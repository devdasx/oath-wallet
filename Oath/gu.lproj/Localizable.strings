"onboarding.entropy.learn_more.inputs.dice.detail" = "સમતોલ પાસામાં, બાજુ 1–4માંથી દરેક 2 બિટ અને બાજુ 5–6માંથી દરેક 1 બિટ આપે છે.";
"onboarding.entropy.learn_more.inputs.coin.title" = "સિક્કો ઉછાળો";
"onboarding.entropy.learn_more.inputs.coin.detail" = "સમતોલ સિક્કાનો દરેક સ્વતંત્ર ઉછાળ 1 પક્ષપાતરહિત એન્ટ્રોપી બિટ આપે છે.";
"onboarding.entropy.learn_more.inputs.digits.title" = "રૅન્ડમ અંકો નોંધો";
"onboarding.entropy.learn_more.inputs.digits.detail" = "અંક 0–7માંથી દરેક 3 બિટ અને અંક 8–9માંથી દરેક 1 બિટ આપે છે. અંકો ખરેખર રૅન્ડમ ભૌતિક પ્રક્રિયામાંથી આવવા જોઈએ.";
"onboarding.entropy.learn_more.inputs.footer" = "સમતોલ ભૌતિક સ્ત્રોત વાપરો અને દરેક પરિણામને ક્રમમાં નોંધો. તમે ઇનપુટની પદ્ધતિ બદલી શકો છો, કારણ કે દરેક સ્વીકારેલું પરિણામ એ જ બિટ સ્ટ્રીમમાં ઉમેરાય છે.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-બિટનું મૂલ્ય તૈયાર કરો";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath પાસાનાં પરિણામો અને દશાંશ અંકોને 2ની ઘાતવાળા પક્ષપાતરહિત જૂથોમાં રૂપાંતરિત કરે છે. યોગદાનની લંબાઈ બદલાઈ શકે છે, પરંતુ સમતોલ ભૌતિક સ્ત્રોત કોઈપણ બિટ મૂલ્યની તરફેણ કરતો નથી.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath બરાબર 256 બિટ એકત્ર ન થાય ત્યાં સુધી દાખલ કરેલા ક્રમમાં બિટ ઉમેરે છે અને પછી સૌથી મહત્ત્વપૂર્ણ બિટને પહેલાં રાખીને તેને 32 બાઇટમાં પૅક કરે છે.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "કસ્ટમ એન્ટ્રોપીમાં માત્ર તમે નોંધેલા ભૌતિક ઇનપુટ હોય છે; Oath ઉપકરણ દ્વારા બનાવેલી રૅન્ડમનેસ તેમાં ઉમેરતું નથી.";
"onboarding.entropy.learn_more.bip39.section" = "3. પુનઃપ્રાપ્તિ શબ્દસમૂહ બનાવો";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "એન્ટ્રોપીના 256 બિટ";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-બિટનો BIP-39 ચેકસમ";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 બિટને 11 બિટના 24 શબ્દ ઇન્ડેક્સમાં વિભાજિત કરવામાં આવે છે";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256 બિટના એન્ટ્રોપી મૂલ્યમાં 8 બિટનો ચેકસમ ઉમેરવાથી 264 બિટ બને છે અને એ 264 બિટને 11 બિટના 24 શબ્દ ઇન્ડેક્સમાં વિભાજિત કરવામાં આવે છે.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 32-બાઇટના એન્ટ્રોપી મૂલ્ય પર SHA-256ની ગણતરી કરે છે અને હૅશના પ્રથમ 8 બિટને ચેકસમ તરીકે લે છે; એ ચેકસમ ઉમેરવાથી 264 બિટ બને છે.";
"onboarding.entropy.learn_more.bip39.words" = "264 બિટને 11 બિટના 24 જૂથમાં વિભાજિત કરવામાં આવે છે. દરેક જૂથ પ્રમાણભૂત 2,048-શબ્દની BIP-39 સૂચિમાંથી એક શબ્દ પસંદ કરીને 24-શબ્દનો પુનઃપ્રાપ્તિ શબ્દસમૂહ બનાવે છે.";
"onboarding.entropy.learn_more.bip39.derivation" = "પરિણામે મળેલા સીડમાંથી Wallet Core નિયત એકાઉન્ટ અને સરનામાં બનાવે છે. એક જ પુનઃપ્રાપ્તિ શબ્દસમૂહ અને વૈકલ્પિક પાસફ્રેઝ હંમેશા એ જ વૉલેટ ફરી બનાવશે.";
"onboarding.entropy.learn_more.security.section" = "કસ્ટમ એન્ટ્રોપી સુરક્ષાને કેવી રીતે મજબૂત બનાવે છે";
"onboarding.entropy.learn_more.security.space.title" = "સંભાવનાઓનું વિશાળ ક્ષેત્ર";
"onboarding.entropy.learn_more.security.space.detail" = "સમાન રીતે વિતરિત 256-બિટ એન્ટ્રોપીમાં 2^256 અનન્ય મૂલ્યો હોય છે, જેથી દરેક શક્યતા અજમાવી અનુમાન કરવું ગણતરીની દૃષ્ટિએ અવ્યવહારુ બને છે. આ ઇનપુટ ક્ષેત્રનું કદ દર્શાવે છે; દરેક ક્રિપ્ટોગ્રાફિક ઘટક 256-બિટ હુમલા સામે સુરક્ષા આપે છે એવો તેનો અર્થ નથી.";
"onboarding.entropy.learn_more.security.source.title" = "રૅન્ડમનેસ તમારી પાસેથી આવે છે";
"onboarding.entropy.learn_more.security.source.detail" = "ભૌતિક ઘટનાઓ તમને માત્ર ઉપકરણના રૅન્ડમ-નંબર જનરેટર પર આધાર રાખવાને બદલે વૉલેટની રૅન્ડમનેસ સ્વતંત્ર રીતે મેળવવા દે છે. આ ઘટનાઓ ખરેખર રૅન્ડમ હોય ત્યારે જ તે સુરક્ષા વધારે છે.";
"onboarding.entropy.learn_more.security.local.title" = "સંપૂર્ણ પ્રક્રિયા આ ઉપકરણ પર જ";
"onboarding.entropy.learn_more.security.local.detail" = "Oath તમારા નોંધાયેલા ક્રમને રૂપાંતરિત કરીને આ ઉપકરણ પર જ પુનઃપ્રાપ્તિ શબ્દસમૂહ બનાવે છે. પ્રક્રિયા માટે તમારો ક્રમ ક્યારેય અપલોડ થતો નથી.";
"onboarding.entropy.learn_more.security.patterns.title" = "માણસે પસંદ કરેલાં રહસ્યો ટાળો";
"onboarding.entropy.learn_more.security.patterns.detail" = "સમતોલ, સ્વતંત્ર ઘટનાઓનો લાંબો ક્રમ જન્મતારીખ, મનપસંદ અંકો, પુનરાવર્તિત પેટર્ન અથવા કોઈ વ્યક્તિએ પસંદ કરેલા શબ્દો કરતાં ઘણો ઓછો અનુમાનપાત્ર હોય છે.";
"onboarding.entropy.learn_more.security.footer" = "ભૌતિક એન્ટ્રોપી ઉપકરણથી બનતી વૉલેટ રૅન્ડમનેસને બદલે છે; તે વધારાનો પાસવર્ડ કે સુરક્ષા સ્તર નથી.";
"onboarding.entropy.learn_more.safety.section" = "આ સુવિધા સુરક્ષિત રીતે વાપરો";
"onboarding.entropy.learn_more.safety.fair.title" = "સમતોલ અને સ્વતંત્ર પરિણામો નોંધો";
"onboarding.entropy.learn_more.safety.fair.detail" = "સમતોલ સિક્કો અથવા પાસો વાપરો અને દરેક પરિણામ સ્વતંત્ર હોય તેની ખાતરી કરો. રૅન્ડમ અંકો ખરેખર ભૌતિક સ્ત્રોતમાંથી આવવા જોઈએ—યાદશક્તિ કે પેટર્નમાંથી નહીં.";
"onboarding.entropy.learn_more.safety.private.title" = "તમારી એન્ટ્રોપી પ્રક્રિયા ખાનગી રાખો";
"onboarding.entropy.learn_more.safety.private.detail" = "નોંધાયેલા ક્રમ અને પૂર્ણ પુનઃપ્રાપ્તિ શબ્દસમૂહ બંનેને વૉલેટનાં રહસ્યો તરીકે સુરક્ષિત રાખો. તેમને કેમેરા અને અન્ય લોકોની નજરથી દૂર રાખો.";
"onboarding.entropy.learn_more.safety.accurate.title" = "દરેક પરિણામ ચોક્કસ રીતે નોંધો";
"onboarding.entropy.learn_more.safety.accurate.detail" = "એક પરિણામ ખૂટે, બે વાર નોંધાય કે તેનો ક્રમ બદલાય તો અલગ વૉલેટ બને છે. વૉલેટમાં ભંડોળ ઉમેરતા પહેલાં દરેક એન્ટ્રી તપાસો અને પૂર્ણ પુનઃપ્રાપ્તિ શબ્દસમૂહની ચકાસણી કરો.";
"onboarding.entropy.learn_more.safety.backup.title" = "પુનઃપ્રાપ્તિ શબ્દસમૂહ સુરક્ષિત રાખો";
"onboarding.entropy.learn_more.safety.backup.detail" = "પુનઃપ્રાપ્તિ શબ્દસમૂહ ઑફલાઇન રાખો અને ક્યારેય શેર ન કરો. બૅકઅપ ચકાસ્યા પછી હવે જરૂર ન હોય તેવા કોઈપણ વચગાળાના ઇનપુટ રેકોર્ડનો સુરક્ષિત રીતે નાશ કરો.";
"onboarding.entropy.learn_more.safety.footer" = "ભૌતિક એન્ટ્રોપી જાહેર થઈ ગયેલા પુનઃપ્રાપ્તિ શબ્દસમૂહ, ચેડાં થયેલા ઉપકરણ, દૂષિત સૉફ્ટવેર કે ખોટી રીતે નોંધાયેલા ક્રમને સુરક્ષિત કરી શકતી નથી. જો તમે સમતોલ, ખાનગી અને ચોક્કસ ઇનપુટની ખાતરી ન કરી શકો, તો તેના બદલે પ્રમાણભૂત રીતે વૉલેટ બનાવો.";
"onboarding.carousel.open_source.eyebrow" = "રચનાથી જ ઓપન સોર્સ";
"onboarding.carousel.open_source.title" = "સોર્સ તપાસો. બિલ્ડની ચકાસણી કરો.";
"onboarding.carousel.open_source.message" = "Oath સ્વતંત્ર સમીક્ષા માટે તેનો સોર્સ કોડ પ્રકાશિત કરે છે. ફરી બનાવી શકાય એવો બિલ્ડ પ્રકાશિત ઍપના ફિંગરપ્રિન્ટ સાથે મેળ ખાય ત્યારે જ રિલીઝ ચકાસાયેલી ગણાય છે.";
