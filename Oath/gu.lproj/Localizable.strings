// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "પુષ્ટિ બટનને બદલે હવે સ્લાઇડ કરીને મોકલો. દિશા દર્શાવતું એનિમેશન, હૅપ્ટિક પ્રતિસાદ અને સરળ ગતિ વાંચવાની બંને દિશામાં કામ કરે છે. મોકલવા 90% કે આગળ પહોંચીને આંગળી છોડો; રદ કરવા પાછું સરકાવો.";
"settings.about.history.v355.build56.activity" = "ઘંટડીથી બાકી પ્રવૃત્તિ ખૂલે છે. વ્યવહારના કૅપ્સ્યુલ સ્થિતિના બૅજ બતાવે છે અને સ્વાઇપથી છુપાવી શકાય છે. પુષ્ટિ ચાલુ અને પુષ્ટિ થયેલા કૅપ્સ્યુલ 3 સેકન્ડ પછી છુપાય છે; પુષ્ટિ થતાં એ જ દેખાતું કૅપ્સ્યુલ અપડેટ થાય છે.";
"settings.about.history.v355.build56.status" = "બધા સમર્થિત નેટવર્ક પર વધુ વિશ્વસનીય વ્યવહાર સ્થિતિ, તાજી વિગતો અને મોકલ્યા પછી ઝડપી બૅલેન્સ અપડેટ. ઍપ ફરી ખોલતાં બાકી વ્યવહારોનું નિરીક્ષણ ફરી શરૂ થાય છે.";
"settings.about.history.v355.build56.fees" = "એ જ ટ્રાન્સફરની સમીક્ષા પર પાછા ફરતાં તૈયાર ફી જળવાય છે. ફી લોડ થવી અને ખાતામાં ભંડોળની જરૂરિયાતની ચેતવણીઓ વધુ સ્પષ્ટ છે; પૂરતી રકમ હોય ત્યારે સક્રિયકરણની સૂચના દેખાતી નથી.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin અને Dogecoinમાં ડસ્ટ મર્યાદાથી ઓછી પરત આવતી રકમ બિનઉપયોગી આઉટપુટ બનાવવાને બદલે ફીમાં ઉમેરાય છે. સમીક્ષાની ફી સહી કરતી વખતની ફી સાથે મેળ ખાય છે.";
"settings.about.history.v355.build56.stability" = "બૅકગ્રાઉન્ડ કાર્યનો ક્રૅશ અને વૉલેટ રિફ્રેશની સમયમર્યાદાની ચેતવણીઓ સુધારી છે. રિફ્રેશ અસ્થાયી રીતે નિષ્ફળ જાય ત્યારે વૉલેટની હાલની માહિતી ઉપલબ્ધ રહે છે.";
"settings.about.history.v355.build56.backup" = "ખુલતાં જ સાચાં શીર્ષકો અને ઓછા સંદેશાઓ સાથે વધુ સ્વચ્છ બૅકઅપ સ્ક્રીનો. ખાનગી કીની ઍક્સેસ ઍપ લૉક સેટિંગ્સને અનુસરે છે. સંક્ષિપ્ત કાચ જેવી આયાત ચેતવણીઓમાં બીજી પુનઃપ્રાપ્તિ શબ્દમાળા પસંદ કરતાં નકારેલું ઇનપુટ સાફ થાય છે.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "મોકલવાનું સ્લાઇડર છોડ્યા પછી, સમીક્ષા સ્ક્રીન બંધ થાય તે પહેલાં એનિમેટેડ ટિક ચિહ્ન દેખાય છે.";
"settings.about.history.v355.build57.activity" = "પ્રવૃત્તિની પંક્તિઓમાં સ્થિતિનું લખાણ ઓછું ઘાટું, રકમ ઉપશીર્ષક તરીકે અને વ્યવહારની વિગતો ખોલવા માટે તીર દેખાય છે.";
"settings.about.history.v355.build57.details" = "નેટવર્ક ફી હવે ટ્રાન્સફરના સારાંશમાં દેખાય છે. ટૂંકાં લેબલ અને નેટવર્કની એક જ પંક્તિથી વિગતો વધુ સ્પષ્ટ બને છે.";
"settings.about.history.v355.build57.resume" = "બેકગ્રાઉન્ડમાંથી પાછા ફરતાં ખુલ્લી સ્ક્રીન અને પેનલ જળવાઈ રહે છે, જેમાં ટ્રાન્સફરની સમીક્ષા અને વ્યવહારની વિગતો પણ સામેલ છે.";
"settings.about.history.v355.build57.secrets" = "ઍપથી 20 સેકન્ડ દૂર રહેવાથી પુનઃપ્રાપ્તિ શબ્દસમૂહ, ખાનગી કી અને પાસફ્રેઝની સ્ક્રીન બંધ થાય છે. ઍપ લૉક તમારી સેટિંગ્સ પ્રમાણે કામ કરતું રહે છે.";
"settings.about.history.v355.build57.filters" = "નેટવર્ક ફિલ્ટરમાં થોડાં ઊંચાં મૂળ સિસ્ટમ બટન, સામગ્રી મુજબનું કદ અને નેવિગેશન બારની નીચે સુધારેલું અંતર છે.";
"settings.about.history.v355.build57.units" = "મૂલ્યની અલગ પંક્તિઓ દૂર કરી છે. રકમ અને નેટવર્ક ફી પહેલાં સ્થાનિક ચલણમાં દેખાય છે; ક્રિપ્ટો એકમમાં બદલવા અને પાછા ફરવા કોઈ એક પર ટૅપ કરો.";
"wallet.transaction.details.toggle_units" = "એકમ બદલો.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "હોમ સ્ક્રીન ફેડ કે કદ બદલવાની અસર વિના ખૂલે છે. સેટિંગ્સ બટન હવે ગિયરનું ચિહ્ન વાપરે છે.";
"settings.about.history.v355.build58.fields" = "વ્યવહાર અને મોકલવાના ક્ષેત્રોમાં લખાણના સામાન્ય રંગો વપરાય છે. તીર ફક્ત સ્ક્રીન કે પેનલ ખોલતી પંક્તિઓમાં દેખાય છે; રકમ અને ફી પર ટૅપ કરવાથી હજી પણ એકમ બદલાય છે.";
"settings.about.history.v355.build58.banners" = "દેખાયા પછી, પુષ્ટિ ચાલુ છે કે પૂર્ણ થઈ છે તેવા બૅનર 3 સેકન્ડ બાદ હટી જાય છે, તમે બીજી સ્ક્રીન ખોલો તો પણ. પુષ્ટિના હજી ન દેખાડેલા અપડેટ પાછા ફરતાં દેખાય છે.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON ટ્રાન્સફરમાં હવે મહત્તમ રકમ મોકલતી વખતે પણ મોકલવાની રકમ ગણતા પહેલાં સક્રિયકરણ અને બેન્ડવિડ્થ ફી માટે રકમ અલગ રાખવામાં આવે છે. સમીક્ષા સ્ક્રીન પર ફી બાદની સાચી રકમ દેખાય છે.";
"settings.about.history.v355.build59.fees" = "પોતે નક્કી કરેલી TRON ફીથી નેટવર્કનો જરૂરી ખર્ચ ચૂકવી શકાય તે જરૂરી છે. TRX બેલેન્સ ઓછું હોય ત્યારે હવે વધુ સ્પષ્ટ માર્ગદર્શન દેખાય છે. ટોકનની માત્રા બદલાતી નથી; ફી TRXમાં ચૂકવાય છે.";

