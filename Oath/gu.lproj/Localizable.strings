"settings.about.history.v352.build50.safety" = "બિલ્ડ 50: TRON મલ્ટિસિગ અને USDT/USDC પ્રતિબંધોની સંયુક્ત ચેતવણીઓ. TRON મલ્ટિસિગ ટ્રાન્સફર બંધ રહે છે, જ્યારે સેટિંગ્સ ઉપલબ્ધ રહે છે. સહીની ભૂલો અને આયાતની સૂચનાઓ વધુ સ્પષ્ટ; પુનઃપ્રાપ્તિ શબ્દસમૂહોની બ્લોક સૂચિ અપડેટ કરી.";

"settings.about.history.v352.build50.input" = "આયાત પછી કિંમતો વધુ ઝડપથી લોડ થાય છે. શૂન્ય બેલેન્સ પર એકમો બદલવા અને જમણેથી ડાબે લખાતી ભાષાઓમાં કન્વર્ટરમાં ટાઇપ કરવાની સમસ્યા સુધારી. પુનઃપ્રાપ્તિ શબ્દોનો ક્રમ જળવાય છે; માન્ય શબ્દસમૂહ પેસ્ટ કે સ્કૅન કરતાં કીબોર્ડ બંધ થાય છે.";

"settings.about.history.v352.build50.interface" = "હોમ સ્ક્રીન અને સંપત્તિ પિન કરવાના વધુ સરળ એનિમેશન, વધુ હૅપ્ટિક પ્રતિસાદ અને સુધારેલા અનુવાદો. પ્રાપ્તિનાં કાર્ડ ડાર્ક મોડમાં મોટા QR કોડ અને સરનામાના લખાણ સાથે દેખાય છે. ફેરફારો ચેકમાર્કથી સાચવાય છે; ચેતવણીઓ ફક્ત જરૂરી માહિતી બતાવે છે.";

"evm_access.gas.insufficient.title" = "નેટવર્ક ફી માટે પૂરતું બેલેન્સ નથી";
"evm_access.gas.insufficient.body" = "નેટવર્ક ફી ચૂકવવા માટે આ વૉલેટમાં %@ ઉમેરો અને તેના માટે %@ નેટવર્ક વાપરો. પછી પરવાનગી રદ કરવાનો ફરી પ્રયાસ કરો.";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "રિકવરી શબ્દસમૂહની ચકાસણી, આપમેળે નાના અક્ષરો, ક્રમાંક સાથે લખાણ, સાફ કરવું, બૅકસ્પેસ દબાવી રાખીને કાઢવું અને કીબોર્ડના વર્તનમાં સુધારો કર્યો છે. રિકવરી સ્ક્રીન પર હવે પાછા જવા માટે એક જ બટન છે.";
"settings.about.history.v353.build51.send" = "ફીના અંદાજ ઉપલબ્ધ ન હોય ત્યારે બધા સમર્થિત નેટવર્ક પર ફીનો અંદાજ મેળવવા માટે વૈકલ્પિક રીતો ઉમેરવામાં આવી છે. મોકલતી વખતે કોન્ટ્રેક્ટ સરનામાં છુપાય છે અને ફી વધુ સ્પષ્ટ દેખાય છે.";
"settings.about.history.v353.build51.security" = "પરવાનગીઓની સમીક્ષા, સરનામાની વિગતો, પરવાનગી રદ કરવાનાં પરિણામો અને ફી માટે નાણાં ઉમેરવાની સૂચનાઓ વધુ સ્પષ્ટ છે. બૅકઅપ કાર્ડ અને શીટની શૈલી એકસરખી છે. નેવિગેશન દરમિયાન થતું કંપન દૂર કર્યું છે.";
"settings.about.history.v353.build51.notifications" = "વિવિધ નેટવર્ક પર આવતા ટ્રાન્સફરની સૂચનાઓ વધુ વિશ્વસનીય છે. ભાવ ઉપલબ્ધ હોય ત્યારે રકમ પસંદ કરેલા ચલણમાં, નહિતર ક્રિપ્ટોના મૂળ એકમમાં દેખાય છે.";

