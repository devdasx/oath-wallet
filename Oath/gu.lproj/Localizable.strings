"onboarding.passphrase.learn_more.path.section" = "બે રહસ્યોમાંથી એક વૉલેટ બને છે";
"onboarding.passphrase.learn_more.overview" = "BIP-39 પાસફ્રેઝ એ તમારા પુનઃપ્રાપ્તિ શબ્દસમૂહ સાથે વપરાતું વૈકલ્પિક રહસ્ય છે. બંને મળીને નિયત રીતે એવું વૉલેટ બનાવે છે જે માત્ર પુનઃપ્રાપ્તિ શબ્દસમૂહથી બનેલા વૉલેટથી અલગ હોય છે.";
"onboarding.passphrase.learn_more.visual.phrase" = "તમારો 24-શબ્દનો પુનઃપ્રાપ્તિ શબ્દસમૂહ";
"onboarding.passphrase.learn_more.visual.passphrase" = "તમારો ગુપ્ત પાસફ્રેઝ";
"onboarding.passphrase.learn_more.visual.wallet" = "પાસફ્રેઝથી સુરક્ષિત વૉલેટ";
"onboarding.passphrase.learn_more.visual.accessibility" = "24-શબ્દનો પુનઃપ્રાપ્તિ શબ્દસમૂહ અને ગુપ્ત પાસફ્રેઝ મળીને પાસફ્રેઝથી સુરક્ષિત એવું અલગ વૉલેટ બનાવે છે.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 વૉલેટ કેવી રીતે બનાવે છે";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "પુનઃપ્રાપ્તિ શબ્દસમૂહ અને પાસફ્રેઝનું સંયોજન";
"onboarding.passphrase.learn_more.derivation.visual.function" = "2,048 રાઉન્ડ સાથે PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-બિટનું માસ્ટર સીડ";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "તેમાંથી બનેલા વૉલેટ એકાઉન્ટ અને સરનામાં";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "તમારો પુનઃપ્રાપ્તિ શબ્દસમૂહ અને પાસફ્રેઝ PBKDF2-HMAC-SHA512ના 2,048 રાઉન્ડમાંથી પસાર થઈને 512-બિટનું સીડ બનાવે છે, જેમાંથી વૉલેટ એકાઉન્ટ અને સરનામાં બને છે.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 સામાન્યકૃત પુનઃપ્રાપ્તિ શબ્દસમૂહને PBKDF2 પાસવર્ડ તરીકે લે છે અને સૉલ્ટ તરીકે “mnemonic” પછી સામાન્યકૃત પાસફ્રેઝ વાપરે છે. PBKDF2-HMAC-SHA512ના 2,048 રાઉન્ડ પછી પ્રક્રિયા 64-બાઇટનું સીડ બનાવે છે.";
"onboarding.passphrase.learn_more.derivation.normalization" = "સીડ બનાવતા પહેલાં Oath, BIP-39 માટે જરૂરી Unicode સામાન્યકરણ લાગુ કરે છે, જેથી એક જ સામાન્યકૃત પુનઃપ્રાપ્તિ શબ્દસમૂહ અને પાસફ્રેઝ હંમેશા એ જ વૉલેટ ફરી બનાવે.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "પાસફ્રેઝ તમારા પુનઃપ્રાપ્તિ શબ્દોને એન્ક્રિપ્ટ કરતો નથી. તે બનતું સીડ બદલે છે, તેથી દરેક જુદો પાસફ્રેઝ જુદા એકાઉન્ટ અને સરનામાં બનાવે છે.";
"onboarding.passphrase.learn_more.wallets.section" = "દરેક પાસફ્રેઝથી અલગ વૉલેટ બને છે";
"onboarding.passphrase.learn_more.wallets.visual.one" = "નમૂનાનો પાસફ્રેઝ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "નમૂનાનો પાસફ્રેઝ 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "નમૂનાનું વૉલેટ A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "નમૂનાનું વૉલેટ B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "એક જ પુનઃપ્રાપ્તિ શબ્દસમૂહને બે જુદા પાસફ્રેઝ સાથે વાપરવાથી બે અલગ વૉલેટ બને છે: વૉલેટ A અને વૉલેટ B.";
"onboarding.passphrase.learn_more.wallets.different" = "માત્ર એક મહત્વપૂર્ણ અક્ષર બદલવાથી પણ જુદું સીડ અને તેથી જુદું વૉલેટ બને છે; મૂળ વૉલેટ બદલાતું નથી.";
"onboarding.passphrase.learn_more.wallets.empty" = "ખાલી પાસફ્રેઝ માત્ર પુનઃપ્રાપ્તિ શબ્દસમૂહથી બનેલું પ્રમાણભૂત વૉલેટ ખોલે છે; ખાલી ન હોય એવો પાસફ્રેઝ પોતાનું અલગ વૉલેટ ખોલે છે.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 “ખોટો પાસફ્રેઝ” એવો પ્રતિભાવ આપતું નથી; દરેક પાસફ્રેઝ માન્ય છે, તેથી ટાઇપોની જાણ થયા વિના બીજું વૉલેટ ખૂલે છે—સામાન્ય રીતે શૂન્ય બેલેન્સ સાથે.";
"onboarding.passphrase.learn_more.security.section" = "પાસફ્રેઝ સુરક્ષા કેવી રીતે વધારે છે";
"onboarding.passphrase.learn_more.security.words.title" = "ફક્ત પુનઃપ્રાપ્તિ શબ્દો પૂરતા નથી";
"onboarding.passphrase.learn_more.security.words.detail" = "માત્ર તમારો પુનઃપ્રાપ્તિ શબ્દસમૂહ મેળવનાર વ્યક્તિને પણ સુરક્ષિત વૉલેટ બનાવવા અને તેને ઍક્સેસ કરવા ચોક્કસ પાસફ્રેઝની જરૂર રહે છે.";
"onboarding.passphrase.learn_more.security.strength.title" = "મજબૂત પાસફ્રેઝ વધુ સારું વિભાજન આપે છે";
"onboarding.passphrase.learn_more.security.strength.detail" = "લાંબો અને અણધાર્યો પાસફ્રેઝ અનુમાન લગાવવાનું અર્થપૂર્ણ રીતે મુશ્કેલ બનાવે છે; ટૂંકું અવતરણ, જન્મતારીખ, નામ કે ફરી વપરાયેલો પાસવર્ડ ઝડપથી અનુમાનાઈ શકે છે અને બહુ ઓછી સુરક્ષા આપે છે.";
"onboarding.passphrase.learn_more.security.separation.title" = "પાસફ્રેઝ અલગ રાખો";
"onboarding.passphrase.learn_more.security.separation.detail" = "પાસફ્રેઝને પુનઃપ્રાપ્તિ શબ્દસમૂહથી અલગ સાચવો, જેથી એક બૅકઅપ ચોરાય તો વૉલેટ પુનઃસ્થાપિત કરવા જરૂરી બંને રહસ્યો જાહેર ન થાય.";
"onboarding.passphrase.learn_more.security.footer" = "બંને રહસ્યો જાહેર થઈ જાય, પાસફ્રેઝ નબળો હોય અથવા ચેડાં થયેલું સૉફ્ટવેર ટાઇપ કરતી વખતે તેને મેળવી લે તો પાસફ્રેઝ તમારું ભંડોળ સુરક્ષિત કરી શકતો નથી.";
"onboarding.passphrase.learn_more.safety.section" = "આ સુવિધા સુરક્ષિત રીતે વાપરો";
"onboarding.passphrase.learn_more.safety.strong.title" = "મજબૂત અને અનન્ય પાસફ્રેઝ બનાવો";
"onboarding.passphrase.learn_more.safety.strong.detail" = "માત્ર આ વૉલેટ માટે અનન્ય હોય એવા કેટલાક રૅન્ડમ શબ્દો કે અન્ય ઉચ્ચ-એન્ટ્રોપી મૂલ્ય પસંદ કરો. વ્યક્તિગત વિગતો, જાણીતા શબ્દસમૂહો, પેટર્ન અને અન્ય જગ્યાએ વપરાયેલા પાસવર્ડ ટાળો.";
"onboarding.passphrase.learn_more.safety.backup.title" = "પાસફ્રેઝનો અલગ બૅકઅપ લો";
"onboarding.passphrase.learn_more.safety.backup.detail" = "ચોક્કસ પાસફ્રેઝની ટકાઉ ઑફલાઇન નકલ બનાવો, તેને પુનઃપ્રાપ્તિ શબ્દસમૂહથી અલગ સાચવો અને માત્ર યાદશક્તિ પર ક્યારેય આધાર ન રાખો.";
"onboarding.passphrase.learn_more.safety.exact.title" = "દરેક અક્ષરથી વૉલેટ બદલાય છે";
"onboarding.passphrase.learn_more.safety.exact.detail" = "દરેક મોટો અક્ષર, જગ્યા, વિરામચિહ્ન અને શબ્દ સહિત પાસફ્રેઝ બનાવ્યો હતો એ જ રીતે ફરી દાખલ કરો. કોઈપણ તફાવતની જાણ થયા વિના બીજું વૉલેટ બને છે.";
"onboarding.passphrase.learn_more.safety.verify.title" = "ભંડોળ ઉમેરતા પહેલાં પુનઃપ્રાપ્તિ ચકાસો";
"onboarding.passphrase.learn_more.safety.verify.detail" = "નોંધપાત્ર ભંડોળ મેળવતા પહેલાં, ખાનગી અને નિયંત્રિત પુનઃપ્રાપ્તિ પરીક્ષણ કરીને ખાતરી કરો કે પુનઃપ્રાપ્તિ શબ્દસમૂહ અને પાસફ્રેઝ અપેક્ષિત સરનામાં ફરી બનાવે છે.";
"onboarding.passphrase.learn_more.safety.footer" = "કોઈપણ સેવા ખોવાયેલો પાસફ્રેઝ રીસેટ કે પુનઃપ્રાપ્ત કરી શકતી નથી. ચોક્કસ પાસફ્રેઝ વિના તે વૉલેટની ઍક્સેસ કાયમ માટે ગુમાવી દો છો—પુનઃપ્રાપ્તિ શબ્દસમૂહ તમારી પાસે હોય તો પણ.";
