"onboarding.carousel.open_source.visual.rebuild" = "રિલીઝ બિલ્ડ ફરી બનાવો";
"onboarding.carousel.open_source.visual.compare" = "બિલ્ડ આર્ટિફેક્ટ્સની સરખામણી કરો";
"onboarding.carousel.open_source.visual.fingerprint" = "પ્રકાશિત રિલીઝનો ફિંગરપ્રિન્ટ";
"onboarding.carousel.open_source.visual.match" = "મેળની પુષ્ટિ — બિલ્ડ ચકાસાયેલ";
"onboarding.carousel.open_source.visual.accessibility" = "રિલીઝની ચકાસણી માટે જાહેર સોર્સ કોડ, સ્વતંત્ર રીતે ફરી બનાવેલો બિલ્ડ અને મેળ ખાતા ફિંગરપ્રિન્ટ જરૂરી છે તે દર્શાવતો આલેખ.";
"onboarding.carousel.passphrase.eyebrow" = "વૈકલ્પિક BIP-39 પાસફ્રેઝ";
"onboarding.carousel.passphrase.title" = "એક પુનઃપ્રાપ્તિ શબ્દસમૂહ. એક વધારાનું રહસ્ય.";
"onboarding.carousel.passphrase.message" = "BIP-39 પાસફ્રેઝ તમારા પુનઃપ્રાપ્તિ શબ્દસમૂહ સાથે મળીને અલગ વૉલેટ બનાવે છે. પુનઃપ્રાપ્તિ શબ્દો જાહેર થઈ જાય તો પણ એ વૉલેટ મેળવવા માટે ચોક્કસ પાસફ્રેઝ જરૂરી રહે છે.";
"onboarding.carousel.passphrase.visual.phrase" = "તમારા 24 પુનઃપ્રાપ્તિ શબ્દો";
"onboarding.carousel.passphrase.visual.passphrase" = "તમારો વધારાનો ગુપ્ત પાસફ્રેઝ";
