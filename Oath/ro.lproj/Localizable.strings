"onboarding.carousel.entropy.eyebrow" = "ENTROPIE DIN SURSE FIZICE";
"onboarding.carousel.entropy.title" = "Generează entropie pe care o controlezi pe deplin.";
"onboarding.carousel.entropy.message" = "Aruncă un zar, dă cu banul sau notează cifre aleatorii. Oath transformă sursa ta fizică în exact 256 de biți de entropie pentru o frază de recuperare de 24 de cuvinte, totul pe dispozitivul tău.";
"onboarding.carousel.entropy.visual.output" = "256 de biți de entropie generați de tine";
"onboarding.carousel.entropy.visual.local" = "Generată exclusiv din datele înregistrate de tine";
"onboarding.carousel.entropy.visual.accessibility" = "Un zar numerotat, o monedă și cifre aleatorii se combină pentru a produce pe acest dispozitiv 256 de biți de entropie pentru portofel.";
"onboarding.carousel.entropy.learn_more.action" = "Explorează detaliile";
"onboarding.entropy.learn_more.navigation" = "Cum funcționează entropia fizică";
"onboarding.entropy.learn_more.path.section" = "De la rezultate fizice la cuvinte de recuperare";
"onboarding.entropy.learn_more.overview" = "Oath înregistrează rezultatele sursei fizice alese și le transformă într-o valoare de 256 de biți. Cei 32 de octeți rezultați sunt apoi transmiși către Wallet Core pentru a crea o frază standard de recuperare BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "O frază de recuperare BIP-39 de 24 de cuvinte";
"onboarding.entropy.learn_more.visual.bits" = "32 de octeți × 8 biți = 256 de biți";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "O grilă de 256 de celule eșantion, aranjate în 32 de octeți.";
"onboarding.entropy.learn_more.visual.accessibility" = "Aruncările de zaruri sau de monedă ori cifrele aleatorii sunt transformate în 256 de biți, apoi într-o frază de recuperare BIP-39 de 24 de cuvinte.";
"onboarding.entropy.learn_more.inputs.section" = "Pasul 1: înregistrează rezultatele fizice";
"onboarding.entropy.learn_more.inputs.dice.title" = "Aruncă un zar echilibrat cu șase fețe";
"onboarding.entropy.learn_more.inputs.dice.detail" = "În cazul unui zar echilibrat, fețele 1–4 contribuie cu câte 2 biți, iar fețele 5–6 cu câte 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Aruncări fizice ale unei monede";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Fiecare aruncare echilibrată și independentă a unei monede contribuie cu un bit de entropie uniform distribuit.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Înregistrează cifre aleatorii";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cifrele 0–7 contribuie cu câte 3 biți, iar cifrele 8–9 cu câte 1 bit. Cifrele trebuie să provină dintr-un proces fizic cu adevărat aleatoriu.";
"onboarding.entropy.learn_more.inputs.footer" = "Folosește o sursă fizică echilibrată și înregistrează fiecare rezultat în ordine. Poți schimba metoda de introducere, deoarece fiecare rezultat acceptat contribuie la același flux de biți.";
"onboarding.entropy.learn_more.conversion.section" = "2. Construiește o valoare de 256 de biți";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath transformă rezultatele zarurilor și cifrele zecimale în grupuri echilibrate a căror dimensiune este o putere a lui doi. Lungimea contribuțiilor poate varia, însă o sursă fizică echilibrată nu favorizează nicio valoare de bit.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath adaugă biții în ordinea introducerii până când adună exact 256, apoi îi grupează în 32 de octeți, începând cu bitul cel mai semnificativ.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropia personalizată conține numai datele fizice înregistrate de tine; Oath nu adaugă date aleatorii generate de dispozitiv.";
"onboarding.entropy.learn_more.bip39.section" = "3. Derivă fraza de recuperare";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 de biți de entropie";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "O sumă de control BIP-39 de 8 biți";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 de biți împărțiți în 24 de indici de câte 11 biți";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "O valoare de entropie de 256 de biți primește o sumă de control de 8 biți, rezultând 264 de biți care se împart în 24 de indici de câte 11 biți.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 calculează SHA-256 pentru valoarea de entropie de 32 de octeți și folosește primii 8 biți ai valorii hash drept sumă de control; adăugarea acesteia produce 264 de biți.";
"onboarding.entropy.learn_more.bip39.words" = "Cei 264 de biți sunt împărțiți în 24 de grupuri de câte 11 biți. Fiecare grup selectează o intrare din lista standard BIP-39 de 2.048 de cuvinte, generând fraza de recuperare de 24 de cuvinte.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core derivă conturi și adrese deterministe din seedul rezultat. Aceeași frază de recuperare și aceeași frază de acces opțională vor recrea întotdeauna același portofel.";
"onboarding.entropy.learn_more.security.section" = "Cum consolidează securitatea entropia personalizată";
"onboarding.entropy.learn_more.security.space.title" = "Un spațiu imens de posibilități";
"onboarding.entropy.learn_more.security.space.detail" = "Entropia uniformă de 256 de biți cuprinde 2^256 de valori unice, ceea ce face imposibilă în practică încercarea exhaustivă a tuturor variantelor. Aceasta este dimensiunea spațiului de intrare și nu înseamnă că fiecare componentă criptografică oferă o rezistență de 256 de biți la atacuri.";
"onboarding.entropy.learn_more.security.source.title" = "Tu controlezi sursa de entropie";
"onboarding.entropy.learn_more.security.source.detail" = "Evenimentele fizice îți permit să generezi independent entropia portofelului, fără să te bazezi exclusiv pe generatorul de numere aleatorii al dispozitivului. Securitatea este îmbunătățită numai dacă evenimentele sunt cu adevărat aleatorii.";
"onboarding.entropy.learn_more.security.local.title" = "Procesare integrală pe acest dispozitiv";
"onboarding.entropy.learn_more.security.local.detail" = "Oath transformă secvența înregistrată și creează fraza de recuperare integral pe acest dispozitiv. Secvența nu este încărcată niciodată pentru procesare.";
"onboarding.entropy.learn_more.security.patterns.title" = "Evită secretele alese de oameni";
"onboarding.entropy.learn_more.security.patterns.detail" = "O secvență lungă de evenimente echilibrate și independente este mult mai puțin previzibilă decât datele de naștere, numerele preferate, tiparele repetate sau cuvintele alese de o persoană.";
"onboarding.entropy.learn_more.security.footer" = "Entropia fizică înlocuiește datele aleatorii generate de dispozitiv pentru portofel; nu este o parolă sau un nivel de securitate suplimentar.";
"onboarding.entropy.learn_more.safety.section" = "Folosește în siguranță această funcție";
"onboarding.entropy.learn_more.safety.fair.title" = "Înregistrează rezultate echilibrate și independente";
"onboarding.entropy.learn_more.safety.fair.detail" = "Folosește o monedă sau un zar echilibrat și asigură-te că fiecare rezultat este independent. Cifrele aleatorii trebuie să provină dintr-o sursă fizică autentică, nu din memorie ori dintr-un tipar.";
"onboarding.entropy.learn_more.safety.private.title" = "Păstrează privat procesul de generare a entropiei";
"onboarding.entropy.learn_more.safety.private.detail" = "Protejează atât secvența înregistrată, cât și fraza de recuperare finală ca pe secrete ale portofelului. Nu le lăsa în raza camerelor sau la vederea altor persoane.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Înregistrează exact fiecare rezultat";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Omiterea, repetarea sau schimbarea ordinii unui singur rezultat creează un alt portofel. Verifică fiecare intrare și fraza de recuperare finală înainte de a depune fonduri în portofel.";
"onboarding.entropy.learn_more.safety.backup.title" = "Protejează fraza de recuperare";
"onboarding.entropy.learn_more.safety.backup.detail" = "Păstrează fraza de recuperare offline și nu o dezvălui niciodată. După ce verifici copia de rezervă, distruge în siguranță orice înregistrare intermediară de care nu mai ai nevoie.";
"onboarding.entropy.learn_more.safety.footer" = "Entropia fizică nu poate proteja o frază de recuperare expusă, un dispozitiv compromis, software rău-intenționat sau o secvență înregistrată incorect. Dacă nu poți garanta că datele de intrare sunt echilibrate, private și înregistrate exact, folosește metoda standard de creare a portofelului.";
