"onboarding.carousel.open_source.title" = "Inspectează codul-sursă. Verifică versiunea compilată.";
"onboarding.carousel.open_source.message" = "Oath își publică codul-sursă pentru inspecție independentă. O versiune este verificată numai dacă o compilare reproductibilă corespunde amprentei aplicației publicate.";
