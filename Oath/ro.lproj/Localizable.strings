"onboarding.carousel.passphrase.eyebrow" = "FRAZĂ DE ACCES BIP-39 OPȚIONALĂ";
"onboarding.carousel.passphrase.title" = "O frază de recuperare. Încă un secret.";
"onboarding.carousel.passphrase.message" = "O frază de acces BIP-39 se combină cu fraza ta de recuperare pentru a deriva un portofel separat. Chiar dacă sunt expuse cuvintele de recuperare, accesarea acelui portofel necesită în continuare fraza de acces exactă.";
"onboarding.carousel.passphrase.visual.phrase" = "Cele 24 de cuvinte de recuperare";
"onboarding.carousel.passphrase.visual.passphrase" = "Fraza ta de acces secretă suplimentară";
"onboarding.carousel.passphrase.visual.output" = "Un portofel distinct derivat cu fraza de acces";
"onboarding.carousel.passphrase.visual.requirement" = "Ambele secrete sunt necesare pentru recuperare";
"onboarding.carousel.passphrase.visual.accessibility" = "O frază de recuperare de 24 de cuvinte și o frază de acces secretă BIP-39 derivă un portofel separat, pentru a cărui recuperare sunt necesare ambele secrete.";
"onboarding.carousel.passphrase.learn_more.action" = "Explorează detaliile";
"onboarding.passphrase.learn_more.navigation" = "Înțelege frazele de acces BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Două secrete derivă un singur portofel";
"onboarding.passphrase.learn_more.overview" = "O frază de acces BIP-39 este un secret opțional combinat cu fraza ta de recuperare. Împreună, acestea derivă în mod determinist un portofel diferit de cel creat numai cu fraza de recuperare.";
"onboarding.passphrase.learn_more.visual.phrase" = "Fraza ta de recuperare de 24 de cuvinte";
"onboarding.passphrase.learn_more.visual.passphrase" = "Fraza ta secretă de acces";
"onboarding.passphrase.learn_more.visual.wallet" = "Un portofel protejat prin frază de acces";
"onboarding.passphrase.learn_more.visual.accessibility" = "O frază de recuperare de 24 de cuvinte și o frază de acces secretă se combină pentru a deriva un portofel separat, protejat prin fraza de acces.";
"onboarding.passphrase.learn_more.derivation.section" = "Cum derivă BIP-39 portofelul";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Fraza de recuperare combinată cu fraza de acces";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 în 2.048 de runde";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Seed principal de 512 biți";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Conturi și adrese derivate ale portofelului";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Fraza ta de recuperare și fraza de acces parcurg 2.048 de runde PBKDF2-HMAC-SHA512 pentru a produce seedul de 512 biți din care sunt derivate conturile și adresele portofelului.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 tratează fraza de recuperare normalizată drept parolă PBKDF2 și folosește drept valoare de salt termenul „mnemonic” urmat de fraza de acces normalizată. După 2.048 de runde PBKDF2-HMAC-SHA512, procesul produce un seed de 64 de octeți.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Înainte de derivarea seedului, Oath aplică normalizarea Unicode impusă de BIP-39, astfel încât aceeași frază de recuperare normalizată și aceeași frază de acces să reproducă întotdeauna același portofel.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "O frază de acces nu criptează cuvintele de recuperare. Ea schimbă seedul derivat, astfel încât fiecare frază de acces diferită produce alte conturi și adrese.";
"onboarding.passphrase.learn_more.wallets.section" = "Fiecare frază de acces derivă un portofel separat";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Exemplu de frază de acces 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Exemplu de frază de acces 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Exemplu de portofel A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Exemplu de portofel B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Aceeași frază de recuperare, combinată cu două fraze de acces diferite, derivă două portofele separate: portofelul A și portofelul B.";
"onboarding.passphrase.learn_more.wallets.different" = "Schimbarea chiar și a unui singur caracter semnificativ derivă un seed diferit și, prin urmare, un alt portofel; portofelul inițial rămâne neschimbat.";
"onboarding.passphrase.learn_more.wallets.empty" = "O frază de acces goală deschide portofelul standard derivat numai din fraza de recuperare; o frază de acces nevidă deschide propriul portofel separat.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nu afișează un răspuns de tipul „frază de acces greșită”; fiecare frază de acces este validă, astfel că o greșeală de tastare deschide în tăcere un alt portofel, de obicei cu sold zero.";
"onboarding.passphrase.learn_more.security.section" = "Cum adaugă protecție o frază de acces";
"onboarding.passphrase.learn_more.security.words.title" = "Cuvintele de recuperare nu sunt suficiente";
"onboarding.passphrase.learn_more.security.words.detail" = "Cine obține numai fraza ta de recuperare are în continuare nevoie de fraza de acces exactă pentru a deriva și accesa portofelul protejat.";
"onboarding.passphrase.learn_more.security.strength.title" = "Robustețea oferă o separare mai bună";
"onboarding.passphrase.learn_more.security.strength.detail" = "O frază de acces lungă și imprevizibilă face ghicirea mult mai dificilă; un citat scurt, o dată de naștere, un nume sau o parolă reutilizată pot fi ghicite rapid și oferă protecție redusă.";
"onboarding.passphrase.learn_more.security.separation.title" = "Păstrează separat fraza de acces";
"onboarding.passphrase.learn_more.security.separation.detail" = "Păstrează fraza de acces separat de fraza de recuperare, astfel încât o singură copie de rezervă furată să nu dezvăluie ambele secrete necesare restaurării portofelului.";
"onboarding.passphrase.learn_more.security.footer" = "O frază de acces nu îți poate proteja fondurile dacă ambele secrete sunt expuse, dacă fraza de acces este slabă sau dacă un software compromis o interceptează în timp ce o tastezi.";
"onboarding.passphrase.learn_more.safety.section" = "Folosește în siguranță această funcție";
"onboarding.passphrase.learn_more.safety.strong.title" = "Creează o frază de acces puternică și unică";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Alege mai multe cuvinte aleatorii sau altă valoare cu entropie ridicată, unică pentru acest portofel. Evită datele personale, expresiile familiare, tiparele și parolele folosite în altă parte.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Păstrează separat o copie a frazei de acces";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Creează offline o copie durabilă a frazei de acces exacte, păstreaz-o separat de fraza de recuperare și nu te baza niciodată numai pe memorie.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Fiecare caracter schimbă portofelul";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Reintrodu fraza de acces exact așa cum ai creat-o, inclusiv toate majusculele, spațiile, semnele de punctuație și cuvintele. Orice diferență derivă în tăcere un alt portofel.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Verifică recuperarea înainte de a depune fonduri";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Înainte de a primi fonduri importante, efectuează în privat un test de recuperare controlat pentru a confirma că fraza de recuperare și fraza de acces recreează adresele așteptate.";
"onboarding.passphrase.learn_more.safety.footer" = "Niciun serviciu nu poate reseta sau recupera o frază de acces pierdută. Fără fraza exactă, accesul la acel portofel este pierdut definitiv, chiar dacă încă deții fraza de recuperare.";
