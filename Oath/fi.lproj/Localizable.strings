"settings.about.history.v355.build58.fields" = "Tapahtumien ja lähetyksen kentissä käytetään tavallisia tekstivärejä. Nuolet näkyvät vain riveillä, jotka avaavat näytön tai paneelin; summien ja maksujen yksikkö vaihtuu edelleen napauttamalla.";
"settings.about.history.v355.build58.banners" = "Kun vahvistuksen etenemisestä tai valmistumisesta kertova ilmoitus on näytetty, se katoaa 3 sekunnin kuluttua myös siirtyessäsi toiselle näytölle. Vielä näyttämättömät vahvistukset näkyvät palatessasi.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON-siirroissa varataan nyt aktivointi- ja kaistanleveysmaksut ennen lähetettävän summan laskemista, myös enimmäissummaa lähetettäessä. Tarkistusnäkymä näyttää oikean summan maksujen vähentämisen jälkeen.";
"settings.about.history.v355.build59.fees" = "Mukautettujen TRON-maksujen on katettava vaaditut verkkokulut. Kun TRX-saldo on pieni, näytetään nyt selkeämmät ohjeet. Tokenien määrä pysyy ennallaan; maksut maksetaan TRX:nä.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Uusi tervetuloa";
"settings.about.history.v356.welcome" = "Uusi tervetulonäyttö, jossa on animoituja taideteoksia ja selkeät vaihtoehdot lompakon luomiseen tai tuontiin.";
"settings.about.history.v357.tour.title" = "Tervetulokierros";
"settings.about.history.v357.tour" = "Viisisivuinen kierros esittelee tuetut verkot, fyysisen entropian, lähettämisen ja vastaanottamisen, turvallisuuden ja vahvistetut koontiversiot. Vaihda sivua pyyhkäisemällä tai napauttamalla pisteitä; kielen vaihto on navigointipalkissa.";
"settings.about.history.v357.backup" = "Lompakon luomisen, tuonnin tai palautuksen jälkeen näyttö avautuu heti ja sen varmuuskopiovaihtoehdot käyttävät vakioluetteloa. iCloud-tarkistus tehdään taustalla, ja Avaa lompakko on valmis heti, kun lompakko on tallennettu.";
"settings.about.history.v357.reliability" = "Taustalta palaaminen ei enää sulje asennusnäyttöä, kun piilotettu palautusnäyttö vanhenee, ja kaikkien tietojen poistaminen avaa tervetulonäytön suoraan.";
"settings.about.history.v357.notifications" = "Ilmoitusasetukset käyttävät luokille ja tilalle selkeämpiä sanamuotoja ilman teknisiä yksityiskohtia.";
"settings.about.history.v357.wallets" = "Järjestä lompakot vaihtimessa pitkällä painalluksella järjestelmän nostoanimaatiolla; rivin napautus aktivoi sen. Palautuslauseen vahvistus numeroi jokaisen sanan, ja Return siirtyy seuraavaan kenttään.";
"settings.about.history.v357.send" = "Lähetys näyttää summan siirron ollessa käynnissä, selkeämpi viesti ilmestyy, jos lähetys ei onnistu, ja TRON-pyynnöt yritetään automaattisesti uudelleen tilapäisten palveluntarjoajavirheiden jälkeen.";
"settings.about.history.v357.security" = "Tuodut TRON-tilit, joiden omistajaoikeus on siirretty toiselle avaimelle, näyttävät nyt varoituksen eivätkä voi lähettää, vaikka jokaisessa oikeudessa olisi vain yksi avain. Useampia tunnettuja paljastuneita palautuslauseita ja yksityisiä avaimia hylätään tuonnissa.";
"settings.about.history.v356.localization" = "Aloitusnäytön tekstit ovat nyt luontevampia ja selkeämpiä kaikilla tuetuilla kielillä.";
"settings.about.history.v356.pricing" = "Token-hinnat vastaavat nyt tarkkaa verkko- ja tunnuksen osoitetta. Käytä ensin DEX-hintoja. Pienet hinnat näkyvät 8 desimaalin tarkkuudella ilman pyöristystä.";
"settings.about.history.v356.appearance" = "Ensisijaiset ja toissijaiset painikkeet käyttävät nyt yhdenmukaisia korkeuksia ja näytön marginaaleja, ja järjestelmän sininen ensisijaiset toiminnot.";
"settings.about.history.v356.transactions" = "Tapahtumatiedoissa käytetään lyhyempää Vahvistettu-tilaa ja selkeämpää harmaata tekstiä päivämäärille, osoitteille, summille ja tapahtumatunnuksille.";
"settings.about.history.v356.security" = "Laajensi tunnettujen paljastuneiden palautuslausekkeiden ja yksityisten avainten luetteloa, joita ei voi tuoda.";

