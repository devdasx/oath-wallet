"onboarding.carousel.open_source.visual.accessibility" = "Kaavio osoittaa, että julkaisun vahvistaminen edellyttää julkista lähdekoodia, riippumatonta uudelleenkoontia ja vastaavia sormenjälkiä.";
"onboarding.carousel.passphrase.eyebrow" = "VALINNAINEN BIP-39-TUNNUSLAUSE";
"onboarding.carousel.passphrase.title" = "Yksi palautuslause. Yksi lisäsalaisuus.";
"onboarding.carousel.passphrase.message" = "BIP-39-tunnuslause yhdistyy palautuslauseeseesi ja johtaa erillisen lompakon. Vaikka palautussanat paljastuisivat, lompakon käyttö edellyttää yhä täsmälleen oikeaa tunnuslausetta.";
"onboarding.carousel.passphrase.visual.phrase" = "24 palautussanaasi";
"onboarding.carousel.passphrase.visual.passphrase" = "Salainen lisätunnuslauseesi";
"onboarding.carousel.passphrase.visual.output" = "Erillinen tunnuslauselompakko";
"onboarding.carousel.passphrase.visual.requirement" = "Palautukseen tarvitaan molemmat salaisuudet";
"onboarding.carousel.passphrase.visual.accessibility" = "24 sanan palautuslause ja salainen BIP-39-tunnuslause johtavat erillisen lompakon, jonka palauttamiseen tarvitaan molemmat salaisuudet.";
"onboarding.carousel.passphrase.learn_more.action" = "Tutustu tarkemmin";
"onboarding.passphrase.learn_more.navigation" = "BIP-39-tunnuslauseiden perusteet";
"onboarding.passphrase.learn_more.path.section" = "Kaksi salaisuutta, yksi lompakko";
"onboarding.passphrase.learn_more.overview" = "BIP-39-tunnuslause on valinnainen salaisuus, joka yhdistetään palautuslauseeseesi. Yhdessä ne johtavat deterministisesti lompakon, joka poikkeaa pelkällä palautuslauseella luodusta lompakosta.";
"onboarding.passphrase.learn_more.visual.phrase" = "24 sanan palautuslauseesi";
"onboarding.passphrase.learn_more.visual.passphrase" = "Salainen tunnuslauseesi";
"onboarding.passphrase.learn_more.visual.wallet" = "Tunnuslauseella suojattu lompakko";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 sanan palautuslause ja salainen tunnuslause johtavat erillisen, tunnuslauseella suojatun lompakon.";
"onboarding.passphrase.learn_more.derivation.section" = "Näin BIP-39 johtaa lompakon";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Palautuslause yhdistettynä tunnuslauseeseen";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2 048 kierrosta";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bittinen pääsiemen";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Johdetut lompakkotilit ja osoitteet";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Palautuslauseesi ja tunnuslauseesi käsitellään 2 048 PBKDF2-HMAC-SHA512-kierroksella. Tuloksena syntyy 512-bittinen siemen, josta lompakkotilit ja osoitteet johdetaan.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 käyttää normalisoitua palautuslausetta PBKDF2-salasanana ja suolana sanaa “mnemonic”, jota seuraa normalisoitu tunnuslause. 2 048 PBKDF2-HMAC-SHA512-kierroksen jälkeen prosessi tuottaa 64-tavuisen siemenen.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Ennen siemenen johtamista Oath käyttää BIP-39:n edellyttämää Unicode-normalisointia, jotta sama normalisoitu palautuslause ja tunnuslause tuottavat aina saman lompakon.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Tunnuslause ei salaa palautussanojasi. Se muuttaa johdettua siementä, joten jokainen eri tunnuslause tuottaa eri tilit ja osoitteet.";
"onboarding.passphrase.learn_more.wallets.section" = "Jokainen tunnuslause johtaa erillisen lompakon";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Esimerkkitunnuslause 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Esimerkkitunnuslause 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Esimerkkilompakko A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Esimerkkilompakko B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Sama palautuslause yhdistettynä kahteen eri tunnuslauseeseen johtaa kaksi erillistä lompakkoa: lompakon A ja lompakon B.";
"onboarding.passphrase.learn_more.wallets.different" = "Yhdenkin merkin muuttaminen johtaa eri siemenen ja siten eri lompakon. Alkuperäinen lompakko pysyy ennallaan.";
"onboarding.passphrase.learn_more.wallets.empty" = "Tyhjä tunnuslause avaa pelkän palautuslauseesta johdetun vakiolompakon. Ei-tyhjä tunnuslause avaa oman erillisen lompakon.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 ei ilmoita \"väärästä tunnuslauseesta\". Jokainen tunnuslause on kelvollinen, joten kirjoitusvirhe avaa huomaamatta toisen lompakon, jonka saldo on yleensä nolla.";
"onboarding.passphrase.learn_more.security.section" = "Näin tunnuslause lisää suojaa";
"onboarding.passphrase.learn_more.security.words.title" = "Palautussanat eivät riitä";
"onboarding.passphrase.learn_more.security.words.detail" = "Jos joku saa vain palautuslauseen, hän tarvitsee silti tarkan tunnuslauseen suojatun lompakon johtamiseen ja käyttämiseen.";
"onboarding.passphrase.learn_more.security.strength.title" = "Vahvuus erottaa lompakot paremmin";
"onboarding.passphrase.learn_more.security.strength.detail" = "Pitkä ja ennalta arvaamaton tunnuslause vaikeuttaa arvaamista merkittävästi. Lyhyt lainaus, syntymäpäivä, nimi tai muualla käytetty salasana voidaan arvata nopeasti, eikä se juuri suojaa.";
"onboarding.passphrase.learn_more.security.separation.title" = "Säilytä tunnuslause erillään";
"onboarding.passphrase.learn_more.security.separation.detail" = "Säilytä tunnuslause erillään palautuslauseesta, jotta yksi varastettu varmuuskopio ei paljasta molempia lompakon palauttamiseen tarvittavia salaisuuksia.";
"onboarding.passphrase.learn_more.security.footer" = "Tunnuslause ei suojaa varojasi, jos molemmat salaisuudet paljastuvat, tunnuslause on heikko tai vaarantunut ohjelmisto sieppaa sen kirjoittamisen aikana.";
"onboarding.passphrase.learn_more.safety.section" = "Käytä ominaisuutta turvallisesti";
"onboarding.passphrase.learn_more.safety.strong.title" = "Luo vahva ja yksilöllinen tunnuslause";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Valitse useita satunnaisia sanoja tai muu suuren entropian arvo, jota käytät vain tässä lompakossa. Vältä henkilötietoja, tuttuja ilmauksia, kuvioita ja muualla käyttämiäsi salasanoja.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Varmuuskopioi tunnuslause erikseen";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Tee tarkasta tunnuslauseesta kestävä offline-kopio, säilytä se erillään palautuslauseesta äläkä koskaan luota vain muistiisi.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Jokainen merkki muuttaa lompakon";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Kirjoita tunnuslause uudelleen täsmälleen luodussa muodossa, kaikki isot kirjaimet, välilyönnit, välimerkit ja sanat mukaan lukien. Pienikin ero johtaa huomaamatta eri lompakon.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Vahvista palautus ennen varojen lisäämistä";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Ennen kuin vastaanotat huomattavia varoja, varmista yksityisellä ja hallitulla palautustestillä, että palautuslause ja tunnuslause luovat uudelleen odotetut osoitteet.";
"onboarding.passphrase.learn_more.safety.footer" = "Mikään palvelu ei voi nollata tai palauttaa kadonnutta tunnuslausetta. Ilman täsmälleen oikeaa tunnuslausetta menetät pysyvästi pääsyn lompakkoon, vaikka palautuslause olisi yhä tallessa.";
