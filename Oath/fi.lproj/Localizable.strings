"onboarding.carousel.entropy.eyebrow" = "ENTROPIAA FYYSISISTÄ SYÖTTEISTÄ";
"onboarding.carousel.entropy.title" = "Luo täysin hallitsemaasi satunnaisuutta.";
"onboarding.carousel.entropy.message" = "Heitä noppaa tai kolikkoa tai kirjaa satunnaisia numeroita. Oath muuntaa fyysisen syötteesi täsmälleen 256 entropiabitiksi 24 sanan palautuslausetta varten kokonaan laitteellasi.";
"onboarding.carousel.entropy.visual.output" = "256 bittiä käyttäjän luomaa entropiaa";
"onboarding.carousel.entropy.visual.local" = "Luotu kokonaan kirjaamistasi syötteistä";
"onboarding.carousel.entropy.visual.accessibility" = "Numeroitu kuusisivuinen noppa, kolikko ja satunnaiset numerot yhdistyvät täydelliseksi 256-bittiseksi lompakon entropia-arvoksi tässä laitteessa.";
"onboarding.carousel.entropy.learn_more.action" = "Tutustu tarkemmin";
"onboarding.entropy.learn_more.navigation" = "Näin fyysinen entropia toimii";
"onboarding.entropy.learn_more.path.section" = "Fyysisistä tuloksista palautussanoiksi";
"onboarding.entropy.learn_more.overview" = "Oath kirjaa valitsemasi fyysisen lähteen tulokset ja muuntaa ne 256-bittiseksi arvoksi. Tuloksena saadut 32 tavua välitetään sitten Wallet Corelle tavallisen BIP-39-palautuslauseen luomista varten.";
"onboarding.entropy.learn_more.visual.phrase" = "24-sanainen BIP-39-palautuslause";
"onboarding.entropy.learn_more.visual.bits" = "32 tavua × 8 bittiä on 256 bittiä";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Ruudukossa on 256 esimerkkibittiä, jotka on järjestetty 32 tavuksi.";
"onboarding.entropy.learn_more.visual.accessibility" = "Nopanheitot, kolikonheitot tai satunnaiset numerot muunnetaan 256 bitiksi ja sitten 24 sanan BIP-39-palautuslauseeksi.";
"onboarding.entropy.learn_more.inputs.section" = "Vaihe 1: kirjaa fyysiset tulokset";
"onboarding.entropy.learn_more.inputs.dice.title" = "Heitä tasapainoista kuusisivuista noppaa";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Tasapainoisella nopalla silmäluvut 1–4 tuottavat kukin 2 bittiä ja silmäluvut 5–6 kukin 1 bitin.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fyysiset kolikonheitot";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Jokainen tasapuolinen ja riippumaton kolikonheitto tuottaa yhden harhattoman entropiabitin.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Kirjaa satunnaisia numeroita";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Numerot 0–7 muodostavat kukin 3 bittiä. Numerot 8–9 antavat kukin 1 bitin. Numeroiden on tultava aidosti satunnaisesta fyysisestä prosessista.";
"onboarding.entropy.learn_more.inputs.footer" = "Käytä tasapuolista fyysistä lähdettä ja kirjaa jokainen tulos järjestyksessä. Voit vaihtaa syöttötapaa, sillä jokainen hyväksytty tulos lisätään samaan bittivirtaan.";
"onboarding.entropy.learn_more.conversion.section" = "2. Kokoa 256-bittinen arvo";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath muuntaa nopan tulokset ja desimaalinumerot harhattomiksi kahden potensseihin perustuviksi ryhmiksi. Tuotettujen bittien määrä voi vaihdella, mutta tasapuolinen fyysinen lähde ei suosi mitään bittiarvoa.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath lisää bitit syöttöjärjestyksessä, kunnes niitä on täsmälleen 256, ja pakkaa ne sitten 32 tavuksi merkitsevin bitti ensin.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Mukautettu entropia sisältää vain kirjaamasi fyysiset syötteet. Oath ei sekoita siihen laitteen luomaa satunnaisuutta.";
"onboarding.entropy.learn_more.bip39.section" = "3. Johda palautuslause";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256-bittinen entropia";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-bittinen BIP-39-tarkistussumma";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bittiä jaettuna 24:ään 11-bittiseen sanaindeksiin";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-bittiseen entropia-arvoon lisätään 8-bittinen tarkistussumma. Näin syntyvät 264 bittiä jaetaan 24:ään 11-bittiseen sanaindeksiin.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 laskee 32-tavuisesta entropia-arvosta SHA-256-tiivisteen ja käyttää tiivisteen ensimmäisiä 8 bittiä tarkistussummana. Tarkistussumman lisääminen tuottaa 264 bittiä.";
"onboarding.entropy.learn_more.bip39.words" = "264 bittiä jaetaan 24 ryhmään, joissa kussakin on 11 bittiä. Kukin ryhmä valitsee yhden sanan tavallisesta 2 048 sanan BIP-39-luettelosta, jolloin syntyy 24 sanan palautuslause.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core johtaa tuloksena saadusta siemenestä deterministiset tilit ja osoitteet. Sama palautuslause ja valinnainen tunnuslause luovat aina saman lompakon uudelleen.";
"onboarding.entropy.learn_more.security.section" = "Näin mukautettu entropia vahvistaa turvallisuutta";
"onboarding.entropy.learn_more.security.space.title" = "Valtava määrä mahdollisia arvoja";
"onboarding.entropy.learn_more.security.space.detail" = "Tasaisesti jakautunut 256-bittinen entropia sisältää 2^256 yksilöllistä arvoa, joten kaikkien vaihtoehtojen kokeileminen ei ole laskennallisesti toteuttamiskelpoista. Tämä kuvaa syöteavaruuden kokoa eikä tarkoita, että jokaisen salauskomponentin hyökkäyskestävyys olisi 256 bittiä.";
"onboarding.entropy.learn_more.security.source.title" = "Satunnaisuus on peräisin sinulta";
"onboarding.entropy.learn_more.security.source.detail" = "Fyysisten tapahtumien avulla voit hankkia lompakon satunnaisuuden itsenäisesti sen sijaan, että luottaisit vain laitteen satunnaisgeneraattoriin. Tämä auttaa vain silloin, kun tapahtumat ovat todella satunnaisia.";
"onboarding.entropy.learn_more.security.local.title" = "Käsitellään kokonaan tällä laitteella";
"onboarding.entropy.learn_more.security.local.detail" = "Oath muuntaa kirjaamasi sarjan ja luo palautuslauseen kokonaan tällä laitteella. Sarjaasi ei koskaan lähetetä käsiteltäväksi.";
"onboarding.entropy.learn_more.security.patterns.title" = "Vältä itse keksittyjä salaisuuksia";
"onboarding.entropy.learn_more.security.patterns.detail" = "Pitkä sarja tasapuolisia ja riippumattomia tapahtumia on paljon vaikeammin ennustettavissa kuin syntymäpäivät, lempinumerot, toistuvat kuviot tai itse valitut sanat.";
"onboarding.entropy.learn_more.security.footer" = "Fyysinen entropia korvaa laitteen luoman lompakkosatunnaisuuden. Se ei ole ylimääräinen salasana tai suojauskerros.";
"onboarding.entropy.learn_more.safety.section" = "Käytä ominaisuutta turvallisesti";
"onboarding.entropy.learn_more.safety.fair.title" = "Kirjaa tasapuolisia ja riippumattomia tuloksia";
"onboarding.entropy.learn_more.safety.fair.detail" = "Käytä tasapuolista kolikkoa tai noppaa ja varmista, että jokainen tulos on riippumaton. Satunnaisten numeroiden on oltava peräisin aidosta fyysisestä lähteestä, ei muistista tai kuviosta.";
"onboarding.entropy.learn_more.safety.private.title" = "Pidä entropian luonti yksityisenä";
"onboarding.entropy.learn_more.safety.private.detail" = "Suojaa sekä kirjattu sarja että valmis palautuslause lompakon salaisuuksina. Pidä ne poissa kameroiden ja muiden ihmisten näkyvistä.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Kirjaa jokainen tulos tarkasti";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Yksikin puuttuva, kahdesti kirjattu tai väärään järjestykseen asetettu tulos luo eri lompakon. Tarkista jokainen merkintä ja vahvista valmis palautuslause ennen varojen lisäämistä lompakkoon.";
"onboarding.entropy.learn_more.safety.backup.title" = "Suojaa palautuslause";
"onboarding.entropy.learn_more.safety.backup.detail" = "Säilytä palautuslause offline-tilassa äläkä koskaan jaa sitä. Kun olet vahvistanut varmuuskopion, tuhoa turvallisesti kaikki tarpeettomat väliaikaiset syötetietueet.";
"onboarding.entropy.learn_more.safety.footer" = "Fyysinen entropia ei suojaa paljastunutta palautuslausetta, vaarantunutta laitetta, haittaohjelmia tai väärin kirjattua sarjaa. Jos et voi taata tasapuolisia, yksityisiä ja tarkkoja syötteitä, käytä tavallista lompakon luontia.";
"onboarding.carousel.open_source.eyebrow" = "SUUNNITELTU AVOIMEKSI LÄHDEKOODIKSI";
"onboarding.carousel.open_source.title" = "Tarkasta lähdekoodi. Vahvista koontiversio.";
"onboarding.carousel.open_source.message" = "Oath julkaisee lähdekoodinsa riippumatonta tarkastusta varten. Julkaisu on vahvistettu vasta, kun toistettava koontiversio vastaa julkaistun sovelluksen sormenjälkeä.";
"onboarding.carousel.open_source.action.github" = "Tarkastele GitHubissa";
