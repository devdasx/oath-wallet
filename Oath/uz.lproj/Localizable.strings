"onboarding.carousel.entropy.eyebrow" = "JISMONIY MANBALARDAN OLINGAN ENTROPIYA";
"onboarding.carousel.entropy.title" = "To‘liq nazoratingizdagi tasodifiylikni yarating.";
"onboarding.carousel.entropy.message" = "Zar yoki tanga tashlang yoxud tasodifiy raqamlarni qayd eting. Oath bu jismoniy kiritmalarni qurilmangizning o‘zida 24 so‘zli tiklash iborasi uchun aniq 256 bit entropiyaga aylantiradi.";
"onboarding.carousel.entropy.visual.output" = "Foydalanuvchi yaratgan 256 bit entropiya";
"onboarding.carousel.entropy.visual.local" = "Faqat siz qayd etgan kiritmalardan yaratilgan";
"onboarding.carousel.entropy.visual.accessibility" = "Raqamli zar, tanga va tasodifiy raqamlar bu qurilmada 256 bit hamyon entropiyasini hosil qiladi.";
"onboarding.carousel.entropy.learn_more.action" = "Batafsil tanishish";
"onboarding.entropy.learn_more.navigation" = "Jismoniy entropiya qanday ishlaydi";
"onboarding.entropy.learn_more.path.section" = "Jismoniy natijalardan tiklash so‘zlarigacha";
"onboarding.entropy.learn_more.overview" = "Oath siz tanlagan jismoniy manba natijalarini qayd etib, ularni 256 bitli qiymatga aylantiradi. Hosil bo‘lgan 32 bayt standart BIP-39 tiklash iborasini yaratish uchun Wallet Core’ga uzatiladi.";
"onboarding.entropy.learn_more.visual.phrase" = "24 so‘zli BIP-39 tiklash iborasi";
"onboarding.entropy.learn_more.visual.bits" = "32 bayt × 8 bit = 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 baytga joylangan 256 ta namunaviy bit katakdan iborat to‘r.";
"onboarding.entropy.learn_more.visual.accessibility" = "Zar yoki tanga tashlash natijalari yoxud tasodifiy raqamlar 256 bitga, so‘ng 24 so‘zli BIP-39 tiklash iborasiga aylantiriladi.";
"onboarding.entropy.learn_more.inputs.section" = "1-qadam: jismoniy natijalarni qayd eting";
"onboarding.entropy.learn_more.inputs.dice.title" = "Xolis olti qirrali zarni tashlang";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Xolis zarning 1–4 yoqlari har biri 2 bit, 5–6 yoqlari esa har biri 1 bit beradi.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Tangani jismonan tashlash";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Xolis va mustaqil tashlangan tanganing har bir natijasi entropiyaga bitta og‘ishsiz bit qo‘shadi.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Tasodifiy raqamlarni qayd eting";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 raqamlarining har biri 3 bit, 8–9 raqamlarining har biri 1 bit beradi. Raqamlar chinakam tasodifiy jismoniy jarayondan olinishi shart.";
"onboarding.entropy.learn_more.inputs.footer" = "Xolis jismoniy manbadan foydalaning va har bir natijani tartib bilan qayd eting. Kiritish usullarini almashtirishingiz mumkin, chunki har bir qabul qilingan natija ayni bit oqimiga qo‘shiladi.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256 bitli qiymatni yig‘ing";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath zar natijalari va o‘nlik raqamlarni og‘ishsiz, ikkilik darajali guruhlarga aylantiradi. Qo‘shiladigan bitlar soni farq qilishi mumkin, ammo jismoniy manba xolis bo‘lsa, hech bir bit qiymatiga ustunlik berilmaydi.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath bitlarni kiritilgan tartibda aniq 256 taga yetguncha qo‘shadi, so‘ng eng katta razryadli bitdan boshlab ularni 32 baytga joylaydi.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Maxsus entropiya faqat siz qayd etgan jismoniy kiritmalardan iborat; Oath unga qurilma yaratgan tasodifiylikni qo‘shmaydi.";
"onboarding.entropy.learn_more.bip39.section" = "3. Tiklash iborasini hosil qiling";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitli entropiya";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8 bitli BIP-39 nazorat summasi";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit 11 bitli 24 ta so‘z indeksiga bo‘linadi";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256 bitli entropiya qiymatiga 8 bitli nazorat summasi qo‘shilib, 264 bit hosil bo‘ladi va u 11 bitli 24 ta so‘z indeksiga bo‘linadi.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 32 baytli entropiya qiymati uchun SHA-256 hisoblaydi va xeshning dastlabki 8 bitini nazorat summasi sifatida oladi; nazorat summasi qo‘shilgach, 264 bit hosil bo‘ladi.";
"onboarding.entropy.learn_more.bip39.words" = "264 bit 11 bitli 24 ta guruhga bo‘linadi. Har bir guruh standart 2,048 so‘zli BIP-39 ro‘yxatidan bitta yozuvni tanlaydi va 24 so‘zli tiklash iborasi hosil bo‘ladi.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core hosil bo‘lgan seed’dan deterministik hisoblar va manzillarni yaratadi. Bir xil tiklash iborasi va ixtiyoriy maxfiy ibora har doim ayni hamyonni qayta yaratadi.";
"onboarding.entropy.learn_more.security.section" = "Maxsus entropiya xavfsizlikni qanday kuchaytiradi";
"onboarding.entropy.learn_more.security.space.title" = "Ulkan imkoniyatlar makoni";
"onboarding.entropy.learn_more.security.space.detail" = "Bir tekis taqsimlangan 256 bitli entropiya 2^256 ta noyob qiymatga ega, shu bois ularning barchasini taxmin qilish hisoblash nuqtayi nazaridan imkonsizdir. Bu kirish qiymatlari makonining kattaligini bildiradi; har bir kriptografik komponent 256 bitli hujumga chidamli degani emas.";
"onboarding.entropy.learn_more.security.source.title" = "Tasodifiylikni siz yaratasiz";
"onboarding.entropy.learn_more.security.source.detail" = "Jismoniy hodisalar hamyon tasodifiyligini faqat qurilmadagi tasodifiy sonlar generatoriga tayanmasdan, mustaqil manbadan olish imkonini beradi. Bu hodisalar chinakam tasodifiy bo‘lsagina xavfsizlikni yaxshilaydi.";
"onboarding.entropy.learn_more.security.local.title" = "Butunlay shu qurilmada qayta ishlanadi";
"onboarding.entropy.learn_more.security.local.detail" = "Oath qayd etilgan ketma-ketlikni o‘zgartirib, tiklash iborasini butunlay shu qurilmada yaratadi. Ketma-ketlik qayta ishlash uchun hech qayerga yuborilmaydi.";
"onboarding.entropy.learn_more.security.patterns.title" = "Inson tanlagan sirlardan saqlaning";
"onboarding.entropy.learn_more.security.patterns.detail" = "Xolis va mustaqil hodisalarning uzun ketma-ketligini tug‘ilgan sanalar, sevimli raqamlar, takroriy andozalar yoki inson tanlagan so‘zlarga qaraganda ancha qiyin taxmin qilish mumkin.";
"onboarding.entropy.learn_more.security.footer" = "Jismoniy entropiya qurilma yaratadigan hamyon tasodifiyligining o‘rnini bosadi; u qo‘shimcha parol yoki xavfsizlik qatlami emas.";
"onboarding.entropy.learn_more.safety.section" = "Bu funksiyadan xavfsiz foydalaning";
"onboarding.entropy.learn_more.safety.fair.title" = "Xolis va mustaqil natijalarni qayd eting";
"onboarding.entropy.learn_more.safety.fair.detail" = "Xolis tanga yoki zardan foydalaning va har bir natija mustaqil bo‘lishini ta’minlang. Tasodifiy raqamlar xotira yoki andozadan emas, chinakam jismoniy manbadan olinishi kerak.";
"onboarding.entropy.learn_more.safety.private.title" = "Entropiya yaratish jarayonini sir saqlang";
"onboarding.entropy.learn_more.safety.private.detail" = "Qayd etilgan ketma-ketlikni ham, tayyor tiklash iborasini ham hamyon siri sifatida himoyalang. Ularni kamera va boshqa odamlar ko‘rishidan saqlang.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Har bir natijani aniq qayd eting";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Bitta tushirib qoldirilgan, takrorlangan yoki o‘rni almashtirilgan natija boshqa hamyon yaratadi. Hamyonga mablag‘ kiritishdan oldin har bir yozuvni ko‘rib chiqing va tayyor tiklash iborasini tekshiring.";
"onboarding.entropy.learn_more.safety.backup.title" = "Tiklash iborasini himoyalang";
"onboarding.entropy.learn_more.safety.backup.detail" = "Tiklash iborasini oflayn saqlang va hech kimga bermang. Zaxira nusxasini tekshirgach, endi kerak bo‘lmagan oraliq kiritma yozuvlarini xavfsiz yo‘q qiling.";
"onboarding.entropy.learn_more.safety.footer" = "Jismoniy entropiya oshkor bo‘lgan tiklash iborasidan, buzilgan qurilmadan, zararli dasturdan yoki noto‘g‘ri qayd etilgan ketma-ketlikdan himoya qilmaydi. Xolis, maxfiy va aniq kiritmalarni kafolatlay olmasangiz, standart hamyon yaratish usulidan foydalaning.";
"onboarding.carousel.open_source.eyebrow" = "OCHIQ MANBALI DIZAYN";
"onboarding.carousel.open_source.title" = "Manba kodini ko‘ring. Ilova to‘plamini tekshiring.";
"onboarding.carousel.open_source.message" = "Oath manba kodini mustaqil tekshirish uchun e’lon qiladi. Reliz faqat takrorlanuvchi yig‘ilma e’lon qilingan ilovaning raqamli iziga mos kelsagina tasdiqlanadi.";
