"onboarding.carousel.open_source.visual.match" = "MOSLIK TASDIQLANDI — YIG‘ILMA TEKSHIRILDI";
"onboarding.carousel.open_source.visual.accessibility" = "Relizni tekshirish uchun ochiq manba kodi, mustaqil qayta yig‘ish va mos raqamli izlar talab qilinishini ko‘rsatuvchi diagramma.";
"onboarding.carousel.passphrase.eyebrow" = "IXTIYORIY BIP-39 MAXFIY IBORASI";
"onboarding.carousel.passphrase.title" = "Bitta tiklash iborasi. Yana bitta sir.";
"onboarding.carousel.passphrase.message" = "BIP-39 maxfiy iborasi tiklash iborangiz bilan birga alohida hamyon hosil qiladi. Tiklash so‘zlari oshkor bo‘lsa ham, bu hamyonga kirish uchun aynan o‘sha maxfiy ibora kerak bo‘ladi.";
"onboarding.carousel.passphrase.visual.phrase" = "Sizning 24 ta tiklash so‘zingiz";
"onboarding.carousel.passphrase.visual.passphrase" = "Qo‘shimcha maxfiy iborangiz";
"onboarding.carousel.passphrase.visual.output" = "Alohida maxfiy iborali hamyon";
"onboarding.carousel.passphrase.visual.requirement" = "Tiklash uchun ikkala sir ham kerak";
"onboarding.carousel.passphrase.visual.accessibility" = "24 so‘zli tiklash iborasi va maxfiy BIP-39 iborasi birga alohida hamyon hosil qiladi; uni tiklash uchun ikkala sir ham kerak.";
"onboarding.carousel.passphrase.learn_more.action" = "Batafsil tanishish";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 maxfiy iboralari haqida";
"onboarding.passphrase.learn_more.path.section" = "Ikki sir bitta hamyonni hosil qiladi";
"onboarding.passphrase.learn_more.overview" = "BIP-39 maxfiy iborasi — tiklash iborasi bilan birlashtiriladigan ixtiyoriy sir. Ular birga faqat tiklash iborasidan yaratiladigan hamyondan farqli hamyonni deterministik tarzda hosil qiladi.";
"onboarding.passphrase.learn_more.visual.phrase" = "24 so‘zli tiklash iborangiz";
"onboarding.passphrase.learn_more.visual.passphrase" = "Maxfiy iborangiz";
"onboarding.passphrase.learn_more.visual.wallet" = "Maxfiy ibora bilan himoyalangan hamyon";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 so‘zli tiklash iborasi va maxfiy ibora birga alohida, maxfiy ibora bilan himoyalangan hamyonni hosil qiladi.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 hamyonni qanday hosil qiladi";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Tiklash iborasi va maxfiy ibora birikmasi";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512, 2,048 raund";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512 bitli asosiy seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Hosil qilingan hamyon hisoblari va manzillari";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Tiklash iborangiz va maxfiy iborangiz PBKDF2-HMAC-SHA512’ning 2,048 raundidan o‘tib, hamyon hisoblari va manzillari hosil qilinadigan 512 bitli seed’ni yaratadi.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 normallashtirilgan tiklash iborasini PBKDF2 paroli, “mnemonic” so‘zidan keyingi normallashtirilgan maxfiy iborani esa salt sifatida ishlatadi. PBKDF2-HMAC-SHA512’ning 2,048 raundidan so‘ng 64 baytli seed hosil bo‘ladi.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Seed’ni hosil qilishdan oldin Oath BIP-39 talab qiladigan Unicode normallashtirishni qo‘llaydi, shu sababli bir xil normallashtirilgan tiklash iborasi va maxfiy ibora har doim ayni hamyonni qayta yaratadi.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Maxfiy ibora tiklash so‘zlaringizni shifrlamaydi. U hosil qilinadigan seed’ni o‘zgartiradi, shu sababli har bir boshqa maxfiy ibora boshqa hisoblar va manzillar yaratadi.";
"onboarding.passphrase.learn_more.wallets.section" = "Har bir maxfiy ibora alohida hamyon hosil qiladi";
"onboarding.passphrase.learn_more.wallets.visual.one" = "1-namunaviy maxfiy ibora";
"onboarding.passphrase.learn_more.wallets.visual.two" = "2-namunaviy maxfiy ibora";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "A namunaviy hamyoni";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "B namunaviy hamyoni";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Bir xil tiklash iborasi ikki xil maxfiy ibora bilan birlashtirilib, ikkita alohida hamyonni — A va B hamyonlarini hosil qiladi.";
"onboarding.passphrase.learn_more.wallets.different" = "Hatto bitta ahamiyatli belgini o‘zgartirish boshqa seed va shu tariqa boshqa hamyon hosil qiladi; asl hamyon o‘zgarishsiz qoladi.";
"onboarding.passphrase.learn_more.wallets.empty" = "Bo‘sh maxfiy ibora faqat tiklash iborasidan hosil qilingan standart hamyonni ochadi; bo‘sh bo‘lmagan maxfiy ibora esa o‘zining alohida hamyonini ochadi.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39’da “noto‘g‘ri maxfiy ibora” degan javob yo‘q; har bir maxfiy ibora yaroqli, shu sababli yozuv xatosi odatda balansi nol bo‘lgan boshqa hamyonni bildirmasdan ochadi.";
"onboarding.passphrase.learn_more.security.section" = "Maxfiy ibora himoyani qanday kuchaytiradi";
"onboarding.passphrase.learn_more.security.words.title" = "Faqat tiklash so‘zlari yetarli emas";
"onboarding.passphrase.learn_more.security.words.detail" = "Faqat tiklash iborangizni qo‘lga kiritgan kishi himoyalangan hamyonni hosil qilish va unga kirish uchun aynan o‘sha maxfiy iboraga ham muhtoj bo‘ladi.";
"onboarding.passphrase.learn_more.security.strength.title" = "Kuchli ibora yaxshiroq ajratadi";
"onboarding.passphrase.learn_more.security.strength.detail" = "Uzun va oldindan aytib bo‘lmaydigan maxfiy iborani taxmin qilish ancha qiyin; qisqa iqtibos, tug‘ilgan sana, ism yoki qayta ishlatilgan parol tez topilishi va juda kam himoya berishi mumkin.";
"onboarding.passphrase.learn_more.security.separation.title" = "Maxfiy iborani alohida saqlang";
"onboarding.passphrase.learn_more.security.separation.detail" = "Maxfiy iborani tiklash iborasidan alohida saqlang, shunda bitta o‘g‘irlangan zaxira nusxasi hamyonni tiklash uchun kerakli ikkala sirni ham oshkor qilmaydi.";
"onboarding.passphrase.learn_more.security.footer" = "Ikkala sir ham oshkor bo‘lsa, maxfiy ibora zaif bo‘lsa yoki buzilgan dastur uni kiritish paytida tutib olsa, maxfiy ibora mablag‘laringizni himoya qila olmaydi.";
"onboarding.passphrase.learn_more.safety.section" = "Bu funksiyadan xavfsiz foydalaning";
"onboarding.passphrase.learn_more.safety.strong.title" = "Kuchli va noyob maxfiy ibora yarating";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Faqat shu hamyonga xos bir nechta tasodifiy so‘z yoki boshqa yuqori entropiyali qiymatni tanlang. Shaxsiy ma’lumotlar, tanish iboralar, andozalar va boshqa joyda ishlatilgan parollardan saqlaning.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Maxfiy iborani alohida zaxiralang";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Aynan o‘sha maxfiy iboraning ishonchli oflayn nusxasini yarating, uni tiklash iborasidan alohida saqlang va faqat xotirangizga tayanmang.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Har bir belgi hamyonni o‘zgartiradi";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Maxfiy iborani yaratilganidek aniq qayta kiriting: har bir bosh harf, bo‘shliq, tinish belgisi va so‘zni saqlang. Har qanday farq bildirmasdan boshqa hamyonni hosil qiladi.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Mablag‘ qo‘shishdan oldin tiklashni tekshiring";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Katta miqdorda mablag‘ olishdan oldin tiklash iborasi va maxfiy ibora kutilgan manzillarni qayta yaratishini maxfiy va nazoratli tiklash sinovi orqali tekshiring.";
"onboarding.passphrase.learn_more.safety.footer" = "Yo‘qolgan maxfiy iborani hech bir xizmat qayta o‘rnata yoki tiklay olmaydi. Tiklash iborasi sizda qolgan taqdirda ham, aniq maxfiy iborasiz bu hamyonga kirish butunlay yo‘qoladi.";
