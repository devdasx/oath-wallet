// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Tasdiqlash tugmasi o‘rniga surib yuborish qo‘shildi. Yo‘nalish animatsiyasi, taktil aloqa va ravon harakat har ikki o‘qish yo‘nalishini qo‘llaydi. Yuborish uchun 90% yoki undan keyin qo‘yib yuboring; bekor qilish uchun orqaga suring.";
"settings.about.history.v355.build56.activity" = "Qo‘ng‘iroq kutilayotgan faollikni ochadi. Tranzaksiya kapsulalari holat nishonlarini ko‘rsatadi va surib yashiriladi. Tasdiqlanayotgan va tasdiqlangan kapsulalar 3 soniyadan so‘ng yashiriladi; tasdiqlash ayni ko‘rinib turgan kapsulani yangilaydi.";
"settings.about.history.v355.build56.status" = "Barcha qo‘llanadigan tarmoqlarda ishonchliroq tranzaksiya holati, jonli tafsilotlar va yuborishdan keyin tezroq balans yangilanishi. Ilova qayta ochilganda kutilayotgan tranzaksiyalarni kuzatish davom etadi.";
"settings.about.history.v355.build56.fees" = "Ayni o‘tkazmani tekshirishga qaytishda tayyor komissiya saqlanadi. Komissiya yuklanishi va hisobni mablag‘ bilan ta’minlash ogohlantirishlari aniqroq; yetarli summada faollashtirish xabarlari ko‘rsatilmaydi.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin va Dogecoin chang chegarasidan kam qaytimni yaroqsiz chiqish yaratish o‘rniga komissiyaga qo‘shadi. Tekshirilgan komissiya imzolashdagi komissiyaga mos keladi.";
"settings.about.history.v355.build56.stability" = "Fon vazifasining qulash xatosi va hamyonni yangilash vaqti tugashi haqidagi ogohlantirishlar tuzatildi. Vaqtinchalik yangilash xatolarida mavjud hamyon ma’lumotlari ochiq qoladi.";
"settings.about.history.v355.build56.backup" = "Ochilgandanoq to‘g‘ri sarlavha va kamroq xabarlarga ega tartibli zaxira ekranlari. Maxfiy kalitga kirish Ilova qulfi sozlamalariga amal qiladi. Ixcham shishasimon import ogohlantirishlari boshqa tiklash iborasini tanlaganingizda rad etilgan kiritmani tozalaydi.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Yuborish slayderini qo‘yib yuborganingizdan so‘ng, tekshirish ekrani yopilishidan oldin animatsiyali tasdiq belgisi ko‘rinadi.";
"settings.about.history.v355.build57.activity" = "Faollik qatorlarida holat ingichkaroq shriftda, miqdor taglavha sifatida va tranzaksiya tafsilotlarini ochish uchun strelka ko‘rsatiladi.";
"settings.about.history.v355.build57.details" = "Tarmoq to‘lovlari endi o‘tkazma xulosasida ko‘rsatiladi. Qisqaroq yorliqlar va tarmoqning bitta qatorda ko‘rsatilishi tafsilotlarni tushunarliroq qiladi.";
"settings.about.history.v355.build57.resume" = "Fondan qaytilganda ochiq ekranlar va panellar, jumladan o‘tkazmani tekshirish va tranzaksiya tafsilotlari saqlanadi.";
"settings.about.history.v355.build57.secrets" = "Tiklash iborasi, maxfiy kalit va parol iborasi ekranlari ilovadan 20 soniya uzoqda bo‘lgandan so‘ng yopiladi. Ilova qulfi sozlamalaringizga amal qilishda davom etadi.";
"settings.about.history.v355.build57.filters" = "Tarmoq filtrlari biroz balandroq tizim tugmalaridan, mazmunga mos o‘lchamdan va navigatsiya paneli ostidagi tuzatilgan oraliqdan foydalanadi.";
"settings.about.history.v355.build57.units" = "Alohida qiymat qatorlari olib tashlandi. Miqdor va tarmoq to‘lovi avval mahalliy valyutada ko‘rsatiladi; kripto birliklariga o‘tish va qaytish uchun birini bosing.";
"wallet.transaction.details.toggle_units" = "Birliklarni almashtirish.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Bosh ekran asta paydo bo‘lish yoki o‘lcham o‘zgarishi effektlarisiz ochiladi. Sozlamalar tugmasida endi tishli g‘ildirak belgisi bor.";
"settings.about.history.v355.build58.fields" = "Tranzaksiya va yuborish maydonlarida odatiy matn ranglari ishlatiladi. Strelkalar faqat ekran yoki panel ochadigan qatorlarda ko‘rinadi; miqdor va komissiyalarni bosish hali ham ko‘rsatish birligini almashtiradi.";
"settings.about.history.v355.build58.banners" = "Ko‘rsatilgach, tasdiqlanayotgan yoki tasdiqlangan tranzaksiya bannerlari 3 soniyadan keyin, hatto boshqa ekran ochsangiz ham yo‘qoladi. Hali ko‘rsatilmagan tasdiqlash xabarlari qaytganingizda paydo bo‘ladi.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON o‘tkazmalarida endi yuboriladigan miqdorni hisoblashdan oldin faollashtirish va o‘tkazish qobiliyati uchun to‘lovlar ajratiladi, hatto eng katta miqdorni yuborishda ham. Tekshirish ekranida to‘lovlar chegirilgandan keyingi to‘g‘ri miqdor ko‘rsatiladi.";
"settings.about.history.v355.build59.fees" = "Qo‘lda belgilangan TRON to‘lovlari zarur tarmoq xarajatlarini qoplashi kerak. TRX qoldig‘i kam bo‘lsa, endi aniqroq yo‘l-yo‘riq ko‘rsatiladi. Token miqdori o‘zgarmaydi; to‘lovlar TRXda amalga oshiriladi.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Yangi xush kelibsiz";
"settings.about.history.v356.welcome" = "Animatsiyalangan san'at asarlari va hamyon yaratish yoki import qilishning aniq variantlari bilan yangi xush kelibsiz ekran.";
"settings.about.history.v357.tour.title" = "Xush kelibsiz sayohati";
"settings.about.history.v357.tour" = "Besh sahifali sayohat qo‘llab-quvvatlanadigan tarmoqlar, jismoniy entropiya, yuborish va qabul qilish, xavfsizlik va tasdiqlangan buildlar bilan tanishtiradi. Sahifani almashtirish uchun suring yoki nuqtalarga teging; til almashtirgich navigatsiya panelida.";
"settings.about.history.v357.backup" = "Hamyon yaratilgan, import qilingan yoki tiklangan zahoti ekran darhol paydo bo‘ladi va zaxira nusxa variantlari standart ro‘yxatdan foydalanadi. iCloud tekshiruvi fonda ishlaydi, hamyon saqlanishi bilanoq Hamyonni ochish tayyor bo‘ladi.";
"settings.about.history.v357.reliability" = "Yashirin tiklash ekrani muddati tugaganda fondan qaytish endi sozlash ekranini yopmaydi, barcha ma’lumotlarni o‘chirish esa xush kelibsiz ekranini to‘g‘ridan-to‘g‘ri ochadi.";
"settings.about.history.v357.notifications" = "Bildirishnoma sozlamalari toifalar va holat uchun texnik tafsilotlarsiz soddaroq iboralardan foydalanadi.";
"settings.about.history.v357.wallets" = "Almashtirgichda hamyonlarni uzoq bosib, tizimning ko‘tarish animatsiyasi bilan qayta tartiblang; qatorga tegish uni faollashtiradi. Tiklash iborasini tekshirish har bir so‘zni raqamlaydi, Return esa keyingi maydonga o‘tadi.";
"settings.about.history.v357.send" = "O‘tkazma davom etayotganda yuborish summani ko‘rsatadi, yuborib bo‘lmasa aniqroq xabar chiqadi, TRON so‘rovlari esa provayderning vaqtinchalik xatolaridan keyin avtomatik qayta uriniladi.";
"settings.about.history.v357.security" = "Egalik ruxsati boshqa kalitga o‘tkazilgan import qilingan TRON hisoblari endi har bir ruxsatda bitta kalit bo‘lsa ham ogohlantirishni ko‘rsatadi va yubora olmaydi. Oshkor bo‘lgani ma’lum bo‘lgan ko‘proq tiklash iboralari va shaxsiy kalitlar importda rad etiladi.";
"settings.about.history.v356.localization" = "Xush kelibsiz ekranidagi matnlar barcha qoʻllab-quvvatlanadigan tillarda yanada tabiiy va tushunarli qilindi.";
"settings.about.history.v356.pricing" = "Token narxlari endi DEX narxlaridan foydalangan holda aniq tarmoq va token manziliga mos keladi. Kichik narxlar yaxlitlashsiz 8 kasrgacha ko'rsatiladi.";
"settings.about.history.v356.appearance" = "Birlamchi va ikkilamchi tugmalar endi bir xil balandliklar va ekran chetlaridan foydalanadi, asosiy harakatlar uchun tizim koʻk rangda.";
"settings.about.history.v356.transactions" = "Tranzaksiya tafsilotlari qisqaroq Tasdiqlangan holat va sanalar, manzillar, summalar va tranzaksiya identifikatorlari uchun aniqroq kulrang matndan foydalanadi.";
