"onboarding.carousel.open_source.visual.repository" = "Ochiq manba kod ombori";
"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture sahifasini ko‘rish";
"onboarding.carousel.open_source.visual.source" = "Manba kodini ko‘rib chiqish";
"onboarding.carousel.open_source.visual.rebuild" = "Reliz yig‘ilmasini qayta yaratish";
"onboarding.carousel.open_source.visual.compare" = "Yig‘ilma fayllarini solishtirish";
