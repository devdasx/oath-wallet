"onboarding.passphrase.learn_more.visual.accessibility" = "Фраза відновлення з 24 слів і секретна парольна фраза разом виводять окремий гаманець, захищений парольною фразою.";
"onboarding.passphrase.learn_more.derivation.section" = "Як BIP-39 виводить гаманець";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Фраза відновлення разом із парольною фразою";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512, 2048 раундів";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-бітове головне початкове значення";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Виведені облікові записи й адреси гаманця";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Ваша фраза відновлення й парольна фраза проходять 2048 раундів PBKDF2-HMAC-SHA512, утворюючи 512-бітове початкове значення, з якого виводяться облікові записи й адреси гаманця.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 вважає нормалізовану фразу відновлення паролем PBKDF2, а рядок «mnemonic» із доданою нормалізованою парольною фразою — сіллю. Після 2048 раундів PBKDF2-HMAC-SHA512 утворюється 64-байтове початкове значення.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Перед виведенням початкового значення Oath застосовує нормалізацію Unicode, передбачену BIP-39, щоб ті самі нормалізовані фраза відновлення й парольна фраза завжди відтворювали той самий гаманець.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Парольна фраза не шифрує слова відновлення. Вона змінює виведене початкове значення, тому кожна інша парольна фраза утворює інші облікові записи й адреси.";
"onboarding.passphrase.learn_more.wallets.section" = "Кожна парольна фраза виводить окремий гаманець";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Приклад парольної фрази 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Приклад парольної фрази 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Приклад гаманця A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Приклад гаманця B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Та сама фраза відновлення з двома різними парольними фразами виводить два окремі гаманці: гаманець A й гаманець B.";
"onboarding.passphrase.learn_more.wallets.different" = "Зміна навіть одного значущого символу виводить інше початкове значення, а отже й інший гаманець; початковий гаманець залишається без змін.";
"onboarding.passphrase.learn_more.wallets.empty" = "Порожня парольна фраза відкриває стандартний гаманець, виведений лише з фрази відновлення; непорожня парольна фраза відкриває власний окремий гаманець.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 не повідомляє про «неправильну парольну фразу»: кожна парольна фраза дійсна, тому друкарська помилка непомітно відкриває інший гаманець — зазвичай із нульовим балансом.";
"onboarding.passphrase.learn_more.security.section" = "Як парольна фраза посилює захист";
"onboarding.passphrase.learn_more.security.words.title" = "Самих слів відновлення недостатньо";
"onboarding.passphrase.learn_more.security.words.detail" = "Тому, хто отримає лише вашу фразу відновлення, усе одно буде потрібна точна парольна фраза, щоб вивести захищений гаманець і отримати до нього доступ.";
"onboarding.passphrase.learn_more.security.strength.title" = "Що надійніша фраза, то кращий захист";
"onboarding.passphrase.learn_more.security.strength.detail" = "Довга непередбачувана парольна фраза істотно ускладнює вгадування; коротку цитату, дату народження, ім’я чи повторно використаний пароль можна швидко вгадати, і вони майже не захищають.";
"onboarding.passphrase.learn_more.security.separation.title" = "Зберігайте парольну фразу окремо";
"onboarding.passphrase.learn_more.security.separation.detail" = "Зберігайте парольну фразу окремо від фрази відновлення, щоб одна викрадена резервна копія не розкрила обидва секрети, потрібні для відновлення гаманця.";
"onboarding.passphrase.learn_more.security.footer" = "Парольна фраза не захистить ваші кошти, якщо розкрито обидва секрети, парольна фраза слабка або скомпрометоване програмне забезпечення перехоплює її під час введення.";
"onboarding.passphrase.learn_more.safety.section" = "Як безпечно користуватися цією функцією";
"onboarding.passphrase.learn_more.safety.strong.title" = "Створіть надійну унікальну парольну фразу";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Виберіть кілька випадкових слів або інше значення з високою ентропією, унікальне для цього гаманця. Уникайте особистих фактів, знайомих фраз, шаблонів і паролів, використаних деінде.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Зробіть окрему резервну копію парольної фрази";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Зробіть довговічну офлайн-копію точної парольної фрази, зберігайте її окремо від фрази відновлення й ніколи не покладайтеся лише на пам’ять.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Кожен символ змінює гаманець";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Вводьте парольну фразу точно так, як її створено, з урахуванням кожної великої літери, пробілу, розділового знака й слова. Будь-яка відмінність непомітно виводить інший гаманець.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Перевірте відновлення до поповнення";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Перш ніж отримувати значні кошти, виконайте приватну контрольовану перевірку відновлення й переконайтеся, що фраза відновлення та парольна фраза відтворюють очікувані адреси.";
"onboarding.passphrase.learn_more.safety.footer" = "Жодна служба не може скинути чи відновити втрачену парольну фразу. Без точної парольної фрази доступ до гаманця буде втрачено назавжди — навіть якщо у вас залишилася фраза відновлення.";
