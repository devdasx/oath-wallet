"onboarding.carousel.open_source.visual.fingerprint" = "Цифровий відбиток опублікованого випуску";
"onboarding.carousel.open_source.visual.match" = "ЗБІГ ПІДТВЕРДЖЕНО — ЗБІРКУ ПЕРЕВІРЕНО";
