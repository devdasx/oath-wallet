"onboarding.carousel.entropy.visual.accessibility" = "Гральна кістка з позначеними гранями, монета й випадкові цифри разом утворюють 256 бітів ентропії гаманця на цьому пристрої.";
"onboarding.carousel.entropy.learn_more.action" = "Переглянути подробиці";
"onboarding.entropy.learn_more.navigation" = "Як працює фізична ентропія";
"onboarding.entropy.learn_more.path.section" = "Від фізичних результатів до слів відновлення";
"onboarding.entropy.learn_more.overview" = "Oath записує результати з вибраного вами фізичного джерела й перетворює їх на 256-бітове значення. Отримані 32 байти передаються до Wallet Core для створення стандартної фрази відновлення BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "Фраза відновлення BIP-39 із 24 слів";
"onboarding.entropy.learn_more.visual.bits" = "32 байти × 8 бітів = 256 бітів";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Сітка з 256 умовних бітових комірок, згрупованих у 32 байти.";
"onboarding.entropy.learn_more.visual.accessibility" = "Результати кидків гральної кістки, підкидань монети або випадкові цифри перетворюються на 256 бітів, а потім — на фразу відновлення BIP-39 із 24 слів.";
"onboarding.entropy.learn_more.inputs.section" = "Крок 1. Запишіть фізичні результати";
"onboarding.entropy.learn_more.inputs.dice.title" = "Кидайте збалансовану шестигранну кістку";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Якщо кістка збалансована, кожна грань 1–4 додає 2 біти, а кожна грань 5–6 — 1 біт.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Підкидання фізичної монети";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Кожне незалежне підкидання збалансованої монети додає 1 неупереджений біт ентропії.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Записуйте випадкові цифри";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Кожна цифра 0–7 додає 3 біти, а кожна цифра 8–9 — 1 біт. Цифри мають походити зі справді випадкового фізичного процесу.";
"onboarding.entropy.learn_more.inputs.footer" = "Використовуйте неупереджене фізичне джерело й записуйте всі результати по порядку. Можна змінювати методи введення, адже кожен прийнятий результат додається до того самого потоку бітів.";
"onboarding.entropy.learn_more.conversion.section" = "2. Сформуйте 256-бітове значення";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath перетворює результати кидків і десяткові цифри на неупереджені групи, розмір яких є степенем двійки. Довжина внесків може різнитися, але неупереджене фізичне джерело не надає переваги жодному значенню біта.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath додає біти в порядку введення, доки не збере рівно 256, а потім пакує їх у 32 байти, починаючи зі старшого біта.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Власна ентропія містить лише записані вами фізичні дані; Oath не додає випадковість, створену пристроєм.";
"onboarding.entropy.learn_more.bip39.section" = "3. Сформуйте фразу відновлення";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 бітів ентропії";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-бітова контрольна сума BIP-39";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 біти, розділені на 24 одинадцятибітові індекси слів";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "До 256-бітового значення ентропії додається 8-бітова контрольна сума. Утворені 264 біти діляться на 24 одинадцятибітові індекси слів.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 обчислює SHA-256 для 32-байтового значення ентропії та бере перші 8 бітів хешу як контрольну суму; після її додавання утворюються 264 біти.";
"onboarding.entropy.learn_more.bip39.words" = "264 біти діляться на 24 групи по 11 бітів. Кожна група визначає один елемент стандартного списку BIP-39 із 2048 слів, утворюючи фразу відновлення з 24 слів.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core виводить детерміновані облікові записи й адреси з отриманого початкового значення. Та сама фраза відновлення й необов’язкова парольна фраза завжди відтворюватимуть той самий гаманець.";
"onboarding.entropy.learn_more.security.section" = "Як власна ентропія посилює безпеку";
"onboarding.entropy.learn_more.security.space.title" = "Величезний простір можливих значень";
"onboarding.entropy.learn_more.security.space.detail" = "Рівномірна 256-бітова ентропія містить 2^256 унікальних значень, тому повний перебір є обчислювально нездійсненним. Це описує розмір простору вхідних даних і не означає, що кожен криптографічний компонент має 256-бітову стійкість до атак.";
"onboarding.entropy.learn_more.security.source.title" = "Джерело випадковості — ви";
"onboarding.entropy.learn_more.security.source.detail" = "Фізичні події дають змогу отримувати випадковість гаманця незалежно, не покладаючись лише на генератор випадкових чисел пристрою. Це посилює безпеку лише тоді, коли події справді випадкові.";
"onboarding.entropy.learn_more.security.local.title" = "Повністю обробляється на цьому пристрої";
"onboarding.entropy.learn_more.security.local.detail" = "Oath перетворює записану вами послідовність і створює фразу відновлення виключно на цьому пристрої. Ваша послідовність ніколи не надсилається на обробку.";
"onboarding.entropy.learn_more.security.patterns.title" = "Не використовуйте секрети, придумані людиною";
"onboarding.entropy.learn_more.security.patterns.detail" = "Довга послідовність неупереджених незалежних подій набагато менш передбачувана, ніж дати народження, улюблені числа, повторювані шаблони чи слова, вибрані людиною.";
"onboarding.entropy.learn_more.security.footer" = "Фізична ентропія замінює випадковість гаманця, створену пристроєм; це не додатковий пароль і не додатковий рівень безпеки.";
"onboarding.entropy.learn_more.safety.section" = "Як безпечно користуватися цією функцією";
"onboarding.entropy.learn_more.safety.fair.title" = "Записуйте неупереджені незалежні результати";
"onboarding.entropy.learn_more.safety.fair.detail" = "Використовуйте збалансовану монету чи гральну кістку й переконайтеся, що кожен результат незалежний. Випадкові цифри мають походити зі справжнього фізичного джерела, а не з пам’яті чи шаблону.";
"onboarding.entropy.learn_more.safety.private.title" = "Зберігайте процес створення ентропії в таємниці";
"onboarding.entropy.learn_more.safety.private.detail" = "Захищайте записану послідовність і готову фразу відновлення як секретні дані гаманця. Не допускайте, щоб їх бачили камери чи інші люди.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Записуйте кожен результат точно";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Один пропущений, повторений або переставлений місцями результат створює інший гаманець. Перегляньте кожен запис і перевірте готову фразу відновлення, перш ніж поповнювати гаманець.";
"onboarding.entropy.learn_more.safety.backup.title" = "Захистіть фразу відновлення";
"onboarding.entropy.learn_more.safety.backup.detail" = "Зберігайте фразу відновлення офлайн і нікому її не передавайте. Перевіривши резервну копію, безпечно знищте всі непотрібні проміжні записи вхідних даних.";
"onboarding.entropy.learn_more.safety.footer" = "Фізична ентропія не захищає від наслідків розкриття фрази відновлення, компрометації пристрою, шкідливого програмного забезпечення чи неправильно записаної послідовності. Якщо ви не можете гарантувати неупереджені, приватні й точні вхідні дані, скористайтеся стандартним створенням гаманця.";
"onboarding.carousel.open_source.eyebrow" = "ВІДКРИТИЙ КОД ЗА ЗАДУМОМ";
