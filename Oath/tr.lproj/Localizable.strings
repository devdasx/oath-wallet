"onboarding.passphrase.learn_more.security.words.detail" = "Birisi yalnızca kurtarma ifadesini edinirse, korumalı cüzdanı türetmek ve ona erişmek için yine de tam parolaya ihtiyaç duyar.";
"onboarding.passphrase.learn_more.security.strength.title" = "Güçlü parola korumayı artırır";
"onboarding.passphrase.learn_more.security.strength.detail" = "Uzun ve öngörülemeyen bir parola, tahmin etmeyi anlamlı ölçüde zorlaştırır; kısa bir söz, doğum günü, ad veya başka yerde kullanılan parola hızla tahmin edilebilir ve çok az koruma sağlar.";
"onboarding.passphrase.learn_more.security.separation.title" = "Parolayı ayrı tutun";
"onboarding.passphrase.learn_more.security.separation.detail" = "Parolayı kurtarma ifadesinden ayrı saklayın; böylece tek bir yedeğin çalınması, cüzdanı geri yüklemek için gereken iki sırrı birden açığa çıkarmaz.";
"onboarding.passphrase.learn_more.security.footer" = "İki sır da açığa çıkarsa, parola zayıfsa veya ele geçirilmiş bir yazılım siz yazarken parolayı yakalarsa parola varlıklarınızı koruyamaz.";
