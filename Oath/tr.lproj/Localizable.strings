"onboarding.carousel.entropy.visual.accessibility" = "Numaraları gösteren bir zar, bir madeni para ve rastgele rakamlar birleşerek bu cihazda 256 bit cüzdan entropisi oluşturuyor.";
"onboarding.carousel.entropy.learn_more.action" = "Ayrıntıları keşfet";
"onboarding.entropy.learn_more.navigation" = "Fiziksel entropi nasıl çalışır?";
"onboarding.entropy.learn_more.path.section" = "Fiziksel sonuçlardan kurtarma kelimelerine";
"onboarding.entropy.learn_more.overview" = "Oath, seçtiğiniz fiziksel kaynaktan elde edilen sonuçları kaydedip 256 bitlik bir değere dönüştürür. Ortaya çıkan 32 bayt, standart bir BIP-39 kurtarma ifadesi oluşturması için Wallet Core'a iletilir.";
"onboarding.entropy.learn_more.visual.phrase" = "24 kelimelik BIP-39 kurtarma ifadesi";
"onboarding.entropy.learn_more.visual.bits" = "32 bayt × 8 bit = 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 bayt halinde düzenlenmiş 256 örnek bit hücresinden oluşan ızgara.";
"onboarding.entropy.learn_more.visual.accessibility" = "Zar atışları, yazı tura atışları veya rastgele rakamlar önce 256 bite, ardından 24 kelimelik BIP-39 kurtarma ifadesine dönüştürülüyor.";
"onboarding.entropy.learn_more.inputs.section" = "1. adım: Fiziksel sonuçları kaydedin";
"onboarding.entropy.learn_more.inputs.dice.title" = "Adil bir altı yüzlü zar atın";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Adil bir zarda 1-4 gelen her atış 2 bit, 5-6 gelen her atış ise 1 bit katkı sağlar.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fiziksel yazı tura atışları";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Adil ve bağımsız her yazı tura atışı, yansız 1 bit entropi sağlar.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Rastgele rakamları kaydedin";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0-7 arasındaki her rakam 3 bit, 8-9 arasındaki her rakam ise 1 bit katkı sağlar. Rakamlar gerçekten rastgele bir fiziksel süreçten gelmelidir.";
"onboarding.entropy.learn_more.inputs.footer" = "Adil bir fiziksel kaynak kullanın ve her sonucu sırayla kaydedin. Kabul edilen her sonuç aynı bit akışına eklendiğinden girdi yöntemleri arasında geçiş yapabilirsiniz.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256 bitlik değeri oluşturun";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath, zar sonuçlarını ve ondalık rakamları yansız, ikinin kuvveti büyüklüğündeki gruplara dönüştürür. Katkı uzunlukları değişebilir; ancak adil bir fiziksel kaynak hiçbir bit değerini kayırmaz.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath, tam 256 bit toplanana kadar bitleri girildiği sırayla ekler; ardından en anlamlı bit başta olacak şekilde 32 bayt halinde paketler.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Özel entropi yalnızca kaydettiğiniz fiziksel girdileri içerir; Oath, cihazın oluşturduğu rastgeleliği buna katmaz.";
"onboarding.entropy.learn_more.bip39.section" = "3. Kurtarma ifadesini türetin";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bit entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8 bitlik BIP-39 sağlama toplamı";
"onboarding.entropy.learn_more.bip39.visual.words" = "24 adet 11 bitlik kelime dizinine bölünmüş 264 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256 bitlik entropi değerine 8 bitlik sağlama toplamı eklenerek, 24 adet 11 bitlik kelime dizinine bölünen 264 bit oluşturuluyor.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39, 32 baytlık entropi değerinin SHA-256 karmasını hesaplayıp karma değerinin ilk 8 bitini sağlama toplamı olarak alır; bu toplam eklendiğinde 264 bit elde edilir.";
"onboarding.entropy.learn_more.bip39.words" = "264 bit, 11 bitlik 24 gruba ayrılır. Her grup, standart 2.048 kelimelik BIP-39 listesinden bir girdiyi seçerek 24 kelimelik kurtarma ifadesini oluşturur.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core, elde edilen tohumdan deterministik hesaplar ve adresler türetir. Aynı kurtarma ifadesi ve isteğe bağlı parola her zaman aynı cüzdanı yeniden oluşturur.";
"onboarding.entropy.learn_more.security.section" = "Özel entropi güvenliği nasıl güçlendirir?";
"onboarding.entropy.learn_more.security.space.title" = "Devasa bir olasılık uzayı";
"onboarding.entropy.learn_more.security.space.detail" = "Eş dağılımlı 256 bit entropi 2^256 benzersiz değer içerdiğinden tüm olasılıkları denemek hesaplama açısından olanaksızdır. Bu, girdi uzayının büyüklüğünü belirtir; her kriptografik bileşenin 256 bit saldırı direnci sunduğu anlamına gelmez.";
"onboarding.entropy.learn_more.security.source.title" = "Rastgeleliği siz sağlarsınız";
"onboarding.entropy.learn_more.security.source.detail" = "Fiziksel olaylar, cüzdanın rastgeleliğini yalnızca cihazın rastgele sayı üretecine bırakmadan bağımsız bir kaynaktan sağlamanıza olanak tanır. Bu, güvenliği ancak olaylar gerçekten rastgele olduğunda artırır.";
"onboarding.entropy.learn_more.security.local.title" = "Tamamen bu cihazda işlenir";
"onboarding.entropy.learn_more.security.local.detail" = "Oath, kaydettiğiniz diziyi dönüştürüp kurtarma ifadesini tamamen bu cihazda oluşturur. Diziniz işlenmek üzere hiçbir zaman yüklenmez.";
"onboarding.entropy.learn_more.security.patterns.title" = "İnsanların seçtiği sırlardan kaçının";
"onboarding.entropy.learn_more.security.patterns.detail" = "Adil, bağımsız olayların uzun bir dizisi, doğum günleri, favori sayılar, tekrarlanan kalıplar veya bir kişi tarafından seçilen kelimelerden çok daha az tahmin edilebilirdir.";
"onboarding.entropy.learn_more.security.footer" = "Fiziksel entropi, cihazın oluşturduğu cüzdan rastgeleliğinin yerini alır; ek bir parola ya da güvenlik katmanı değildir.";
"onboarding.entropy.learn_more.safety.section" = "Bu özelliği güvenle kullanın";
"onboarding.entropy.learn_more.safety.fair.title" = "Adil ve bağımsız sonuçları kaydedin";
"onboarding.entropy.learn_more.safety.fair.detail" = "Adil bir madeni para veya zar kullanın ve her sonucun bağımsız olduğundan emin olun. Rastgele rakamlar belleğinizden ya da bir kalıptan değil, gerçek bir fiziksel kaynaktan gelmelidir.";
"onboarding.entropy.learn_more.safety.private.title" = "Entropi oluşturma sürecinizi gizli tutun";
"onboarding.entropy.learn_more.safety.private.detail" = "Hem kaydedilen diziyi hem de tamamlanan kurtarma ifadesini cüzdan sırları olarak değerlendirin. Kameraların veya diğer kişilerin bunları gözlemlemesini önleyin.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Her sonucu eksiksiz kaydedin";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Tek bir eksik, yinelenen veya sırası değiştirilen sonuç farklı bir cüzdan oluşturur. Her girdiyi inceleyin ve cüzdana varlık aktarmadan önce tamamlanan kurtarma ifadesini doğrulayın.";
"onboarding.entropy.learn_more.safety.backup.title" = "Kurtarma ifadesini güvenceye alın";
"onboarding.entropy.learn_more.safety.backup.detail" = "Kurtarma ifadesini çevrimdışı olarak saklayın ve asla paylaşmayın. Yedeklemeyi doğruladıktan sonra artık ihtiyacınız olmayan tüm ara giriş kayıtlarını güvenli bir şekilde yok edin.";
"onboarding.entropy.learn_more.safety.footer" = "Fiziksel entropi; ifşa olmuş bir kurtarma ifadesini, ele geçirilmiş cihazı, kötü amaçlı yazılımı veya yanlış kaydedilmiş diziyi güvence altına alamaz. Girdilerin adil, gizli ve doğru olduğundan emin değilseniz standart cüzdan oluşturma yöntemini kullanın.";
"onboarding.carousel.open_source.eyebrow" = "TASARIMI GEREĞİ AÇIK KAYNAK";
