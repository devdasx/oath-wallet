"onboarding.carousel.passphrase.eyebrow" = "İSTEĞE BAĞLI BIP-39 PAROLASI";
"onboarding.carousel.passphrase.title" = "Tek kurtarma ifadesi. Bir ek sır.";
"onboarding.carousel.passphrase.message" = "BIP-39 parolası kurtarma ifadenizle birleşerek ayrı bir cüzdan türetir. Kurtarma kelimeleri açığa çıksa bile bu cüzdana erişmek için parolanın tam olarak bilinmesi gerekir.";
"onboarding.carousel.passphrase.visual.phrase" = "24 kurtarma kelimeniz";
"onboarding.carousel.passphrase.visual.passphrase" = "Ek gizli parolanız";
"onboarding.carousel.passphrase.visual.output" = "Parolayla türetilen ayrı cüzdan";
