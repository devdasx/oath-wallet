"onboarding.carousel.passphrase.learn_more.action" = "Ayrıntıları keşfet";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 parolalarını anlamak";
"onboarding.passphrase.learn_more.path.section" = "İki sırdan tek cüzdan türetme";
"onboarding.passphrase.learn_more.overview" = "BIP-39 parolası, kurtarma ifadenizle birleştirilen isteğe bağlı bir sırdır. İkisi birlikte, yalnızca kurtarma ifadesinden oluşturulandan farklı bir cüzdanı deterministik olarak türetir.";
"onboarding.passphrase.learn_more.visual.phrase" = "24 kelimelik kurtarma ifadeniz";
"onboarding.passphrase.learn_more.visual.passphrase" = "Gizli parolanız";
"onboarding.passphrase.learn_more.visual.wallet" = "Parolayla korunan cüzdan";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 kelimelik kurtarma ifadesi ile gizli parola birleşerek ayrı ve parolayla korunan bir cüzdan türetiyor.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 cüzdanı nasıl türetir?";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Parolayla birleştirilmiş kurtarma ifadesi";
"onboarding.passphrase.learn_more.derivation.visual.function" = "2.048 tur PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512 bitlik ana tohum";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Türetilen cüzdan hesapları ve adresleri";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Kurtarma ifadeniz ve parolanız, cüzdan hesaplarıyla adreslerinin türetildiği 512 bitlik tohumu üretmek üzere 2.048 tur PBKDF2-HMAC-SHA512 işleminden geçiyor.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39, normalleştirilmiş kurtarma ifadesini PBKDF2 parolası olarak; “mnemonic” sözcüğüyle ardından gelen normalleştirilmiş parolayı ise tuz değeri olarak kullanır. 2.048 tur PBKDF2-HMAC-SHA512 işleminin ardından 64 baytlık bir tohum üretilir.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Oath, tohumu türetmeden önce BIP-39'un gerektirdiği Unicode normalleştirmesini uygular. Böylece aynı normalleştirilmiş kurtarma ifadesi ve parola her zaman aynı cüzdanı yeniden oluşturur.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Parola, kurtarma sözcüklerini şifrelemez. Tohumun kendisini değiştirir, böylece farklı bir parola farklı hesaplar ve adresler oluşturur.";
"onboarding.passphrase.learn_more.wallets.section" = "Her parola ayrı bir cüzdan türetir";
