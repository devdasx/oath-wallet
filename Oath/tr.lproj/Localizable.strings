// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Göndermek için Kaydır, onay düğmesinin yerini alır. Yön animasyonu, dokunsal geri bildirim ve akıcı hareket her iki okuma yönünü destekler. Göndermek için en az %90 seviyesinde bırakın; iptal etmek için geri kaydırın.";
"settings.about.history.v355.build56.activity" = "Zil, bekleyen etkinlikleri açar. İşlem kapsülleri durum rozetlerini gösterir ve kaydırılarak kapatılır. Onaylanan veya onayı süren kapsüller 3 saniye sonra gizlenir; onay, görünür kapsülün kendisini günceller.";
"settings.about.history.v355.build56.status" = "Desteklenen tüm ağlarda daha güvenilir işlem durumları, canlı işlem ayrıntıları ve gönderim sonrası daha hızlı bakiye güncellemeleri. Bekleyen işlemlerin takibi uygulama yeniden açıldığında sürer.";
"settings.about.history.v355.build56.fees" = "Aynı transfer incelemesine dönüldüğünde alınmış ücret korunur. Ücret yükleme ve hesap fonlama uyarıları daha açıktır; yeterli tutarlarda artık etkinleştirme bildirimi gösterilmez.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin ve Dogecoin, toz eşiğinin altındaki para üstünü kullanılamaz bir çıktı oluşturmak yerine ücrete ekler. İncelenen ücret imzalama sırasında kullanılan ücretle eşleşir.";
"settings.about.history.v355.build56.stability" = "Arka plan görevi çökmesi ve cüzdan yenileme zaman aşımı uyarıları düzeltildi. Geçici yenileme hatalarında mevcut cüzdan bilgileri erişilebilir kalır.";
"settings.about.history.v355.build56.backup" = "Doğru açılış başlıkları ve daha az mesajla daha sade yedekleme ekranları. Özel anahtara erişim Uygulama Kilidi ayarlarına uyar. Kompakt cam içe aktarma uyarıları, başka bir kurtarma ifadesi seçtiğinizde reddedilen girdiyi temizler.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Göndermek için kaydırma denetimini bıraktığınızda, inceleme ekranı kapanmadan önce animasyonlu bir onay işareti görünür.";
"settings.about.history.v355.build57.activity" = "Etkinlik satırlarında durum metni daha ince, tutar ikincil metin olarak gösterilir; işlem ayrıntılarını açmak için bir ok bulunur.";
"settings.about.history.v355.build57.details" = "Ağ ücretleri artık transfer özetinde yer alır. Daha kısa etiketler ve tek bir ağ satırı, ayrıntıları daha anlaşılır kılar.";
"settings.about.history.v355.build57.resume" = "Arka plandan dönüldüğünde, transfer incelemesi ve işlem ayrıntıları dahil açık ekranlar ve paneller korunur.";
"settings.about.history.v355.build57.secrets" = "Kurtarma ifadesi, özel anahtar ve parola ifadesi ekranları, uygulamadan 20 saniye uzak kalındığında kapanır. Uygulama kilidi ayarlarınıza uymaya devam eder.";
"settings.about.history.v355.build57.filters" = "Ağ filtreleri biraz daha yüksek yerel düğmeler kullanır; boyutları içeriğe göre ayarlanır ve gezinme çubuğunun altındaki boşluk düzeltilmiştir.";
"settings.about.history.v355.build57.units" = "Ayrı değer satırları kaldırıldı. Tutar ve ağ ücreti önce yerel para biriminde gösterilir; kripto birimlerine geçmek ve geri dönmek için birine dokunun.";
"wallet.transaction.details.toggle_units" = "Birimleri değiştirin.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Ana ekran solma veya ölçekleme efekti olmadan açılır. Ayarlar düğmesi artık dişli simgesi kullanır.";
"settings.about.history.v355.build58.fields" = "İşlem ve gönderim alanları standart metin renklerini kullanır. Oklar yalnızca ekran veya panel açan satırlarda görünür; tutarlara ve ücretlere dokunmak birimleri değiştirmeye devam eder.";
"settings.about.history.v355.build58.banners" = "Onaylanıyor ve Onaylandı bildirimleri gösterildikten 3 saniye sonra, başka bir ekran açsanız bile kaybolur. Henüz gösterilmemiş onay güncellemeleri geri döndüğünüzde görünür.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON transferleri artık maksimum tutarı gönderirken de gönderilecek tutarı hesaplamadan önce etkinleştirme ve bant genişliği ücretlerini ayırır. İnceleme ekranı, ücretler düşüldükten sonraki doğru tutarı gösterir.";
"settings.about.history.v355.build59.fees" = "Özel TRON ücretleri, gerekli ağ maliyetlerini karşılamalıdır. TRX bakiyesi düşük olduğunda artık daha açık yönlendirmeler gösterilir. Token miktarı değişmez; ücretler TRX ile ödenir.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Yeni bir karşılama";
"settings.about.history.v356.welcome" = "Animasyonlu resimler ve cüzdan oluşturmak veya içe aktarmak için net seçenekler içeren yeni bir karşılama ekranı.";
"settings.about.history.v357.tour.title" = "Hoş geldiniz turu";
"settings.about.history.v357.tour" = "Beş sayfalık bir tur desteklenen ağları, fiziksel entropiyi, gönderme ve almayı, güvenliği ve doğrulanmış derlemeleri tanıtır. Sayfa değiştirmek için kaydırın veya noktalara dokunun; dil değiştirici gezinme çubuğundadır.";
"settings.about.history.v357.backup" = "Bir cüzdan oluşturduktan, içe aktardıktan veya geri yükledikten sonra ekran hemen görünür ve yedekleme seçenekleri standart listeyi kullanır. iCloud denetimi arka planda çalışır ve cüzdan kaydedilir kaydedilmez Cüzdanı Aç hazır olur.";
"settings.about.history.v357.reliability" = "Gizli bir kurtarma ekranının süresi dolduğunda arka plandan dönmek artık kurulum ekranını kapatmaz ve tüm verileri silmek doğrudan hoş geldiniz ekranını açar.";
"settings.about.history.v357.notifications" = "Bildirim ayarları, kategoriler ve durum için teknik ayrıntılar olmadan daha sade ifadeler kullanır.";
"settings.about.history.v357.wallets" = "Değiştiricide cüzdanları sistemin kaldırma animasyonuyla uzun basarak yeniden sıralayın; bir satıra dokunmak onu etkinleştirir. Kurtarma ifadesi doğrulaması her sözcüğü numaralandırır ve Return tuşu sonraki alana geçer.";
"settings.about.history.v357.send" = "Aktarım sürerken gönderme tutarı gösterir, gönderilemezse daha net bir ileti görünür ve TRON istekleri geçici sağlayıcı hatalarından sonra otomatik olarak yeniden denenir.";
"settings.about.history.v357.security" = "Sahip izni başka bir anahtara taşınmış içe aktarılmış TRON hesapları, her izin tek bir anahtar listelese bile artık uyarıyı gösterir ve gönderemez. Açığa çıktığı bilinen daha fazla kurtarma ifadesi ve özel anahtar içe aktarmada reddedilir.";
"settings.about.history.v356.localization" = "Karşılama ekranındaki metinler, desteklenen tüm dillerde daha doğal ve anlaşılır hâle getirildi.";
"settings.about.history.v356.pricing" = "Token fiyatları artık öncelikle DEX fiyatları kullanılarak tam ağ ve token adresiyle eşleşiyor. Küçük fiyatlar, yuvarlama olmadan 8 ondalık basamağa kadar gösterilir.";
"settings.about.history.v356.appearance" = "Birincil ve ikincil düğmeler artık tutarlı yükseklikler ve ekran kenar boşlukları kullanıyor ve birincil eylemler için sistem mavisi kullanılıyor.";
"settings.about.history.v356.transactions" = "İşlem ayrıntılarında tarihler, adresler, tutarlar ve işlem kimlikleri için daha kısa bir Onaylandı durumu ve daha net gri metin kullanılır.";
