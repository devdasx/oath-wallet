"onboarding.passphrase.learn_more.safety.strong.detail" = "Bu cüzdana özgü birkaç rastgele kelime veya yüksek entropili başka bir değer seçin. Kişisel bilgilerden, tanıdık ifadelerden, kalıplardan ve başka yerde kullandığınız parolalardan kaçının.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Parolayı ayrı yedekleyin";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Parolanın tam ve dayanıklı bir çevrimdışı kopyasını oluşturun, kurtarma ifadesinden ayrı saklayın ve yalnızca belleğinize güvenmeyin.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Her karakter cüzdanı değiştirir";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Parolayı tüm büyük harfleri, boşlukları, noktalama işaretleri ve kelimeleriyle oluşturduğunuz biçimde yeniden girin. En küçük fark bile uyarı vermeden başka bir cüzdan türetir.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Varlık eklemeden önce kurtarmayı doğrulayın";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Önemli miktarda para almadan önce, özel, kontrollü bir kurtarma testinde kurtarma ifadesinin ve parolanın beklenen adresleri yeniden oluşturduğunu doğrulayın.";
"onboarding.passphrase.learn_more.safety.footer" = "Hiçbir hizmet kayıp bir parolayı sıfırlayamaz veya kurtaramaz. Kurtarma ifadeniz elinizde olsa bile tam parola olmadan bu cüzdana erişiminiz kalıcı olarak kaybolur.";
