"onboarding.passphrase.learn_more.safety.section" = "ဤလုပ်ဆောင်ချက်ကို လုံခြုံစွာ အသုံးပြုပါ";
"onboarding.passphrase.learn_more.safety.strong.title" = "အားကောင်းပြီး သီးသန့်ဖြစ်သော စကားဝှက်စာစုကို ဖန်တီးပါ";
