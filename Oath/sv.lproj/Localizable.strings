"settings.about.history.v357.tour.title" = "Välkomstrundtur";
"settings.about.history.v357.tour" = "En rundtur på fem sidor presenterar de nätverk som stöds, fysisk entropi, sändning och mottagning, säkerhet och verifierade byggen. Svep eller tryck på prickarna för att byta sida; språkväljaren finns i navigeringsfältet.";
