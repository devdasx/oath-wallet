"onboarding.carousel.wallet.eyebrow" = "DIN OATH WALLET";
"onboarding.carousel.wallet.title" = "En plånbok för varje transaktion.";
"onboarding.carousel.wallet.message" = "Oath samlar dina tillgångar i en modern, snabb och lättöverskådlig plånbok för alla nätverk, helt under din kontroll.";
"onboarding.carousel.wallet.visual.networks" = "En samlad överblick över alla nätverk";
