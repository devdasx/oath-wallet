"onboarding.carousel.entropy.eyebrow" = "ENTROPI FRÅN FYSISKA INDATA";
"onboarding.carousel.entropy.title" = "Skapa slumpdata som du styr helt över.";
"onboarding.carousel.entropy.message" = "Kasta tärning, singla slant eller registrera slumpmässiga siffror. Oath omvandlar dina fysiska indata till exakt 256 bitars entropi för en återställningsfras med 24 ord, helt och hållet på din enhet.";
"onboarding.carousel.entropy.visual.output" = "256 bitars användargenererad entropi";
"onboarding.carousel.entropy.visual.local" = "Skapas helt från dina registrerade indata";
"onboarding.carousel.entropy.visual.accessibility" = "En numrerad tärning, ett mynt och slumpmässiga siffror kombineras till 256 bitars plånboksentropi på den här enheten.";
"onboarding.carousel.entropy.learn_more.action" = "Läs mer om hur det fungerar";
"onboarding.entropy.learn_more.navigation" = "Så fungerar fysisk entropi";
"onboarding.entropy.learn_more.path.section" = "Från fysiska utfall till återställningsord";
"onboarding.entropy.learn_more.overview" = "Oath registrerar utfall från den fysiska källa du väljer och omvandlar dem till ett 256-bitarsvärde. De 32 byte som bildas skickas sedan till Wallet Core för att skapa en standardiserad BIP-39-återställningsfras.";
"onboarding.entropy.learn_more.visual.phrase" = "En BIP-39-återställningsfras med 24 ord";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bitar är 256 bitar";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Ett rutnät med 256 exempelbitar ordnade i 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Tärningskast, slantsinglingar eller slumpmässiga siffror omvandlas till 256 bitar och därefter till en BIP-39-återställningsfras med 24 ord.";
"onboarding.entropy.learn_more.inputs.section" = "Steg 1: Registrera fysiska utfall";
"onboarding.entropy.learn_more.inputs.dice.title" = "Kasta en rättvis sexsidig tärning";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Med en rättvis tärning bidrar sidorna 1–4 med 2 bitar vardera och sidorna 5–6 med 1 bit vardera.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fysiska slantsinglingar";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Varje rättvis och oberoende slantsingling bidrar med 1 opartisk entropibit.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registrera slumpmässiga siffror";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Siffror 0–7 bidrar vardera med 3 bitar. Siffror 8–9 bidrar med 1 bit vardera. Siffrorna måste komma från en genuint slumpmässig fysisk process.";
"onboarding.entropy.learn_more.inputs.footer" = "Använd en rättvis fysisk källa och registrera varje resultat i ordning. Du kan byta inmatningsmetod eftersom varje godkänt resultat bidrar till samma bitström.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sätt samman ett 256-bitarsvärde";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath omvandlar tärningsresultat och decimalsiffror till tvåpotensgrupper utan statistisk snedvridning. Bidragens längd kan variera, men en rättvis fysisk källa gynnar inget bitvärde.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath lägger till bitarna i den ordning de anges tills exakt 256 har samlats in och packar dem sedan i 32 byte med den mest signifikanta biten först.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Anpassad entropi innehåller endast de fysiska indata du registrerar. Oath blandar inte in någon enhetsgenererad slump.";
"onboarding.entropy.learn_more.bip39.section" = "3. Härled återställningsfrasen";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256-bitars entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "En 8-bitars BIP-39-kontrollsumma";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bitar uppdelade i 24 ordindex med 11 bitar vardera";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Ett 256-bitars entropivärde plus en 8-bitars kontrollsumma skapar 264 bitar, som delas upp i 24 ordindex på 11 bitar vardera.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 beräknar SHA-256 för entropivärdet på 32 byte och använder de första 8 hashbitarna som kontrollsumma. När kontrollsumman läggs till bildas 264 bitar.";
"onboarding.entropy.learn_more.bip39.words" = "De 264 bitarna delas upp i 24 grupper med 11 bitar vardera. Varje grupp väljer en post i BIP-39-standardlistan med 2 048 ord och bildar återställningsfrasen med 24 ord.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core härleder deterministiska konton och adresser från den seed som bildas. Samma återställningsfras och valfria lösenfras återskapar alltid samma plånbok.";
"onboarding.entropy.learn_more.security.section" = "Så stärker anpassad entropi säkerheten";
"onboarding.entropy.learn_more.security.space.title" = "Ett enormt antal möjligheter";
"onboarding.entropy.learn_more.security.space.detail" = "Likformig 256-bitarsentropi innehåller 2^256 unika värden, vilket gör uttömmande gissning beräkningsmässigt ogenomförbar. Det beskriver indatarymdens storlek och innebär inte att varje kryptografisk komponent ger ett 256-bitars skydd mot angrepp.";
"onboarding.entropy.learn_more.security.source.title" = "Slumpen kommer från dig";
"onboarding.entropy.learn_more.security.source.detail" = "Med fysiska händelser kan du skapa plånbokens slump oberoende i stället för att enbart förlita dig på enhetens slumptalsgenerator. Det stärker bara säkerheten när händelserna verkligen är slumpmässiga.";
"onboarding.entropy.learn_more.security.local.title" = "Bearbetas helt på den här enheten";
"onboarding.entropy.learn_more.security.local.detail" = "Oath omvandlar den registrerade sekvensen och skapar återställningsfrasen helt på den här enheten. Sekvensen laddas aldrig upp för bearbetning.";
"onboarding.entropy.learn_more.security.patterns.title" = "Undvik självvalda hemligheter";
"onboarding.entropy.learn_more.security.patterns.detail" = "En lång sekvens av rättvisa, oberoende händelser är betydligt mindre förutsägbar än födelsedagar, favoritnummer, upprepade mönster eller ord som en person har valt.";
"onboarding.entropy.learn_more.security.footer" = "Fysisk entropi ersätter den enhetsgenererade slumpen för plånboken. Den är inte ett extra lösenord eller säkerhetslager.";
"onboarding.entropy.learn_more.safety.section" = "Använd funktionen på ett säkert sätt";
"onboarding.entropy.learn_more.safety.fair.title" = "Registrera rättvisa, oberoende resultat";
"onboarding.entropy.learn_more.safety.fair.detail" = "Använd ett rättvist mynt eller en rättvis tärning och se till att varje resultat är oberoende. Slumpmässiga siffror måste komma från en verklig fysisk källa, inte från minnet eller ett mönster.";
"onboarding.entropy.learn_more.safety.private.title" = "Håll hela processen privat";
"onboarding.entropy.learn_more.safety.private.detail" = "Skydda både den registrerade sekvensen och den färdiga återställningsfrasen som plånbokshemligheter. Håll dem utom synhåll för kameror och andra personer.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registrera varje resultat exakt";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Ett resultat som saknas, har dubblerats eller hamnat i fel ordning skapar en annan plånbok. Granska varje post och verifiera den färdiga återställningsfrasen innan du sätter in tillgångar i plånboken.";
"onboarding.entropy.learn_more.safety.backup.title" = "Skydda återställningsfrasen";
"onboarding.entropy.learn_more.safety.backup.detail" = "Förvara återställningsfrasen offline och dela den aldrig. När du har verifierat säkerhetskopian ska du förstöra alla mellanliggande indataposter som du inte längre behöver på ett säkert sätt.";
"onboarding.entropy.learn_more.safety.footer" = "Fysisk entropi kan inte skydda en röjd återställningsfras, en komprometterad enhet, skadlig programvara eller en felaktigt registrerad sekvens. Använd standardmetoden för att skapa en plånbok om du inte kan garantera rättvisa, privata och korrekt registrerade indata.";
"onboarding.carousel.open_source.eyebrow" = "ÖPPEN KÄLLKOD FRÅN GRUNDEN";
"onboarding.carousel.open_source.title" = "Granska källkoden. Verifiera bygget.";
"onboarding.carousel.open_source.message" = "Oath publicerar sin källkod för oberoende granskning. En version är verifierad först när ett reproducerbart bygge har samma fingeravtryck som den publicerade appen.";
"onboarding.carousel.open_source.action.github" = "Granska på GitHub";
"onboarding.carousel.open_source.visual.repository" = "Offentligt källkodsförråd";
"onboarding.carousel.open_source.visual.repository.path" = "Visa github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Granska källkoden";
"onboarding.carousel.open_source.visual.rebuild" = "Reproducera versionsbygget";
"onboarding.carousel.open_source.visual.compare" = "Jämför byggartefakterna";
"onboarding.carousel.open_source.visual.fingerprint" = "Den publicerade versionens fingeravtryck";
"onboarding.carousel.open_source.visual.match" = "MATCHNING BEKRÄFTAD — BYGGET VERIFIERAT";
"onboarding.carousel.open_source.visual.accessibility" = "Ett diagram som visar att versionsverifiering kräver offentlig källkod, ett oberoende ombygge och matchande fingeravtryck.";
"onboarding.carousel.passphrase.eyebrow" = "VALFRI BIP-39-LÖSENFRAS";
"onboarding.carousel.passphrase.title" = "En återställningsfras. En extra hemlighet.";
"onboarding.carousel.passphrase.message" = "En BIP-39-lösenfras kombineras med din återställningsfras för att skapa en separat plånbok. Om återställningsorden avslöjas kräver den plånboken fortfarande den exakta lösenfrasen.";
"onboarding.carousel.passphrase.visual.phrase" = "Dina 24 återställningsord";
"onboarding.carousel.passphrase.visual.passphrase" = "Din extra hemliga lösenfras";
"onboarding.carousel.passphrase.visual.output" = "En separat plånbok med lösenfras";
"onboarding.carousel.passphrase.visual.requirement" = "Båda hemligheterna krävs för återställning";
"onboarding.carousel.passphrase.visual.accessibility" = "En återställningsfras på 24 ord kombineras med en hemlig BIP-39-lösenfras för att skapa en separat plånbok som kräver båda hemligheterna för återställning.";
"onboarding.carousel.passphrase.learn_more.action" = "Läs mer om hur det fungerar";
"onboarding.passphrase.learn_more.navigation" = "Så fungerar BIP-39-lösenfraser";
"onboarding.passphrase.learn_more.path.section" = "Två hemligheter, en plånbok";
"onboarding.passphrase.learn_more.overview" = "En BIP-39-lösenfras är en valfri hemlighet som kombineras med återställningsfrasen. Tillsammans härleder de deterministiskt en annan plånbok än den som skapas enbart från återställningsfrasen.";
"onboarding.passphrase.learn_more.visual.phrase" = "Din återställningsfras med 24 ord";
"onboarding.passphrase.learn_more.visual.passphrase" = "Din hemliga lösenfras";
"onboarding.passphrase.learn_more.visual.wallet" = "En plånbok skyddad med lösenfras";
"onboarding.passphrase.learn_more.visual.accessibility" = "En återställningsfras med 24 ord och en hemlig lösenfras kombineras för att härleda en separat plånbok som skyddas med lösenfras.";
"onboarding.passphrase.learn_more.derivation.section" = "Så härleder BIP-39 plånboken";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Återställningsfras kombinerad med lösenfras";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 med 2 048 omgångar";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bitars huvudseed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Härledda plånbokskonton och adresser";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Återställningsfrasen och lösenfrasen bearbetas i 2 048 omgångar med PBKDF2-HMAC-SHA512 för att skapa den 512-bitars seed som plånbokskonton och adresser härleds från.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 använder den normaliserade återställningsfrasen som PBKDF2-lösenord och ordet \"mnemonic\" följt av den normaliserade lösenfrasen som salt. Efter 2 048 omgångar med PBKDF2-HMAC-SHA512 skapas en seed på 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Innan seed härleds tillämpar Oath den Unicode-normalisering som BIP-39 kräver, så att samma normaliserade återställningsfras och lösenfras alltid återskapar samma plånbok.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "En lösenfras krypterar inte återställningsorden. Den ändrar den seed som härleds, så varje unik lösenfras skapar olika konton och adresser.";
"onboarding.passphrase.learn_more.wallets.section" = "Varje lösenfras härleder en separat plånbok";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Exempellösenfras 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Exempellösenfras 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Exempelplånbok A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Exempelplånbok B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Samma återställningsfras kombinerad med två olika lösenfraser härleder två separata plånböcker: plånbok A och plånbok B.";
"onboarding.passphrase.learn_more.wallets.different" = "Om ett enda tecken ändras härleds en annan seed och därmed en annan plånbok. Den ursprungliga plånboken förblir oförändrad.";
"onboarding.passphrase.learn_more.wallets.empty" = "En tom lösenfras öppnar standardplånboken som härleds enbart från återställningsfrasen. En lösenfras som inte är tom öppnar en egen, separat plånbok.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 ger inget svar om \"fel lösenfras\". Varje lösenfras är giltig, så ett skrivfel öppnar en annan plånbok utan varning, oftast med nollsaldo.";
"onboarding.passphrase.learn_more.security.section" = "Så ger en lösenfras extra skydd";
"onboarding.passphrase.learn_more.security.words.title" = "Återställningsord räcker inte";
"onboarding.passphrase.learn_more.security.words.detail" = "Om någon bara får återställningsfrasen behöver de fortfarande den exakta lösenfrasen för att härleda och komma åt den skyddade plånboken.";
"onboarding.passphrase.learn_more.security.strength.title" = "Styrka ger bättre avskiljning";
"onboarding.passphrase.learn_more.security.strength.detail" = "En lång, oförutsägbar lösenfras gör gissningar betydligt svårare. Ett kort citat, ett födelsedatum, ett namn eller ett återanvänt lösenord kan gissas snabbt och ger svagt skydd.";
"onboarding.passphrase.learn_more.security.separation.title" = "Förvara lösenfrasen separat";
"onboarding.passphrase.learn_more.security.separation.detail" = "Förvara lösenfrasen åtskild från återställningsfrasen, så att en stulen säkerhetskopia inte avslöjar båda hemligheterna som krävs för att återställa plånboken.";
"onboarding.passphrase.learn_more.security.footer" = "En lösenfras kan inte skydda dina tillgångar om båda hemligheterna röjs, om lösenfrasen är svag eller om komprometterad programvara fångar upp den när du skriver.";
"onboarding.passphrase.learn_more.safety.section" = "Använd funktionen på ett säkert sätt";
"onboarding.passphrase.learn_more.safety.strong.title" = "Välj en stark, unik lösenfras";
