// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "ದೃಢೀಕರಣ ಬಟನ್ ಬದಲಿಗೆ ಸ್ಲೈಡ್ ಮಾಡಿ ಕಳುಹಿಸುವ ಸೌಲಭ್ಯ ಬಂದಿದೆ. ದಿಕ್ಕಿನ ಅನಿಮೇಶನ್, ಸ್ಪರ್ಶ ಪ್ರತಿಕ್ರಿಯೆ ಮತ್ತು ಮೃದುವಾದ ಚಲನೆ ಎರಡೂ ಓದುವ ದಿಕ್ಕುಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತವೆ. ಕಳುಹಿಸಲು 90% ಅಥವಾ ಮುಂದೆ ಬೆರಳು ಬಿಡಿ; ರದ್ದುಪಡಿಸಲು ಹಿಂದಕ್ಕೆ ಸರಿಸಿ.";
"settings.about.history.v355.build56.activity" = "ಗಂಟೆ ಚಿಹ್ನೆ ಬಾಕಿ ಚಟುವಟಿಕೆಯನ್ನು ತೆರೆಯುತ್ತದೆ. ವಹಿವಾಟಿನ ಕ್ಯಾಪ್ಸೂಲ್‌ಗಳು ಸ್ಥಿತಿ ಬ್ಯಾಡ್ಜ್ ತೋರಿಸುತ್ತವೆ; ಸ್ವೈಪ್ ಮಾಡಿ ಮರೆಮಾಡಬಹುದು. ದೃಢೀಕರಣದಲ್ಲಿರುವ ಮತ್ತು ದೃಢೀಕೃತ ಕ್ಯಾಪ್ಸೂಲ್‌ಗಳು 3 ಸೆಕೆಂಡ್ ನಂತರ ಮರೆಯಾಗುತ್ತವೆ; ದೃಢೀಕರಣ ಅದೇ ಕಾಣುತ್ತಿರುವ ಕ್ಯಾಪ್ಸೂಲ್ ಅನ್ನು ನವೀಕರಿಸುತ್ತದೆ.";
"settings.about.history.v355.build56.status" = "ಬೆಂಬಲಿತ ಎಲ್ಲ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಹೆಚ್ಚು ವಿಶ್ವಾಸಾರ್ಹ ವಹಿವಾಟಿನ ಸ್ಥಿತಿ, ತಾಜಾ ವಿವರಗಳು ಮತ್ತು ಕಳುಹಿಸಿದ ನಂತರ ವೇಗವಾದ ಬ್ಯಾಲೆನ್ಸ್ ನವೀಕರಣಗಳು. ಆ್ಯಪ್ ಮತ್ತೆ ತೆರೆದಾಗ ಬಾಕಿ ವಹಿವಾಟುಗಳ ಮೇಲ್ವಿಚಾರಣೆ ಮುಂದುವರಿಯುತ್ತದೆ.";
"settings.about.history.v355.build56.fees" = "ಅದೇ ವರ್ಗಾವಣೆಯ ಪರಿಶೀಲನೆಗೆ ಹಿಂದಿರುಗಿದಾಗ ಸಿದ್ಧವಾದ ಶುಲ್ಕ ಉಳಿಯುತ್ತದೆ. ಶುಲ್ಕ ಲೋಡಿಂಗ್ ಮತ್ತು ಖಾತೆಗೆ ಹಣ ಒದಗಿಸುವ ಎಚ್ಚರಿಕೆಗಳು ಹೆಚ್ಚು ಸ್ಪಷ್ಟವಾಗಿವೆ; ಸಾಕಷ್ಟು ಮೊತ್ತವಿದ್ದರೆ ಸಕ್ರಿಯಗೊಳಿಸುವ ಸೂಚನೆ ಕಾಣುವುದಿಲ್ಲ.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin ಮತ್ತು Dogecoin ಡಸ್ಟ್ ಮಿತಿಗಿಂತ ಕಡಿಮೆ ವಾಪಸಾಗುವ ಉಳಿಕೆ ಹಣವನ್ನು ಬಳಸಲಾಗದ ಔಟ್‌ಪುಟ್ ಮಾಡುವ ಬದಲು ಶುಲ್ಕಕ್ಕೆ ಸೇರಿಸುತ್ತವೆ. ಪರಿಶೀಲಿಸಿದ ಶುಲ್ಕ ಸಹಿ ಮಾಡುವಾಗಿನ ಶುಲ್ಕಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುತ್ತದೆ.";
"settings.about.history.v355.build56.stability" = "ಹಿನ್ನೆಲೆ ಕಾರ್ಯದ ಕ್ರ್ಯಾಶ್ ಮತ್ತು ವಾಲೆಟ್ ರಿಫ್ರೆಶ್ ಸಮಯ ಮೀರಿದ ಎಚ್ಚರಿಕೆಗಳನ್ನು ಸರಿಪಡಿಸಲಾಗಿದೆ. ರಿಫ್ರೆಶ್ ತಾತ್ಕಾಲಿಕವಾಗಿ ವಿಫಲವಾದರೂ ಈಗಿರುವ ವಾಲೆಟ್ ಮಾಹಿತಿ ಲಭ್ಯವಿರುತ್ತದೆ.";
"settings.about.history.v355.build56.backup" = "ತೆರೆದಾಗ ಸರಿಯಾದ ಶೀರ್ಷಿಕೆ ಮತ್ತು ಕಡಿಮೆ ಸಂದೇಶಗಳಿರುವ ಸ್ವಚ್ಛ ಬ್ಯಾಕಪ್ ಪರದೆಗಳು. ಖಾಸಗಿ ಕೀ ಪ್ರವೇಶ ಆ್ಯಪ್ ಲಾಕ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಗೌರವಿಸುತ್ತದೆ. ಕಾಂಪ್ಯಾಕ್ಟ್ ಗಾಜಿನ ವಿನ್ಯಾಸದ ಆಮದು ಎಚ್ಚರಿಕೆಗಳಲ್ಲಿ ಮತ್ತೊಂದು ಮರುಪಡೆಯುವ ಪದಗುಚ್ಛ ಆರಿಸಿದಾಗ ತಿರಸ್ಕೃತ ಇನ್‌ಪುಟ್ ತೆರವಾಗುತ್ತದೆ.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "ಕಳುಹಿಸುವ ಸ್ಲೈಡರ್ ಬಿಟ್ಟ ನಂತರ, ಪರಿಶೀಲನಾ ಪರದೆ ಮುಚ್ಚುವ ಮೊದಲು ಚಲಿಸುವ ಟಿಕ್ ಗುರುತು ಕಾಣಿಸುತ್ತದೆ.";
"settings.about.history.v355.build57.activity" = "ಚಟುವಟಿಕೆಯ ಸಾಲುಗಳಲ್ಲಿ ಸ್ಥಿತಿ ಪಠ್ಯ ಕಡಿಮೆ ದಪ್ಪವಾಗಿ, ಮೊತ್ತ ಉಪಶೀರ್ಷಿಕೆಯಾಗಿ ಮತ್ತು ವಹಿವಾಟಿನ ವಿವರಗಳನ್ನು ತೆರೆಯಲು ಬಾಣ ಕಾಣಿಸುತ್ತದೆ.";
"settings.about.history.v355.build57.details" = "ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕಗಳು ಈಗ ವರ್ಗಾವಣೆಯ ಸಾರಾಂಶದಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ. ಚಿಕ್ಕ ಲೇಬಲ್‌ಗಳು ಮತ್ತು ನೆಟ್‌ವರ್ಕ್‌ನ ಒಂದೇ ಸಾಲು ವಿವರಗಳನ್ನು ಸ್ಪಷ್ಟಗೊಳಿಸುತ್ತವೆ.";
"settings.about.history.v355.build57.resume" = "ಹಿನ್ನೆಲೆಯಿಂದ ಹಿಂತಿರುಗಿದಾಗ ತೆರೆದ ಪರದೆಗಳು ಮತ್ತು ಫಲಕಗಳು ಉಳಿಯುತ್ತವೆ; ವರ್ಗಾವಣೆಯ ಪರಿಶೀಲನೆ ಮತ್ತು ವಹಿವಾಟಿನ ವಿವರಗಳೂ ಇದರಲ್ಲಿ ಸೇರಿವೆ.";
"settings.about.history.v355.build57.secrets" = "ಆ್ಯಪ್‌ನಿಂದ 20 ಸೆಕೆಂಡ್ ದೂರವಿದ್ದರೆ ಮರುಪಡೆಯುವ ಪದಗುಚ್ಛ, ಖಾಸಗಿ ಕೀ ಮತ್ತು ಪಾಸ್‌ಫ್ರೇಸ್ ಪರದೆಗಳು ಮುಚ್ಚುತ್ತವೆ. ಆ್ಯಪ್ ಲಾಕ್ ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪ್ರಕಾರವೇ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ.";
"settings.about.history.v355.build57.filters" = "ನೆಟ್‌ವರ್ಕ್ ಫಿಲ್ಟರ್‌ಗಳು ಸ್ವಲ್ಪ ಎತ್ತರದ ಸಿಸ್ಟಂ ಬಟನ್‌ಗಳು, ವಿಷಯಕ್ಕೆ ತಕ್ಕ ಗಾತ್ರ ಮತ್ತು ನ್ಯಾವಿಗೇಷನ್ ಪಟ್ಟಿಯ ಕೆಳಗೆ ಸರಿಪಡಿಸಿದ ಅಂತರವನ್ನು ಬಳಸುತ್ತವೆ.";
"settings.about.history.v355.build57.units" = "ಪ್ರತ್ಯೇಕ ಮೌಲ್ಯದ ಸಾಲುಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಮೊತ್ತ ಮತ್ತು ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ಮೊದಲು ಸ್ಥಳೀಯ ಕರೆನ್ಸಿಯಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ; ಕ್ರಿಪ್ಟೋ ಘಟಕಗಳಿಗೆ ಬದಲಿಸಲು ಮತ್ತು ಹಿಂತಿರುಗಲು ಯಾವುದನ್ನಾದರೂ ಟ್ಯಾಪ್ ಮಾಡಿ.";
"wallet.transaction.details.toggle_units" = "ಘಟಕಗಳನ್ನು ಬದಲಿಸಿ.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "ಮುಖಪುಟವು ಮಸುಕಾಗುವಿಕೆ ಅಥವಾ ಗಾತ್ರ ಬದಲಾವಣೆಯ ಪರಿಣಾಮಗಳಿಲ್ಲದೆ ತೆರೆಯುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಬಟನ್ ಈಗ ಗೇರ್ ಚಿಹ್ನೆಯನ್ನು ಬಳಸುತ್ತದೆ.";
"settings.about.history.v355.build58.fields" = "ವಹಿವಾಟು ಮತ್ತು ಕಳುಹಿಸುವಿಕೆಯ ಕ್ಷೇತ್ರಗಳು ಸಾಮಾನ್ಯ ಪಠ್ಯ ಬಣ್ಣಗಳನ್ನು ಬಳಸುತ್ತವೆ. ಪರದೆ ಅಥವಾ ಫಲಕವನ್ನು ತೆರೆಯುವ ಸಾಲುಗಳಲ್ಲಿ ಮಾತ್ರ ಬಾಣಗಳು ಕಾಣುತ್ತವೆ; ಮೊತ್ತ ಮತ್ತು ಶುಲ್ಕವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ಮೊದಲಿನಂತೆಯೇ ಘಟಕ ಬದಲಾಗುತ್ತದೆ.";
"settings.about.history.v355.build58.banners" = "ಒಮ್ಮೆ ತೋರಿಸಿದ ನಂತರ, ದೃಢೀಕರಣ ನಡೆಯುತ್ತಿರುವ ಅಥವಾ ಪೂರ್ಣಗೊಂಡ ಬ್ಯಾನರ್‌ಗಳು 3 ಸೆಕೆಂಡುಗಳ ಬಳಿಕ ಮರೆಯಾಗುತ್ತವೆ, ನೀವು ಬೇರೆ ಪರದೆಯನ್ನು ತೆರೆದರೂ ಸಹ. ಇನ್ನೂ ತೋರಿಸದ ದೃಢೀಕರಣದ ನವೀಕರಣಗಳು ನೀವು ಹಿಂದಿರುಗಿದಾಗ ಕಾಣುತ್ತವೆ.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON ವರ್ಗಾವಣೆಗಳಲ್ಲಿ ಈಗ ಗರಿಷ್ಠ ಮೊತ್ತವನ್ನು ಕಳುಹಿಸುವಾಗಲೂ ಕಳುಹಿಸಬೇಕಾದ ಮೊತ್ತವನ್ನು ಲೆಕ್ಕಹಾಕುವ ಮೊದಲು ಸಕ್ರಿಯಗೊಳಿಸುವಿಕೆ ಮತ್ತು ಬ್ಯಾಂಡ್‌ವಿಡ್ತ್ ಶುಲ್ಕಗಳಿಗೆ ಹಣವನ್ನು ಮೀಸಲಿಡಲಾಗುತ್ತದೆ. ಪರಿಶೀಲನೆ ಪರದೆಯು ಶುಲ್ಕಗಳನ್ನು ಕಳೆದ ನಂತರದ ಸರಿಯಾದ ಮೊತ್ತವನ್ನು ತೋರಿಸುತ್ತದೆ.";
"settings.about.history.v355.build59.fees" = "ಸ್ವತಃ ನಿಗದಿಪಡಿಸಿದ TRON ಶುಲ್ಕಗಳು ಅಗತ್ಯ ನೆಟ್‌ವರ್ಕ್ ವೆಚ್ಚಗಳನ್ನು ಭರಿಸಬೇಕು. TRX ಬ್ಯಾಲೆನ್ಸ್ ಕಡಿಮೆ ಇದ್ದಾಗ ಈಗ ಇನ್ನಷ್ಟು ಸ್ಪಷ್ಟ ಮಾರ್ಗದರ್ಶನ ಕಾಣಿಸುತ್ತದೆ. ಟೋಕನ್ ಪ್ರಮಾಣ ಬದಲಾಗುವುದಿಲ್ಲ; ಶುಲ್ಕಗಳನ್ನು TRXನಲ್ಲಿ ಪಾವತಿಸಲಾಗುತ್ತದೆ.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "ಹೊಸ ಸ್ವಾಗತ";
"settings.about.history.v356.welcome" = "ಅನಿಮೇಟೆಡ್ ಕಲಾಕೃತಿಯೊಂದಿಗೆ ಹೊಸ ಸ್ವಾಗತ ಪರದೆ ಮತ್ತು ವಾಲೆಟ್ ರಚಿಸಲು ಅಥವಾ ಆಮದು ಮಾಡಿಕೊಳ್ಳಲು ಸ್ಪಷ್ಟ ಆಯ್ಕೆಗಳು.";
"settings.about.history.v357.tour.title" = "ಸ್ವಾಗತ ಪ್ರವಾಸ";
"settings.about.history.v357.tour" = "ಐದು ಪುಟಗಳ ಪ್ರವಾಸವು ಬೆಂಬಲಿತ ನೆಟ್‌ವರ್ಕ್‌ಗಳು, ಭೌತಿಕ ಎಂಟ್ರೊಪಿ, ಕಳುಹಿಸುವಿಕೆ ಮತ್ತು ಸ್ವೀಕರಿಸುವಿಕೆ, ಭದ್ರತೆ ಮತ್ತು ಪರಿಶೀಲಿತ ಬಿಲ್ಡ್‌ಗಳನ್ನು ಪರಿಚಯಿಸುತ್ತದೆ. ಪುಟ ಬದಲಿಸಲು ಸ್ವೈಪ್ ಮಾಡಿ ಅಥವಾ ಚುಕ್ಕೆಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ; ಭಾಷೆ ಬದಲಾವಣೆ ನ್ಯಾವಿಗೇಷನ್ ಬಾರ್‌ನಲ್ಲಿದೆ.";
"settings.about.history.v357.backup" = "ವ್ಯಾಲೆಟ್ ರಚಿಸಿದ, ಆಮದು ಮಾಡಿದ ಅಥವಾ ಮರುಸ್ಥಾಪಿಸಿದ ನಂತರ ಪರದೆ ತಕ್ಷಣ ಕಾಣಿಸುತ್ತದೆ ಮತ್ತು ಅದರ ಬ್ಯಾಕಪ್ ಆಯ್ಕೆಗಳು ಪ್ರಮಾಣಿತ ಪಟ್ಟಿಯನ್ನು ಬಳಸುತ್ತವೆ. iCloud ಪರಿಶೀಲನೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ನಡೆಯುತ್ತದೆ, ವ್ಯಾಲೆಟ್ ಉಳಿಸಿದ ತಕ್ಷಣ ವ್ಯಾಲೆಟ್ ತೆರೆಯಿರಿ ಸಿದ್ಧವಿರುತ್ತದೆ.";
"settings.about.history.v357.reliability" = "ಮರೆಮಾಡಿದ ಮರುಪಡೆಯುವಿಕೆ ಪರದೆಯ ಅವಧಿ ಮುಗಿದಾಗ ಹಿನ್ನೆಲೆಯಿಂದ ಹಿಂತಿರುಗುವುದು ಇನ್ನು ಮುಂದೆ ಸೆಟಪ್ ಪರದೆಯನ್ನು ಮುಚ್ಚುವುದಿಲ್ಲ, ಮತ್ತು ಎಲ್ಲಾ ಡೇಟಾ ಅಳಿಸಿದರೆ ನೇರವಾಗಿ ಸ್ವಾಗತ ಪರದೆ ತೆರೆಯುತ್ತದೆ.";
"settings.about.history.v357.notifications" = "ಅಧಿಸೂಚನೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ವರ್ಗಗಳು ಮತ್ತು ಸ್ಥಿತಿಗೆ ತಾಂತ್ರಿಕ ವಿವರಗಳಿಲ್ಲದೆ ಸರಳ ಪದಗಳನ್ನು ಬಳಸುತ್ತವೆ.";
"settings.about.history.v357.wallets" = "ಸ್ವಿಚರ್‌ನಲ್ಲಿ ವ್ಯಾಲೆಟ್‌ಗಳನ್ನು ದೀರ್ಘ ಒತ್ತಿನೊಂದಿಗೆ ಸಿಸ್ಟಂನ ಎತ್ತುವ ಅನಿಮೇಷನ್ ಬಳಸಿ ಮರುಜೋಡಿಸಿ; ಸಾಲನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿದರೆ ಅದು ಸಕ್ರಿಯವಾಗುತ್ತದೆ. ರಿಕವರಿ ಫ್ರೇಸ್ ಪರಿಶೀಲನೆ ಪ್ರತಿ ಪದಕ್ಕೆ ಸಂಖ್ಯೆ ನೀಡುತ್ತದೆ, ಮತ್ತು Return ಮುಂದಿನ ಕ್ಷೇತ್ರಕ್ಕೆ ಹೋಗುತ್ತದೆ.";
"settings.about.history.v357.send" = "ವರ್ಗಾವಣೆ ನಡೆಯುತ್ತಿರುವಾಗ ಕಳುಹಿಸುವಿಕೆ ಮೊತ್ತವನ್ನು ತೋರಿಸುತ್ತದೆ, ಕಳುಹಿಸಲಾಗದಿದ್ದರೆ ಸ್ಪಷ್ಟವಾದ ಸಂದೇಶ ಕಾಣಿಸುತ್ತದೆ, ಮತ್ತು ತಾತ್ಕಾಲಿಕ ಪೂರೈಕೆದಾರ ದೋಷಗಳ ನಂತರ TRON ವಿನಂತಿಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮರುಪ್ರಯತ್ನಿಸುತ್ತವೆ.";
"settings.about.history.v357.security" = "ಮಾಲೀಕ ಅನುಮತಿಯನ್ನು ಬೇರೆ ಕೀಗೆ ವರ್ಗಾಯಿಸಿದ ಆಮದು ಮಾಡಿದ TRON ಖಾತೆಗಳು ಈಗ ಪ್ರತಿ ಅನುಮತಿಯಲ್ಲಿ ಒಂದೇ ಕೀ ಇದ್ದರೂ ಎಚ್ಚರಿಕೆ ತೋರಿಸುತ್ತವೆ ಮತ್ತು ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ. ಬಹಿರಂಗಗೊಂಡಿವೆ ಎಂದು ತಿಳಿದಿರುವ ಹೆಚ್ಚಿನ ರಿಕವರಿ ಫ್ರೇಸ್‌ಗಳು ಮತ್ತು ಖಾಸಗಿ ಕೀಗಳನ್ನು ಆಮದು ಮಾಡುವಾಗ ನಿರಾಕರಿಸಲಾಗುತ್ತದೆ.";
"settings.about.history.v356.localization" = "ಬೆಂಬಲಿತ ಎಲ್ಲ ಭಾಷೆಗಳಲ್ಲಿ ಸ್ವಾಗತ ಪರದೆಯ ಪಠ್ಯವನ್ನು ಹೆಚ್ಚು ಸಹಜವಾಗಿ ಮತ್ತು ಸ್ಪಷ್ಟವಾಗಿ ಪರಿಷ್ಕರಿಸಲಾಗಿದೆ.";
"settings.about.history.v356.pricing" = "ಟೋಕನ್ ಬೆಲೆಗಳು ಈಗ ನಿಖರವಾದ ನೆಟ್‌ವರ್ಕ್ ಮತ್ತು ಟೋಕನ್ ವಿಳಾಸಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುತ್ತವೆ, ಮೊದಲು DEX ಬೆಲೆಗಳನ್ನು ಬಳಸಿ. ಸಣ್ಣ ಬೆಲೆಗಳು ಪೂರ್ಣಗೊಳ್ಳದೆ 8 ದಶಮಾಂಶ ಸ್ಥಾನಗಳನ್ನು ತೋರಿಸುತ್ತವೆ.";
"settings.about.history.v356.appearance" = "ಪ್ರಾಥಮಿಕ ಮತ್ತು ಮಾಧ್ಯಮಿಕ ಬಟನ್‌ಗಳು ಈಗ ಸ್ಥಿರವಾದ ಎತ್ತರಗಳು ಮತ್ತು ಪರದೆಯ ಅಂಚುಗಳನ್ನು ಬಳಸುತ್ತವೆ, ಪ್ರಾಥಮಿಕ ಕ್ರಿಯೆಗಳಿಗಾಗಿ ಸಿಸ್ಟಮ್ ನೀಲಿ ಬಣ್ಣದೊಂದಿಗೆ.";
"settings.about.history.v356.transactions" = "ವಹಿವಾಟಿನ ವಿವರಗಳು ದಿನಾಂಕಗಳು, ವಿಳಾಸಗಳು, ಮೊತ್ತಗಳು ಮತ್ತು ವಹಿವಾಟು ಐಡಿಗಳಿಗಾಗಿ ಚಿಕ್ಕದಾದ ದೃಢೀಕೃತ ಸ್ಥಿತಿ ಮತ್ತು ಸ್ಪಷ್ಟವಾದ ಬೂದು ಪಠ್ಯವನ್ನು ಬಳಸುತ್ತವೆ.";
"settings.about.history.v356.security" = "ತಿಳಿದಿರುವ ಬಹಿರಂಗ ಮರುಪಡೆಯುವಿಕೆ ನುಡಿಗಟ್ಟುಗಳು ಮತ್ತು ಆಮದು ಮಾಡಲಾಗದ ಖಾಸಗಿ ಕೀಗಳ ಪಟ್ಟಿಯನ್ನು ವಿಸ್ತರಿಸಲಾಗಿದೆ.";

