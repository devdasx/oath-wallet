"send.submit.error.tron_signature" = "ವಹಿವಾಟಿನ ಸಹಿಯನ್ನು ಪರಿಶೀಲಿಸಲು TRON ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಖಾತೆಯ ಸಹಿ ಮಾಡುವ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ: ಹೆಚ್ಚುವರಿ ಸಹಿಗಳು ಅಥವಾ ಬೇರೊಂದು ಅಧಿಕೃತ ಕೀ ಬೇಕಾಗಬಹುದು.";

"tron.permissions.warning.title" = "ಬಹು ಸಹಿಗಳ TRON ವ್ಯಾಲೆಟ್";
"tron.permissions.warning.body" = "ಈ ವ್ಯಾಲೆಟ್‌ಗೆ ಹಲವು TRON ಸಹಿಗಳು ಬೇಕಾಗುತ್ತವೆ. ಈ ಆ್ಯಪ್‌ನಲ್ಲಿ ಕಳುಹಿಸುವಿಕೆ, ಸ್ವೀಕಾರ ಮತ್ತು ವ್ಯಾಲೆಟ್ ಕಾರ್ಯಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ.\n\nಬಹು ಸಹಿಗಳಿಗೆ ಕಾನೂನುಬದ್ಧ ಬಳಕೆಗಳೂ ಇವೆ. ಯಾರಾದರೂ ನಿಮಗೆ ಈ ವ್ಯಾಲೆಟ್ ನೀಡಿದ್ದರೆ, ಅದರ ಟೋಕನ್‌ಗಳನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲು TRX ಜಮಾ ಮಾಡಬೇಡಿ. ಅಗತ್ಯ ಸಹಿಗಳು ಅವರ ನಿಯಂತ್ರಣದಲ್ಲಿರಬಹುದು ಮತ್ತು ನೀವು ಜಮಾ ಮಾಡಿದ ಹಣವನ್ನು ಕದಿಯಬಹುದು.";
"tron.permissions.unavailable" = "TRON ಸಹಿ ಅನುಮತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.";

"wallet.restrictions.warning.title" = "ವಾಲೆಟ್‌ನಲ್ಲಿ ನಿರ್ಬಂಧಗಳು ಕಂಡುಬಂದಿವೆ";

"wallet.blacklist.warning.body" = "ಕೆಳಗೆ ಪಟ್ಟಿ ಮಾಡಿದ ಟೋಕನ್ ಒಪ್ಪಂದಗಳು ಈ ವಿಳಾಸವು ಕಪ್ಪುಪಟ್ಟಿಯಲ್ಲಿದೆ ಎಂದು ತಿಳಿಸಿವೆ. ಈ ಟೋಕನ್‌ಗಳ ವರ್ಗಾವಣೆ ನಿರ್ಬಂಧಿತವಾಗಿರಬಹುದು. ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕಕ್ಕಾಗಿ ಹಣ ಸೇರಿಸಿದರೂ ನಿರ್ಬಂಧ ತೆರವಾಗುವುದಿಲ್ಲ.";


"import.safety.action.different_recovery_phrase" = "ಬೇರೆ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಬಳಸಿ";

