"settings.about.history.v354.build53.imports" = "Bitcoin ಆಮದಿಗೆ ಇನ್ನಷ್ಟು ಆಯ್ಕೆಗಳು: BIP38, ಹೆಕ್ಸ್ ಕೀಗಳು, ಮಿನಿ ಕೀಗಳು, ವಿಸ್ತೃತ ಕೀಗಳು, ಖಾಸಗಿ ಡಿಸ್ಕ್ರಿಪ್ಟರ್‌ಗಳು, wallet.dat, Electrum, TXT, CSV ಮತ್ತು JSON. ಬೆಂಬಲಿತ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಕೀಗಳು ಮತ್ತು ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಒಂದೇ ಹಂತದಲ್ಲಿ ಡಿಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಆಮದು ಮಾಡಿ.";
"settings.about.history.v354.build53.files" = "ಫೈಲ್ ಹೆಸರು, ಗಾತ್ರ, ಬದಲಿಸುವ ಮತ್ತು ತೆರವುಗೊಳಿಸುವ ಆಯ್ಕೆಗಳು, ಚಿಕ್ಕ ಆಮದು ಬಟನ್ ಹಾಗೂ ಸುಗಮ ಪರಿವರ್ತನೆಗಳೊಂದಿಗೆ ಫೈಲ್ ಆಮದು ಇನ್ನಷ್ಟು ಸ್ಪಷ್ಟವಾಗಿದೆ. ಅನಗತ್ಯ ಶೀರ್ಷಿಕೆಗಳು ಮತ್ತು ಸ್ಥಿತಿ ಪಠ್ಯವನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ.";
"settings.about.history.v354.build53.send" = "Bitcoin ಇನ್‌ಪುಟ್‌ಗಳ ಕೈಯಾರೆ ಆಯ್ಕೆಯನ್ನು ಸರಿಪಡಿಸಲಾಗಿದೆ. ಶುಲ್ಕ, ಹಿಂತಿರುಗುವ ಮೊತ್ತ ಮತ್ತು ಅಂತಿಮ ವಹಿವಾಟಿನ ಲೆಕ್ಕದಲ್ಲಿ ಈಗ ಆಯ್ಕೆ ಮಾಡಿದ ಎಲ್ಲಾ ಇನ್‌ಪುಟ್‌ಗಳು ಸೇರಿವೆ.";

// Expanded Bitcoin release history
"settings.about.history.v354.core.title" = "Bitcoin Core ಬ್ಯಾಕಪ್‌ಗಳು";
"settings.about.history.v354.electrum.title" = "Electrum ವಾಲೆಟ್ ಫೈಲ್‌ಗಳು";
"settings.about.history.v354.build53.encrypted" = "BIP38 ಕೀಗಳನ್ನು ಒಂದೇ ಹಂತದಲ್ಲಿ ಡೀಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಆಮದು ಮಾಡಿ. ಸಂಕುಚಿತ ಕೀಗಳು Legacy, Nested SegWit, Native SegWit ಮತ್ತು Taproot ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತವೆ; ಸಂಕುಚಿತವಲ್ಲದ ಕೀಗಳು Legacy ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತವೆ.";
"settings.about.history.v354.build53.core" = "ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾದ ಹಳೆಯ ಮತ್ತು ಡಿಸ್ಕ್ರಿಪ್ಟರ್ ವಾಲೆಟ್‌ಗಳು ಸೇರಿದಂತೆ ಬೆಂಬಲಿತ Bitcoin Core wallet.dat ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿ.";
"settings.about.history.v354.build53.electrum" = "ಹಳೆಯ ಮತ್ತು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾದ ಸ್ವರೂಪಗಳು ಸೇರಿದಂತೆ ಬೆಂಬಲಿತ ಏಕ-ಸಹಿಯ Electrum ಫೈಲ್‌ಗಳನ್ನು ಮೂಲ ಸ್ವೀಕೃತಿ/ಚಿಲ್ಲರೆ ವಿಳಾಸಗಳು ಮತ್ತು ಕಸ್ಟಮ್ ಡೆರಿವೇಶನ್ ಪಥಗಳೊಂದಿಗೆ ಮರುಸ್ಥಾಪಿಸಿ.";
"settings.about.history.v354.build53.discovery" = "BRD ವಿಳಾಸ ಆಯ್ಕೆ, ಬ್ಯಾಲೆನ್ಸ್ ಮತ್ತು ವಹಿವಾಟು ಹುಡುಕಾಟ, ಕಳುಹಿಸುವಿಕೆ ಮತ್ತು ಕೀ ರಫ್ತನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. ಆಮದು ಮಾಡಿದ ಕೀ ಸಂಗ್ರಹಗಳು ಸ್ವೀಕೃತಿ/ಚಿಲ್ಲರೆ ವಿಳಾಸ ಹುಡುಕಾಟ ಮತ್ತು ಮಿಶ್ರ ಇನ್‌ಪುಟ್‌ಗಳಿಂದ ಖರ್ಚು ಮಾಡುವುದನ್ನು ಬೆಂಬಲಿಸುತ್ತವೆ.";
"settings.about.history.v354.build53.backup" = "ರಫ್ತು ಮಾಡುವಾಗ, ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾದ iCloud ಬ್ಯಾಕಪ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸುವಾಗ ಅಥವಾ ಹೊಸ ಸಾಧನಕ್ಕೆ ವರ್ಗಾಯಿಸುವಾಗ ಆಮದು ಮಾಡಿದ Bitcoin ಸಂಗ್ರಹಗಳ ಎಲ್ಲ ಕೀಗಳು ಉಳಿಯುತ್ತವೆ.";

