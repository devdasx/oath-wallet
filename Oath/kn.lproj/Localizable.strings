"settings.about.history.v358.arc.title" = "Arc ನೆಟ್‌ವರ್ಕ್";
"settings.about.history.v358.arc" = "ಶುಲ್ಕವನ್ನು USDC ನಲ್ಲಿ ಪಾವತಿಸುವ Circle ನ ನೆಟ್‌ವರ್ಕ್ Arc ಈಗ ಸ್ವೀಕರಿಸಲು, ಕಳುಹಿಸಲು, ಬಾಕಿ ಮತ್ತು ಚಟುವಟಿಕೆಗೆ ಬೆಂಬಲಿತವಾಗಿದೆ, ಜೊತೆಗೆ EURC, Circle Wrapped Bitcoin ಮತ್ತು ಇತರ Arc ಟೋಕನ್‌ಗಳು. ವರ್ಗಾವಣೆಗಳು ದೃಢೀಕರಿಸಲು ಶುಲ್ಕವು ನೆಟ್‌ವರ್ಕ್‌ನ ಕನಿಷ್ಠಕ್ಕಿಂತ ಮೇಲಿರುತ್ತದೆ.";
"settings.about.history.v358.stocks.title" = "ಟೋಕನೀಕೃತ ಷೇರುಗಳು";
"settings.about.history.v358.stocks" = "BNB Smart Chain ನಲ್ಲಿ ಟೋಕನೀಕೃತ ಅಮೆರಿಕದ ಷೇರುಗಳು ಮತ್ತು ETF ಆದ Binance bStocks ಗೆ ಸ್ವೀಕರಿಸಿ ಮತ್ತು ಕಳುಹಿಸಿಯಲ್ಲಿ ತಮ್ಮದೇ bStocks ಫಿಲ್ಟರ್ ಇದೆ, ಅವುಗಳ ಶುಲ್ಕ ಪಾವತಿಸುವ ನಾಣ್ಯ BNB ನಂತರ ಪಟ್ಟಿಯಾಗಿದೆ. ಅವುಗಳ ಸಾಲುಗಳು bStocks ಮತ್ತು BNB ಎರಡೂ ಬ್ಯಾಡ್ಜ್‌ಗಳನ್ನು ತೋರಿಸುತ್ತವೆ.";
"settings.about.history.v358.backup" = "ಖಾಸಗಿ ಕೀ ರಫ್ತು ಪರದೆಗಳು iCloud ಬ್ಯಾಕಪ್ ಸಾಲಿನೊಂದಿಗೆ ಹೊಂದಿಕೊಂಡಿವೆ ಮತ್ತು ಸ್ವೀಕೃತಿ ಪರದೆಯ QR ಕಾರ್ಡ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತವೆ, ಎಲ್ಲೆಡೆ ಸಮಾನ ಅಂತರದೊಂದಿಗೆ.";
"settings.about.history.v358.reliability" = "ಆ್ಯಪ್ ಅನ್ನು ನವೀಕರಿಸಿದಾಗ ಈಗ ಟೋಕನ್ ಪಟ್ಟಿ ತಕ್ಷಣ ತಾಜಾ ಆಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಕೊನೆಯ ನವೀಕರಣದ ನಂತರ ಸೇರಿಸಿದ ನೆಟ್‌ವರ್ಕ್‌ಗಳು ಮತ್ತು ಟೋಕನ್‌ಗಳು ಮರುಸ್ಥಾಪನೆ ಇಲ್ಲದೆ ಕಾಣಿಸುತ್ತವೆ. ಪಟ್ಟಿಯು ಈ ಆವೃತ್ತಿ ಬೆಂಬಲಿಸುವ ನೆಟ್‌ವರ್ಕ್‌ಗಳನ್ನು ಮಾತ್ರ ಡೌನ್‌ಲೋಡ್ ಮಾಡುತ್ತದೆ, ಮತ್ತು Arc ನಲ್ಲಿ ಸ್ಥಳೀಯ USDC ವರ್ಗಾವಣೆ ಚಟುವಟಿಕೆಯಲ್ಲಿ ಒಮ್ಮೆ ಮಾತ್ರ ಕಾಣಿಸುತ್ತದೆ.";

