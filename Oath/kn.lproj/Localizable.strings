"onboarding.carousel.entropy.message" = "ದಾಳ ಉರುಳಿಸಿ, ನಾಣ್ಯ ಚಿಮ್ಮಿಸಿ ಅಥವಾ ಯಾದೃಚ್ಛಿಕ ಅಂಕಿಗಳನ್ನು ದಾಖಲಿಸಿ. Oath ನಿಮ್ಮ ಭೌತಿಕ ಇನ್‌ಪುಟ್ ಅನ್ನು 24-ಪದಗಳ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛಕ್ಕಾಗಿ ನಿಖರವಾಗಿ 256 ಬಿಟ್‌ಗಳ ಎಂಟ್ರೋಪಿಯಾಗಿ, ಸಂಪೂರ್ಣವಾಗಿ ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಪರಿವರ್ತಿಸುತ್ತದೆ.";
"onboarding.carousel.entropy.visual.output" = "ಬಳಕೆದಾರರು ರಚಿಸಿದ 256 ಬಿಟ್‌ಗಳ ಎಂಟ್ರೋಪಿ";
"onboarding.carousel.entropy.visual.local" = "ನೀವು ದಾಖಲಿಸಿದ ಇನ್‌ಪುಟ್‌ಗಳಿಂದಲೇ ಸಂಪೂರ್ಣವಾಗಿ ರಚಿಸಲಾಗಿದೆ";
"onboarding.carousel.entropy.visual.accessibility" = "ಸಂಖ್ಯೆಯಿರುವ ದಾಳ, ನಾಣ್ಯ ಮತ್ತು ಯಾದೃಚ್ಛಿಕ ಅಂಕಿಗಳು ಒಟ್ಟಾಗಿ ಈ ಸಾಧನದಲ್ಲಿ 256 ಬಿಟ್‌ಗಳ ವ್ಯಾಲೆಟ್ ಎಂಟ್ರೋಪಿಯನ್ನು ಉತ್ಪಾದಿಸುತ್ತವೆ.";
"onboarding.carousel.entropy.learn_more.action" = "ಹೆಚ್ಚಿನ ವಿವರಗಳನ್ನು ತಿಳಿಯಿರಿ";
"onboarding.entropy.learn_more.navigation" = "ಭೌತಿಕ ಎಂಟ್ರೋಪಿ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ";
"onboarding.entropy.learn_more.path.section" = "ಭೌತಿಕ ಫಲಿತಾಂಶಗಳಿಂದ ಮರುಪಡೆಯುವಿಕೆ ಪದಗಳವರೆಗೆ";
"onboarding.entropy.learn_more.overview" = "Oath ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಭೌತಿಕ ಮೂಲದ ಫಲಿತಾಂಶಗಳನ್ನು ದಾಖಲಿಸಿ, ಅವನ್ನು 256-ಬಿಟ್ ಮೌಲ್ಯವಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ. ನಂತರ ಫಲಿತಾಂಶದ 32 ಬೈಟ್‌ಗಳನ್ನು ಪ್ರಮಾಣಿತ BIP-39 ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ರಚಿಸಲು Wallet Core ಗೆ ರವಾನಿಸುತ್ತದೆ.";
"onboarding.entropy.learn_more.visual.phrase" = "24-ಪದಗಳ BIP-39 ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ";
"onboarding.entropy.learn_more.visual.bits" = "32 ಬೈಟ್‌ಗಳು × 8 ಬಿಟ್‌ಗಳು ಎಂದರೆ 256 ಬಿಟ್‌ಗಳು";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "256 ಮಾದರಿ ಬಿಟ್ ಕೋಶಗಳನ್ನು 32 ಬೈಟ್‌ಗಳಾಗಿ ಜೋಡಿಸಿದ ಗ್ರಿಡ್.";
"onboarding.entropy.learn_more.visual.accessibility" = "ದಾಳದ ಉರುಳಿಕೆಗಳು, ನಾಣ್ಯದ ಚಿಮ್ಮುವಿಕೆಗಳು ಅಥವಾ ಯಾದೃಚ್ಛಿಕ ಅಂಕಿಗಳನ್ನು 256 ಬಿಟ್‌ಗಳಾಗಿ, ನಂತರ 24-ಪದಗಳ BIP-39 ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವಾಗಿ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ.";
"onboarding.entropy.learn_more.inputs.section" = "ಹಂತ 1: ಭೌತಿಕ ಫಲಿತಾಂಶಗಳನ್ನು ದಾಖಲಿಸಿ";
"onboarding.entropy.learn_more.inputs.dice.title" = "ನಿಷ್ಪಕ್ಷಪಾತ ಆರು ಮುಖದ ದಾಳವನ್ನು ಉರುಳಿಸಿ";
"onboarding.entropy.learn_more.inputs.dice.detail" = "ನಿಷ್ಪಕ್ಷಪಾತ ದಾಳದಲ್ಲಿ, 1–4 ಮುಖಗಳು ತಲಾ 2 ಬಿಟ್‌ಗಳನ್ನು ನೀಡುತ್ತವೆ; 5–6 ಮುಖಗಳು ತಲಾ 1 ಬಿಟ್ ನೀಡುತ್ತವೆ.";
"onboarding.entropy.learn_more.inputs.coin.title" = "ಭೌತಿಕ ನಾಣ್ಯ ಚಿಮ್ಮುವಿಕೆಗಳು";
"onboarding.entropy.learn_more.inputs.coin.detail" = "ನಿಷ್ಪಕ್ಷಪಾತವಾಗಿ ಮತ್ತು ಸ್ವತಂತ್ರವಾಗಿ ನಾಣ್ಯವನ್ನು ಚಿಮ್ಮಿಸುವ ಪ್ರತಿಯೊಂದು ಫಲಿತಾಂಶವು ಪಕ್ಷಪಾತವಿಲ್ಲದ 1 ಬಿಟ್ ಎಂಟ್ರೋಪಿಯನ್ನು ನೀಡುತ್ತದೆ.";
"onboarding.entropy.learn_more.inputs.digits.title" = "ಯಾದೃಚ್ಛಿಕ ಅಂಕಿಗಳನ್ನು ದಾಖಲಿಸಿ";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 ಅಂಕಿಗಳು ತಲಾ 3 ಬಿಟ್‌ಗಳನ್ನು ನೀಡುತ್ತವೆ; 8–9 ಅಂಕಿಗಳು ತಲಾ 1 ಬಿಟ್ ನೀಡುತ್ತವೆ. ಈ ಅಂಕಿಗಳು ನಿಜವಾಗಿಯೂ ಯಾದೃಚ್ಛಿಕವಾದ ಭೌತಿಕ ಪ್ರಕ್ರಿಯೆಯಿಂದಲೇ ಬರಬೇಕು.";
"onboarding.entropy.learn_more.inputs.footer" = "ನಿಷ್ಪಕ್ಷಪಾತ ಭೌತಿಕ ಮೂಲವನ್ನು ಬಳಸಿ ಮತ್ತು ಪ್ರತಿಯೊಂದು ಫಲಿತಾಂಶವನ್ನು ಕ್ರಮವಾಗಿ ದಾಖಲಿಸಿ. ಸ್ವೀಕರಿಸಿದ ಪ್ರತಿಯೊಂದು ಫಲಿತಾಂಶವೂ ಒಂದೇ ಬಿಟ್ ಸ್ಟ್ರೀಮ್‌ಗೆ ಸೇರುವುದರಿಂದ ನೀವು ಇನ್‌ಪುಟ್ ವಿಧಾನಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-ಬಿಟ್ ಮೌಲ್ಯವನ್ನು ಜೋಡಿಸಿ";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath ದಾಳದ ಫಲಿತಾಂಶಗಳು ಮತ್ತು ದಶಮಾಂಶ ಅಂಕಿಗಳನ್ನು ಪಕ್ಷಪಾತವಿಲ್ಲದ, ಎರಡರ ಘಾತದ ಗುಂಪುಗಳಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ. ಕೊಡುಗೆಯ ಉದ್ದಗಳು ಬದಲಾಗಬಹುದು, ಆದರೆ ನಿಷ್ಪಕ್ಷಪಾತ ಭೌತಿಕ ಮೂಲವು ಯಾವುದೇ ಬಿಟ್ ಮೌಲ್ಯಕ್ಕೆ ಒಲವು ತೋರುವುದಿಲ್ಲ.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath ನಿಖರವಾಗಿ 256 ಬಿಟ್‌ಗಳನ್ನು ಸಂಗ್ರಹಿಸುವವರೆಗೆ ಅವನ್ನು ನಮೂದಿಸಿದ ಕ್ರಮದಲ್ಲಿ ಸೇರಿಸುತ್ತದೆ; ನಂತರ ಅತ್ಯಂತ ಮಹತ್ವದ ಬಿಟ್ ಮೊದಲು ಬರುವಂತೆ 32 ಬೈಟ್‌ಗಳಾಗಿ ಪ್ಯಾಕ್ ಮಾಡುತ್ತದೆ.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "ಕಸ್ಟಮ್ ಎಂಟ್ರೋಪಿಯು ನೀವು ದಾಖಲಿಸುವ ಭೌತಿಕ ಇನ್‌ಪುಟ್‌ಗಳನ್ನು ಮಾತ್ರ ಒಳಗೊಂಡಿರುತ್ತದೆ; Oath ಸಾಧನ-ರಚಿತ ಯಾದೃಚ್ಛಿಕತೆಯನ್ನು ಬೆರೆಸುವುದಿಲ್ಲ.";
"onboarding.entropy.learn_more.bip39.section" = "3. ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಪಡೆಯಿರಿ";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 ಬಿಟ್‌ಗಳ ಎಂಟ್ರೋಪಿ";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-ಬಿಟ್ BIP-39 ಚೆಕ್‌ಸಮ್";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 ಬಿಟ್‌ಗಳನ್ನು ತಲಾ 11 ಬಿಟ್‌ಗಳ 24 ಪದ ಸೂಚ್ಯಂಕಗಳಾಗಿ ವಿಭಜಿಸಲಾಗಿದೆ";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-ಬಿಟ್ ಎಂಟ್ರೋಪಿ ಮೌಲ್ಯಕ್ಕೆ 8-ಬಿಟ್ ಚೆಕ್‌ಸಮ್ ಸೇರಿಸಿ 264 ಬಿಟ್‌ಗಳನ್ನು ಉತ್ಪಾದಿಸಲಾಗುತ್ತದೆ; ಅವನ್ನು ತಲಾ 11 ಬಿಟ್‌ಗಳ 24 ಪದ ಸೂಚ್ಯಂಕಗಳಾಗಿ ವಿಭಜಿಸಲಾಗುತ್ತದೆ.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39, 32-ಬೈಟ್ ಎಂಟ್ರೋಪಿ ಮೌಲ್ಯದ ಮೇಲೆ SHA-256 ಅನ್ನು ಲೆಕ್ಕಾಚಾರ ಮಾಡಿ, ಮೊದಲ 8 ಹ್ಯಾಶ್ ಬಿಟ್‌ಗಳನ್ನು ಚೆಕ್‌ಸಮ್ ಆಗಿ ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ; ಆ ಚೆಕ್‌ಸಮ್ ಸೇರಿಸಿದಾಗ 264 ಬಿಟ್‌ಗಳು ಉತ್ಪತ್ತಿಯಾಗುತ್ತವೆ.";
"onboarding.entropy.learn_more.bip39.words" = "264 ಬಿಟ್‌ಗಳನ್ನು ತಲಾ 11 ಬಿಟ್‌ಗಳ 24 ಗುಂಪುಗಳಾಗಿ ವಿಭಜಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದು ಗುಂಪು ಪ್ರಮಾಣಿತ 2,048-ಪದಗಳ BIP-39 ಪಟ್ಟಿಯಿಂದ ಒಂದು ನಮೂದನ್ನು ಆಯ್ಕೆಮಾಡಿ, 24-ಪದಗಳ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ.";
"onboarding.entropy.learn_more.bip39.derivation" = "ಫಲಿತಾಂಶದ ಸೀಡ್‌ನಿಂದ Wallet Core ಪುನರುತ್ಪಾದಿಸಬಹುದಾದ ಖಾತೆಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಪಡೆಯುತ್ತದೆ. ಅದೇ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ಐಚ್ಛಿಕ ಪಾಸ್‌ಫ್ರೇಸ್ ಯಾವಾಗಲೂ ಅದೇ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಮರುಸೃಷ್ಟಿಸುತ್ತವೆ.";
"onboarding.entropy.learn_more.security.section" = "ಕಸ್ಟಮ್ ಎಂಟ್ರೋಪಿಯು ಭದ್ರತೆಯನ್ನು ಹೇಗೆ ಬಲಪಡಿಸುತ್ತದೆ";
"onboarding.entropy.learn_more.security.space.title" = "ಅಗಾಧ ಸಾಧ್ಯತೆಗಳ ಪರಿಧಿ";
"onboarding.entropy.learn_more.security.space.detail" = "ಏಕರೂಪದ 256-ಬಿಟ್ ಎಂಟ್ರೋಪಿಯು 2^256 ಅನನ್ಯ ಮೌಲ್ಯಗಳನ್ನು ಹೊಂದಿದ್ದು, ಎಲ್ಲವನ್ನೂ ಊಹಿಸುವುದು ಗಣಕಯಂತ್ರದ ದೃಷ್ಟಿಯಿಂದ ಕಾರ್ಯಸಾಧ್ಯವಲ್ಲ. ಇದು ಇನ್‌ಪುಟ್ ಪರಿಧಿಯ ಗಾತ್ರವನ್ನು ವಿವರಿಸುತ್ತದೆ; ಪ್ರತಿಯೊಂದು ಕ್ರಿಪ್ಟೋಗ್ರಾಫಿಕ್ ಘಟಕವೂ 256-ಬಿಟ್ ದಾಳಿ ನಿರೋಧಕತೆ ನೀಡುತ್ತದೆ ಎಂಬ ಅರ್ಥವಲ್ಲ.";
"onboarding.entropy.learn_more.security.source.title" = "ಯಾದೃಚ್ಛಿಕತೆಯ ಮೂಲ ನೀವೇ";
"onboarding.entropy.learn_more.security.source.detail" = "ಭೌತಿಕ ಘಟನೆಗಳು, ಸಾಧನದ ಯಾದೃಚ್ಛಿಕ-ಸಂಖ್ಯೆ ಜನರೇಟರ್‌ವೊಂದನ್ನೇ ಅವಲಂಬಿಸುವ ಬದಲು, ವ್ಯಾಲೆಟ್‌ನ ಯಾದೃಚ್ಛಿಕತೆಗೆ ಸ್ವತಂತ್ರವಾಗಿ ಮೂಲ ಒದಗಿಸಲು ನಿಮಗೆ ಅವಕಾಶ ನೀಡುತ್ತವೆ. ಆ ಘಟನೆಗಳು ನಿಜವಾಗಿಯೂ ಯಾದೃಚ್ಛಿಕವಾಗಿದ್ದಾಗ ಮಾತ್ರ ಇದು ಭದ್ರತೆಯನ್ನು ಸುಧಾರಿಸುತ್ತದೆ.";
"onboarding.entropy.learn_more.security.local.title" = "ಈ ಸಾಧನದಲ್ಲೇ ಸಂಪೂರ್ಣವಾಗಿ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲಾಗಿದೆ";
"onboarding.entropy.learn_more.security.local.detail" = "Oath ನೀವು ದಾಖಲಿಸಿದ ಅನುಕ್ರಮವನ್ನು ಪರಿವರ್ತಿಸಿ, ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಈ ಸಾಧನದಲ್ಲೇ ರಚಿಸುತ್ತದೆ. ಪ್ರಕ್ರಿಯೆಗಾಗಿ ನಿಮ್ಮ ಅನುಕ್ರಮವನ್ನು ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಮಾಡುವುದಿಲ್ಲ.";
"onboarding.entropy.learn_more.security.patterns.title" = "ಮನುಷ್ಯರು ಆಯ್ಕೆಮಾಡಿದ ರಹಸ್ಯಗಳನ್ನು ತಪ್ಪಿಸಿ";
"onboarding.entropy.learn_more.security.patterns.detail" = "ಜನ್ಮದಿನಗಳು, ನೆಚ್ಚಿನ ಸಂಖ್ಯೆಗಳು, ಪುನರಾವರ್ತಿತ ಮಾದರಿಗಳು ಅಥವಾ ವ್ಯಕ್ತಿಯೇ ಆಯ್ಕೆಮಾಡಿದ ಪದಗಳಿಗಿಂತ, ನಿಷ್ಪಕ್ಷಪಾತ ಮತ್ತು ಸ್ವತಂತ್ರ ಘಟನೆಗಳ ದೀರ್ಘ ಅನುಕ್ರಮವನ್ನು ಊಹಿಸುವುದು ಬಹಳ ಕಷ್ಟ.";
"onboarding.entropy.learn_more.security.footer" = "ಭೌತಿಕ ಎಂಟ್ರೋಪಿಯು ಸಾಧನ ರಚಿಸುವ ವ್ಯಾಲೆಟ್ ಯಾದೃಚ್ಛಿಕತೆಯನ್ನು ಬದಲಿಸುತ್ತದೆ; ಅದು ಹೆಚ್ಚುವರಿ ಪಾಸ್‌ವರ್ಡ್ ಅಥವಾ ಭದ್ರತಾ ಪದರವಲ್ಲ.";
"onboarding.entropy.learn_more.safety.section" = "ಈ ವೈಶಿಷ್ಟ್ಯವನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಬಳಸಿ";
"onboarding.entropy.learn_more.safety.fair.title" = "ನಿಷ್ಪಕ್ಷಪಾತ, ಸ್ವತಂತ್ರ ಫಲಿತಾಂಶಗಳನ್ನು ದಾಖಲಿಸಿ";
"onboarding.entropy.learn_more.safety.fair.detail" = "ನಿಷ್ಪಕ್ಷಪಾತ ನಾಣ್ಯ ಅಥವಾ ದಾಳ ಬಳಸಿ ಮತ್ತು ಪ್ರತಿಯೊಂದು ಫಲಿತಾಂಶವೂ ಸ್ವತಂತ್ರವಾಗಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ. ಯಾದೃಚ್ಛಿಕ ಅಂಕಿಗಳು ನೈಜ ಭೌತಿಕ ಮೂಲದಿಂದ ಬರಬೇಕು—ನಿಮ್ಮ ನೆನಪು ಅಥವಾ ಯಾವುದೇ ಮಾದರಿಯಿಂದಲ್ಲ.";
"onboarding.entropy.learn_more.safety.private.title" = "ನಿಮ್ಮ ಎಂಟ್ರೋಪಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಖಾಸಗಿಯಾಗಿ ಇರಿಸಿ";
"onboarding.entropy.learn_more.safety.private.detail" = "ದಾಖಲಿಸಿದ ಅನುಕ್ರಮ ಮತ್ತು ಪೂರ್ಣಗೊಂಡ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಎರಡನ್ನೂ ವ್ಯಾಲೆಟ್ ರಹಸ್ಯಗಳಾಗಿ ರಕ್ಷಿಸಿ. ಕ್ಯಾಮೆರಾಗಳು ಮತ್ತು ಇತರ ಜನರ ಕಣ್ಣಿಗೆ ಅವು ಬೀಳದಂತೆ ಇರಿಸಿ.";
"onboarding.entropy.learn_more.safety.accurate.title" = "ಪ್ರತಿಯೊಂದು ಫಲಿತಾಂಶವನ್ನೂ ನಿಖರವಾಗಿ ದಾಖಲಿಸಿ";
"onboarding.entropy.learn_more.safety.accurate.detail" = "ಒಂದು ಫಲಿತಾಂಶ ಕಾಣೆಯಾದರೂ, ನಕಲಾದರೂ ಅಥವಾ ಕ್ರಮ ಬದಲಾದರೂ ಬೇರೆ ವ್ಯಾಲೆಟ್ ರಚನೆಯಾಗುತ್ತದೆ. ಪ್ರತಿಯೊಂದು ನಮೂದನ್ನೂ ಪರಿಶೀಲಿಸಿ ಮತ್ತು ವ್ಯಾಲೆಟ್‌ಗೆ ಹಣ ಸೇರಿಸುವ ಮೊದಲು ಪೂರ್ಣಗೊಂಡ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಪರಿಶೀಲಿಸಿ.";
"onboarding.entropy.learn_more.safety.backup.title" = "ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಸುರಕ್ಷಿತಗೊಳಿಸಿ";
"onboarding.entropy.learn_more.safety.backup.detail" = "ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಇರಿಸಿ ಮತ್ತು ಎಂದಿಗೂ ಹಂಚಿಕೊಳ್ಳಬೇಡಿ. ನಿಮ್ಮ ಬ್ಯಾಕಪ್ ಪರಿಶೀಲಿಸಿದ ನಂತರ, ಇನ್ನು ಅಗತ್ಯವಿಲ್ಲದ ಯಾವುದೇ ಮಧ್ಯಂತರ ಇನ್‌ಪುಟ್ ದಾಖಲೆಯನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ನಾಶಮಾಡಿ.";
"onboarding.entropy.learn_more.safety.footer" = "ಬಹಿರಂಗವಾದ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ, ರಾಜಿಯಾದ ಸಾಧನ, ದುರುದ್ದೇಶಪೂರಿತ ಸಾಫ್ಟ್‌ವೇರ್ ಅಥವಾ ತಪ್ಪಾಗಿ ದಾಖಲಿಸಿದ ಅನುಕ್ರಮವನ್ನು ಭೌತಿಕ ಎಂಟ್ರೋಪಿಯು ಸುರಕ್ಷಿತಗೊಳಿಸಲಾರದು. ನಿಷ್ಪಕ್ಷಪಾತ, ಖಾಸಗಿ ಮತ್ತು ನಿಖರ ಇನ್‌ಪುಟ್‌ಗಳನ್ನು ಖಚಿತಪಡಿಸಲಾಗದಿದ್ದರೆ, ಬದಲಿಗೆ ಪ್ರಮಾಣಿತ ವ್ಯಾಲೆಟ್ ರಚನೆಯನ್ನು ಬಳಸಿ.";
"onboarding.carousel.open_source.eyebrow" = "ವಿನ್ಯಾಸದಿಂದಲೇ ಮುಕ್ತ ಮೂಲ";
"onboarding.carousel.open_source.title" = "ಮೂಲ ಕೋಡ್ ಪರಿಶೀಲಿಸಿ. ಬಿಲ್ಡ್ ದೃಢಪಡಿಸಿ.";
"onboarding.carousel.open_source.message" = "ಸ್ವತಂತ್ರ ಪರಿಶೀಲನೆಗಾಗಿ Oath ತನ್ನ ಮೂಲ ಕೋಡ್ ಅನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ. ಪುನರುತ್ಪಾದಿಸಬಹುದಾದ ಬಿಲ್ಡ್ ಪ್ರಕಟಿತ ಆ್ಯಪ್‌ನ ಫಿಂಗರ್‌ಪ್ರಿಂಟ್‌ಗೆ ಹೊಂದಿಕೆಯಾದಾಗ ಮಾತ್ರ ಬಿಡುಗಡೆಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗಿದೆ ಎಂದು ಪರಿಗಣಿಸಲಾಗುತ್ತದೆ.";
"onboarding.carousel.open_source.action.github" = "GitHub ನಲ್ಲಿ ಪರಿಶೀಲಿಸಿ";
"onboarding.carousel.open_source.visual.repository" = "ಸಾರ್ವಜನಿಕ ಮೂಲ ಕೋಡ್ ರೆಪೊಸಿಟರಿ";
"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture ವೀಕ್ಷಿಸಿ";
"onboarding.carousel.open_source.visual.source" = "ಮೂಲ ಕೋಡ್ ಪರಿಶೀಲಿಸಿ";
"onboarding.carousel.open_source.visual.rebuild" = "ಬಿಡುಗಡೆ ಬಿಲ್ಡ್ ಅನ್ನು ಪುನರುತ್ಪಾದಿಸಿ";
"onboarding.carousel.open_source.visual.compare" = "ಬಿಲ್ಡ್ ಆರ್ಟಿಫ್ಯಾಕ್ಟ್‌ಗಳನ್ನು ಹೋಲಿಸಿ";
"onboarding.carousel.open_source.visual.fingerprint" = "ಪ್ರಕಟಿತ ಬಿಡುಗಡೆ ಫಿಂಗರ್‌ಪ್ರಿಂಟ್";
"onboarding.carousel.open_source.visual.match" = "ಹೊಂದಾಣಿಕೆ ದೃಢಪಟ್ಟಿದೆ — ಬಿಲ್ಡ್ ಪರಿಶೀಲಿಸಲಾಗಿದೆ";
"onboarding.carousel.open_source.visual.accessibility" = "ಬಿಡುಗಡೆಯ ಪರಿಶೀಲನೆಗೆ ಸಾರ್ವಜನಿಕ ಮೂಲ ಕೋಡ್, ಸ್ವತಂತ್ರ ಪುನರ್‌ಬಿಲ್ಡ್ ಮತ್ತು ಹೊಂದಾಣಿಕೆಯ ಫಿಂಗರ್‌ಪ್ರಿಂಟ್‌ಗಳು ಅಗತ್ಯವೆಂದು ತೋರಿಸುವ ರೇಖಾಚಿತ್ರ.";
"onboarding.carousel.passphrase.eyebrow" = "ಐಚ್ಛಿಕ BIP-39 ಪಾಸ್‌ಫ್ರೇಸ್";
"onboarding.carousel.passphrase.title" = "ಒಂದು ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ. ಒಂದು ಹೆಚ್ಚುವರಿ ರಹಸ್ಯ.";
"onboarding.carousel.passphrase.message" = "BIP-39 ಪಾಸ್‌ಫ್ರೇಸ್ ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛದೊಂದಿಗೆ ಸೇರಿ ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ. ಮರುಪಡೆಯುವಿಕೆ ಪದಗಳು ಬಹಿರಂಗವಾದರೂ, ಆ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಪ್ರವೇಶಿಸಲು ನಿಖರ ಪಾಸ್‌ಫ್ರೇಸ್ ಇನ್ನೂ ಅಗತ್ಯ.";
