"onboarding.carousel.passphrase.visual.passphrase" = "ನಿಮ್ಮ ಹೆಚ್ಚುವರಿ ರಹಸ್ಯ ಪಾಸ್‌ಫ್ರೇಸ್";
"onboarding.carousel.passphrase.visual.output" = "ಪ್ರತ್ಯೇಕ ಪಾಸ್‌ಫ್ರೇಸ್ ವ್ಯಾಲೆಟ್";
"onboarding.carousel.passphrase.visual.requirement" = "ಮರುಪಡೆಯಲು ಎರಡೂ ರಹಸ್ಯಗಳು ಅಗತ್ಯ";
"onboarding.carousel.passphrase.visual.accessibility" = "24-ಪದಗಳ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ರಹಸ್ಯ BIP-39 ಪಾಸ್‌ಫ್ರೇಸ್ ಒಟ್ಟಾಗಿ ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತವೆ; ಅದನ್ನು ಮರುಪಡೆಯಲು ಎರಡೂ ರಹಸ್ಯಗಳು ಅಗತ್ಯ.";
"onboarding.carousel.passphrase.learn_more.action" = "ಹೆಚ್ಚಿನ ವಿವರಗಳನ್ನು ತಿಳಿಯಿರಿ";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 ಪಾಸ್‌ಫ್ರೇಸ್‌ಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಿ";
"onboarding.passphrase.learn_more.path.section" = "ಎರಡು ರಹಸ್ಯಗಳಿಂದ ಒಂದೇ ವ್ಯಾಲೆಟ್";
"onboarding.passphrase.learn_more.overview" = "BIP-39 ಪಾಸ್‌ಫ್ರೇಸ್ ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛದೊಂದಿಗೆ ಸಂಯೋಜಿಸುವ ಐಚ್ಛಿಕ ರಹಸ್ಯ. ಇವೆರಡೂ ಸೇರಿ, ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವೊಂದರಿಂದಲೇ ರಚನೆಯಾಗುವ ವ್ಯಾಲೆಟ್‌ಗಿಂತ ಭಿನ್ನವಾದ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಸದಾ ಒಂದೇ ರೀತಿಯಲ್ಲಿ ಉತ್ಪಾದಿಸುತ್ತವೆ.";
"onboarding.passphrase.learn_more.visual.phrase" = "ನಿಮ್ಮ 24-ಪದಗಳ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ";
"onboarding.passphrase.learn_more.visual.passphrase" = "ನಿಮ್ಮ ರಹಸ್ಯ ಪಾಸ್‌ಫ್ರೇಸ್";
"onboarding.passphrase.learn_more.visual.wallet" = "ಪಾಸ್‌ಫ್ರೇಸ್‌ನಿಂದ ರಕ್ಷಿತ ವ್ಯಾಲೆಟ್";
"onboarding.passphrase.learn_more.visual.accessibility" = "24-ಪದಗಳ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ರಹಸ್ಯ ಪಾಸ್‌ಫ್ರೇಸ್ ಒಟ್ಟಾಗಿ, ಪಾಸ್‌ಫ್ರೇಸ್‌ನಿಂದ ರಕ್ಷಿತ ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತವೆ.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 ವ್ಯಾಲೆಟ್ ಅನ್ನು ಹೇಗೆ ಉತ್ಪಾದಿಸುತ್ತದೆ";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "ಪಾಸ್‌ಫ್ರೇಸ್‌ನೊಂದಿಗೆ ಸಂಯೋಜಿಸಿದ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ";
"onboarding.passphrase.learn_more.derivation.visual.function" = "2,048 ಸುತ್ತುಗಳ PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-ಬಿಟ್ ಮಾಸ್ಟರ್ ಸೀಡ್";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "ಪಡೆದ ವ್ಯಾಲೆಟ್ ಖಾತೆಗಳು ಮತ್ತು ವಿಳಾಸಗಳು";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ಪಾಸ್‌ಫ್ರೇಸ್ PBKDF2-HMAC-SHA512 ನ 2,048 ಸುತ್ತುಗಳ ಮೂಲಕ ಹಾದು 512-ಬಿಟ್ ಸೀಡ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತವೆ; ಅದರಿಂದ ವ್ಯಾಲೆಟ್ ಖಾತೆಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಪಡೆಯಲಾಗುತ್ತದೆ.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 ಸಾಮಾನ್ಯೀಕರಿಸಿದ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು PBKDF2 ಪಾಸ್‌ವರ್ಡ್ ಆಗಿ ಪರಿಗಣಿಸುತ್ತದೆ ಮತ್ತು ಸಾಮಾನ್ಯೀಕರಿಸಿದ ಪಾಸ್‌ಫ್ರೇಸ್‌ನ ಮೊದಲು “mnemonic” ಸೇರಿಸಿದ ಮೌಲ್ಯವನ್ನು ಸಾಲ್ಟ್ ಆಗಿ ಬಳಸುತ್ತದೆ. PBKDF2-HMAC-SHA512 ನ 2,048 ಸುತ್ತುಗಳ ನಂತರ, ಪ್ರಕ್ರಿಯೆಯು 64-ಬೈಟ್ ಸೀಡ್ ಉತ್ಪಾದಿಸುತ್ತದೆ.";
"onboarding.passphrase.learn_more.derivation.normalization" = "ಸೀಡ್ ಪಡೆಯುವ ಮೊದಲು Oath, BIP-39 ಗೆ ಅಗತ್ಯವಾದ Unicode ಸಾಮಾನ್ಯೀಕರಣವನ್ನು ಅನ್ವಯಿಸುತ್ತದೆ; ಇದರಿಂದ ಅದೇ ಸಾಮಾನ್ಯೀಕರಿಸಿದ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ಪಾಸ್‌ಫ್ರೇಸ್ ಯಾವಾಗಲೂ ಅದೇ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಮರುಸೃಷ್ಟಿಸುತ್ತವೆ.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "ಪಾಸ್‌ಫ್ರೇಸ್ ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಪದಗಳನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡುವುದಿಲ್ಲ. ಅದು ಪಡೆದ ಸೀಡ್ ಅನ್ನು ಬದಲಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಪ್ರತಿಯೊಂದು ವಿಭಿನ್ನ ಪಾಸ್‌ಫ್ರೇಸ್ ವಿಭಿನ್ನ ಖಾತೆಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ.";
"onboarding.passphrase.learn_more.wallets.section" = "ಪ್ರತಿಯೊಂದು ಪಾಸ್‌ಫ್ರೇಸ್ ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ";
"onboarding.passphrase.learn_more.wallets.visual.one" = "ಉದಾಹರಣೆ ಪಾಸ್‌ಫ್ರೇಸ್ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "ಉದಾಹರಣೆ ಪಾಸ್‌ಫ್ರೇಸ್ 2";
