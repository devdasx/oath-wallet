"settings.about.history.v354.build55.interface" = "iOS 27 ಹೊಂದಾಣಿಕೆ, ಬಲದಿಂದ ಎಡಕ್ಕೆ ವಿನ್ಯಾಸಗಳು, ಸ್ವೀಕರಿಸುವವರ ಸೂಚನೆಗಳು, ಅನುವಾದಗಳು ಮತ್ತು ಕೀಬೋರ್ಡ್ ಸ್ಥಿರತೆಯನ್ನು ಸುಧಾರಿಸಲಾಗಿದೆ. ಸ್ವೀಕರಿಸುವ ಪರದೆ Avalanche C-Chain ಅನ್ನು ಗುರುತಿಸುತ್ತದೆ ಮತ್ತು Stellar ಹಾಗೂ Gram ಮೆಮೊಗಳನ್ನು ವಿವರಿಸುತ್ತದೆ. ವಿಕಿಪೀಡಿಯ ವಿವರಣೆಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ.";

"settings.about.history.v354.build55.send" = "ಪರಿಶೀಲನಾ ಪರದೆ ಶುಲ್ಕಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ, ನೆಟ್‌ವರ್ಕ್‌ನ ಮೂಲ ನಾಣ್ಯವನ್ನು ಠೇವಣಿ ಮಾಡುವ ಆಯ್ಕೆ ನೀಡುತ್ತದೆ ಮತ್ತು ಶುಲ್ಕ ಭರಿಸಲು ಅದರ ಕಳುಹಿಸುವ ಮೊತ್ತವನ್ನು ಸರಿಹೊಂದಿಸುತ್ತದೆ. ನಾಣ್ಯ ನಿಯಂತ್ರಣ ವಿಳಾಸದ ವಿಧಗಳು ಮತ್ತು ಆಯ್ದ ಇನ್‌ಪುಟ್‌ಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. Solana ಲೋಡಿಂಗ್, Sui ವರ್ಗಾವಣೆಗಳು ಮತ್ತು ಹಳೆಯ iOS ಆವೃತ್ತಿಗಳಲ್ಲಿನ Sui ಇತಿಹಾಸವನ್ನು ಸುಧಾರಿಸಲಾಗಿದೆ.";

"settings.about.history.v354.build55.notifications" = "ಅನುವಾದಿತ ಅಧಿಸೂಚನೆಗಳು ನಿಮ್ಮ ಆದ್ಯತೆಗಳನ್ನು ಪಾಲಿಸುತ್ತವೆ ಮತ್ತು ಆಸ್ತಿ ಲೋಗೋಗಳು, ಸರಿಯಾಗಿ ರೂಪಿಸಿದ ಮೊತ್ತಗಳು, ಪ್ರಸ್ತುತ ಸ್ಥಿತಿ ಹಾಗೂ ಸಂಪೂರ್ಣ ವಹಿವಾಟಿನ ವಿವರಗಳನ್ನು ತೋರಿಸುತ್ತವೆ.";

