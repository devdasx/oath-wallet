"settings.about.history.v352.build50.safety" = "ಬಿಲ್ಡ್ 50: TRON ಬಹುಸಹಿ ಮತ್ತು USDT/USDC ನಿರ್ಬಂಧಗಳ ಸಂಯೋಜಿತ ಎಚ್ಚರಿಕೆಗಳು. TRON ಬಹುಸಹಿ ವರ್ಗಾವಣೆಗಳು ನಿಷ್ಕ್ರಿಯವಾಗಿಯೇ ಇರುತ್ತವೆ, ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಲಭ್ಯವಿರುತ್ತವೆ. ಸಹಿ ದೋಷಗಳು ಮತ್ತು ಆಮದು ಮಾರ್ಗದರ್ಶನ ಇನ್ನಷ್ಟು ಸ್ಪಷ್ಟ; ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛಗಳ ನಿರ್ಬಂಧ ಪಟ್ಟಿ ನವೀಕರಿಸಲಾಗಿದೆ.";

"settings.about.history.v352.build50.input" = "ಆಮದಿನ ನಂತರ ಬೆಲೆಗಳು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ. ಶೂನ್ಯ ಬಾಕಿಯಲ್ಲಿ ಘಟಕ ಬದಲಾವಣೆ ಮತ್ತು ಬಲದಿಂದ ಎಡಕ್ಕೆ ಬರೆಯುವ ಭಾಷೆಗಳಲ್ಲಿ ಪರಿವರ್ತಕದ ಇನ್‌ಪುಟ್ ಸಮಸ್ಯೆ ಸರಿಪಡಿಸಲಾಗಿದೆ. ಮರುಪಡೆಯುವಿಕೆ ಪದಗಳ ಕ್ರಮ ಉಳಿಯುತ್ತದೆ; ಮಾನ್ಯ ಪದಗುಚ್ಛ ಅಂಟಿಸಿದಾಗ ಅಥವಾ ಸ್ಕ್ಯಾನ್ ಮಾಡಿದಾಗ ಕೀಬೋರ್ಡ್ ಮುಚ್ಚುತ್ತದೆ.";

"settings.about.history.v352.build50.interface" = "ಮುಖಪುಟ ಮತ್ತು ಸ್ವತ್ತುಗಳನ್ನು ಪಿನ್ ಮಾಡುವ ಅನಿಮೇಷನ್‌ಗಳು ಸುಗಮವಾಗಿವೆ, ಸ್ಪರ್ಶ ಪ್ರತಿಕ್ರಿಯೆ ವಿಸ್ತರಿಸಿದೆ ಮತ್ತು ಅನುವಾದಗಳು ಸುಧಾರಿಸಿವೆ. ಸ್ವೀಕೃತಿ ಕಾರ್ಡ್‌ಗಳು ದೊಡ್ಡ QR ಕೋಡ್ ಮತ್ತು ವಿಳಾಸ ಪಠ್ಯದೊಂದಿಗೆ ಡಾರ್ಕ್ ಮೋಡ್ ಬೆಂಬಲಿಸುತ್ತವೆ. ಬದಲಾವಣೆಗಳನ್ನು ಚೆಕ್‌ಮಾರ್ಕ್‌ನಿಂದ ದೃಢೀಕರಿಸಲಾಗುತ್ತದೆ; ಎಚ್ಚರಿಕೆಗಳು ಅಗತ್ಯ ಮಾಹಿತಿಯನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತವೆ.";

"evm_access.gas.insufficient.title" = "ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕಕ್ಕೆ ಸಾಕಷ್ಟು ಬ್ಯಾಲೆನ್ಸ್ ಇಲ್ಲ";
"evm_access.gas.insufficient.body" = "ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ಪಾವತಿಸಲು ಈ ವಾಲೆಟ್‌ಗೆ %@ ಸೇರಿಸಿ. ಇದಕ್ಕಾಗಿ %@ ನೆಟ್‌ವರ್ಕ್ ಬಳಸಿ, ನಂತರ ಅನುಮತಿಯನ್ನು ರದ್ದುಪಡಿಸಲು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "ಮರುಪಡೆಯುವ ಪದಗುಚ್ಛದ ಪರಿಶೀಲನೆ, ಸ್ವಯಂಚಾಲಿತ ಸಣ್ಣಕ್ಷರ ಪರಿವರ್ತನೆ, ಸಂಖ್ಯೆಯೊಂದಿಗೆ ನಮೂದಿಸುವಿಕೆ, ತೆರವುಗೊಳಿಸುವಿಕೆ, ಬ್ಯಾಕ್‌ಸ್ಪೇಸ್ ಒತ್ತಿಹಿಡಿದು ಅಳಿಸುವಿಕೆ ಮತ್ತು ಕೀಬೋರ್ಡ್ ವರ್ತನೆಯನ್ನು ಸುಧಾರಿಸಲಾಗಿದೆ. ಮರುಪಡೆಯುವ ಪರದೆಗಳಲ್ಲಿ ಈಗ ಒಂದೇ ಹಿಂದಕ್ಕೆ ಬಟನ್ ಇದೆ.";
"settings.about.history.v353.build51.send" = "ಶುಲ್ಕದ ಅಂದಾಜುಗಳು ಲಭ್ಯವಿಲ್ಲದಾಗ, ಬೆಂಬಲಿತ ಎಲ್ಲ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಶುಲ್ಕವನ್ನು ಅಂದಾಜಿಸಲು ಪರ್ಯಾಯ ವಿಧಾನಗಳನ್ನು ಸೇರಿಸಲಾಗಿದೆ. ಕಳುಹಿಸುವಾಗ ಕಾಂಟ್ರ್ಯಾಕ್ಟ್ ವಿಳಾಸಗಳನ್ನು ಮರೆಮಾಡಿ ಶುಲ್ಕವನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ತೋರಿಸಲಾಗುತ್ತದೆ.";
"settings.about.history.v353.build51.security" = "ಅನುಮತಿಗಳ ಪರಿಶೀಲನೆ, ವಿಳಾಸದ ವಿವರಗಳು, ಅನುಮತಿ ಹಿಂಪಡೆಯುವ ಫಲಿತಾಂಶಗಳು ಮತ್ತು ಶುಲ್ಕಕ್ಕಾಗಿ ಹಣ ಸೇರಿಸುವ ಮಾರ್ಗದರ್ಶನ ಹೆಚ್ಚು ಸ್ಪಷ್ಟವಾಗಿದೆ. ಬ್ಯಾಕಪ್ ಕಾರ್ಡ್‌ಗಳು ಮತ್ತು ಶೀಟ್‌ಗಳಿಗೆ ಏಕರೂಪದ ವಿನ್ಯಾಸವಿದೆ. ನ್ಯಾವಿಗೇಶನ್ ಕಂಪನವನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ.";
"settings.about.history.v353.build51.notifications" = "ವಿವಿಧ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಬರುವ ವರ್ಗಾವಣೆಗಳ ಸೂಚನೆಗಳು ಹೆಚ್ಚು ವಿಶ್ವಾಸಾರ್ಹವಾಗಿವೆ. ಬೆಲೆ ಲಭ್ಯವಿದ್ದಾಗ ಆಯ್ದ ಕರೆನ್ಸಿಯಲ್ಲಿ, ಇಲ್ಲದಿದ್ದರೆ ಕ್ರಿಪ್ಟೋದ ಮೂಲ ಘಟಕದಲ್ಲಿ ಮೊತ್ತವನ್ನು ತೋರಿಸಲಾಗುತ್ತದೆ.";

