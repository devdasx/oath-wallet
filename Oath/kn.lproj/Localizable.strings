"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "ಉದಾಹರಣೆ ವ್ಯಾಲೆಟ್ B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "ಒಂದೇ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವನ್ನು ಎರಡು ವಿಭಿನ್ನ ಪಾಸ್‌ಫ್ರೇಸ್‌ಗಳೊಂದಿಗೆ ಸಂಯೋಜಿಸಿದಾಗ, ವ್ಯಾಲೆಟ್ A ಮತ್ತು ವ್ಯಾಲೆಟ್ B ಎಂಬ ಎರಡು ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್‌ಗಳು ಉತ್ಪತ್ತಿಯಾಗುತ್ತವೆ.";
"onboarding.passphrase.learn_more.wallets.different" = "ಒಂದು ಅರ್ಥಪೂರ್ಣ ಅಕ್ಷರವನ್ನು ಬದಲಿಸಿದರೂ ವಿಭಿನ್ನ ಸೀಡ್ ಮತ್ತು ಆ ಮೂಲಕ ವಿಭಿನ್ನ ವ್ಯಾಲೆಟ್ ಉತ್ಪತ್ತಿಯಾಗುತ್ತದೆ; ಮೂಲ ವ್ಯಾಲೆಟ್ ಬದಲಾಗದೆ ಉಳಿಯುತ್ತದೆ.";
"onboarding.passphrase.learn_more.wallets.empty" = "ಖಾಲಿ ಪಾಸ್‌ಫ್ರೇಸ್ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವೊಂದರಿಂದಲೇ ಪಡೆದ ಪ್ರಮಾಣಿತ ವ್ಯಾಲೆಟ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ; ಖಾಲಿಯಲ್ಲದ ಪಾಸ್‌ಫ್ರೇಸ್ ತನ್ನದೇ ಆದ ಪ್ರತ್ಯೇಕ ವ್ಯಾಲೆಟ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 ನಲ್ಲಿ “ತಪ್ಪು ಪಾಸ್‌ಫ್ರೇಸ್” ಎಂಬ ಪ್ರತಿಕ್ರಿಯೆ ಇಲ್ಲ; ಪ್ರತಿಯೊಂದು ಪಾಸ್‌ಫ್ರೇಸ್ ಮಾನ್ಯವಾಗಿರುತ್ತದೆ. ಆದ್ದರಿಂದ ಅಕ್ಷರದೋಷವು ಯಾವುದೇ ಎಚ್ಚರಿಕೆಯಿಲ್ಲದೆ ಮತ್ತೊಂದು ವ್ಯಾಲೆಟ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ—ಸಾಮಾನ್ಯವಾಗಿ ಶೂನ್ಯ ಬ್ಯಾಲೆನ್ಸ್‌ನೊಂದಿಗೆ.";
"onboarding.passphrase.learn_more.security.section" = "ಪಾಸ್‌ಫ್ರೇಸ್ ರಕ್ಷಣೆಯನ್ನು ಹೇಗೆ ಹೆಚ್ಚಿಸುತ್ತದೆ";
"onboarding.passphrase.learn_more.security.words.title" = "ಮರುಪಡೆಯುವಿಕೆ ಪದಗಳೊಂದೇ ಸಾಕಾಗುವುದಿಲ್ಲ";
"onboarding.passphrase.learn_more.security.words.detail" = "ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛವೊಂದನ್ನೇ ಪಡೆಯುವ ವ್ಯಕ್ತಿಗೆ, ರಕ್ಷಿತ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸಿ ಪ್ರವೇಶಿಸಲು ನಿಖರ ಪಾಸ್‌ಫ್ರೇಸ್ ಇನ್ನೂ ಅಗತ್ಯ.";
"onboarding.passphrase.learn_more.security.strength.title" = "ಬಲಿಷ್ಠ ಪಾಸ್‌ಫ್ರೇಸ್ ಉತ್ತಮ ಪ್ರತ್ಯೇಕತೆ ನೀಡುತ್ತದೆ";
"onboarding.passphrase.learn_more.security.strength.detail" = "ಉದ್ದವಾದ, ಊಹಿಸಲು ಕಷ್ಟವಾದ ಪಾಸ್‌ಫ್ರೇಸ್ ಊಹಿಸುವ ಸವಾಲನ್ನು ಗಣನೀಯವಾಗಿ ಹೆಚ್ಚಿಸುತ್ತದೆ; ಚಿಕ್ಕ ಉಲ್ಲೇಖ, ಜನ್ಮದಿನ, ಹೆಸರು ಅಥವಾ ಮರುಬಳಕೆಯ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಬೇಗ ಊಹಿಸಬಹುದು ಮತ್ತು ಅದು ಅಲ್ಪ ರಕ್ಷಣೆಯನ್ನಷ್ಟೇ ನೀಡುತ್ತದೆ.";
"onboarding.passphrase.learn_more.security.separation.title" = "ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿ";
"onboarding.passphrase.learn_more.security.separation.detail" = "ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛದಿಂದ ಪ್ರತ್ಯೇಕವಾಗಿ ಸಂಗ್ರಹಿಸಿ; ಇದರಿಂದ ಕಳವಾದ ಒಂದೇ ಬ್ಯಾಕಪ್ ವ್ಯಾಲೆಟ್ ಮರುಸ್ಥಾಪಿಸಲು ಅಗತ್ಯವಾದ ಎರಡೂ ರಹಸ್ಯಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸುವುದಿಲ್ಲ.";
"onboarding.passphrase.learn_more.security.footer" = "ಎರಡೂ ರಹಸ್ಯಗಳು ಬಹಿರಂಗವಾದರೆ, ಪಾಸ್‌ಫ್ರೇಸ್ ದುರ್ಬಲವಾಗಿದ್ದರೆ ಅಥವಾ ನೀವು ಟೈಪ್ ಮಾಡುವಾಗ ರಾಜಿಯಾದ ಸಾಫ್ಟ್‌ವೇರ್ ಅದನ್ನು ಸೆರೆಹಿಡಿದರೆ, ಪಾಸ್‌ಫ್ರೇಸ್ ನಿಮ್ಮ ಹಣವನ್ನು ರಕ್ಷಿಸಲಾರದು.";
"onboarding.passphrase.learn_more.safety.section" = "ಈ ವೈಶಿಷ್ಟ್ಯವನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಬಳಸಿ";
"onboarding.passphrase.learn_more.safety.strong.title" = "ಬಲವಾದ, ವಿಶಿಷ್ಟ ಪಾಸ್‌ಫ್ರೇಸ್ ರಚಿಸಿ";
"onboarding.passphrase.learn_more.safety.strong.detail" = "ಈ ವ್ಯಾಲೆಟ್‌ಗೆ ಮಾತ್ರ ಬಳಸುವ ಹಲವು ಯಾದೃಚ್ಛಿಕ ಪದಗಳು ಅಥವಾ ಮತ್ತೊಂದು ಹೆಚ್ಚಿನ-ಎಂಟ್ರೋಪಿ ಮೌಲ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ವೈಯಕ್ತಿಕ ಸಂಗತಿಗಳು, ಪರಿಚಿತ ಪದಗುಚ್ಛಗಳು, ಮಾದರಿಗಳು ಮತ್ತು ಬೇರೆಡೆ ಬಳಸಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ತಪ್ಪಿಸಿ.";
"onboarding.passphrase.learn_more.safety.backup.title" = "ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ಯಾಕಪ್ ಮಾಡಿ";
"onboarding.passphrase.learn_more.safety.backup.detail" = "ನಿಖರ ಪಾಸ್‌ಫ್ರೇಸ್‌ನ ಬಾಳಿಕೆ ಬರುವ ಆಫ್‌ಲೈನ್ ಪ್ರತಿಯನ್ನು ಮಾಡಿ, ಅದನ್ನು ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛದಿಂದ ಪ್ರತ್ಯೇಕವಾಗಿ ಸಂಗ್ರಹಿಸಿ ಮತ್ತು ಕೇವಲ ನೆನಪನ್ನೇ ಎಂದಿಗೂ ಅವಲಂಬಿಸಬೇಡಿ.";
"onboarding.passphrase.learn_more.safety.exact.title" = "ಪ್ರತಿಯೊಂದು ಅಕ್ಷರವೂ ವ್ಯಾಲೆಟ್ ಅನ್ನು ಬದಲಿಸುತ್ತದೆ";
"onboarding.passphrase.learn_more.safety.exact.detail" = "ಪ್ರತಿಯೊಂದು ದೊಡ್ಡಕ್ಷರ, ಖಾಲಿ ಜಾಗ, ವಿರಾಮಚಿಹ್ನೆ ಮತ್ತು ಪದವನ್ನೂ ಒಳಗೊಂಡಂತೆ, ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ರಚಿಸಿದಂತೆಯೇ ನಿಖರವಾಗಿ ಮತ್ತೆ ನಮೂದಿಸಿ. ಯಾವುದೇ ವ್ಯತ್ಯಾಸವು ಎಚ್ಚರಿಕೆಯಿಲ್ಲದೆ ಮತ್ತೊಂದು ವ್ಯಾಲೆಟ್ ಅನ್ನು ಉತ್ಪಾದಿಸುತ್ತದೆ.";
"onboarding.passphrase.learn_more.safety.verify.title" = "ಹಣ ಸೇರಿಸುವ ಮೊದಲು ಮರುಪಡೆಯುವಿಕೆಯನ್ನು ಪರಿಶೀಲಿಸಿ";
"onboarding.passphrase.learn_more.safety.verify.detail" = "ಗಣನೀಯ ಹಣವನ್ನು ಸ್ವೀಕರಿಸುವ ಮೊದಲು, ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ಮತ್ತು ಪಾಸ್‌ಫ್ರೇಸ್ ನಿರೀಕ್ಷಿತ ವಿಳಾಸಗಳನ್ನು ಮರುಸೃಷ್ಟಿಸುತ್ತವೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಲು ಖಾಸಗಿ, ನಿಯಂತ್ರಿತ ಮರುಪಡೆಯುವಿಕೆ ಪರೀಕ್ಷೆ ನಡೆಸಿ.";
"onboarding.passphrase.learn_more.safety.footer" = "ಕಳೆದುಹೋದ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಯಾವುದೇ ಸೇವೆ ಮರುಹೊಂದಿಸಲು ಅಥವಾ ಮರುಪಡೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ. ನಿಖರ ಪಾಸ್‌ಫ್ರೇಸ್ ಇಲ್ಲದಿದ್ದರೆ ಆ ವ್ಯಾಲೆಟ್‌ಗೆ ಪ್ರವೇಶ ಶಾಶ್ವತವಾಗಿ ಕಳೆದುಹೋಗುತ್ತದೆ—ಮರುಪಡೆಯುವಿಕೆ ಪದಗುಚ್ಛ ನಿಮ್ಮಲ್ಲಿದ್ದರೂ ಸಹ.";
