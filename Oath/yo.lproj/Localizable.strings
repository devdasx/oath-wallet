"settings.about.history.v355.build58.home" = "Ojú ìwé àkọ́kọ́ ṣí láìsí ipa fífarahàn díẹ̀díẹ̀ tàbí yíyí ìwọ̀n padà. Bọ́tìnì àwọn ètò ti ń lo àmì àgbá kẹ̀kẹ́ oníhín báyìí.";
"settings.about.history.v355.build58.fields" = "Àwọn pápá ìṣòwò àti fífi ránṣẹ́ ń lo àwọ̀ ọ̀rọ̀ déédéé. Àwọn ọfà hàn lórí àwọn ìlà tí ó ṣí ojú ìwé tàbí pánẹ́lì nìkan; fífi ọwọ́ kan iye àti owó iṣẹ́ ṣì ń yí ẹyọ tí a fi ń ṣàfihàn wọn padà.";
"settings.about.history.v355.build58.banners" = "Lẹ́yìn tí a bá ti fi wọ́n hàn, àwọn ìfitónilétí ìmúdájú tó ń lọ tàbí tó ti parí máa ń pòórá lẹ́yìn ìṣẹ́jú àáyá 3, kódà bí o bá ṣí ojú ìwé mìíràn. Àwọn ìmúdájú tí a kò tíì fi hàn máa farahàn nígbà tí o bá padà.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Àwọn ìfiránṣẹ́ TRON ti ń ya owó ìmúṣiṣẹ́ àkọọ́lẹ̀ àti bandwidth sọ́tọ̀ kí wọ́n tó ṣírò iye tí a ó fi ránṣẹ́, kódà nígbà tí a bá yan iye tó pọ̀ jù lọ. Ojú ìṣàyẹ̀wò ń fi iye tó tọ́ hàn lẹ́yìn yíyọ àwọn owó iṣẹ́ kúrò.";
