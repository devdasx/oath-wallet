"settings.about.history.v355.build56.slide" = "Yíyọ̀ láti fi ránṣẹ́ rọ́pò bọ́tìnì ìmúdájú. Ìṣipopada ìtọ́sọ́nà, ìdáhùn ìfọwọ́kàn àti ìrìn tó rọrùn ṣe àtìlẹ́yìn fún ìtọ́sọ́nà kíkà méjèèjì. Gbé ìka sókè ní 90% tàbí jù bẹ́ẹ̀ lọ láti fi ránṣẹ́; fà padà láti fagilé.";
"settings.about.history.v355.build56.activity" = "Agogo ṣí àwọn ìṣe tó ń dúró. Àwọn kápsùlù ìdúnàádúrà fi àmì ipò hàn, a sì lè yọ wọ́n kúrò nípa fífa. Àwọn tó ń dúró fún ìmúdájú àti àwọn tí a ti mú dájú parẹ́ lẹ́yìn ìṣẹ́jú-àáyá 3; ìmúdájú ṣe àtúnṣe sí kápsùlù kan náà tó hàn.";
"settings.about.history.v355.build56.status" = "Ipò ìdúnàádúrà tó ṣeé gbẹ́kẹ̀ lé jù lórí gbogbo nẹ́tíwọ́ọ̀kì tí a ṣe àtìlẹ́yìn fún, àlàyé tó ń yí padà lẹ́sẹ̀kẹsẹ̀ àti àtúnṣe iye owó tó yára lẹ́yìn fífiránṣẹ́. Títọpinpin àwọn ìdúnàádúrà tó ń dúró tún bẹ̀rẹ̀ nígbà tí a bá ṣí app padà.";
"settings.about.history.v355.build56.fees" = "Pípadà sí àyẹ̀wò ìfiránṣẹ́ kan náà pa owó iṣẹ́ tí a ti rí mọ́. Gbígba owó iṣẹ́ àti ìkìlọ̀ nípa fífi owó sínú àkọọ́lẹ̀ túbọ̀ ṣe kedere; iye tó tó kò fi ìfitónilétí ìmúṣiṣẹ́ hàn mọ́.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin àti Dogecoin fi owó àṣẹ́kù tó kéré ju ààlà dust kún owó iṣẹ́ dípò ṣíṣe output tí kò wúlò. Owó iṣẹ́ tí a ṣàyẹ̀wò bá èyí tí a lò nígbà fífi ọwọ́ sí mu.";
"settings.about.history.v355.build56.stability" = "A ti tún ìṣubú iṣẹ́ abẹ́lẹ̀ àti ìkìlọ̀ àkókò títún wálẹ́ẹ̀tì ṣe tó parí ṣe. Àlàyé wálẹ́ẹ̀tì tó wà tẹ́lẹ̀ ṣì wà nígbà tí àtúnṣe bá kùnà fún ìgbà díẹ̀.";
"settings.about.history.v355.build56.backup" = "Àwọn ojú ìfipamọ́ àfipamọ́ tó mọ́ síi, pẹ̀lú àkọlé tó tọ́ nígbà ṣíṣí àti àwọn ìfiránṣẹ́ díẹ̀. Ìwọlé sí kọ́kọ́rọ́ àdáni tẹ̀ lé ètò títì app. Àwọn ìkìlọ̀ gbígbé wọlé kékeré tó dà bí gíláàsì pa ohun tí a kọ̀ sílẹ̀ rẹ́ nígbà tí o bá yan gbólóhùn ìmúpadàbọ̀ mìíràn.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Lẹ́yìn tí o bá tú ohun ìfà láti fi ránṣẹ́ sílẹ̀, àmì ìjẹ́rìí tó ń rìn yóò hàn kí ojú ìṣàyẹ̀wò tó pa.";
"settings.about.history.v355.build57.activity" = "Àwọn ìlà ìgbòkègbodò fi ipò hàn pẹ̀lú lẹ́tà tí kò nípọn púpọ̀, iye gẹ́gẹ́ bí àkọlé kékeré, àti ọfà láti ṣí àlàyé ìṣòwò.";
"settings.about.history.v355.build57.details" = "Owó iṣẹ́ nẹ́tíwọ́ọ̀kì ti wà nínú àkótán ìfiránṣẹ́ báyìí. Àwọn àmì kúkúrú àti ìlà nẹ́tíwọ́ọ̀kì kan ṣoṣo mú kí àlàyé túbọ̀ ṣe kedere.";
"settings.about.history.v355.build57.resume" = "Nígbà tí o bá padà láti abẹ́lẹ̀, àwọn ojú ìwé àti pánẹ́lì tó ṣí yóò wà bí wọ́n ṣe rí, títí kan ìṣàyẹ̀wò ìfiránṣẹ́ àti àlàyé ìṣòwò.";
"settings.about.history.v355.build57.secrets" = "Àwọn ojú gbólóhùn ìmúpadàbọ̀, kọ́kọ́rọ́ àdáni àti gbólóhùn aṣínà yóò pa lẹ́yìn ìṣẹ́jú-àáyá 20 tí o fi kúrò nínú ápù. Títìpa ápù yóò máa tẹ̀lé àwọn ètò rẹ.";
"settings.about.history.v355.build57.filters" = "Àwọn àlẹ̀mọ́ nẹ́tíwọ́ọ̀kì lo bọ́tìnì ètò tó ga díẹ̀ sí i, ìwọ̀n tó bá àkóónú mu àti àlàfo tí a túnṣe lábẹ́ ọ̀pá ìdarí.";
"settings.about.history.v355.build57.units" = "A ti yọ àwọn ìlà iye tí ó yà sọ́tọ̀. Iye àti owó iṣẹ́ nẹ́tíwọ́ọ̀kì yóò kọ́kọ́ hàn ní owó agbègbè; tẹ èyíkéyìí láti yí sí ẹyọ kirípítò àti padà.";
