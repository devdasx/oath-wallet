"onboarding.carousel.entropy.eyebrow" = "ẸNTÍRÓPÌ LÁTI ÀWỌN ÌGBÉWỌLÉ TI ARA";
"onboarding.carousel.entropy.title" = "Ṣẹ̀dá Àìlétò Tí O Ṣàkóso Pátápátá.";
"onboarding.carousel.entropy.message" = "Ju dáísì, sọ ẹyọ owó sí òkè, tàbí ṣe àkọsílẹ̀ àwọn díjítì láìlétò. Oath yí ìgbéwọlé ti ara rẹ padà sí bítì ẹntíròpì 256 gangan fún gbólóhùn ìmúpadàbọ̀ oní ọ̀rọ̀ 24, gbogbo rẹ̀ lórí ẹ̀rọ rẹ.";
"onboarding.carousel.entropy.visual.output" = "Bítì Ẹntíròpì 256 Tí Olùlò Ṣẹ̀dá";
"onboarding.carousel.entropy.visual.local" = "A Ṣẹ̀dá Rẹ̀ Pátápátá Láti Àwọn Ìgbéwọlé Tí O Ṣe Àkọsílẹ̀";
"onboarding.carousel.entropy.visual.accessibility" = "Dáísì onínọ́mbà, ẹyọ owó, àti àwọn díjítì láìlétò parapọ̀ láti ṣẹ̀dá bítì ẹntíròpì àpamọ́wọ́ 256 lórí ẹ̀rọ yìí.";
"onboarding.carousel.entropy.learn_more.action" = "Ṣàwárí Àwọn Àlàyé Sí I";
"onboarding.entropy.learn_more.navigation" = "Bí Ẹntíròpì Ti Ara Ṣe Ń Ṣiṣẹ́";
"onboarding.entropy.learn_more.path.section" = "Láti Àbájáde Ti Ara Sí Àwọn Ọ̀rọ̀ Ìmúpadàbọ̀";
"onboarding.entropy.learn_more.overview" = "Oath ṣe àkọsílẹ̀ àwọn àbájáde láti orísun ti ara tí o yàn, ó sì yí wọn padà sí iye bítì 256. Lẹ́yìn náà, a fi báìtì 32 tí ó yọ jáde ránṣẹ́ sí Wallet Core láti ṣẹ̀dá gbólóhùn ìmúpadàbọ̀ BIP-39 tó bá òfin mu.";
"onboarding.entropy.learn_more.visual.phrase" = "Gbólóhùn Ìmúpadàbọ̀ BIP-39 Oní Ọ̀rọ̀ 24";
"onboarding.entropy.learn_more.visual.bits" = "Báìtì 32 × bítì 8 jẹ́ bítì 256";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Àkójọpọ̀ sẹ́ẹ̀lì bítì àpẹẹrẹ 256 tí a tò sí báìtì 32.";
"onboarding.entropy.learn_more.visual.accessibility" = "A yí yíyí dáísì, sísọ owó sí òkè, tàbí àwọn díjítì láìlétò padà sí bítì 256, lẹ́yìn náà sí gbólóhùn ìmúpadàbọ̀ BIP-39 oní ọ̀rọ̀ 24.";
"onboarding.entropy.learn_more.inputs.section" = "Ìgbésẹ̀ 1: Ṣe Àkọsílẹ̀ Àwọn Àbájáde Ti Ara";
"onboarding.entropy.learn_more.inputs.dice.title" = "Ju Dáísì Olójú Mẹ́fà Tí Kò Ṣe Ojúsàájú";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Fún dáísì tí kò ṣe ojúsàájú, ojú 1–4 kọ̀ọ̀kan ń fún ni ní bítì 2; ojú 5–6 kọ̀ọ̀kan sì ń fún ni ní bítì 1.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Sọ Ẹyọ Owó Sí Òkè";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Sísọ ẹyọ owó tí kò ṣe ojúsàájú sí òkè lọ́kọ̀ọ̀kan ń fún ni ní bítì ẹntíròpì 1 tí kò ṣe ojúsàájú.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Ṣe Àkọsílẹ̀ Àwọn Díjítì Láìlétò";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Díjítì 0–7 kọ̀ọ̀kan ń fún ni ní bítì 3; díjítì 8–9 kọ̀ọ̀kan sì ń fún ni ní bítì 1. Àwọn díjítì náà gbọ́dọ̀ wá láti ìlànà ti ara tó jẹ́ àìlétò ní tòótọ́.";
"onboarding.entropy.learn_more.inputs.footer" = "Lo orísun ti ara tí kò ṣe ojúsàájú, kí o sì ṣe àkọsílẹ̀ gbogbo àbájáde ní títò. O lè yí ọ̀nà ìgbéwọlé padà nítorí gbogbo àbájáde tí a gba ń darapọ̀ mọ́ ìṣàn bítì kan náà.";
"onboarding.entropy.learn_more.conversion.section" = "2. Kó Iye Bítì 256 Jọ";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath yí àbájáde dáísì àti díjítì eleemewa padà sí àwọn ẹgbẹ́ tí ìwọ̀n wọn jẹ́ agbára 2 láìsí ojúsàájú. Gígùn ìkópa lè yàtọ̀, ṣùgbọ́n orísun ti ara tí kò ṣe ojúsàájú kì í ṣe ojúsàájú fún iye bítì kankan.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath ń fi àwọn bítì kún un ní títò tí o fi tẹ̀ wọ́n títí tí wọn yóò fi pé 256 gangan, lẹ́yìn náà ó kó wọn sínú báìtì 32, pẹ̀lú bítì tó ní ìtúmọ̀ jù lọ ní iwájú.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Ẹntíròpì àkànṣe ní àwọn ìgbéwọlé ti ara tí o ṣe àkọsílẹ̀ nìkan; Oath kì í fi àìlétò tí ẹ̀rọ ṣẹ̀dá kún un.";
"onboarding.entropy.learn_more.bip39.section" = "3. Mú Gbólóhùn Ìmúpadàbọ̀ Jáde";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Bítì Ẹntíròpì 256";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Àpapọ̀ Àyẹ̀wò BIP-39 Oní Bítì 8";
"onboarding.entropy.learn_more.bip39.visual.words" = "Bítì 264 tí a pín sí atọ́ka ọ̀rọ̀ 24 oní bítì 11";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "A fi àpapọ̀ àyẹ̀wò oní bítì 8 kún iye ẹntíròpì oní bítì 256, ó di bítì 264 tí a pín sí atọ́ka ọ̀rọ̀ 24 oní bítì 11.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 ṣe ìṣirò SHA-256 lórí iye ẹntíròpì oní báìtì 32, ó sì mú bítì hash 8 àkọ́kọ́ gẹ́gẹ́ bí àpapọ̀ àyẹ̀wò; fífi àpapọ̀ àyẹ̀wò náà kún un ń mú kí ó di bítì 264.";
"onboarding.entropy.learn_more.bip39.words" = "A pín bítì 264 sí ẹgbẹ́ 24 oní bítì 11. Ẹgbẹ́ kọ̀ọ̀kan yan ọ̀rọ̀ kan láti inú àtòjọ BIP-39 tó bá òfin mu, tó ní ọ̀rọ̀ 2,048, láti ṣẹ̀dá gbólóhùn ìmúpadàbọ̀ oní ọ̀rọ̀ 24.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core mú àwọn àkọọ́lẹ̀ àti àdírẹ́sì tí kò yí padà jáde láti inú irúgbìn náà. Gbólóhùn ìmúpadàbọ̀ kan náà àti gbólóhùn aṣínà àṣàyàn kan náà yóò máa tún àpamọ́wọ́ kan náà ṣẹ̀dá.";
"onboarding.entropy.learn_more.security.section" = "Bí Ẹntíròpì Àkànṣe Ṣe Ń Fún Ààbò Lókun";
"onboarding.entropy.learn_more.security.space.title" = "Ààyè Àǹfààní Tó Tóbi Gan-an";
"onboarding.entropy.learn_more.security.space.detail" = "Ẹntíròpì oní bítì 256 tó pín dọ́gba ní iye aláìlẹ́gbẹ́ 2^256, èyí tó mú kí gbígbìyànjú gbogbo àǹfààní má ṣeé ṣe nípa ìṣirò. Èyí ń ṣàlàyé ìwọ̀n ààyè ìgbéwọlé; kò túmọ̀ sí pé gbogbo apá ìsekóòdù ní agbára ìdènà ìkọlù oní bítì 256.";
"onboarding.entropy.learn_more.security.source.title" = "Ìwọ Ni Orísun Àìlétò Náà";
"onboarding.entropy.learn_more.security.source.detail" = "Àwọn ìṣẹ̀lẹ̀ ti ara jẹ́ kí o pèsè àìlétò àpamọ́wọ́ ní òmìnira dípò gbígbẹ́kẹ̀lé olupilẹṣẹ nọ́mbà láìlétò ẹ̀rọ nìkan. Èyí ń mú ààbò dára sí i kìkì nígbà tí àwọn ìṣẹ̀lẹ̀ náà bá jẹ́ àìlétò ní tòótọ́.";
"onboarding.entropy.learn_more.security.local.title" = "A Ṣe Gbogbo Ìṣiṣẹ́ Lórí Ẹ̀rọ Yìí";
"onboarding.entropy.learn_more.security.local.detail" = "Oath yí ọ̀wọ̀ọ̀wọ́ tí o ṣe àkọsílẹ̀ padà, ó sì ṣẹ̀dá gbólóhùn ìmúpadàbọ̀ lórí ẹ̀rọ yìí pátápátá. A kì í gbé ọ̀wọ̀ọ̀wọ́ rẹ sókè fún ìṣiṣẹ́.";
"onboarding.entropy.learn_more.security.patterns.title" = "Yẹra Fún Àwọn Àṣírí Tí Èèyàn Yan";
"onboarding.entropy.learn_more.security.patterns.detail" = "Ọ̀wọ̀ọ̀wọ́ gígùn àwọn ìṣẹ̀lẹ̀ olómìnira tí kò ṣe ojúsàájú kò rọrùn láti sọ tẹ́lẹ̀ bí ọjọ́ ìbí, nọ́mbà ààyò, àpẹẹrẹ àtúnṣe, tàbí ọ̀rọ̀ tí ènìyàn yan.";
"onboarding.entropy.learn_more.security.footer" = "Ẹntíròpì ti ara rọ́pò àìlétò àpamọ́wọ́ tí ẹ̀rọ ṣẹ̀dá; kì í ṣe ọ̀rọ̀ aṣínà àfikún tàbí ìpele ààbò mìíràn.";
"onboarding.entropy.learn_more.safety.section" = "Lo Ẹ̀yà Yìí Lọ́nà Ààbò";
"onboarding.entropy.learn_more.safety.fair.title" = "Ṣe Àkọsílẹ̀ Àbájáde Tí Kò Ṣe Ojúsàájú, Tó Sì Dúró Lọ́tọ̀";
"onboarding.entropy.learn_more.safety.fair.detail" = "Lo ẹyọ owó tàbí dáísì tí kò ṣe ojúsàájú, kí o sì rí i pé gbogbo àbájáde dúró lọ́tọ̀. Àwọn díjítì láìlétò gbọ́dọ̀ wá láti orísun ti ara gidi—kì í ṣe láti inú ìrántí tàbí àpẹẹrẹ.";
"onboarding.entropy.learn_more.safety.private.title" = "Pa Ìlànà Ẹntíròpì Rẹ Mọ́ Ní Àṣírí";
"onboarding.entropy.learn_more.safety.private.detail" = "Dáàbò bo ọ̀wọ̀ọ̀wọ́ tí o ṣe àkọsílẹ̀ àti gbólóhùn ìmúpadàbọ̀ tó parí gẹ́gẹ́ bí àṣírí àpamọ́wọ́. Má jẹ́ kí kámẹ́rà tàbí ẹlòmíràn rí wọn.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Ṣe Àkọsílẹ̀ Gbogbo Àbájáde Gangan";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Àbájáde kan tó sọnù, tó ṣe ẹ̀dà méjì, tàbí tí a tún tò yóò ṣẹ̀dá àpamọ́wọ́ mìíràn. Ṣàyẹ̀wò gbogbo ìgbéwọlé, kí o sì jẹ́rìísí gbólóhùn ìmúpadàbọ̀ tó parí kí o tó fi owó sínú àpamọ́wọ́.";
"onboarding.entropy.learn_more.safety.backup.title" = "Dáàbò Bo Gbólóhùn Ìmúpadàbọ̀";
"onboarding.entropy.learn_more.safety.backup.detail" = "Pa gbólóhùn ìmúpadàbọ̀ mọ́ ní aisinipo, má sì pín in. Lẹ́yìn tí o bá jẹ́rìísí ẹ̀dà àfẹ́yinti rẹ, pa àkọsílẹ̀ ìgbéwọlé àárín gbùngbùn tí o kò nílò mọ́ rẹ́ lọ́nà ààbò.";
"onboarding.entropy.learn_more.safety.footer" = "Ẹntíròpì ti ara kò lè dáàbò bo gbólóhùn ìmúpadàbọ̀ tí a ti ṣí payá, ẹ̀rọ tí a ti dá ààbò rẹ̀ rú, sọ́fitiwia apanilára, tàbí ọ̀wọ̀ọ̀wọ́ tí a kọ sílẹ̀ lọ́nà àṣìṣe. Tí o kò bá lè mú un dájú pé ìgbéwọlé rẹ kò ṣe ojúsàájú, ó wà ní àṣírí, ó sì péye, lo ìṣẹ̀dá àpamọ́wọ́ boṣewa dípò.";
"onboarding.carousel.open_source.eyebrow" = "A ṢE É PẸ̀LÚ ORÍSUN ṢÍṢÍ";
"onboarding.carousel.open_source.title" = "Ṣàyẹ̀wò Orísun. Jẹ́rìísí Bílíìdì.";
"onboarding.carousel.open_source.message" = "Oath ń tẹ kóòdù orísun rẹ̀ jáde fún àyẹ̀wò olómìnira. A jẹ́rìísí ìtújáde kìkì nígbà tí bílíìdì tí a lè tún ṣe bá ìka-ọwọ́ díjítà ápù tí a tẹ̀ jáde mu.";
