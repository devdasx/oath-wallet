"onboarding.carousel.open_source.visual.compare" = "Fi Àwọn Àbájáde Bílíìdì Wé Ara Wọn";
"onboarding.carousel.open_source.visual.fingerprint" = "Ìka-Ọwọ́ Díjítà Ìtújáde Tí A Tẹ̀ Jáde";
"onboarding.carousel.open_source.visual.match" = "ÌBÁMU TI FÌDÍ MÚLẸ̀ — A JẸ́RÌÍSÍ BÍLÍÌDÌ";
"onboarding.carousel.open_source.visual.accessibility" = "Àwòrán tó fi hàn pé jíjẹ́rìísí ìtújáde nílò kóòdù orísun gbangba, títún bílíìdì ṣe lọ́nà olómìnira, àti àwọn ìka-ọwọ́ tó bá ara wọn mu.";
"onboarding.carousel.passphrase.eyebrow" = "GBÓLÓHÙN AṢÍNÀ BIP-39 ÀṢÀYÀN";
"onboarding.carousel.passphrase.title" = "Gbólóhùn Ìmúpadàbọ̀ Kan. Àṣírí Àfikún Kan.";
"onboarding.carousel.passphrase.message" = "Gbólóhùn aṣínà BIP-39 kan darapọ̀ mọ́ gbólóhùn ìmúpadàbọ̀ rẹ láti mú àpamọ́wọ́ ọ̀tọ̀ jáde. Bí àwọn ọ̀rọ̀ ìmúpadàbọ̀ bá tilẹ̀ di gbangba, wíwọlé sí àpamọ́wọ́ yẹn ṣì nílò gbólóhùn aṣínà gangan.";
"onboarding.carousel.passphrase.visual.phrase" = "Àwọn Ọ̀rọ̀ Ìmúpadàbọ̀ 24 Rẹ";
"onboarding.carousel.passphrase.visual.passphrase" = "Gbólóhùn Aṣínà Àfikún Tó Jẹ́ Àṣírí Rẹ";
"onboarding.carousel.passphrase.visual.output" = "Àpamọ́wọ́ Gbólóhùn Aṣínà Ọ̀tọ̀";
"onboarding.carousel.passphrase.visual.requirement" = "A Nílò Àṣírí Méjèèjì Fún Ìmúpadàbọ̀";
"onboarding.carousel.passphrase.visual.accessibility" = "Gbólóhùn ìmúpadàbọ̀ oní ọ̀rọ̀ 24 àti gbólóhùn aṣínà BIP-39 àṣírí mú àpamọ́wọ́ ọ̀tọ̀ jáde, tí ó sì nílò àṣírí méjèèjì fún ìmúpadàbọ̀.";
"onboarding.carousel.passphrase.learn_more.action" = "Ṣàwárí Àwọn Àlàyé Sí I";
"onboarding.passphrase.learn_more.navigation" = "Lílóye Àwọn Gbólóhùn Aṣínà BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Àṣírí Méjì Mú Àpamọ́wọ́ Kan Jáde";
"onboarding.passphrase.learn_more.overview" = "Gbólóhùn aṣínà BIP-39 jẹ́ àṣírí àṣàyàn tí a darapọ̀ mọ́ gbólóhùn ìmúpadàbọ̀ rẹ. Àwọn méjèèjì jọ ń mú àpamọ́wọ́ kan jáde ní ọ̀nà tó dúró ṣinṣin, àpamọ́wọ́ náà sì yàtọ̀ sí èyí tí gbólóhùn ìmúpadàbọ̀ nìkan ṣẹ̀dá.";
"onboarding.passphrase.learn_more.visual.phrase" = "Gbólóhùn Ìmúpadàbọ̀ Oní Ọ̀rọ̀ 24 Rẹ";
"onboarding.passphrase.learn_more.visual.passphrase" = "Gbólóhùn Aṣínà Àṣírí Rẹ";
"onboarding.passphrase.learn_more.visual.wallet" = "Àpamọ́wọ́ Tí Gbólóhùn Aṣínà Dáàbò Bo";
"onboarding.passphrase.learn_more.visual.accessibility" = "Gbólóhùn ìmúpadàbọ̀ oní ọ̀rọ̀ 24 àti gbólóhùn aṣínà àṣírí parapọ̀ láti mú àpamọ́wọ́ ọ̀tọ̀ tí gbólóhùn aṣínà dáàbò bo jáde.";
"onboarding.passphrase.learn_more.derivation.section" = "Bí BIP-39 Ṣe Ń Mú Àpamọ́wọ́ Jáde";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Gbólóhùn Ìmúpadàbọ̀ Pẹ̀lú Gbólóhùn Aṣínà";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 Pẹ̀lú Yíyípo 2,048";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Irúgbìn Àkọ́kọ́ Oní Bítì 512";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Àwọn Àkọọ́lẹ̀ àti Àdírẹ́sì Àpamọ́wọ́ Tí A Mú Jáde";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Gbólóhùn ìmúpadàbọ̀ àti gbólóhùn aṣínà rẹ kọjá nínú yíyípo PBKDF2-HMAC-SHA512 2,048 láti ṣẹ̀dá irúgbìn oní bítì 512, tí a sì ti inú rẹ̀ mú àwọn àkọọ́lẹ̀ àti àdírẹ́sì àpamọ́wọ́ jáde.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 ka gbólóhùn ìmúpadàbọ̀ tí a mú dọ́gba sí ọ̀rọ̀ aṣínà PBKDF2, ó sì lo “mnemonic” tí gbólóhùn aṣínà tí a mú dọ́gba tẹ̀ lé gẹ́gẹ́ bí salt. Lẹ́yìn yíyípo PBKDF2-HMAC-SHA512 2,048, ìlànà náà ṣẹ̀dá irúgbìn oní báìtì 64.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Kí ó tó mú irúgbìn jáde, Oath lo ìmúdọ́gba Unicode tí BIP-39 béèrè, kí gbólóhùn ìmúpadàbọ̀ àti gbólóhùn aṣínà kan náà tí a mú dọ́gba lè máa tún àpamọ́wọ́ kan náà ṣẹ̀dá.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Gbólóhùn aṣínà kì í fi ìsekóòdù bo àwọn ọ̀rọ̀ ìmúpadàbọ̀ rẹ. Ó ń yí irúgbìn tí a mú jáde padà, nítorí náà gbogbo gbólóhùn aṣínà tó yàtọ̀ ń ṣẹ̀dá àwọn àkọọ́lẹ̀ àti àdírẹ́sì tó yàtọ̀.";
"onboarding.passphrase.learn_more.wallets.section" = "Gbólóhùn Aṣínà Kọ̀ọ̀kan Ń Mú Àpamọ́wọ́ Ọ̀tọ̀ Jáde";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Àpẹẹrẹ Gbólóhùn Aṣínà 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Àpẹẹrẹ Gbólóhùn Aṣínà 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Àpẹẹrẹ Àpamọ́wọ́ A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Àpẹẹrẹ Àpamọ́wọ́ B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Gbólóhùn ìmúpadàbọ̀ kan náà pẹ̀lú gbólóhùn aṣínà méjì tó yàtọ̀ ń mú àpamọ́wọ́ ọ̀tọ̀ méjì jáde: Àpamọ́wọ́ A àti Àpamọ́wọ́ B.";
"onboarding.passphrase.learn_more.wallets.different" = "Yíyí àmì kan ṣoṣo tó ní ìtumọ̀ padà ń mú irúgbìn mìíràn, àti nítorí náà àpamọ́wọ́ mìíràn, jáde; àpamọ́wọ́ àkọ́kọ́ kò yí padà.";
"onboarding.passphrase.learn_more.wallets.empty" = "Gbólóhùn aṣínà òfo ń ṣí àpamọ́wọ́ boṣewa tí gbólóhùn ìmúpadàbọ̀ nìkan mú jáde; gbólóhùn aṣínà tí kò ṣófo ń ṣí àpamọ́wọ́ ọ̀tọ̀ tirẹ̀.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 kò ní ìdáhùn “gbólóhùn aṣínà tí kò tọ́”; gbogbo gbólóhùn aṣínà ló wúlò, nítorí náà àṣìṣe títẹ̀ kan lè ṣí àpamọ́wọ́ mìíràn láìsọ fún ọ—ọ̀pọ̀ ìgbà pẹ̀lú ìyókù owó òdo.";
"onboarding.passphrase.learn_more.security.section" = "Bí Gbólóhùn Aṣínà Ṣe Ń Fi Ààbò Kún Un";
"onboarding.passphrase.learn_more.security.words.title" = "Àwọn Ọ̀rọ̀ Ìmúpadàbọ̀ Nìkan Kò Tó";
"onboarding.passphrase.learn_more.security.words.detail" = "Ẹni tó bá rí gbólóhùn ìmúpadàbọ̀ rẹ nìkan ṣì nílò gbólóhùn aṣínà gangan láti mú àpamọ́wọ́ tí a dáàbò bo jáde, kí ó sì wọlé sí i.";
"onboarding.passphrase.learn_more.security.strength.title" = "Agbára Ń Dá Àwọn Àṣírí Yà Dáadáa Sí I";
"onboarding.passphrase.learn_more.security.strength.detail" = "Gbólóhùn aṣínà gígùn tí kò rọrùn láti sọ tẹ́lẹ̀ ń mú kí àfojúsùn rẹ̀ ṣòro gan-an; ọ̀rọ̀ àyọlò kúkúrú, ọjọ́ ìbí, orúkọ, tàbí ọ̀rọ̀ aṣínà tí a tún lò lè rọrùn láti fojú sọ, kò sì ní ààbò púpọ̀.";
"onboarding.passphrase.learn_more.security.separation.title" = "Pa Gbólóhùn Aṣínà Mọ́ Lọ́tọ̀";
"onboarding.passphrase.learn_more.security.separation.detail" = "Fi gbólóhùn aṣínà pamọ́ lọ́tọ̀ sí gbólóhùn ìmúpadàbọ̀, kí jíjí ẹ̀dà àfẹ́yinti kan ṣoṣo má bàa ṣí àṣírí méjèèjì tí a nílò láti mú àpamọ́wọ́ padà.";
"onboarding.passphrase.learn_more.security.footer" = "Gbólóhùn aṣínà kò lè dáàbò bo owó rẹ bí àṣírí méjèèjì bá di gbangba, bí gbólóhùn aṣínà bá rọrùn, tàbí bí sọ́fitiwia tí a ti dá ààbò rẹ̀ rú bá gba á nígbà tí o ń tẹ̀ ẹ́.";
"onboarding.passphrase.learn_more.safety.section" = "Lo Ẹ̀yà Yìí Lọ́nà Ààbò";
"onboarding.passphrase.learn_more.safety.strong.title" = "Ṣẹ̀dá Gbólóhùn Aṣínà Tó Lágbára, Tó Sì Yàtọ̀";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Yan ọ̀pọ̀ ọ̀rọ̀ láìlétò tàbí iye ẹntíròpì gíga mìíràn tó jẹ́ ti àpamọ́wọ́ yìí nìkan. Yẹra fún òtítọ́ nípa ara rẹ, gbólóhùn tí a mọ̀ dáadáa, àpẹẹrẹ, àti ọ̀rọ̀ aṣínà tí o lò níbòmíràn.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Ṣe Ẹ̀dà Àfẹ́yinti Gbólóhùn Aṣínà Lọ́tọ̀";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Ṣe ẹ̀dà aisinipo tó lágbára ti gbólóhùn aṣínà gangan, fi í pamọ́ lọ́tọ̀ sí gbólóhùn ìmúpadàbọ̀, má sì gbẹ́kẹ̀lé ìrántí nìkan.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Gbogbo Àmì Ń Yí Àpamọ́wọ́ Padà";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Tún gbólóhùn aṣínà tẹ̀ gangan bí o ṣe ṣẹ̀dá rẹ̀, pẹ̀lú gbogbo lẹ́tà ńlá, ààyè, àmì ìdádúró, àti ọ̀rọ̀. Ìyàtọ̀ èyíkéyìí ń mú àpamọ́wọ́ mìíràn jáde láìfi àṣìṣe hàn.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Jẹ́rìísí Ìmúpadàbọ̀ Kí O Tó Fi Owó Kún Un";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Kí o tó gba owó tó pọ̀, ṣe ìdánwò ìmúpadàbọ̀ ní àṣírí àti lábẹ́ ìṣàkóso láti jẹ́rìí pé gbólóhùn ìmúpadàbọ̀ àti gbólóhùn aṣínà ń tún àwọn àdírẹ́sì tí a retí ṣẹ̀dá.";
"onboarding.passphrase.learn_more.safety.footer" = "Kò sí iṣẹ́ kankan tó lè tún gbólóhùn aṣínà tí ó sọnù ṣètò tàbí mú un padà. Láìsí gbólóhùn aṣínà gangan, ìwọlé sí àpamọ́wọ́ náà ti sọnù títí láéláé—kódà bí o bá ṣì ní gbólóhùn ìmúpadàbọ̀.";
