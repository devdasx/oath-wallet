"settings.about.history.v357.tour" = "Ìrìn àjò olójú ewé márùn-ún ń ṣàfihàn àwọn nẹ́tíwọ́ọ̀kì tí a ń ṣe àtìlẹ́yìn fún, entropy ti ara, fífiránṣẹ́ àti gbígbà, ààbò àti àwọn ìkọ́lé tí a ti fọwọ́ sí. Fà tàbí tẹ àwọn àmì kékeré láti yí ojú ewé padà; bọ́tìnì ìyípadà èdè wà nínú pátákó ìlọ́kiri.";
"settings.about.history.v357.backup" = "Lẹ́yìn ṣíṣẹ̀dá, gbígbé wọlé tàbí mímú àpamọ́wọ́ padà, ojú ìboju yóò farahàn lẹ́sẹ̀kẹsẹ̀, àwọn àṣàyàn àfipamọ́ rẹ̀ sì ń lo àkójọ àṣà. Àyẹ̀wò iCloud ń ṣiṣẹ́ ní ẹ̀yìn, bọ́tìnì Ṣí Àpamọ́wọ́ sì ti ṣetán ní kété tí a bá ti fi àpamọ́wọ́ pamọ́.";
"settings.about.history.v357.reliability" = "Pípadà láti ẹ̀yìn kò ti ojú ìboju ìṣètò mọ́ nígbà tí ojú ìboju ìgbàpadà tí a fi pamọ́ bá parí, píparẹ́ gbogbo dátà sì ń ṣí ojú ìboju ìkíni tààrà.";
"settings.about.history.v357.notifications" = "Àwọn ètò ìfitónilétí ń lo àwọn ọ̀rọ̀ tí ó rọrùn jù fún àwọn ẹ̀ka àti ipò, láìsí àwọn kúlẹ̀kúlẹ̀ ìmọ̀ ẹ̀rọ.";
"settings.about.history.v357.wallets" = "Tún àwọn àpamọ́wọ́ tò nínú olùyípadà pẹ̀lú títẹ̀ pẹ́ nípa lílo ìgbéga eré ìdárayá ètò; títẹ ìlà kan ń mú un ṣiṣẹ́. Ìfẹ̀rí gbólóhùn ìgbàpadà ń fi nọ́mbà sí ọ̀rọ̀ kọ̀ọ̀kan, Return sì ń lọ sí àyè tí ó tẹ̀lé e.";
"settings.about.history.v357.send" = "Fífiránṣẹ́ ń fi iye hàn nígbà tí ìgbéṣẹ́ náà ń lọ lọ́wọ́, ìfiránṣẹ́ tí ó ṣe kedere jù yóò farahàn bí kò bá ṣeé fi ránṣẹ́, àwọn ìbéèrè TRON sì ń tún gbìyànjú fúnra wọn lẹ́yìn àwọn àṣìṣe olùpèsè fún ìgbà díẹ̀.";
"settings.about.history.v357.security" = "Àwọn àkántì TRON tí a gbé wọlé tí a ti gbé àṣẹ olówó wọn lọ sí kọ́kọ́rọ́ mìíràn ti ń fi ìkìlọ̀ hàn báyìí, wọn kò sì lè fi ránṣẹ́, kódà nígbà tí àṣẹ kọ̀ọ̀kan bá ní kọ́kọ́rọ́ kan ṣoṣo. A ń kọ àwọn gbólóhùn ìgbàpadà àti àwọn kọ́kọ́rọ́ ìkọ̀kọ̀ púpọ̀ sí i tí a mọ̀ pé wọ́n ti jáde nígbà gbígbé wọlé.";
"settings.about.history.v356.localization" = "A ti mú ọ̀rọ̀ ojú ìkíni káàbọ̀ sunwọ̀n sí i ní gbogbo èdè tí a ń ṣe àtìlẹ́yìn fún, kí ó rọrùn láti kà àti láti lóye.";
