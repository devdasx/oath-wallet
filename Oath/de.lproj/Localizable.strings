"onboarding.carousel.entropy.eyebrow" = "ENTROPIE AUS PHYSISCHEN EINGABEN";
"onboarding.carousel.entropy.title" = "Erzeuge Zufall, den du vollständig kontrollierst.";
"onboarding.carousel.entropy.message" = "Würfle, wirf eine Münze oder notiere zufällige Ziffern. Oath wandelt deine physischen Eingaben direkt auf deinem Gerät in genau 256 Bit Entropie für eine Wiederherstellungsphrase aus 24 Wörtern um.";
"onboarding.carousel.entropy.visual.output" = "256 Bit selbst erzeugte Entropie";
"onboarding.carousel.entropy.visual.local" = "Ausschließlich aus deinen aufgezeichneten Eingaben erzeugt";
"onboarding.carousel.entropy.visual.accessibility" = "Ein beschrifteter Würfel, eine Münze und zufällige Ziffern ergeben zusammen auf diesem Gerät 256 Bit Wallet-Entropie.";
"onboarding.carousel.entropy.learn_more.action" = "Weitere Details ansehen";
"onboarding.entropy.learn_more.navigation" = "So funktioniert physische Entropie";
"onboarding.entropy.learn_more.path.section" = "Von physischen Ergebnissen zu Wiederherstellungswörtern";
"onboarding.entropy.learn_more.overview" = "Oath erfasst die Ergebnisse deiner gewählten physischen Quelle und wandelt sie in einen 256-Bit-Wert um. Die daraus entstehenden 32 Byte werden anschließend an Wallet Core übergeben, um eine standardmäßige BIP-39-Wiederherstellungsphrase zu erstellen.";
"onboarding.entropy.learn_more.visual.phrase" = "Eine BIP-39-Wiederherstellungsphrase aus 24 Wörtern";
"onboarding.entropy.learn_more.visual.bits" = "32 Byte × 8 Bit ergeben 256 Bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Ein Raster mit 256 beispielhaften Bit-Zellen, angeordnet in 32 Byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Würfelergebnisse, Münzwürfe oder zufällige Ziffern werden in 256 Bit und anschließend in eine BIP-39-Wiederherstellungsphrase aus 24 Wörtern umgewandelt.";
"onboarding.entropy.learn_more.inputs.section" = "Schritt 1: Physische Ergebnisse aufzeichnen";
"onboarding.entropy.learn_more.inputs.dice.title" = "Mit einem fairen sechsseitigen Würfel würfeln";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Bei einem fairen Würfel tragen die Seiten 1–4 jeweils 2 Bit bei, die Seiten 5–6 jeweils 1 Bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Eine echte Münze werfen";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Jeder faire, unabhängige Münzwurf trägt 1 unverzerrtes Bit Entropie bei.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zufällige Ziffern aufzeichnen";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Die Ziffern 0–7 tragen jeweils 3 Bit bei, die Ziffern 8–9 jeweils 1 Bit. Die Ziffern müssen aus einem wirklich zufälligen physischen Vorgang stammen.";
"onboarding.entropy.learn_more.inputs.footer" = "Verwende eine faire physische Quelle und zeichne jedes Ergebnis der Reihe nach auf. Du kannst zwischen den Eingabemethoden wechseln, da jedes akzeptierte Ergebnis zum selben Bitstrom beiträgt.";
"onboarding.entropy.learn_more.conversion.section" = "2. Einen 256-Bit-Wert zusammensetzen";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath wandelt Würfelergebnisse und Dezimalziffern in unverzerrte Zweierpotenz-Gruppen um. Die Länge der Beiträge kann variieren, doch bei einer fairen physischen Quelle wird kein Bitwert bevorzugt.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath hängt die Bits in der eingegebenen Reihenfolge an, bis genau 256 erfasst sind, und packt sie anschließend mit dem höchstwertigen Bit zuerst in 32 Byte.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Die benutzerdefinierte Entropie enthält ausschließlich deine aufgezeichneten physischen Eingaben. Oath mischt keinen vom Gerät erzeugten Zufall bei.";
"onboarding.entropy.learn_more.bip39.section" = "3. Die Wiederherstellungsphrase ableiten";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 Bit Entropie";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Eine 8-Bit-BIP-39-Prüfsumme";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 Bit, aufgeteilt in 24 Wortindizes mit je 11 Bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Ein 256-Bit-Entropiewert erhält eine 8-Bit-Prüfsumme. So entstehen 264 Bit, die in 24 Wortindizes mit je 11 Bit aufgeteilt werden.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 berechnet SHA-256 über den 32-Byte-Entropiewert und verwendet die ersten 8 Hash-Bits als Prüfsumme. Durch Anhängen dieser Prüfsumme entstehen 264 Bit.";
"onboarding.entropy.learn_more.bip39.words" = "Die 264 Bit werden in 24 Gruppen mit je 11 Bit aufgeteilt. Jede Gruppe wählt einen Eintrag aus der standardmäßigen BIP-39-Liste mit 2.048 Wörtern aus. Daraus entsteht die Wiederherstellungsphrase aus 24 Wörtern.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core leitet aus dem resultierenden Seed deterministisch Konten und Adressen ab. Dieselbe Wiederherstellungsphrase und optionale Passphrase stellen immer dieselbe Wallet wieder her.";
"onboarding.entropy.learn_more.security.section" = "So stärkt benutzerdefinierte Entropie die Sicherheit";
"onboarding.entropy.learn_more.security.space.title" = "Ein enorm großer Möglichkeitsraum";
"onboarding.entropy.learn_more.security.space.detail" = "Gleichverteilte 256-Bit-Entropie umfasst 2^256 eindeutige Werte und macht vollständiges Durchprobieren rechnerisch undurchführbar. Dies beschreibt die Größe des Eingaberaums und bedeutet nicht, dass jede kryptografische Komponente eine Angriffssicherheit von 256 Bit bietet.";
"onboarding.entropy.learn_more.security.source.title" = "Der Zufall kommt von dir";
"onboarding.entropy.learn_more.security.source.detail" = "Mit physischen Ereignissen kannst du den Zufall deiner Wallet unabhängig erzeugen, statt dich ausschließlich auf den Zufallszahlengenerator eines Geräts zu verlassen. Das erhöht die Sicherheit nur, wenn diese Ereignisse wirklich zufällig sind.";
"onboarding.entropy.learn_more.security.local.title" = "Vollständig auf diesem Gerät verarbeitet";
"onboarding.entropy.learn_more.security.local.detail" = "Oath wandelt deine aufgezeichnete Abfolge um und erstellt die Wiederherstellungsphrase vollständig auf diesem Gerät. Deine Abfolge wird niemals zur Verarbeitung hochgeladen.";
"onboarding.entropy.learn_more.security.patterns.title" = "Keine selbst gewählten Geheimnisse";
"onboarding.entropy.learn_more.security.patterns.detail" = "Eine lange Abfolge fairer, unabhängiger Ereignisse ist wesentlich weniger vorhersehbar als Geburtstage, Lieblingszahlen, wiederholte Muster oder selbst gewählte Wörter.";
"onboarding.entropy.learn_more.security.footer" = "Physische Entropie ersetzt den vom Gerät erzeugten Wallet-Zufall. Sie ist kein zusätzliches Passwort und keine weitere Sicherheitsebene.";
"onboarding.entropy.learn_more.safety.section" = "Diese Funktion sicher verwenden";
"onboarding.entropy.learn_more.safety.fair.title" = "Faire, unabhängige Ergebnisse aufzeichnen";
"onboarding.entropy.learn_more.safety.fair.detail" = "Verwende eine faire Münze oder einen fairen Würfel und stelle sicher, dass jedes Ergebnis unabhängig ist. Zufällige Ziffern müssen aus einer echten physischen Quelle stammen, nicht aus dem Gedächtnis oder einem Muster.";
"onboarding.entropy.learn_more.safety.private.title" = "Halte deinen Entropieprozess geheim";
"onboarding.entropy.learn_more.safety.private.detail" = "Schütze sowohl die aufgezeichnete Abfolge als auch die fertige Wiederherstellungsphrase wie Wallet-Geheimnisse. Halte beides von Kameras und anderen Personen fern.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Jedes Ergebnis exakt aufzeichnen";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Ein fehlendes, doppeltes oder in der Reihenfolge verändertes Ergebnis erzeugt eine andere Wallet. Prüfe jeden Eintrag und verifiziere die fertige Wiederherstellungsphrase, bevor du Guthaben auf die Wallet überträgst.";
"onboarding.entropy.learn_more.safety.backup.title" = "Wiederherstellungsphrase sicher aufbewahren";
"onboarding.entropy.learn_more.safety.backup.detail" = "Bewahre die Wiederherstellungsphrase offline auf und teile sie niemals. Vernichte nach der Überprüfung deines Backups alle nicht mehr benötigten Zwischenaufzeichnungen sicher.";
"onboarding.entropy.learn_more.safety.footer" = "Physische Entropie schützt weder eine offengelegte Wiederherstellungsphrase noch ein kompromittiertes Gerät, Schadsoftware oder eine falsch aufgezeichnete Abfolge. Wenn du keine fairen, geheimen und exakten Eingaben gewährleisten kannst, verwende stattdessen die standardmäßige Wallet-Erstellung.";
"onboarding.carousel.open_source.eyebrow" = "OPEN SOURCE AUS ÜBERZEUGUNG";
"onboarding.carousel.open_source.title" = "Quellcode prüfen. Build verifizieren.";
"onboarding.carousel.open_source.message" = "Oath veröffentlicht seinen Quellcode zur unabhängigen Prüfung. Ein Release gilt nur dann als verifiziert, wenn ein reproduzierbarer Build mit dem Fingerabdruck der veröffentlichten App übereinstimmt.";
"onboarding.carousel.open_source.action.github" = "Auf GitHub prüfen";
"onboarding.carousel.open_source.visual.repository" = "Öffentliches Quellcode-Repository";
"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture öffnen";
"onboarding.carousel.open_source.visual.source" = "Quellcode prüfen";
"onboarding.carousel.open_source.visual.rebuild" = "Release-Build reproduzieren";
"onboarding.carousel.open_source.visual.compare" = "Build-Artefakte vergleichen";
"onboarding.carousel.open_source.visual.fingerprint" = "Fingerabdruck des veröffentlichten Releases";
"onboarding.carousel.open_source.visual.match" = "ÜBEREINSTIMMUNG BESTÄTIGT — BUILD VERIFIZIERT";
"onboarding.carousel.open_source.visual.accessibility" = "Diagramm: Zur Verifizierung eines Releases sind öffentlicher Quellcode, ein unabhängiger neuer Build und übereinstimmende Fingerabdrücke erforderlich.";
"onboarding.carousel.passphrase.eyebrow" = "OPTIONALE BIP-39-PASSPHRASE";
"onboarding.carousel.passphrase.title" = "Eine Wiederherstellungsphrase. Ein weiteres Geheimnis.";
"onboarding.carousel.passphrase.message" = "Eine BIP-39-Passphrase wird mit deiner Wiederherstellungsphrase kombiniert, um eine separate Wallet abzuleiten. Selbst wenn die Wiederherstellungswörter offengelegt werden, ist für den Zugriff auf diese Wallet weiterhin die exakte Passphrase erforderlich.";
"onboarding.carousel.passphrase.visual.phrase" = "Deine 24 Wiederherstellungswörter";
"onboarding.carousel.passphrase.visual.passphrase" = "Deine zusätzliche geheime Passphrase";
"onboarding.carousel.passphrase.visual.output" = "Eine eigenständige Passphrase-Wallet";
"onboarding.carousel.passphrase.visual.requirement" = "Zur Wiederherstellung sind beide Geheimnisse erforderlich";
"onboarding.carousel.passphrase.visual.accessibility" = "Eine Wiederherstellungsphrase aus 24 Wörtern und eine geheime BIP-39-Passphrase leiten eine separate Wallet ab, für deren Wiederherstellung beide Geheimnisse erforderlich sind.";
"onboarding.carousel.passphrase.learn_more.action" = "Weitere Details ansehen";
"onboarding.passphrase.learn_more.navigation" = "BIP-39-Passphrasen verstehen";
"onboarding.passphrase.learn_more.path.section" = "Zwei Geheimnisse leiten eine Wallet ab";
"onboarding.passphrase.learn_more.overview" = "Eine BIP-39-Passphrase ist ein optionales Geheimnis, das mit deiner Wiederherstellungsphrase kombiniert wird. Zusammen leiten sie deterministisch eine andere Wallet ab als die Wiederherstellungsphrase allein.";
"onboarding.passphrase.learn_more.visual.phrase" = "Deine Wiederherstellungsphrase aus 24 Wörtern";
"onboarding.passphrase.learn_more.visual.passphrase" = "Deine geheime Passphrase";
"onboarding.passphrase.learn_more.visual.wallet" = "Eine durch eine Passphrase geschützte Wallet";
"onboarding.passphrase.learn_more.visual.accessibility" = "Eine Wiederherstellungsphrase aus 24 Wörtern und eine geheime Passphrase ergeben zusammen eine separate, durch eine Passphrase geschützte Wallet.";
"onboarding.passphrase.learn_more.derivation.section" = "So leitet BIP-39 die Wallet ab";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Wiederherstellungsphrase mit Passphrase kombiniert";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 mit 2.048 Durchläufen";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-Bit-Master-Seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Abgeleitete Wallet-Konten und -Adressen";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Deine Wiederherstellungsphrase und Passphrase durchlaufen 2.048 Runden PBKDF2-HMAC-SHA512. So entsteht der 512-Bit-Seed, aus dem Wallet-Konten und -Adressen abgeleitet werden.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 verwendet die normalisierte Wiederherstellungsphrase als PBKDF2-Passwort und „mnemonic“, gefolgt von der normalisierten Passphrase, als Salt. Nach 2.048 Runden PBKDF2-HMAC-SHA512 erzeugt das Verfahren einen 64-Byte-Seed.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Vor der Seed-Ableitung wendet Oath die von BIP-39 vorgeschriebene Unicode-Normalisierung an. So stellen dieselbe normalisierte Wiederherstellungsphrase und Passphrase stets dieselbe Wallet wieder her.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Eine Passphrase verschlüsselt deine Wiederherstellungswörter nicht. Sie verändert den abgeleiteten Seed, sodass jede andere Passphrase andere Konten und Adressen erzeugt.";
"onboarding.passphrase.learn_more.wallets.section" = "Jede Passphrase leitet eine separate Wallet ab";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Beispiel-Passphrase 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Beispiel-Passphrase 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Beispiel-Wallet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Beispiel-Wallet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Dieselbe Wiederherstellungsphrase leitet zusammen mit zwei verschiedenen Passphrasen zwei separate Wallets ab: Wallet A und Wallet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Schon die Änderung eines einzigen bedeutungstragenden Zeichens leitet einen anderen Seed und damit eine andere Wallet ab. Die ursprüngliche Wallet bleibt unverändert.";
"onboarding.passphrase.learn_more.wallets.empty" = "Eine leere Passphrase öffnet die Standard-Wallet, die allein aus der Wiederherstellungsphrase abgeleitet wird. Eine nicht leere Passphrase öffnet eine eigene separate Wallet.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 kennt keine Meldung für eine „falsche Passphrase“: Jede Passphrase ist gültig. Ein Tippfehler öffnet daher unbemerkt eine andere Wallet, meist mit einem Saldo von 0.";
"onboarding.passphrase.learn_more.security.section" = "So bietet eine Passphrase zusätzlichen Schutz";
"onboarding.passphrase.learn_more.security.words.title" = "Wiederherstellungswörter allein reichen nicht aus";
"onboarding.passphrase.learn_more.security.words.detail" = "Wer nur deine Wiederherstellungsphrase erhält, benötigt weiterhin die exakte Passphrase, um die geschützte Wallet abzuleiten und darauf zuzugreifen.";
"onboarding.passphrase.learn_more.security.strength.title" = "Stärke schafft eine bessere Trennung";
"onboarding.passphrase.learn_more.security.strength.detail" = "Eine lange, unvorhersehbare Passphrase erschwert das Erraten erheblich. Ein kurzes Zitat, ein Geburtstag, ein Name oder ein wiederverwendetes Passwort lässt sich möglicherweise schnell erraten und bietet kaum Schutz.";
"onboarding.passphrase.learn_more.security.separation.title" = "Passphrase getrennt aufbewahren";
"onboarding.passphrase.learn_more.security.separation.detail" = "Bewahre die Passphrase getrennt von der Wiederherstellungsphrase auf, damit ein einziges gestohlenes Backup nicht beide zur Wiederherstellung erforderlichen Geheimnisse preisgibt.";
"onboarding.passphrase.learn_more.security.footer" = "Eine Passphrase kann dein Guthaben nicht schützen, wenn beide Geheimnisse offengelegt werden, die Passphrase schwach ist oder kompromittierte Software sie bei der Eingabe erfasst.";
"onboarding.passphrase.learn_more.safety.section" = "Diese Funktion sicher verwenden";
"onboarding.passphrase.learn_more.safety.strong.title" = "Eine starke, einzigartige Passphrase erstellen";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Wähle mehrere zufällige Wörter oder einen anderen Wert mit hoher Entropie, den du nur für diese Wallet verwendest. Vermeide persönliche Angaben, bekannte Formulierungen, Muster und andernorts verwendete Passwörter.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Passphrase separat sichern";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Erstelle eine dauerhafte Offline-Kopie der exakten Passphrase, bewahre sie getrennt von der Wiederherstellungsphrase auf und verlasse dich niemals allein auf dein Gedächtnis.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Jedes Zeichen verändert die Wallet";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Gib die Passphrase genau so ein, wie du sie erstellt hast, einschließlich aller Großbuchstaben, Leerzeichen, Satzzeichen und Wörter. Jede Abweichung leitet unbemerkt eine andere Wallet ab.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Wiederherstellung vor dem Einzahlen prüfen";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Führe vor dem Empfang größerer Beträge einen geheimen, kontrollierten Wiederherstellungstest durch. Vergewissere dich, dass Wiederherstellungsphrase und Passphrase die erwarteten Adressen wiederherstellen.";
"onboarding.passphrase.learn_more.safety.footer" = "Kein Dienst kann eine verlorene Passphrase zurücksetzen oder wiederherstellen. Ohne die exakte Passphrase ist der Zugriff auf diese Wallet dauerhaft verloren, selbst wenn du die Wiederherstellungsphrase noch besitzt.";
