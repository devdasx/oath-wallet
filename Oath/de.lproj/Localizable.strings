"wallet.restrictions.warning.title" = "Wallet-Einschränkungen erkannt";

"wallet.blacklist.warning.body" = "Die unten aufgeführten Token-Verträge melden diese Adresse als gesperrt. Übertragungen dieser Token können blockiert sein. Zusätzliches Guthaben für Netzwerkgebühren hebt die Sperre nicht auf.";


"import.safety.action.different_recovery_phrase" = "Andere Wiederherstellungsphrase verwenden";

