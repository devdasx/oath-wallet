// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "Verbesserte Prüfung der Wiederherstellungsphrase, automatische Kleinschreibung, nummerierte Eingaben, Leeren, Löschen durch Gedrückthalten und Tastaturbedienung. Die Wiederherstellungsansichten haben jetzt nur eine Zurück-Schaltfläche.";
"settings.about.history.v353.build51.send" = "Alternative Gebührenschätzungen für alle unterstützten Netzwerke hinzugefügt, falls keine Schätzung verfügbar ist. Beim Senden werden Vertragsadressen ausgeblendet und Gebühren übersichtlicher angezeigt.";
"settings.about.history.v353.build51.security" = "Übersichtlichere Berechtigungsprüfung, Adressdetails, Widerrufsergebnisse und Hinweise zum Aufladen für Netzwerkgebühren. Einheitliche Gestaltung von Sicherungskarten und modalen Ansichten. Keine haptische Rückmeldung mehr bei der Navigation.";
"settings.about.history.v353.build51.notifications" = "Zuverlässigere Benachrichtigungen über eingehende Transfers in verschiedenen Netzwerken. Beträge erscheinen bei verfügbaren Kursen in der gewählten Währung, andernfalls in der jeweiligen Kryptowährung.";

