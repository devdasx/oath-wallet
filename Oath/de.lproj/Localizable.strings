// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Wischen zum Senden ersetzt die Bestätigungstaste. Richtungsanimation, Haptik und flüssigere Bewegung unterstützen beide Leserichtungen. Zum Senden bei mindestens 90% loslassen; zum Abbrechen zurückschieben.";
"settings.about.history.v355.build56.activity" = "Die Glocke öffnet ausstehende Aktivitäten. Transaktionskapseln zeigen Statusabzeichen und lassen sich wegwischen. Kapseln für laufende und abgeschlossene Bestätigungen verschwinden nach 3 Sekunden; die Bestätigung aktualisiert dieselbe noch sichtbare Kapsel.";
"settings.about.history.v355.build56.status" = "Zuverlässigerer Transaktionsstatus in allen unterstützten Netzwerken, aktuelle Transaktionsdetails und schnellere Guthabenaktualisierungen nach dem Senden. Die Überwachung ausstehender Transaktionen wird beim erneuten Öffnen fortgesetzt.";
"settings.about.history.v355.build56.fees" = "Bei Rückkehr zur selben Übertragungsprüfung bleibt die ermittelte Gebühr erhalten. Klareres Laden der Gebühren und Hinweise zur Kontofinanzierung; bei ausreichendem Betrag entfallen Aktivierungshinweise.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin und Dogecoin schlagen Wechselgeld unterhalb der Dust-Schwelle der Gebühr zu, statt einen unbrauchbaren Output zu erzeugen. Gebührenprüfung und Signierung stimmen überein.";
"settings.about.history.v355.build56.stability" = "Ein Absturz bei Hintergrundaufgaben und Zeitüberschreitungswarnungen beim Aktualisieren der Wallet wurden behoben. Bei vorübergehenden Aktualisierungsfehlern bleiben vorhandene Wallet-Informationen verfügbar.";
"settings.about.history.v355.build56.backup" = "Übersichtlichere Backup-Ansichten mit korrekten Titeln beim Öffnen und weniger Meldungen. Der Zugriff auf private Schlüssel respektiert die App-Sperre. Kompakte Importwarnungen in Glasoptik löschen abgelehnte Eingaben, wenn Sie eine andere Wiederherstellungsphrase wählen.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Nach dem Loslassen des Sendereglers erscheint ein animiertes Häkchen, bevor sich die Überprüfung schließt.";
"settings.about.history.v355.build57.activity" = "Aktivitätszeilen zeigen den Status in leichterer Schrift, den Betrag als Untertitel und einen Pfeil zum Öffnen der Transaktionsdetails.";
"settings.about.history.v355.build57.details" = "Netzwerkgebühren stehen jetzt in der Überweisungsübersicht. Kürzere Beschriftungen und eine einzige Netzwerkzeile machen die Details übersichtlicher.";
"settings.about.history.v355.build57.resume" = "Bei der Rückkehr aus dem Hintergrund bleiben geöffnete Ansichten und Blätter erhalten, einschließlich Überweisungsprüfung und Transaktionsdetails.";
"settings.about.history.v355.build57.secrets" = "Ansichten mit Wiederherstellungsphrase, privatem Schlüssel oder Passphrase schließen sich nach 20 Sekunden Abwesenheit. Die App-Sperre folgt weiterhin deinen Einstellungen.";
"settings.about.history.v355.build57.filters" = "Netzwerkfilter verwenden etwas höhere native Tasten, passen ihre Größe an den Inhalt an und haben korrigierte Abstände unter der Navigationsleiste.";
"settings.about.history.v355.build57.units" = "Separate Wertzeilen wurden entfernt. Betrag und Netzwerkgebühr erscheinen zuerst in der Landeswährung; durch Antippen wechselst du zu Kryptoeinheiten und zurück.";
"wallet.transaction.details.toggle_units" = "Einheiten wechseln.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Die Startseite öffnet sich ohne Einblend- oder Skalierungseffekt. Die Einstellungen-Taste verwendet jetzt ein Zahnradsymbol.";
"settings.about.history.v355.build58.fields" = "Felder in den Transaktionsdetails und beim Senden verwenden normale Textfarben. Pfeile erscheinen nur bei Zeilen, die einen Bildschirm oder ein Blatt öffnen; bei Beträgen und Gebühren wechselt Antippen weiterhin die Einheit.";
"settings.about.history.v355.build58.banners" = "Sobald Banner zur laufenden oder abgeschlossenen Bestätigung angezeigt wurden, verschwinden sie nach 3 Sekunden, auch beim Öffnen eines anderen Bildschirms. Noch nicht angezeigte Bestätigungsupdates erscheinen bei der Rückkehr.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Bei TRON-Überweisungen werden Aktivierungs- und Bandbreitengebühren jetzt vor der Berechnung des Sendebetrags zurückgelegt, auch beim Senden des Maximalbetrags. Die Überprüfung zeigt den korrekten Betrag nach Abzug der Gebühren.";
"settings.about.history.v355.build59.fees" = "Eigene TRON-Gebühren müssen die erforderlichen Netzwerkkosten decken. Bei niedrigem TRX-Guthaben erscheinen jetzt klarere Hinweise. Die Tokenmenge bleibt unverändert; Gebühren werden in TRX bezahlt.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Ein neuer Willkommensbildschirm";
"settings.about.history.v356.welcome" = "Ein neuer Willkommensbildschirm mit animierten Grafiken und klaren Optionen zum Erstellen oder Importieren einer Wallet.";
"settings.about.history.v357.tour.title" = "Willkommenstour";
"settings.about.history.v357.tour" = "Eine Tour mit fünf Seiten stellt die unterstützten Netzwerke, physische Entropie, Senden und Empfangen, Sicherheit und verifizierte Builds vor. Wische oder tippe auf die Punkte, um zwischen den Seiten zu wechseln; die Sprachauswahl sitzt in der Navigationsleiste.";
"settings.about.history.v357.backup" = "Nach dem Erstellen, Importieren oder Wiederherstellen einer Wallet erscheint der Bildschirm sofort, und die Backup-Optionen nutzen die Standardliste. Die iCloud-Prüfung läuft im Hintergrund, und „Wallet öffnen“ ist bereit, sobald die Wallet gespeichert ist.";
"settings.about.history.v357.reliability" = "Die Rückkehr aus dem Hintergrund schließt den Einrichtungsbildschirm nicht mehr, wenn ein verborgener Wiederherstellungsbildschirm abläuft, und das Löschen aller Daten öffnet direkt den Willkommensbildschirm.";
"settings.about.history.v357.notifications" = "Die Mitteilungseinstellungen verwenden für Kategorien und Status einfachere Formulierungen ohne technische Details.";
"settings.about.history.v357.wallets" = "Ordne Wallets im Umschalter per langem Drücken mit der Hebeanimation des Systems neu; ein Tipp auf eine Zeile aktiviert sie. Die Prüfung der Wiederherstellungsphrase nummeriert jedes Wort, und die Eingabetaste springt zum nächsten Feld.";
"settings.about.history.v357.send" = "Beim Senden wird der Betrag angezeigt, solange die Überweisung läuft, eine klarere Meldung erscheint, wenn sie nicht gesendet werden kann, und TRON-Anfragen werden nach vorübergehenden Anbieterfehlern automatisch wiederholt.";
"settings.about.history.v357.security" = "Importierte TRON-Konten, deren Eigentümerberechtigung auf einen anderen Schlüssel übertragen wurde, zeigen jetzt die Warnung und können nicht senden, selbst wenn jede Berechtigung nur einen Schlüssel aufführt. Weitere bekannte offengelegte Wiederherstellungsphrasen und private Schlüssel werden beim Import abgelehnt.";
"settings.about.history.v356.localization" = "Die Texte auf dem Willkommensbildschirm sind jetzt in allen unterstützten Sprachen natürlicher und verständlicher.";
"settings.about.history.v356.pricing" = "Tokenpreise werden jetzt anhand des genauen Netzwerks und der Tokenadresse abgerufen. DEX-Preise haben Vorrang. Kleine Preise werden mit bis zu 8 Nachkommastellen ohne Rundung angezeigt.";
"settings.about.history.v356.appearance" = "Primäre und sekundäre Schaltflächen haben jetzt einheitliche Höhen und seitliche Abstände. Primäre Aktionen verwenden das Systemblau.";
"settings.about.history.v356.transactions" = "Transaktionsdetails zeigen den kürzeren Status Bestätigt und besser lesbaren grauen Text für Datum, Adressen, Beträge und Transaktions-IDs.";
"settings.about.history.v356.security" = "Die Liste bekannter offengelegter Wiederherstellungsphrasen und privater Schlüssel, deren Import blockiert wird, wurde erweitert.";

