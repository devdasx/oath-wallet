"settings.about.history.v352.typing.title" = "Eingabe und Bearbeitung";
"settings.about.history.v352.navigation.title" = "Formularnavigation";
"settings.about.history.v352.icon.title" = "App-Symbol";
"settings.about.history.v352.recovery" = "Nummerierte Wortfelder wachsen beim Tippen, mit fließenden Übergängen, gepunkteten Bearbeitungsrahmen und stabilen Positionen beim Löschen von Wörtern.";
"settings.about.history.v352.typing" = "Automatischer Fokus, Inline-Vervollständigung mit Leer- oder Eingabetaste, zweistufiges Bearbeiten per Rücktaste, Löschen durch Gedrückthalten und automatisches Scrollen. Die Eingabetaste blendet die Tastatur nur bei einer gültigen Phrase aus.";
"settings.about.history.v352.passphrase" = "Das erste Passphrasenfeld wird automatisch fokussiert. Die Eingabetaste wechselt zur Bestätigung und blendet danach die Tastatur aus. Speichern über das Häkchen ist wieder verfügbar.";
"settings.about.history.v352.navigation" = "Bestätigte Eingaben bleiben beim Zurückgehen im Ablauf erhalten; beim Schließen werden unfertige Eingaben gelöscht.";
"settings.about.history.v352.scanner" = "Der QR-Scanner öffnet eine eigene Kameraansicht mit nativer Schließen-Taste.";
"settings.about.history.v352.recipients" = "Ein leerer Empfängerverlauf zeigt keinen Fehler und keine Aufforderung zum Wiederholen mehr.";
"settings.about.history.v352.amount" = "Tippe auf das Umrechnungsfeld, um zwischen Landeswährung und nativen Einheiten zu wechseln; es zeigt den Gegenwert in der anderen Einheit.";
"settings.about.history.v352.visibility" = "Adressen und Transaktions-IDs bleiben nach Authentifizierung oder App-Wechsel sichtbar. Lange Werte werden ohne zusätzliche Bindestriche umgebrochen.";
"settings.about.history.v352.op_return" = "Bitcoin-Nachrichten unterstützen bis zu 99,994 UTF-8-Bytes innerhalb der Transaktionsgrenzen. Signieren des Maximalbetrags korrigiert; lange Nachrichten zeigen drei Zeilen und öffnen sich vollständig in einer Ansicht.";
"settings.about.history.v352.repeat" = "Erneutes Senden prüft zuerst das Guthaben und zeigt bei unzureichenden Mitteln einen Dialog, bevor eine weitere Überweisung beginnt.";
"settings.about.history.v352.sharing" = "Das Teilen einer Transaktions-ID verwendet jetzt eine eigene, korrekt übersetzte Beschriftung.";
"settings.about.history.v352.localization" = "Nicht übersetzte oder veraltete Beschriftungen, Platzhalter und Netzwerknamen in allen 57 Sprachen korrigiert und die Lokalisierungsprüfungen verbessert.";
"settings.about.history.v352.icon" = "Die Symboltransparenz wurde für den App Store korrigiert, ohne das vorhandene Motiv zu verändern.";
"settings.about.history.v352.backup" = "Vorhandene iCloud-Backups können nach Bestätigung ersetzt werden.";

"settings.about.history.v352.build48" = "Build 48: Übersetzte Versionshinweise hinzugefügt. Der Export von Leistungsprotokollen und die Entwicklerprotokollierung wurden entfernt. Alte Diagnosedateien werden automatisch gelöscht.";

"settings.about.history.v352.build49" = "Build 49: Die Versionshinweise im Versionsverlauf wurden vereinfacht.";

