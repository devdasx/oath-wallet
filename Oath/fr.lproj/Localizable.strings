"onboarding.carousel.entropy.eyebrow" = "ENTROPIE ISSUE DE SOURCES PHYSIQUES";
"onboarding.carousel.entropy.title" = "Créez une source aléatoire sous votre contrôle.";
"onboarding.carousel.entropy.message" = "Lancez des dés, tirez à pile ou face ou notez des chiffres aléatoires. Oath convertit ces données physiques en exactement 256 bits d’entropie pour créer une phrase de récupération de 24 mots, entièrement sur votre appareil.";
"onboarding.carousel.entropy.visual.output" = "256 bits d’entropie générée par l’utilisateur";
"onboarding.carousel.entropy.visual.local" = "Générée uniquement à partir de vos saisies";
"onboarding.carousel.entropy.visual.accessibility" = "Un dé numéroté à six faces, une pièce et des chiffres aléatoires se combinent pour former une valeur d’entropie complète de 256 bits pour le portefeuille sur cet appareil.";
"onboarding.carousel.entropy.learn_more.action" = "Découvrir les détails";
"onboarding.entropy.learn_more.navigation" = "Fonctionnement de l’entropie physique";
"onboarding.entropy.learn_more.path.section" = "Des résultats physiques aux mots de récupération";
"onboarding.entropy.learn_more.overview" = "Oath enregistre les résultats de la source physique choisie et les convertit en une valeur de 256 bits. Les 32 octets obtenus sont ensuite transmis à Wallet Core pour créer une phrase de récupération BIP-39 standard.";
"onboarding.entropy.learn_more.visual.phrase" = "Phrase de récupération BIP-39 de 24 mots";
"onboarding.entropy.learn_more.visual.bits" = "32 octets × 8 bits = 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Une grille de 256 cellules binaires réparties en 32 octets.";
"onboarding.entropy.learn_more.visual.accessibility" = "Les lancers de dés, les tirages à pile ou face ou les chiffres aléatoires sont convertis en 256 bits, puis en une phrase de récupération BIP-39 de 24 mots.";
"onboarding.entropy.learn_more.inputs.section" = "Étape 1 : noter les résultats physiques";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lancer un dé équilibré à six faces";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Avec un dé équitable, les faces 1 à 4 contribuent chacune à 2 bits. Les faces 5 à 6 contribuent chacune à 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Tirages physiques à pile ou face";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Chaque tirage indépendant avec une pièce équilibrée apporte 1 bit d’entropie non biaisé.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Noter des chiffres aléatoires";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Les chiffres 0 à 7 contribuent chacun à 3 bits. Les chiffres 8 à 9 contribuent chacun à 1 bit. Les chiffres doivent provenir d’un processus physique véritablement aléatoire.";
"onboarding.entropy.learn_more.inputs.footer" = "Utilisez une source physique équilibrée et notez chaque résultat dans l’ordre. Vous pouvez changer de méthode, car chaque résultat accepté alimente le même flux binaire.";
"onboarding.entropy.learn_more.conversion.section" = "2. Assembler une valeur de 256 bits";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath convertit les résultats des dés et les chiffres décimaux en groupes non biaisés dont la taille est une puissance de 2. La longueur des contributions peut varier, mais une source physique équilibrée ne favorise aucune valeur binaire.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath ajoute les bits dans l’ordre de saisie jusqu’à en recueillir exactement 256, puis les regroupe en 32 octets, bit de poids fort en premier.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "L’entropie personnalisée contient uniquement les données physiques que vous saisissez ; Oath n’y ajoute aucune source aléatoire générée par l’appareil.";
"onboarding.entropy.learn_more.bip39.section" = "3. Dériver la phrase de récupération";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Entropie de 256 bits";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Somme de contrôle de 8 bits";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits répartis en 24 index de mots de 11 bits";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Une valeur d’entropie de 256 bits plus une somme de contrôle de 8 bits crée 264 bits, divisés en 24 index de mots de 11 bits chacun.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 calcule SHA-256 sur la valeur d’entropie de 32 octets et prend les 8 premiers bits de hachage comme somme de contrôle. L’ajout de cette somme de contrôle produit 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "Les 264 bits sont répartis en 24 groupes de 11 bits. Chaque groupe sélectionne 1 entrée dans la liste BIP-39 standard de 2 048 mots, produisant ainsi la phrase de récupération de 24 mots.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core dérive des comptes et des adresses déterministes à partir de la graine obtenue. La même phrase de récupération et la même phrase secrète facultative recréeront toujours le même portefeuille.";
"onboarding.entropy.learn_more.security.section" = "Comment l’entropie personnalisée renforce la sécurité";
"onboarding.entropy.learn_more.security.space.title" = "Un immense espace de possibilités";
"onboarding.entropy.learn_more.security.space.detail" = "Une entropie uniforme de 256 bits contient 2^256 valeurs uniques, ce qui rend toute recherche exhaustive irréalisable en pratique. Cette valeur décrit la taille de l’espace d’entrée ; elle ne signifie pas que chaque composant cryptographique résiste à une attaque de 256 bits.";
"onboarding.entropy.learn_more.security.source.title" = "Le hasard que vous fournissez";
"onboarding.entropy.learn_more.security.source.detail" = "Les événements physiques vous permettent de produire vous-même la source aléatoire du portefeuille au lieu de dépendre uniquement du générateur de nombres aléatoires d’un appareil. La sécurité n’est renforcée que si ces événements sont réellement aléatoires.";
"onboarding.entropy.learn_more.security.local.title" = "Traitement intégral sur cet appareil";
"onboarding.entropy.learn_more.security.local.detail" = "Oath convertit votre séquence et crée la phrase de récupération entièrement sur cet appareil. Votre séquence n’est jamais envoyée ailleurs pour être traitée.";
"onboarding.entropy.learn_more.security.patterns.title" = "Éviter les secrets choisis par une personne";
"onboarding.entropy.learn_more.security.patterns.detail" = "Une longue séquence d’événements équilibrés et indépendants est bien moins prévisible qu’une date de naissance, un nombre favori, un motif répété ou des mots choisis par une personne.";
"onboarding.entropy.learn_more.security.footer" = "L’entropie physique remplace la source aléatoire du portefeuille générée par l’appareil ; ce n’est ni un mot de passe supplémentaire ni une couche de sécurité additionnelle.";
"onboarding.entropy.learn_more.safety.section" = "Utiliser cette fonction en toute sécurité";
"onboarding.entropy.learn_more.safety.fair.title" = "Noter des résultats équilibrés et indépendants";
"onboarding.entropy.learn_more.safety.fair.detail" = "Utilisez une pièce ou un dé équilibré et veillez à ce que chaque résultat soit indépendant. Les chiffres aléatoires doivent provenir d’une véritable source physique, jamais de votre mémoire ni d’un motif.";
"onboarding.entropy.learn_more.safety.private.title" = "Gardez l’ensemble du processus privé";
"onboarding.entropy.learn_more.safety.private.detail" = "Protégez la séquence enregistrée et la phrase de récupération finale comme des secrets du portefeuille. Gardez-les hors de vue des caméras et des autres personnes.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Enregistrez chaque résultat avec précision";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Un seul résultat manquant, dupliqué ou déplacé crée un portefeuille différent. Vérifiez chaque saisie et la phrase de récupération finale avant d’approvisionner le portefeuille.";
"onboarding.entropy.learn_more.safety.backup.title" = "Protégez la phrase de récupération";
"onboarding.entropy.learn_more.safety.backup.detail" = "Stockez la phrase de récupération hors ligne et ne la partagez jamais. Après avoir vérifié la sauvegarde, détruisez en toute sécurité tout enregistrement d’entrée intermédiaire dont vous n’avez plus besoin.";
"onboarding.entropy.learn_more.safety.footer" = "L’entropie physique ne protège ni une phrase de récupération exposée, ni un appareil compromis, ni un logiciel malveillant, ni une séquence mal notée. Si vous ne pouvez pas garantir des saisies équilibrées, confidentielles et exactes, utilisez la création standard d’un portefeuille.";
"onboarding.carousel.open_source.eyebrow" = "OPEN SOURCE PAR CONCEPTION";
"onboarding.carousel.open_source.title" = "Inspectez le code source. Vérifiez la compilation.";
"onboarding.carousel.open_source.message" = "Oath publie son code source afin qu’il puisse être inspecté indépendamment. Une version n’est vérifiée que si une compilation reproductible correspond à l’empreinte de l’app publiée.";
"onboarding.carousel.open_source.action.github" = "Examiner sur GitHub";
"onboarding.carousel.open_source.visual.repository" = "Dépôt public de code source";
"onboarding.carousel.open_source.visual.repository.path" = "Voir github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Inspecter le code source";
"onboarding.carousel.open_source.visual.rebuild" = "Reproduire la compilation publiée";
"onboarding.carousel.open_source.visual.compare" = "Comparer les artefacts de compilation";
"onboarding.carousel.open_source.visual.fingerprint" = "Empreinte de la version de production";
"onboarding.carousel.open_source.visual.match" = "EMPREINTE IDENTIQUE — COMPILATION VÉRIFIÉE";
"onboarding.carousel.open_source.visual.accessibility" = "Un diagramme montrant que le code source public, une reconstruction indépendante de l’application et des empreintes numériques correspondantes sont nécessaires pour vérifier une version logicielle.";
"onboarding.carousel.passphrase.eyebrow" = "PHRASE SECRÈTE BIP-39 FACULTATIVE";
"onboarding.carousel.passphrase.title" = "Une phrase de récupération. Un secret supplémentaire.";
"onboarding.carousel.passphrase.message" = "Une phrase secrète BIP-39 se combine avec votre phrase de récupération pour créer un portefeuille distinct. Même si les mots de récupération sont exposés, l’accès à ce portefeuille exige toujours la phrase secrète exacte.";
"onboarding.carousel.passphrase.visual.phrase" = "24 mots de récupération";
"onboarding.carousel.passphrase.visual.passphrase" = "Votre phrase secrète supplémentaire";
"onboarding.carousel.passphrase.visual.output" = "Un portefeuille distinct protégé par phrase secrète";
"onboarding.carousel.passphrase.visual.requirement" = "Les deux secrets sont requis pour la récupération";
"onboarding.carousel.passphrase.visual.accessibility" = "Une phrase de récupération de 24 mots se combine avec une phrase secrète BIP-39 pour créer un portefeuille distinct qui nécessite les deux secrets pour la récupération.";
"onboarding.carousel.passphrase.learn_more.action" = "Découvrir les détails";
"onboarding.passphrase.learn_more.navigation" = "Comprendre les phrases secrètes BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Deux secrets pour dériver un portefeuille";
"onboarding.passphrase.learn_more.overview" = "Une phrase secrète BIP-39 est un secret facultatif utilisé avec la phrase de récupération. La paire crée de manière déterministe un portefeuille différent du portefeuille créé par la seule phrase de récupération.";
"onboarding.passphrase.learn_more.visual.phrase" = "Phrase de récupération de 24 mots";
"onboarding.passphrase.learn_more.visual.passphrase" = "Phrase secrète";
"onboarding.passphrase.learn_more.visual.wallet" = "Portefeuille protégé par phrase secrète";
"onboarding.passphrase.learn_more.visual.accessibility" = "Une phrase de récupération de 24 mots et une phrase secrète se combinent pour créer un portefeuille protégé par une phrase secrète.";
"onboarding.passphrase.learn_more.derivation.section" = "Comment BIP-39 dérive le portefeuille";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Phrase de récupération combinée à la phrase secrète";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2 048 tours";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Graine maîtresse de 512 bits";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Comptes et adresses dérivés du portefeuille";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "La phrase de récupération et la phrase secrète entrent dans PBKDF2-HMAC-SHA512 pendant 2 048 tours, produisant une graine de 512 bits à partir de laquelle les comptes et adresses de portefeuille sont dérivés.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 utilise la phrase de récupération normalisée comme mot de passe PBKDF2 et le mot « mnemonic » suivi de la phrase secrète normalisée comme sel. PBKDF2-HMAC-SHA512 fonctionne pendant 2 048 tours et produit une graine de 64 octets.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Oath applique la normalisation Unicode exigée par BIP-39 avant la dérivation afin que la même phrase de récupération normalisée et la même phrase secrète reproduisent toujours le même portefeuille.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Une phrase secrète ne chiffre pas vos mots de récupération. Elle modifie la graine dérivée : chaque phrase secrète différente produit donc des comptes et des adresses différents.";
"onboarding.passphrase.learn_more.wallets.section" = "Chaque phrase secrète dérive un portefeuille distinct";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Exemple de phrase secrète 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Exemple de phrase secrète 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Exemple de portefeuille A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Exemple de portefeuille B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "La même phrase de récupération avec deux phrases secrètes différentes crée le portefeuille A et le portefeuille B.";
"onboarding.passphrase.learn_more.wallets.different" = "Changer ne serait-ce qu’un seul caractère significatif entraîne une graine différente et donc un portefeuille différent. Le portefeuille d’origine reste inchangé.";
"onboarding.passphrase.learn_more.wallets.empty" = "Une phrase secrète vide ouvre le portefeuille standard dérivé de la seule phrase de récupération. Une phrase secrète non vide ouvre son propre portefeuille séparé.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 n’a pas de réponse « mauvais mot de passe ». Chaque phrase secrète est valide, donc une faute de frappe ouvre silencieusement un autre portefeuille, généralement avec un solde nul.";
"onboarding.passphrase.learn_more.security.section" = "Comment une phrase secrète renforce la protection";
"onboarding.passphrase.learn_more.security.words.title" = "Les mots de récupération ne suffisent pas";
"onboarding.passphrase.learn_more.security.words.detail" = "Si quelqu’un obtient uniquement la phrase de récupération, il a toujours besoin de la phrase secrète exacte pour dériver et accéder au portefeuille protégé.";
"onboarding.passphrase.learn_more.security.strength.title" = "La sécurité vient de la force";
"onboarding.passphrase.learn_more.security.strength.detail" = "Une phrase secrète longue et imprévisible ajoute une difficulté significative à deviner. Une courte citation, une date de naissance, un nom ou un mot de passe réutilisé peuvent être devinés rapidement et n’offrent que peu de protection.";
"onboarding.passphrase.learn_more.security.separation.title" = "Conserver la phrase secrète séparément";
"onboarding.passphrase.learn_more.security.separation.detail" = "Conservez la phrase secrète séparément de la phrase de récupération afin qu’une sauvegarde volée ne révèle pas les deux secrets nécessaires à la restauration du portefeuille.";
"onboarding.passphrase.learn_more.security.footer" = "Une phrase secrète ne peut pas protéger les fonds lorsque les deux secrets sont exposés, lorsque la phrase secrète est faible ou lorsqu’un logiciel compromis la capture lors de la saisie.";
"onboarding.passphrase.learn_more.safety.section" = "Utiliser cette fonction en toute sécurité";
"onboarding.passphrase.learn_more.safety.strong.title" = "Choisissez une phrase secrète forte et unique";
