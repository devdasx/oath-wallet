"onboarding.carousel.entropy.visual.accessibility" = "Egy számozott dobókocka, egy érme és véletlen számjegyek együttesen 256 bitnyi tárcaentrópiát hoznak létre ezen az eszközön.";
"onboarding.carousel.entropy.learn_more.action" = "További részletek";
"onboarding.entropy.learn_more.navigation" = "A fizikai entrópia működése";
"onboarding.entropy.learn_more.path.section" = "A fizikai eredményektől a helyreállítási szavakig";
"onboarding.entropy.learn_more.overview" = "Az Oath rögzíti a kiválasztott fizikai forrás eredményeit, és 256 bites értékké alakítja őket. Az így kapott 32 bájtot ezután átadja a Wallet Core-nak, amely szabványos BIP-39 helyreállítási kifejezést hoz létre.";
"onboarding.entropy.learn_more.visual.phrase" = "Egy 24 szavas BIP-39 helyreállítási kifejezés";
"onboarding.entropy.learn_more.visual.bits" = "32 bájt × 8 bit = 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "256 bitet szemléltető, 32 bájtba rendezett rács.";
"onboarding.entropy.learn_more.visual.accessibility" = "A kockadobások, érmefeldobások vagy véletlen számjegyek 256 bitté, majd egy 24 szavas BIP-39 helyreállítási kifejezéssé alakulnak.";
"onboarding.entropy.learn_more.inputs.section" = "1. lépés: Fizikai eredmények rögzítése";
"onboarding.entropy.learn_more.inputs.dice.title" = "Szabályos hatoldalú kocka dobása";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Szabályos kocka esetén az 1–4 oldalak mindegyike 2 bitet, az 5–6 oldalak mindegyike 1 bitet ad hozzá.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fizikai érmefeldobások";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Egy szabályos érme minden független feldobása 1 torzítatlan entrópiabitet ad hozzá.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Véletlen számjegyek rögzítése";
"onboarding.entropy.learn_more.inputs.digits.detail" = "A 0–7 számjegyek mindegyike 3 bitet, a 8–9 számjegyek mindegyike 1 bitet ad hozzá. A számjegyeknek valóban véletlenszerű fizikai folyamatból kell származniuk.";
"onboarding.entropy.learn_more.inputs.footer" = "Használjon torzítatlan fizikai forrást, és minden eredményt sorrendben rögzítsen. A beviteli módok között válthat, mert minden elfogadott eredmény ugyanahhoz a bitfolyamhoz járul hozzá.";
"onboarding.entropy.learn_more.conversion.section" = "2. Egy 256 bites érték összeállítása";
"onboarding.entropy.learn_more.conversion.mapping" = "Az Oath a kockaeredményeket és a decimális számjegyeket torzítatlan, kettőhatvány méretű csoportokká alakítja. A hozzájárulások hossza eltérhet, de szabályos fizikai forrás esetén egyik bitérték sem lesz valószínűbb a másiknál.";
"onboarding.entropy.learn_more.conversion.packing" = "Az Oath a megadás sorrendjében fűzi egymáshoz a biteket, amíg pontosan 256 bitet nem gyűjt össze, majd 32 bájtba csomagolja őket, a legmagasabb helyi értékű bittel kezdve.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Az egyéni entrópia kizárólag a rögzített fizikai bemeneteket tartalmazza; az Oath nem kever hozzá eszköz által létrehozott véletlenszerűséget.";
"onboarding.entropy.learn_more.bip39.section" = "3. A helyreállítási kifejezés származtatása";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitnyi entrópia";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Egy 8 bites BIP-39 ellenőrző összeg";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit felosztása 24 darab, egyenként 11 bites szóindexre";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "A 256 bites entrópiaérték egy 8 bites ellenőrző összeget kap, így 264 bit keletkezik, amely 24 darab, egyenként 11 bites szóindexre oszlik.";
"onboarding.entropy.learn_more.bip39.checksum" = "A BIP-39 SHA-256 kivonatot számít a 32 bájtos entrópiaértékből, majd a kivonat első 8 bitjét használja ellenőrző összegként; ennek hozzáfűzésével 264 bit keletkezik.";
"onboarding.entropy.learn_more.bip39.words" = "A 264 bit 24 darab, egyenként 11 bites csoportra oszlik. Minden csoport kiválaszt egy bejegyzést a szabványos, 2048 szavas BIP-39 listából, így létrejön a 24 szavas helyreállítási kifejezés.";
"onboarding.entropy.learn_more.bip39.derivation" = "A Wallet Core determinisztikus fiókokat és címeket származtat az így kapott magból. Ugyanaz a helyreállítási kifejezés és opcionális jelmondat mindig ugyanazt a tárcát állítja helyre.";
"onboarding.entropy.learn_more.security.section" = "Így erősíti a biztonságot az egyéni entrópia";
"onboarding.entropy.learn_more.security.space.title" = "Hatalmas lehetőségtér";
"onboarding.entropy.learn_more.security.space.detail" = "Az egyenletes 256 bites entrópia 2^256 egyedi értéket tartalmaz, ezért az összes lehetőség végigpróbálása számítási szempontból megvalósíthatatlan. Ez a bemeneti tér méretét írja le; nem jelenti azt, hogy minden kriptográfiai összetevő 256 bites támadási ellenállást nyújt.";
"onboarding.entropy.learn_more.security.source.title" = "A véletlenszerűség Öntől származik";
"onboarding.entropy.learn_more.security.source.detail" = "A fizikai eseményekkel a tárca véletlenszerűsége független forrásból származhat, nem kizárólag az eszköz véletlenszám-generátorából. Ez csak akkor növeli a biztonságot, ha az események valóban véletlenszerűek.";
"onboarding.entropy.learn_more.security.local.title" = "Teljes feldolgozás ezen az eszközön";
"onboarding.entropy.learn_more.security.local.detail" = "Az Oath teljes egészében ezen az eszközön alakítja át a rögzített sorozatot, és itt hozza létre a helyreállítási kifejezést. A sorozatot soha nem tölti fel feldolgozásra.";
"onboarding.entropy.learn_more.security.patterns.title" = "Kerülje az ember által választott titkokat";
"onboarding.entropy.learn_more.security.patterns.detail" = "A torzítatlan, független események hosszú sorozata jóval kevésbé kiszámítható, mint a születésnapok, kedvenc számok, ismétlődő minták vagy egy ember által kiválasztott szavak.";
"onboarding.entropy.learn_more.security.footer" = "A fizikai entrópia a tárcához használt, eszköz által létrehozott véletlenszerűséget helyettesíti; nem jelent további jelszót vagy biztonsági réteget.";
"onboarding.entropy.learn_more.safety.section" = "A funkció biztonságos használata";
"onboarding.entropy.learn_more.safety.fair.title" = "Torzítatlan, független eredmények rögzítése";
"onboarding.entropy.learn_more.safety.fair.detail" = "Használjon szabályos érmét vagy kockát, és gondoskodjon róla, hogy minden eredmény független legyen. A véletlen számjegyeknek valódi fizikai forrásból kell származniuk, nem emlékezetből vagy valamilyen mintából.";
"onboarding.entropy.learn_more.safety.private.title" = "Tartsa titokban az entrópia létrehozásának folyamatát";
"onboarding.entropy.learn_more.safety.private.detail" = "A rögzített sorozatot és az elkészült helyreállítási kifejezést egyaránt kezelje titkos tárcaadatként. Óvja őket kamerák és más személyek tekintete elől.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Minden eredményt pontosan rögzítsen";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Már egy hiányzó, megkettőzött vagy átrendezett eredmény is másik tárcát hoz létre. Ellenőrizzen minden bejegyzést és a kész helyreállítási kifejezést, mielőtt eszközöket helyezne a tárcába.";
"onboarding.entropy.learn_more.safety.backup.title" = "Helyezze biztonságba a helyreállítási kifejezést";
"onboarding.entropy.learn_more.safety.backup.detail" = "Tartsa offline a helyreállítási kifejezést, és soha ne ossza meg. A biztonsági másolat ellenőrzése után biztonságosan semmisítsen meg minden feleslegessé vált köztes bemeneti feljegyzést.";
"onboarding.entropy.learn_more.safety.footer" = "A fizikai entrópia nem nyújt védelmet egy nyilvánosságra került helyreállítási kifejezés, feltört eszköz, kártékony szoftver vagy hibásan rögzített sorozat ellen. Ha nem tudja garantálni a torzítatlan, titkos és pontos bevitelt, válassza inkább a szabványos tárcalétrehozást.";
"onboarding.carousel.open_source.eyebrow" = "NYÍLT FORRÁSKÓDÚNAK TERVEZVE";
