"onboarding.passphrase.learn_more.visual.wallet" = "Jelmondattal védett tárca";
"onboarding.passphrase.learn_more.visual.accessibility" = "Egy 24 szavas helyreállítási kifejezés és egy titkos jelmondat együttesen különálló, jelmondattal védett tárcát származtat.";
"onboarding.passphrase.learn_more.derivation.section" = "Így származtatja a BIP-39 a tárcát";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Helyreállítási kifejezés jelmondattal kombinálva";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512, 2048 kör";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512 bites főmag";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Származtatott tárcafiókok és -címek";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "A PBKDF2-HMAC-SHA512 2048 körben dolgozza fel a helyreállítási kifejezést és a jelmondatot, így létrehozza az 512 bites magot, amelyből a tárcafiókok és -címek származnak.";
"onboarding.passphrase.learn_more.derivation.standard" = "A BIP-39 a normalizált helyreállítási kifejezést használja PBKDF2-jelszóként, sóként pedig a „mnemonic” szót és az azt követő normalizált jelmondatot. A PBKDF2-HMAC-SHA512 2048 köre után a folyamat egy 64 bájtos magot állít elő.";
"onboarding.passphrase.learn_more.derivation.normalization" = "A mag származtatása előtt az Oath elvégzi a BIP-39 által előírt Unicode-normalizálást, így ugyanaz a normalizált helyreállítási kifejezés és jelmondat mindig ugyanazt a tárcát állítja helyre.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "A jelmondat nem titkosítja a helyreállítási szavakat. A származtatott magot módosítja, ezért minden eltérő jelmondat eltérő fiókokat és címeket eredményez.";
"onboarding.passphrase.learn_more.wallets.section" = "Minden jelmondat külön tárcát származtat";
"onboarding.passphrase.learn_more.wallets.visual.one" = "1. példajelmondat";
"onboarding.passphrase.learn_more.wallets.visual.two" = "2. példajelmondat";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "A jelű példatárca";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "B jelű példatárca";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Ugyanaz a helyreállítási kifejezés két különböző jelmondattal két különálló tárcát származtat: az A és a B tárcát.";
"onboarding.passphrase.learn_more.wallets.different" = "Akár egyetlen érdemi karakter megváltoztatása is eltérő magot, így eltérő tárcát származtat; az eredeti tárca változatlan marad.";
"onboarding.passphrase.learn_more.wallets.empty" = "Az üres jelmondat a kizárólag a helyreállítási kifejezésből származtatott szabványos tárcát nyitja meg; egy nem üres jelmondat a saját, különálló tárcáját nyitja meg.";
"onboarding.passphrase.learn_more.wallets.footer" = "A BIP-39 nem jelez „hibás jelmondatot”; minden jelmondat érvényes, ezért egy elírás észrevétlenül másik tárcát nyit meg, amelynek egyenlege rendszerint nulla.";
"onboarding.passphrase.learn_more.security.section" = "Így nyújt további védelmet a jelmondat";
"onboarding.passphrase.learn_more.security.words.title" = "A helyreállítási szavak önmagukban nem elegendők";
"onboarding.passphrase.learn_more.security.words.detail" = "Aki csak a helyreállítási kifejezést szerzi meg, annak a védett tárca származtatásához és eléréséhez továbbra is szüksége van a pontos jelmondatra.";
"onboarding.passphrase.learn_more.security.strength.title" = "Az erős jelmondat jobb elkülönítést biztosít";
"onboarding.passphrase.learn_more.security.strength.detail" = "Egy hosszú, kiszámíthatatlan jelmondat érdemben megnehezíti a találgatást; egy rövid idézet, születésnap, név vagy máshol is használt jelszó gyorsan kitalálható, és alig nyújt védelmet.";
"onboarding.passphrase.learn_more.security.separation.title" = "Tartsa külön a jelmondatot";
"onboarding.passphrase.learn_more.security.separation.detail" = "A jelmondatot a helyreállítási kifejezéstől elkülönítve tárolja, hogy egyetlen ellopott biztonsági másolat ne fedje fel a tárca helyreállításához szükséges mindkét titkot.";
"onboarding.passphrase.learn_more.security.footer" = "A jelmondat nem védi meg az eszközeit, ha mindkét titok nyilvánosságra kerül, a jelmondat gyenge, vagy egy feltört szoftver rögzíti gépelés közben.";
"onboarding.passphrase.learn_more.safety.section" = "A funkció biztonságos használata";
"onboarding.passphrase.learn_more.safety.strong.title" = "Hozzon létre erős, egyedi jelmondatot";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Válasszon több véletlen szót vagy más, nagy entrópiájú értéket, amelyet kizárólag ehhez a tárcához használ. Kerülje a személyes adatokat, ismert kifejezéseket, mintákat és a máshol használt jelszavakat.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Készítsen külön biztonsági másolatot a jelmondatról";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Készítsen tartós offline másolatot a pontos jelmondatról, tárolja a helyreállítási kifejezéstől elkülönítve, és soha ne hagyatkozzon kizárólag az emlékezetére.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Minden karakter megváltoztatja a tárcát";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Pontosan az eredeti formájában adja meg újra a jelmondatot, minden nagybetűvel, szóközzel, írásjellel és szóval együtt. Bármilyen eltérés észrevétlenül másik tárcát származtat.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Eszközök fogadása előtt ellenőrizze a helyreállítást";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Jelentős érték fogadása előtt zárt, ellenőrzött körülmények között végezzen helyreállítási próbát annak igazolására, hogy a helyreállítási kifejezés és a jelmondat a várt címeket hozza létre újra.";
"onboarding.passphrase.learn_more.safety.footer" = "Egyetlen szolgáltatás sem tudja visszaállítani vagy helyreállítani az elveszett jelmondatot. A pontos jelmondat nélkül a tárcához való hozzáférés végleg elvész, akkor is, ha a helyreállítási kifejezés még megvan.";
