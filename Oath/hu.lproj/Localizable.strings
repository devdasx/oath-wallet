// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "A megerősítő gombot csúsztatásos küldés váltja fel. Irányjelző animáció, haptika és simább mozgás támogatja mindkét olvasási irányt. Küldéshez engedje el legalább 90%-nál; visszahúzással megszakíthatja.";
"settings.about.history.v355.build56.activity" = "A harang megnyitja a függőben lévő tevékenységeket. A tranzakciókapszulák állapotjelvényt mutatnak, és elsöpörhetők. A megerősítésre váró és megerősített kapszulák 3 másodperc után eltűnnek; a megerősítés ugyanazt a látható kapszulát frissíti.";
"settings.about.history.v355.build56.status" = "Megbízhatóbb tranzakcióállapot minden támogatott hálózaton, élő tranzakciórészletek és gyorsabb egyenlegfrissítés küldés után. A függő tranzakciók követése az app újranyitásakor folytatódik.";
"settings.about.history.v355.build56.fees" = "Ugyanazon átutalás ellenőrzéséhez visszatérve megmarad a már lekért díj. Egyértelműbb díjbetöltés és számlafeltöltési figyelmeztetések; megfelelő összegnél már nincs aktiválási tájékoztató.";
"settings.about.history.v355.build56.dust" = "A Bitcoin Cash, Bitcoin, Litecoin és Dogecoin a porküszöb alatti visszajárót a díjhoz adja használhatatlan kimenet létrehozása helyett. Az ellenőrzött díj megegyezik az aláíráskor használttal.";
"settings.about.history.v355.build56.stability" = "Javítottunk egy háttérfeladat-összeomlást és a tárcafrissítés időtúllépési riasztásait. Átmeneti frissítési hibáknál a meglévő tárcaadatok elérhetők maradnak.";
"settings.about.history.v355.build56.backup" = "Áttekinthetőbb biztonságimásolat-képernyők, azonnal helyes címmel és kevesebb üzenettel. A privát kulcsok elérése követi az appzár beállításait. A kompakt, üvegszerű importfigyelmeztetések másik helyreállítási kifejezés választásakor törlik az elutasított bevitelt.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "A küldési csúszka elengedése után animált pipa jelenik meg, mielőtt az ellenőrzőképernyő bezárul.";
"settings.about.history.v355.build57.activity" = "A tevékenységsorok vékonyabb betűkkel mutatják az állapotot, alcímként az összeget, a tranzakció részleteit pedig egy nyíllal lehet megnyitni.";
"settings.about.history.v355.build57.details" = "A hálózati díjak most az átutalás összesítésében szerepelnek. A rövidebb címkék és az egyetlen hálózati sor áttekinthetőbbé teszik a részleteket.";
"settings.about.history.v355.build57.resume" = "A háttérből visszatérve megmaradnak a nyitott képernyők és panelek, köztük az átutalás ellenőrzése és a tranzakció részletei.";
"settings.about.history.v355.build57.secrets" = "A helyreállítási kifejezést, privát kulcsot vagy jelmondatot tartalmazó képernyők 20 másodperc távollét után bezárulnak. Az alkalmazászár továbbra is a beállításait követi.";
"settings.about.history.v355.build57.filters" = "A hálózatszűrők kissé magasabb natív gombokat, tartalomhoz igazodó méretezést és javított térközt használnak a navigációs sáv alatt.";
"settings.about.history.v355.build57.units" = "A külön értéksorok megszűntek. Az összeg és a hálózati díj először helyi pénznemben jelenik meg; érintéssel kriptoegységekre válthat, majd vissza.";
"wallet.transaction.details.toggle_units" = "Mértékegység váltása.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "A kezdőképernyő áttűnés és méretváltozás nélkül nyílik meg. A Beállítások gombon most fogaskerékikon látható.";
"settings.about.history.v355.build58.fields" = "A tranzakciós és küldési mezők szokásos szövegszíneket használnak. Nyíl csak a képernyőt vagy panelt megnyitó soroknál jelenik meg; az összegekre és díjakra koppintva továbbra is váltható az egység.";
"settings.about.history.v355.build58.banners" = "A folyamatban lévő vagy befejezett megerősítés értesítései a megjelenésük után 3 másodperccel eltűnnek, akkor is, ha másik képernyőt nyit meg. A még meg nem jelenített megerősítések visszatéréskor láthatók.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "A TRON-átutalások most már a küldendő összeg kiszámítása előtt elkülönítik az aktiválási és sávszélességi díjakat, a maximális összeg küldésekor is. Az ellenőrző képernyő a díjak levonása utáni helyes összeget mutatja.";
"settings.about.history.v355.build59.fees" = "Az egyéni TRON-díjaknak fedezniük kell a szükséges hálózati költségeket. Alacsony TRX-egyenleg esetén mostantól világosabb útmutatás jelenik meg. A tokenmennyiség nem változik; a díjakat TRX-ben kell fizetni.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Új üdvözlet";
"settings.about.history.v356.welcome" = "Új üdvözlőképernyő animált grafikával, valamint egyértelmű lehetőségek a pénztárca létrehozására vagy importálására.";
"settings.about.history.v357.tour.title" = "Üdvözlő bemutató";
"settings.about.history.v357.tour" = "Egy ötoldalas bemutató ismerteti a támogatott hálózatokat, a fizikai entrópiát, a küldést és fogadást, a biztonságot és az ellenőrzött buildeket. Lapozáshoz pöccints vagy koppints a pontokra; a nyelvváltó a navigációs sávban található.";
"settings.about.history.v357.backup" = "Tárca létrehozása, importálása vagy visszaállítása után a képernyő azonnal megjelenik, a mentési lehetőségek pedig a szokásos listát használják. Az iCloud-ellenőrzés a háttérben fut, és a Tárca megnyitása kész, amint a tárca mentésre került.";
"settings.about.history.v357.reliability" = "A háttérből visszatérve már nem záródik be a beállítási képernyő, ha egy rejtett helyreállítási képernyő lejár, és az összes adat törlése közvetlenül az üdvözlő képernyőt nyitja meg.";
"settings.about.history.v357.notifications" = "Az értesítési beállítások egyszerűbb megfogalmazást használnak a kategóriákhoz és az állapothoz, technikai részletek nélkül.";
"settings.about.history.v357.wallets" = "Rendezd át a tárcákat a váltóban hosszú nyomással, a rendszer emelő animációjával; egy sorra koppintva aktiválod azt. A helyreállítási kifejezés ellenőrzése számozza a szavakat, a Return pedig a következő mezőre lép.";
"settings.about.history.v357.send" = "A küldés az átutalás alatt mutatja az összeget, világosabb üzenet jelenik meg, ha nem küldhető el, a TRON-kérések pedig átmeneti szolgáltatói hibák után automatikusan újrapróbálkoznak.";
"settings.about.history.v357.security" = "Az importált TRON-fiókok, amelyek tulajdonosi engedélye másik kulcsra került, mostantól figyelmeztetést mutatnak és nem tudnak küldeni, még ha minden engedély csak egy kulcsot sorol is fel. Több ismert, kiszivárgott helyreállítási kifejezést és privát kulcsot utasít el az importálás.";
"settings.about.history.v356.localization" = "Az üdvözlőképernyő szövege minden támogatott nyelven természetesebb és érthetőbb lett.";
"settings.about.history.v356.pricing" = "A token árak mostantól pontosan megegyeznek a hálózattal és a token címmel, először a DEX-árakat használva. A kis árak 8 tizedesjegyig jelennek meg kerekítés nélkül.";
"settings.about.history.v356.appearance" = "Az elsődleges és másodlagos gombok mostantól egységes magasságot és képernyő margót használnak, a rendszer kék színnel pedig az elsődleges műveletekhez.";
"settings.about.history.v356.transactions" = "A tranzakció részletei rövidebb Megerősített állapotot és világosabb szürke szöveget használnak a dátumokhoz, címekhez, összegekhez és tranzakcióazonosítókhoz.";
"settings.about.history.v356.security" = "Kibővítette az ismert, nyilvánosságra hozott helyreállítási kifejezések és privát kulcsok listáját, amelyek nem importálhatók.";

