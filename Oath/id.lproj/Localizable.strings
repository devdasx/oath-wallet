"onboarding.carousel.entropy.eyebrow" = "ENTROPI DARI MASUKAN FISIK";
"onboarding.carousel.entropy.title" = "Ciptakan Keacakan yang Sepenuhnya Anda Kendalikan.";
"onboarding.carousel.entropy.message" = "Lempar dadu, lempar koin, atau catat digit acak. Oath mengubah masukan fisik Anda menjadi tepat 256 bit entropi untuk frasa pemulihan 24 kata, seluruhnya di perangkat Anda.";
"onboarding.carousel.entropy.visual.output" = "256 Bit Entropi Buatan Anda";
"onboarding.carousel.entropy.visual.local" = "Dihasilkan Sepenuhnya dari Masukan yang Anda Catat";
"onboarding.carousel.entropy.visual.accessibility" = "Dadu bernomor, koin, dan digit acak digabungkan untuk menghasilkan 256 bit entropi dompet di perangkat ini.";
"onboarding.carousel.entropy.learn_more.action" = "Jelajahi Detail Selengkapnya";
"onboarding.entropy.learn_more.navigation" = "Cara Kerja Entropi Fisik";
"onboarding.entropy.learn_more.path.section" = "Dari Hasil Fisik hingga Kata Pemulihan";
"onboarding.entropy.learn_more.overview" = "Oath mencatat hasil dari sumber fisik pilihan Anda dan mengubahnya menjadi nilai 256 bit. Sebanyak 32 byte yang dihasilkan kemudian diteruskan ke Wallet Core untuk membuat frasa pemulihan BIP-39 standar.";
"onboarding.entropy.learn_more.visual.phrase" = "Frasa Pemulihan BIP-39 24 Kata";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit sama dengan 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Kisi berisi 256 sel bit contoh yang disusun menjadi 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Lemparan dadu, lemparan koin, atau digit acak diubah menjadi 256 bit, lalu menjadi frasa pemulihan BIP-39 24 kata.";
"onboarding.entropy.learn_more.inputs.section" = "Langkah 1: Catat Hasil Fisik";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lempar Dadu Enam Sisi yang Seimbang";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Dengan dadu yang seimbang, sisi 1–4 masing-masing menyumbangkan 2 bit; sisi 5–6 masing-masing menyumbangkan 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lemparan Koin Fisik";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Setiap lemparan koin yang seimbang dan independen menyumbangkan satu bit entropi tanpa bias.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Catat Digit Acak";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Digit 0–7 masing-masing menyumbangkan 3 bit; digit 8–9 masing-masing menyumbangkan 1 bit. Digit tersebut harus berasal dari proses fisik yang benar-benar acak.";
"onboarding.entropy.learn_more.inputs.footer" = "Gunakan sumber fisik yang seimbang dan catat setiap hasil secara berurutan. Anda boleh beralih metode masukan karena setiap hasil yang diterima berkontribusi pada aliran bit yang sama.";
"onboarding.entropy.learn_more.conversion.section" = "2. Susun Nilai 256 Bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath mengubah hasil dadu dan digit desimal menjadi kelompok berpangkat dua tanpa bias. Panjang kontribusi dapat bervariasi, tetapi sumber fisik yang seimbang tidak mengutamakan nilai bit apa pun.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath menambahkan bit sesuai urutan masukan hingga terkumpul tepat 256 bit, lalu mengemasnya menjadi 32 byte dengan bit paling signifikan terlebih dahulu.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropi khusus hanya berisi masukan fisik yang Anda catat; Oath tidak mencampurkan keacakan yang dihasilkan perangkat.";
"onboarding.entropy.learn_more.bip39.section" = "3. Turunkan Frasa Pemulihan";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 Bit Entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Checksum BIP-39 8 Bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit dibagi menjadi 24 indeks kata 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Nilai entropi 256-bit ditambah checksum 8-bit menghasilkan 264 bit, yang dibagi menjadi 24 indeks kata yang masing-masing 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 menghitung SHA-256 atas nilai entropi 32 byte dan mengambil 8 bit hash pertama sebagai checksum; penambahan checksum tersebut menghasilkan 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "Sebanyak 264 bit dibagi menjadi 24 kelompok yang masing-masing terdiri dari 11 bit. Setiap kelompok memilih satu entri dari daftar standar BIP-39 berisi 2.048 kata untuk menghasilkan frasa pemulihan 24 kata.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core menurunkan akun dan alamat deterministik dari seed yang dihasilkan. Frasa pemulihan dan frasa sandi opsional yang sama akan selalu membuat ulang dompet yang sama.";
"onboarding.entropy.learn_more.security.section" = "Cara Entropi Khusus Memperkuat Keamanan";
"onboarding.entropy.learn_more.security.space.title" = "Ruang Kemungkinan yang Sangat Besar";
"onboarding.entropy.learn_more.security.space.detail" = "Entropi 256 bit yang seragam berisi 2^256 nilai unik sehingga penebakan menyeluruh tidak layak secara komputasi. Ini menjelaskan ukuran ruang masukan; bukan berarti setiap komponen kriptografi memberikan ketahanan serangan 256 bit.";
"onboarding.entropy.learn_more.security.source.title" = "Keacakan Berasal dari Anda";
"onboarding.entropy.learn_more.security.source.detail" = "Peristiwa fisik memungkinkan Anda memperoleh keacakan dompet secara mandiri, bukan hanya mengandalkan generator angka acak perangkat. Keamanan hanya meningkat jika peristiwa tersebut benar-benar acak.";
"onboarding.entropy.learn_more.security.local.title" = "Diproses Sepenuhnya di Perangkat Ini";
"onboarding.entropy.learn_more.security.local.detail" = "Oath mengonversi urutan yang Anda catat dan membuat frasa pemulihan sepenuhnya di perangkat ini. Urutan Anda tidak pernah diunggah untuk diproses.";
"onboarding.entropy.learn_more.security.patterns.title" = "Hindari Rahasia Buatan Manusia";
"onboarding.entropy.learn_more.security.patterns.detail" = "Urutan panjang dari peristiwa yang seimbang dan independen jauh lebih sulit diprediksi daripada tanggal lahir, angka favorit, pola berulang, atau kata pilihan seseorang.";
"onboarding.entropy.learn_more.security.footer" = "Entropi fisik menggantikan keacakan dompet yang dihasilkan perangkat; entropi ini bukan kata sandi tambahan atau lapisan keamanan lain.";
"onboarding.entropy.learn_more.safety.section" = "Gunakan Fitur Ini dengan Aman";
"onboarding.entropy.learn_more.safety.fair.title" = "Catat Hasil yang Seimbang dan Independen";
"onboarding.entropy.learn_more.safety.fair.detail" = "Gunakan koin atau dadu yang seimbang dan pastikan setiap hasil bersifat independen. Digit acak harus berasal dari sumber fisik yang benar-benar acak, bukan dari ingatan atau pola.";
"onboarding.entropy.learn_more.safety.private.title" = "Jaga Kerahasiaan Proses Entropi Anda";
"onboarding.entropy.learn_more.safety.private.detail" = "Lindungi urutan yang dicatat dan frasa pemulihan yang telah selesai sebagai rahasia dompet. Jauhkan keduanya dari pandangan kamera dan orang lain.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Catat Setiap Hasil dengan Tepat";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Satu hasil yang hilang, terduplikasi, atau berubah urutan akan membuat dompet berbeda. Periksa setiap entri dan verifikasi frasa pemulihan yang telah selesai sebelum menambahkan dana ke dompet.";
"onboarding.entropy.learn_more.safety.backup.title" = "Amankan Frasa Pemulihan";
"onboarding.entropy.learn_more.safety.backup.detail" = "Simpan frasa pemulihan secara offline dan jangan pernah membagikannya. Setelah memverifikasi cadangan, hancurkan dengan aman semua catatan masukan perantara yang tidak lagi Anda perlukan.";
"onboarding.entropy.learn_more.safety.footer" = "Entropi fisik tidak dapat mengamankan frasa pemulihan yang terekspos, perangkat yang disusupi, perangkat lunak berbahaya, atau urutan yang salah dicatat. Jika Anda tidak dapat menjamin masukan yang seimbang, rahasia, dan akurat, gunakan pembuatan dompet standar.";
"onboarding.carousel.open_source.eyebrow" = "DIRANCANG DENGAN SUMBER TERBUKA";
"onboarding.carousel.open_source.title" = "Periksa Sumbernya. Verifikasi Build-nya.";
"onboarding.carousel.open_source.message" = "Oath menerbitkan kode sumbernya agar dapat diperiksa secara independen. Rilis hanya terverifikasi jika build yang dapat direproduksi cocok dengan sidik jari aplikasi yang diterbitkan.";
"onboarding.carousel.open_source.action.github" = "Tinjau di GitHub";
"onboarding.carousel.open_source.visual.repository" = "Repositori Sumber Publik";
"onboarding.carousel.open_source.visual.repository.path" = "Lihat github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Tinjau Kode Sumber";
"onboarding.carousel.open_source.visual.rebuild" = "Reproduksi Build Rilis";
"onboarding.carousel.open_source.visual.compare" = "Bandingkan Artefak Build";
"onboarding.carousel.open_source.visual.fingerprint" = "Sidik Jari Rilis yang Diterbitkan";
"onboarding.carousel.open_source.visual.match" = "KECOCOKAN TERKONFIRMASI — BUILD TERVERIFIKASI";
"onboarding.carousel.open_source.visual.accessibility" = "Diagram yang menunjukkan bahwa verifikasi rilis memerlukan kode sumber publik, build ulang independen, dan sidik jari yang cocok.";
"onboarding.carousel.passphrase.eyebrow" = "FRASA SANDI BIP-39 OPSIONAL";
"onboarding.carousel.passphrase.title" = "Satu Frasa Pemulihan. Satu Rahasia Tambahan.";
"onboarding.carousel.passphrase.message" = "Frasa sandi BIP-39 digabungkan dengan frasa pemulihan Anda untuk menurunkan dompet terpisah. Meskipun kata pemulihan terekspos, dompet tersebut tetap memerlukan frasa sandi yang tepat untuk diakses.";
"onboarding.carousel.passphrase.visual.phrase" = "24 Kata Pemulihan Anda";
"onboarding.carousel.passphrase.visual.passphrase" = "Frasa Sandi Rahasia Tambahan Anda";
"onboarding.carousel.passphrase.visual.output" = "Dompet Terpisah dengan Frasa Sandi";
"onboarding.carousel.passphrase.visual.requirement" = "Kedua Rahasia Diperlukan untuk Pemulihan";
"onboarding.carousel.passphrase.visual.accessibility" = "Frasa pemulihan 24 kata digabungkan dengan frasa sandi rahasia BIP-39 untuk membuat dompet terpisah yang memerlukan kedua rahasia tersebut untuk pemulihan.";
"onboarding.carousel.passphrase.learn_more.action" = "Jelajahi Detail Selengkapnya";
"onboarding.passphrase.learn_more.navigation" = "Memahami Frasa Sandi BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dua Rahasia Menurunkan Satu Dompet";
"onboarding.passphrase.learn_more.overview" = "Frasa sandi BIP-39 adalah rahasia opsional yang digabungkan dengan frasa pemulihan Anda. Keduanya secara deterministik menurunkan dompet yang berbeda dari dompet yang dibuat hanya dengan frasa pemulihan.";
"onboarding.passphrase.learn_more.visual.phrase" = "Frasa Pemulihan 24 Kata Anda";
"onboarding.passphrase.learn_more.visual.passphrase" = "Frasa Sandi Rahasia Anda";
"onboarding.passphrase.learn_more.visual.wallet" = "Dompet yang Dilindungi Frasa Sandi";
"onboarding.passphrase.learn_more.visual.accessibility" = "Frasa pemulihan 24 kata dan frasa sandi rahasia digabungkan untuk menurunkan dompet terpisah yang dilindungi frasa sandi.";
"onboarding.passphrase.learn_more.derivation.section" = "Cara BIP-39 Menurunkan Dompet";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frasa Pemulihan yang Digabungkan dengan Frasa Sandi";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 dengan 2.048 Putaran";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Seed Utama 512 Bit";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Akun dan Alamat Dompet Turunan";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Frasa pemulihan dan frasa sandi Anda melewati 2.048 putaran PBKDF2-HMAC-SHA512 untuk menghasilkan seed 512 bit yang digunakan untuk menurunkan akun dan alamat dompet.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 memperlakukan frasa pemulihan yang dinormalisasi sebagai kata sandi PBKDF2 dan menggunakan “mnemonic” yang diikuti frasa sandi yang dinormalisasi sebagai salt. Setelah 2.048 putaran PBKDF2-HMAC-SHA512, proses ini menghasilkan seed 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Sebelum menurunkan seed, Oath menerapkan normalisasi Unicode yang diwajibkan BIP-39 sehingga frasa pemulihan dan frasa sandi ternormalisasi yang sama selalu menghasilkan kembali dompet yang sama.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Frasa sandi tidak mengenkripsi kata pemulihan Anda. Frasa sandi mengubah seed turunan sehingga setiap frasa sandi yang berbeda menghasilkan akun dan alamat yang berbeda.";
"onboarding.passphrase.learn_more.wallets.section" = "Setiap Frasa Sandi Menurunkan Dompet Terpisah";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Contoh Frasa Sandi 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Contoh Frasa Sandi 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Contoh Dompet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Contoh Dompet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Frasa pemulihan yang sama, ketika digabungkan dengan dua frasa sandi berbeda, menurunkan dua dompet terpisah: Dompet A dan Dompet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Mengubah satu karakter yang berpengaruh sekalipun akan menurunkan seed dan dompet yang berbeda; dompet asli tetap tidak berubah.";
"onboarding.passphrase.learn_more.wallets.empty" = "Frasa sandi kosong membuka dompet standar yang diturunkan hanya dari frasa pemulihan; frasa sandi yang terisi membuka dompet terpisahnya sendiri.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 tidak memiliki respons “frasa sandi salah”. Setiap frasa sandi valid, jadi salah ketik akan membuka dompet lain secara diam-diam—biasanya dengan saldo nol.";
"onboarding.passphrase.learn_more.security.section" = "Cara Frasa Sandi Menambah Perlindungan";
"onboarding.passphrase.learn_more.security.words.title" = "Kata Pemulihan Saja Tidak Cukup";
"onboarding.passphrase.learn_more.security.words.detail" = "Seseorang yang hanya memperoleh frasa pemulihan Anda tetap memerlukan frasa sandi yang tepat untuk menurunkan dan mengakses dompet yang dilindungi.";
"onboarding.passphrase.learn_more.security.strength.title" = "Kekuatan Memberikan Pemisahan Lebih Baik";
"onboarding.passphrase.learn_more.security.strength.detail" = "Frasa sandi yang panjang dan sulit diprediksi membuat penebakan jauh lebih sulit; kutipan pendek, tanggal lahir, nama, atau kata sandi yang digunakan ulang dapat ditebak dengan cepat dan hanya memberi sedikit perlindungan.";
"onboarding.passphrase.learn_more.security.separation.title" = "Simpan Frasa Sandi Secara Terpisah";
"onboarding.passphrase.learn_more.security.separation.detail" = "Simpan frasa sandi secara terpisah dari frasa pemulihan agar satu cadangan yang dicuri tidak mengungkap kedua rahasia yang diperlukan untuk memulihkan dompet.";
"onboarding.passphrase.learn_more.security.footer" = "Frasa sandi tidak dapat melindungi dana Anda jika kedua rahasia terekspos, frasa sandi lemah, atau perangkat lunak yang disusupi merekamnya saat Anda mengetik.";
"onboarding.passphrase.learn_more.safety.section" = "Gunakan Fitur Ini dengan Aman";
"onboarding.passphrase.learn_more.safety.strong.title" = "Buat Frasa Sandi yang Kuat dan Unik";
