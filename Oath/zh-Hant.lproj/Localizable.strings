"onboarding.entropy.learn_more.navigation" = "實體熵的運作方式";
"onboarding.entropy.learn_more.path.section" = "從實體結果到復原單字";
"onboarding.entropy.learn_more.overview" = "Oath 會記錄所選實體來源的結果，並將其轉換為 256 位元值。接著會將所得的 32 位元組傳遞至 Wallet Core，以建立標準 BIP-39 復原短語。";
"onboarding.entropy.learn_more.visual.phrase" = "包含 24 個單字的 BIP-39 復原短語";
"onboarding.entropy.learn_more.visual.bits" = "32 位元組 × 8 位元等於 256 位元";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "由 256 個範例位元格組成的網格，排列為 32 位元組。";
"onboarding.entropy.learn_more.visual.accessibility" = "擲骰子、擲硬幣或隨機數字會轉換成 256 位元，再轉換成包含 24 個單字的 BIP-39 復原短語。";
"onboarding.entropy.learn_more.inputs.section" = "步驟 1：記錄實體結果";
"onboarding.entropy.learn_more.inputs.dice.title" = "擲一顆公平的六面骰";
"onboarding.entropy.learn_more.inputs.dice.detail" = "使用公平的骰子時，點數 1–4 各提供 2 位元；點數 5–6 各提供 1 位元。";
"onboarding.entropy.learn_more.inputs.coin.title" = "擲實體硬幣";
"onboarding.entropy.learn_more.inputs.coin.detail" = "每次公平且獨立的擲硬幣結果，都會提供 1 個無偏的熵位元。";
"onboarding.entropy.learn_more.inputs.digits.title" = "記錄隨機數字";
"onboarding.entropy.learn_more.inputs.digits.detail" = "數字 0–7 各提供 3 位元；數字 8–9 各提供 1 位元。這些數字必須來自真正隨機的實體過程。";
"onboarding.entropy.learn_more.inputs.footer" = "請使用公平的實體來源，並依序記錄每個結果。你可以切換輸入方式，因為每個有效結果都會加入同一個位元流。";
"onboarding.entropy.learn_more.conversion.section" = "2. 組成 256 位元值";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath 會將骰子結果與十進位數字轉換成無偏的 2 次冪群組。各結果提供的位元長度可能不同，但公平的實體來源不會偏向任何位元值。";
"onboarding.entropy.learn_more.conversion.packing" = "Oath 會依輸入順序附加位元，直到正好收集 256 位元，再按照最高有效位元優先的順序封裝成 32 位元組。";
"onboarding.entropy.learn_more.conversion.no_mixing" = "自訂熵只包含你記錄的實體輸入；Oath 不會混入裝置產生的隨機性。";
"onboarding.entropy.learn_more.bip39.section" = "3. 衍生復原短語";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 位元熵";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8 位元 BIP-39 總和檢查碼";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 位元分成 24 個 11 位元單字索引";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256 位元熵值加入 8 位元總和檢查碼後會產生 264 位元，再分成 24 個各為 11 位元的單字索引。";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 會對 32 位元組熵值計算 SHA-256，並取雜湊值的前 8 位元作為總和檢查碼；附加此檢查碼後會產生 264 位元。";
"onboarding.entropy.learn_more.bip39.words" = "這 264 位元會分成 24 組，每組 11 位元。每組會從標準的 2,048 個單字 BIP-39 清單中選取 1 個項目，產生包含 24 個單字的復原短語。";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core 會從所得種子衍生確定性的帳戶與位址。相同的復原短語和選用的密碼短語，一律會重新建立相同的錢包。";
"onboarding.entropy.learn_more.security.section" = "自訂熵如何強化安全性";
"onboarding.entropy.learn_more.security.space.title" = "極為龐大的可能空間";
"onboarding.entropy.learn_more.security.space.detail" = "均勻分布的 256 位元熵包含 2^256 個不重複的值，從運算角度而言無法逐一窮舉。這代表輸入空間的大小，不表示每個密碼學元件都具備 256 位元的抗攻擊強度。";
"onboarding.entropy.learn_more.security.source.title" = "隨機性由你提供";
"onboarding.entropy.learn_more.security.source.detail" = "透過實體事件，你可以獨立提供錢包的隨機性，而不必完全仰賴裝置的隨機數產生器。只有在事件真正隨機時，才能提升安全性。";
"onboarding.entropy.learn_more.security.local.title" = "完全在此裝置上處理";
"onboarding.entropy.learn_more.security.local.detail" = "Oath 會完全在此裝置上轉換你記錄的序列並建立復原短語，絕不會上傳序列進行處理。";
"onboarding.entropy.learn_more.security.patterns.title" = "避免人為選擇的秘密";
"onboarding.entropy.learn_more.security.patterns.detail" = "由公平且獨立事件組成的長序列，遠比生日、偏好的數字、重複模式或人為選擇的單字更難預測。";
"onboarding.entropy.learn_more.security.footer" = "實體熵會取代由裝置產生的錢包隨機性；它不是額外的密碼或安全層。";
"onboarding.entropy.learn_more.safety.section" = "安全使用此功能";
"onboarding.entropy.learn_more.safety.fair.title" = "記錄公平且獨立的結果";
"onboarding.entropy.learn_more.safety.fair.detail" = "請使用公平的硬幣或骰子，並確保每個結果都彼此獨立。隨機數字必須來自真正的實體來源，而不是記憶或某種模式。";
"onboarding.entropy.learn_more.safety.private.title" = "將熵產生過程保密";
"onboarding.entropy.learn_more.safety.private.detail" = "請將記錄的序列與完成的復原短語都視為錢包機密，避免攝影機或其他人看見。";
"onboarding.entropy.learn_more.safety.accurate.title" = "正確記錄每個結果";
"onboarding.entropy.learn_more.safety.accurate.detail" = "遺漏、重複或順序錯誤的任何結果，都會建立不同的錢包。請檢查每筆輸入，並在錢包入金前驗證完成的復原短語。";
"onboarding.entropy.learn_more.safety.backup.title" = "妥善保護復原短語";
"onboarding.entropy.learn_more.safety.backup.detail" = "請離線儲存復原短語，切勿分享。驗證備份後，請安全銷毀不再需要的任何中間輸入記錄。";
"onboarding.entropy.learn_more.safety.footer" = "實體熵無法保護已外洩的復原短語、遭入侵的裝置、惡意軟體或記錄錯誤的序列。如果無法確保輸入公平、私密且正確，請改用標準錢包建立方式。";
