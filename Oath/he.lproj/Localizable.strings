"onboarding.passphrase.learn_more.safety.backup.title" = "גיבוי ביטוי הסיסמה בנפרד";
"onboarding.passphrase.learn_more.safety.backup.detail" = "צרו עותק עמיד ולא מקוון של ביטוי הסיסמה המדויק, שמרו אותו בנפרד מביטוי השחזור ולעולם אל תסתמכו על הזיכרון בלבד.";
"onboarding.passphrase.learn_more.safety.exact.title" = "כל תו משנה את הארנק";
"onboarding.passphrase.learn_more.safety.exact.detail" = "הזינו שוב את ביטוי הסיסמה בדיוק כפי שנוצר, כולל כל אות רישית, רווח, סימן פיסוק ומילה. כל הבדל גוזר בשקט ארנק אחר.";
"onboarding.passphrase.learn_more.safety.verify.title" = "אימות השחזור לפני הוספת כספים";
