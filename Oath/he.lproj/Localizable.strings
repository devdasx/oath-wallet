"onboarding.passphrase.learn_more.security.footer" = "ביטוי סיסמה אינו יכול להגן על הכספים שלכם אם שני הסודות נחשפו, אם ביטוי הסיסמה חלש או אם תוכנה שנפרצה לוכדת אותו בזמן ההקלדה.";
