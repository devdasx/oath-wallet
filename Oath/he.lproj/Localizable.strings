"onboarding.entropy.learn_more.visual.accessibility" = "תוצאות הטלת קובייה, הטלות מטבע או ספרות אקראיות מומרות ל-256 סיביות ולאחר מכן לביטוי שחזור BIP-39 בן 24 מילים.";
"onboarding.entropy.learn_more.inputs.section" = "שלב 1: תיעוד תוצאות פיזיות";
"onboarding.entropy.learn_more.inputs.dice.title" = "הטלת קובייה הוגנת בעלת 6 פאות";
"onboarding.entropy.learn_more.inputs.dice.detail" = "בקובייה הוגנת, כל אחת מהפאות 1–4 תורמת 2 סיביות, וכל אחת מהפאות 5–6 תורמת סיבית אחת.";
"onboarding.entropy.learn_more.inputs.coin.title" = "הטלות מטבע פיזיות";
"onboarding.entropy.learn_more.inputs.coin.detail" = "כל הטלה הוגנת ועצמאית של מטבע תורמת סיבית אנטרופיה אחת ללא הטיה.";
"onboarding.entropy.learn_more.inputs.digits.title" = "תיעוד ספרות אקראיות";
"onboarding.entropy.learn_more.inputs.digits.detail" = "כל אחת מהספרות 0–7 תורמת 3 סיביות, וכל אחת מהספרות 8–9 תורמת סיבית אחת. הספרות חייבות להגיע מתהליך פיזי אקראי באמת.";
"onboarding.entropy.learn_more.inputs.footer" = "השתמשו במקור פיזי הוגן ותעדו כל תוצאה לפי הסדר. אפשר לעבור בין שיטות קלט, משום שכל תוצאה שהתקבלה תורמת לאותו זרם סיביות.";
"onboarding.entropy.learn_more.conversion.section" = "2. הרכבת ערך של 256 סיביות";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath ממירה תוצאות קובייה וספרות עשרוניות לקבוצות ללא הטיה שגודלן חזקה של 2. אורך התרומות עשוי להשתנות, אך מקור פיזי הוגן אינו מעדיף ערך סיבית כלשהו.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath מצרפת סיביות בסדר שבו הוזנו עד שנאספות בדיוק 256 סיביות, ואז אורזת אותן ב-32 בתים, מהסיבית המשמעותית ביותר.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "אנטרופיה מותאמת אישית מכילה רק את הקלטים הפיזיים שתיעדתם; Oath אינה מערבבת בה אקראיות שנוצרה במכשיר.";
"onboarding.entropy.learn_more.bip39.section" = "3. גזירת ביטוי השחזור";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "אנטרופיה של 256 סיביות";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "סכום ביקורת BIP-39 בן 8 סיביות";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 סיביות המחולקות ל-24 אינדקסים של מילים, בני 11 סיביות";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "לערך אנטרופיה בן 256 סיביות מתווסף סכום ביקורת בן 8 סיביות, וכך מתקבלות 264 סיביות המחולקות ל-24 אינדקסים של מילים, בני 11 סיביות.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 מחשב SHA-256 על ערך האנטרופיה בן 32 הבתים ולוקח את 8 סיביות הגיבוב הראשונות כסכום ביקורת; צירוף סכום הביקורת יוצר 264 סיביות.";
"onboarding.entropy.learn_more.bip39.words" = "264 הסיביות מחולקות ל-24 קבוצות של 11 סיביות. כל קבוצה בוחרת רשומה אחת מתוך רשימת BIP-39 התקנית, הכוללת 2,048 מילים, וכך נוצר ביטוי השחזור בן 24 המילים.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core גוזרת מה-Seed שהתקבל חשבונות וכתובות באופן דטרמיניסטי. אותו ביטוי שחזור ואותו ביטוי סיסמה אופציונלי תמיד ייצרו מחדש את אותו ארנק.";
"onboarding.entropy.learn_more.security.section" = "כיצד אנטרופיה מותאמת אישית מחזקת את האבטחה";
"onboarding.entropy.learn_more.security.space.title" = "מרחב אפשרויות עצום";
"onboarding.entropy.learn_more.security.space.detail" = "אנטרופיה אחידה בת 256 סיביות מכילה 2^256 ערכים ייחודיים, ולכן ניחוש ממצה אינו מעשי מבחינה חישובית. נתון זה מתאר את גודל מרחב הקלט; אין פירושו שכל רכיב קריפטוגרפי מספק עמידות של 256 סיביות בפני תקיפה.";
"onboarding.entropy.learn_more.security.source.title" = "האקראיות מגיעה מכם";
"onboarding.entropy.learn_more.security.source.detail" = "אירועים פיזיים מאפשרים לכם לספק את מקור האקראיות של הארנק באופן עצמאי, במקום להסתמך אך ורק על מחולל המספרים האקראיים של המכשיר. הדבר משפר את האבטחה רק כשהאירועים אקראיים באמת.";
"onboarding.entropy.learn_more.security.local.title" = "עיבוד מלא במכשיר הזה";
"onboarding.entropy.learn_more.security.local.detail" = "Oath ממירה את הרצף שתיעדתם ויוצרת את ביטוי השחזור במלואו במכשיר הזה. הרצף שלכם לעולם אינו מועלה לצורך עיבוד.";
"onboarding.entropy.learn_more.security.patterns.title" = "הימנעו מסודות שנבחרו על ידי אדם";
"onboarding.entropy.learn_more.security.patterns.detail" = "רצף ארוך של אירועים הוגנים ועצמאיים צפוי הרבה פחות מתאריכי יום הולדת, מספרים אהובים, דפוסים חוזרים או מילים שאדם בחר.";
"onboarding.entropy.learn_more.security.footer" = "אנטרופיה פיזית מחליפה את האקראיות שהמכשיר מייצר עבור הארנק; היא אינה סיסמה נוספת או שכבת אבטחה נוספת.";
"onboarding.entropy.learn_more.safety.section" = "שימוש בטוח בתכונה";
"onboarding.entropy.learn_more.safety.fair.title" = "תיעוד תוצאות הוגנות ועצמאיות";
"onboarding.entropy.learn_more.safety.fair.detail" = "השתמשו במטבע או בקובייה הוגנים, וודאו שכל תוצאה עצמאית. ספרות אקראיות חייבות להגיע ממקור פיזי אמיתי, ולא מהזיכרון או מדפוס.";
"onboarding.entropy.learn_more.safety.private.title" = "שמירה על פרטיות תהליך האנטרופיה";
"onboarding.entropy.learn_more.safety.private.detail" = "הגנו הן על הרצף המתועד והן על ביטוי השחזור המלא כעל סודות ארנק. הרחיקו אותם מעיני מצלמות ואנשים אחרים.";
"onboarding.entropy.learn_more.safety.accurate.title" = "תיעוד מדויק של כל תוצאה";
"onboarding.entropy.learn_more.safety.accurate.detail" = "תוצאה אחת חסרה, כפולה או שלא במקומה יוצרת ארנק אחר. עברו על כל רשומה ואמתו את ביטוי השחזור המלא לפני הפקדת כספים בארנק.";
"onboarding.entropy.learn_more.safety.backup.title" = "אבטחת ביטוי השחזור";
"onboarding.entropy.learn_more.safety.backup.detail" = "שמרו את ביטוי השחזור במצב לא מקוון ולעולם אל תשתפו אותו. לאחר אימות הגיבוי, השמידו באופן מאובטח כל תיעוד ביניים של הקלט שאינכם זקוקים לו עוד.";
"onboarding.entropy.learn_more.safety.footer" = "אנטרופיה פיזית אינה יכולה לאבטח ביטוי שחזור שנחשף, מכשיר שנפרץ, תוכנה זדונית או רצף שתועד באופן שגוי. אם אינכם יכולים להבטיח קלטים הוגנים, פרטיים ומדויקים, השתמשו ביצירה רגילה של ארנק.";
