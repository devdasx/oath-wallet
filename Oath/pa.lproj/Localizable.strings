"send.submit.error.tron_signature" = "TRON ਲੈਣ-ਦੇਣ ਦੇ ਦਸਤਖ਼ਤ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕਰ ਸਕਿਆ। ਖਾਤੇ ਦੀਆਂ ਦਸਤਖ਼ਤ ਕਰਨ ਦੀਆਂ ਇਜਾਜ਼ਤਾਂ ਜਾਂਚੋ: ਵਾਧੂ ਦਸਤਖ਼ਤਾਂ ਜਾਂ ਕਿਸੇ ਹੋਰ ਅਧਿਕਾਰਤ ਕੁੰਜੀ ਦੀ ਲੋੜ ਹੋ ਸਕਦੀ ਹੈ।";

"tron.permissions.warning.title" = "ਕਈ ਦਸਤਖ਼ਤਾਂ ਵਾਲਾ TRON ਵਾਲਿਟ";
"tron.permissions.warning.body" = "ਇਸ ਵਾਲਿਟ ਲਈ ਕਈ TRON ਦਸਤਖ਼ਤ ਲੋੜੀਂਦੇ ਹਨ। ਇਸ ਐਪ ਵਿੱਚ ਭੇਜਣਾ, ਪ੍ਰਾਪਤ ਕਰਨਾ ਅਤੇ ਵਾਲਿਟ ਦੀਆਂ ਕਾਰਵਾਈਆਂ ਬੰਦ ਹਨ।\n\nਕਈ ਦਸਤਖ਼ਤਾਂ ਦੀ ਜਾਇਜ਼ ਵਰਤੋਂ ਵੀ ਹੁੰਦੀ ਹੈ। ਜੇ ਕਿਸੇ ਨੇ ਤੁਹਾਨੂੰ ਇਹ ਵਾਲਿਟ ਦਿੱਤਾ ਹੈ, ਤਾਂ ਇਸ ਦੇ ਟੋਕਨ ਅਨਲੌਕ ਕਰਨ ਲਈ TRX ਜਮ੍ਹਾਂ ਨਾ ਕਰੋ। ਲੋੜੀਂਦੇ ਦਸਤਖ਼ਤ ਉਸ ਦੇ ਕਾਬੂ ਵਿੱਚ ਹੋ ਸਕਦੇ ਹਨ ਅਤੇ ਉਹ ਤੁਹਾਡੀ ਜਮ੍ਹਾਂ ਰਕਮ ਚੋਰੀ ਕਰ ਸਕਦਾ ਹੈ।";
"tron.permissions.unavailable" = "TRON ਦੀਆਂ ਦਸਤਖ਼ਤ ਇਜਾਜ਼ਤਾਂ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਹੋ ਸਕੀ।";

"wallet.restrictions.warning.title" = "ਵਾਲਿਟ ਉੱਤੇ ਪਾਬੰਦੀਆਂ ਮਿਲੀਆਂ";

"wallet.blacklist.warning.body" = "ਹੇਠਾਂ ਦਿੱਤੇ ਟੋਕਨ ਇਕਰਾਰਨਾਮਿਆਂ ਮੁਤਾਬਕ ਇਹ ਪਤਾ ਬਲੈਕਲਿਸਟ ਵਿੱਚ ਹੈ। ਇਨ੍ਹਾਂ ਟੋਕਨਾਂ ਦੇ ਟ੍ਰਾਂਸਫਰ ਰੋਕੇ ਜਾ ਸਕਦੇ ਹਨ। ਨੈੱਟਵਰਕ ਫੀਸ ਲਈ ਪੈਸੇ ਜੋੜਨ ਨਾਲ ਪਾਬੰਦੀ ਨਹੀਂ ਹਟੇਗੀ।";


"import.safety.action.different_recovery_phrase" = "ਕੋਈ ਹੋਰ ਰਿਕਵਰੀ ਵਾਕਾਂਸ਼ ਵਰਤੋ";

"import.safety.action.different_private_key" = "ਕੋਈ ਹੋਰ ਪ੍ਰਾਈਵੇਟ ਕੁੰਜੀ ਵਰਤੋ";

"settings.about.history.v352.build50.safety" = "ਬਿਲਡ 50: TRON ਮਲਟੀਸਿਗ ਅਤੇ USDT/USDC ਪਾਬੰਦੀਆਂ ਲਈ ਸਾਂਝੀਆਂ ਚੇਤਾਵਨੀਆਂ। TRON ਮਲਟੀਸਿਗ ਟ੍ਰਾਂਸਫਰ ਬੰਦ ਰਹਿੰਦੇ ਹਨ, ਜਦਕਿ ਸੈਟਿੰਗਾਂ ਉਪਲਬਧ ਰਹਿੰਦੀਆਂ ਹਨ। ਦਸਤਖ਼ਤ ਦੀਆਂ ਗਲਤੀਆਂ ਅਤੇ ਆਯਾਤ ਦੀਆਂ ਹਦਾਇਤਾਂ ਹੋਰ ਸਪੱਸ਼ਟ; ਰਿਕਵਰੀ ਵਾਕਾਂਸ਼ਾਂ ਦੀ ਬਲਾਕ ਸੂਚੀ ਅੱਪਡੇਟ ਕੀਤੀ।";

"settings.about.history.v352.build50.input" = "ਆਯਾਤ ਤੋਂ ਬਾਅਦ ਕੀਮਤਾਂ ਤੇਜ਼ੀ ਨਾਲ ਲੋਡ ਹੁੰਦੀਆਂ ਹਨ। ਸਿਫ਼ਰ ਬਕਾਏ ਉੱਤੇ ਇਕਾਈ ਬਦਲਣ ਅਤੇ ਸੱਜੇ ਤੋਂ ਖੱਬੇ ਲਿਖੀਆਂ ਭਾਸ਼ਾਵਾਂ ਵਿੱਚ ਕਨਵਰਟਰ ਵਿੱਚ ਟਾਈਪ ਕਰਨ ਦੀਆਂ ਸਮੱਸਿਆਵਾਂ ਠੀਕ ਕੀਤੀਆਂ। ਰਿਕਵਰੀ ਸ਼ਬਦਾਂ ਦਾ ਕ੍ਰਮ ਬਣਿਆ ਰਹਿੰਦਾ ਹੈ; ਸਹੀ ਵਾਕਾਂਸ਼ ਪੇਸਟ ਜਾਂ ਸਕੈਨ ਕਰਨ ਉੱਤੇ ਕੀਬੋਰਡ ਬੰਦ ਹੋ ਜਾਂਦਾ ਹੈ।";

"settings.about.history.v352.build50.interface" = "ਹੋਮ ਸਕ੍ਰੀਨ ਅਤੇ ਸੰਪਤੀਆਂ ਪਿੰਨ ਕਰਨ ਦੀਆਂ ਹੋਰ ਸੁਚਾਰੂ ਐਨੀਮੇਸ਼ਨਾਂ, ਵਧੇਰੇ ਹੈਪਟਿਕ ਪ੍ਰਤੀਕਿਰਿਆ ਅਤੇ ਬਿਹਤਰ ਅਨੁਵਾਦ। ਪ੍ਰਾਪਤੀ ਕਾਰਡ ਵੱਡੇ QR ਕੋਡ ਅਤੇ ਪਤੇ ਦੇ ਅੱਖਰਾਂ ਨਾਲ ਡਾਰਕ ਮੋਡ ਵਿੱਚ ਦਿਸਦੇ ਹਨ। ਤਬਦੀਲੀਆਂ ਚੈੱਕਮਾਰਕ ਨਾਲ ਸੰਭਾਲੀਆਂ ਜਾਂਦੀਆਂ ਹਨ; ਚੇਤਾਵਨੀਆਂ ਸਿਰਫ਼ ਲੋੜੀਂਦੀ ਜਾਣਕਾਰੀ ਦਿਖਾਉਂਦੀਆਂ ਹਨ।";

"evm_access.gas.insufficient.title" = "ਨੈੱਟਵਰਕ ਫੀਸ ਲਈ ਲੋੜੀਂਦਾ ਬੈਲੈਂਸ ਨਹੀਂ ਹੈ";
"evm_access.gas.insufficient.body" = "ਨੈੱਟਵਰਕ ਫੀਸ ਭਰਨ ਲਈ ਇਸ ਵਾਲਿਟ ਵਿੱਚ %@ ਜੋੜੋ। ਇਸ ਲਈ %@ ਨੈੱਟਵਰਕ ਵਰਤੋ, ਫਿਰ ਇਜਾਜ਼ਤ ਰੱਦ ਕਰਨ ਦੀ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "ਰਿਕਵਰੀ ਵਾਕਾਂਸ਼ ਦੀ ਜਾਂਚ, ਆਪਣੇ-ਆਪ ਛੋਟੇ ਅੱਖਰ ਕਰਨਾ, ਨੰਬਰਾਂ ਸਮੇਤ ਇਨਪੁੱਟ, ਸਾਫ਼ ਕਰਨਾ, ਬੈਕਸਪੇਸ ਦਬਾ ਕੇ ਰੱਖਣ ਨਾਲ ਮਿਟਾਉਣਾ ਅਤੇ ਕੀਬੋਰਡ ਦਾ ਵਿਹਾਰ ਸੁਧਾਰਿਆ ਗਿਆ ਹੈ। ਰਿਕਵਰੀ ਸਕ੍ਰੀਨਾਂ ਉੱਤੇ ਹੁਣ ਵਾਪਸੀ ਦਾ ਇੱਕੋ ਬਟਨ ਹੈ।";
"settings.about.history.v353.build51.send" = "ਫ਼ੀਸ ਦੇ ਅੰਦਾਜ਼ੇ ਉਪਲਬਧ ਨਾ ਹੋਣ ’ਤੇ ਸਾਰੇ ਸਮਰਥਿਤ ਨੈੱਟਵਰਕਾਂ ਵਿੱਚ ਫ਼ੀਸ ਦਾ ਅੰਦਾਜ਼ਾ ਲਗਾਉਣ ਦੇ ਬਦਲਵੇਂ ਤਰੀਕੇ ਜੋੜੇ ਗਏ ਹਨ। ਭੇਜਣ ਵੇਲੇ ਕੰਟਰੈਕਟ ਪਤੇ ਲੁਕਾਏ ਜਾਂਦੇ ਹਨ ਅਤੇ ਫ਼ੀਸ ਹੋਰ ਸਪਸ਼ਟ ਦਿਖਦੀ ਹੈ।";
"settings.about.history.v353.build51.security" = "ਇਜਾਜ਼ਤਾਂ ਦੀ ਸਮੀਖਿਆ, ਪਤੇ ਦੇ ਵੇਰਵੇ, ਇਜਾਜ਼ਤ ਰੱਦ ਕਰਨ ਦੇ ਨਤੀਜੇ ਅਤੇ ਫ਼ੀਸ ਲਈ ਪੈਸੇ ਜੋੜਨ ਦੀਆਂ ਹਦਾਇਤਾਂ ਹੋਰ ਸਪਸ਼ਟ ਹਨ। ਬੈਕਅੱਪ ਕਾਰਡਾਂ ਤੇ ਸ਼ੀਟਾਂ ਦੀ ਸ਼ੈਲੀ ਇੱਕੋ ਜਿਹੀ ਹੈ। ਨੈਵੀਗੇਸ਼ਨ ਵੇਲੇ ਕੰਪਨ ਹਟਾ ਦਿੱਤੀ ਹੈ।";
"settings.about.history.v353.build51.notifications" = "ਵੱਖ-ਵੱਖ ਨੈੱਟਵਰਕਾਂ ਉੱਤੇ ਆਉਣ ਵਾਲੇ ਟ੍ਰਾਂਸਫਰਾਂ ਦੀਆਂ ਸੂਚਨਾਵਾਂ ਹੋਰ ਭਰੋਸੇਯੋਗ ਹਨ। ਕੀਮਤਾਂ ਮਿਲਣ ਉੱਤੇ ਰਕਮ ਚੁਣੀ ਮੁਦਰਾ ਵਿੱਚ, ਨਹੀਂ ਤਾਂ ਕ੍ਰਿਪਟੋ ਦੀ ਮੂਲ ਇਕਾਈ ਵਿੱਚ ਦਿਖਾਈ ਜਾਂਦੀ ਹੈ।";

