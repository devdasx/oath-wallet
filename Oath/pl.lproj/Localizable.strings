"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Fraza odzyskiwania i hasło przechodzą przez 2048 rund PBKDF2-HMAC-SHA512, tworząc 512-bitowe ziarno, z którego wyprowadzane są konta i adresy portfela.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 traktuje znormalizowaną frazę odzyskiwania jako hasło PBKDF2, a jako sól wykorzystuje słowo „mnemonic” i następujące po nim znormalizowane hasło BIP-39. Po 2048 rundach PBKDF2-HMAC-SHA512 powstaje 64-bajtowe ziarno.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Przed wyprowadzeniem ziarna Oath stosuje normalizację Unicode wymaganą przez BIP-39, dlatego ta sama znormalizowana fraza odzyskiwania i hasło zawsze odtwarzają ten sam portfel.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Hasło BIP-39 nie szyfruje słów odzyskiwania. Zmienia wyprowadzone ziarno, dlatego każde inne hasło tworzy inne konta i adresy.";
