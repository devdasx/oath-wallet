"onboarding.entropy.learn_more.navigation" = "Jak działa entropia fizyczna";
"onboarding.entropy.learn_more.path.section" = "Od wyników fizycznych do słów odzyskiwania";
"onboarding.entropy.learn_more.overview" = "Oath zapisuje wyniki z wybranego źródła fizycznego i przekształca je w wartość 256-bitową. Uzyskane 32 bajty trafiają następnie do Wallet Core, który tworzy standardową frazę odzyskiwania BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "24-wyrazowa fraza odzyskiwania BIP-39";
"onboarding.entropy.learn_more.visual.bits" = "32 bajty × 8 bitów = 256 bitów";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Siatka 256 przykładowych komórek bitowych ułożonych w 32 bajty.";
"onboarding.entropy.learn_more.visual.accessibility" = "Rzuty kośćmi, rzuty monetą lub losowe cyfry są przekształcane w 256 bitów, a następnie w 24-wyrazową frazę odzyskiwania BIP-39.";
"onboarding.entropy.learn_more.inputs.section" = "Krok 1: Zapisz wyniki fizyczne";
"onboarding.entropy.learn_more.inputs.dice.title" = "Rzuć uczciwą sześciościenną kością";
"onboarding.entropy.learn_more.inputs.dice.detail" = "W przypadku uczciwej kości każda ścianka 1–4 wnosi 2 bity, a każda ścianka 5–6 — 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fizyczne rzuty monetą";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Każdy uczciwy, niezależny rzut monetą wnosi 1 nieobciążony bit entropii.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zapisz losowe cyfry";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Każda cyfra 0–7 wnosi po 3 bity. Każda cyfra 8–9 wnosi 1 bit. Cyfry muszą pochodzić z prawdziwie losowego procesu fizycznego.";
"onboarding.entropy.learn_more.inputs.footer" = "Użyj bezstronnego źródła fizycznego i zapisuj każdy wynik po kolei. Możesz zmieniać metody, ponieważ każdy zaakceptowany wynik trafia do tego samego strumienia bitów.";
"onboarding.entropy.learn_more.conversion.section" = "2. Zbuduj wartość 256-bitową";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath przekształca wyniki rzutów kością i cyfry dziesiętne w nieobciążone grupy o liczebności będącej potęgą dwójki. Długość wkładu może być różna, ale uczciwe źródło fizyczne nie faworyzuje żadnej wartości bitu.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath dodaje bity w kolejności ich wprowadzania, aż zbierze dokładnie 256, a następnie pakuje je w 32 bajty, zaczynając od najbardziej znaczącego bitu.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Niestandardowa entropia zawiera wyłącznie zapisane przez Ciebie dane fizyczne; Oath nie dodaje losowości generowanej przez urządzenie.";
"onboarding.entropy.learn_more.bip39.section" = "3. Wyprowadź frazę odzyskiwania";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitów entropii";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-bitowa suma kontrolna BIP-39";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bity podzielone na 24 jedenastobitowe indeksy słów";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-bitowa wartość entropii plus 8-bitowa suma kontrolna tworzy 264 bity, które dzielą się na 24 indeksy słów po 11 bitów każdy.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 oblicza SHA-256 na podstawie 32-bajtowej wartości entropii i przyjmuje pierwsze 8 bitów skrótu jako sumę kontrolną. Dołączenie tej sumy kontrolnej daje 264 bity.";
"onboarding.entropy.learn_more.bip39.words" = "264 bity są dzielone na 24 grupy po 11 bitów. Każda grupa wskazuje jedną pozycję ze standardowej listy 2048 słów BIP-39, tworząc 24-wyrazową frazę odzyskiwania.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core wyprowadza deterministyczne konta i adresy z uzyskanego ziarna. Ta sama fraza odzyskiwania i opcjonalne hasło BIP-39 zawsze odtworzą ten sam portfel.";
"onboarding.entropy.learn_more.security.section" = "Jak niestandardowa entropia zwiększa bezpieczeństwo";
"onboarding.entropy.learn_more.security.space.title" = "Ogromna przestrzeń możliwości";
"onboarding.entropy.learn_more.security.space.detail" = "Równomierna 256-bitowa entropia obejmuje 2^256 unikalnych wartości, co sprawia, że wyczerpujące zgadywanie jest obliczeniowo niewykonalne. Opisuje to rozmiar przestrzeni wejściowej; nie oznacza, że każdy składnik kryptograficzny zapewnia 256-bitową odporność na ataki.";
"onboarding.entropy.learn_more.security.source.title" = "Losowość pochodzi od Ciebie";
"onboarding.entropy.learn_more.security.source.detail" = "Zdarzenia fizyczne pozwalają niezależnie pozyskać losowość portfela zamiast polegać wyłącznie na generatorze liczb losowych urządzenia. Zwiększa to bezpieczeństwo tylko wtedy, gdy te zdarzenia są naprawdę losowe.";
"onboarding.entropy.learn_more.security.local.title" = "Przetwarzanie wyłącznie na tym urządzeniu";
"onboarding.entropy.learn_more.security.local.detail" = "Oath przekształca zapisaną sekwencję i tworzy frazę odzyskiwania wyłącznie na tym urządzeniu. Twoja sekwencja nigdy nie jest przesyłana do przetworzenia.";
"onboarding.entropy.learn_more.security.patterns.title" = "Unikaj sekretów wybieranych przez człowieka";
"onboarding.entropy.learn_more.security.patterns.detail" = "Długa sekwencja uczciwych, niezależnych zdarzeń jest znacznie mniej przewidywalna niż data urodzenia, ulubione liczby, powtarzające się wzorce lub słowa wybrane przez człowieka.";
"onboarding.entropy.learn_more.security.footer" = "Entropia fizyczna zastępuje losowość portfela generowaną przez urządzenie; nie jest dodatkowym hasłem ani warstwą zabezpieczeń.";
"onboarding.entropy.learn_more.safety.section" = "Bezpieczne korzystanie z tej funkcji";
"onboarding.entropy.learn_more.safety.fair.title" = "Zapisuj uczciwe, niezależne wyniki";
"onboarding.entropy.learn_more.safety.fair.detail" = "Użyj uczciwej monety lub kości i dopilnuj, aby każdy wynik był niezależny. Losowe cyfry muszą pochodzić z prawdziwego źródła fizycznego — nie z pamięci ani wzorca.";
"onboarding.entropy.learn_more.safety.private.title" = "Zachowaj prywatność procesu tworzenia entropii";
"onboarding.entropy.learn_more.safety.private.detail" = "Chroń zapisaną sekwencję i gotową frazę odzyskiwania jak sekrety portfela. Trzymaj je poza zasięgiem kamer i wzroku innych osób.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Dokładnie zapisuj każdy wynik";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Jeden pominięty, powtórzony lub przestawiony wynik tworzy inny portfel. Sprawdź każdy wpis i zweryfikuj gotową frazę odzyskiwania przed wpłatą środków do portfela.";
"onboarding.entropy.learn_more.safety.backup.title" = "Chroń frazę odzyskiwania";
"onboarding.entropy.learn_more.safety.backup.detail" = "Przechowuj frazę odzyskiwania w trybie offline i nigdy jej nie udostępniaj. Po zweryfikowaniu kopii zapasowej bezpiecznie zniszcz wszelkie pośrednie zapisy danych wejściowych, których już nie potrzebujesz.";
"onboarding.entropy.learn_more.safety.footer" = "Entropia fizyczna nie ochroni ujawnionej frazy odzyskiwania, przejętego urządzenia, złośliwego oprogramowania ani błędnie zapisanej sekwencji. Jeśli nie możesz zagwarantować uczciwych, prywatnych i dokładnych danych wejściowych, użyj standardowego sposobu tworzenia portfela.";
"onboarding.carousel.open_source.eyebrow" = "OTWARTY KOD Z ZAŁOŻENIA";
