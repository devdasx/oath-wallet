// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Przesuń, aby wysłać zastępuje przycisk potwierdzenia. Animacja kierunkowa, haptyka i płynniejszy ruch obsługują oba kierunki czytania. Puść przy co najmniej 90%, aby wysłać; przesuń z powrotem, aby anulować.";
"settings.about.history.v355.build56.activity" = "Dzwonek otwiera oczekującą aktywność. Kapsuły transakcji pokazują oznaczenia stanu i można je odsunąć gestem. Kapsuły potwierdzania i potwierdzonych transakcji znikają po 3 sekundach; potwierdzenie aktualizuje tę samą widoczną kapsułę.";
"settings.about.history.v355.build56.status" = "Bardziej wiarygodny stan transakcji we wszystkich obsługiwanych sieciach, aktualne szczegóły i szybsze aktualizacje salda po wysłaniu. Śledzenie oczekujących transakcji wznawia się po ponownym otwarciu aplikacji.";
"settings.about.history.v355.build56.fees" = "Powrót do przeglądu tego samego przelewu zachowuje ustaloną opłatę. Czytelniejsze pobieranie opłat i ostrzeżenia o zasileniu konta; wystarczające kwoty nie wyświetlają już komunikatów o aktywacji.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin i Dogecoin dodają resztę poniżej progu pyłu do opłaty zamiast tworzyć bezużyteczne wyjście. Opłata w przeglądzie odpowiada opłacie przy podpisywaniu.";
"settings.about.history.v355.build56.stability" = "Naprawiono awarię zadania w tle i alerty o przekroczeniu czasu odświeżania portfela. Przy chwilowych błędach odświeżania dotychczasowe informacje o portfelu pozostają dostępne.";
"settings.about.history.v355.build56.backup" = "Czytelniejsze ekrany kopii zapasowych z właściwymi tytułami od otwarcia i mniejszą liczbą komunikatów. Dostęp do kluczy prywatnych respektuje blokadę aplikacji. Kompaktowe ostrzeżenia importu w stylu szkła usuwają odrzucone dane po wybraniu innej frazy odzyskiwania.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Po zwolnieniu suwaka wysyłania pojawia się animowany znacznik wyboru, zanim ekran weryfikacji zostanie zamknięty.";
"settings.about.history.v355.build57.activity" = "Wiersze aktywności wyświetlają status lżejszą czcionką, kwotę jako podtytuł oraz strzałkę otwierającą szczegóły transakcji.";
"settings.about.history.v355.build57.details" = "Opłaty sieciowe są teraz widoczne w podsumowaniu przelewu. Krótsze etykiety i tylko jeden wiersz sieci zwiększają czytelność szczegółów.";
"settings.about.history.v355.build57.resume" = "Po powrocie z tła otwarte ekrany i panele pozostają zachowane, w tym weryfikacja przelewu i szczegóły transakcji.";
"settings.about.history.v355.build57.secrets" = "Ekrany frazy odzyskiwania, klucza prywatnego i dodatkowej frazy hasła zamykają się po 20 sekundach poza aplikacją. Blokada aplikacji nadal działa zgodnie z ustawieniami.";
"settings.about.history.v355.build57.filters" = "Filtry sieci używają nieco wyższych przycisków systemowych, rozmiarów dopasowanych do treści i poprawionych odstępów pod paskiem nawigacji.";
"settings.about.history.v355.build57.units" = "Usunięto osobne wiersze wartości. Kwota i opłata sieciowa są początkowo w lokalnej walucie; dotknij jednej z nich, aby przełączyć na jednostki kryptowaluty i z powrotem.";
"wallet.transaction.details.toggle_units" = "Zmień jednostki.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Ekran główny otwiera się bez efektów zanikania i skalowania. Przycisk ustawień używa teraz ikony koła zębatego.";
"settings.about.history.v355.build58.fields" = "Pola transakcji i wysyłania używają standardowych kolorów tekstu. Strzałki pojawiają się tylko w wierszach otwierających ekran lub panel; dotknięcie kwoty albo opłaty nadal przełącza jednostki.";
"settings.about.history.v355.build58.banners" = "Po wyświetleniu banery trwającego lub zakończonego potwierdzania znikają po 3 sekundach, nawet gdy otworzysz inny ekran. Niewyświetlone jeszcze potwierdzenia pojawią się po powrocie.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Przelewy TRON rezerwują teraz opłaty za aktywację i przepustowość przed obliczeniem kwoty do wysłania, także przy wysyłaniu maksymalnej kwoty. Podgląd pokazuje prawidłową kwotę po odliczeniu opłat.";
"settings.about.history.v355.build59.fees" = "Własne opłaty TRON muszą pokrywać wymagane koszty sieci. Przy niskim saldzie TRX wyświetlane są teraz jaśniejsze wskazówki. Liczba tokenów nie zmienia się; opłaty są płacone w TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Nowe powitanie";
"settings.about.history.v356.welcome" = "Nowy ekran powitalny z animowaną grafiką i przejrzystymi opcjami tworzenia lub importowania portfela.";
"settings.about.history.v357.tour.title" = "Wycieczka powitalna";
"settings.about.history.v357.tour" = "Pięciostronicowa wycieczka przedstawia obsługiwane sieci, fizyczną entropię, wysyłanie i odbieranie, bezpieczeństwo oraz zweryfikowane kompilacje. Przesuń palcem lub stuknij kropki, aby zmienić stronę; przełącznik języka znajduje się na pasku nawigacji.";
"settings.about.history.v357.backup" = "Po utworzeniu, zaimportowaniu lub odzyskaniu portfela ekran pojawia się natychmiast, a opcje kopii zapasowej korzystają ze standardowej listy. Sprawdzanie iCloud odbywa się w tle, a przycisk Otwórz portfel jest gotowy, gdy tylko portfel zostanie zapisany.";
"settings.about.history.v357.reliability" = "Powrót z tła nie zamyka już ekranu konfiguracji, gdy wygaśnie ukryty ekran odzyskiwania, a usunięcie wszystkich danych otwiera bezpośrednio ekran powitalny.";
"settings.about.history.v357.notifications" = "Ustawienia powiadomień używają prostszych sformułowań dla kategorii i stanu, bez szczegółów technicznych.";
"settings.about.history.v357.wallets" = "Zmieniaj kolejność portfeli w przełączniku długim naciśnięciem z systemową animacją uniesienia; stuknięcie wiersza aktywuje portfel. Weryfikacja frazy odzyskiwania numeruje każde słowo, a Return przechodzi do następnego pola.";
"settings.about.history.v357.send" = "Podczas wysyłania widoczna jest kwota, dopóki trwa przelew, w razie niepowodzenia pojawia się czytelniejszy komunikat, a żądania TRON są automatycznie ponawiane po tymczasowych błędach dostawcy.";
"settings.about.history.v357.security" = "Zaimportowane konta TRON, których uprawnienie właściciela przeniesiono na inny klucz, pokazują teraz ostrzeżenie i nie mogą wysyłać, nawet gdy każde uprawnienie wymienia tylko jeden klucz. Przy imporcie odrzucanych jest więcej znanych ujawnionych fraz odzyskiwania i kluczy prywatnych.";
"settings.about.history.v356.localization" = "Teksty na ekranie powitalnym są teraz bardziej naturalne i zrozumiałe we wszystkich obsługiwanych językach.";
"settings.about.history.v356.pricing" = "Ceny tokenów są teraz zgodne z dokładną siecią i adresem tokena, najpierw korzystając z cen DEX. Małe ceny podawane są z dokładnością do 8 miejsc po przecinku bez zaokrągleń.";
"settings.about.history.v356.appearance" = "Przyciski główne i dodatkowe mają teraz spójne wysokości i marginesy ekranu, a podstawowe czynności są niebieskie.";
"settings.about.history.v356.transactions" = "Szczegóły transakcji mają krótszy status Potwierdzone i wyraźniejszy szary tekst w przypadku dat, adresów, kwot i identyfikatorów transakcji.";
"settings.about.history.v356.security" = "Rozszerzono listę znanych ujawnionych fraz odzyskiwania i kluczy prywatnych, których nie można zaimportować.";

