"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Ta sama fraza odzyskiwania połączona z 2 różnymi hasłami wyprowadza 2 oddzielne portfele: portfel A i portfel B.";
"onboarding.passphrase.learn_more.wallets.different" = "Zmiana choć jednego istotnego znaku wyprowadza inne ziarno, a więc także inny portfel. Oryginalny portfel pozostaje bez zmian.";
"onboarding.passphrase.learn_more.wallets.empty" = "Puste hasło otwiera standardowy portfel wywodzący się z samej frazy odzyskiwania. Niepuste hasło otwiera własny, oddzielny portfel.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nie zgłasza „nieprawidłowego hasła”; każde hasło jest prawidłowe, dlatego literówka po cichu otwiera inny portfel — zwykle z zerowym saldem.";
"onboarding.passphrase.learn_more.security.section" = "Jak hasło zwiększa ochronę";
"onboarding.passphrase.learn_more.security.words.title" = "Sama fraza odzyskiwania nie wystarczy";
"onboarding.passphrase.learn_more.security.words.detail" = "Osoba, która uzyska tylko frazę odzyskiwania, nadal potrzebuje dokładnego hasła, aby wyprowadzić chroniony portfel i uzyskać do niego dostęp.";
"onboarding.passphrase.learn_more.security.strength.title" = "Siła hasła wzmacnia ochronę";
"onboarding.passphrase.learn_more.security.strength.detail" = "Długie, nieprzewidywalne hasło znacznie utrudnia odgadnięcie. Krótkie cytaty, daty urodzenia, imiona i ponownie używane hasła można szybko odgadnąć, dlatego zapewniają niewielką ochronę.";
"onboarding.passphrase.learn_more.security.separation.title" = "Przechowuj hasło oddzielnie";
"onboarding.passphrase.learn_more.security.separation.detail" = "Przechowuj hasło oddzielnie od frazy odzyskiwania, aby jedna skradziona kopia zapasowa nie ujawniła obu sekretów potrzebnych do odzyskania portfela.";
"onboarding.passphrase.learn_more.security.footer" = "Hasło nie może chronić środków, gdy oba sekrety zostaną ujawnione, gdy hasło jest słabe lub gdy skompromitowane oprogramowanie przechwyci je podczas wprowadzania danych.";
"onboarding.passphrase.learn_more.safety.section" = "Bezpieczne korzystanie z tej funkcji";
"onboarding.passphrase.learn_more.safety.strong.title" = "Utwórz silne, unikatowe hasło";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Wybierz kilka losowych słów lub inną wartość o wysokiej entropii, używaną tylko w tym portfelu. Unikaj danych osobowych, znanych zwrotów, wzorców i haseł używanych gdzie indziej.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Zapisz hasło oddzielnie";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Utwórz trwałą kopię dokładnego hasła w trybie offline i przechowuj ją oddzielnie od frazy odzyskiwania. Nie polegaj wyłącznie na pamięci.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Każdy znak zmienia portfel";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Wprowadź hasło ponownie dokładnie w takiej postaci, w jakiej je utworzono, łącznie z każdą wielką literą, spacją, znakiem interpunkcyjnym i słowem. Każda różnica po cichu wyprowadza inny portfel.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Sprawdź odzyskiwanie przed wpłatą środków";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Przed otrzymaniem znacznych środków sprawdź w prywatnym, kontrolowanym teście odzyskiwania, czy fraza odzyskiwania i hasło odtwarzają oczekiwane adresy.";
"onboarding.passphrase.learn_more.safety.footer" = "Żadna usługa nie może zresetować ani odzyskać utraconego hasła BIP-39. Bez dokładnego hasła dostęp do tego portfela zostanie trwale utracony — nawet jeśli nadal masz frazę odzyskiwania.";
