"onboarding.carousel.passphrase.visual.accessibility" = "24slovná obnovovací fráze a tajná přístupová fráze BIP-39 odvodí samostatnou peněženku, k jejímuž obnovení jsou nutná obě tajemství.";
"onboarding.carousel.passphrase.learn_more.action" = "Další informace";
"onboarding.passphrase.learn_more.navigation" = "Jak fungují přístupové fráze BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Ze dvou tajemství vzniká jedna peněženka";
"onboarding.passphrase.learn_more.overview" = "Přístupová fráze BIP-39 je volitelný tajný údaj, který se spojuje s obnovovací frází. Společně deterministicky odvodí peněženku odlišnou od peněženky vytvořené pouze obnovovací frází.";
"onboarding.passphrase.learn_more.visual.phrase" = "24slovná obnovovací fráze";
