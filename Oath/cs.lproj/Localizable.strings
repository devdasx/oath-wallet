"onboarding.carousel.entropy.eyebrow" = "ENTROPIE Z FYZICKÝCH VSTUPŮ";
"onboarding.carousel.entropy.title" = "Vytvořte náhodnost, kterou máte plně pod kontrolou.";
"onboarding.carousel.entropy.message" = "Hoďte kostkou, hoďte mincí nebo zaznamenejte náhodné číslice. Oath přímo v tomto zařízení převede váš fyzický vstup přesně na 256 bitů entropie pro 24slovnou obnovovací frázi.";
"onboarding.carousel.entropy.visual.output" = "256 bitů entropie vytvořených uživatelem";
"onboarding.carousel.entropy.visual.local" = "Vytvořeno výhradně z vašich zaznamenaných vstupů";
"onboarding.carousel.entropy.visual.accessibility" = "Kostka s čísly, mince a náhodné číslice společně vytvoří v tomto zařízení 256 bitů entropie peněženky.";
"onboarding.carousel.entropy.learn_more.action" = "Další informace";
"onboarding.entropy.learn_more.navigation" = "Jak funguje fyzická entropie";
"onboarding.entropy.learn_more.path.section" = "Od fyzických výsledků k obnovovacím slovům";
"onboarding.entropy.learn_more.overview" = "Oath zaznamená výsledky z vámi zvoleného fyzického zdroje a převede je na 256bitovou hodnotu. Výsledných 32 bajtů poté předá Wallet Core, který vytvoří standardní obnovovací frázi BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "24slovná obnovovací fráze BIP-39";
"onboarding.entropy.learn_more.visual.bits" = "32 bajtů × 8 bitů = 256 bitů";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Mřížka 256 ukázkových bitových buněk uspořádaných do 32 bajtů.";
"onboarding.entropy.learn_more.visual.accessibility" = "Hody kostkou, hody mincí nebo náhodné číslice se převedou na 256 bitů a poté na 24slovnou obnovovací frázi BIP-39.";
"onboarding.entropy.learn_more.inputs.section" = "Krok 1: Zaznamenejte fyzické výsledky";
"onboarding.entropy.learn_more.inputs.dice.title" = "Házejte vyváženou šestistěnnou kostkou";
"onboarding.entropy.learn_more.inputs.dice.detail" = "U vyvážené kostky přispívají stěny 1–4 každá 2 bity, stěny 5–6 každá 1 bitem.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fyzické hody mincí";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Každý nezávislý hod vyváženou mincí přidá 1 nezaujatý bit entropie.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zaznamenejte náhodné číslice";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Každá číslice 0–7 přispívá 3 bity. Každá číslice 8–9 přispívá 1 bitem. Číslice musí pocházet ze skutečně náhodného fyzického procesu.";
"onboarding.entropy.learn_more.inputs.footer" = "Použijte vyvážený fyzický zdroj a zaznamenávejte všechny výsledky v pořadí. Metody vstupu můžete střídat, protože každý přijatý výsledek přispívá do stejného bitového toku.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sestavte 256bitovou hodnotu";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath převádí výsledky hodů kostkou a desetinné číslice do nezaujatých skupin o velikosti mocniny 2. Délka příspěvků se může lišit, ale vyvážený fyzický zdroj nezvýhodňuje žádnou bitovou hodnotu.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath připojuje bity v pořadí zadání, dokud jich neshromáždí přesně 256. Poté je zabalí do 32 bajtů, od nejvýznamnějšího bitu.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Vlastní entropii tvoří pouze zaznamenané fyzické vstupy; Oath k nim nepřimíchává náhodnost generovanou zařízením.";
"onboarding.entropy.learn_more.bip39.section" = "3. Odvoďte obnovovací frázi";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitů entropie";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8bitový kontrolní součet BIP-39";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bitů rozdělených do 24 jedenáctibitových indexů slov";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "K 256bitové hodnotě entropie se přidá 8bitový kontrolní součet. Vzniklých 264 bitů se rozdělí do 24 jedenáctibitových indexů slov.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 vypočítá SHA-256 z 32bajtové hodnoty entropie a prvních 8 bitů hash hodnoty použije jako kontrolní součet. Jeho připojením vznikne 264 bitů.";
"onboarding.entropy.learn_more.bip39.words" = "264 bitů je rozděleno do 24 skupin po 11 bitech. Každá skupina vybere 1 položku ze standardního seznamu BIP-39 o 2 048 slovech, čímž vznikne 24slovná obnovovací fráze.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core z výsledného seedu deterministicky odvodí účty a adresy. Stejná obnovovací fráze a volitelná přístupová fráze vždy znovu vytvoří stejnou peněženku.";
"onboarding.entropy.learn_more.security.section" = "Jak vlastní entropie posiluje zabezpečení";
"onboarding.entropy.learn_more.security.space.title" = "Obrovský prostor možností";
"onboarding.entropy.learn_more.security.space.detail" = "Rovnoměrná 256bitová entropie obsahuje 2^256 jedinečných hodnot, takže vyčerpávající zkoušení je výpočetně neproveditelné. Jde o velikost vstupního prostoru; neznamená to, že každá kryptografická součást poskytuje 256bitovou odolnost vůči útoku.";
"onboarding.entropy.learn_more.security.source.title" = "Náhodnost pochází od vás";
"onboarding.entropy.learn_more.security.source.detail" = "Fyzické události vám umožňují získat zdroj náhodnosti peněženky nezávisle a nespoléhat se pouze na generátor náhodných čísel v zařízení. Zabezpečení tím posílíte jen tehdy, jsou-li události skutečně náhodné.";
"onboarding.entropy.learn_more.security.local.title" = "Zpracování probíhá výhradně v tomto zařízení";
"onboarding.entropy.learn_more.security.local.detail" = "Oath převádí zaznamenanou sekvenci a vytváří obnovovací frázi výhradně v tomto zařízení. Sekvence se nikdy neodesílá ke zpracování.";
"onboarding.entropy.learn_more.security.patterns.title" = "Nevymýšlejte tajné údaje sami";
"onboarding.entropy.learn_more.security.patterns.detail" = "Dlouhá posloupnost vyvážených, nezávislých událostí je mnohem méně předvídatelná než datum narození, oblíbená čísla, opakující se vzory nebo slova zvolená člověkem.";
"onboarding.entropy.learn_more.security.footer" = "Fyzická entropie nahrazuje náhodnost peněženky generovanou zařízením; nejde o další heslo ani vrstvu zabezpečení.";
"onboarding.entropy.learn_more.safety.section" = "Používejte tuto funkci bezpečně";
"onboarding.entropy.learn_more.safety.fair.title" = "Zaznamenávejte vyvážené a nezávislé výsledky";
"onboarding.entropy.learn_more.safety.fair.detail" = "Použijte vyváženou minci nebo kostku a zajistěte, aby byl každý výsledek nezávislý. Náhodné číslice musí pocházet ze skutečného fyzického zdroje, nikoli z paměti nebo vzoru.";
"onboarding.entropy.learn_more.safety.private.title" = "Uchovejte proces tvorby entropie v soukromí";
"onboarding.entropy.learn_more.safety.private.detail" = "Se zaznamenanou sekvencí i hotovou obnovovací frází zacházejte jako s tajnými údaji peněženky. Chraňte je před kamerami a zraky ostatních.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Přesně zaznamenejte každý výsledek";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Jediný chybějící, duplicitní nebo přehozený výsledek vytvoří jinou peněženku. Než do peněženky vložíte prostředky, zkontrolujte každý záznam a ověřte hotovou obnovovací frázi.";
"onboarding.entropy.learn_more.safety.backup.title" = "Zabezpečte obnovovací frázi";
"onboarding.entropy.learn_more.safety.backup.detail" = "Uchovávejte obnovovací frázi offline a nikdy ji nesdílejte. Po ověření zálohy bezpečně zničte všechny průběžné záznamy vstupů, které už nepotřebujete.";
"onboarding.entropy.learn_more.safety.footer" = "Fyzická entropie nedokáže ochránit zveřejněnou obnovovací frázi, napadené zařízení, škodlivý software ani nesprávně zaznamenanou sekvenci. Pokud nedokážete zaručit vyvážené, soukromé a přesné vstupy, použijte standardní vytvoření peněženky.";
"onboarding.carousel.open_source.eyebrow" = "OD ZÁKLADU S OTEVŘENÝM KÓDEM";
"onboarding.carousel.open_source.title" = "Prohlédněte si zdrojový kód. Ověřte sestavení.";
"onboarding.carousel.open_source.message" = "Oath zveřejňuje svůj zdrojový kód k nezávislé kontrole. Vydání je ověřené pouze tehdy, když reprodukovatelné sestavení odpovídá otisku zveřejněné aplikace.";
