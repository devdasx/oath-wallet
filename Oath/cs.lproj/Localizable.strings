"onboarding.carousel.open_source.visual.match" = "SHODA POTVRZENA — SESTAVENÍ OVĚŘENO";
"onboarding.carousel.open_source.visual.accessibility" = "Diagram znázorňující, že ověření vydání vyžaduje veřejný zdrojový kód, nezávislé reprodukovatelné sestavení a shodné otisky.";
"onboarding.carousel.passphrase.eyebrow" = "VOLITELNÁ PŘÍSTUPOVÁ FRÁZE BIP-39";
"onboarding.carousel.passphrase.title" = "Jedna obnovovací fráze. Jedno další tajemství.";
"onboarding.carousel.passphrase.message" = "Přístupová fráze BIP-39 se spojí s vaší obnovovací frází a vytvoří samostatnou peněženku. Pokud jsou obnovovací slova odhalena, peněženka stále vyžaduje přesnou přístupovou frázi.";
"onboarding.carousel.passphrase.visual.phrase" = "Vašich 24 obnovovacích slov";
