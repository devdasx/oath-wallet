// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Odeslání posunutím nahrazuje potvrzovací tlačítko. Směrová animace, haptika a plynulejší pohyb podporují oba směry čtení. Pro odeslání uvolněte při alespoň 90%; posunutím zpět akci zrušíte.";
"settings.about.history.v355.build56.activity" = "Zvonek otevírá čekající aktivitu. Kapsle transakcí zobrazují stavové odznaky a lze je odsunout. Kapsle potvrzování i potvrzených transakcí se skryjí po 3 sekundách; potvrzení aktualizuje stejnou viditelnou kapsli.";
"settings.about.history.v355.build56.status" = "Spolehlivější stav transakcí ve všech podporovaných sítích, průběžně aktualizované podrobnosti a rychlejší aktualizace zůstatku po odeslání. Sledování čekajících transakcí se obnoví při opětovném otevření aplikace.";
"settings.about.history.v355.build56.fees" = "Návrat ke kontrole stejného převodu zachová zjištěný poplatek. Přehlednější načítání poplatků a upozornění na financování účtu; dostatečné částky již nezobrazují oznámení o aktivaci.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin a Dogecoin přidávají vratnou částku pod hranicí prachu k poplatku místo vytvoření nepoužitelného výstupu. Poplatek při kontrole odpovídá poplatku při podpisu.";
"settings.about.history.v355.build56.stability" = "Opraven pád úlohy na pozadí a upozornění na vypršení času obnovování peněženky. Při dočasném selhání obnovování zůstávají dosavadní informace dostupné.";
"settings.about.history.v355.build56.backup" = "Přehlednější obrazovky zálohování se správnými úvodními názvy a méně zprávami. Přístup k soukromým klíčům respektuje nastavení zámku aplikace. Kompaktní skleněná upozornění při importu vymažou odmítnutý vstup při volbě jiné obnovovací fráze.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Po uvolnění posuvníku pro odeslání se před zavřením kontroly zobrazí animované zatržítko.";
"settings.about.history.v355.build57.activity" = "Řádky aktivity zobrazují stav méně tučným písmem, částku jako podtitulek a šipku pro otevření podrobností transakce.";
"settings.about.history.v355.build57.details" = "Síťové poplatky se nyní zobrazují v souhrnu převodu. Kratší popisky a jediný řádek sítě zpřehledňují podrobnosti.";
"settings.about.history.v355.build57.resume" = "Po návratu z pozadí zůstanou otevřené obrazovky a panely zachovány, včetně kontroly převodu a podrobností transakce.";
"settings.about.history.v355.build57.secrets" = "Obrazovky s obnovovací frází, soukromým klíčem a přístupovou frází se po 20 sekundách mimo aplikaci zavřou. Zámek aplikace se nadále řídí vaším nastavením.";
"settings.about.history.v355.build57.filters" = "Filtry sítí používají o něco vyšší nativní tlačítka s velikostí podle obsahu a opravenými rozestupy pod navigační lištou.";
"settings.about.history.v355.build57.units" = "Samostatné řádky hodnot byly odstraněny. Částka a síťový poplatek se nejprve zobrazí v místní měně; klepnutím přepnete na kryptoměnové jednotky a zpět.";
"wallet.transaction.details.toggle_units" = "Přepnout jednotky.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Domovská obrazovka se otevírá bez prolínání nebo změny velikosti. Tlačítko nastavení nyní používá ikonu ozubeného kola.";
"settings.about.history.v355.build58.fields" = "Pole transakcí a odesílání používají běžné barvy textu. Šipky se zobrazují pouze u řádků, které otevírají obrazovku nebo panel; klepnutí na částku či poplatek stále přepíná jednotky.";
"settings.about.history.v355.build58.banners" = "Po zobrazení zmizí oznámení o probíhajícím či dokončeném potvrzení za 3 sekundy, i když otevřete jinou obrazovku. Dosud nezobrazená potvrzení se objeví po návratu.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Převody TRON nyní před výpočtem odesílané částky vyhradí prostředky na aktivaci a šířku pásma, a to i při odesílání maxima. Kontrola převodu zobrazuje správnou částku po odečtení poplatků.";
"settings.about.history.v355.build59.fees" = "Vlastní poplatky TRON musí pokrýt požadované náklady sítě. Při nízkém zůstatku TRX se nyní zobrazí srozumitelnější pokyny. Množství tokenů se nemění; poplatky se hradí v TRX.";

