"onboarding.passphrase.learn_more.derivation.section" = "Jak BIP-39 odvozuje peněženku";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Obnovovací fráze spojená s přístupovou frází";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 se 2 048 koly";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512bitový hlavní seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Odvozené účty a adresy peněženky";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Obnovovací fráze a přístupová fráze vstoupí do PBKDF2-HMAC-SHA512 na 2 048 kol, čímž vznikne 512bitový seed, ze kterého jsou odvozeny účty peněženek a adresy.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 považuje normalizovanou obnovovací frázi za heslo PBKDF2 a jako sůl používá řetězec „mnemonic“ následovaný normalizovanou přístupovou frází. Po 2 048 kolech PBKDF2-HMAC-SHA512 vznikne 64bajtový seed.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Před odvozením seedu Oath provede normalizaci Unicode vyžadovanou standardem BIP-39, takže stejná normalizovaná obnovovací a přístupová fráze vždy znovu vytvoří stejnou peněženku.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Přístupová fráze obnovovací slova nešifruje. Mění odvozený seed, takže každá odlišná přístupová fráze vytváří jiné účty a adresy.";
"onboarding.passphrase.learn_more.wallets.section" = "Každá přístupová fráze odvozuje samostatnou peněženku";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Ukázková přístupová fráze 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Ukázková přístupová fráze 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Ukázková peněženka A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Ukázková peněženka B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Stejná obnovovací fráze spojená se dvěma různými přístupovými frázemi odvodí dvě samostatné peněženky: Peněženku A a Peněženku B.";
"onboarding.passphrase.learn_more.wallets.different" = "Změna byť jediného významného znaku odvodí jiný seed, a tedy jinou peněženku; původní peněženka zůstane beze změny.";
"onboarding.passphrase.learn_more.wallets.empty" = "Prázdná přístupová fráze otevře standardní peněženku odvozenou pouze z obnovovací fráze. Neprázdná přístupová fráze otevře vlastní samostatnou peněženku.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nevrací chybu „nesprávná přístupová fráze“; každá přístupová fráze je platná, takže překlep bez upozornění otevře jinou peněženku — obvykle s nulovým zůstatkem.";
"onboarding.passphrase.learn_more.security.section" = "Jak přístupová fráze zvyšuje ochranu";
"onboarding.passphrase.learn_more.security.words.title" = "Samotná obnovovací slova nestačí";
"onboarding.passphrase.learn_more.security.words.detail" = "Pokud někdo získá pouze obnovovací frázi, stále potřebuje přesnou přístupovou frázi k odvození a přístupu k chráněné peněžence.";
"onboarding.passphrase.learn_more.security.strength.title" = "Silnější fráze lépe odděluje peněženky";
"onboarding.passphrase.learn_more.security.strength.detail" = "Dlouhá, nepředvídatelná přístupová fráze výrazně ztíží uhodnutí; krátký citát, datum narození, jméno nebo opakovaně používané heslo lze uhodnout rychle a poskytují jen malou ochranu.";
"onboarding.passphrase.learn_more.security.separation.title" = "Uchovávejte přístupovou frázi odděleně";
"onboarding.passphrase.learn_more.security.separation.detail" = "Uložte přístupovou frázi odděleně od obnovovací fráze, aby jediná odcizená záloha neodhalila obě tajemství potřebná k obnovení peněženky.";
"onboarding.passphrase.learn_more.security.footer" = "Přístupová fráze neochrání vaše prostředky, pokud jsou odhalena obě tajemství, fráze je slabá nebo ji při zadávání zachytí napadený software.";
"onboarding.passphrase.learn_more.safety.section" = "Používejte tuto funkci bezpečně";
"onboarding.passphrase.learn_more.safety.strong.title" = "Vytvořte silnou a jedinečnou přístupovou frázi";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Preferujte několik náhodně vybraných slov nebo jinou hodnotu s vysokou entropií použitou pouze pro tuto peněženku. Nespoléhejte na osobní fakta, známé fráze, vzorce nebo hesla používaná jinde.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Zálohujte přístupovou frázi odděleně";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Vytvořte trvalou offline zálohu přesné přístupové fráze a uložte ji odděleně od obnovovací fráze. Nespoléhejte pouze na paměť.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Každý znak mění peněženku";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Zadejte přístupovou frázi přesně tak, jak jste ji vytvořili, včetně všech velkých písmen, mezer, interpunkčních znamének a slov. Jakýkoli rozdíl bez upozornění odvodí jinou peněženku.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Před vložením prostředků ověřte obnovení";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Než přijmete větší objem prostředků, proveďte v soukromí kontrolovaný test obnovení a ověřte, že obnovovací a přístupová fráze znovu vytvoří očekávané adresy.";
"onboarding.passphrase.learn_more.safety.footer" = "Žádná služba nedokáže ztracenou přístupovou frázi resetovat ani obnovit. Bez přesné přístupové fráze je přístup k dané peněžence navždy ztracen — i když stále máte obnovovací frázi.";
