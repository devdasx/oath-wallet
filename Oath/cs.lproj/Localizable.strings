"settings.about.history.v356.welcome.title" = "Nové přivítání";
"settings.about.history.v356.welcome" = "Nová uvítací obrazovka s animovanými kresbami a jasnými možnostmi pro vytvoření nebo import peněženky.";
"settings.about.history.v357.tour.title" = "Úvodní prohlídka";
"settings.about.history.v357.tour" = "Pětistránková prohlídka představuje podporované sítě, fyzickou entropii, odesílání a přijímání, zabezpečení a ověřená sestavení. Mezi stránkami přejíždějte prstem nebo klepejte na tečky; přepínač jazyka je v navigačním panelu.";
"settings.about.history.v357.backup" = "Po vytvoření, importu nebo obnovení peněženky se obrazovka zobrazí okamžitě a možnosti zálohování používají standardní seznam. Kontrola iCloudu probíhá na pozadí a tlačítko Otevřít peněženku je připravené, jakmile je peněženka uložena.";
"settings.about.history.v357.reliability" = "Návrat z pozadí už nezavře obrazovku nastavení, když vyprší skrytá obrazovka obnovy, a vymazání všech dat otevře úvodní obrazovku přímo.";
"settings.about.history.v357.notifications" = "Nastavení oznámení používá pro kategorie a stav srozumitelnější formulace bez technických podrobností.";
"settings.about.history.v357.wallets" = "Peněženky v přepínači přeuspořádáte dlouhým stisknutím se systémovou animací zvednutí; klepnutí na řádek peněženku aktivuje. Ověření fráze pro obnovu čísluje každé slovo a klávesa Return přechází na další pole.";
"settings.about.history.v357.send" = "Během převodu se při odesílání zobrazuje částka, při neúspěchu se objeví srozumitelnější zpráva a požadavky TRON se po dočasných chybách poskytovatele automaticky opakují.";
"settings.about.history.v357.security" = "Importované účty TRON, jejichž oprávnění vlastníka bylo přesunuto na jiný klíč, nyní zobrazují varování a nemohou odesílat, i když každé oprávnění uvádí jediný klíč. Při importu je odmítnuto více známých prozrazených frází pro obnovu a soukromých klíčů.";
"settings.about.history.v356.localization" = "Texty uvítací obrazovky jsou ve všech podporovaných jazycích přirozenější a srozumitelnější.";
