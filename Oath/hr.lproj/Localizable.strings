// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Povucite za slanje zamjenjuje gumb za potvrdu. Usmjerena animacija, haptički odziv i glađi pokret podržavaju oba smjera čitanja. Otpustite na najmanje 90% za slanje; povucite natrag za odustajanje.";
"settings.about.history.v355.build56.activity" = "Zvono otvara aktivnosti na čekanju. Kapsule transakcija prikazuju oznake statusa i mogu se ukloniti povlačenjem. Kapsule potvrđivanja i potvrđenih transakcija nestaju nakon 3 sekunde; potvrda ažurira istu vidljivu kapsulu.";
"settings.about.history.v355.build56.status" = "Pouzdaniji status transakcija na svim podržanim mrežama, ažurni detalji i brže osvježavanje stanja sredstava nakon slanja. Praćenje transakcija na čekanju nastavlja se ponovnim otvaranjem aplikacije.";
"settings.about.history.v355.build56.fees" = "Povratak na pregled istog prijenosa zadržava dobivenu naknadu. Jasnije učitavanje naknada i upozorenja o financiranju računa; dovoljni iznosi više ne prikazuju obavijesti o aktivaciji.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin i Dogecoin ostatak ispod praga prašine dodaju naknadi umjesto stvaranja neupotrebljivog izlaza. Naknada u pregledu odgovara naknadi pri potpisivanju.";
"settings.about.history.v355.build56.stability" = "Ispravljeni su rušenje pozadinskog zadatka i upozorenja o isteku vremena osvježavanja novčanika. Postojeći podaci ostaju dostupni pri privremenim pogreškama osvježavanja.";
"settings.about.history.v355.build56.backup" = "Pregledniji zasloni sigurnosnog kopiranja s ispravnim naslovima pri otvaranju i manje poruka. Pristup privatnim ključevima poštuje postavke zaključavanja aplikacije. Kompaktna staklena upozorenja pri uvozu brišu odbijeni unos kada odaberete drugu frazu za oporavak.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Nakon što otpustite klizač za slanje, pojavljuje se animirana kvačica prije zatvaranja pregleda.";
"settings.about.history.v355.build57.activity" = "Redci aktivnosti prikazuju status tanjim slovima, iznos kao podnaslov i strelicu za otvaranje pojedinosti transakcije.";
"settings.about.history.v355.build57.details" = "Mrežne naknade sada su u sažetku prijenosa. Kraći nazivi i samo jedan redak za mrežu čine pojedinosti preglednijima.";
"settings.about.history.v355.build57.resume" = "Pri povratku iz pozadine zadržavaju se otvoreni zasloni i paneli, uključujući pregled prijenosa i pojedinosti transakcije.";
"settings.about.history.v355.build57.secrets" = "Zasloni s frazom za oporavak, privatnim ključem i pristupnom frazom zatvaraju se nakon 20 sekundi izbivanja. Zaključavanje aplikacije i dalje slijedi vaše postavke.";
"settings.about.history.v355.build57.filters" = "Mrežni filtri koriste malo više izvorne gumbe, veličinu prilagođenu sadržaju i ispravljen razmak ispod navigacijske trake.";
"settings.about.history.v355.build57.units" = "Uklonjeni su zasebni redci vrijednosti. Iznos i mrežna naknada prvo se prikazuju u lokalnoj valuti; dodirnite ih za prebacivanje na kriptojedinice i natrag.";
