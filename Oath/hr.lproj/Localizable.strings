"onboarding.passphrase.learn_more.derivation.section" = "Kako BIP-39 izvodi novčanik";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Fraza za oporavak kombinirana s lozinkom";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 s 2.048 rundi";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bitni glavni ključ";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Izvedeni novčanici i adrese";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Vaša fraza za oporavak i lozinka prolaze kroz 2.048 rundi PBKDF2-HMAC-SHA512 kako bi se proizveo 512-bitni seed iz kojeg se izvode računi i adrese novčanika.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 tretira normaliziranu frazu za oporavak kao PBKDF2 lozinku i koristi „mnemonic“ nakon kojeg slijedi normalizirana lozinka kao sol. Nakon 2.048 rundi PBKDF2-HMAC-SHA512, proces generira sjeme od 64 bajta.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Prije nego što se izvede sjeme, Oath primjenjuje Unicode normalizaciju koju zahtijeva BIP-39 tako da ista normalizirana fraza za oporavak i lozinka uvijek reproduciraju isti novčanik.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Lozinka ne šifrira vaše riječi za oporavak. Ona mijenja izvedeno sjeme, pa svaka drugačija lozinka stvara različite račune i adrese.";
"onboarding.passphrase.learn_more.wallets.section" = "Svaka lozinka generira zaseban novčanik";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Primjer lozinke 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Primjer lozinke 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Primjer Novčanik A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Primjer Novčanik B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Ista fraza za oporavak u kombinaciji s dvije različite lozinke stvara dva odvojena novčanika: Novčanik A i Novčanik B.";
"onboarding.passphrase.learn_more.wallets.different" = "Promjena čak i jednog značajnog znaka dovodi do drugog sjemena, a time i drugog novčanika; izvorni novčanik ostaje nepromijenjen.";
"onboarding.passphrase.learn_more.wallets.empty" = "Prazna lozinka otvara standardni novčanik izveden samo iz fraze za oporavak; lozinka koja nije prazna otvara vlastiti zasebni novčanik.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nema odgovor „pogrešna lozinka“; svaka lozinka je valjana, pa tipfeler tiho otvara drugi novčanik—obično s nulom na računu.";
"onboarding.passphrase.learn_more.security.section" = "Kako lozinka dodaje zaštitu";
"onboarding.passphrase.learn_more.security.words.title" = "Same riječi za oporavak nisu dovoljne";
"onboarding.passphrase.learn_more.security.words.detail" = "Netko tko dobije samo vašu frazu za oporavak još uvijek treba točnu lozinku kako bi izveo i pristupio zaštićenom novčaniku.";
"onboarding.passphrase.learn_more.security.strength.title" = "Snaga stvara bolju separaciju";
"onboarding.passphrase.learn_more.security.strength.detail" = "Duga, nepredvidiva lozinka dodaje značajnu težinu pogađanju; kratki citat, rođendan, ime ili ponovno korištena lozinka može se brzo pogoditi i pruža malu zaštitu.";
"onboarding.passphrase.learn_more.security.separation.title" = "Držite zaporku odvojeno";
"onboarding.passphrase.learn_more.security.separation.detail" = "Spremite lozinku odvojeno od fraze za oporavak kako jedna ukradena sigurnosna kopija ne bi otkrila obje tajne potrebne za obnovu novčanika.";
"onboarding.passphrase.learn_more.security.footer" = "Lozinka ne može zaštititi vaša sredstva ako su obje tajne otkrivene, ako je lozinka slaba ili ako je kompromitirani softver zabilježi dok je upisujete.";
"onboarding.passphrase.learn_more.safety.section" = "Sigurno koristite ovu funkciju";
"onboarding.passphrase.learn_more.safety.strong.title" = "Stvorite snažnu, jedinstvenu lozinku";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Odaberite nekoliko nasumičnih riječi ili neku drugu vrijednost visoke entropije koja je jedinstvena za ovaj novčanik. Izbjegavajte osobne podatke, poznate izraze, obrasce i lozinke koje koristite drugdje.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Sigurnosno kopirajte frazu zasebno";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Napravite trajnu offline kopiju točne lozinke, pohranite je odvojeno od fraze za oporavak i nikada se nemojte oslanjati samo na pamćenje.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Svaki karakter mijenja novčanik";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Ponovno unesite zaporku točno onako kako je stvorena, uključujući svako veliko slovo, razmak, znak interpunkcije i riječ. Bilo koja razlika tiho stvara drugi novčanik.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Provjerite oporavak prije dodavanja sredstava";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Prije primanja značajnih sredstava, izvršite privatni, kontrolirani test oporavka kako biste potvrdili da fraza za oporavak i lozinka reproduciraju očekivane adrese.";
"onboarding.passphrase.learn_more.safety.footer" = "Nijedna usluga ne može resetirati ili povratiti izgubljenu lozinku. Bez točne lozinke, pristup tom novčaniku je trajno izgubljen—čak i ako još uvijek imate frazu za oporavak.";
