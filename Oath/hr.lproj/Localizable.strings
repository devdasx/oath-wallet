"onboarding.carousel.passphrase.eyebrow" = "NEOBAVEZNA BIP-39 LOZINKA";
"onboarding.carousel.passphrase.title" = "Jedna fraza za oporavak. Jedna dodatna tajna.";
"onboarding.carousel.passphrase.message" = "BIP-39 lozinka kombinira se s vašom frazom za oporavak kako bi se dobio zaseban novčanik. Čak i ako su riječi za oporavak izložene, pristup tom novčaniku i dalje zahtijeva točnu lozinku.";
