"onboarding.carousel.entropy.eyebrow" = "ENTROPIJA IZ FIZIČKIH ULAZA";
"onboarding.carousel.entropy.title" = "Stvorite slučajnost koju u potpunosti kontrolirate.";
"onboarding.carousel.entropy.message" = "Bacajte kocku, okrenite novčić ili zabilježite nasumične znamenke. Oath pretvara vaš fizički unos u točno 256 bita entropije za 24-riječnu frazu za oporavak, potpuno na vašem uređaju.";
"onboarding.carousel.entropy.visual.output" = "256 bita korisnički generirane entropije";
"onboarding.carousel.entropy.visual.local" = "Potpuno generirano iz vaših snimljenih unosa";
"onboarding.carousel.entropy.visual.accessibility" = "Bacanje označene kocke, novčića i nasumičnih znamenki kombinira se kako bi na ovom uređaju proizvelo 256 bita entropije novčanika.";
"onboarding.carousel.entropy.learn_more.action" = "Istraži više detalja";
"onboarding.entropy.learn_more.navigation" = "Kako fizička entropija funkcionira";
"onboarding.entropy.learn_more.path.section" = "Od fizičkih ishoda do riječi o oporavku";
"onboarding.entropy.learn_more.overview" = "Oath bilježi rezultate s vašeg odabranog fizičkog izvora i pretvara ih u 256-bitnu vrijednost. Dobivenih 32 bajta zatim se prosljeđuje Wallet Coreu kako bi se stvorila standardna BIP-39 fraza za oporavak.";
"onboarding.entropy.learn_more.visual.phrase" = "24-riječna BIP-39 fraza za oporavak";
"onboarding.entropy.learn_more.visual.bits" = "32 bajta × 8 bita jednako je 256 bita";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Mreža od 256 uzornih bit ćelija raspoređenih u 32 bajta.";
"onboarding.entropy.learn_more.visual.accessibility" = "Bacanja kocke, bacanja novčića ili nasumične znamenke pretvaraju se u 256 bita, a zatim u 24-riječnu BIP-39 frazu za oporavak.";
"onboarding.entropy.learn_more.inputs.section" = "Korak 1: Zabilježite fizičke rezultate";
"onboarding.entropy.learn_more.inputs.dice.title" = "Baci pošteni kocku sa šest stranica";
"onboarding.entropy.learn_more.inputs.dice.detail" = "S poštenim kockom, lica 1–4 svaki doprinose 2 bita; lica 5–6 svaki doprinose 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fizičko bacanje novčića";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Svako pošteno, neovisno okretanje novčića doprinosi jednom nepristranom bitu entropije.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zabilježite slučajne znamenke";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cifre 0–7 svaka doprinosi 3 bita; cifre 8–9 svaka doprinosi 1 bitu. Cifre moraju dolaziti iz stvarnog slučajnog fizičkog procesa.";
"onboarding.entropy.learn_more.inputs.footer" = "Koristite pošteni fizički izvor i zabilježite svaki rezultat redom. Možete mijenjati metode unosa jer svaki prihvaćeni rezultat doprinosi istom bitnom nizu.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sastavite 256-bitnu vrijednost";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath pretvara rezultate kockica i decimalne znamenke u nepristrane skupine snage dvojke. Duljine doprinosa mogu varirati, ali pošten fizički izvor ne favorizira nijednu vrijednost bitova.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath dodaje bitove redom kojim su uneseni sve dok ne prikupi točno 256, zatim ih pakira u 32 bajta s najznačajnijim bitom prvi.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Prilagođena entropija sadrži samo fizičke ulaze koje bilježite; Apertura ne miješa nasumičnost generiranu uređajem.";
"onboarding.entropy.learn_more.bip39.section" = "3. Izvedite frazu za oporavak";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bita entropije";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-bitni BIP-39 kontrolni zbroj";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bita podijeljeno u 24 indeksa riječi od jedanaest bita";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Vrijednost entropije od 256 bita prima kontrolni zbroj od 8 bita, što rezultira s 264 bita koja se dijele na 24 indeksa riječi od jedanaest bitova.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 izračunava SHA-256 nad 32-bajtnom vrijednošću entropije i uzima prvih 8 bitova heša kao kontrolni zbroj; dodavanje tog kontrolnog zbroja daje 264 bita.";
"onboarding.entropy.learn_more.bip39.words" = "264 bita su podijeljena u 24 grupe po 11 bita. Svaka grupa odabire jedan unos s standardne BIP-39 liste od 2.048 riječi kako bi se proizvela 24-riječena fraza za oporavak.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core izvodi determinističke račune i adrese iz dobivene sjemenke. Ista fraza za oporavak i opcionalna zaporka uvijek će recreirati isti novčanik.";
"onboarding.entropy.learn_more.security.section" = "Kako prilagođena entropija jača sigurnost";
"onboarding.entropy.learn_more.security.space.title" = "Ogroman prostor mogućnosti";
"onboarding.entropy.learn_more.security.space.detail" = "Jednolikih 256-bitnih entropija sadrži 2^256 jedinstvenih vrijednosti, što čini iscrpno pogodavanje računalno nepraktičnim. Ovo opisuje veličinu ulaznog prostora; ne implicira da svaki kriptografski komponenta pruža otpornost na napade od 256 bita.";
"onboarding.entropy.learn_more.security.source.title" = "Slučajnost dolazi od tebe";
"onboarding.entropy.learn_more.security.source.detail" = "Fizički događaji omogućuju vam da neovisno generirate slučajnost novčanika umjesto da se oslanjate samo na generator slučajnih brojeva uređaja. To poboljšava sigurnost samo kada ti događaji zaista budu nasumični.";
"onboarding.entropy.learn_more.security.local.title" = "U potpunosti obrađeno na ovom uređaju";
"onboarding.entropy.learn_more.security.local.detail" = "Oath pretvara vašu snimljenu sekvencu i stvara frazu za oporavak potpuno na ovom uređaju. Vaša se sekvenca nikada ne prenosi radi obrade.";
"onboarding.entropy.learn_more.security.patterns.title" = "Izbjegavajte tajne odabrane od strane ljudi";
"onboarding.entropy.learn_more.security.patterns.detail" = "Duga sekvenca poštenih, neovisnih događaja daleko je manje predvidiva od rođendana, omiljenih brojeva, ponovljenih obrazaca ili riječi koje odabere osoba.";
"onboarding.entropy.learn_more.security.footer" = "Fizička entropija zamjenjuje nasumičnost novčanika koju generira uređaj; nije dodatna lozinka ili sloj sigurnosti.";
"onboarding.entropy.learn_more.safety.section" = "Sigurno koristite ovu funkciju";
"onboarding.entropy.learn_more.safety.fair.title" = "Sajam ploča, Neovisni rezultati";
"onboarding.entropy.learn_more.safety.fair.detail" = "Koristite poštenu kovanicu ili kocku i osigurajte da je svaki rezultat neovisan. Slučajni brojevi moraju dolaziti iz stvarnog fizičkog izvora—ne iz memorije ili uzorka.";
"onboarding.entropy.learn_more.safety.private.title" = "Držite svoj proces entropije privatnim";
"onboarding.entropy.learn_more.safety.private.detail" = "Zaštitite i snimljeni niz i dovršenu frazu za oporavak kao tajne novčanika. Držite ih izvan vidokruga kamera i drugih ljudi.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Zabilježite svaki rezultat točno";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Jedan nedostajući, duplicirani ili preraspoređeni rezultat stvara drugačiji novčanik. Pregledajte svaki unos i provjerite dovršenu frazu za oporavak prije nego što uložite sredstva u novčanik.";
"onboarding.entropy.learn_more.safety.backup.title" = "Osigurajte frazu za oporavak";
"onboarding.entropy.learn_more.safety.backup.detail" = "Držite frazu za oporavak izvan mreže i nikada je ne dijelite. Nakon provjere vaše sigurnosne kopije, sigurno uništite sve privremene zapise koje više ne trebate.";
"onboarding.entropy.learn_more.safety.footer" = "Fizička entropija ne može osigurati izloženu frazu za oporavak, kompromitirani uređaj, zlonamjerni softver ili netočno zabilježenu sekvencu. Ako ne možete jamčiti pošten unos, privatnost i točnost, umjesto toga koristite standardno stvaranje novčanika.";
