// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Početni zaslon otvara se bez efekata postupnog pojavljivanja ili promjene veličine. Gumb postavki sada koristi ikonu zupčanika.";
"settings.about.history.v355.build58.fields" = "Polja transakcija i slanja koriste uobičajene boje teksta. Strelice se prikazuju samo u redcima koji otvaraju zaslon ili panel; dodir iznosa i naknada i dalje mijenja jedinicu prikaza.";
"settings.about.history.v355.build58.banners" = "Nakon prikazivanja obavijesti o potvrđivanju ili potvrdi nestaju za 3 sekunde, čak i ako otvorite drugi zaslon. Potvrde koje još nisu prikazane pojavljuju se kad se vratite.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Prijenosi TRON sada odvajaju sredstva za aktivaciju i propusnost prije izračuna iznosa za slanje, uključujući slanje maksimalnog iznosa. Pregled prikazuje točan iznos nakon odbitka naknada.";
"settings.about.history.v355.build59.fees" = "Prilagođene naknade za TRON moraju pokriti potrebne mrežne troškove. Pri niskom saldu TRX sada se prikazuju jasnije upute. Količina tokena ostaje nepromijenjena; naknade se plaćaju u TRX-u.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Nova dobrodošlica";
"settings.about.history.v356.welcome" = "Novi zaslon dobrodošlice s animiranim ilustracijama i jasnim opcijama za izradu ili uvoz novčanika.";
"settings.about.history.v357.tour.title" = "Uvodni obilazak";
"settings.about.history.v357.tour" = "Obilazak od pet stranica predstavlja podržane mreže, fizičku entropiju, slanje i primanje, sigurnost i provjerene verzije. Prijeđite prstom ili dodirnite točke za promjenu stranice; izbornik jezika nalazi se u navigacijskoj traci.";
"settings.about.history.v357.backup" = "Nakon stvaranja, uvoza ili obnove novčanika zaslon se pojavljuje odmah, a opcije sigurnosne kopije koriste standardni popis. Provjera iClouda odvija se u pozadini, a Otvori novčanik spreman je čim se novčanik spremi.";
"settings.about.history.v357.reliability" = "Povratak iz pozadine više ne zatvara zaslon postavljanja kad istekne skriveni zaslon oporavka, a brisanje svih podataka izravno otvara zaslon dobrodošlice.";
