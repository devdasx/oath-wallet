"onboarding.passphrase.learn_more.path.section" = "Dve tajne vode do jednog novčanika";
"onboarding.passphrase.learn_more.overview" = "BIP-39 lozinka je opcionalna tajna koja se kombinira s vašom frazom za oporavak. Zajedno deterministički stvaraju novčanik koji se razlikuje od onog koji se stvara samo pomoću fraze za oporavak.";
"onboarding.passphrase.learn_more.visual.phrase" = "Vaša 24-riječna fraza za oporavak";
"onboarding.passphrase.learn_more.visual.passphrase" = "Vaša tajna lozinka";
