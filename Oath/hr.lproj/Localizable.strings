"settings.about.history.v357.wallets" = "Presložite novčanike u izborniku dugim pritiskom uz sistemsku animaciju podizanja; dodir retka aktivira ga. Provjera fraze za oporavak numerira svaku riječ, a tipka Return prelazi na sljedeće polje.";
"settings.about.history.v357.send" = "Slanje prikazuje iznos dok je prijenos u tijeku, jasnija poruka pojavljuje se ako se ne može poslati, a TRON zahtjevi automatski se ponavljaju nakon privremenih pogrešaka pružatelja.";
"settings.about.history.v357.security" = "Uvezeni TRON računi čije je vlasničko dopuštenje premješteno na drugi ključ sada prikazuju upozorenje i ne mogu slati, čak i kada svako dopuštenje navodi samo jedan ključ. Više poznatih izloženih fraza za oporavak i privatnih ključeva odbija se pri uvozu.";
"settings.about.history.v356.localization" = "Tekst na zaslonu dobrodošlice sada je prirodniji i jasniji na svim podržanim jezicima.";
"settings.about.history.v356.pricing" = "Cijene tokena sada odgovaraju točnoj mreži i adresi tokena, prvo koristeći DEX cijene. Male cijene prikazuju se do 8 decimala bez zaokruživanja.";
"settings.about.history.v356.appearance" = "Primarni i sekundarni gumbi sada koriste dosljedne visine i margine zaslona, s plavom bojom sustava za primarne radnje.";
