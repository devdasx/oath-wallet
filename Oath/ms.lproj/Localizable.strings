"onboarding.carousel.wallet.visual.networks" = "Paparan Bersepadu di Pelbagai Rangkaian";
"onboarding.carousel.wallet.visual.accessibility" = "Pratonton Oath yang menunjukkan baki dompet; butang hantar, terima, dan imbas; serta aset Ethereum dan Bitcoin.";
"onboarding.carousel.entropy.eyebrow" = "ENTROPI DARIPADA INPUT FIZIKAL";
"onboarding.carousel.entropy.title" = "Cipta Kerawakan yang Sepenuhnya anda Kendalikan.";
"onboarding.carousel.entropy.message" = "Baling dadu, lambung syiling, atau catat digit rawak. Oath menukar input fizikal anda menjadi tepat 256 bit entropi untuk frasa pemulihan 24 kata, seluruhnya pada peranti anda.";
"onboarding.carousel.entropy.visual.output" = "256 Bit Entropi Ciptaan anda";
"onboarding.carousel.entropy.visual.local" = "Dihasilkan Sepenuhnya daripada Input yang anda Catat";
"onboarding.carousel.entropy.visual.accessibility" = "Dadu bernombor, syiling, dan digit rawak digabungkan untuk menghasilkan 256 bit entropi dompet pada peranti ini.";
"onboarding.carousel.entropy.learn_more.action" = "Terokai Butiran Lanjut";
"onboarding.entropy.learn_more.navigation" = "Cara Kerja Entropi Fizikal";
"onboarding.entropy.learn_more.path.section" = "Daripada Hasil Fizikal hingga Kata Pemulihan";
"onboarding.entropy.learn_more.overview" = "Oath mencatat hasil daripada sumber fizikal pilihan anda dan mengubahnya menjadi nilai 256 bit. Sebanyak 32 byte yang dihasilkan kemudian diteruskan ke Wallet Core untuk mencipta frasa pemulihan BIP-39 standard.";
"onboarding.entropy.learn_more.visual.phrase" = "Frasa Pemulihan BIP-39 24 Kata";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit sama dengan 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Kisi mengandungi 256 sel bit contoh yang disusun menjadi 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Balingan dadu, lambungan syiling, atau digit rawak ditukar menjadi 256 bit, lalu menjadi frasa pemulihan BIP-39 24 kata.";
"onboarding.entropy.learn_more.inputs.section" = "Langkah 1: Catat Hasil Fizikal";
"onboarding.entropy.learn_more.inputs.dice.title" = "Baling Dadu Enam Sisi yang Adil";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Dengan dadu yang adil, sisi 1–4 setiap satu menyumbang 2 bit; sisi 5–6 setiap satu menyumbang 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lambungan Syiling Fizikal";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Setiap lambungan syiling yang adil dan bebas menyumbang satu bit entropi tanpa berat sebelah.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Catat Digit Rawak";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Digit 0–7 setiap satu menyumbang 3 bit; digit 8–9 setiap satu menyumbang 1 bit. Digit tersebut mesti berasal daripada proses fizikal yang betul-betul rawak.";
"onboarding.entropy.learn_more.inputs.footer" = "Gunakan sumber fizikal yang adil dan catat setiap hasil secara mengikut turutan. anda boleh bertukar kaedah input kerana setiap hasil yang diterima menyumbang kepada aliran bit yang sama.";
"onboarding.entropy.learn_more.conversion.section" = "2. Susun Nilai 256 Bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath menukar hasil dadu dan digit perpuluhan menjadi kumpulan berpangkat dua tanpa berat sebelah. Panjang sumbangan boleh berbeza-beza, tetapi sumber fizikal yang adil tidak mengutamakan nilai bit apa-apa.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath menambah bit sesuai urutan input hingga terkumpul tepat 256 bit, lalu mengemasnya menjadi 32 byte dengan bit paling bererti terlebih dahulu.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropi tersuai hanya mengandungi input fizikal yang anda catat; Oath tidak mencampurkan kerawakan yang dihasilkan peranti.";
"onboarding.entropy.learn_more.bip39.section" = "3. Turunkan Frasa Pemulihan";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 Bit Entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Checksum BIP-39 8 Bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit dibahagikan menjadi 24 indeks kata 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Nilai entropi 256-bit ditambah checksum 8-bit menghasilkan 264 bit, yang dibahagikan menjadi 24 indeks kata yang setiap satu 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 menghitung SHA-256 atas nilai entropi 32 byte dan mengambil 8 bit hash pertama sebagai checksum; penambahan checksum tersebut menghasilkan 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "Sebanyak 264 bit dibahagikan menjadi 24 kumpulan yang setiap satu mengandungi 11 bit. Setiap kumpulan memilih satu entri daripada senarai standard BIP-39 mengandungi 2.048 kata untuk menghasilkan frasa pemulihan 24 kata.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core menerbitkan akaun dan alamat deterministik daripada benih yang dihasilkan. Frasa pemulihan dan frasa laluan pilihan yang sama akan sentiasa mencipta semula dompet yang sama.";
"onboarding.entropy.learn_more.security.section" = "Cara Entropi Tersuai Memperkuat Keselamatan";
"onboarding.entropy.learn_more.security.space.title" = "Ruang Kemungkinan yang Amat Besar";
"onboarding.entropy.learn_more.security.space.detail" = "Entropi 256 bit yang seragam mengandungi 2^256 nilai unik sehingga tekaan menyeluruh tidak layak secara pengkomputeran. Ini menerangkan saiz ruang input; bukan bermakna setiap komponen kriptografi memberikan rintangan serangan 256 bit.";
"onboarding.entropy.learn_more.security.source.title" = "Kerawakan Berasal daripada anda";
"onboarding.entropy.learn_more.security.source.detail" = "Peristiwa fizikal membolehkan anda memperoleh kerawakan dompet secara bebas, bukan hanya bergantung pada penjana nombor rawak peranti. Keselamatan hanya meningkat jika peristiwa tersebut betul-betul rawak.";
"onboarding.entropy.learn_more.security.local.title" = "Diproses Sepenuhnya di Peranti Ini";
"onboarding.entropy.learn_more.security.local.detail" = "Oath menukar urutan yang anda catat dan mencipta frasa pemulihan sepenuhnya pada peranti ini. Urutan anda tidak pernah dimuat naik untuk diproses.";
"onboarding.entropy.learn_more.security.patterns.title" = "Hindaripada Rahsia Ciptaan Manusia";
"onboarding.entropy.learn_more.security.patterns.detail" = "Urutan panjang daripada peristiwa yang adil dan bebas jauh lebih sukar diramal daripada tarikh lahir, nombor kegemaran, corak berulang, atau kata pilihan seseorang.";
"onboarding.entropy.learn_more.security.footer" = "Entropi fizikal menggantikan kerawakan dompet yang dihasilkan peranti; entropi ini bukan kata laluan tambahan atau lapisan keselamatan lain.";
"onboarding.entropy.learn_more.safety.section" = "Gunakan Ciri Ini dengan Selamat";
"onboarding.entropy.learn_more.safety.fair.title" = "Catat Hasil yang Adil dan Bebas";
"onboarding.entropy.learn_more.safety.fair.detail" = "Gunakan syiling atau dadu yang adil dan pastikan setiap hasil bersifat bebas. Digit rawak mesti berasal daripada sumber fizikal yang betul-betul rawak, bukan daripada ingatan atau corak.";
"onboarding.entropy.learn_more.safety.private.title" = "Jaga Kerahsiaan Proses Entropi anda";
"onboarding.entropy.learn_more.safety.private.detail" = "Lindungi urutan yang dicatat dan frasa pemulihan yang telah selesai sebagai rahsia dompet. Jauhkan kedua-duanya daripada pandangan kamera dan orang lain.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Catat Setiap Hasil dengan Tepat";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Satu hasil yang hilang, berulang, atau berubah urutan akan mencipta dompet berbeza. Semak setiap entri dan pengesahan frasa pemulihan yang telah selesai sebelum menambah dana ke dompet.";
"onboarding.entropy.learn_more.safety.backup.title" = "Lindungi Frasa Pemulihan";
"onboarding.entropy.learn_more.safety.backup.detail" = "Simpan frasa pemulihan secara luar talian dan jangan pernah berkongsinya. Selepas mengesahkan sandaran, musnahkan dengan selamat semua nota input perantaraan yang tidak lagi anda perlukan.";
"onboarding.entropy.learn_more.safety.footer" = "Entropi fizikal tidak boleh melindungi frasa pemulihan yang terdedah, peranti yang diceroboh, perisian berbahaya, atau urutan yang salah dicatat. Jika anda tidak boleh menjamin input yang adil, rahsia, dan tepat, gunakan penciptaan dompet standard.";
"onboarding.carousel.open_source.eyebrow" = "DIRANCANG DENGAN SUMBER TERBUKA";
"onboarding.carousel.open_source.title" = "Semak Sumber. Sahkan Binaan.";
"onboarding.carousel.open_source.message" = "Oath menerbitkan kod sumbernya supaya boleh disemak secara bebas. Keluaran hanya disahkan jika binaan yang boleh dihasilkan semula sepadan dengan cap jari aplikasi yang diterbitkan.";
"onboarding.carousel.open_source.action.github" = "Semak di GitHub";
"onboarding.carousel.open_source.visual.repository" = "Repositori Sumber Awam";
"onboarding.carousel.open_source.visual.repository.path" = "Lihat github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Semak Kod Sumber";
"onboarding.carousel.open_source.visual.rebuild" = "Hasilkan Semula Binaan Keluaran";
"onboarding.carousel.open_source.visual.compare" = "Bandingkan Artifak Binaan";
"onboarding.carousel.open_source.visual.fingerprint" = "Cap Jari Keluaran yang Diterbitkan";
"onboarding.carousel.open_source.visual.match" = "PADANAN DISAHKAN — BINAAN DISAHKAN";
"onboarding.carousel.open_source.visual.accessibility" = "Rajah yang menunjukkan bahawa pengesahan keluaran memerlukan kod sumber awam, binaan semula bebas, dan cap jari yang sepadan.";
"onboarding.carousel.passphrase.eyebrow" = "FRASA SANDI BIP-39 PILIHAN";
"onboarding.carousel.passphrase.title" = "Satu Frasa Pemulihan. Satu Rahsia Tambahan.";
"onboarding.carousel.passphrase.message" = "Frasa laluan BIP-39 digabungkan dengan frasa pemulihan anda untuk menerbitkan dompet berasingan. Walaupun kata pemulihan terdedah, dompet tersebut tetap memerlukan frasa laluan yang tepat untuk diakses.";
"onboarding.carousel.passphrase.visual.phrase" = "24 Kata Pemulihan anda";
"onboarding.carousel.passphrase.visual.passphrase" = "Frasa Laluan Rahsia Tambahan anda";
"onboarding.carousel.passphrase.visual.output" = "Dompet Berasingan dengan Frasa Laluan";
"onboarding.carousel.passphrase.visual.requirement" = "Kedua Rahsia Diperlukan untuk Pemulihan";
"onboarding.carousel.passphrase.visual.accessibility" = "Frasa pemulihan 24 kata digabungkan dengan frasa laluan rahsia BIP-39 untuk mencipta dompet berasingan yang memerlukan kedua rahsia tersebut untuk pemulihan.";
"onboarding.carousel.passphrase.learn_more.action" = "Terokai Butiran Lanjut";
"onboarding.passphrase.learn_more.navigation" = "Memahami Frasa Laluan BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dua Rahsia Menerbitkan Satu Dompet";
"onboarding.passphrase.learn_more.overview" = "Frasa laluan BIP-39 ialah rahsia pilihan yang digabungkan dengan frasa pemulihan anda. Kedua-duanya secara deterministik menerbitkan dompet yang berbeza daripada dompet yang dicipta hanya dengan frasa pemulihan.";
"onboarding.passphrase.learn_more.visual.phrase" = "Frasa Pemulihan 24 Kata anda";
"onboarding.passphrase.learn_more.visual.passphrase" = "Frasa Laluan Rahsia anda";
"onboarding.passphrase.learn_more.visual.wallet" = "Dompet yang Dilindungi Frasa Laluan";
"onboarding.passphrase.learn_more.visual.accessibility" = "Frasa pemulihan 24 kata dan frasa laluan rahsia digabungkan untuk menerbitkan dompet berasingan yang dilindungi frasa laluan.";
"onboarding.passphrase.learn_more.derivation.section" = "Cara BIP-39 Menerbitkan Dompet";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frasa Pemulihan yang Digabungkan dengan Frasa Laluan";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 dengan 2.048 Pusingan";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Benih Utama 512 Bit";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Akaun dan Alamat Dompet Terbitan";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Frasa pemulihan dan frasa laluan anda melalui 2.048 pusingan PBKDF2-HMAC-SHA512 untuk menghasilkan benih 512 bit yang digunakan untuk menerbitkan akaun dan alamat dompet.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 menganggap frasa pemulihan yang dinormalkan sebagai kata laluan PBKDF2 dan menggunakan “mnemonic” yang diikuti frasa laluan yang dinormalkan sebagai salt. Selepas 2.048 pusingan PBKDF2-HMAC-SHA512, proses ini menghasilkan benih 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Sebelum menerbitkan benih, Oath menerapkan penormalan Unicode yang diperlukan BIP-39 sehingga frasa pemulihan dan frasa laluan dinormalkan yang sama sentiasa menghasilkan semula dompet yang sama.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Frasa laluan tidak menyulitkan kata pemulihan anda. Frasa laluan menukar benih terbitan sehingga setiap frasa laluan yang berbeza menghasilkan akaun dan alamat yang berbeza.";
"onboarding.passphrase.learn_more.wallets.section" = "Setiap Frasa Laluan Menerbitkan Dompet Berasingan";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Contoh Frasa Laluan 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Contoh Frasa Laluan 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Contoh Dompet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Contoh Dompet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Frasa pemulihan yang sama, ketika digabungkan dengan dua frasa laluan berbeza, menerbitkan dua dompet berasingan: Dompet A dan Dompet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Menukar satu aksara yang ketara sekalipun akan menerbitkan benih dan dompet yang berbeza; dompet asal tetap tidak berubah.";
"onboarding.passphrase.learn_more.wallets.empty" = "Frasa laluan kosong membuka dompet standard yang diterbitkan hanya daripada frasa pemulihan; frasa laluan yang diisi membuka dompet terpisahnya sendiri.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 tidak mempunyai respons “frasa laluan salah”. Setiap frasa laluan sah, jadi kesilapan menaip akan membuka dompet lain tanpa disedari—biasanya dengan baki sifar.";
"onboarding.passphrase.learn_more.security.section" = "Cara Frasa Laluan Menambah Perlindungan";
"onboarding.passphrase.learn_more.security.words.title" = "Kata Pemulihan Sahaja Tidak Cukup";
"onboarding.passphrase.learn_more.security.words.detail" = "Seseorang yang hanya memperoleh frasa pemulihan anda tetap memerlukan frasa laluan yang tepat untuk menerbitkan dan mengakses dompet yang dilindungi.";
"onboarding.passphrase.learn_more.security.strength.title" = "Kekuatan Memberikan Pengasingan Lebih Baik";
"onboarding.passphrase.learn_more.security.strength.detail" = "Frasa laluan yang panjang dan sukar diramal mencipta tekaan jauh lebih sukar; petikan pendek, tarikh lahir, nama, atau kata laluan yang digunakan semula boleh diteka dengan cepat dan hanya memberi sedikit perlindungan.";
"onboarding.passphrase.learn_more.security.separation.title" = "Simpan Frasa Laluan Secara Berasingan";
"onboarding.passphrase.learn_more.security.separation.detail" = "Simpan frasa laluan secara berasingan daripada frasa pemulihan supaya satu sandaran yang dicuri tidak mendedahkan kedua rahsia yang diperlukan untuk memulihkan dompet.";
"onboarding.passphrase.learn_more.security.footer" = "Frasa laluan tidak boleh melindungi dana anda jika kedua rahsia terdedah, frasa laluan lemah, atau perisian yang diceroboh merekamnya apabila anda mengetik.";
"onboarding.passphrase.learn_more.safety.section" = "Gunakan Ciri Ini dengan Selamat";
"onboarding.passphrase.learn_more.safety.strong.title" = "Cipta Frasa Laluan yang Kuat dan Unik";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Pilih beberapa kata rawak atau nilai berentropi tinggi lain yang unik untuk dompet ini. Hindaripada fakta peribadi, frasa yang biasa, corak, dan kata laluan yang digunakan di tempat lain.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Sandarkan Frasa Laluan Secara Berasingan";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Cipta salinan luar talian yang tahan lama daripada frasa laluan yang tepat, simpan berasingan daripada frasa pemulihan, dan jangan pernah hanya bergantung pada ingatan.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Setiap Aksara Menukar Dompet";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Masukkan semula frasa laluan tepat seperti apabila dicipta, termasuk setiap huruf besar, ruang, tanda baca, dan kata. Perbezaan apa-apa akan menerbitkan dompet lain tanpa pemberitahuan.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Pengesahan Pemulihan Sebelum Menambah Dana";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Sebelum menerima dana dalam jumlah besar, lakukan ujian pemulihan yang peribadi dan terkawal untuk memastikan frasa pemulihan serta frasa laluan mencipta semula alamat yang dijangka.";
"onboarding.passphrase.learn_more.safety.footer" = "Tidak ada perkhidmatan yang boleh menetapkan semula atau memulihkan frasa laluan yang hilang. Tanpa frasa laluan yang tepat, akses ke dompet tersebut hilang kekal, walaupun anda masih mempunyai frasa pemulihan.";
