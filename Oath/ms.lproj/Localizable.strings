// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Luncur untuk Hantar menggantikan butang pengesahan. Animasi arah, maklum balas haptik dan gerakan lebih lancar menyokong kedua-dua arah bacaan. Lepaskan pada 90% atau lebih untuk menghantar; luncur kembali untuk membatalkan.";
"settings.about.history.v355.build56.activity" = "Loceng membuka aktiviti tertunda. Kapsul transaksi menunjukkan lencana status dan boleh disapu untuk ditutup. Kapsul yang sedang atau telah disahkan disembunyikan selepas 3 saat; pengesahan mengemas kini kapsul sama yang masih kelihatan.";
"settings.about.history.v355.build56.status" = "Status transaksi lebih boleh dipercayai pada semua rangkaian yang disokong, butiran transaksi terkini dan kemas kini baki lebih pantas selepas penghantaran. Penjejakan transaksi tertunda disambung apabila aplikasi dibuka semula.";
"settings.about.history.v355.build56.fees" = "Kembali ke semakan pindahan yang sama mengekalkan fi yang telah diperoleh. Pemuatan fi dan amaran pembiayaan akaun lebih jelas; amaun mencukupi tidak lagi memaparkan makluman pengaktifan.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin dan Dogecoin menambah wang baki di bawah ambang debu kepada fi, bukannya mencipta output yang tidak boleh digunakan. Fi yang disemak sepadan dengan fi ketika tandatangan.";
"settings.about.history.v355.build56.stability" = "Membaiki ranap tugas latar belakang dan amaran tamat masa penyegaran dompet. Maklumat dompet sedia ada kekal tersedia apabila penyegaran gagal buat sementara waktu.";
"settings.about.history.v355.build56.backup" = "Skrin sandaran lebih kemas, dengan tajuk betul semasa dibuka dan mesej lebih sedikit. Akses kunci peribadi mematuhi tetapan Kunci Aplikasi. Amaran import kaca yang padat memadam input yang ditolak apabila anda memilih frasa pemulihan lain.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Selepas anda melepaskan peluncur untuk menghantar, tanda semak beranimasi muncul sebelum skrin semakan ditutup.";
"settings.about.history.v355.build57.activity" = "Baris aktiviti memaparkan status dengan tulisan lebih nipis, amaun sebagai sari kata dan anak panah untuk membuka butiran transaksi.";
"settings.about.history.v355.build57.details" = "Yuran rangkaian kini dipaparkan dalam ringkasan pindahan. Label yang lebih pendek dan satu baris rangkaian menjadikan butiran lebih jelas.";
"settings.about.history.v355.build57.resume" = "Apabila kembali dari latar belakang, skrin dan panel yang terbuka dikekalkan, termasuk semakan pindahan dan butiran transaksi.";
"settings.about.history.v355.build57.secrets" = "Skrin frasa pemulihan, kunci peribadi dan frasa laluan ditutup selepas 20 saat meninggalkan aplikasi. Kunci Aplikasi terus mengikut tetapan anda.";
"settings.about.history.v355.build57.filters" = "Penapis rangkaian menggunakan butang sistem yang lebih tinggi sedikit, saiz mengikut kandungan dan jarak yang dibetulkan di bawah bar navigasi.";
"settings.about.history.v355.build57.units" = "Baris nilai berasingan telah dibuang. Amaun dan yuran rangkaian mula-mula dipaparkan dalam mata wang tempatan; ketik mana-mana satu untuk bertukar ke unit kripto dan kembali.";
"wallet.transaction.details.toggle_units" = "Tukar unit.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Skrin utama dibuka tanpa kesan pudar atau perubahan skala. Butang Tetapan kini menggunakan ikon gear.";
"settings.about.history.v355.build58.fields" = "Medan transaksi dan penghantaran menggunakan warna teks biasa. Anak panah hanya muncul pada baris yang membuka skrin atau panel; mengetik amaun dan fi masih menukar unit.";
"settings.about.history.v355.build58.banners" = "Selepas dipaparkan, sepanduk pengesahan yang sedang berlangsung atau telah selesai hilang selepas 3 saat, walaupun anda membuka skrin lain. Kemas kini pengesahan yang belum dipaparkan akan muncul apabila anda kembali.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Pemindahan TRON kini mengetepikan yuran pengaktifan dan lebar jalur sebelum mengira jumlah untuk dihantar, termasuk apabila menghantar jumlah maksimum. Skrin semakan memaparkan jumlah yang betul selepas ditolak yuran.";
"settings.about.history.v355.build59.fees" = "Yuran TRON tersuai mesti meliputi kos rangkaian yang diperlukan. Panduan kini lebih jelas apabila baki TRX rendah. Jumlah token kekal tidak berubah; yuran dibayar dalam TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Sambutan baru";
"settings.about.history.v356.welcome" = "Skrin alu-aluan baharu dengan karya seni animasi dan pilihan yang jelas untuk membuat atau mengimport dompet.";
"settings.about.history.v357.tour.title" = "Jelajah alu-aluan";
"settings.about.history.v357.tour" = "Jelajah lima halaman memperkenalkan rangkaian yang disokong, entropi fizikal, penghantaran dan penerimaan, keselamatan serta binaan yang disahkan. Leret atau ketik titik untuk menukar halaman; penukar bahasa berada di bar navigasi.";
"settings.about.history.v357.backup" = "Selepas mencipta, mengimport atau memulihkan dompet, skrin muncul serta-merta dan pilihan sandarannya menggunakan senarai standard. Semakan iCloud berjalan di latar belakang, dan Buka Dompet sedia sebaik sahaja dompet disimpan.";
"settings.about.history.v357.reliability" = "Kembali dari latar belakang tidak lagi menutup skrin persediaan apabila skrin pemulihan tersembunyi tamat tempoh, dan memadam semua data terus membuka skrin alu-aluan.";
"settings.about.history.v357.notifications" = "Tetapan pemberitahuan menggunakan perkataan yang lebih mudah untuk kategori dan status, tanpa butiran teknikal.";
"settings.about.history.v357.wallets" = "Susun semula dompet dalam penukar dengan tekanan lama menggunakan animasi angkat sistem; mengetik baris akan mengaktifkannya. Pengesahan frasa pemulihan menomborkan setiap perkataan, dan Return beralih ke medan seterusnya.";
"settings.about.history.v357.send" = "Penghantaran memaparkan jumlah semasa pemindahan sedang berjalan, mesej yang lebih jelas muncul jika ia tidak dapat dihantar, dan permintaan TRON dicuba semula secara automatik selepas ralat pembekal sementara.";
"settings.about.history.v357.security" = "Akaun TRON yang diimport dan kebenaran pemiliknya dipindahkan ke kunci lain kini memaparkan amaran dan tidak boleh menghantar, walaupun setiap kebenaran menyenaraikan satu kunci sahaja. Lebih banyak frasa pemulihan dan kunci peribadi yang diketahui terdedah ditolak semasa import.";
"settings.about.history.v356.localization" = "Teks pada skrin alu-aluan kini lebih jelas dan semula jadi dalam semua bahasa yang disokong.";
"settings.about.history.v356.pricing" = "Harga token kini sepadan dengan rangkaian dan alamat token yang tepat, menggunakan harga DEX terlebih dahulu. Harga kecil menunjukkan sehingga 8 tempat perpuluhan tanpa pembundaran.";
"settings.about.history.v356.appearance" = "Butang utama dan kedua kini menggunakan ketinggian dan margin skrin yang konsisten, dengan sistem biru untuk tindakan utama.";
"settings.about.history.v356.transactions" = "Butiran transaksi menggunakan status Disahkan yang lebih pendek dan teks kelabu yang lebih jelas untuk tarikh, alamat, jumlah dan ID transaksi.";
