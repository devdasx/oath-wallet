// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Telezesha ili Kutuma inachukua nafasi ya kitufe cha uthibitisho. Uhuishaji wa mwelekeo, mwitikio wa mguso na mwendo laini vinafaa mielekeo yote miwili ya usomaji. Achia katika 90% au zaidi ili kutuma; rudisha nyuma ili kughairi.";
"settings.about.history.v355.build56.activity" = "Kengele hufungua shughuli zinazosubiri. Kapsuli za miamala huonyesha beji za hali na zinaweza kufichwa kwa kutelezesha. Zinazothibitishwa na zilizothibitishwa hufichwa baada ya sekunde 3; uthibitisho husasisha kapsuli ileile inayoonekana.";
"settings.about.history.v355.build56.status" = "Hali ya miamala inaaminika zaidi kwenye mitandao yote inayotumika, maelezo husasishwa moja kwa moja na salio husasishwa haraka zaidi baada ya kutuma. Ufuatiliaji wa miamala inayosubiri huendelea programu inapofunguliwa tena.";
"settings.about.history.v355.build56.fees" = "Kurudi kwenye ukaguzi wa uhamisho uleule huhifadhi ada iliyopatikana. Upakiaji wa ada na maonyo ya kuweka fedha kwenye akaunti ni wazi zaidi; kiasi cha kutosha hakionyeshi tena arifa za kuwezesha akaunti.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin na Dogecoin huongeza chenji iliyo chini ya kiwango cha dust kwenye ada badala ya kuunda pato lisiloweza kutumika. Ada iliyokaguliwa inalingana na ile ya kutia saini.";
"settings.about.history.v355.build56.stability" = "Tumerekebisha hitilafu iliyofunga programu wakati wa kazi ya chinichini na arifa za muda wa kuonyesha upya pochi kuisha. Taarifa zilizopo za pochi hubaki zinapatikana ikiwa kuonyesha upya kunashindwa kwa muda.";
"settings.about.history.v355.build56.backup" = "Skrini safi zaidi za nakala rudufu, zenye vichwa sahihi zinapofunguliwa na ujumbe mchache. Ufikiaji wa funguo binafsi hufuata mipangilio ya kufunga programu. Maonyo madogo ya kuingiza yenye mwonekano wa kioo hufuta ingizo lililokataliwa unapochagua kifungu kingine cha urejeshaji.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Baada ya kuachia kitelezi cha kutuma, alama ya tiki yenye uhuishaji huonekana kabla ya skrini ya ukaguzi kufungwa.";
"settings.about.history.v355.build57.activity" = "Safu za shughuli zinaonyesha hali kwa maandishi mepesi zaidi, kiasi kama kichwa kidogo na mshale wa kufungua maelezo ya muamala.";
"settings.about.history.v355.build57.details" = "Ada za mtandao sasa zinaonekana katika muhtasari wa uhamisho. Lebo fupi na safu moja ya mtandao zinafanya maelezo yawe wazi zaidi.";
"settings.about.history.v355.build57.resume" = "Unaporudi kutoka chinichini, skrini na paneli zilizofunguliwa huhifadhiwa, zikiwemo ukaguzi wa uhamisho na maelezo ya muamala.";
"settings.about.history.v355.build57.secrets" = "Skrini za kifungu cha kurejesha, ufunguo binafsi na kifungu cha nenosiri hufungwa baada ya sekunde 20 nje ya programu. Kufuli ya programu inaendelea kufuata mipangilio yako.";
"settings.about.history.v355.build57.filters" = "Vichujio vya mtandao hutumia vitufe vya mfumo vilivyo virefu kidogo, ukubwa unaolingana na maudhui na nafasi iliyorekebishwa chini ya upau wa urambazaji.";
"settings.about.history.v355.build57.units" = "Safu tofauti za thamani zimeondolewa. Kiasi na ada ya mtandao huanza kwa sarafu ya ndani; gusa mojawapo kubadili hadi vipimo vya kripto na kurudi.";
