"settings.about.history.v352.typing" = "Ulengaji wa kiotomatiki, ukamilishaji kwa Nafasi au Enter, uhariri wa hatua mbili kwa Backspace, kushikilia ili kufuta na kusogeza kiotomatiki. Enter huficha kibodi tu ikiwa kifungu ni halali.";
