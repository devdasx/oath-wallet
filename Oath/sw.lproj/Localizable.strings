"settings.about.history.v355.build58.home" = "Skrini ya mwanzo hufunguka bila athari za kufifia au kubadilika kwa ukubwa. Kitufe cha mipangilio sasa kina aikoni ya gurudumu lenye meno.";
"settings.about.history.v355.build58.fields" = "Sehemu za muamala na kutuma zinatumia rangi za kawaida za maandishi. Mishale inaonekana tu kwenye safu zinazofungua skrini au kidirisha; kugusa kiasi na ada bado hubadilisha vipimo vya kuonyesha.";
"settings.about.history.v355.build58.banners" = "Baada ya kuonyeshwa, mabango ya uthibitisho unaoendelea au uliokamilika hupotea baada ya sekunde 3, hata ukifungua skrini nyingine. Taarifa mpya za uthibitisho ambazo bado hazijaonyeshwa huonekana unaporudi.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Uhamisho wa TRON sasa hutenga ada za kuwezesha akaunti na kipimo data kabla ya kukokotoa kiasi cha kutuma, hata unapochagua kiasi cha juu kabisa. Skrini ya ukaguzi huonyesha kiasi sahihi baada ya kutoa ada.";
"settings.about.history.v355.build59.fees" = "Ada za TRON unazoweka mwenyewe lazima zitoshe kulipia gharama zinazohitajika za mtandao. Sasa kuna maelekezo yaliyo wazi zaidi salio la TRX linapokuwa dogo. Kiasi cha tokeni hakibadiliki; ada hulipwa kwa TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Makaribisho mapya";
"settings.about.history.v356.welcome" = "Skrini mpya ya kukaribisha iliyo na kazi ya sanaa iliyohuishwa na chaguo wazi za kuunda au kuagiza pochi.";
"settings.about.history.v357.tour.title" = "Ziara ya karibu";
"settings.about.history.v357.tour" = "Ziara ya kurasa tano inatambulisha mitandao inayotumika, entropi halisi, kutuma na kupokea, usalama na matoleo yaliyothibitishwa. Telezesha kidole au gusa vitone kubadilisha ukurasa; kibadilishaji cha lugha kiko kwenye upau wa usogezaji.";
"settings.about.history.v357.backup" = "Baada ya kuunda, kuingiza au kurejesha pochi, skrini huonekana mara moja na chaguo zake za nakala rudufu hutumia orodha ya kawaida. Ukaguzi wa iCloud hufanyika chinichini, na Fungua Pochi huwa tayari mara tu pochi inapohifadhiwa.";
"settings.about.history.v357.reliability" = "Kurudi kutoka chinichini hakufungi tena skrini ya usanidi wakati skrini ya urejeshaji iliyofichwa inapoisha muda, na kufuta data yote hufungua moja kwa moja skrini ya karibu.";
"settings.about.history.v357.notifications" = "Mipangilio ya arifa hutumia maneno rahisi zaidi kwa kategoria na hali, bila maelezo ya kiufundi.";
"settings.about.history.v357.wallets" = "Panga upya pochi kwenye kibadilishaji kwa kubonyeza kwa muda mrefu ukitumia uhuishaji wa kuinua wa mfumo; kugusa safu huiwasha. Uthibitishaji wa kifungu cha urejeshaji hupa kila neno nambari, na Return huhamia sehemu inayofuata.";
"settings.about.history.v357.send" = "Kutuma huonyesha kiasi wakati uhamisho unaendelea, ujumbe wazi zaidi huonekana ikiwa hauwezi kutumwa, na maombi ya TRON hujaribu tena kiotomatiki baada ya hitilafu za muda za mtoa huduma.";
"settings.about.history.v357.security" = "Akaunti za TRON zilizoingizwa ambazo ruhusa ya mmiliki imehamishiwa ufunguo mwingine sasa zinaonyesha onyo na haziwezi kutuma, hata wakati kila ruhusa inaorodhesha ufunguo mmoja tu. Vifungu vya urejeshaji na funguo za faragha zaidi zinazojulikana kuwa zimefichuka hukataliwa wakati wa kuingiza.";
"settings.about.history.v356.localization" = "Maandishi ya skrini ya ukaribisho yameboreshwa katika lugha zote zinazotumika ili yawe ya kawaida zaidi na rahisi kueleweka.";
"settings.about.history.v356.pricing" = "Bei za tokeni sasa zinalingana na mtandao halisi na anwani ya tokeni, kwa kutumia bei za DEX kwanza. Bei ndogo huonyesha hadi nafasi 8 za desimali bila kuzungushwa.";
"settings.about.history.v356.appearance" = "Vitufe vya msingi na vya upili sasa vinatumia urefu na ukingo thabiti wa skrini, na mfumo wa bluu kwa vitendo vya msingi.";
"settings.about.history.v356.transactions" = "Maelezo ya muamala hutumia hali fupi iliyothibitishwa na maandishi ya kijivu wazi zaidi kwa tarehe, anwani, kiasi na Vitambulisho vya muamala.";
"settings.about.history.v356.security" = "Imeongeza orodha ya vifungu vya faragha vinavyojulikana ambavyo haviwezi kuingizwa.";

