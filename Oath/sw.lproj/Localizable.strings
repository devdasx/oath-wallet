// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "Uhakiki wa kifungu cha urejeshaji, herufi ndogo za kiotomatiki, uingizaji wenye nambari, kusafisha maandishi, kufuta kwa kushikilia kitufe na utendaji wa kibodi vimeboreshwa. Skrini za urejeshaji sasa zina kitufe kimoja cha kurudi.";
"settings.about.history.v353.build51.send" = "Tumeongeza njia mbadala za kukadiria ada kwenye mitandao yote inayotumika wakati makadirio ya ada hayapatikani. Anwani za mikataba zimefichwa wakati wa kutuma na ada zinaonyeshwa kwa uwazi zaidi.";
"settings.about.history.v353.build51.security" = "Mapitio ya ruhusa, maelezo ya anwani, matokeo ya kubatilisha ruhusa na mwongozo wa kuongeza fedha za ada viko wazi zaidi. Kadi za nakala rudufu na paneli zina mwonekano mmoja. Mtetemo wakati wa kuvinjari umeondolewa.";
"settings.about.history.v353.build51.notifications" = "Arifa za kuaminika zaidi za uhamisho unaoingia kwenye mitandao mbalimbali. Kiasi huonyeshwa kwa sarafu uliyochagua bei zinapopatikana, na kwa vipimo vya sarafu ya kidijitali zisipopatikana.";

