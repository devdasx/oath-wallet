"onboarding.carousel.wallet.eyebrow" = "POCHI YAKO YA OATH";
"onboarding.carousel.wallet.title" = "Pochi Moja kwa Kila Hatua.";
"onboarding.carousel.wallet.message" = "Oath huweka mali zako katika mazingira ya kisasa yaliyojengwa kwa kifaa chako, yaliyo wazi katika mitandao yote, yanayofanya kazi haraka na yanayobaki chini ya udhibiti wako kamili.";
"onboarding.carousel.wallet.visual.networks" = "Mwonekano Mmoja Katika Mitandao Yote";
"onboarding.carousel.wallet.visual.accessibility" = "Onyesho la Oath lenye salio la pochi, vitendo vya Tuma, Pokea na Changanua, pamoja na mali za Ethereum na Bitcoin.";
"onboarding.carousel.entropy.eyebrow" = "ENTROPI KUTOKA KWA MAINGIZO HALISI";
"onboarding.carousel.entropy.title" = "Unda Unasibu Unaoudhibiti Kikamilifu.";
"onboarding.carousel.entropy.message" = "Rushe kete, rusha sarafu au rekodi tarakimu nasibu. Oath hubadilisha maingizo yako halisi kuwa biti 256 kamili za entropi kwa ajili ya kifungu cha urejeshaji chenye maneno 24, yote yakifanyika kwenye kifaa chako.";
"onboarding.carousel.entropy.visual.output" = "Biti 256 za Entropi Uliyozalisha";
"onboarding.carousel.entropy.visual.local" = "Imezalishwa Kabisa kutokana na Maingizo Uliyorekodi";
"onboarding.carousel.entropy.visual.accessibility" = "Kete yenye nambari, sarafu na tarakimu nasibu vinaunganishwa ili kuzalisha biti 256 za entropi ya pochi kwenye kifaa hiki.";
"onboarding.carousel.entropy.learn_more.action" = "Chunguza Maelezo Zaidi";
"onboarding.entropy.learn_more.navigation" = "Jinsi Entropi Halisi Inavyofanya Kazi";
"onboarding.entropy.learn_more.path.section" = "Kutoka Matokeo Halisi hadi Maneno ya Urejeshaji";
"onboarding.entropy.learn_more.overview" = "Oath hurekodi matokeo kutoka kwa chanzo halisi unachochagua na kuyabadilisha kuwa thamani ya biti 256. Kisha baiti 32 zinazopatikana hupitishwa kwa Wallet Core ili kuunda kifungu cha kawaida cha urejeshaji cha BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "Kifungu cha Urejeshaji cha BIP-39 chenye Maneno 24";
"onboarding.entropy.learn_more.visual.bits" = "Baiti 32 × biti 8 ni sawa na biti 256";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Gridi ya seli 256 za biti za mfano zilizopangwa katika baiti 32.";
"onboarding.entropy.learn_more.visual.accessibility" = "Matokeo ya kete, urushaji wa sarafu au tarakimu nasibu hubadilishwa kuwa biti 256, kisha kuwa kifungu cha urejeshaji cha BIP-39 chenye maneno 24.";
"onboarding.entropy.learn_more.inputs.section" = "Hatua ya 1: Rekodi Matokeo Halisi";
"onboarding.entropy.learn_more.inputs.dice.title" = "Rusha Kete Halali yenye Pande Sita";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Kwa kete halali, kila upande wa 1-4 huchangia biti 2; kila upande wa 5-6 huchangia biti 1.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Urushaji Halisi wa Sarafu";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Kila urushaji huru wa sarafu halali huchangia biti 1 isiyo na upendeleo ya entropi.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Rekodi Tarakimu Nasibu";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Nambari 0-7 kila moja huchangia biti 3. Nambari 8-9 kila moja huchangia biti 1. Nambari lazima zitoke kwa mchakato wa kimaumbile wa nasibu.";
"onboarding.entropy.learn_more.inputs.footer" = "Tumia chanzo halisi kisicho na upendeleo na urekodi kila matokeo kwa mpangilio. Unaweza kubadilisha njia ya kuingiza kwa sababu kila tokeo linalokubalika huchangia mtiririko uleule wa biti.";
"onboarding.entropy.learn_more.conversion.section" = "2. Kusanya Thamani ya Biti 256";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath hubadilisha matokeo ya kete na tarakimu za desimali kuwa vikundi visivyo na upendeleo vya vipeo vya 2. Urefu wa mchango unaweza kutofautiana, lakini chanzo halisi kisicho na upendeleo hakipendelei thamani yoyote ya biti.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath huongeza biti kwa mpangilio zilivyoingizwa hadi ikusanye 256 kamili, kisha huzipanga katika baiti 32 ikianza na biti yenye thamani kubwa zaidi.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropi maalum huwa na maingizo halisi uliyorekodi pekee; Oath haiongezi unasibu uliozalishwa na kifaa.";
"onboarding.entropy.learn_more.bip39.section" = "3. Zalisha Kifungu cha Urejeshaji";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Biti 256 za Entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Thamani ya Ukaguzi ya BIP-39 ya Biti 8";
"onboarding.entropy.learn_more.bip39.visual.words" = "Biti 264 zimegawanywa katika faharasa 24 za maneno zenye biti 11";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Thamani ya entropi ya biti 256 pamoja na thamani ya ukaguzi ya biti 8 huunda biti 264, ambazo hugawanywa katika faharasa 24 za maneno zenye biti 11 kila moja.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 hukokotoa SHA-256 kwa thamani ya entropi ya baiti 32 na huchukua biti 8 za kwanza za heshi kuwa thamani ya ukaguzi; kuambatisha thamani hiyo huzalisha biti 264.";
"onboarding.entropy.learn_more.bip39.words" = "Biti 264 hugawanywa katika vikundi 24 vya biti 11. Kila kikundi huchagua ingizo 1 kutoka kwenye orodha ya kawaida ya BIP-39 yenye maneno 2,048 ili kuunda kifungu cha urejeshaji chenye maneno 24.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core huzalisha akaunti na anwani zilezile kila wakati kutokana na mbegu hiyo. Kifungu kilekile cha urejeshaji na kaulisiri ya hiari huunda upya pochi ileile daima.";
"onboarding.entropy.learn_more.security.section" = "Jinsi Entropi Maalum Inavyoimarisha Usalama";
"onboarding.entropy.learn_more.security.space.title" = "Nafasi Kubwa Sana ya Uwezekano";
"onboarding.entropy.learn_more.security.space.detail" = "Entropi sare ya biti 256 ina thamani 2^256 za kipekee, hivyo kujaribu uwezekano wote kwa kompyuta hakutekelezeki. Hii inaeleza ukubwa wa nafasi ya maingizo; haimaanishi kuwa kila sehemu ya kriptografia hustahimili mashambulizi ya biti 256.";
"onboarding.entropy.learn_more.security.source.title" = "Unasibu Unatoka Kwako";
"onboarding.entropy.learn_more.security.source.detail" = "Matukio halisi hukuwezesha kupata unasibu wa pochi kwa kujitegemea badala ya kutegemea jenereta ya nambari nasibu ya kifaa pekee. Hii huimarisha usalama tu ikiwa matukio hayo ni nasibu kweli.";
"onboarding.entropy.learn_more.security.local.title" = "Inachakatwa Kabisa kwenye Kifaa Hiki";
"onboarding.entropy.learn_more.security.local.detail" = "Oath hubadilisha mfuatano uliorekodiwa na kuunda kifungu cha urejeshaji kwenye kifaa. Mfuatano haupakiwi mahali pengine ili kuchakatwa.";
"onboarding.entropy.learn_more.security.patterns.title" = "Epuka Siri Zinazochaguliwa na Binadamu";
"onboarding.entropy.learn_more.security.patterns.detail" = "Msururu mrefu wa matukio ya haki, huru hautabiriki sana kuliko siku za kuzaliwa, nambari zinazopendwa, muundo unaorudiwa, au maneno yaliyochaguliwa na mtu.";
"onboarding.entropy.learn_more.security.footer" = "Entropi halisi ni chanzo mbadala cha unasibu wa pochi, si nenosiri la ziada wala safu ya pili ya usalama.";
"onboarding.entropy.learn_more.safety.section" = "Itumie kwa Usalama";
"onboarding.entropy.learn_more.safety.fair.title" = "Rekodi Matokeo Halali na Huru";
"onboarding.entropy.learn_more.safety.fair.detail" = "Tumia sarafu au kete isiyo na upendeleo. Kila tukio lazima lijitegemee na lisitegemee yaliyotangulia. Tarakimu nasibu lazima zitoke kwenye chanzo halisi cha unasibu, si kumbukumbu yako.";
"onboarding.entropy.learn_more.safety.private.title" = "Weka Mchakato Mzima kuwa wa Faragha";
"onboarding.entropy.learn_more.safety.private.detail" = "Chukulia mfuatano uliorekodiwa na kifungu kamili cha urejeshaji kama siri za pochi. Zuia kamera au watu wengine kuziona.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Rekodi Kila Matokeo kwa Usahihi";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Tokeo moja linalokosekana, lililorudiwa au lililopangwa upya huunda pochi tofauti. Kagua kila ingizo na uthibitishe kifungu kamili cha urejeshaji kabla ya kuweka fedha kwenye pochi.";
"onboarding.entropy.learn_more.safety.backup.title" = "Linda Kifungu cha Urejeshaji";
"onboarding.entropy.learn_more.safety.backup.detail" = "Hifadhi kifungu cha urejeshaji nje ya mtandao na usiwahi kukishiriki. Baada ya kuthibitisha nakala rudufu, haribu kwa usalama rekodi yoyote ya muda ya maingizo ambayo huihitaji tena.";
"onboarding.entropy.learn_more.safety.footer" = "Entropi halisi haiwezi kulinda kifungu cha urejeshaji kilichofichuliwa, kifaa kilichodukuliwa, programu hasidi au mfuatano uliorekodiwa vibaya. Ikiwa huwezi kuhakikisha maingizo yasiyo na upendeleo, ya faragha na sahihi, tumia njia ya kawaida ya kuunda pochi.";
"onboarding.carousel.open_source.eyebrow" = "IMEUNDWA KWA MSIMBO WAZI";
"onboarding.carousel.open_source.title" = "Kagua Msimbo. Thibitisha Toleo.";
"onboarding.carousel.open_source.message" = "Oath huchapisha msimbo wake chanzo ili ukaguliwe kwa kujitegemea. Toleo huthibitishwa tu ikiwa uundaji unaoweza kurudiwa unalingana na alama ya kidijitali ya programu iliyochapishwa.";
"onboarding.carousel.open_source.action.github" = "Kagua kwenye GitHub";
"onboarding.carousel.open_source.visual.repository" = "Hazina ya Umma ya Msimbo Chanzo";
"onboarding.carousel.open_source.visual.repository.path" = "Tazama github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Kagua msimbo wa chanzo";
"onboarding.carousel.open_source.visual.rebuild" = "Unda Upya Toleo kwa Kujitegemea";
"onboarding.carousel.open_source.visual.compare" = "Linganisha Vipengee Vilivyoundwa";
"onboarding.carousel.open_source.visual.fingerprint" = "Alama ya Toleo Lililochapishwa";
"onboarding.carousel.open_source.visual.match" = "ZINALINGANA — TOLEO LIMETHIBITISHWA";
"onboarding.carousel.open_source.visual.accessibility" = "Mchoro unaoonyesha kuwa uthibitishaji wa toleo unahitaji msimbo chanzo wa umma, uundaji upya wa kujitegemea na alama zinazolingana.";
"onboarding.carousel.passphrase.eyebrow" = "KAULISIRI YA HIARI YA BIP-39";
"onboarding.carousel.passphrase.title" = "Kifungu Kimoja cha Urejeshaji. Siri Moja ya Ziada.";
"onboarding.carousel.passphrase.message" = "Kaulisiri ya BIP-39 huchanganywa na kifungu chako cha urejeshaji ili kuzalisha pochi tofauti. Hata kifungu cha urejeshaji kikifichuliwa, kufikia pochi hiyo bado kunahitaji kaulisiri kamili.";
"onboarding.carousel.passphrase.visual.phrase" = "Maneno Yako 24 ya Urejeshaji";
"onboarding.carousel.passphrase.visual.passphrase" = "Kaulisiri Yako ya Ziada";
"onboarding.carousel.passphrase.visual.output" = "Pochi Tofauti ya Kaulisiri";
"onboarding.carousel.passphrase.visual.requirement" = "Siri Zote Mbili Zinahitajika Kurejesha";
"onboarding.carousel.passphrase.visual.accessibility" = "Kifungu cha urejeshaji cha maneno 24 huchanganywa na kaulisiri ya siri ya BIP-39 ili kuunda pochi tofauti inayohitaji siri zote mbili kurejeshwa.";
"onboarding.carousel.passphrase.learn_more.action" = "Chunguza Maelezo Zaidi";
"onboarding.passphrase.learn_more.navigation" = "Kuelewa Kaulisiri za BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Siri Mbili Huzalisha Pochi Moja";
"onboarding.passphrase.learn_more.overview" = "Kaulisiri ya BIP-39 ni siri ya hiari inayounganishwa na kifungu chako cha urejeshaji. Kwa pamoja, huzalisha pochi ileile kila wakati, lakini tofauti na pochi inayoundwa kwa kifungu cha urejeshaji pekee.";
"onboarding.passphrase.learn_more.visual.phrase" = "Kifungu Chako cha Urejeshaji chenye Maneno 24";
"onboarding.passphrase.learn_more.visual.passphrase" = "Kaulisiri Yako";
"onboarding.passphrase.learn_more.visual.wallet" = "Pochi Iliyolindwa kwa Kaulisiri";
"onboarding.passphrase.learn_more.visual.accessibility" = "Kifungu cha urejeshaji cha maneno 24 na kaulisiri ya siri huchanganywa ili kuunda pochi inayolindwa kwa kaulisiri.";
"onboarding.passphrase.learn_more.derivation.section" = "Jinsi BIP-39 Inavyozalisha Pochi";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Kifungu cha Urejeshaji Kimeunganishwa na Kaulisiri";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 kwa Raundi 2,048";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Mbegu kuu ya biti 512";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Akaunti na Anwani za Pochi Zilizozalishwa";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Kifungu chako cha urejeshaji na kaulisiri hupitia raundi 2,048 za PBKDF2-HMAC-SHA512 ili kutoa mbegu ya biti 512 ambayo hutumiwa kuzalisha akaunti na anwani za pochi.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 hutumia kifungu cha urejeshaji kilichosanifishwa kama nenosiri la PBKDF2 na neno \"mnemonic\" likifuatiwa na kaulisiri iliyosanifishwa kama chumvi. Baada ya raundi 2,048 za PBKDF2-HMAC-SHA512, mchakato hutoa mbegu ya baiti 64.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Kabla ya kuzalisha mbegu, Oath hutumia usawazishaji wa Unicode unaohitajika na BIP-39 ili kifungu kilekile cha urejeshaji na kaulisiri vilivyosawazishwa viunde upya pochi ileile kila wakati.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Kaulisiri haisimbifiche maneno yako ya urejeshaji. Hubadilisha mbegu inayozalishwa, kwa hivyo kila kaulisiri tofauti huzalisha akaunti na anwani tofauti.";
"onboarding.passphrase.learn_more.wallets.section" = "Kila Kaulisiri Huzalisha Pochi Tofauti";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Mfano wa Kaulisiri 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Mfano wa Kaulisiri 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Mfano wa Pochi A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Mfano wa Pochi B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Kifungu kilekile cha urejeshaji kikichanganywa na kaulisiri mbili tofauti huzalisha pochi mbili tofauti: Pochi A na Pochi B.";
"onboarding.passphrase.learn_more.wallets.different" = "Kubadilisha hata herufi moja yenye maana huzalisha mbegu tofauti na hivyo pochi tofauti; pochi ya awali haibadiliki.";
"onboarding.passphrase.learn_more.wallets.empty" = "Kaulisiri tupu hufungua pochi ya kawaida inayozalishwa kwa kifungu cha urejeshaji pekee; kaulisiri isiyo tupu hufungua pochi yake tofauti.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 haitoi jibu la \"kaulisiri si sahihi\"; kila kaulisiri ni halali, kwa hivyo kosa la kuandika hufungua pochi nyingine bila tahadhari—kwa kawaida ikiwa na salio sifuri.";
"onboarding.passphrase.learn_more.security.section" = "Jinsi Kaulisiri Inavyoongeza Ulinzi";
"onboarding.passphrase.learn_more.security.words.title" = "Maneno ya Urejeshaji Pekee Hayatoshi";
"onboarding.passphrase.learn_more.security.words.detail" = "Mtu akipata kifungu chako cha urejeshaji pekee, bado anahitaji kaulisiri kamili ili kuzalisha na kufikia pochi iliyolindwa.";
"onboarding.passphrase.learn_more.security.strength.title" = "Nguvu Huongeza Utengano";
"onboarding.passphrase.learn_more.security.strength.detail" = "Kaulisiri ndefu isiyotabirika huongeza sana ugumu wa kuikisia; nukuu fupi, tarehe ya kuzaliwa, jina au nenosiri lililotumiwa tena linaweza kukisiwa haraka na kutoa ulinzi mdogo.";
"onboarding.passphrase.learn_more.security.separation.title" = "Weka Kaulisiri Kando";
"onboarding.passphrase.learn_more.security.separation.detail" = "Kuweka kaulisiri kando na kifungu cha urejeshaji huzuia nakala moja rudufu iliyoibiwa kufichua kila kitu kinachohitajika kurejesha pochi iliyolindwa.";
"onboarding.passphrase.learn_more.security.footer" = "Kaulisiri haiwezi kulinda fedha zako ikiwa siri zote mbili zimefichuliwa, kaulisiri ni dhaifu au programu iliyodukuliwa inainasa unapoiandika.";
"onboarding.passphrase.learn_more.safety.section" = "Itumie kwa Usalama";
"onboarding.passphrase.learn_more.safety.strong.title" = "Unda Kaulisiri Imara na ya Kipekee";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Chagua maneno kadhaa nasibu au thamani nyingine yenye entropi nyingi na ya kipekee kwa pochi hii. Epuka taarifa binafsi, misemo inayofahamika, ruwaza na manenosiri yanayotumiwa kwingine.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Hifadhi Nakala ya Kaulisiri Kando";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Unda nakala ya kudumu ya nje ya mtandao ya kaulisiri kamili na uihifadhi kando na kifungu cha urejeshaji. Usitegemee kumbukumbu pekee.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Kila Herufi Hubadilisha Pochi";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Ingiza tena kaulisiri kama ilivyoundwa, ikijumuisha kila herufi kubwa, nafasi, alama ya uakifishaji na neno. Tofauti yoyote huzalisha pochi nyingine bila tahadhari.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Thibitisha Urejeshaji Kabla ya Kuongeza Fedha";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Kabla ya kupokea fedha nyingi, thibitisha kwa jaribio la urejeshaji la faragha na linalodhibitiwa kwamba kifungu cha urejeshaji na kaulisiri huunda upya anwani zinazotarajiwa.";
"onboarding.passphrase.learn_more.safety.footer" = "Hakuna huduma inayoweza kuweka upya au kurejesha kaulisiri iliyopotea. Bila kaulisiri kamili, huwezi tena kufikia pochi hiyo—hata ikiwa bado una kifungu cha urejeshaji.";
