"onboarding.carousel.entropy.title" = "Tự tạo nguồn ngẫu nhiên bạn hoàn toàn kiểm soát.";
"onboarding.carousel.entropy.message" = "Gieo xúc xắc, tung đồng xu hoặc ghi lại các chữ số ngẫu nhiên. Oath chuyển đầu vào vật lý của bạn thành chính xác 256 bit entropy cho cụm từ khôi phục 24 từ, hoàn toàn trên thiết bị này.";
"onboarding.carousel.entropy.visual.output" = "256 bit entropy do bạn tạo";
"onboarding.carousel.entropy.visual.local" = "Hoàn toàn từ dữ liệu bạn ghi lại";
"onboarding.carousel.entropy.visual.accessibility" = "Một con xúc xắc có đánh số, một đồng xu và các chữ số ngẫu nhiên kết hợp để tạo 256 bit entropy cho ví trên thiết bị này.";
"onboarding.carousel.entropy.learn_more.action" = "Khám phá chi tiết";
"onboarding.entropy.learn_more.navigation" = "Cách entropy vật lý hoạt động";
"onboarding.entropy.learn_more.path.section" = "Từ kết quả vật lý đến từ khôi phục";
"onboarding.entropy.learn_more.overview" = "Oath ghi lại kết quả từ nguồn vật lý bạn chọn và chuyển đổi chúng thành một giá trị 256 bit. Sau đó, Wallet Core dùng 32 byte kết quả để tạo cụm từ khôi phục BIP-39 tiêu chuẩn.";
"onboarding.entropy.learn_more.visual.phrase" = "Cụm từ khôi phục BIP-39 gồm 24 từ";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit bằng 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Lưới 256 ô bit mẫu được xếp thành 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Kết quả gieo xúc xắc, tung đồng xu hoặc các chữ số ngẫu nhiên được chuyển thành 256 bit rồi thành cụm từ khôi phục BIP-39 gồm 24 từ.";
"onboarding.entropy.learn_more.inputs.section" = "Bước 1: Ghi lại kết quả vật lý";
"onboarding.entropy.learn_more.inputs.dice.title" = "Gieo xúc xắc 6 mặt cân bằng";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Với một con xúc xắc cân bằng, mỗi mặt 1–4 đóng góp 2 bit; mỗi mặt 5–6 đóng góp 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Tung đồng xu vật lý";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Mỗi lần tung một đồng xu cân bằng và độc lập sẽ đóng góp 1 bit entropy không thiên lệch.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Ghi lại các chữ số ngẫu nhiên";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Mỗi chữ số 0–7 đóng góp 3 bit; mỗi chữ số 8–9 đóng góp 1 bit. Các chữ số phải đến từ một quy trình vật lý thực sự ngẫu nhiên.";
"onboarding.entropy.learn_more.inputs.footer" = "Dùng nguồn ngẫu nhiên vật lý không thiên lệch và ghi lại mọi kết quả theo đúng thứ tự. Bạn có thể đổi phương thức đầu vào vì mỗi kết quả được chấp nhận đều đóng góp vào cùng một luồng bit.";
"onboarding.entropy.learn_more.conversion.section" = "2. Tạo giá trị 256 bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath chuyển kết quả xúc xắc và chữ số thập phân thành các nhóm không thiên lệch có kích thước là lũy thừa của 2. Số bit đóng góp có thể khác nhau, nhưng nguồn vật lý không thiên lệch không ưu tiên bất kỳ giá trị bit nào.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath nối các bit theo thứ tự nhập cho đến khi đủ chính xác 256 bit, rồi đóng gói chúng thành 32 byte theo thứ tự bit quan trọng nhất trước.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropy tùy chỉnh chỉ chứa đầu vào vật lý bạn ghi lại; Oath không trộn thêm nguồn ngẫu nhiên do thiết bị tạo.";
"onboarding.entropy.learn_more.bip39.section" = "3. Dẫn xuất cụm từ khôi phục";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bit entropy";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Giá trị kiểm tra BIP-39 8 bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit chia thành 24 chỉ mục từ, mỗi chỉ mục 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Giá trị entropy 256 bit cộng với tổng kiểm tra 8 bit tạo ra 264 bit, chia thành 24 chỉ mục từ, mỗi chỉ mục 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 tính SHA-256 trên giá trị entropy 32 byte và lấy 8 bit đầu tiên của hàm băm làm giá trị kiểm tra; nối thêm giá trị này sẽ tạo ra 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "264 bit được chia thành 24 nhóm 11 bit. Mỗi nhóm chọn 1 mục từ danh sách BIP-39 tiêu chuẩn gồm 2.048 từ, tạo ra cụm từ khôi phục gồm 24 từ.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core dẫn xuất các tài khoản và địa chỉ theo cách tất định từ seed thu được. Cùng một cụm từ khôi phục và cụm mật khẩu tùy chọn sẽ luôn tái tạo cùng một ví.";
"onboarding.entropy.learn_more.security.section" = "Cách entropy tùy chỉnh tăng cường bảo mật";
"onboarding.entropy.learn_more.security.space.title" = "Không gian khả năng khổng lồ";
"onboarding.entropy.learn_more.security.space.detail" = "Entropy 256 bit phân bố đều có 2^256 giá trị duy nhất, khiến việc thử hết mọi khả năng bất khả thi về mặt tính toán. Đây là kích thước của không gian đầu vào, không có nghĩa mọi thành phần mật mã đều chống được cuộc tấn công có độ phức tạp 256 bit.";
"onboarding.entropy.learn_more.security.source.title" = "Nguồn ngẫu nhiên đến từ bạn";
"onboarding.entropy.learn_more.security.source.detail" = "Các sự kiện vật lý giúp bạn tự tạo nguồn ngẫu nhiên cho ví thay vì chỉ dựa vào bộ tạo số ngẫu nhiên của thiết bị. Cách này chỉ tăng bảo mật khi các sự kiện thực sự ngẫu nhiên.";
"onboarding.entropy.learn_more.security.local.title" = "Được xử lý hoàn toàn trên thiết bị này";
"onboarding.entropy.learn_more.security.local.detail" = "Oath chuyển đổi chuỗi bạn ghi lại và tạo cụm từ khôi phục hoàn toàn trên thiết bị này. Chuỗi đó không bao giờ được tải lên để xử lý.";
"onboarding.entropy.learn_more.security.patterns.title" = "Tránh bí mật do con người tự chọn";
"onboarding.entropy.learn_more.security.patterns.detail" = "Một chuỗi dài gồm các sự kiện độc lập, không thiên lệch khó đoán hơn nhiều so với ngày sinh, số yêu thích, mẫu lặp hoặc từ do con người tự chọn.";
"onboarding.entropy.learn_more.security.footer" = "Entropy vật lý thay thế nguồn ngẫu nhiên do thiết bị tạo cho ví; đây không phải mật khẩu hay lớp bảo mật bổ sung.";
"onboarding.entropy.learn_more.safety.section" = "Sử dụng tính năng này an toàn";
"onboarding.entropy.learn_more.safety.fair.title" = "Ghi lại các kết quả độc lập, không thiên lệch";
"onboarding.entropy.learn_more.safety.fair.detail" = "Dùng đồng xu hoặc xúc xắc cân bằng và bảo đảm mỗi kết quả đều độc lập. Chữ số ngẫu nhiên phải đến từ một nguồn vật lý thực sự, không phải từ trí nhớ hay một mẫu có sẵn.";
"onboarding.entropy.learn_more.safety.private.title" = "Giữ kín quy trình tạo entropy";
"onboarding.entropy.learn_more.safety.private.detail" = "Bảo vệ cả chuỗi đã ghi và cụm từ khôi phục hoàn chỉnh như những bí mật của ví. Không để camera hoặc người khác nhìn thấy.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Ghi lại mọi kết quả một cách chính xác";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Chỉ một kết quả bị thiếu, lặp lại hoặc sai thứ tự cũng tạo ra ví khác. Hãy xem lại mọi mục nhập và xác minh cụm từ khôi phục hoàn chỉnh trước khi chuyển tiền vào ví.";
"onboarding.entropy.learn_more.safety.backup.title" = "Bảo vệ cụm từ khôi phục";
"onboarding.entropy.learn_more.safety.backup.detail" = "Lưu trữ cụm từ khôi phục ngoại tuyến và không bao giờ chia sẻ nó. Sau khi xác minh bản sao lưu, hãy hủy an toàn mọi bản ghi đầu vào trung gian mà bạn không cần nữa.";
"onboarding.entropy.learn_more.safety.footer" = "Entropy vật lý không thể bảo vệ cụm từ khôi phục đã lộ, thiết bị bị xâm nhập, phần mềm độc hại hoặc chuỗi bị ghi sai. Nếu không thể bảo đảm đầu vào không thiên lệch, riêng tư và chính xác, hãy dùng cách tạo ví tiêu chuẩn.";
"onboarding.carousel.open_source.eyebrow" = "MÃ NGUỒN MỞ NGAY TỪ THIẾT KẾ";
"onboarding.carousel.open_source.title" = "Kiểm tra mã nguồn. Xác minh bản dựng.";
"onboarding.carousel.open_source.message" = "Oath công bố mã nguồn để mọi người có thể kiểm tra độc lập. Một bản phát hành chỉ được xác minh khi bản dựng có thể tái tạo khớp với dấu vân tay của ứng dụng đã phát hành.";
