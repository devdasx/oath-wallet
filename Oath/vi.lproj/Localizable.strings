"onboarding.carousel.passphrase.title" = "Một cụm từ khôi phục. Thêm một bí mật.";
"onboarding.carousel.passphrase.message" = "Cụm mật khẩu BIP-39 kết hợp với cụm từ khôi phục của bạn để tạo một ví riêng. Nếu các từ khôi phục bị lộ, ví đó vẫn yêu cầu cụm mật khẩu chính xác.";
"onboarding.carousel.passphrase.visual.phrase" = "24 từ khôi phục của bạn";
"onboarding.carousel.passphrase.visual.passphrase" = "Cụm mật khẩu bí mật của bạn";
"onboarding.carousel.passphrase.visual.output" = "Một ví riêng biệt dùng cụm mật khẩu";
"onboarding.carousel.passphrase.visual.requirement" = "Cần cả hai bí mật để khôi phục";
"onboarding.carousel.passphrase.visual.accessibility" = "Cụm từ khôi phục 24 từ và cụm mật khẩu BIP-39 bí mật dẫn xuất một ví riêng, cần cả hai bí mật để khôi phục.";
"onboarding.carousel.passphrase.learn_more.action" = "Khám phá chi tiết";
"onboarding.passphrase.learn_more.navigation" = "Tìm hiểu cụm mật khẩu BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Hai bí mật dẫn xuất một ví";
"onboarding.passphrase.learn_more.overview" = "Cụm mật khẩu BIP-39 là một bí mật tùy chọn được kết hợp với cụm từ khôi phục. Cả hai cùng dẫn xuất theo cách tất định một ví khác với ví chỉ dùng cụm từ khôi phục.";
"onboarding.passphrase.learn_more.visual.phrase" = "Cụm từ khôi phục 24 từ của bạn";
"onboarding.passphrase.learn_more.visual.passphrase" = "Cụm mật khẩu bí mật";
"onboarding.passphrase.learn_more.visual.wallet" = "Ví được bảo vệ bằng cụm mật khẩu";
"onboarding.passphrase.learn_more.visual.accessibility" = "Cụm từ khôi phục 24 từ và cụm mật khẩu bí mật kết hợp để dẫn xuất một ví riêng được bảo vệ bằng cụm mật khẩu.";
"onboarding.passphrase.learn_more.derivation.section" = "Cách BIP-39 dẫn xuất ví";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Cụm từ khôi phục kết hợp với cụm mật khẩu";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 qua 2.048 vòng";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Seed gốc 512 bit";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Các tài khoản và địa chỉ ví được dẫn xuất";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Cụm từ khôi phục và cụm mật khẩu trải qua 2.048 vòng PBKDF2-HMAC-SHA512 để tạo seed 512 bit dùng dẫn xuất các tài khoản và địa chỉ ví.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 xem cụm từ khôi phục đã chuẩn hóa là mật khẩu PBKDF2 và dùng chuỗi “mnemonic” nối với cụm mật khẩu đã chuẩn hóa làm salt. Sau 2.048 vòng PBKDF2-HMAC-SHA512, quy trình tạo ra seed 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Trước khi dẫn xuất seed, Oath áp dụng phép chuẩn hóa Unicode theo BIP-39 để cùng một cụm từ khôi phục và cụm mật khẩu đã chuẩn hóa luôn tái tạo đúng một ví.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Cụm mật khẩu không mã hóa các từ khôi phục. Nó thay đổi seed được dẫn xuất, vì vậy mỗi cụm mật khẩu khác nhau sẽ tạo ra các tài khoản và địa chỉ khác nhau.";
"onboarding.passphrase.learn_more.wallets.section" = "Mỗi cụm mật khẩu dẫn xuất một ví riêng";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Cụm mật khẩu mẫu 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Cụm mật khẩu mẫu 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Ví mẫu A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Ví mẫu B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Cụm từ khôi phục giống nhau với hai cụm mật khẩu khác nhau sẽ tạo ra Ví A và Ví B.";
"onboarding.passphrase.learn_more.wallets.different" = "Chỉ cần thay đổi một ký tự có ý nghĩa cũng dẫn xuất một seed khác và do đó là một ví khác; ví ban đầu vẫn không đổi.";
"onboarding.passphrase.learn_more.wallets.empty" = "Cụm mật khẩu trống sẽ mở ví tiêu chuẩn được dẫn xuất chỉ từ cụm từ khôi phục; cụm mật khẩu không trống sẽ mở một ví riêng.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 không có phản hồi “cụm mật khẩu sai”. Mọi cụm mật khẩu đều hợp lệ, do đó, một lỗi đánh máy sẽ âm thầm mở ra một ví khác—thường có số dư bằng 0.";
"onboarding.passphrase.learn_more.security.section" = "Cách cụm mật khẩu tăng cường bảo vệ";
"onboarding.passphrase.learn_more.security.words.title" = "Chỉ có từ khôi phục là chưa đủ";
"onboarding.passphrase.learn_more.security.words.detail" = "Người chỉ có cụm từ khôi phục vẫn cần chính xác cụm mật khẩu để dẫn xuất và truy cập ví được bảo vệ.";
"onboarding.passphrase.learn_more.security.strength.title" = "Cụm mật khẩu mạnh giúp bảo vệ tốt hơn";
"onboarding.passphrase.learn_more.security.strength.detail" = "Cụm mật khẩu dài, không thể đoán trước sẽ làm tăng thêm độ khó đoán có ý nghĩa. Một câu trích dẫn ngắn, ngày sinh, tên hoặc mật khẩu được sử dụng lại có thể bị đoán nhanh chóng và mang lại ít sự bảo vệ.";
"onboarding.passphrase.learn_more.security.separation.title" = "Lưu cụm mật khẩu riêng biệt";
"onboarding.passphrase.learn_more.security.separation.detail" = "Việc tách cụm mật khẩu khỏi cụm từ khôi phục sẽ ngăn bản sao lưu bị đánh cắp tiết lộ mọi thứ cần thiết để khôi phục ví được bảo vệ.";
"onboarding.passphrase.learn_more.security.footer" = "Cụm mật khẩu không thể bảo vệ tiền nếu cả hai bí mật đều bị lộ, cụm mật khẩu quá yếu hoặc phần mềm bị xâm phạm ghi lại cụm mật khẩu khi bạn nhập.";
"onboarding.passphrase.learn_more.safety.section" = "Sử dụng tính năng này an toàn";
"onboarding.passphrase.learn_more.safety.strong.title" = "Tạo cụm mật khẩu mạnh và duy nhất";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Ưu tiên một số từ được chọn ngẫu nhiên hoặc giá trị entropy cao khác chỉ được sử dụng cho ví này. Không dựa vào thông tin cá nhân, cụm từ, mẫu quen thuộc hoặc mật khẩu được sử dụng ở nơi khác.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Sao lưu riêng cụm mật khẩu";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Tạo bản sao lưu ngoại tuyến lâu dài của cụm mật khẩu chính xác và lưu trữ nó riêng biệt với cụm từ khôi phục. Đừng chỉ phụ thuộc vào trí nhớ.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Mỗi ký tự đều thay đổi ví";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Nhập chính xác cụm mật khẩu, bao gồm viết hoa, dấu cách, dấu câu và thứ tự từ. Một mục nhập khác sẽ tạo ra một ví khác mà không có lỗi.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Xác minh khả năng khôi phục trước khi nạp tiền";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Trước khi nhận một khoản tiền đáng kể, hãy thực hiện thử nghiệm khôi phục riêng tư, có kiểm soát để xác minh rằng cụm từ khôi phục và cụm mật khẩu sẽ tạo lại các địa chỉ dự kiến.";
"onboarding.passphrase.learn_more.safety.footer" = "Không dịch vụ nào có thể đặt lại hoặc khôi phục cụm mật khẩu đã mất. Nếu không có chính xác cụm mật khẩu đó, bạn sẽ vĩnh viễn mất quyền truy cập ví này, ngay cả khi vẫn còn cụm từ khôi phục.";
