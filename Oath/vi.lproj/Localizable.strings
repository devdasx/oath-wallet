// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Trượt để gửi thay thế nút xác nhận. Hiệu ứng chỉ hướng, phản hồi xúc giác và chuyển động mượt hơn hỗ trợ cả hai chiều đọc. Thả tay ở mức 90% trở lên để gửi; trượt lại để hủy.";
"settings.about.history.v355.build56.activity" = "Chuông mở hoạt động đang chờ. Thẻ giao dịch dạng viên nang hiển thị huy hiệu trạng thái và có thể vuốt để ẩn. Thẻ đang xác nhận hoặc đã xác nhận ẩn sau 3 giây; xác nhận cập nhật ngay thẻ đang hiển thị.";
"settings.about.history.v355.build56.status" = "Trạng thái giao dịch đáng tin cậy hơn trên mọi mạng được hỗ trợ, chi tiết cập nhật trực tiếp và số dư cập nhật nhanh hơn sau khi gửi. Việc theo dõi giao dịch đang chờ tiếp tục khi mở lại ứng dụng.";
"settings.about.history.v355.build56.fees" = "Quay lại phần kiểm tra cùng giao dịch sẽ giữ nguyên mức phí đã có. Hiển thị tải phí và cảnh báo cấp vốn tài khoản rõ ràng hơn; số tiền đủ sẽ không còn hiện thông báo kích hoạt.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin và Dogecoin cộng tiền thừa dưới ngưỡng bụi vào phí thay vì tạo đầu ra không sử dụng được. Phí khi kiểm tra khớp với phí khi ký.";
"settings.about.history.v355.build56.stability" = "Đã sửa lỗi tác vụ nền làm ứng dụng dừng đột ngột và cảnh báo hết thời gian làm mới ví. Thông tin ví hiện có vẫn khả dụng khi làm mới tạm thời thất bại.";
"settings.about.history.v355.build56.backup" = "Màn hình sao lưu gọn hơn, đúng tiêu đề ngay khi mở và ít thông báo hơn. Quyền truy cập khóa riêng tuân theo cài đặt Khóa ứng dụng. Cảnh báo nhập dạng kính nhỏ gọn xóa nội dung bị từ chối khi bạn chọn cụm từ khôi phục khác.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Sau khi bạn thả thanh trượt gửi, dấu tích động sẽ xuất hiện trước khi màn hình kiểm tra đóng lại.";
"settings.about.history.v355.build57.activity" = "Các hàng hoạt động hiển thị trạng thái với nét chữ mảnh hơn, số tiền ở dòng phụ và mũi tên để mở chi tiết giao dịch.";
"settings.about.history.v355.build57.details" = "Phí mạng hiện nằm trong phần tóm tắt chuyển tiền. Nhãn ngắn hơn và chỉ một hàng mạng giúp thông tin rõ ràng hơn.";
"settings.about.history.v355.build57.resume" = "Khi quay lại từ nền, các màn hình và bảng đang mở được giữ nguyên, bao gồm màn hình kiểm tra chuyển tiền và chi tiết giao dịch.";
"settings.about.history.v355.build57.secrets" = "Các màn hình cụm từ khôi phục, khóa riêng tư và cụm mật khẩu sẽ đóng sau khi bạn rời ứng dụng 20 giây. Khóa ứng dụng vẫn tuân theo cài đặt của bạn.";
"settings.about.history.v355.build57.filters" = "Bộ lọc mạng dùng nút gốc cao hơn một chút, kích thước theo nội dung và khoảng cách đã chỉnh sửa bên dưới thanh điều hướng.";
"settings.about.history.v355.build57.units" = "Đã bỏ các hàng giá trị riêng. Số tiền và phí mạng ban đầu hiển thị bằng nội tệ; chạm vào một trong hai để chuyển sang đơn vị tiền mã hóa và ngược lại.";
"wallet.transaction.details.toggle_units" = "Đổi đơn vị.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Màn hình chính mở mà không có hiệu ứng mờ dần hay thay đổi kích thước. Nút Cài đặt nay dùng biểu tượng bánh răng.";
"settings.about.history.v355.build58.fields" = "Các trường giao dịch và gửi tiền dùng màu chữ thông thường. Mũi tên chỉ xuất hiện ở những hàng mở màn hình hoặc bảng; chạm vào số tiền và phí vẫn chuyển đổi đơn vị hiển thị.";
"settings.about.history.v355.build58.banners" = "Sau khi xuất hiện, thông báo đang xác nhận và đã xác nhận sẽ biến mất sau 3 giây, kể cả khi bạn mở màn hình khác. Những cập nhật xác nhận chưa hiển thị sẽ xuất hiện khi bạn quay lại.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Giao dịch TRON giờ đây dành riêng phí kích hoạt và băng thông trước khi tính số tiền gửi, kể cả khi gửi tối đa. Màn hình xem lại hiển thị đúng số tiền sau khi trừ phí.";
"settings.about.history.v355.build59.fees" = "Phí TRON tùy chỉnh phải đủ để trả chi phí mạng bắt buộc. Khi số dư TRX thấp, ứng dụng giờ đây hiển thị hướng dẫn rõ ràng hơn. Số lượng token không thay đổi; phí được thanh toán bằng TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Một sự chào đón mới";
"settings.about.history.v356.welcome" = "Màn hình chào mừng mới với tác phẩm nghệ thuật hoạt hình và các tùy chọn rõ ràng để tạo hoặc nhập ví.";
"settings.about.history.v357.tour.title" = "Chuyến tham quan chào mừng";
"settings.about.history.v357.tour" = "Chuyến tham quan năm trang giới thiệu các mạng được hỗ trợ, entropy vật lý, gửi và nhận, bảo mật và các bản dựng đã xác minh. Vuốt hoặc chạm vào các chấm để chuyển trang; nút đổi ngôn ngữ nằm trên thanh điều hướng.";
"settings.about.history.v357.backup" = "Sau khi tạo, nhập hoặc khôi phục ví, màn hình xuất hiện ngay và các tùy chọn sao lưu dùng danh sách chuẩn. Việc kiểm tra iCloud chạy ở chế độ nền, và nút Mở ví sẵn sàng ngay khi ví được lưu.";
"settings.about.history.v357.reliability" = "Quay lại từ chế độ nền không còn đóng màn hình thiết lập khi một màn hình khôi phục bị ẩn hết hạn, và xóa toàn bộ dữ liệu sẽ mở thẳng màn hình chào mừng.";
"settings.about.history.v357.notifications" = "Cài đặt thông báo dùng cách diễn đạt đơn giản hơn cho các danh mục và trạng thái, không có chi tiết kỹ thuật.";
"settings.about.history.v357.wallets" = "Sắp xếp lại ví trong trình chuyển đổi bằng cách nhấn giữ với hiệu ứng nhấc lên của hệ thống; chạm vào một hàng sẽ kích hoạt ví đó. Xác minh cụm từ khôi phục đánh số từng từ, và phím Return chuyển sang ô tiếp theo.";
"settings.about.history.v357.send" = "Khi gửi, số tiền hiển thị trong lúc giao dịch đang thực hiện, một thông báo rõ ràng hơn xuất hiện nếu không thể gửi, và các yêu cầu TRON tự động thử lại sau lỗi tạm thời của nhà cung cấp.";
"settings.about.history.v357.security" = "Các tài khoản TRON đã nhập có quyền chủ sở hữu bị chuyển sang khóa khác giờ đây hiển thị cảnh báo và không thể gửi, ngay cả khi mỗi quyền chỉ liệt kê một khóa. Nhiều cụm từ khôi phục và khóa riêng đã biết là bị lộ bị từ chối khi nhập.";
"settings.about.history.v356.localization" = "Nội dung màn hình chào mừng đã được chỉnh sửa để rõ ràng và tự nhiên hơn ở tất cả ngôn ngữ được hỗ trợ.";
"settings.about.history.v356.pricing" = "Giá mã thông báo hiện khớp với mạng và địa chỉ mã thông báo chính xác, trước tiên sử dụng giá DEX. Giá nhỏ hiển thị tới 8 chữ số thập phân mà không làm tròn.";
"settings.about.history.v356.appearance" = "Các nút chính và phụ hiện sử dụng độ cao và lề màn hình nhất quán, với màu xanh lam của hệ thống cho các hành động chính.";
"settings.about.history.v356.transactions" = "Chi tiết giao dịch sử dụng trạng thái Đã xác nhận ngắn hơn và văn bản màu xám rõ ràng hơn về ngày, địa chỉ, số tiền và ID giao dịch.";
"settings.about.history.v356.security" = "Mở rộng danh sách các cụm từ khôi phục đã biết và khóa riêng không thể nhập được.";

