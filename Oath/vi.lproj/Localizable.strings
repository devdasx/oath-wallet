"onboarding.carousel.open_source.visual.match" = "KHỚP HOÀN TOÀN — BẢN DỰNG ĐÃ XÁC MINH";
"onboarding.carousel.open_source.visual.accessibility" = "Sơ đồ cho thấy việc xác minh bản phát hành cần mã nguồn công khai, một bản dựng lại độc lập và các dấu vân tay trùng khớp.";
