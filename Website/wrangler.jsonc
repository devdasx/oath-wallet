{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oath-website",
  "account_id": "27ca43420c32782f83aa2a734653df13",
  "compatibility_date": "2026-09-22",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "oathwallet.org",
      "custom_domain": true
    },
    {
      "pattern": "www.oathwallet.org",
      "custom_domain": true
    },
    {
      "pattern": "news.oathwallet.org",
      "custom_domain": true
    },
    {
      "pattern": "help.oathwallet.org",
      "custom_domain": true
    },
    {
      "pattern": "articles.oathwallet.org",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "VISITOR_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "NEWSLETTER_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
