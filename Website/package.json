{
  "name": "oath-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:search": "node scripts/build-search-content.mjs",
    "predeploy": "npm run build:brand && npm run build:press && npm run build:bounty && npm run build:footer-networks && npm run build:networks && npm run build:help-chrome && npm run build:walkthroughs && npm run build:articles && npm run build:seo && npm run build:search && npm run build:site-chrome && npm run build:agents",
    "build:seo": "node scripts/build-seo.mjs",
    "deploy": "wrangler deploy",
    "postdeploy": "node scripts/submit-indexnow.mjs",
    "notify:search": "node scripts/submit-indexnow.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-site.mjs",
    "build:walkthroughs": "node scripts/build-walkthroughs.mjs",
    "build:help-chrome": "node scripts/build-help-chrome.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "build:agents": "node scripts/build-agent-content.mjs",
    "build:networks": "node scripts/build-network-guides.mjs",
    "build:footer-networks": "node scripts/sync-footer-networks.mjs",
    "build:site-chrome": "node scripts/build-site-chrome.mjs",
    "build:articles": "node scripts/build-article-index.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "build:bounty": "node scripts/build-bug-bounty.mjs",
    "build:press": "node scripts/build-press.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "wrangler": "4.154.0"
  }
}
