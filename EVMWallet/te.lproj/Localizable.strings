"onboarding.carousel.open_source.visual.repository" = "పబ్లిక్ సోర్స్ రిపాజిటరీ";
"onboarding.carousel.open_source.visual.repository.path" = "చూడండి: github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "సోర్స్ కోడ్‌ను పరిశీలించండి";
"onboarding.carousel.open_source.visual.rebuild" = "రిలీజ్ బిల్డ్‌ను పునరుత్పత్తి చేయండి";
"onboarding.carousel.open_source.visual.compare" = "బిల్డ్ ఆర్టిఫాక్ట్‌లను పోల్చండి";
"onboarding.carousel.open_source.visual.fingerprint" = "ప్రచురిత రిలీజ్ ఫింగర్ప్రింట్";
"onboarding.carousel.open_source.visual.match" = "సరిపోలిక నిర్ధారితమైంది — బిల్డ్ ధృవీకరించబడింది";
"onboarding.carousel.open_source.visual.accessibility" = "రిలీజ్ ధృవీకరణకు పబ్లిక్ సోర్స్ కోడ్, స్వతంత్ర రీబిల్డ్, సరిపోలే ఫింగర్‌ప్రింట్‌లు అవసరమని చూపే రేఖాచిత్రం.";
"onboarding.carousel.passphrase.eyebrow" = "ఐచ్ఛిక BIP-39 పాస్‌ఫ్రేజ్";
"onboarding.carousel.passphrase.title" = "ఒక రికవరీ పదబంధం. మరో రహస్యం.";
"onboarding.carousel.passphrase.message" = "ప్రత్యేక వాలెట్‌ను ఉత్పన్నం చేయడానికి BIP-39 పాస్‌ఫ్రేజ్ మీ రికవరీ పదబంధంతో కలుస్తుంది. రికవరీ పదాలు బహిర్గతమైనా, ఆ వాలెట్‌ను యాక్సెస్ చేయడానికి ఖచ్చితమైన పాస్‌ఫ్రేజ్ అవసరమే.";
"onboarding.carousel.passphrase.visual.phrase" = "మీ 24 రికవరీ పదాలు";
"onboarding.carousel.passphrase.visual.passphrase" = "మీ అదనపు రహస్య పాస్‌ఫ్రేజ్";
"onboarding.carousel.passphrase.visual.output" = "ప్రత్యేక పాస్‌ఫ్రేజ్ వాలెట్";
"onboarding.carousel.passphrase.visual.requirement" = "రికవరీకి రెండు రహస్యాలూ అవసరం";
"onboarding.carousel.passphrase.visual.accessibility" = "24 పదాల రికవరీ పదబంధం, రహస్య BIP-39 పాస్‌ఫ్రేజ్ కలిసి ప్రత్యేక వాలెట్‌ను ఉత్పన్నం చేస్తాయి; దాని రికవరీకి రెండు రహస్యాలూ అవసరం.";
"onboarding.carousel.passphrase.learn_more.action" = "మరిన్ని వివరాలను తెలుసుకోండి";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 పాస్‌ఫ్రేజ్‌లను అర్థం చేసుకోండి";
"onboarding.passphrase.learn_more.path.section" = "రెండు రహస్యాల నుంచి ఒక వాలెట్";
"onboarding.passphrase.learn_more.overview" = "BIP-39 పాస్‌ఫ్రేజ్ అనేది మీ రికవరీ పదబంధంతో కలిపే ఐచ్ఛిక రహస్యం. రెండూ కలిసి, రికవరీ పదబంధం ఒక్కటే సృష్టించే వాలెట్‌కు భిన్నమైన వాలెట్‌ను నిర్ణీత విధానంలో ఉత్పన్నం చేస్తాయి.";
"onboarding.passphrase.learn_more.visual.phrase" = "మీ 24 పదాల రికవరీ పదబంధం";
"onboarding.passphrase.learn_more.visual.passphrase" = "మీ రహస్య పాస్‌ఫ్రేజ్";
"onboarding.passphrase.learn_more.visual.wallet" = "పాస్‌ఫ్రేజ్‌తో రక్షిత వాలెట్";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 పదాల రికవరీ పదబంధం, రహస్య పాస్‌ఫ్రేజ్ కలిసి ప్రత్యేకమైన, పాస్‌ఫ్రేజ్‌తో రక్షిత వాలెట్‌ను ఉత్పన్నం చేస్తాయి.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 వాలెట్‌ను ఎలా ఉత్పన్నం చేస్తుంది";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "పాస్‌ఫ్రేజ్‌తో కలిపిన రికవరీ పదబంధం";
"onboarding.passphrase.learn_more.derivation.visual.function" = "2,048 రౌండ్ల PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-బిట్ మాస్టర్ సీడ్";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "ఉత్పన్నమైన వాలెట్ ఖాతాలు, చిరునామాలు";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "మీ రికవరీ పదబంధం, పాస్‌ఫ్రేజ్ PBKDF2-HMAC-SHA512లో 2,048 రౌండ్లు ప్రాసెస్ అయి 512-బిట్ సీడ్‌ను రూపొందిస్తాయి; ఆ సీడ్ నుంచి వాలెట్ ఖాతాలు, చిరునామాలు ఉత్పన్నమవుతాయి.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 సాధారణీకరించిన రికవరీ పదబంధాన్ని PBKDF2 పాస్‌వర్డ్‌గా పరిగణిస్తుంది; “mnemonic” తర్వాత సాధారణీకరించిన పాస్‌ఫ్రేజ్‌ను జోడించిన విలువను సాల్ట్‌గా ఉపయోగిస్తుంది. PBKDF2-HMAC-SHA512లో 2,048 రౌండ్ల తర్వాత 64-బైట్ సీడ్ ఏర్పడుతుంది.";
"onboarding.passphrase.learn_more.derivation.normalization" = "సీడ్‌ను ఉత్పన్నం చేసే ముందు, ఒకే సాధారణీకరించిన రికవరీ పదబంధం, పాస్‌ఫ్రేజ్ ఎల్లప్పుడూ అదే వాలెట్‌ను తిరిగి సృష్టించేలా BIP-39 కోరే Unicode సాధారణీకరణను Oath వర్తింపజేస్తుంది.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "పాస్‌ఫ్రేజ్ మీ రికవరీ పదాలను ఎన్‌క్రిప్ట్ చేయదు. అది ఉత్పన్నమయ్యే సీడ్‌ను మారుస్తుంది, కాబట్టి ప్రతి భిన్నమైన పాస్‌ఫ్రేజ్ భిన్నమైన ఖాతాలు, చిరునామాలను సృష్టిస్తుంది.";
"onboarding.passphrase.learn_more.wallets.section" = "ప్రతి పాస్‌ఫ్రేజ్ ప్రత్యేక వాలెట్‌ను ఉత్పన్నం చేస్తుంది";
"onboarding.passphrase.learn_more.wallets.visual.one" = "ఉదాహరణ పాస్‌ఫ్రేజ్ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "ఉదాహరణ పాస్‌ఫ్రేజ్ 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "ఉదాహరణ వాలెట్ A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "ఉదాహరణ వాలెట్ B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "ఒకే రికవరీ పదబంధాన్ని రెండు భిన్నమైన పాస్‌ఫ్రేజ్‌లతో కలిపితే రెండు ప్రత్యేక వాలెట్‌లు ఉత్పన్నమవుతాయి: వాలెట్ A, వాలెట్ B.";
"onboarding.passphrase.learn_more.wallets.different" = "అర్థవంతమైన ఒక్క అక్షరాన్ని మార్చినా భిన్నమైన సీడ్, దాంతో భిన్నమైన వాలెట్ ఉత్పన్నమవుతుంది; అసలు వాలెట్ మారదు.";
"onboarding.passphrase.learn_more.wallets.empty" = "ఖాళీ పాస్‌ఫ్రేజ్ రికవరీ పదబంధం ఒక్కదాని నుంచి ఉత్పన్నమైన ప్రామాణిక వాలెట్‌ను తెరుస్తుంది; ఖాళీ కాని పాస్‌ఫ్రేజ్ దాని స్వంత ప్రత్యేక వాలెట్‌ను తెరుస్తుంది.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39లో “తప్పు పాస్‌ఫ్రేజ్” అనే ప్రతిస్పందన లేదు; ప్రతి పాస్‌ఫ్రేజ్ చెల్లుబాటే. అందువల్ల టైపింగ్ పొరపాటు తెలియకుండానే సాధారణంగా 0 బ్యాలెన్స్ ఉన్న మరో వాలెట్‌ను తెరుస్తుంది.";
"onboarding.passphrase.learn_more.security.section" = "పాస్‌ఫ్రేజ్ రక్షణను ఎలా పెంచుతుంది";
"onboarding.passphrase.learn_more.security.words.title" = "రికవరీ పదాలు మాత్రమే సరిపోవు";
"onboarding.passphrase.learn_more.security.words.detail" = "మీ రికవరీ పదబంధం మాత్రమే ఎవరికైనా లభించినా, రక్షిత వాలెట్‌ను ఉత్పన్నం చేసి యాక్సెస్ చేయడానికి వారికి ఖచ్చితమైన పాస్‌ఫ్రేజ్ ఇంకా అవసరం.";
"onboarding.passphrase.learn_more.security.strength.title" = "బలమైన పాస్‌ఫ్రేజ్ మెరుగైన రక్షణనిస్తుంది";
"onboarding.passphrase.learn_more.security.strength.detail" = "పొడవైన, ఊహించలేని పాస్‌ఫ్రేజ్‌ను అంచనా వేయడం ఎంతో కష్టం; చిన్న ఉల్లేఖనం, పుట్టినరోజు, పేరు లేదా మళ్లీ ఉపయోగించిన పాస్‌వర్డ్‌ను త్వరగా ఊహించవచ్చు, కాబట్టి అది చాలా తక్కువ రక్షణనిస్తుంది.";
"onboarding.passphrase.learn_more.security.separation.title" = "పాస్‌ఫ్రేజ్‌ను విడిగా ఉంచండి";
"onboarding.passphrase.learn_more.security.separation.detail" = "దొంగిలించబడిన ఒక్క బ్యాకప్ వాలెట్ రికవరీకి అవసరమైన రెండు రహస్యాలనూ బయటపెట్టకుండా ఉండేందుకు, పాస్‌ఫ్రేజ్‌ను రికవరీ పదబంధానికి వేరుగా భద్రపరచండి.";
"onboarding.passphrase.learn_more.security.footer" = "రెండు రహస్యాలూ బహిర్గతమైతే, పాస్‌ఫ్రేజ్ బలహీనంగా ఉంటే లేదా మీరు టైప్ చేస్తున్నప్పుడు భద్రత కోల్పోయిన సాఫ్ట్‌వేర్ దాన్ని సంగ్రహిస్తే, పాస్‌ఫ్రేజ్ మీ నిధులకు రక్షణ కల్పించదు.";
"onboarding.passphrase.learn_more.safety.section" = "దీన్ని సురక్షితంగా ఉపయోగించండి";
"onboarding.passphrase.learn_more.safety.strong.title" = "బలమైన, ప్రత్యేకమైన పాస్‌ఫ్రేజ్‌ను సృష్టించండి";
"onboarding.passphrase.learn_more.safety.strong.detail" = "ఈ వాలెట్‌కే ప్రత్యేకమైన అనేక యాదృచ్ఛిక పదాలను లేదా మరో అధిక-ఎంట్రోపీ విలువను ఎంచుకోండి. వ్యక్తిగత విషయాలు, సుపరిచిత పదబంధాలు, నమూనాలు, ఇతర చోట్ల ఉపయోగించిన పాస్‌వర్డ్‌లను నివారించండి.";
"onboarding.passphrase.learn_more.safety.backup.title" = "పాస్‌ఫ్రేజ్‌ను విడిగా బ్యాకప్ చేయండి";
"onboarding.passphrase.learn_more.safety.backup.detail" = "ఖచ్చితమైన పాస్‌ఫ్రేజ్‌కు మన్నికైన ఆఫ్‌లైన్ నకలును రూపొందించి, రికవరీ పదబంధానికి వేరుగా భద్రపరచండి; జ్ఞాపకశక్తిపైనే ఆధారపడవద్దు.";
"onboarding.passphrase.learn_more.safety.exact.title" = "ప్రతి అక్షరం వాలెట్‌ను మారుస్తుంది";
"onboarding.passphrase.learn_more.safety.exact.detail" = "ప్రతి పెద్ద అక్షరం, ఖాళీ, విరామ చిహ్నం, పదంతో సహా పాస్‌ఫ్రేజ్‌ను సృష్టించినట్లుగానే మళ్లీ నమోదు చేయండి. ఏ చిన్న తేడా ఉన్నా తెలియకుండానే మరో వాలెట్ ఉత్పన్నమవుతుంది.";
"onboarding.passphrase.learn_more.safety.verify.title" = "నిధులు జోడించే ముందు రికవరీని ధృవీకరించండి";
"onboarding.passphrase.learn_more.safety.verify.detail" = "గణనీయమైన నిధులను స్వీకరించే ముందు, రికవరీ పదబంధం, పాస్‌ఫ్రేజ్ ఆశించిన చిరునామాలను మళ్లీ సృష్టిస్తున్నాయని నిర్ధారించడానికి గోప్యంగా, నియంత్రిత రికవరీ పరీక్షను నిర్వహించండి.";
"onboarding.passphrase.learn_more.safety.footer" = "కోల్పోయిన పాస్‌ఫ్రేజ్‌ను రీసెట్ చేయడం గానీ తిరిగి పొందడం గానీ ఏ సేవకూ సాధ్యం కాదు. మీ వద్ద రికవరీ పదబంధం ఉన్నా, ఖచ్చితమైన పాస్‌ఫ్రేజ్ లేకపోతే ఆ వాలెట్‌కు యాక్సెస్ శాశ్వతంగా కోల్పోతారు.";
"passcode.accessibility.label" = "యాప్ పాస్‌కోడ్";
"passcode.keypad.delete" = "చివరి అంకెను తొలగించండి";
