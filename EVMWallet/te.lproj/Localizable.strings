"evm_access.gas.insufficient.body" = "నెట్‌వర్క్ రుసుము చెల్లించడానికి ఈ వాలెట్‌కు %@ జోడించండి. ఇందుకు %@ నెట్‌వర్క్‌ను ఉపయోగించండి, ఆపై అనుమతిని రద్దు చేయడానికి మళ్లీ ప్రయత్నించండి.";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "రికవరీ పదబంధం ధృవీకరణ, స్వయంచాలక చిన్న అక్షరాలు, సంఖ్యలతో ఇన్‌పుట్, క్లియర్ చేయడం, బ్యాక్‌స్పేస్ నొక్కి ఉంచి తొలగించడం, కీబోర్డ్ ప్రవర్తన మెరుగుపడ్డాయి. రికవరీ స్క్రీన్‌లలో ఇప్పుడు ఒకే వెనుకకు బటన్ ఉంది.";
