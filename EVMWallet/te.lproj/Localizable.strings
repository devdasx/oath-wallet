"onboarding.carousel.entropy.title" = "పూర్తిగా మీ నియంత్రణలో ఉండే యాదృచ్ఛికతను సృష్టించండి.";
"onboarding.carousel.entropy.message" = "పాచికలు వేయండి, నాణెం ఎగరవేయండి లేదా యాదృచ్ఛిక అంకెలను నమోదు చేయండి. Oath మీ భౌతిక ఇన్‌పుట్‌ను మీ పరికరంలోనే 24 పదాల రికవరీ పదబంధానికి అవసరమైన సరిగ్గా 256 బిట్‌ల ఎంట్రోపీగా మారుస్తుంది.";
"onboarding.carousel.entropy.visual.output" = "వినియోగదారు సృష్టించిన 256 బిట్‌ల ఎంట్రోపీ";
"onboarding.carousel.entropy.visual.local" = "మీరు నమోదు చేసిన ఇన్‌పుట్‌ల నుంచే పూర్తిగా సృష్టించబడింది";
"onboarding.carousel.entropy.visual.accessibility" = "సంఖ్యలున్న పాచిక, నాణెం, యాదృచ్ఛిక అంకెలు కలిసి ఈ పరికరంలో 256 బిట్‌ల వాలెట్ ఎంట్రోపీని రూపొందిస్తాయి.";
"onboarding.carousel.entropy.learn_more.action" = "మరిన్ని వివరాలను తెలుసుకోండి";
"onboarding.entropy.learn_more.navigation" = "భౌతిక ఎంట్రోపీ ఎలా పనిచేస్తుంది";
"onboarding.entropy.learn_more.path.section" = "భౌతిక ఫలితాల నుంచి రికవరీ పదాల వరకు";
"onboarding.entropy.learn_more.overview" = "Oath మీరు ఎంచుకున్న భౌతిక మూలం నుంచి ఫలితాలను నమోదు చేసి, వాటిని 256-బిట్ విలువగా మారుస్తుంది. ఆపై ఏర్పడిన 32 బైట్‌లను ప్రామాణిక BIP-39 రికవరీ పదబంధాన్ని సృష్టించడానికి Wallet Coreకు పంపుతుంది.";
"onboarding.entropy.learn_more.visual.phrase" = "24 పదాల BIP-39 రికవరీ పదబంధం";
"onboarding.entropy.learn_more.visual.bits" = "32 బైట్లు × 8 బిట్‌లు = 256 బిట్‌లు";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 బైట్‌లుగా అమర్చిన 256 నమూనా బిట్ సెల్‌ల గ్రిడ్.";
"onboarding.entropy.learn_more.visual.accessibility" = "పాచికల ఫలితాలు, నాణెం ఎగరవేతలు లేదా యాదృచ్ఛిక అంకెలు 256 బిట్‌లుగా, ఆపై 24 పదాల BIP-39 రికవరీ పదబంధంగా మారతాయి.";
"onboarding.entropy.learn_more.inputs.section" = "దశ 1: భౌతిక ఫలితాలను నమోదు చేయండి";
"onboarding.entropy.learn_more.inputs.dice.title" = "సమతుల్యమైన ఆరు ముఖాల పాచికను వేయండి";
"onboarding.entropy.learn_more.inputs.dice.detail" = "సమతుల్యమైన పాచికలో 1–4 ముఖాలు ఒక్కొక్కటి 2 బిట్‌లను; 5–6 ముఖాలు ఒక్కొక్కటి 1 బిట్‌ను అందిస్తాయి.";
"onboarding.entropy.learn_more.inputs.coin.title" = "నాణెం ఎగరవేతలు";
"onboarding.entropy.learn_more.inputs.coin.detail" = "సమతుల్యమైన నాణెాన్ని స్వతంత్రంగా ఎగరవేసిన ప్రతిసారీ ఒక పక్షపాతరహిత ఎంట్రోపీ బిట్ లభిస్తుంది.";
"onboarding.entropy.learn_more.inputs.digits.title" = "యాదృచ్ఛిక అంకెలను నమోదు చేయండి";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 అంకెలు ఒక్కొక్కటి 3 బిట్‌లను; 8–9 అంకెలు ఒక్కొక్కటి 1 బిట్‌ను అందిస్తాయి. అంకెలు నిజంగా యాదృచ్ఛికమైన భౌతిక ప్రక్రియ నుంచి రావాలి.";
"onboarding.entropy.learn_more.inputs.footer" = "సమతుల్యమైన భౌతిక మూలాన్ని ఉపయోగించి ప్రతి ఫలితాన్ని క్రమంలో నమోదు చేయండి. ఆమోదించిన ప్రతి ఫలితం ఒకే బిట్ స్ట్రీమ్‌కు చేరుతుంది కాబట్టి, మీరు ఇన్‌పుట్ పద్ధతులను మార్చవచ్చు.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-బిట్ విలువను రూపొందించండి";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath పాచికల ఫలితాలు, దశాంశ అంకెలను పక్షపాతంలేని రెండు ఘాతాల సమూహాలుగా మారుస్తుంది. అందే బిట్‌ల సంఖ్య మారవచ్చు; అయితే భౌతిక మూలం సమతుల్యంగా ఉంటే ఏ బిట్ విలువకూ ప్రాధాన్యం లభించదు.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath సరిగ్గా 256 బిట్‌లు చేరేవరకు నమోదు చేసిన క్రమంలో వాటిని జోడించి, తర్వాత అత్యంత ప్రాముఖ్యమైన బిట్‌ను ముందుగా ఉంచి వాటిని 32 బైట్‌లుగా ప్యాక్ చేస్తుంది.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "కస్టమ్ ఎంట్రోపీలో మీరు నమోదు చేసే భౌతిక ఇన్‌పుట్‌లు మాత్రమే ఉంటాయి; Oath పరికరం సృష్టించిన యాదృచ్ఛికతను అందులో కలపదు.";
"onboarding.entropy.learn_more.bip39.section" = "3. రికవరీ పదబంధాన్ని సృష్టించండి";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 బిట్‌ల ఎంట్రోపీ";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-బిట్ BIP-39 చెక్‌సమ్";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 బిట్‌లను 11 బిట్‌ల చొప్పున 24 పద సూచికలుగా విభజించడం";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-బిట్ ఎంట్రోపీ విలువకు 8-బిట్ చెక్‌సమ్‌ను జోడించి 264 బిట్‌లను రూపొందిస్తారు; వాటిని 11 బిట్‌ల చొప్పున 24 పద సూచికలుగా విభజిస్తారు.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39, 32-బైట్ ఎంట్రోపీ విలువపై SHA-256ను గణించి, మొదటి 8 హ్యాష్ బిట్‌లను చెక్‌సమ్‌గా తీసుకుంటుంది; ఆ చెక్‌సమ్‌ను జోడించడంతో 264 బిట్‌లు ఏర్పడతాయి.";
"onboarding.entropy.learn_more.bip39.words" = "264 బిట్‌లను 11 బిట్‌ల చొప్పున 24 సమూహాలుగా విభజిస్తారు. ప్రతి సమూహం ప్రామాణిక 2,048 పదాల BIP-39 జాబితా నుంచి ఒక ఎంట్రీని ఎంచుకుని, 24 పదాల రికవరీ పదబంధాన్ని రూపొందిస్తుంది.";
"onboarding.entropy.learn_more.bip39.derivation" = "ఫలితంగా వచ్చే సీడ్ నుంచి Wallet Core నిర్ణీత విధానంలో ఖాతాలు, చిరునామాలను ఉత్పన్నం చేస్తుంది. ఒకే రికవరీ పదబంధం, ఐచ్ఛిక పాస్‌ఫ్రేజ్ ఎల్లప్పుడూ అదే వాలెట్‌ను మళ్లీ సృష్టిస్తాయి.";
"onboarding.entropy.learn_more.security.section" = "కస్టమ్ ఎంట్రోపీ భద్రతను ఎలా బలోపేతం చేస్తుంది";
"onboarding.entropy.learn_more.security.space.title" = "అపారమైన అవకాశాల పరిధి";
"onboarding.entropy.learn_more.security.space.detail" = "ఏకరీతి 256-బిట్ ఎంట్రోపీలో 2^256 ప్రత్యేక విలువలు ఉంటాయి; వాటన్నింటినీ ఊహించి పరీక్షించడం గణనపరంగా అసాధ్యం. ఇది ఇన్‌పుట్ పరిధి పరిమాణాన్ని మాత్రమే వివరిస్తుంది; ప్రతి క్రిప్టోగ్రాఫిక్ భాగం 256-బిట్ దాడి నిరోధకతను అందిస్తుందని దీని అర్థం కాదు.";
"onboarding.entropy.learn_more.security.source.title" = "యాదృచ్ఛికత మీ నుంచే వస్తుంది";
"onboarding.entropy.learn_more.security.source.detail" = "భౌతిక సంఘటనల వల్ల పరికరంలోని యాదృచ్ఛిక సంఖ్యల జనరేటర్‌పైనే ఆధారపడకుండా, వాలెట్ యాదృచ్ఛికతను స్వతంత్రంగా పొందవచ్చు. ఆ సంఘటనలు నిజంగా యాదృచ్ఛికంగా ఉన్నప్పుడే భద్రత మెరుగుపడుతుంది.";
"onboarding.entropy.learn_more.security.local.title" = "పూర్తిగా ఈ పరికరంలోనే ప్రాసెస్ అవుతుంది";
"onboarding.entropy.learn_more.security.local.detail" = "Oath మీరు నమోదు చేసిన క్రమాన్ని మార్చి, రికవరీ పదబంధాన్ని పూర్తిగా ఈ పరికరంలోనే సృష్టిస్తుంది. ప్రాసెసింగ్ కోసం మీ క్రమం ఎప్పటికీ అప్‌లోడ్ చేయబడదు.";
"onboarding.entropy.learn_more.security.patterns.title" = "మనుషులు ఎంచుకున్న రహస్యాలను నివారించండి";
"onboarding.entropy.learn_more.security.patterns.detail" = "సమతుల్యమైన, స్వతంత్ర సంఘటనల సుదీర్ఘ క్రమాన్ని ఊహించడం, మనిషి ఎంచుకున్న పుట్టినరోజులు, ఇష్టమైన సంఖ్యలు, పునరావృత నమూనాలు లేదా పదాలను ఊహించడం కంటే చాలా కష్టం.";
"onboarding.entropy.learn_more.security.footer" = "భౌతిక ఎంట్రోపీ పరికరం సృష్టించే వాలెట్ యాదృచ్ఛికత స్థానాన్ని భర్తీ చేస్తుంది; ఇది అదనపు పాస్‌వర్డ్ లేదా భద్రతా పొర కాదు.";
"onboarding.entropy.learn_more.safety.section" = "దీన్ని సురక్షితంగా ఉపయోగించండి";
"onboarding.entropy.learn_more.safety.fair.title" = "సమతుల్యమైన, స్వతంత్ర ఫలితాలను నమోదు చేయండి";
"onboarding.entropy.learn_more.safety.fair.detail" = "సమతుల్యమైన నాణెం లేదా పాచికను ఉపయోగించి, ప్రతి ఫలితం ఇతర ఫలితాల నుంచి స్వతంత్రంగా ఉండేలా చూసుకోండి. యాదృచ్ఛిక అంకెలు నిజమైన భౌతిక మూలం నుంచి రావాలి—జ్ఞాపకం లేదా నమూనా నుంచి కాదు.";
"onboarding.entropy.learn_more.safety.private.title" = "మీ ఎంట్రోపీ ప్రక్రియను గోప్యంగా ఉంచండి";
"onboarding.entropy.learn_more.safety.private.detail" = "నమోదు చేసిన క్రమాన్ని, పూర్తయిన రికవరీ పదబంధాన్ని వాలెట్ రహస్యాలుగా రక్షించండి. అవి కెమెరాలకు లేదా ఇతర వ్యక్తులకు కనిపించకుండా ఉంచండి.";
"onboarding.entropy.learn_more.safety.accurate.title" = "ప్రతి ఫలితాన్ని ఖచ్చితంగా రికార్డ్ చేయండి";
"onboarding.entropy.learn_more.safety.accurate.detail" = "ఒక్క ఫలితం తప్పినా, రెండుసార్లు నమోదైనా లేదా క్రమం మారినా మరో వాలెట్ సృష్టించబడుతుంది. వాలెట్‌కు నిధులు జోడించే ముందు ప్రతి నమోదును పరిశీలించి, పూర్తయిన రికవరీ పదబంధాన్ని ధృవీకరించండి.";
"onboarding.entropy.learn_more.safety.backup.title" = "రికవరీ పదబంధాన్ని సురక్షితంగా ఉంచండి";
"onboarding.entropy.learn_more.safety.backup.detail" = "రికవరీ పదబంధాన్ని ఆఫ్‌లైన్‌లో ఉంచి, ఎవరితోనూ పంచుకోవద్దు. మీ బ్యాకప్‌ను ధృవీకరించిన తర్వాత, ఇక అవసరం లేని మధ్యంతర ఇన్‌పుట్ రికార్డులను సురక్షితంగా నాశనం చేయండి.";
"onboarding.entropy.learn_more.safety.footer" = "బహిర్గతమైన రికవరీ పదబంధం, భద్రత కోల్పోయిన పరికరం, హానికరమైన సాఫ్ట్‌వేర్ లేదా తప్పుగా నమోదైన క్రమం నుంచి భౌతిక ఎంట్రోపీ రక్షణ కల్పించదు. సమతుల్యమైన, గోప్యమైన, ఖచ్చితమైన ఇన్‌పుట్‌లకు హామీ ఇవ్వలేకపోతే, ప్రామాణిక వాలెట్ సృష్టి పద్ధతిని ఉపయోగించండి.";
"onboarding.carousel.open_source.eyebrow" = "రూపకల్పన నుంచే ఓపెన్ సోర్స్";
"onboarding.carousel.open_source.title" = "సోర్స్‌ను పరిశీలించండి. బిల్డ్‌ను ధృవీకరించండి.";
"onboarding.carousel.open_source.message" = "స్వతంత్ర పరిశీలన కోసం Oath తన సోర్స్ కోడ్‌ను ప్రచురిస్తుంది. పునరుత్పాదక బిల్డ్ ప్రచురించిన యాప్ ఫింగర్‌ప్రింట్‌తో సరిపోలినప్పుడే రిలీజ్ ధృవీకరించబడుతుంది.";
