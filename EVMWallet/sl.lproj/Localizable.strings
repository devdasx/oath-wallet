// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Začetni zaslon se odpre brez bledenja ali spreminjanja velikosti. Gumb za nastavitve zdaj uporablja ikono zobnika.";
"settings.about.history.v355.build58.fields" = "Polja za transakcije in pošiljanje uporabljajo običajne barve besedila. Puščice so prikazane le v vrsticah, ki odprejo zaslon ali podokno; z dotikom zneska ali provizije še vedno preklopite enoto.";
"settings.about.history.v355.build58.banners" = "Ko so obvestila o potrjevanju ali potrditvi prikazana, izginejo po 3 sekundah, tudi če odprete drug zaslon. Še neprikazane potrditve se prikažejo ob vrnitvi.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Prenosi TRON zdaj pred izračunom zneska za pošiljanje rezervirajo sredstva za aktivacijo in pasovno širino, tudi pri pošiljanju največjega zneska. Pregled prikaže pravilen znesek po odštetju provizij.";
"settings.about.history.v355.build59.fees" = "Prilagojene provizije TRON morajo pokriti zahtevane omrežne stroške. Pri nizkem stanju TRX se zdaj prikažejo jasnejša navodila. Količina žetonov ostane nespremenjena; provizije se plačajo v TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Nova dobrodošlica";
"settings.about.history.v356.welcome" = "Nov pozdravni zaslon z animirano sliko in jasnimi možnostmi za ustvarjanje ali uvoz denarnice.";
"settings.about.history.v357.tour.title" = "Uvodni ogled";
"settings.about.history.v357.tour" = "Ogled na petih straneh predstavi podprta omrežja, fizično entropijo, pošiljanje in prejemanje, varnost in preverjene gradnje. Za menjavo strani podrsnite ali tapnite pike; preklop jezika je v navigacijski vrstici.";
"settings.about.history.v357.backup" = "Po ustvarjanju, uvozu ali obnovitvi denarnice se zaslon prikaže takoj, možnosti varnostnega kopiranja pa uporabljajo standardni seznam. Preverjanje iClouda poteka v ozadju, gumb Odpri denarnico pa je pripravljen, takoj ko je denarnica shranjena.";
"settings.about.history.v357.reliability" = "Vrnitev iz ozadja ne zapre več zaslona za nastavitev, ko poteče skriti zaslon za obnovitev, brisanje vseh podatkov pa neposredno odpre pozdravni zaslon.";
