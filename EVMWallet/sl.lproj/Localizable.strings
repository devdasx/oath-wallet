"onboarding.passphrase.learn_more.derivation.section" = "Kako BIP-39 izpelje denarnico";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Obnovitvena fraza v kombinaciji z geslom";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 z 2.048 ponovitvami";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bitno glavno seme";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Izpeljani računi in naslovi denarnice";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Vaša obnovitvena fraza in geslo gresta skozi 2.048 krogov PBKDF2-HMAC-SHA512, da proizvedeta 512-bitno seme, iz katerega izhajajo računi in naslovi denarnice.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 obravnava normalizirano obnovitveno frazo kot geslo PBKDF2 in uporablja »mnemoniko«, ki ji sledi normalizirana fraza kot sol. Po 2048 krogih PBKDF2-HMAC-SHA512 postopek ustvari 64-bajtno seme.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Preden izpelje seme, Oath uporabi normalizacijo Unicode, ki jo zahteva BIP-39, tako da ista normalizirana obnovitvena fraza in geslo vedno reproducirata isto denarnico.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Geslo ne šifrira vaših obnovitvenih besed. Spremeni izpeljano seme, tako da vsako drugo geslo ustvari različne račune in naslove.";
