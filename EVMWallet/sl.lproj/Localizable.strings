"onboarding.carousel.entropy.eyebrow" = "ENTROPIJA IZ FIZIČNIH VNOSOV";
"onboarding.carousel.entropy.title" = "Ustvarite naključnost, ki jo popolnoma nadzorujete.";
"onboarding.carousel.entropy.message" = "Vrzite kocke, vrzite kovanec ali zapišite naključne številke. Oath pretvori vaš fizični vnos v natanko 256 bitov entropije za obnovitveno frazo s 24 besedami, v celoti v vaši napravi.";
"onboarding.carousel.entropy.visual.output" = "256 bitov uporabniško ustvarjene entropije";
"onboarding.carousel.entropy.visual.local" = "V celoti ustvarjeno iz vaših posnetih vnosov";
"onboarding.carousel.entropy.visual.accessibility" = "Oštevilčena kocka, kovanec in naključne števke skupaj ustvarijo 256 bitov entropije denarnice v tej napravi.";
"onboarding.carousel.entropy.learn_more.action" = "Raziščite več podrobnosti";
"onboarding.entropy.learn_more.navigation" = "Kako deluje fizična entropija";
"onboarding.entropy.learn_more.path.section" = "Od fizičnih rezultatov do obnovitvenih besed";
"onboarding.entropy.learn_more.overview" = "Oath zabeleži rezultate izbranega fizičnega vira in jih pretvori v 256-bitno vrednost. Nastalih 32 bajtov nato posreduje ogrodju Wallet Core, ki ustvari standardno obnovitveno frazo BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "24-besedna obnovitvena fraza BIP-39";
"onboarding.entropy.learn_more.visual.bits" = "32 bajtov × 8 bitov je enako 256 bitov";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Mreža 256 vzorčnih bitnih celic, razvrščenih v 32 bajtov.";
"onboarding.entropy.learn_more.visual.accessibility" = "Meti kock, meti kovancev ali naključne števke se pretvorijo v 256 bitov in nato v 24-besedno obnovitveno frazo BIP-39.";
"onboarding.entropy.learn_more.inputs.section" = "1. korak: Zabeležite fizične rezultate";
"onboarding.entropy.learn_more.inputs.dice.title" = "Vrzite pošteno šeststransko kocko";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Pri pošteni kocki vsak obraz 1–4 prispeva 2 bita; obrazi 5–6 vsak prispevajo 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fizični meti kovancev";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Vsak pošten in neodvisen met kovanca prispeva en nepristranski bit entropije.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zabeležite naključne številke";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Številke 0–7 vsaka prispevajo 3 bite; števke 8–9 prispevajo vsaka 1 bit. Številke morajo izhajati iz resnično naključnega fizičnega procesa.";
"onboarding.entropy.learn_more.inputs.footer" = "Uporabite pošten fizični vir in zabeležite vsak rezultat po vrstnem redu. Metode vnosa lahko zamenjate, ker vsak sprejet rezultat prispeva k istemu bitnemu toku.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sestavite 256-bitno vrednost";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath pretvori rezultate kocke in decimalne števke v nepristranske skupine moči dveh. Dolžine prispevkov so lahko različne, vendar pošten fizični vir ne daje prednosti nobeni bitni vrednosti.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath dodaja bite v vnesenem vrstnem redu, dokler jih ne zbere točno 256, nato pa jih zapakira v 32 bajtov, pri čemer je najpomembnejši bit prvi.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropija po meri vsebuje samo fizične vnose, ki jih zabeležite; Oath ne doda naključnosti, ki jo ustvari naprava.";
"onboarding.entropy.learn_more.bip39.section" = "3. Izpeljite frazo za obnovitev";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitov entropije";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-bitna kontrolna vsota BIP-39";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bitov, razdeljenih na 24 enajstbitnih besednih indeksov";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-bitna entropijska vrednost prejme 8-bitno kontrolno vsoto, ki proizvede 264 bitov, ki se razdelijo na 24 enajstbitnih besednih indeksov.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 izračuna SHA-256 preko 32-bajtne vrednosti entropije in vzame prvih 8 zgoščenih bitov kot kontrolno vsoto; dodajanje te kontrolne vsote proizvede 264 bitov.";
"onboarding.entropy.learn_more.bip39.words" = "264 bitov je razdeljenih v 24 skupin po 11 bitov. Vsaka skupina izbere en vnos s standardnega 2048-besednega seznama BIP-39, da ustvari 24-besedno frazo za obnovitev.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core izpelje deterministične račune in naslove iz nastalega semena. Ista obnovitvena fraza in neobvezno geslo bosta vedno znova ustvarila isto denarnico.";
"onboarding.entropy.learn_more.security.section" = "Kako Entropija po meri krepi varnost";
"onboarding.entropy.learn_more.security.space.title" = "Ogromen prostor možnosti";
"onboarding.entropy.learn_more.security.space.detail" = "Enotna 256-bitna entropija vsebuje 2^256 edinstvenih vrednosti, zaradi česar je izčrpno ugibanje računalniško neizvedljivo. To opisuje velikost vhodnega prostora; to ne pomeni, da vsaka kriptografska komponenta zagotavlja 256-bitno odpornost proti napadom.";
"onboarding.entropy.learn_more.security.source.title" = "Naključnost prihaja iz vas";
"onboarding.entropy.learn_more.security.source.detail" = "Fizični dogodki vam omogočajo, da neodvisno pridobite naključnost denarnice, namesto da se zanašate samo na generator naključnih števil naprave. To izboljša varnost le, če so ti dogodki resnično naključni.";
"onboarding.entropy.learn_more.security.local.title" = "V celoti obdelano v tej napravi";
"onboarding.entropy.learn_more.security.local.detail" = "Oath v celoti v tej napravi pretvori zabeleženo zaporedje in ustvari obnovitveno frazo. Zaporedje se nikoli ne naloži v obdelavo.";
"onboarding.entropy.learn_more.security.patterns.title" = "Izogibajte se skrivnostim, ki so jih izbrali ljudje";
"onboarding.entropy.learn_more.security.patterns.detail" = "Dolgo zaporedje poštenih, neodvisnih dogodkov je veliko manj predvidljivo kot rojstni dnevi, priljubljene številke, ponavljajoči se vzorci ali besede, ki jih izbere oseba.";
"onboarding.entropy.learn_more.security.footer" = "Fizična entropija nadomešča naključnost denarnice, ki jo ustvari naprava; ni dodatno geslo ali varnostna plast.";
"onboarding.entropy.learn_more.safety.section" = "To funkcijo uporabljajte varno";
"onboarding.entropy.learn_more.safety.fair.title" = "Zabeležite poštene, neodvisne rezultate";
"onboarding.entropy.learn_more.safety.fair.detail" = "Uporabite pošten kovanec ali kocko in zagotovite, da je vsak rezultat neodvisen. Naključne številke morajo izvirati iz pristnega fizičnega vira – ne iz spomina ali vzorca.";
"onboarding.entropy.learn_more.safety.private.title" = "Naj bo vaš entropijski proces zaseben";
"onboarding.entropy.learn_more.safety.private.detail" = "Zaščitite posneto zaporedje in dokončano obnovitveno frazo kot skrivnosti denarnice. Hranite jih zunaj vidnega polja kamer in drugih ljudi.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Natančno zabeležite vsak rezultat";
"onboarding.entropy.learn_more.safety.accurate.detail" = "En manjkajoči, podvojen ali preurejen rezultat ustvari drugo denarnico. Preglejte vsak vnos in preverite izpolnjeno frazo za obnovitev, preden financirate denarnico.";
"onboarding.entropy.learn_more.safety.backup.title" = "Zavarujte frazo za obnovitev";
"onboarding.entropy.learn_more.safety.backup.detail" = "Frazo za obnovitev hranite brez povezave in je nikoli ne delite z drugimi. Ko preverite varnostno kopijo, varno uničite vse vmesne vhodne zapise, ki jih ne potrebujete več.";
"onboarding.entropy.learn_more.safety.footer" = "Fizična entropija ne more zaščititi izpostavljene fraze za obnovitev, ogrožene naprave, zlonamerne programske opreme ali nepravilno posnetega zaporedja. Če ne morete zagotoviti poštenih, zasebnih in točnih vnosov, namesto tega uporabite standardno ustvarjanje denarnice.";
"onboarding.carousel.open_source.eyebrow" = "ODPRTA KODA PO ZASNOVI";
