"onboarding.carousel.passphrase.eyebrow" = "NEOBVEZNO GESLO BIP-39";
"onboarding.carousel.passphrase.title" = "Ena obnovitvena fraza. Ena dodatna skrivnost.";
"onboarding.carousel.passphrase.message" = "Geslo BIP-39 se združi z vašo obnovitveno frazo, da izpelje ločeno denarnico. Tudi če so obnovitvene besede razkrite, dostop do te denarnice še vedno zahteva natančno geslo.";
