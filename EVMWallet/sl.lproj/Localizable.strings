"onboarding.passphrase.learn_more.path.section" = "Dve skrivnosti prinašata eno denarnico";
"onboarding.passphrase.learn_more.overview" = "Geslo BIP-39 je neobvezna skrivnost v kombinaciji z vašo frazo za obnovitev. Skupaj deterministično izpeljejo denarnico, ki se razlikuje od tiste, ustvarjene samo s obnovitvene fraze.";
"onboarding.passphrase.learn_more.visual.phrase" = "Vaš 24-besedni obnovitvena fraza";
