"onboarding.passphrase.learn_more.wallets.different" = "Spreminjanje celo enega pomembnega znaka izpelje drugačno seme in s tem drugačno denarnico; originalna denarnica ostane nespremenjena.";
"onboarding.passphrase.learn_more.wallets.empty" = "Prazno geslo odpre standardno denarnico, izpeljano samo iz obnovitvene fraze; neprazno geslo odpre ločeno denarnico.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nima odgovora »napačno geslo«; vsako geslo je veljavno, zato tipkarska napaka tiho odpre drugo denarnico - običajno z ničelnim stanjem.";
"onboarding.passphrase.learn_more.security.section" = "Kako geslo doda zaščito";
"onboarding.passphrase.learn_more.security.words.title" = "Samo obnovitvene besede niso dovolj";
"onboarding.passphrase.learn_more.security.words.detail" = "Kdor pridobi samo obnovitveno frazo, za izpeljavo in dostop do zaščitene denarnice še vedno potrebuje točno geslo.";
"onboarding.passphrase.learn_more.security.strength.title" = "Moč ustvarja boljšo ločitev";
"onboarding.passphrase.learn_more.security.strength.detail" = "Dolgo, nepredvidljivo geslo doda pomembne težave pri ugibanju; kratek citat, rojstni dan, ime ali ponovno uporabljeno geslo je mogoče hitro uganiti in nudi malo zaščite.";
"onboarding.passphrase.learn_more.security.separation.title" = "Geslo hranite ločeno";
"onboarding.passphrase.learn_more.security.separation.detail" = "Geslo shranite ločeno od obnovitvene fraze, tako da ena sama ukradena varnostna kopija ne razkrije obeh skrivnosti, potrebnih za obnovitev denarnice.";
"onboarding.passphrase.learn_more.security.footer" = "Geslo ne more zaščititi vaših sredstev, če sta razkriti obe skrivnosti, če je geslo šibko ali ga ogrožena programska oprema zajame med tipkanjem.";
"onboarding.passphrase.learn_more.safety.section" = "To funkcijo uporabljajte varno";
"onboarding.passphrase.learn_more.safety.strong.title" = "Ustvarite močno, edinstveno geslo";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Izberite več naključnih besed ali drugo visokoentropijsko vrednost, ki je edinstvena za to denarnico. Izogibajte se osebnim dejstvom, znanim stavkom, vzorcem in geslom, ki se uporabljajo drugje.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Ločeno varnostno kopirajte geslo";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Naredite trajno kopijo natančnega gesla brez povezave, jo shranite ločeno od obnovitvene fraze in se nikoli ne zanašajte samo na spomin.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Vsak znak spremeni denarnico";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Znova vnesite geslo natanko tako, kot je bilo ustvarjeno, vključno z vsemi velikimi črkami, presledki, ločili in besedami. Vsaka razlika tiho izpelje drugo denarnico.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Pred dodajanjem sredstev preverite obnovitev";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Preden prejmete znatna sredstva, izvedite zaseben, nadzorovan preskus obnovitve, da potrdite, da obnovitvena fraza in geslo ponovno ustvarjata pričakovane naslove.";
"onboarding.passphrase.learn_more.safety.footer" = "Nobena storitev ne more ponastaviti ali obnoviti izgubljenega gesla. Brez natančnega gesla je dostop do te denarnice trajno izgubljen – tudi če še vedno imate obnovitvena fraza.";
