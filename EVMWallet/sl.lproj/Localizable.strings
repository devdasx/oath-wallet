"settings.about.history.v357.wallets" = "Denarnice v preklopniku prerazporedite z dolgim pritiskom in sistemsko animacijo dviga; dotik vrstice jo aktivira. Preverjanje fraze za obnovitev oštevilči vsako besedo, tipka Return pa preide na naslednje polje.";
"settings.about.history.v357.send" = "Med pošiljanjem je prikazan znesek, dokler prenos poteka, ob neuspehu se prikaže jasnejše sporočilo, zahteve TRON pa se po začasnih napakah ponudnika samodejno ponovijo.";
"settings.about.history.v357.security" = "Uvoženi računi TRON, katerih lastniško dovoljenje je bilo preneseno na drug ključ, zdaj prikazujejo opozorilo in ne morejo pošiljati, tudi če vsako dovoljenje navaja en sam ključ. Ob uvozu je zavrnjenih več znanih razkritih fraz za obnovitev in zasebnih ključev.";
"settings.about.history.v356.localization" = "Besedilo na pozdravnem zaslonu je zdaj bolj naravno in razumljivo v vseh podprtih jezikih.";
"settings.about.history.v356.pricing" = "Cene žetonov se zdaj natančno ujemajo z omrežjem in naslovom žetona, pri čemer se najprej uporabljajo cene DEX. Male cene prikazujejo do 8 decimalnih mest brez zaokroževanja.";
"settings.about.history.v356.appearance" = "Primarni in sekundarni gumbi zdaj uporabljajo dosledne višine in robove zaslona, s sistemsko modro za primarna dejanja.";
