"settings.about.history.v357.reliability" = "छिपी हुई रिकवरी स्क्रीन की अवधि समाप्त होने पर पृष्ठभूमि से लौटना अब सेटअप स्क्रीन बंद नहीं करता, और सारा डेटा मिटाने पर सीधे स्वागत स्क्रीन खुलती है।";
"settings.about.history.v357.notifications" = "सूचना सेटिंग्स श्रेणियों और स्थिति के लिए तकनीकी विवरण के बिना सरल भाषा का उपयोग करती हैं।";
"settings.about.history.v357.wallets" = "स्विचर में वॉलेट को देर तक दबाकर सिस्टम के उठाने वाले एनिमेशन के साथ फिर से क्रमबद्ध करें; किसी पंक्ति पर टैप करने से वह सक्रिय हो जाती है। रिकवरी फ़्रेज़ सत्यापन हर शब्द को क्रमांक देता है, और Return अगले फ़ील्ड पर ले जाता है।";
"settings.about.history.v357.send" = "स्थानांतरण चलते समय भेजने में राशि दिखती है, भेजा न जा सके तो अधिक स्पष्ट संदेश दिखता है, और अस्थायी प्रदाता त्रुटियों के बाद TRON अनुरोध अपने आप फिर से प्रयास करते हैं।";
"settings.about.history.v357.security" = "जिन आयातित TRON खातों की स्वामी अनुमति किसी दूसरी कुंजी पर ले जाई गई है, वे अब हर अनुमति में एक ही कुंजी होने पर भी चेतावनी दिखाते हैं और भेज नहीं सकते। उजागर हो चुकी और अधिक ज्ञात रिकवरी फ़्रेज़ तथा निजी कुंजियाँ आयात के समय अस्वीकार की जाती हैं।";
"settings.about.history.v356.localization" = "सभी समर्थित भाषाओं में स्वागत स्क्रीन की भाषा को अधिक सहज और स्पष्ट बनाया गया है।";
"settings.about.history.v356.pricing" = "टोकन की कीमतें अब पहले DEX कीमतों का उपयोग करके सटीक नेटवर्क और टोकन पते से मेल खाती हैं। छोटी कीमतें बिना पूर्णांकन के 8 दशमलव स्थानों तक दिखाई देती हैं।";
"settings.about.history.v356.appearance" = "प्राथमिक और द्वितीयक बटन अब प्राथमिक क्रियाओं के लिए सिस्टम ब्लू के साथ, लगातार ऊंचाई और स्क्रीन मार्जिन का उपयोग करते हैं।";
