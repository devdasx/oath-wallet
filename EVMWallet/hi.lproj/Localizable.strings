"onboarding.passphrase.learn_more.derivation.visual.function" = "2,048 राउंड वाला PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-बिट मास्टर सीड";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "निकाले गए वॉलेट खाते और पते";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "आपका रिकवरी फ़्रेज़ और पासफ़्रेज़ PBKDF2-HMAC-SHA512 के 2,048 राउंड से गुज़रकर 512-बिट सीड बनाते हैं, जिससे वॉलेट खाते और पते निकाले जाते हैं।";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 सामान्यीकृत रिकवरी फ़्रेज़ को PBKDF2 पासवर्ड मानता है और \"mnemonic\" के बाद सामान्यीकृत पासफ़्रेज़ जोड़कर उसे salt की तरह इस्तेमाल करता है। PBKDF2-HMAC-SHA512 के 2,048 राउंड के बाद 64-बाइट सीड बनता है।";
"onboarding.passphrase.learn_more.derivation.normalization" = "सीड निकालने से पहले Oath, BIP-39 के लिए ज़रूरी Unicode normalization लागू करता है, ताकि वही सामान्यीकृत रिकवरी फ़्रेज़ और पासफ़्रेज़ हमेशा वही वॉलेट दोबारा बनाएँ।";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "पासफ़्रेज़ आपके रिकवरी शब्दों को एन्क्रिप्ट नहीं करता। वह निकले हुए सीड को बदलता है, इसलिए हर अलग पासफ़्रेज़ अलग खाते और पते बनाता है।";
"onboarding.passphrase.learn_more.wallets.section" = "हर पासफ़्रेज़ से अलग वॉलेट निकलता है";
"onboarding.passphrase.learn_more.wallets.visual.one" = "उदाहरण पासफ़्रेज़ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "उदाहरण पासफ़्रेज़ 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "उदाहरण वॉलेट A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "उदाहरण वॉलेट B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "एक ही रिकवरी फ़्रेज़ को 2 अलग पासफ़्रेज़ के साथ मिलाने पर 2 अलग वॉलेट—वॉलेट A और वॉलेट B—निकलते हैं।";
"onboarding.passphrase.learn_more.wallets.different" = "एक भी महत्वपूर्ण कैरेक्टर बदलने पर अलग सीड और इसलिए अलग वॉलेट निकलता है; मूल वॉलेट नहीं बदलता।";
"onboarding.passphrase.learn_more.wallets.empty" = "खाली पासफ़्रेज़ केवल रिकवरी फ़्रेज़ से निकला मानक वॉलेट खोलता है; गैर-खाली पासफ़्रेज़ अपना अलग वॉलेट खोलता है।";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 में “गलत पासफ़्रेज़” का कोई जवाब नहीं होता। हर पासफ़्रेज़ मान्य है, इसलिए टाइप की गलती चुपचाप दूसरा वॉलेट खोल देती है—आमतौर पर 0 बैलेंस वाला।";
"onboarding.passphrase.learn_more.security.section" = "यह सुरक्षा कैसे जोड़ता है";
"onboarding.passphrase.learn_more.security.words.title" = "केवल रिकवरी शब्द काफ़ी नहीं हैं";
"onboarding.passphrase.learn_more.security.words.detail" = "अगर किसी को केवल रिकवरी फ़्रेज़ मिल जाए, तब भी सुरक्षित वॉलेट निकालने और उस तक पहुँचने के लिए उसे सटीक पासफ़्रेज़ चाहिए।";
"onboarding.passphrase.learn_more.security.strength.title" = "सुरक्षा ताकत से आती है";
"onboarding.passphrase.learn_more.security.strength.detail" = "लंबा और अनुमान न लगाया जा सकने वाला पासफ़्रेज़ अनुमान लगाना काफ़ी कठिन बनाता है। छोटा उद्धरण, जन्मदिन, नाम या दोबारा इस्तेमाल किया गया पासवर्ड जल्दी अनुमान लगाया जा सकता है और बहुत कम सुरक्षा देता है।";
"onboarding.passphrase.learn_more.security.separation.title" = "पासफ़्रेज़ अलग रखें";
"onboarding.passphrase.learn_more.security.separation.detail" = "पासफ़्रेज़ को रिकवरी फ़्रेज़ से अलग रखने पर एक बैकअप चोरी होने से सुरक्षित वॉलेट रिकवर करने के लिए ज़रूरी सारी जानकारी उजागर नहीं होती।";
"onboarding.passphrase.learn_more.security.footer" = "दोनों सीक्रेट उजागर हों, पासफ़्रेज़ कमज़ोर हो या असुरक्षित सॉफ़्टवेयर दर्ज करते समय उसे पकड़ ले, तो पासफ़्रेज़ फंड की सुरक्षा नहीं कर सकता।";
"onboarding.passphrase.learn_more.safety.section" = "इस सुविधा का सुरक्षित इस्तेमाल करें";
"onboarding.passphrase.learn_more.safety.strong.title" = "मज़बूत और अनोखा पासफ़्रेज़ बनाएँ";
"onboarding.passphrase.learn_more.safety.strong.detail" = "केवल इस वॉलेट के लिए उपयोग किए जाने वाले कई बेतरतीब ढंग से चयनित शब्दों या किसी अन्य उच्च-एन्ट्रॉपी मान को प्राथमिकता दें। व्यक्तिगत तथ्यों, परिचित वाक्यांशों, पैटर्न या अन्यत्र उपयोग किए गए पासवर्ड पर भरोसा न करें।";
"onboarding.passphrase.learn_more.safety.backup.title" = "पासफ़्रेज़ का अलग बैकअप लें";
"onboarding.passphrase.learn_more.safety.backup.detail" = "सटीक पासफ़्रेज़ की टिकाऊ ऑफ़लाइन कॉपी बनाएँ, उसे रिकवरी फ़्रेज़ से अलग रखें और केवल याददाश्त पर कभी निर्भर न रहें।";
