"send.submit.error.tron_signature" = "TRON लेन-देन के हस्ताक्षर की पुष्टि नहीं कर सका। खाते की हस्ताक्षर अनुमतियाँ जाँचें: अतिरिक्त हस्ताक्षरों या किसी अन्य अधिकृत कुंजी की आवश्यकता हो सकती है।";

"tron.permissions.warning.title" = "कई हस्ताक्षरों वाला TRON वॉलेट";
"tron.permissions.warning.body" = "इस वॉलेट के लिए कई TRON हस्ताक्षर ज़रूरी हैं। इस ऐप में भेजना, प्राप्त करना और वॉलेट की कार्रवाइयाँ बंद हैं।\n\nकई हस्ताक्षरों वाले वॉलेट का वैध उपयोग भी होता है। अगर किसी ने आपको यह वॉलेट दिया है, तो इसके टोकन अनलॉक करने के लिए TRX जमा न करें। ज़रूरी हस्ताक्षरों पर उस व्यक्ति का नियंत्रण हो सकता है और वह आपकी जमा राशि चुरा सकता है।";
"tron.permissions.unavailable" = "TRON की हस्ताक्षर अनुमतियों की पुष्टि नहीं हो सकी।";

