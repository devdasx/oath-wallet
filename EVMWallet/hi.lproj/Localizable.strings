"settings.about.history.v352.build50.safety" = "बिल्ड 50: TRON मल्टीसिग और USDT/USDC प्रतिबंधों की संयुक्त चेतावनियाँ। TRON मल्टीसिग ट्रांसफ़र बंद रहते हैं, जबकि सेटिंग्स उपलब्ध रहती हैं। हस्ताक्षर संबंधी त्रुटियाँ और आयात के निर्देश अधिक स्पष्ट; रिकवरी फ़्रेज़ की ब्लॉक सूची अपडेट की गई।";

"settings.about.history.v352.build50.input" = "आयात के बाद कीमतें तेज़ी से लोड होती हैं। शून्य बैलेंस पर इकाइयाँ बदलने और दाएँ से बाएँ लिखी जाने वाली भाषाओं में कन्वर्टर में टाइप करने की समस्याएँ ठीक की गईं। रिकवरी शब्दों का क्रम बना रहता है; मान्य फ़्रेज़ पेस्ट या स्कैन करने पर कीबोर्ड बंद हो जाता है।";

"settings.about.history.v352.build50.interface" = "होम स्क्रीन और एसेट पिन करने के अधिक सहज ऐनिमेशन, अधिक हैप्टिक प्रतिक्रिया और बेहतर अनुवाद। प्राप्ति कार्ड डार्क मोड में बड़े QR कोड और पते के टेक्स्ट के साथ उपलब्ध हैं। बदलाव चेकमार्क से सहेजे जाते हैं; चेतावनियाँ केवल ज़रूरी जानकारी दिखाती हैं।";

"evm_access.gas.insufficient.title" = "नेटवर्क शुल्क के लिए पर्याप्त बैलेंस नहीं है";
"evm_access.gas.insufficient.body" = "नेटवर्क शुल्क चुकाने के लिए इस वॉलेट में %@ जोड़ें। इसके लिए %@ नेटवर्क का इस्तेमाल करें, फिर अनुमति रद्द करने की दोबारा कोशिश करें।";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "रिकवरी फ़्रेज़ की जाँच, अपने-आप छोटे अक्षरों में बदलाव, क्रमांक सहित इनपुट, साफ़ करने, बैकस्पेस दबाए रखकर मिटाने और कीबोर्ड के व्यवहार में सुधार हुआ है। रिकवरी स्क्रीन पर अब केवल एक वापस जाने का बटन है।";
"settings.about.history.v353.build51.send" = "शुल्क का अनुमान उपलब्ध न होने पर सभी समर्थित नेटवर्क पर शुल्क का अनुमान लगाने के वैकल्पिक तरीके जोड़े गए हैं। भेजते समय कॉन्ट्रैक्ट पते छिपे रहते हैं और शुल्क अधिक स्पष्ट दिखता है।";
"settings.about.history.v353.build51.security" = "अनुमतियों की समीक्षा, पते का विवरण, अनुमति रद्द करने के परिणाम और शुल्क के लिए धन जोड़ने के निर्देश अधिक स्पष्ट हैं। बैकअप कार्ड और शीट का डिज़ाइन एक जैसा है। नेविगेशन के दौरान कंपन हटा दिया गया है।";
"settings.about.history.v353.build51.notifications" = "अलग-अलग नेटवर्क पर आने वाले ट्रांसफ़र की सूचनाएँ अधिक भरोसेमंद हैं। कीमत उपलब्ध होने पर राशि चुनी हुई मुद्रा में, अन्यथा क्रिप्टो की मूल इकाइयों में दिखाई जाती है।";

