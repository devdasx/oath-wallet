"settings.about.history.v352.recovery" = "क्रमांक वाले शब्द कैप्सूल टाइप करते समय बढ़ते हैं, सहज बदलाव दिखाते हैं, संपादन में बिंदुदार किनारा रखते हैं और शब्द हटाते समय अपनी जगह पर रहते हैं।";
"settings.about.history.v352.typing" = "अपने आप फ़ोकस, स्पेस या Enter से शब्द पूरा करना, Backspace से दो चरणों में संपादन, दबाकर रखने से हटाना और अपने आप स्क्रॉल करना। Enter केवल मान्य वाक्यांश होने पर कीबोर्ड छिपाता है।";
"settings.about.history.v352.passphrase" = "पहला पासफ़्रेज़ फ़ील्ड अपने आप फ़ोकस होता है। Enter से सत्यापन पर जाते हैं, फिर कीबोर्ड छिपता है। सही के निशान से सहेजने की क्रिया वापस लाई गई है।";
"settings.about.history.v352.navigation" = "प्रक्रिया में पीछे जाने पर स्वीकार किया गया इनपुट बना रहता है; प्रक्रिया बंद करने पर अधूरी प्रविष्टियाँ साफ़ हो जाती हैं।";
"settings.about.history.v352.scanner" = "QR स्कैन करने पर सिस्टम के बंद करने वाले बटन के साथ अलग कैमरा शीट खुलती है।";
"settings.about.history.v352.recipients" = "प्राप्तकर्ता इतिहास खाली होने पर अब त्रुटि या दोबारा कोशिश करने का संदेश नहीं दिखता।";
"settings.about.history.v352.amount" = "स्थानीय मुद्रा और संपत्ति की मूल इकाइयों के बीच बदलने के लिए रूपांतरण कैप्सूल पर टैप करें; इसमें दूसरी इकाई की बराबर राशि दिखती है।";
"settings.about.history.v352.visibility" = "प्रमाणीकरण या ऐप बदलने के बाद भी पते और लेनदेन ID दिखते रहते हैं। लंबे मान बिना अतिरिक्त हाइफ़न के अगली पंक्ति में जाते हैं।";
"settings.about.history.v352.op_return" = "Bitcoin संदेश लेनदेन की सीमाओं में 99,994 UTF-8 बाइट तक समर्थित हैं। अधिकतम राशि पर हस्ताक्षर की समस्या ठीक हुई; लंबे संदेश तीन पंक्तियों में दिखते हैं और शीट में पूरे खुलते हैं।";
"settings.about.history.v352.repeat" = "दोबारा भेजें पहले धन जाँचता है और शेष राशि कम होने पर अगला हस्तांतरण शुरू करने से पहले संवाद दिखाता है।";
"settings.about.history.v352.sharing" = "लेनदेन ID साझा करने के लिए अब अलग और सही अनुवाद वाला लेबल है।";
"settings.about.history.v352.localization" = "सभी 57 भाषाओं में अनूदित न किए गए या पुराने लेबल, संकेत-पाठ और नेटवर्क नाम सुधारे गए हैं, साथ ही स्थानीयकरण जाँच बेहतर की गई है।";
"settings.about.history.v352.icon" = "मौजूदा चित्र बनाए रखते हुए App Store वितरण के लिए आइकन की पारदर्शिता ठीक की गई।";
"settings.about.history.v352.backup" = "पुष्टि के बाद मौजूदा iCloud बैकअप बदले जा सकते हैं।";

"settings.about.history.v352.build48" = "बिल्ड 48: अनुवादित रिलीज़ नोट जोड़े गए। प्रदर्शन लॉग निर्यात और डेवलपर लॉगिंग हटा दिए गए हैं, और पुरानी निदान फ़ाइलें अपने आप साफ़ हो जाती हैं।";

