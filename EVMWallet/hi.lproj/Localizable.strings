"onboarding.passphrase.learn_more.visual.accessibility" = "24 शब्दों का रिकवरी फ़्रेज़ और गुप्त पासफ़्रेज़ मिलकर एक अलग, पासफ़्रेज़ से सुरक्षित वॉलेट निकालते हैं।";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 वॉलेट कैसे निकालता है";
