"onboarding.carousel.passphrase.learn_more.action" = "ज़्यादा जानकारी देखें";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 पासफ़्रेज़ को समझें";
"onboarding.passphrase.learn_more.path.section" = "2 सीक्रेट से 1 वॉलेट निकलता है";
"onboarding.passphrase.learn_more.overview" = "BIP-39 पासफ़्रेज़ एक वैकल्पिक सीक्रेट है जिसे आपके रिकवरी फ़्रेज़ के साथ जोड़ा जाता है। दोनों मिलकर तय तरीके से ऐसा वॉलेट निकालते हैं जो केवल रिकवरी फ़्रेज़ से बने वॉलेट से अलग होता है।";
