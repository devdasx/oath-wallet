// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "पुष्टि बटन की जगह अब स्लाइड करके भेजें। दिशा बताने वाला एनिमेशन, हैप्टिक प्रतिक्रिया और सहज गति, पढ़ने की दोनों दिशाओं में काम करते हैं। भेजने के लिए 90% या आगे पहुँचकर उँगली उठाएँ; रद्द करने के लिए वापस खिसकाएँ।";
"settings.about.history.v355.build56.activity" = "घंटी से लंबित गतिविधि खुलती है। लेनदेन कैप्सूल स्थिति बैज दिखाते हैं और स्वाइप करके छिपाए जा सकते हैं। पुष्टि जारी और पुष्ट कैप्सूल 3 सेकंड बाद छिपते हैं; पुष्टि होने पर वही दिखाई दे रहा कैप्सूल अपडेट होता है।";
"settings.about.history.v355.build56.status" = "सभी समर्थित नेटवर्क पर अधिक भरोसेमंद लेनदेन स्थिति, ताज़ा विवरण और भेजने के बाद तेज़ बैलेंस अपडेट। ऐप दोबारा खोलने पर लंबित लेनदेन की निगरानी फिर शुरू होती है।";
"settings.about.history.v355.build56.fees" = "उसी ट्रांसफ़र की समीक्षा पर लौटने से तैयार शुल्क बना रहता है। शुल्क लोड होने और खाते में धन की ज़रूरत की चेतावनियाँ अधिक स्पष्ट हैं; पर्याप्त राशि पर सक्रियण संबंधी संदेश नहीं दिखते।";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin और Dogecoin में डस्ट सीमा से कम बची हुई वापसी राशि को अनुपयोगी आउटपुट बनाने के बजाय शुल्क में जोड़ा जाता है। समीक्षा का शुल्क हस्ताक्षर के समय के शुल्क से मेल खाता है।";
"settings.about.history.v355.build56.stability" = "बैकग्राउंड कार्य का क्रैश और वॉलेट रीफ़्रेश की समय-सीमा संबंधी अलर्ट ठीक किए गए। अस्थायी रीफ़्रेश विफलता में वॉलेट की मौजूदा जानकारी उपलब्ध रहती है।";
"settings.about.history.v355.build56.backup" = "सही शुरुआती शीर्षकों और कम संदेशों के साथ अधिक स्पष्ट बैकअप स्क्रीन। निजी कुंजी तक पहुँच ऐप लॉक सेटिंग्स का पालन करती है। छोटे ग्लास आयात चेतावनी पैनल में दूसरा रिकवरी वाक्यांश चुनने पर अस्वीकृत इनपुट मिट जाता है।";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "भेजने का स्लाइडर छोड़ने के बाद, समीक्षा स्क्रीन बंद होने से पहले एक ऐनिमेटेड सही का निशान दिखाई देता है।";
"settings.about.history.v355.build57.activity" = "गतिविधि की पंक्तियों में स्थिति का टेक्स्ट कम मोटा, राशि उपशीर्षक के रूप में और लेन-देन का विवरण खोलने के लिए एक तीर दिखाई देता है।";
"settings.about.history.v355.build57.details" = "नेटवर्क शुल्क अब ट्रांसफ़र सारांश में दिखाई देता है। छोटे लेबल और नेटवर्क की एक ही पंक्ति से विवरण अधिक स्पष्ट हो गया है।";
"settings.about.history.v355.build57.resume" = "बैकग्राउंड से लौटने पर खुले स्क्रीन और पैनल बने रहते हैं, जिनमें ट्रांसफ़र समीक्षा और लेन-देन का विवरण भी शामिल हैं।";
"settings.about.history.v355.build57.secrets" = "ऐप से 20 सेकंड दूर रहने पर रिकवरी फ़्रेज़, निजी कुंजी और पासफ़्रेज़ के स्क्रीन बंद हो जाते हैं। ऐप लॉक आपकी सेटिंग के अनुसार काम करता रहता है।";
"settings.about.history.v355.build57.filters" = "नेटवर्क फ़िल्टर में थोड़े ऊँचे नेटिव बटन, सामग्री के अनुसार आकार और नेविगेशन बार के नीचे सुधरा हुआ अंतर है।";
"settings.about.history.v355.build57.units" = "मूल्य की अलग पंक्तियाँ हटा दी गई हैं। राशि और नेटवर्क शुल्क पहले स्थानीय मुद्रा में दिखते हैं; क्रिप्टो इकाइयों में बदलने और वापस लौटने के लिए किसी पर भी टैप करें।";
"wallet.transaction.details.toggle_units" = "इकाई बदलें।";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "होम स्क्रीन बिना फ़ेड या आकार बदलने वाले प्रभाव के खुलती है। सेटिंग्स बटन पर अब गियर का आइकन है।";
"settings.about.history.v355.build58.fields" = "लेन-देन और भेजने के फ़ील्ड में टेक्स्ट के सामान्य रंग दिखते हैं। तीर केवल उन पंक्तियों में दिखते हैं जो स्क्रीन या पैनल खोलती हैं; राशि और शुल्क पर टैप करने से अब भी इकाई बदलती है।";
"settings.about.history.v355.build58.banners" = "दिखाई देने के बाद, पुष्टि जारी होने या पूरी होने के बैनर 3 सेकंड में हट जाते हैं, भले ही आप दूसरी स्क्रीन खोल लें। पुष्टि के जो अपडेट अभी नहीं दिखे हैं, वे लौटने पर दिखाई देते हैं।";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON ट्रांसफ़र में अब अधिकतम राशि भेजते समय भी भेजी जाने वाली राशि की गणना से पहले सक्रियण और बैंडविड्थ शुल्क अलग रखे जाते हैं। समीक्षा स्क्रीन पर शुल्क कटने के बाद की सही राशि दिखाई देती है।";
"settings.about.history.v355.build59.fees" = "अपनी तय की गई TRON फ़ीस से नेटवर्क की ज़रूरी लागत पूरी होनी चाहिए। TRX बैलेंस कम होने पर अब ज़्यादा स्पष्ट मार्गदर्शन दिखता है। टोकन की मात्रा नहीं बदलती; शुल्क TRX में चुकाए जाते हैं।";

