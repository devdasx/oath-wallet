"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture देखें";
"onboarding.carousel.open_source.visual.source" = "स्रोत कोड का निरीक्षण करें";
"onboarding.carousel.open_source.visual.rebuild" = "रिलीज़ बिल्ड दोबारा बनाएँ";
"onboarding.carousel.open_source.visual.compare" = "बिल्ड आर्टिफ़ैक्ट की तुलना करें";
"onboarding.carousel.open_source.visual.fingerprint" = "प्रकाशित रिलीज़ फिंगरप्रिंट";
"onboarding.carousel.open_source.visual.match" = "मिलान की पुष्टि — बिल्ड सत्यापित";
"onboarding.carousel.open_source.visual.accessibility" = "एक आरेख जो दिखाता है कि सार्वजनिक स्रोत कोड, स्वतंत्र ऐप पुनर्निर्माण और मिलते-जुलते डिजिटल फिंगरप्रिंट्स सॉफ़्टवेयर रिलीज़ को सत्यापित करने के लिए आवश्यक हैं।";
"onboarding.carousel.passphrase.eyebrow" = "वैकल्पिक BIP-39 पासफ़्रेज़";
"onboarding.carousel.passphrase.title" = "एक रिकवरी फ़्रेज़। एक अतिरिक्त सीक्रेट।";
"onboarding.carousel.passphrase.message" = "BIP-39 पासफ़्रेज़ आपके रिकवरी फ़्रेज़ के साथ मिलकर एक अलग वॉलेट निकालता है। रिकवरी शब्द उजागर हो जाने पर भी उस वॉलेट तक पहुँचने के लिए सटीक पासफ़्रेज़ चाहिए।";
"onboarding.carousel.passphrase.visual.phrase" = "आपके 24 रिकवरी शब्द";
"onboarding.carousel.passphrase.visual.passphrase" = "आपका अतिरिक्त गुप्त पासफ़्रेज़";
