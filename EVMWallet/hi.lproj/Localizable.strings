"onboarding.carousel.entropy.visual.accessibility" = "नंबर वाला पासा, एक सिक्का और रैंडम अंक मिलकर इस डिवाइस पर 256 बिट की वॉलेट एन्ट्रॉपी बनाते हैं।";
"onboarding.carousel.entropy.learn_more.action" = "ज़्यादा जानकारी देखें";
"onboarding.entropy.learn_more.navigation" = "भौतिक एन्ट्रॉपी कैसे काम करती है";
"onboarding.entropy.learn_more.path.section" = "भौतिक नतीजों से रिकवरी शब्दों तक";
"onboarding.entropy.learn_more.overview" = "Oath आपके चुने हुए भौतिक स्रोत के नतीजे रिकॉर्ड करके उन्हें 256-बिट मान में बदलता है। फिर मानक BIP-39 रिकवरी फ़्रेज़ बनाने के लिए परिणामी 32 बाइट Wallet Core को दिए जाते हैं।";
"onboarding.entropy.learn_more.visual.phrase" = "24 शब्दों का BIP-39 रिकवरी फ़्रेज़";
"onboarding.entropy.learn_more.visual.bits" = "32 बाइट × 8 बिट, यानी 256 बिट";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "256 नमूना बिट सेल की एक ग्रिड, जिसे 32 बाइट में व्यवस्थित किया गया है।";
"onboarding.entropy.learn_more.visual.accessibility" = "पासे के नतीजे, सिक्के की उछाल या रैंडम अंक पहले 256 बिट में और फिर 24 शब्दों के BIP-39 रिकवरी फ़्रेज़ में बदले जाते हैं।";
"onboarding.entropy.learn_more.inputs.section" = "चरण 1: भौतिक नतीजे रिकॉर्ड करें";
"onboarding.entropy.learn_more.inputs.dice.title" = "छह फलकों वाला निष्पक्ष पासा फेंकें";
"onboarding.entropy.learn_more.inputs.dice.detail" = "निष्पक्ष पासे के फलक 1-4 में से हर फलक 2 बिट और फलक 5-6 में से हर फलक 1 बिट देता है।";
"onboarding.entropy.learn_more.inputs.coin.title" = "सिक्के को भौतिक रूप से उछालें";
"onboarding.entropy.learn_more.inputs.coin.detail" = "निष्पक्ष सिक्के की हर स्वतंत्र उछाल एन्ट्रॉपी का 1 निष्पक्ष बिट देती है।";
"onboarding.entropy.learn_more.inputs.digits.title" = "रैंडम अंक रिकॉर्ड करें";
"onboarding.entropy.learn_more.inputs.digits.detail" = "अंक 0-7 प्रत्येक 3 बिट्स का योगदान करते हैं। अंक 8-9 प्रत्येक 1 बिट का योगदान करते हैं। अंक वास्तव में यादृच्छिक भौतिक प्रक्रिया से आने चाहिए।";
"onboarding.entropy.learn_more.inputs.footer" = "निष्पक्ष भौतिक स्रोत इस्तेमाल करें और हर नतीजा क्रम से रिकॉर्ड करें। आप इनपुट का तरीका बदल सकते हैं, क्योंकि हर स्वीकार किया गया नतीजा उसी बिट स्ट्रीम में जुड़ता है।";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-बिट मान तैयार करें";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath पासे के नतीजों और दशमलव अंकों को 2 की घात वाले निष्पक्ष समूहों में बदलता है। मिलने वाले बिट की संख्या अलग हो सकती है, लेकिन निष्पक्ष भौतिक स्रोत किसी भी बिट मान को तरजीह नहीं देता।";
"onboarding.entropy.learn_more.conversion.packing" = "Oath बिट को दर्ज किए गए क्रम में तब तक जोड़ता है जब तक उनकी संख्या ठीक 256 न हो जाए, फिर सबसे महत्वपूर्ण बिट को पहले रखते हुए उन्हें 32 बाइट में पैक करता है।";
"onboarding.entropy.learn_more.conversion.no_mixing" = "कस्टम एन्ट्रॉपी में केवल आपके रिकॉर्ड किए हुए भौतिक इनपुट होते हैं; Oath इसमें डिवाइस की जनरेट की हुई रैंडमनेस नहीं मिलाता।";
"onboarding.entropy.learn_more.bip39.section" = "3. रिकवरी फ़्रेज़ निकालें";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 बिट की एन्ट्रॉपी";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-बिट BIP-39 चेकसम";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 बिट को 11-बिट वाले 24 शब्द इंडेक्स में बाँटा गया";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-बिट एन्ट्रॉपी मान में 8-बिट चेकसम जोड़ने पर 264 बिट बनते हैं, जिन्हें 11-बिट वाले 24 शब्द इंडेक्स में बाँटा जाता है।";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39, 32-बाइट एन्ट्रॉपी मान पर SHA-256 की गणना करके पहले 8 हैश बिट को चेकसम की तरह लेता है; वह चेकसम जोड़ने पर कुल 264 बिट बनते हैं।";
"onboarding.entropy.learn_more.bip39.words" = "264 बिट को 11 बिट के 24 समूहों में बाँटा जाता है। हर समूह मानक 2,048-शब्द वाली BIP-39 सूची से 1 प्रविष्टि चुनता है और इस तरह 24 शब्दों का रिकवरी फ़्रेज़ बनता है।";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core परिणामी सीड से तयशुदा खाते और पते निकालता है। वही रिकवरी फ़्रेज़ और वैकल्पिक पासफ़्रेज़ हमेशा वही वॉलेट दोबारा बनाएँगे।";
"onboarding.entropy.learn_more.security.section" = "कस्टम एन्ट्रॉपी सुरक्षा कैसे मज़बूत करती है";
"onboarding.entropy.learn_more.security.space.title" = "संभावनाओं का बेहद विशाल दायरा";
"onboarding.entropy.learn_more.security.space.detail" = "एकसमान 256-बिट एन्ट्रॉपी में 2^256 अलग-अलग मान होते हैं, इसलिए सभी संभावनाएँ आज़माना कंप्यूटेशन की दृष्टि से व्यावहारिक नहीं है। यह केवल इनपुट स्पेस का आकार बताता है; इसका अर्थ यह नहीं कि हर क्रिप्टोग्राफ़िक घटक 256-बिट हमले से सुरक्षा देता है।";
"onboarding.entropy.learn_more.security.source.title" = "रैंडमनेस आपसे आती है";
"onboarding.entropy.learn_more.security.source.detail" = "भौतिक घटनाओं से आप केवल डिवाइस के रैंडम नंबर जनरेटर पर निर्भर रहने के बजाय वॉलेट की रैंडमनेस का स्रोत खुद चुन सकते हैं। सुरक्षा तभी बेहतर होती है जब ये घटनाएँ सचमुच रैंडम हों।";
"onboarding.entropy.learn_more.security.local.title" = "पूरी प्रक्रिया इसी डिवाइस पर";
"onboarding.entropy.learn_more.security.local.detail" = "Oath आपके रिकॉर्ड किए हुए क्रम को बदलकर रिकवरी फ़्रेज़ पूरी तरह इसी डिवाइस पर बनाता है। आपका क्रम प्रोसेसिंग के लिए कभी अपलोड नहीं होता।";
"onboarding.entropy.learn_more.security.patterns.title" = "इंसान के चुने सीक्रेट से बचें";
"onboarding.entropy.learn_more.security.patterns.detail" = "निष्पक्ष, स्वतंत्र घटनाओं का एक लंबा क्रम जन्मदिनों, पसंदीदा संख्याओं, दोहराए गए पैटर्न, या किसी व्यक्ति द्वारा चुने गए शब्दों की तुलना में बहुत कम पूर्वानुमानित होता है।";
"onboarding.entropy.learn_more.security.footer" = "भौतिक एन्ट्रॉपी डिवाइस की जनरेट की हुई वॉलेट रैंडमनेस की जगह लेती है; यह कोई अतिरिक्त पासवर्ड या सुरक्षा की दूसरी परत नहीं है।";
"onboarding.entropy.learn_more.safety.section" = "इस सुविधा का सुरक्षित इस्तेमाल करें";
"onboarding.entropy.learn_more.safety.fair.title" = "निष्पक्ष और स्वतंत्र नतीजे रिकॉर्ड करें";
"onboarding.entropy.learn_more.safety.fair.detail" = "निष्पक्ष सिक्का या पासा इस्तेमाल करें और पक्का करें कि हर नतीजा स्वतंत्र हो। रैंडम अंक किसी असली भौतिक स्रोत से आने चाहिए—याददाश्त या किसी पैटर्न से नहीं।";
"onboarding.entropy.learn_more.safety.private.title" = "एन्ट्रॉपी बनाने की प्रक्रिया निजी रखें";
"onboarding.entropy.learn_more.safety.private.detail" = "रिकॉर्ड किए गए क्रम और पूरे रिकवरी फ़्रेज़, दोनों को वॉलेट सीक्रेट की तरह सुरक्षित रखें। इन्हें कैमरे और दूसरे लोगों की नज़र से दूर रखें।";
"onboarding.entropy.learn_more.safety.accurate.title" = "प्रत्येक परिणाम को सटीक रूप से रिकॉर्ड करें";
"onboarding.entropy.learn_more.safety.accurate.detail" = "एक भी नतीजा छूटने, दो बार दर्ज होने या उसका क्रम बदलने से अलग वॉलेट बन जाता है। हर प्रविष्टि जाँचें और वॉलेट में फंड जोड़ने से पहले पूरे रिकवरी फ़्रेज़ का सत्यापन करें।";
"onboarding.entropy.learn_more.safety.backup.title" = "रिकवरी फ़्रेज़ सुरक्षित रखें";
"onboarding.entropy.learn_more.safety.backup.detail" = "रिकवरी फ़्रेज़ ऑफ़लाइन रखें और इसे कभी साझा न करें। बैकअप का सत्यापन करने के बाद, बीच में बनाए गए जिन इनपुट रिकॉर्ड की अब ज़रूरत नहीं है उन्हें सुरक्षित रूप से नष्ट कर दें।";
"onboarding.entropy.learn_more.safety.footer" = "भौतिक एन्ट्रॉपी उजागर हो चुके रिकवरी फ़्रेज़, असुरक्षित डिवाइस, नुकसानदेह सॉफ़्टवेयर या गलत रिकॉर्ड किए गए क्रम को सुरक्षित नहीं कर सकती। अगर आप निष्पक्ष, निजी और सटीक इनपुट सुनिश्चित नहीं कर सकते, तो वॉलेट बनाने का मानक तरीका इस्तेमाल करें।";
"onboarding.carousel.open_source.eyebrow" = "डिज़ाइन से ही ओपन-सोर्स";
"onboarding.carousel.open_source.title" = "सोर्स कोड देखें। सॉफ़्टवेयर बिल्ड सत्यापित करें।";
"onboarding.carousel.open_source.message" = "Oath स्वतंत्र जाँच के लिए अपना सोर्स कोड प्रकाशित करता है। कोई रिलीज़ तभी सत्यापित मानी जाती है जब दोबारा बनाया जा सकने वाला बिल्ड प्रकाशित ऐप के फिंगरप्रिंट से मेल खाए।";
"onboarding.carousel.open_source.action.github" = "GitHub पर समीक्षा करें";
