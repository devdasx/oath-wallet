"onboarding.carousel.wallet.eyebrow" = "SUA OATH WALLET";
"onboarding.carousel.wallet.title" = "Uma carteira para cada movimento.";
"onboarding.carousel.wallet.message" = "O Oath oferece aos seus ativos um espaço moderno e nativo, com clareza entre as redes, respostas rápidas e controle inteiramente seu.";
"onboarding.carousel.wallet.visual.networks" = "Uma visão unificada entre redes";
"onboarding.carousel.wallet.visual.accessibility" = "Prévia do Oath exibindo o saldo da carteira, as ações Enviar, Receber e Escanear, além de ativos Ethereum e Bitcoin.";
"onboarding.carousel.entropy.eyebrow" = "ENTROPIA DE ENTRADAS FÍSICAS";
"onboarding.carousel.entropy.title" = "Crie uma aleatoriedade sob seu total controle.";
"onboarding.carousel.entropy.message" = "Lance um dado, jogue uma moeda ou registre dígitos aleatórios. O Oath converte sua entrada física em exatamente 256 bits de entropia para uma frase de recuperação de 24 palavras, tudo no seu dispositivo.";
"onboarding.carousel.entropy.visual.output" = "256 bits de entropia gerada por você";
"onboarding.carousel.entropy.visual.local" = "Gerada inteiramente a partir das entradas registradas";
"onboarding.carousel.entropy.visual.accessibility" = "Um dado numerado, uma moeda e dígitos aleatórios se combinam para produzir 256 bits de entropia da carteira neste dispositivo.";
"onboarding.carousel.entropy.learn_more.action" = "Ver mais detalhes";
"onboarding.entropy.learn_more.navigation" = "Como funciona a entropia física";
"onboarding.entropy.learn_more.path.section" = "Dos resultados físicos às palavras de recuperação";
"onboarding.entropy.learn_more.overview" = "O Oath registra os resultados da fonte física escolhida e os converte em um valor de 256 bits. Em seguida, os 32 bytes resultantes são enviados ao Wallet Core para criar uma frase de recuperação BIP-39 padrão.";
"onboarding.entropy.learn_more.visual.phrase" = "Frase de recuperação BIP-39 de 24 palavras";
"onboarding.entropy.learn_more.visual.bits" = "32 bytes × 8 bits equivalem a 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Uma grade com 256 células de bits de exemplo, organizadas em 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Lançamentos de dado, lançamentos de moeda ou dígitos aleatórios são convertidos em 256 bits e depois em uma frase de recuperação BIP-39 de 24 palavras.";
"onboarding.entropy.learn_more.inputs.section" = "Etapa 1: registre os resultados físicos";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lance um dado não viciado de seis faces";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Com um dado não viciado, cada face de 1–4 contribui com 2 bits; cada face de 5–6 contribui com 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lançamentos físicos de moeda";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Cada lançamento independente de uma moeda não viciada contribui com 1 bit de entropia sem viés.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registre dígitos aleatórios";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cada dígito de 0–7 contribui com 3 bits; cada dígito de 8–9 contribui com 1 bit. Os dígitos devem vir de um processo físico realmente aleatório.";
"onboarding.entropy.learn_more.inputs.footer" = "Use uma fonte física sem viés e registre todos os resultados na ordem. Você pode alternar entre os métodos, pois cada resultado aceito contribui para o mesmo fluxo de bits.";
"onboarding.entropy.learn_more.conversion.section" = "2. Monte um valor de 256 bits";
"onboarding.entropy.learn_more.conversion.mapping" = "O Oath converte resultados do dado e dígitos decimais em grupos de potências de dois sem viés. O tamanho das contribuições pode variar, mas uma fonte física sem viés não favorece nenhum valor de bit.";
"onboarding.entropy.learn_more.conversion.packing" = "O Oath acrescenta os bits na ordem em que são inseridos até reunir exatamente 256. Depois, compacta-os em 32 bytes, começando pelo bit mais significativo.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "A entropia personalizada contém apenas as entradas físicas que você registra; o Oath não adiciona aleatoriedade gerada pelo dispositivo.";
"onboarding.entropy.learn_more.bip39.section" = "3. Derive a frase de recuperação";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bits de entropia";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Uma soma de verificação BIP-39 de 8 bits";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits divididos em 24 índices de palavras de 11 bits";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Um valor de entropia de 256 bits recebe uma soma de verificação de 8 bits, produzindo 264 bits que são divididos em 24 índices de palavras de 11 bits.";
"onboarding.entropy.learn_more.bip39.checksum" = "O BIP-39 calcula o SHA-256 do valor de entropia de 32 bytes e usa os primeiros 8 bits do hash como soma de verificação; anexar essa soma produz 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "Os 264 bits são divididos em 24 grupos de 11 bits. Cada grupo seleciona uma entrada da lista BIP-39 padrão de 2.048 palavras para produzir a frase de recuperação de 24 palavras.";
"onboarding.entropy.learn_more.bip39.derivation" = "O Wallet Core deriva contas e endereços determinísticos da semente resultante. A mesma frase de recuperação e a mesma frase secreta opcional sempre recriarão a mesma carteira.";
"onboarding.entropy.learn_more.security.section" = "Como a entropia personalizada reforça a segurança";
"onboarding.entropy.learn_more.security.space.title" = "Um vasto espaço de possibilidades";
"onboarding.entropy.learn_more.security.space.detail" = "A entropia uniforme de 256 bits contém 2^256 valores únicos, o que torna uma tentativa exaustiva computacionalmente inviável. Isso descreve o tamanho do espaço de entrada; não significa que todos os componentes criptográficos ofereçam resistência a ataques de 256 bits.";
"onboarding.entropy.learn_more.security.source.title" = "A aleatoriedade vem de você";
"onboarding.entropy.learn_more.security.source.detail" = "Eventos físicos permitem que você gere a aleatoriedade da carteira de forma independente, sem depender apenas do gerador de números aleatórios do dispositivo. Isso só reforça a segurança quando os eventos são realmente aleatórios.";
"onboarding.entropy.learn_more.security.local.title" = "Processado inteiramente neste dispositivo";
"onboarding.entropy.learn_more.security.local.detail" = "O Oath converte a sequência registrada e cria a frase de recuperação inteiramente neste dispositivo. A sequência nunca é enviada para processamento.";
"onboarding.entropy.learn_more.security.patterns.title" = "Evite segredos escolhidos por pessoas";
"onboarding.entropy.learn_more.security.patterns.detail" = "Uma longa sequência de eventos aleatórios, equiprováveis e independentes é muito menos previsível do que aniversários, números favoritos, padrões repetidos ou palavras escolhidas por uma pessoa.";
"onboarding.entropy.learn_more.security.footer" = "A entropia física substitui a aleatoriedade da carteira gerada pelo dispositivo; ela não é uma senha adicional nem outra camada de segurança.";
"onboarding.entropy.learn_more.safety.section" = "Use este recurso com segurança";
"onboarding.entropy.learn_more.safety.fair.title" = "Registre resultados sem viés e independentes";
"onboarding.entropy.learn_more.safety.fair.detail" = "Use uma moeda ou um dado não viciado e garanta que cada resultado seja independente. Os dígitos aleatórios devem vir de uma fonte física realmente aleatória, não da memória nem de um padrão.";
"onboarding.entropy.learn_more.safety.private.title" = "Mantenha seu processo de entropia em sigilo";
"onboarding.entropy.learn_more.safety.private.detail" = "Proteja tanto a sequência registrada quanto a frase de recuperação concluída como segredos da carteira. Mantenha-as fora do alcance de câmeras e de outras pessoas.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registre cada resultado com exatidão";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Um resultado ausente, duplicado ou fora de ordem cria outra carteira. Revise cada entrada e verifique a frase de recuperação concluída antes de adicionar fundos à carteira.";
"onboarding.entropy.learn_more.safety.backup.title" = "Proteja a frase de recuperação";
"onboarding.entropy.learn_more.safety.backup.detail" = "Mantenha a frase de recuperação offline e nunca a compartilhe. Depois de verificar o backup, destrua com segurança qualquer registro intermediário das entradas que não seja mais necessário.";
"onboarding.entropy.learn_more.safety.footer" = "A entropia física não protege uma frase de recuperação exposta, um dispositivo comprometido, um software malicioso nem uma sequência registrada incorretamente. Se não puder garantir entradas sem viés, sigilosas e exatas, use a criação padrão de carteira.";
"onboarding.carousel.open_source.eyebrow" = "CÓDIGO ABERTO POR CONCEPÇÃO";
"onboarding.carousel.open_source.title" = "Inspecione o código-fonte. Verifique a compilação.";
"onboarding.carousel.open_source.message" = "O Oath publica seu código-fonte para inspeção independente. Uma versão só é verificada quando uma compilação reproduzível coincide com a impressão digital do app publicado.";
"onboarding.carousel.open_source.action.github" = "Analisar no GitHub";
"onboarding.carousel.open_source.visual.repository" = "Repositório público de código-fonte";
"onboarding.carousel.open_source.visual.repository.path" = "Ver github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Examinar o código-fonte";
"onboarding.carousel.open_source.visual.rebuild" = "Reproduzir a compilação da versão";
"onboarding.carousel.open_source.visual.compare" = "Comparar os artefatos da compilação";
"onboarding.carousel.open_source.visual.fingerprint" = "Impressão digital da versão publicada";
"onboarding.carousel.open_source.visual.match" = "CORRESPONDÊNCIA CONFIRMADA — COMPILAÇÃO VERIFICADA";
"onboarding.carousel.open_source.visual.accessibility" = "Diagrama mostrando que a verificação de uma versão exige código-fonte público, uma recompilação independente e impressões digitais correspondentes.";
"onboarding.carousel.passphrase.eyebrow" = "FRASE SECRETA BIP-39 OPCIONAL";
"onboarding.carousel.passphrase.title" = "Uma frase de recuperação. Um segredo adicional.";
"onboarding.carousel.passphrase.message" = "Uma frase secreta BIP-39 se combina à sua frase de recuperação para derivar outra carteira. Mesmo que as palavras de recuperação sejam expostas, o acesso a essa carteira ainda exige a frase secreta exata.";
"onboarding.carousel.passphrase.visual.phrase" = "Suas 24 palavras de recuperação";
"onboarding.carousel.passphrase.visual.passphrase" = "Sua frase secreta adicional";
"onboarding.carousel.passphrase.visual.output" = "Uma carteira distinta com frase secreta";
"onboarding.carousel.passphrase.visual.requirement" = "Os dois segredos são necessários para a recuperação";
"onboarding.carousel.passphrase.visual.accessibility" = "Uma frase de recuperação de 24 palavras e uma frase secreta BIP-39 derivam outra carteira, que exige os dois segredos para ser recuperada.";
"onboarding.carousel.passphrase.learn_more.action" = "Ver mais detalhes";
"onboarding.passphrase.learn_more.navigation" = "Entenda as frases secretas BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dois segredos derivam uma carteira";
"onboarding.passphrase.learn_more.overview" = "Uma frase secreta BIP-39 é um segredo opcional combinado à sua frase de recuperação. Juntas, elas derivam de forma determinística uma carteira diferente daquela criada apenas pela frase de recuperação.";
"onboarding.passphrase.learn_more.visual.phrase" = "Sua frase de recuperação de 24 palavras";
"onboarding.passphrase.learn_more.visual.passphrase" = "Sua frase secreta";
"onboarding.passphrase.learn_more.visual.wallet" = "Uma carteira protegida por frase secreta";
"onboarding.passphrase.learn_more.visual.accessibility" = "Uma frase de recuperação de 24 palavras e uma frase secreta se combinam para derivar outra carteira, protegida pela frase secreta.";
"onboarding.passphrase.learn_more.derivation.section" = "Como o BIP-39 deriva a carteira";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frase de recuperação combinada à frase secreta";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 em 2.048 rodadas";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Semente mestra de 512 bits";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Contas e endereços derivados da carteira";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Sua frase de recuperação e sua frase secreta passam por 2.048 rodadas de PBKDF2-HMAC-SHA512 para produzir a semente de 512 bits da qual as contas e os endereços da carteira são derivados.";
"onboarding.passphrase.learn_more.derivation.standard" = "O BIP-39 trata a frase de recuperação normalizada como a senha do PBKDF2 e usa como salt a palavra “mnemonic” seguida da frase secreta normalizada. Após 2.048 rodadas de PBKDF2-HMAC-SHA512, o processo produz uma semente de 64 bytes.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Antes de derivar a semente, o Oath aplica a normalização Unicode exigida pelo BIP-39. Assim, a mesma frase de recuperação normalizada e a mesma frase secreta sempre reproduzem a mesma carteira.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Uma frase secreta não criptografa suas palavras de recuperação. Ela altera a semente derivada; portanto, cada frase secreta diferente produz contas e endereços diferentes.";
"onboarding.passphrase.learn_more.wallets.section" = "Cada frase secreta deriva uma carteira diferente";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Exemplo de frase secreta 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Exemplo de frase secreta 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Exemplo de carteira A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Exemplo de carteira B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "A mesma frase de recuperação combinada a duas frases secretas diferentes deriva duas carteiras distintas: a Carteira A e a Carteira B.";
"onboarding.passphrase.learn_more.wallets.different" = "Alterar até mesmo um caractere relevante deriva outra semente e, portanto, outra carteira; a carteira original permanece inalterada.";
"onboarding.passphrase.learn_more.wallets.empty" = "Uma frase secreta vazia abre a carteira padrão derivada apenas da frase de recuperação; uma frase secreta preenchida abre sua própria carteira separada.";
"onboarding.passphrase.learn_more.wallets.footer" = "O BIP-39 não apresenta uma resposta de “frase secreta incorreta”; toda frase secreta é válida. Por isso, um erro de digitação abre silenciosamente outra carteira, normalmente com saldo zero.";
"onboarding.passphrase.learn_more.security.section" = "Como uma frase secreta reforça a proteção";
"onboarding.passphrase.learn_more.security.words.title" = "Só as palavras de recuperação não bastam";
"onboarding.passphrase.learn_more.security.words.detail" = "Quem obtiver apenas sua frase de recuperação ainda precisará da frase secreta exata para derivar e acessar a carteira protegida.";
"onboarding.passphrase.learn_more.security.strength.title" = "Maior complexidade cria uma separação mais segura";
"onboarding.passphrase.learn_more.security.strength.detail" = "Uma frase secreta longa e imprevisível dificulta consideravelmente as tentativas de descoberta. Uma frase curta, data de aniversário, nome ou senha reutilizada pode ser descoberta rapidamente e oferece pouca proteção.";
"onboarding.passphrase.learn_more.security.separation.title" = "Mantenha a frase secreta separada";
"onboarding.passphrase.learn_more.security.separation.detail" = "Armazene a frase secreta separadamente da frase de recuperação para que um único backup roubado não revele os dois segredos necessários para restaurar a carteira.";
"onboarding.passphrase.learn_more.security.footer" = "Uma frase secreta não protege seus fundos se os dois segredos forem expostos, se ela for fraca ou se um software comprometido a capturar durante a digitação.";
"onboarding.passphrase.learn_more.safety.section" = "Use este recurso com segurança";
"onboarding.passphrase.learn_more.safety.strong.title" = "Crie uma frase secreta forte e exclusiva";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Escolha várias palavras aleatórias ou outro valor de alta entropia exclusivo para esta carteira. Evite dados pessoais, frases conhecidas, padrões e senhas usadas em outros lugares.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Faça um backup separado da frase secreta";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Crie uma cópia offline durável da frase secreta exata, armazene-a separadamente da frase de recuperação e nunca dependa apenas da memória.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Cada caractere muda a carteira";
