// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Deslizar para enviar substitui o botão de confirmação. Animação direcional, resposta tátil e movimento mais suave acompanham os dois sentidos de leitura. Solte em 90% ou mais para enviar; deslize de volta para cancelar.";
"settings.about.history.v355.build56.activity" = "O sino abre as atividades pendentes. As cápsulas mostram indicadores de status e podem ser dispensadas deslizando. As que aguardam confirmação ou foram confirmadas somem após 3 segundos; a confirmação atualiza a mesma cápsula visível.";
"settings.about.history.v355.build56.status" = "Status de transações mais confiável em todas as redes compatíveis, detalhes atualizados em tempo real e saldo atualizado mais rápido após o envio. O acompanhamento de pendências é retomado ao reabrir o app.";
"settings.about.history.v355.build56.fees" = "Voltar à mesma revisão de transferência preserva a taxa já obtida. Carregamento de taxas e avisos sobre fundos mais claros; valores suficientes não exibem mais avisos de ativação.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin e Dogecoin adicionam o troco abaixo do limite de poeira à taxa, em vez de criar uma saída inutilizável. A taxa revisada corresponde à usada na assinatura.";
"settings.about.history.v355.build56.stability" = "Corrigidos um encerramento inesperado em tarefas de segundo plano e alertas de tempo esgotado ao atualizar a carteira. Falhas temporárias de atualização mantêm as informações existentes disponíveis.";
"settings.about.history.v355.build56.backup" = "Telas de backup mais claras, com títulos corretos ao abrir e menos mensagens. O acesso às chaves privadas respeita o Bloqueio do App. Avisos de importação compactos em vidro apagam a entrada rejeitada ao escolher outra frase de recuperação.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Ao soltar o controle de deslizar para enviar, uma marca de verificação animada aparece antes de a revisão fechar.";
"settings.about.history.v355.build57.activity" = "As linhas de atividade exibem o status com uma fonte mais leve, o valor como subtítulo e uma seta para abrir os detalhes da transação.";
"settings.about.history.v355.build57.details" = "As taxas de rede agora aparecem no resumo da transferência. Rótulos mais curtos e uma única linha para a rede deixam os detalhes mais claros.";
"settings.about.history.v355.build57.resume" = "Ao voltar do segundo plano, as telas e os painéis abertos são preservados, incluindo a revisão de transferências e os detalhes das transações.";
"settings.about.history.v355.build57.secrets" = "As telas de frase de recuperação, chave privada e frase-senha fecham após 20 segundos fora do app. O bloqueio do app continua seguindo seus ajustes.";
"settings.about.history.v355.build57.filters" = "Os filtros de rede usam botões nativos um pouco mais altos, com tamanho ajustado ao conteúdo e espaçamento corrigido abaixo da barra de navegação.";
"settings.about.history.v355.build57.units" = "As linhas separadas de valor foram removidas. Valor e taxa de rede aparecem primeiro em moeda local; toque em qualquer um para alternar com as unidades cripto.";
"wallet.transaction.details.toggle_units" = "Alternar unidades.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "A tela inicial abre sem efeitos de transição de opacidade ou escala. O botão de configurações agora usa um ícone de engrenagem.";
"settings.about.history.v355.build58.fields" = "Os campos de transações e envios usam as cores de texto padrão. As setas aparecem apenas nas linhas que abrem uma tela ou um painel; tocar nos valores e nas taxas continua alternando as unidades.";
"settings.about.history.v355.build58.banners" = "Após serem exibidos, os avisos de confirmação em andamento ou concluída desaparecem em 3 segundos, mesmo que você abra outra tela. As confirmações ainda não exibidas aparecem quando você volta.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "As transferências de TRON agora reservam as taxas de ativação e largura de banda antes de calcular o valor a enviar, inclusive ao enviar o valor máximo. A revisão mostra o valor correto após descontar as taxas.";
"settings.about.history.v355.build59.fees" = "As taxas personalizadas de TRON devem cobrir os custos de rede necessários. Agora há orientações mais claras quando o saldo de TRX está baixo. A quantidade de tokens não muda; as taxas são pagas em TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Uma nova tela de boas-vindas";
"settings.about.history.v356.welcome" = "Uma nova tela de boas-vindas com ilustrações animadas e opções claras para criar ou importar uma carteira.";
"settings.about.history.v357.tour.title" = "Tour de boas-vindas";
"settings.about.history.v357.tour" = "Um tour de cinco páginas apresenta as redes compatíveis, a entropia física, o envio e o recebimento, a segurança e as versões verificadas. Deslize ou toque nos pontos para mudar de página; o seletor de idioma fica na barra de navegação.";
"settings.about.history.v357.backup" = "Depois de criar, importar ou restaurar uma carteira, a tela aparece imediatamente e as opções de backup usam a lista padrão. A verificação do iCloud roda em segundo plano, e Abrir carteira fica pronto assim que a carteira é salva.";
"settings.about.history.v357.reliability" = "Voltar do segundo plano não fecha mais a tela de configuração quando uma tela de recuperação oculta expira, e apagar todos os dados abre diretamente a tela de boas-vindas.";
"settings.about.history.v357.notifications" = "Os ajustes de notificações usam palavras mais simples para categorias e status, sem detalhes técnicos.";
"settings.about.history.v357.wallets" = "Reordene carteiras no seletor com um toque longo usando a animação de elevação do sistema; tocar em uma linha a ativa. A verificação da frase de recuperação numera cada palavra, e a tecla Return passa para o próximo campo.";
"settings.about.history.v357.send" = "O envio mostra o valor enquanto a transferência está em andamento, uma mensagem mais clara aparece se não for possível enviar, e as solicitações TRON são repetidas automaticamente após erros temporários do provedor.";
"settings.about.history.v357.security" = "Contas TRON importadas cuja permissão de proprietário foi movida para outra chave agora mostram o aviso e não podem enviar, mesmo quando cada permissão lista uma única chave. Mais frases de recuperação e chaves privadas conhecidas como expostas são recusadas na importação.";
"settings.about.history.v356.localization" = "Os textos da tela de boas-vindas estão mais claros e naturais em todos os idiomas disponíveis.";
"settings.about.history.v356.pricing" = "Os preços dos tokens agora são consultados pela rede e pelo endereço exatos, priorizando os preços das DEXs. Preços pequenos exibem até 8 casas decimais, sem arredondamento.";
"settings.about.history.v356.appearance" = "Os botões primários e secundários agora têm alturas e margens laterais uniformes. As ações principais usam o azul do sistema.";
"settings.about.history.v356.transactions" = "Os detalhes das transações mostram o status abreviado Confirmada e texto cinza mais legível para datas, endereços, valores e IDs de transação.";
"settings.about.history.v356.security" = "A lista de frases de recuperação e chaves privadas que se sabe que foram expostas e cuja importação é bloqueada foi ampliada.";

