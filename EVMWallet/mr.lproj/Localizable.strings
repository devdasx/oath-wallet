"onboarding.passphrase.learn_more.safety.verify.title" = "निधी जोडण्यापूर्वी पुनर्प्राप्ती पडताळा";
"onboarding.passphrase.learn_more.safety.verify.detail" = "मोठी रक्कम प्राप्त करण्यापूर्वी, पुनर्प्राप्ती वाक्यांश आणि पासफ्रेजमधून अपेक्षित पत्ते पुन्हा तयार होतात याची खाजगी, नियंत्रित पुनर्प्राप्ती चाचणीत खात्री करा.";
"onboarding.passphrase.learn_more.safety.footer" = "हरवलेला पासफ्रेज कोणतीही सेवा रीसेट किंवा पुनर्प्राप्त करू शकत नाही. तुमच्याकडे पुनर्प्राप्ती वाक्यांश असला तरी अचूक पासफ्रेजशिवाय त्या वॉलेटचा प्रवेश कायमचा गमावला जातो.";
