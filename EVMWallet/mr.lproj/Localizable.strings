// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "पुष्टी बटणाऐवजी आता स्लाइड करून पाठवा. दिशादर्शक अॅनिमेशन, हॅप्टिक प्रतिसाद आणि सहज हालचाल वाचनाच्या दोन्ही दिशांना आधार देतात. पाठवण्यासाठी 90% किंवा पुढे बोट सोडा; रद्द करण्यासाठी मागे सरकवा.";
"settings.about.history.v355.build56.activity" = "घंटीतून प्रलंबित क्रियाकलाप उघडतात. व्यवहार कॅप्सूल स्थितीचे बॅज दाखवतात आणि स्वाइपने लपवता येतात. पुष्टी सुरू असलेले व पुष्टी झालेले कॅप्सूल 3 सेकंदांनी लपतात; पुष्टी झाल्यावर तोच दिसणारा कॅप्सूल अद्ययावत होतो.";
"settings.about.history.v355.build56.status" = "सर्व समर्थित नेटवर्कवर अधिक विश्वासार्ह व्यवहार स्थिती, थेट अद्ययावत तपशील आणि पाठवल्यानंतर जलद शिल्लक अद्यतने. अॅप पुन्हा उघडल्यावर प्रलंबित व्यवहारांचा मागोवा पुन्हा सुरू होतो.";
"settings.about.history.v355.build56.fees" = "त्याच हस्तांतरणाच्या पुनरावलोकनावर परतल्यावर तयार शुल्क कायम राहते. शुल्क लोड होणे आणि खात्यात निधीची गरज याबाबत स्पष्ट इशारे; पुरेशी रक्कम असल्यास सक्रियकरणाच्या सूचना दिसत नाहीत.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin आणि Dogecoinमध्ये डस्ट मर्यादेपेक्षा कमी परत येणारी रक्कम निरुपयोगी आउटपुट तयार करण्याऐवजी शुल्कात जोडली जाते. पुनरावलोकनातील शुल्क स्वाक्षरीवेळी वापरलेल्या शुल्काशी जुळते.";
"settings.about.history.v355.build56.stability" = "पार्श्वभूमीतील कामाचा क्रॅश आणि वॉलेट रिफ्रेशच्या कालमर्यादेचे इशारे दुरुस्त केले. तात्पुरत्या रिफ्रेश अपयशात वॉलेटची विद्यमान माहिती उपलब्ध राहते.";
"settings.about.history.v355.build56.backup" = "उघडताच योग्य शीर्षके आणि कमी संदेश असलेल्या सुटसुटीत बॅकअप स्क्रीन. खाजगी कीचा प्रवेश अॅप लॉक सेटिंग्ज पाळतो. लहान काचेच्या शैलीतील आयात इशाऱ्यात दुसरा पुनर्प्राप्ती शब्दसमूह निवडल्यावर नाकारलेला इनपुट पुसला जातो.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "पाठवण्याचा स्लायडर सोडल्यानंतर, पुनरावलोकन स्क्रीन बंद होण्यापूर्वी अ‍ॅनिमेटेड टिक चिन्ह दिसते.";
"settings.about.history.v355.build57.activity" = "हालचालींच्या ओळींमध्ये स्थितीचा मजकूर कमी ठळक, रक्कम उपशीर्षक म्हणून आणि व्यवहाराचा तपशील उघडण्यासाठी बाण दिसतो.";
"settings.about.history.v355.build57.details" = "नेटवर्क शुल्क आता हस्तांतरणाच्या सारांशात दिसते. लहान लेबले आणि नेटवर्कची एकच ओळ यांमुळे तपशील अधिक स्पष्ट होतो.";
"settings.about.history.v355.build57.resume" = "पार्श्वभूमीतून परतल्यावर उघड्या स्क्रीन आणि पॅनेल कायम राहतात, यात हस्तांतरणाचे पुनरावलोकन आणि व्यवहाराचा तपशीलही समाविष्ट आहे.";
"settings.about.history.v355.build57.secrets" = "अ‍ॅपपासून 20 सेकंद दूर राहिल्यास पुनर्प्राप्ती शब्दसमूह, खाजगी की आणि पासफ्रेजच्या स्क्रीन बंद होतात. अ‍ॅप लॉक तुमच्या सेटिंग्जनुसारच काम करते.";
"settings.about.history.v355.build57.filters" = "नेटवर्क फिल्टरमध्ये किंचित उंच सिस्टीम बटणे, मजकुरानुसार आकार आणि नेव्हिगेशन बारखाली सुधारलेले अंतर वापरले जाते.";
"settings.about.history.v355.build57.units" = "मूल्याच्या स्वतंत्र ओळी काढल्या आहेत. रक्कम आणि नेटवर्क शुल्क आधी स्थानिक चलनात दिसतात; क्रिप्टो एककांमध्ये बदलण्यासाठी आणि परत येण्यासाठी त्यापैकी कोणत्याही मूल्यावर टॅप करा.";
"wallet.transaction.details.toggle_units" = "एकक बदला.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "होम स्क्रीन फेड किंवा आकार बदलण्याच्या परिणामाशिवाय उघडते. सेटिंग्ज बटणावर आता गिअरचे चिन्ह आहे.";
"settings.about.history.v355.build58.fields" = "व्यवहार आणि पाठवण्याच्या फील्डमध्ये मजकुराचे नेहमीचे रंग वापरले जातात. फक्त स्क्रीन किंवा पॅनल उघडणाऱ्या ओळींवर बाण दिसतात; रक्कम आणि शुल्कावर टॅप केल्यावर अजूनही एकक बदलते.";
"settings.about.history.v355.build58.banners" = "दिसल्यानंतर, पुष्टी सुरू असल्याचे किंवा पूर्ण झाल्याचे बॅनर 3 सेकंदांनी नाहीसे होतात, तुम्ही दुसरी स्क्रीन उघडली तरीही. पुष्टीचे अद्याप न दाखवलेले अपडेट परत आल्यावर दिसतात.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON हस्तांतरणात आता कमाल रक्कम पाठवतानाही पाठवायची रक्कम मोजण्यापूर्वी सक्रियकरण आणि बँडविड्थ शुल्कासाठी रक्कम राखून ठेवली जाते. पुनरावलोकन स्क्रीनवर शुल्क वजा केल्यानंतरची योग्य रक्कम दिसते.";
"settings.about.history.v355.build59.fees" = "स्वतः ठरवलेल्या TRON शुल्कातून नेटवर्कचा आवश्यक खर्च भागला पाहिजे. TRX शिल्लक कमी असल्यास आता अधिक स्पष्ट मार्गदर्शन दिसते. टोकनची मात्रा बदलत नाही; शुल्क TRX मध्ये भरले जाते.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "एक नवीन स्वागत";
"settings.about.history.v356.welcome" = "ॲनिमेटेड आर्टवर्क आणि वॉलेट तयार करण्यासाठी किंवा आयात करण्यासाठी स्पष्ट पर्यायांसह एक नवीन स्वागत स्क्रीन.";
"settings.about.history.v357.tour.title" = "स्वागत फेरफटका";
"settings.about.history.v357.tour" = "पाच पानांचा फेरफटका समर्थित नेटवर्क, भौतिक एन्ट्रॉपी, पाठवणे आणि प्राप्त करणे, सुरक्षा आणि पडताळलेल्या बिल्ड्सची ओळख करून देतो. पान बदलण्यासाठी स्वाइप करा किंवा ठिपक्यांवर टॅप करा; भाषा बदलण्याचे बटण नेव्हिगेशन बारमध्ये आहे.";
"settings.about.history.v357.backup" = "वॉलेट तयार केल्यावर, आयात केल्यावर किंवा पुनर्संचयित केल्यावर स्क्रीन लगेच दिसते आणि तिचे बॅकअप पर्याय मानक यादी वापरतात. iCloud तपासणी पार्श्वभूमीत चालते, आणि वॉलेट जतन होताच वॉलेट उघडा तयार असते.";
"settings.about.history.v357.reliability" = "लपलेल्या रिकव्हरी स्क्रीनची मुदत संपल्यावर पार्श्वभूमीतून परत आल्याने आता सेटअप स्क्रीन बंद होत नाही, आणि सर्व डेटा पुसल्यावर थेट स्वागत स्क्रीन उघडते.";
"settings.about.history.v357.notifications" = "सूचना सेटिंग्जमध्ये श्रेणी आणि स्थितीसाठी तांत्रिक तपशीलांशिवाय सोपी भाषा वापरली आहे.";
"settings.about.history.v357.wallets" = "स्विचरमध्ये वॉलेट दीर्घकाळ दाबून सिस्टमच्या उचलण्याच्या ॲनिमेशनसह पुन्हा क्रमाने लावा; ओळीवर टॅप केल्याने ती सक्रिय होते. रिकव्हरी फ्रेज पडताळणी प्रत्येक शब्दाला क्रमांक देते, आणि Return पुढील रकान्यात जाते.";
"settings.about.history.v357.send" = "हस्तांतरण सुरू असताना पाठवण्यात रक्कम दिसते, पाठवता येत नसल्यास अधिक स्पष्ट संदेश दिसतो, आणि तात्पुरत्या प्रदाता त्रुटींनंतर TRON विनंत्या आपोआप पुन्हा प्रयत्न करतात.";
"settings.about.history.v357.security" = "ज्या आयात केलेल्या TRON खात्यांची मालक परवानगी दुसऱ्या कीकडे हलवली आहे, ती आता प्रत्येक परवानगीत एकच की असली तरी चेतावणी दाखवतात आणि पाठवू शकत नाहीत. उघड झालेल्या म्हणून ज्ञात असलेले आणखी रिकव्हरी फ्रेज आणि खाजगी की आयात करताना नाकारल्या जातात.";
"settings.about.history.v356.localization" = "सर्व समर्थित भाषांमध्ये स्वागत स्क्रीनवरील मजकूर अधिक सहज आणि स्पष्ट केला आहे.";
"settings.about.history.v356.pricing" = "टोकन किंमती आता प्रथम DEX किमती वापरून अचूक नेटवर्क आणि टोकन पत्त्याशी जुळतात. लहान किमती राउंडिंगशिवाय 8 दशांश स्थानांपर्यंत दाखवतात.";
"settings.about.history.v356.appearance" = "प्राथमिक आणि दुय्यम बटणे आता प्राथमिक क्रियांसाठी सिस्टीम निळ्यासह सुसंगत उंची आणि स्क्रीन समास वापरतात.";
"settings.about.history.v356.transactions" = "व्यवहार तपशील तारखा, पत्ते, रक्कम आणि व्यवहार आयडीसाठी एक लहान पुष्टी केलेली स्थिती आणि स्पष्ट राखाडी मजकूर वापरतात.";
"settings.about.history.v356.security" = "ज्ञात उघड झालेल्या पुनर्प्राप्ती वाक्यांशांची आणि खाजगी की ज्या आयात केल्या जाऊ शकत नाहीत त्यांची सूची विस्तृत केली.";

