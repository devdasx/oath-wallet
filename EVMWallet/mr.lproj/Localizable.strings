"onboarding.carousel.entropy.visual.local" = "पूर्णपणे तुमच्या नोंदवलेल्या इनपुटमधून तयार केलेली";
"onboarding.carousel.entropy.visual.accessibility" = "अंक असलेला फासा, नाणे आणि यादृच्छिक अंक एकत्र येऊन या डिव्हाइसवर वॉलेट एन्ट्रॉपीचे 256 बिट तयार करतात.";
"onboarding.carousel.entropy.learn_more.action" = "अधिक तपशील जाणून घ्या";
"onboarding.entropy.learn_more.navigation" = "भौतिक एन्ट्रॉपी कशी कार्य करते";
"onboarding.entropy.learn_more.path.section" = "भौतिक परिणामांपासून पुनर्प्राप्ती शब्दांपर्यंत";
"onboarding.entropy.learn_more.overview" = "Oath तुम्ही निवडलेल्या भौतिक स्रोतातील परिणाम नोंदवते आणि त्यांचे 256-बिट मूल्यात रूपांतर करते. त्यातून मिळालेले 32 बाइट नंतर मानक BIP-39 पुनर्प्राप्ती वाक्यांश तयार करण्यासाठी Wallet Core कडे पाठवले जातात.";
"onboarding.entropy.learn_more.visual.phrase" = "24 शब्दांचा BIP-39 पुनर्प्राप्ती वाक्यांश";
"onboarding.entropy.learn_more.visual.bits" = "32 बाइट × 8 बिट म्हणजे 256 बिट";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 बाइटमध्ये मांडलेल्या 256 नमुना बिट सेलची जाळी.";
"onboarding.entropy.learn_more.visual.accessibility" = "फासे टाकण्याचे परिणाम, नाणेफेकीचे परिणाम किंवा यादृच्छिक अंक यांचे 256 बिटमध्ये आणि नंतर 24 शब्दांच्या BIP-39 पुनर्प्राप्ती वाक्यांशात रूपांतर होते.";
"onboarding.entropy.learn_more.inputs.section" = "पायरी 1: भौतिक परिणाम नोंदवा";
"onboarding.entropy.learn_more.inputs.dice.title" = "निष्पक्ष सहा-बाजूंचा फासा टाका";
"onboarding.entropy.learn_more.inputs.dice.detail" = "निष्पक्ष फासाच्या 1–4 बाजू प्रत्येकी 2 बिट देतात; 5–6 बाजू प्रत्येकी 1 बिट देतात.";
"onboarding.entropy.learn_more.inputs.coin.title" = "प्रत्यक्ष नाणेफेक";
"onboarding.entropy.learn_more.inputs.coin.detail" = "प्रत्येक निष्पक्ष, स्वतंत्र नाणेफेक एन्ट्रॉपीचा 1 पक्षपातशून्य बिट देते.";
"onboarding.entropy.learn_more.inputs.digits.title" = "यादृच्छिक अंक नोंदवा";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 हे अंक प्रत्येकी 3 बिट देतात; 8–9 हे अंक प्रत्येकी 1 बिट देतात. हे अंक खरोखर यादृच्छिक भौतिक प्रक्रियेतून मिळालेले असणे आवश्यक आहे.";
"onboarding.entropy.learn_more.inputs.footer" = "निष्पक्ष भौतिक स्रोत वापरा आणि प्रत्येक परिणाम क्रमाने नोंदवा. प्रत्येक स्वीकारलेला परिणाम त्याच बिट प्रवाहात भर घालत असल्याने तुम्ही इनपुट पद्धत बदलू शकता.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-बिट मूल्य तयार करा";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath फासे आणि दशांश अंकांच्या परिणामांचे पक्षपातशून्य, दोनच्या घातांवर आधारित गटांत रूपांतर करते. प्रत्येक परिणामातून मिळणाऱ्या बिटची संख्या वेगळी असू शकते, पण निष्पक्ष भौतिक स्रोत कोणत्याही बिट मूल्याला प्राधान्य देत नाही.";
"onboarding.entropy.learn_more.conversion.packing" = "नेमके 256 बिट मिळेपर्यंत Oath प्रविष्ट केलेल्या क्रमाने बिट जोडते आणि नंतर सर्वाधिक महत्त्वाचा बिट प्रथम ठेवून ते 32 बाइटमध्ये पॅक करते.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "सानुकूल एन्ट्रॉपीमध्ये फक्त तुम्ही नोंदवलेले भौतिक इनपुट असतात; Oath त्यात डिव्हाइसने तयार केलेली यादृच्छिकता मिसळत नाही.";
"onboarding.entropy.learn_more.bip39.section" = "3. पुनर्प्राप्ती वाक्यांश तयार करा";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256-बिट एन्ट्रॉपी";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-बिट BIP-39 चेकसम";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 बिटचे प्रत्येकी 11 बिटच्या 24 शब्द निर्देशांकांत विभाजन";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-बिट एन्ट्रॉपी मूल्यात 8-बिट चेकसम जोडल्याने 264 बिट तयार होतात; ते प्रत्येकी 11 बिटच्या 24 शब्द निर्देशांकांत विभागले जातात.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 हे 32-बाइट एन्ट्रॉपी मूल्य वापरून SHA-256 ची गणना करते आणि हॅशचे पहिले 8 बिट चेकसम म्हणून घेते; हा चेकसम जोडल्यावर 264 बिट तयार होतात.";
"onboarding.entropy.learn_more.bip39.words" = "264 बिट प्रत्येकी 11 बिटच्या 24 गटांत विभागले जातात. प्रत्येक गट मानक 2,048-शब्दांच्या BIP-39 सूचीतील एक नोंद निवडतो आणि त्यातून 24 शब्दांचा पुनर्प्राप्ती वाक्यांश तयार होतो.";
"onboarding.entropy.learn_more.bip39.derivation" = "मिळालेल्या सीडमधून Wallet Core निश्चित खाती आणि पत्ते तयार करते. तोच पुनर्प्राप्ती वाक्यांश आणि पर्यायी पासफ्रेज नेहमी तेच वॉलेट पुन्हा तयार करतात.";
"onboarding.entropy.learn_more.security.section" = "सानुकूल एन्ट्रॉपीमुळे सुरक्षा कशी मजबूत होते";
"onboarding.entropy.learn_more.security.space.title" = "शक्यतांचे प्रचंड अवकाश";
"onboarding.entropy.learn_more.security.space.detail" = "एकसमान 256-बिट एन्ट्रॉपीमध्ये 2^256 वेगवेगळी मूल्ये असतात, त्यामुळे सर्व शक्यता तपासून अंदाज लावणे संगणकीयदृष्ट्या अव्यवहार्य ठरते. हे इनपुट अवकाशाचे आकारमान दर्शवते; प्रत्येक क्रिप्टोग्राफिक घटक 256-बिट हल्ला-प्रतिरोध देतो असा त्याचा अर्थ नाही.";
"onboarding.entropy.learn_more.security.source.title" = "यादृच्छिकता तुमच्याकडून येते";
"onboarding.entropy.learn_more.security.source.detail" = "फक्त डिव्हाइसच्या यादृच्छिक संख्या जनित्रावर अवलंबून न राहता, भौतिक घटनांमधून वॉलेटची यादृच्छिकता स्वतंत्रपणे मिळवता येते. त्या घटना खरोखर यादृच्छिक असतील तरच यामुळे सुरक्षा सुधारते.";
"onboarding.entropy.learn_more.security.local.title" = "पूर्ण प्रक्रिया याच डिव्हाइसवर";
"onboarding.entropy.learn_more.security.local.detail" = "Oath तुमच्या नोंदवलेल्या क्रमाचे रूपांतर करून पुनर्प्राप्ती वाक्यांश पूर्णपणे याच डिव्हाइसवर तयार करते. प्रक्रिया करण्यासाठी तुमचा क्रम कधीही अपलोड केला जात नाही.";
"onboarding.entropy.learn_more.security.patterns.title" = "स्वतः निवडलेली गुपिते टाळा";
"onboarding.entropy.learn_more.security.patterns.detail" = "निष्पक्ष, स्वतंत्र घटनांचा दीर्घ क्रम हा वाढदिवस, आवडते अंक, पुनरावृत्तीचे नमुने किंवा एखाद्या व्यक्तीने निवडलेल्या शब्दांपेक्षा खूपच कमी अंदाजयोग्य असतो.";
"onboarding.entropy.learn_more.security.footer" = "भौतिक एन्ट्रॉपी डिव्हाइसने तयार केलेल्या वॉलेट यादृच्छिकतेची जागा घेते; ती अतिरिक्त पासवर्ड किंवा सुरक्षा स्तर नाही.";
"onboarding.entropy.learn_more.safety.section" = "हे वैशिष्ट्य सुरक्षितपणे वापरा";
"onboarding.entropy.learn_more.safety.fair.title" = "निष्पक्ष, स्वतंत्र परिणाम नोंदवा";
"onboarding.entropy.learn_more.safety.fair.detail" = "निष्पक्ष नाणे किंवा फासा वापरा आणि प्रत्येक परिणाम स्वतंत्र असल्याची खात्री करा. यादृच्छिक अंक खऱ्या भौतिक स्रोतातून मिळालेले असावेत—स्मृतीतून किंवा एखाद्या नमुन्यातून नाही.";
"onboarding.entropy.learn_more.safety.private.title" = "तुमची एन्ट्रॉपी प्रक्रिया खाजगी ठेवा";
"onboarding.entropy.learn_more.safety.private.detail" = "नोंदवलेला क्रम आणि पूर्ण झालेला पुनर्प्राप्ती वाक्यांश या दोन्हींना वॉलेटची गुपिते मानून सुरक्षित ठेवा. ते कॅमेरे किंवा इतर लोकांच्या नजरेस पडू देऊ नका.";
"onboarding.entropy.learn_more.safety.accurate.title" = "प्रत्येक निकालाची अचूक नोंद करा";
"onboarding.entropy.learn_more.safety.accurate.detail" = "एक परिणाम जरी गहाळ, दुबार किंवा चुकीच्या क्रमात असेल तरी वेगळे वॉलेट तयार होते. प्रत्येक नोंद तपासा आणि वॉलेटमध्ये निधी भरण्यापूर्वी पूर्ण पुनर्प्राप्ती वाक्यांशाची पडताळणी करा.";
"onboarding.entropy.learn_more.safety.backup.title" = "पुनर्प्राप्ती वाक्यांश संरक्षित करा";
"onboarding.entropy.learn_more.safety.backup.detail" = "पुनर्प्राप्ती वाक्यांश ऑफलाइन ठेवा आणि तो कधीही कोणासोबत शेअर करू नका. बॅकअपची पडताळणी केल्यानंतर, यापुढे गरज नसलेली कोणतीही मधली इनपुट नोंद सुरक्षितपणे नष्ट करा.";
"onboarding.entropy.learn_more.safety.footer" = "भौतिक एन्ट्रॉपी उघड झालेला पुनर्प्राप्ती वाक्यांश, तडजोड झालेले डिव्हाइस, दुर्भावनापूर्ण सॉफ्टवेअर किंवा चुकीने नोंदवलेला क्रम सुरक्षित करू शकत नाही. निष्पक्ष, खाजगी आणि अचूक इनपुटची खात्री देता येत नसेल, तर त्याऐवजी मानक पद्धतीने वॉलेट तयार करा.";
"onboarding.carousel.open_source.eyebrow" = "रचनेपासूनच मुक्त-स्रोत";
"onboarding.carousel.open_source.title" = "स्रोत तपासा. बिल्ड पडताळा.";
"onboarding.carousel.open_source.message" = "स्वतंत्र तपासणीसाठी Oath आपला स्रोत कोड प्रकाशित करते. स्वतंत्रपणे पुन्हा तयार केलेला बिल्ड प्रकाशित ॲपच्या फिंगरप्रिंटशी जुळतो तेव्हाच रिलीझची पडताळणी होते.";
