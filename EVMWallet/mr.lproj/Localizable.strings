// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "रिकव्हरी शब्दसमूहाची पडताळणी, आपोआप लहान अक्षरे करणे, क्रमांकासह मजकूर भरणे, साफ करणे, बॅकस्पेस दाबून धरून मिटवणे आणि कीबोर्डचे वर्तन सुधारले आहे. रिकव्हरी स्क्रीनवर आता मागे जाण्यासाठी एकच बटण आहे.";
"settings.about.history.v353.build51.send" = "शुल्काचा अंदाज उपलब्ध नसल्यास सर्व समर्थित नेटवर्कवर शुल्काचा अंदाज घेण्यासाठी पर्यायी पद्धती जोडल्या आहेत. पाठवताना कॉन्ट्रॅक्ट पत्ते लपवले जातात आणि शुल्क अधिक स्पष्ट दिसते.";
"settings.about.history.v353.build51.security" = "परवानग्यांचा आढावा, पत्त्यांचे तपशील, परवानगी रद्द केल्याचे परिणाम आणि शुल्कासाठी निधी जोडण्याचे मार्गदर्शन अधिक स्पष्ट आहे. बॅकअप कार्ड आणि शीटची शैली एकसमान आहे. नेव्हिगेशनमधील कंपन काढले आहे.";
"settings.about.history.v353.build51.notifications" = "वेगवेगळ्या नेटवर्कवर येणाऱ्या हस्तांतरणांच्या सूचना अधिक विश्वासार्ह आहेत. किंमत उपलब्ध असल्यास रक्कम निवडलेल्या चलनात, अन्यथा क्रिप्टोच्या मूळ एककात दिसते.";

