"onboarding.carousel.open_source.visual.rebuild" = "रिलीझ बिल्ड पुन्हा तयार करा";
"onboarding.carousel.open_source.visual.compare" = "बिल्डमधील तयार फायलींची तुलना करा";
"onboarding.carousel.open_source.visual.fingerprint" = "प्रकाशित रिलीझ फिंगरप्रिंट";
