"onboarding.passphrase.learn_more.safety.strong.title" = "मजबूत, अद्वितीय पासफ्रेज तयार करा";
"onboarding.passphrase.learn_more.safety.strong.detail" = "अनेक यादृच्छिक शब्द किंवा फक्त या वॉलेटसाठी असलेले दुसरे उच्च-एन्ट्रॉपी मूल्य निवडा. वैयक्तिक माहिती, परिचित वाक्ये, नमुने आणि इतरत्र वापरलेले पासवर्ड टाळा.";
"onboarding.passphrase.learn_more.safety.backup.title" = "पासफ्रेजचा स्वतंत्र बॅकअप घ्या";
"onboarding.passphrase.learn_more.safety.backup.detail" = "अचूक पासफ्रेजची टिकाऊ ऑफलाइन प्रत तयार करा, ती पुनर्प्राप्ती वाक्यांशापासून वेगळी ठेवा आणि केवळ स्मरणशक्तीवर कधीही अवलंबून राहू नका.";
"onboarding.passphrase.learn_more.safety.exact.title" = "प्रत्येक वर्णामुळे वॉलेट बदलते";
