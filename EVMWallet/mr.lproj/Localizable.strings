"onboarding.carousel.open_source.visual.accessibility" = "रिलीझच्या पडताळणीसाठी सार्वजनिक स्रोत कोड, स्वतंत्रपणे पुन्हा तयार केलेला बिल्ड आणि जुळणारे फिंगरप्रिंट आवश्यक असल्याचे दाखवणारी आकृती.";
"onboarding.carousel.passphrase.eyebrow" = "पर्यायी BIP-39 पासफ्रेज";
"onboarding.carousel.passphrase.title" = "एक पुनर्प्राप्ती वाक्यांश. एक अतिरिक्त गुपित.";
"onboarding.carousel.passphrase.message" = "BIP-39 पासफ्रेज तुमच्या पुनर्प्राप्ती वाक्यांशासोबत वापरून स्वतंत्र वॉलेट तयार करतो. पुनर्प्राप्ती शब्द उघड झाले तरी त्या वॉलेटमध्ये प्रवेश करण्यासाठी अचूक पासफ्रेज आवश्यक असतो.";
"onboarding.carousel.passphrase.visual.phrase" = "तुमचे 24 पुनर्प्राप्ती शब्द";
