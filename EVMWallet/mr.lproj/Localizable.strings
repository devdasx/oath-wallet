"onboarding.carousel.passphrase.visual.requirement" = "पुनर्प्राप्तीसाठी दोन्ही गुपिते आवश्यक";
"onboarding.carousel.passphrase.visual.accessibility" = "24 शब्दांचा पुनर्प्राप्ती वाक्यांश आणि गुप्त BIP-39 पासफ्रेज मिळून स्वतंत्र वॉलेट तयार होते; ते पुनर्प्राप्त करण्यासाठी दोन्ही गुपिते आवश्यक असतात.";
"onboarding.carousel.passphrase.learn_more.action" = "अधिक जाणून घ्या";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 पासफ्रेज समजून घ्या";
"onboarding.passphrase.learn_more.path.section" = "दोन गुपितांपासून एक वॉलेट";
"onboarding.passphrase.learn_more.overview" = "BIP-39 पासफ्रेज हे तुमच्या पुनर्प्राप्ती वाक्यांशासोबत वापरले जाणारे पर्यायी गुपित आहे. हे दोन्ही मिळून केवळ पुनर्प्राप्ती वाक्यांशाने तयार होणाऱ्या वॉलेटपेक्षा वेगळे, निश्चित वॉलेट तयार करतात.";
"onboarding.passphrase.learn_more.visual.phrase" = "तुमचा 24 शब्दांचा पुनर्प्राप्ती वाक्यांश";
"onboarding.passphrase.learn_more.visual.passphrase" = "तुमचा गुप्त पासफ्रेज";
"onboarding.passphrase.learn_more.visual.wallet" = "पासफ्रेज-संरक्षित वॉलेट";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 शब्दांचा पुनर्प्राप्ती वाक्यांश आणि गुप्त पासफ्रेज मिळून स्वतंत्र, पासफ्रेज-संरक्षित वॉलेट तयार होते.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 वॉलेट कसे तयार करते";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "पुनर्प्राप्ती वाक्यांश आणि पासफ्रेज यांचे संयोजन";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 च्या 2,048 फेऱ्या";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-बिट मास्टर सीड";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "तयार झालेली वॉलेट खाती आणि पत्ते";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "तुमचा पुनर्प्राप्ती वाक्यांश आणि पासफ्रेज PBKDF2-HMAC-SHA512 च्या 2,048 फेऱ्यांतून जाऊन 512-बिट सीड तयार करतात; त्यातून वॉलेट खाती आणि पत्ते तयार होतात.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 मध्ये सामान्यीकृत पुनर्प्राप्ती वाक्यांश हा PBKDF2 पासवर्ड मानला जातो आणि “mnemonic” नंतर जोडलेला सामान्यीकृत पासफ्रेज सॉल्ट म्हणून वापरला जातो. PBKDF2-HMAC-SHA512 च्या 2,048 फेऱ्यांनंतर 64-बाइट सीड तयार होते.";
"onboarding.passphrase.learn_more.derivation.normalization" = "सीड तयार करण्यापूर्वी Oath, BIP-39 ने आवश्यक केलेले Unicode सामान्यीकरण लागू करते; त्यामुळे तोच सामान्यीकृत पुनर्प्राप्ती वाक्यांश आणि पासफ्रेज नेहमी तेच वॉलेट पुन्हा तयार करतात.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "पासफ्रेज तुमचे पुनर्प्राप्ती शब्द एन्क्रिप्ट करत नाही. तो तयार होणारा सीड बदलतो, त्यामुळे प्रत्येक वेगळ्या पासफ्रेजमधून वेगळी खाती आणि पत्ते तयार होतात.";
"onboarding.passphrase.learn_more.wallets.section" = "प्रत्येक पासफ्रेजपासून स्वतंत्र वॉलेट तयार होते";
"onboarding.passphrase.learn_more.wallets.visual.one" = "उदाहरण पासफ्रेज 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "उदाहरण पासफ्रेज 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "उदाहरण वॉलेट A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "उदाहरण वॉलेट B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "तोच पुनर्प्राप्ती वाक्यांश दोन वेगवेगळ्या पासफ्रेजसोबत वापरल्यावर वॉलेट A आणि वॉलेट B अशी दोन स्वतंत्र वॉलेट तयार होतात.";
"onboarding.passphrase.learn_more.wallets.different" = "अर्थपूर्ण असा एक वर्ण जरी बदलला तरी वेगळा सीड आणि त्यामुळे वेगळे वॉलेट तयार होते; मूळ वॉलेट बदलत नाही.";
"onboarding.passphrase.learn_more.wallets.empty" = "रिकामा पासफ्रेज केवळ पुनर्प्राप्ती वाक्यांशापासून तयार झालेले मानक वॉलेट उघडतो; रिकामा नसलेला पासफ्रेज त्याचे स्वतंत्र वॉलेट उघडतो.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 मध्ये “चुकीचा पासफ्रेज” असा प्रतिसाद नसतो; प्रत्येक पासफ्रेज वैध असतो, त्यामुळे टायपिंगची चूक कोणतीही सूचना न देता दुसरे वॉलेट उघडते—बहुतेकदा शून्य शिल्लकीचे.";
"onboarding.passphrase.learn_more.security.section" = "पासफ्रेजमुळे संरक्षण कसे वाढते";
"onboarding.passphrase.learn_more.security.words.title" = "फक्त पुनर्प्राप्ती शब्द पुरेसे नाहीत";
"onboarding.passphrase.learn_more.security.words.detail" = "एखाद्याला फक्त तुमचा पुनर्प्राप्ती वाक्यांश मिळाला तरी संरक्षित वॉलेट तयार करून त्यात प्रवेश करण्यासाठी अचूक पासफ्रेज आवश्यक असतो.";
"onboarding.passphrase.learn_more.security.strength.title" = "मजबूत पासफ्रेज अधिक प्रभावी विभाजन करतो";
"onboarding.passphrase.learn_more.security.strength.detail" = "लांब, अंदाज लावता न येणारा पासफ्रेज ओळखणे खरोखर कठीण करते; लहान उद्धरण, वाढदिवस, नाव किंवा पुन्हा वापरलेला पासवर्ड पटकन ओळखला जाऊ शकतो आणि फारसे संरक्षण देत नाही.";
"onboarding.passphrase.learn_more.security.separation.title" = "पासफ्रेज वेगळा ठेवा";
"onboarding.passphrase.learn_more.security.separation.detail" = "पासफ्रेज पुनर्प्राप्ती वाक्यांशापासून वेगळा ठेवा, म्हणजे एकच बॅकअप चोरीला गेल्यास वॉलेट पुनर्संचयित करण्यासाठी आवश्यक दोन्ही गुपिते उघड होणार नाहीत.";
"onboarding.passphrase.learn_more.security.footer" = "दोन्ही गुपिते उघड झाल्यास, पासफ्रेज कमकुवत असल्यास किंवा टाइप करताना तडजोड झालेले सॉफ्टवेअर तो टिपून घेत असल्यास पासफ्रेज तुमचा निधी सुरक्षित ठेवू शकत नाही.";
