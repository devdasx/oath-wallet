"settings.about.history.v354.build55.interface" = "iOS 27 सुसंगतता, उजवीकडून डावीकडील मांडणी, प्राप्तकर्त्यासाठी सूचना, भाषांतरे आणि कीबोर्डची स्थिरता सुधारली आहे. प्राप्त करण्याच्या स्क्रीनवर Avalanche C-Chain स्पष्ट केले आहे आणि Stellar व Gram मेमो समजावले आहेत. विकिपीडियाची वर्णने काढली आहेत.";

"settings.about.history.v354.build55.send" = "पुनरावलोकन स्क्रीन शुल्क तपासते, नेटवर्कचे मूळ नाणे जमा करण्याचा पर्याय देते आणि शुल्क भागवण्यासाठी त्याची पाठवायची रक्कम समायोजित करते. नाणे नियंत्रण पत्त्यांचे प्रकार आणि निवडलेले इनपुट दाखवते. Solana लोडिंग, Sui हस्तांतरणे आणि जुन्या iOS आवृत्त्यांवरील Sui इतिहास सुधारला आहे.";

"settings.about.history.v354.build55.notifications" = "भाषांतरित सूचना तुमच्या प्राधान्यांचे पालन करतात आणि मालमत्तेचे लोगो, योग्य स्वरूपातील रकमा, अद्ययावत स्थिती आणि व्यवहाराचे संपूर्ण तपशील दाखवतात.";

"settings.about.history.v354.build55.backup" = "आयात केलेल्या Bitcoin वॉलेटचा बॅकअप आणि पुनर्प्राप्ती सुधारली आहे.";

