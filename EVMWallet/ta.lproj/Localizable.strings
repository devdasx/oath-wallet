"settings.about.history.v354.build53.send" = "Bitcoin உள்ளீடுகளைக் கைமுறையாகத் தேர்ந்தெடுப்பது சரிசெய்யப்பட்டுள்ளது. கட்டணம், மீதித் தொகை மற்றும் இறுதிப் பரிவர்த்தனையைக் கணக்கிடும்போது தேர்ந்தெடுத்த அனைத்து உள்ளீடுகளும் இப்போது சேர்க்கப்படும்.";

