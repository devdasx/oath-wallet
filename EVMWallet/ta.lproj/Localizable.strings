/* Arbitrum transfer affordability */
"send.submit.error.arbitrum_eth_fee" = "பரிமாற்றம் அனுப்பப்படவில்லை. ARB அல்லது பிற டோக்கன்களை அனுப்புவதற்கான கட்டணத்தைச் செலுத்த Arbitrum One வலையமைப்பில் ETH தேவை. Arbitrum One வலையமைப்பில் இந்த முகவரிக்கு ETH சேர்த்து மீண்டும் முயலவும்.";
"send.submit.error.arbitrum_eth_total" = "பரிமாற்றம் அனுப்பப்படவில்லை. Arbitrum One வலையமைப்பில் உள்ள உங்கள் ETH இருப்பு, பரிமாற்றத் தொகைக்கும் வலையமைப்புக் கட்டணத்திற்கும் போதவில்லை. தொகையைக் குறைக்கவும் அல்லது Arbitrum One வலையமைப்பில் ETH சேர்க்கவும்.";

"send.review.funding.insufficient" = "%@ இன் பயன்படுத்தக்கூடிய இருப்பு, %@ வலையமைப்பில் இந்தப் பரிமாற்றத்திற்கும் வலையமைப்புச் செலவுகளுக்கும் போதவில்லை. தொடர, இதே வலையமைப்பில் அதன் அடிப்படை நாணயத்தைச் செலுத்தவும்.";

"send.review.funding.deposit" = "%@ செலுத்தவும்";

"send.submit.error.sui_provider_unavailable" = "Sui நெட்வொர்க்கில் தற்போது அனுப்ப முடியவில்லை. எந்தப் பரிவர்த்தனையும் சமர்ப்பிக்கப்படவில்லை. பின்னர் மீண்டும் முயற்சிக்கவும்.";

"settings.about.history.v354.build55.interface" = "iOS 27 இணக்கத்தன்மை, வலமிருந்து இடமாகக் காட்டும் அமைப்பு, பெறுநர் குறிப்புகள், மொழிபெயர்ப்புகள் மற்றும் விசைப்பலகை நிலைத்தன்மை மேம்படுத்தப்பட்டுள்ளன. பெறும் திரை Avalanche C-Chain-ஐ அடையாளப்படுத்தி Stellar, Gram மெமோக்களை விளக்குகிறது. விக்கிப்பீடியா விளக்கங்கள் அகற்றப்பட்டுள்ளன.";

"settings.about.history.v354.build55.send" = "மதிப்பாய்வுத் திரை கட்டணங்களைச் சரிபார்த்து, நெட்வொர்க்கின் சொந்த நாணயத்தை வைப்பிடும் வசதியை வழங்கி, கட்டணத்தை ஈடுகட்ட அதன் அனுப்பும் தொகையைச் சரிசெய்கிறது. நாணயக் கட்டுப்பாடு முகவரி வகைகளையும் தேர்ந்தெடுத்த உள்ளீடுகளையும் காட்டுகிறது. Solana ஏற்றம், Sui பரிமாற்றங்கள் மற்றும் பழைய iOS பதிப்புகளில் Sui வரலாறு மேம்படுத்தப்பட்டுள்ளன.";

"settings.about.history.v354.build55.notifications" = "மொழிபெயர்க்கப்பட்ட அறிவிப்புகள் உங்கள் விருப்பங்களைப் பின்பற்றி, சொத்து சின்னங்கள், வடிவமைக்கப்பட்ட தொகைகள், தற்போதைய நிலை மற்றும் முழுப் பரிவர்த்தனை விவரங்களைக் காட்டுகின்றன.";

"settings.about.history.v354.build55.backup" = "இறக்குமதி செய்த Bitcoin பணப்பைகளின் காப்புப்பிரதியும் மீட்டெடுப்பும் மேம்படுத்தப்பட்டுள்ளன.";

