// Version 3.5.4 (53)
"settings.about.history.v354.build53.brd" = "Bitcoin-க்கு BRD Legacy மற்றும் Native SegWit முகவரிகளுக்கான ஆதரவு சேர்க்கப்பட்டுள்ளது.";
"settings.about.history.v354.build53.imports" = "Bitcoin இறக்குமதிக்குக் கூடுதல் விருப்பங்கள்: BIP38, ஹெக்ஸ் விசைகள், மினி விசைகள், நீட்டிக்கப்பட்ட விசைகள், தனிப்பட்ட விளக்கிகள், wallet.dat, Electrum, TXT, CSV மற்றும் JSON. ஆதரிக்கப்படும் மறையாக்கப்பட்ட விசைகளையும் காப்புப்பிரதிகளையும் ஒரே படியில் மறைவிலக்கி இறக்குமதி செய்யலாம்.";
