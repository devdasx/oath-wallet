"onboarding.subtitle.assets_view" = "ஆதரிக்கப்படும் அனைத்து நெட்வொர்க்குகளிலும் இருப்பு, டோக்கன்கள் மற்றும் செயல்பாட்டை ஒரே இடத்தில் பாருங்கள்.";
"onboarding.subtitle.crypto_clarity" = "சக்திவாய்ந்த வாலெட் கருவிகள், எளிமையாக வழங்கப்படுகின்றன—ஒவ்வொரு செயலும் புரியும் வகையில்.";
