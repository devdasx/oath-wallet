"settings.about.history.v352.scanner" = "QR ஸ்கேன், அமைப்பின் மூடும் பொத்தானுடன் தனிக் கேமரா தாளைத் திறக்கும்.";
"settings.about.history.v352.recipients" = "பெறுநர் வரலாறு காலியாக இருந்தால் பிழையோ மீண்டும் முயலும் அறிவுறுத்தலோ இனி காட்டப்படாது.";
"settings.about.history.v352.amount" = "உள்ளூர் நாணயம் மற்றும் சொத்தின் இயல்பான அலகுகளிடையே மாற மாற்று காப்சூலைத் தட்டவும்; அது மற்ற அலகில் சமமான தொகையைக் காட்டும்.";
"settings.about.history.v352.visibility" = "அங்கீகாரம் அல்லது செயலி மாற்றத்திற்குப் பிறகும் முகவரிகளும் பரிவர்த்தனை ID-களும் தெரியும். நீண்ட மதிப்புகள் கூடுதல் இணைப்புக்குறியின்றி அடுத்த வரிக்கு மடங்கும்.";
"settings.about.history.v352.op_return" = "பரிவர்த்தனை வரம்புகளுக்குள் Bitcoin செய்திகள் 99,994 UTF-8 பைட்டுகள் வரை ஆதரிக்கப்படுகின்றன. அதிகபட்சத் தொகைக்கான கையொப்பம் சரிசெய்யப்பட்டது; நீண்ட செய்திகள் மூன்று வரிகளாகத் தெரிந்து, தாளில் முழுமையாகத் திறக்கும்.";
"settings.about.history.v352.repeat" = "மீண்டும் அனுப்பு முதலில் நிதியைச் சரிபார்த்து, இருப்பு போதாவிட்டால் அடுத்த பரிமாற்றம் தொடங்குமுன் உரையாடல் பெட்டியைக் காட்டும்.";
"settings.about.history.v352.sharing" = "பரிவர்த்தனை ID பகிர்வுக்கு இப்போது சரியாக மொழிபெயர்க்கப்பட்ட தனி பெயர்ச்சீட்டு உள்ளது.";
"settings.about.history.v352.localization" = "அனைத்து 57 மொழிகளிலும் மொழிபெயர்க்காத அல்லது பழைய பெயர்ச்சீட்டுகள், குறிப்புரைகள் மற்றும் பிணையப் பெயர்கள் சரிசெய்யப்பட்டு, உள்ளூர்மயமாக்கல் சரிபார்ப்புகள் மேம்படுத்தப்பட்டன.";
"settings.about.history.v352.icon" = "ஏற்கெனவே உள்ள வடிவத்தைப் பாதுகாத்து App Store விநியோகத்திற்கான சின்னத்தின் வெளிப்படைத்தன்மை சரிசெய்யப்பட்டது.";
"settings.about.history.v352.backup" = "உறுதிப்படுத்திய பிறகு ஏற்கெனவே உள்ள iCloud காப்புப்பிரதிகளை மாற்றலாம்.";

"settings.about.history.v352.build48" = "உருவாக்கம் 48: மொழிபெயர்க்கப்பட்ட வெளியீட்டுக் குறிப்புகள் சேர்க்கப்பட்டன. செயல்திறன் பதிவுகளை ஏற்றுமதி செய்வதும் உருவாக்குநர் பதிவுகளைச் சேமிப்பதும் அகற்றப்பட்டன. பழைய கண்டறிதல் கோப்புகள் தானாகச் சுத்தம் செய்யப்படும்.";

"settings.about.history.v352.build49" = "உருவாக்கம் 49: பதிப்பு வரலாற்றில் உள்ள வெளியீட்டுக் குறிப்புகள் எளிமைப்படுத்தப்பட்டன.";

"send.submit.error.tron_signature" = "பரிவர்த்தனையின் கையொப்பத்தை TRON ஆல் சரிபார்க்க முடியவில்லை. கணக்கின் கையொப்ப அனுமதிகளைச் சரிபார்க்கவும்: கூடுதல் கையொப்பங்கள் அல்லது வேறொரு அங்கீகரிக்கப்பட்ட விசை தேவைப்படலாம்.";

"tron.permissions.warning.title" = "பல கையொப்பங்கள் தேவைப்படும் TRON பணப்பை";
"tron.permissions.warning.body" = "இந்தப் பணப்பைக்குப் பல TRON கையொப்பங்கள் தேவை. இந்தச் செயலியில் அனுப்புதல், பெறுதல் மற்றும் பணப்பைச் செயல்கள் முடக்கப்பட்டுள்ளன.\n\nபல கையொப்ப முறைக்கு முறையான பயன்பாடுகளும் உள்ளன. யாரேனும் இந்தப் பணப்பையை உங்களுக்குக் கொடுத்திருந்தால், அதன் டோக்கன்களைத் திறக்க TRX செலுத்த வேண்டாம். தேவையான கையொப்பங்கள் அவர்களின் கட்டுப்பாட்டில் இருக்கலாம்; நீங்கள் செலுத்திய தொகையை அவர்கள் திருடக்கூடும்.";
"tron.permissions.unavailable" = "TRON கையொப்ப அனுமதிகளைச் சரிபார்க்க முடியவில்லை.";

"wallet.restrictions.warning.title" = "வாலட்டில் கட்டுப்பாடுகள் கண்டறியப்பட்டன";

"wallet.blacklist.warning.body" = "கீழே பட்டியலிடப்பட்ட டோக்கன் ஒப்பந்தங்கள் இந்த முகவரி தடுப்புப் பட்டியலில் இருப்பதாகத் தெரிவித்துள்ளன. இந்த டோக்கன்களின் பரிமாற்றங்கள் தடுக்கப்பட்டிருக்கலாம். நெட்வொர்க் கட்டணத்திற்காகப் பணம் சேர்ப்பதால் கட்டுப்பாடு நீங்காது.";


"import.safety.action.different_recovery_phrase" = "வேறொரு மீட்புச் சொற்றொடரைப் பயன்படுத்தவும்";

"import.safety.action.different_private_key" = "வேறொரு தனிப்பட்ட விசையைப் பயன்படுத்தவும்";

"settings.about.history.v352.build50.safety" = "உருவாக்கம் 50: TRON பல்கையொப்பம் மற்றும் USDT/USDC கட்டுப்பாடுகளுக்கான ஒருங்கிணைந்த எச்சரிக்கைகள். TRON பல்கையொப்பப் பரிமாற்றங்கள் முடக்கப்பட்டிருக்கும்; அமைப்புகளை அணுகலாம். கையொப்பப் பிழைகளும் இறக்குமதி வழிகாட்டுதலும் தெளிவாக்கப்பட்டன; தடுக்கப்பட்ட மீட்புச் சொற்றொடர்களின் பட்டியல் புதுப்பிக்கப்பட்டது.";

"settings.about.history.v352.build50.input" = "இறக்குமதிக்குப் பிறகு விலைகள் விரைவாக ஏற்றப்படுகின்றன. பூஜ்ஜிய இருப்பில் அலகு மாற்றமும் வலமிருந்து இடமாக எழுதும் மொழிகளில் மாற்றியில் உள்ளீடும் சரிசெய்யப்பட்டன. மீட்புச் சொற்களின் வரிசை மாறாது; செல்லுபடியாகும் சொற்றொடரை ஒட்டினாலோ ஸ்கேன் செய்தாலோ விசைப்பலகை மூடப்படும்.";

"settings.about.history.v352.build50.interface" = "முகப்புத் திரை மற்றும் சொத்துகளைப் பொருத்தும் அசைவூட்டங்கள் சீராக்கப்பட்டன; தொடு உணர்வு பின்னூட்டமும் மொழிபெயர்ப்புகளும் மேம்படுத்தப்பட்டன. பெறுதல் அட்டைகள் பெரிய QR குறியீடுகளுடனும் முகவரி எழுத்துகளுடனும் இருண்ட தோற்றத்தை ஆதரிக்கின்றன. மாற்றங்கள் சரிக்குறியால் உறுதிசெய்யப்படும்; எச்சரிக்கைகள் தேவையான தகவல்களை மட்டும் காட்டும்.";

"evm_access.gas.insufficient.title" = "நெட்வொர்க் கட்டணத்திற்குப் போதுமான இருப்பு இல்லை";
"evm_access.gas.insufficient.body" = "நெட்வொர்க் கட்டணத்தைச் செலுத்த, இந்த வாலட்டில் %@ சேர்க்கவும். இதற்கு %@ நெட்வொர்க்கைப் பயன்படுத்தவும். பின்னர் அனுமதியை ரத்து செய்ய மீண்டும் முயற்சிக்கவும்.";

// Version 3.5.3 (51).
"settings.about.history.v353.build51.recovery" = "மீட்பு சொற்றொடர் சரிபார்ப்பு, தானியங்கி சிற்றெழுத்து மாற்றம், எண்களுடன் உள்ளீடு, அழித்தல், பேக்ஸ்பேஸை அழுத்திப் பிடித்து நீக்குதல் மற்றும் விசைப்பலகை செயல்பாடு மேம்படுத்தப்பட்டுள்ளன. மீட்புத் திரைகளில் இப்போது ஒரே பின்செல் பொத்தான் உள்ளது.";
"settings.about.history.v353.build51.send" = "கட்டண மதிப்பீடுகள் கிடைக்காதபோது பயன்படுத்த, ஆதரிக்கப்படும் அனைத்து நெட்வொர்க்குகளிலும் மாற்றுக் கட்டண மதிப்பீட்டு முறைகள் சேர்க்கப்பட்டுள்ளன. அனுப்பும்போது ஒப்பந்த முகவரிகள் மறைக்கப்பட்டு கட்டணங்கள் தெளிவாகக் காட்டப்படுகின்றன.";
"settings.about.history.v353.build51.security" = "அனுமதி மதிப்பாய்வு, முகவரி விவரங்கள், அனுமதி ரத்து முடிவுகள் மற்றும் கட்டணத்திற்குப் பணம் சேர்க்கும் வழிகாட்டுதல் தெளிவாக்கப்பட்டுள்ளன. காப்புப் பிரதி அட்டைகளும் பேனல்களும் ஒரே வடிவமைப்பைப் பயன்படுத்துகின்றன. வழிசெலுத்தல் அதிர்வு நீக்கப்பட்டுள்ளது.";
"settings.about.history.v353.build51.notifications" = "பல்வேறு நெட்வொர்க்குகளில் வரும் பரிமாற்ற அறிவிப்புகள் மேலும் நம்பகமானவை. விலைகள் கிடைத்தால் தேர்ந்தெடுத்த நாணயத்திலும், இல்லையெனில் கிரிப்டோவின் சொந்த அலகிலும் தொகை காட்டப்படும்.";

