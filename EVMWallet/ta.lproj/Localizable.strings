"settings.about.history.v352.recovery" = "எண்களிட்ட சொல் காப்சூல்கள் தட்டச்சின்போது விரிவடைகின்றன; மென்மையான மாற்றங்கள், திருத்தும்போது புள்ளியிட்ட விளிம்புகள், சொற்களை நீக்கும்போது நிலையான இடங்கள் ஆகியவற்றைக் கொண்டுள்ளன.";
"settings.about.history.v352.typing" = "தானியங்கி கவனம், Space அல்லது Enter மூலம் நிறைவு, Backspace மூலம் இருபடி திருத்தம், அழுத்திப் பிடித்து நீக்குதல் மற்றும் தானியங்கி உருட்டல். சொற்றொடர் செல்லுபடியாக இருந்தால் மட்டுமே Enter விசைப்பலகையை மறைக்கும்.";
"settings.about.history.v352.passphrase" = "முதல் கடவுச்சொற்றொடர் புலம் தானாகக் கவனம் பெறும். Enter சரிபார்ப்புக்குச் சென்று, பின்னர் விசைப்பலகையை மறைக்கும். சரிக்குறி மூலம் சேமிக்கும் செயல் மீட்டமைக்கப்பட்டது.";
