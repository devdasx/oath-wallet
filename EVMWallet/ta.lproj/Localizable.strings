"settings.about.history.v358.arc.title" = "Arc நெட்வொர்க்";
"settings.about.history.v358.arc" = "கட்டணங்கள் USDC இல் செலுத்தப்படும் Circle இன் நெட்வொர்க்கான Arc இப்போது பெறுதல், அனுப்புதல், இருப்புகள் மற்றும் செயல்பாட்டிற்கு ஆதரிக்கப்படுகிறது, உடன் EURC, Circle Wrapped Bitcoin மற்றும் பிற Arc டோக்கன்கள். பரிமாற்றங்கள் உறுதிப்படுத்த கட்டணங்கள் நெட்வொர்க்கின் குறைந்தபட்சத்திற்கு மேலே இருக்கும்.";
