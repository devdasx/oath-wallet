// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "உறுதிப்படுத்தல் பொத்தானுக்குப் பதிலாக நகர்த்தி அனுப்பும் வசதி வந்துள்ளது. திசை அசைவூட்டம், தொடு பின்னூட்டம், மென்மையான இயக்கம் இரு வாசிப்புத் திசைகளையும் ஆதரிக்கின்றன. அனுப்ப 90% அல்லது அதற்கு மேல் சென்று விரலை விடவும்; ரத்துசெய்ய பின்னால் நகர்த்தவும்.";
"settings.about.history.v355.build56.activity" = "மணியைத் தட்டினால் நிலுவைச் செயல்பாடுகள் திறக்கும். பரிவர்த்தனைக் காப்சூல்கள் நிலைப் பதக்கங்களைக் காட்டும்; ஸ்வைப் செய்து மறைக்கலாம். உறுதியாகிக்கொண்டிருக்கும் மற்றும் உறுதியான காப்சூல்கள் 3 வினாடிகளில் மறையும்; உறுதியானதும் அதே தெரியும் காப்சூல் புதுப்பிக்கப்படும்.";
"settings.about.history.v355.build56.status" = "ஆதரிக்கப்படும் அனைத்து நெட்வொர்க்குகளிலும் நம்பகமான பரிவர்த்தனை நிலை, நேரடியாகப் புதுப்பிக்கப்படும் விவரங்கள், அனுப்பிய பிறகு விரைவான இருப்புப் புதுப்பிப்புகள். செயலியை மீண்டும் திறக்கும்போது நிலுவைப் பரிவர்த்தனைகளின் கண்காணிப்பு தொடரும்.";
"settings.about.history.v355.build56.fees" = "அதே பணமாற்ற மதிப்பாய்வுக்குத் திரும்பும்போது ஏற்கெனவே பெறப்பட்ட கட்டணம் தக்கவைக்கப்படும். கட்டண ஏற்றமும் கணக்கு நிதி எச்சரிக்கைகளும் தெளிவாக்கப்பட்டுள்ளன; போதுமான தொகைக்கு செயல்படுத்தல் அறிவிப்புகள் காட்டப்படாது.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin, Dogecoin ஆகியவை டஸ்ட் வரம்புக்குக் குறைவான மீதித் தொகையை பயன்படுத்த முடியாத வெளியீடாக உருவாக்காமல் கட்டணத்தில் சேர்க்கின்றன. மதிப்பாய்வுக் கட்டணம் கையொப்பமிடும்போதுள்ள கட்டணத்துடன் பொருந்தும்.";
"settings.about.history.v355.build56.stability" = "பின்னணிப் பணியால் ஏற்பட்ட செயலிழப்பும் பணப்பை புதுப்பிப்பு நேரமுடிவு எச்சரிக்கைகளும் சரிசெய்யப்பட்டன. புதுப்பிப்பு தற்காலிகமாகத் தோல்வியடைந்தாலும் ஏற்கெனவே உள்ள பணப்பைத் தகவல்கள் கிடைக்கும்.";
"settings.about.history.v355.build56.backup" = "திறந்தவுடன் சரியான தலைப்புகளும் குறைவான செய்திகளும் கொண்ட தெளிவான காப்புப் பிரதி திரைகள். தனிப்பட்ட விசி அணுகல் செயலிப் பூட்டு அமைப்புகளைப் பின்பற்றும். சிறிய கண்ணாடி வடிவ இறக்குமதி எச்சரிக்கையில் வேறொரு மீட்பு சொற்றொடரைத் தேர்ந்தெடுத்தால் நிராகரிக்கப்பட்ட உள்ளீடு அழிக்கப்படும்.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "அனுப்பும் ஸ்லைடரை விட்டதும், சரிபார்ப்புத் திரை மூடுவதற்கு முன் அனிமேஷனுடன் கூடிய சரிக்குறி தோன்றும்.";
"settings.about.history.v355.build57.activity" = "செயல்பாட்டு வரிசைகளில் நிலை உரை குறைந்த தடிமனிலும், தொகை துணைத்தலைப்பாகவும் காட்டப்படும். பரிவர்த்தனை விவரங்களைத் திறக்க அம்புக்குறியும் உள்ளது.";
"settings.about.history.v355.build57.details" = "நெட்வொர்க் கட்டணங்கள் இப்போது பரிமாற்றச் சுருக்கத்தில் உள்ளன. சுருக்கமான பெயர்களும் நெட்வொர்க்கிற்கு ஒரே வரிசையும் விவரங்களைத் தெளிவாக்குகின்றன.";
"settings.about.history.v355.build57.resume" = "பின்னணியிலிருந்து திரும்பும்போது திறந்த திரைகளும் பலகங்களும் அப்படியே இருக்கும். பரிமாற்றச் சரிபார்ப்பும் பரிவர்த்தனை விவரங்களும் இதில் அடங்கும்.";
"settings.about.history.v355.build57.secrets" = "செயலியை விட்டு 20 வினாடிகள் சென்றால் மீட்பு சொற்றொடர், தனிப்பட்ட விசை மற்றும் கடவுச்சொற்றொடர் திரைகள் மூடப்படும். செயலிப் பூட்டு உங்கள் அமைப்புகளின்படியே செயல்படும்.";
"settings.about.history.v355.build57.filters" = "நெட்வொர்க் வடிகட்டிகளில் சற்று உயரமான இயல்புநிலைப் பொத்தான்கள், உள்ளடக்கத்திற்கு ஏற்ற அளவு மற்றும் வழிசெலுத்தல் பட்டிக்குக் கீழே சரிசெய்யப்பட்ட இடைவெளி பயன்படுத்தப்படுகின்றன.";
"settings.about.history.v355.build57.units" = "தனித்தனி மதிப்பு வரிசைகள் நீக்கப்பட்டன. தொகையும் நெட்வொர்க் கட்டணமும் முதலில் உள்ளூர் நாணயத்தில் தெரியும்; கிரிப்டோ அலகுகளுக்கு மாறவும் திரும்பவும் அவற்றைத் தட்டவும்.";
"wallet.transaction.details.toggle_units" = "அலகுகளை மாற்றவும்.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "முகப்புத் திரை மங்கல் அல்லது அளவு மாற்ற விளைவுகள் இன்றித் திறக்கிறது. அமைப்புகள் பொத்தானில் இப்போது பற்சக்கரச் சின்னம் உள்ளது.";
"settings.about.history.v355.build58.fields" = "பரிவர்த்தனை மற்றும் அனுப்புதல் புலங்களில் வழக்கமான உரை நிறங்கள் பயன்படுத்தப்படுகின்றன. திரை அல்லது பலகையைத் திறக்கும் வரிகளில் மட்டுமே அம்புக்குறிகள் தோன்றும்; தொகை மற்றும் கட்டணத்தைத் தட்டினால் முன்புபோலவே அலகு மாறும்.";
"settings.about.history.v355.build58.banners" = "காட்டப்பட்ட பிறகு, உறுதிப்படுத்தல் நடைபெறுவதற்கான அல்லது முடிந்ததற்கான அறிவிப்புகள் 3 வினாடிகளில் மறையும்; வேறு திரையைத் திறந்தாலும் இது தொடரும். இன்னும் காட்டப்படாத உறுதிப்படுத்தல் அறிவிப்புகள் நீங்கள் திரும்பும்போது தோன்றும்.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "அதிகபட்சத் தொகையை அனுப்பும்போதும், அனுப்ப வேண்டிய தொகையைக் கணக்கிடுவதற்கு முன் TRON பரிமாற்றங்கள் இப்போது செயல்படுத்தல் மற்றும் அலைவரிசைக் கட்டணங்களுக்கான தொகையை ஒதுக்குகின்றன. மதிப்பாய்வுத் திரையில் கட்டணங்கள் கழித்த பின் சரியான தொகை காட்டப்படுகிறது.";
"settings.about.history.v355.build59.fees" = "நீங்களே நிர்ணயிக்கும் TRON கட்டணங்கள் தேவையான நெட்வொர்க் செலவுகளை ஈடுசெய்ய வேண்டும். TRX இருப்பு குறைவாக இருக்கும்போது இப்போது மேலும் தெளிவான வழிகாட்டுதல் காட்டப்படுகிறது. டோக்கன்களின் அளவு மாறாது; கட்டணங்கள் TRX-இல் செலுத்தப்படும்.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "புதிய வரவேற்பு";
"settings.about.history.v356.welcome" = "அனிமேஷன் செய்யப்பட்ட கலைப்படைப்புகளுடன் கூடிய புதிய வரவேற்புத் திரை மற்றும் பணப்பையை உருவாக்க அல்லது இறக்குமதி செய்வதற்கான தெளிவான விருப்பங்கள்.";
"settings.about.history.v357.tour.title" = "வரவேற்புச் சுற்றுலா";
"settings.about.history.v357.tour" = "ஐந்து பக்கச் சுற்றுலா ஆதரிக்கப்படும் நெட்வொர்க்குகள், இயற்பியல் என்ட்ரோபி, அனுப்புதல் மற்றும் பெறுதல், பாதுகாப்பு மற்றும் சரிபார்க்கப்பட்ட பில்டுகளை அறிமுகப்படுத்துகிறது. பக்கம் மாற்ற ஸ்வைப் செய்யவும் அல்லது புள்ளிகளைத் தட்டவும்; மொழி மாற்றி வழிசெலுத்தல் பட்டையில் உள்ளது.";
"settings.about.history.v357.backup" = "வாலட்டை உருவாக்கிய, இறக்குமதி செய்த அல்லது மீட்டெடுத்த பிறகு திரை உடனே தோன்றும், அதன் காப்புப்பிரதி விருப்பங்கள் நிலையான பட்டியலைப் பயன்படுத்தும். iCloud சரிபார்ப்பு பின்னணியில் இயங்கும்; வாலட் சேமிக்கப்பட்டவுடன் வாலட்டைத் திற தயாராக இருக்கும்.";
"settings.about.history.v357.reliability" = "மறைக்கப்பட்ட மீட்புத் திரை காலாவதியாகும்போது பின்னணியிலிருந்து திரும்புவது இனி அமைவுத் திரையை மூடாது; எல்லா தரவையும் அழித்தால் வரவேற்புத் திரை நேரடியாகத் திறக்கும்.";
"settings.about.history.v357.notifications" = "அறிவிப்பு அமைப்புகள் வகைகளுக்கும் நிலைக்கும் தொழில்நுட்ப விவரங்கள் இல்லாத எளிய சொற்களைப் பயன்படுத்துகின்றன.";
"settings.about.history.v357.wallets" = "மாற்றியில் வாலட்டுகளை நீண்ட அழுத்தத்துடன் சிஸ்டத்தின் தூக்கும் அனிமேஷனைப் பயன்படுத்தி மறுவரிசைப்படுத்துங்கள்; வரிசையைத் தட்டினால் அது செயல்படும். மீட்பு சொற்றொடர் சரிபார்ப்பு ஒவ்வொரு சொல்லுக்கும் எண் இடுகிறது, Return அடுத்த புலத்திற்குச் செல்கிறது.";
"settings.about.history.v357.send" = "பரிமாற்றம் நடக்கும்போது அனுப்புதல் தொகையைக் காட்டுகிறது, அனுப்ப முடியாவிட்டால் தெளிவான செய்தி தோன்றுகிறது, தற்காலிக வழங்குநர் பிழைகளுக்குப் பிறகு TRON கோரிக்கைகள் தானாக மீண்டும் முயற்சிக்கின்றன.";
"settings.about.history.v357.security" = "உரிமையாளர் அனுமதி வேறு சாவிக்கு மாற்றப்பட்ட இறக்குமதி செய்யப்பட்ட TRON கணக்குகள், ஒவ்வொரு அனுமதியிலும் ஒரே சாவி இருந்தாலும் இப்போது எச்சரிக்கையைக் காட்டுகின்றன, அனுப்ப முடியாது. வெளிப்பட்டதாக அறியப்பட்ட மேலும் பல மீட்பு சொற்றொடர்களும் தனிப்பட்ட சாவிகளும் இறக்குமதியின்போது நிராகரிக்கப்படுகின்றன.";
"settings.about.history.v356.localization" = "ஆதரிக்கப்படும் அனைத்து மொழிகளிலும் வரவேற்புத் திரையின் உரை மேலும் இயல்பாகவும் தெளிவாகவும் மேம்படுத்தப்பட்டுள்ளது.";
"settings.about.history.v356.pricing" = "டோக்கன் விலைகள் இப்போது DEX விலைகளை முதலில் பயன்படுத்தி, சரியான நெட்வொர்க் மற்றும் டோக்கன் முகவரியுடன் பொருந்துகின்றன. சிறிய விலைகள் வட்டமிடாமல் 8 தசம இடங்கள் வரை காட்டப்படும்.";
"settings.about.history.v356.appearance" = "முதன்மை மற்றும் இரண்டாம் நிலை பொத்தான்கள் இப்போது நிலையான உயரம் மற்றும் திரை விளிம்புகளைப் பயன்படுத்துகின்றன, முதன்மை செயல்களுக்கு கணினி நீலத்துடன்.";
"settings.about.history.v356.transactions" = "பரிவர்த்தனை விவரங்கள் தேதிகள், முகவரிகள், தொகைகள் மற்றும் பரிவர்த்தனை ஐடிகளுக்கு குறுகிய உறுதிப்படுத்தப்பட்ட நிலை மற்றும் தெளிவான சாம்பல் உரையைப் பயன்படுத்துகின்றன.";
"settings.about.history.v356.security" = "அறியப்பட்ட அம்பலப்படுத்தப்பட்ட மீட்பு சொற்றொடர்கள் மற்றும் இறக்குமதி செய்ய முடியாத தனிப்பட்ட விசைகளின் பட்டியல் விரிவாக்கப்பட்டது.";

"send.submit.error.try_again" = "உங்கள் பரிவர்த்தனையை அனுப்பும்போது ஒரு சிக்கல் ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்.";

