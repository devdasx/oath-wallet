"onboarding.title.assets_view" = "ஒவ்வொரு சொத்தும்.\nஒரே தெளிவான பார்வையில்.";
"onboarding.title.crypto_clarity" = "கிரிப்டோவுக்காக உருவாக்கப்பட்டது.\nதெளிவுக்காக வடிவமைக்கப்பட்டது.";
"onboarding.title.networks_aperture" = "பல நெட்வொர்க்குகள்.\nஒரே பாதுகாப்பான வாலெட்.";
"onboarding.title.onchain_control" = "ஆன்செயினில் செயல்படுங்கள்.\nமுழுக் கட்டுப்பாட்டையும் வைத்திருங்கள்.";
"onboarding.carousel.wallet.eyebrow" = "உங்கள் OATH WALLET";
"onboarding.carousel.wallet.title" = "ஒவ்வொரு செயலுக்கும் ஒரே வாலெட்.";
"onboarding.carousel.wallet.message" = "நெட்வொர்க்குகள் அனைத்திலும் தெளிவாகவும் வேகமாகவும் இயங்கி, முழுவதும் உங்கள் கட்டுப்பாட்டிலேயே இருக்கும் நவீன, சாதனத்திற்கேற்ற இடத்தை உங்கள் சொத்துகளுக்கு Oath வழங்குகிறது.";
"onboarding.carousel.wallet.visual.networks" = "நெட்வொர்க்குகள் அனைத்தையும் ஒருங்கிணைத்த பார்வை";
"onboarding.carousel.wallet.visual.accessibility" = "வாலெட் இருப்பு, அனுப்பு, பெறு, ஸ்கேன் செயல்கள் மற்றும் Ethereum, Bitcoin சொத்துகளைக் காட்டும் Oath முன்னோட்டம்.";
"onboarding.carousel.entropy.eyebrow" = "இயற்பியல் உள்ளீடுகளிலிருந்து என்ட்ரோபி";
"onboarding.carousel.entropy.title" = "முழுக் கட்டுப்பாட்டிலுள்ள சீரற்ற தன்மையை உருவாக்குங்கள்.";
"onboarding.carousel.entropy.message" = "பகடையை உருட்டுங்கள், நாணயத்தைச் சுண்டுங்கள், அல்லது சீரற்ற இலக்கங்களைப் பதிவு செய்யுங்கள். Oath உங்கள் இயற்பியல் உள்ளீட்டை 24-சொல் மீட்பு சொற்றொடருக்கான 256-பிட் என்ட்ரோபியாக மாற்றுகிறது—முழுவதும் உங்கள் சாதனத்திலேயே.";
"onboarding.carousel.entropy.visual.output" = "பயனர் உருவாக்கிய 256 பிட் என்ட்ரோபி";
"onboarding.carousel.entropy.visual.local" = "நீங்கள் பதிவுசெய்த உள்ளீடுகளிலிருந்து முழுவதுமாக உருவாக்கப்பட்டது";
"onboarding.carousel.entropy.visual.accessibility" = "எண்ணிடப்பட்ட பகடை, ஒரு நாணயம் மற்றும் சீரற்ற இலக்கங்கள் இணைந்து இந்தச் சாதனத்தில் 256 பிட் வாலெட் என்ட்ரோபியை உருவாக்குகின்றன.";
"onboarding.carousel.entropy.learn_more.action" = "கூடுதல் விவரங்களை அறியவும்";
"onboarding.entropy.learn_more.navigation" = "இயற்பியல் என்ட்ரோபி செயல்படும் விதம்";
"onboarding.entropy.learn_more.path.section" = "இயற்பியல் முடிவுகளிலிருந்து மீட்புச் சொற்கள் வரை";
"onboarding.entropy.learn_more.overview" = "நீங்கள் தேர்ந்தெடுத்த இயற்பியல் மூலத்தின் முடிவுகளை Oath பதிவுசெய்து, அவற்றை 256 பிட் மதிப்பாக மாற்றுகிறது. அதன் விளைவான 32 பைட்டுகள், நிலையான BIP-39 மீட்புச் சொற்றொடரை உருவாக்க Wallet Core-க்கு அனுப்பப்படுகின்றன.";
"onboarding.entropy.learn_more.visual.phrase" = "24 சொற்கள் கொண்ட BIP-39 மீட்புச் சொற்றொடர்";
"onboarding.entropy.learn_more.visual.bits" = "32 பைட்டுகள் × 8 பிட்கள் என்பது 256 பிட்கள்";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 பைட்டுகளாக அமைக்கப்பட்ட 256 மாதிரி பிட் கலங்களின் கட்டம்.";
"onboarding.entropy.learn_more.visual.accessibility" = "பகடை உருட்டல்கள், நாணயச் சுண்டல்கள் அல்லது சீரற்ற இலக்கங்கள் 256 பிட்களாகவும், பின்னர் 24 சொற்கள் கொண்ட BIP-39 மீட்புச் சொற்றொடராகவும் மாற்றப்படுகின்றன.";
"onboarding.entropy.learn_more.inputs.section" = "படி 1: இயற்பியல் முடிவுகளைப் பதிவுசெய்யவும்";
"onboarding.entropy.learn_more.inputs.dice.title" = "சமவாய்ப்புள்ள ஆறு பக்கப் பகடையை உருட்டவும்";
"onboarding.entropy.learn_more.inputs.dice.detail" = "சமவாய்ப்புள்ள பகடையில், 1–4 முகங்கள் ஒவ்வொன்றும் 2 பிட்களையும், 5–6 முகங்கள் ஒவ்வொன்றும் 1 பிட்டையும் வழங்குகின்றன.";
"onboarding.entropy.learn_more.inputs.coin.title" = "நாணயத்தைச் சுண்டவும்";
"onboarding.entropy.learn_more.inputs.coin.detail" = "சமவாய்ப்புள்ள நாணயத்தின் ஒன்றையொன்று சாராத ஒவ்வொரு சுண்டலும் சார்பற்ற 1 பிட் என்ட்ரோபியை வழங்குகிறது.";
"onboarding.entropy.learn_more.inputs.digits.title" = "சீரற்ற இலக்கங்களைப் பதிவுசெய்யவும்";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0-7 இலக்கங்கள் ஒவ்வொன்றும் 3 பிட்கள் பங்களிக்கின்றன. 8-9 இலக்கங்கள் ஒவ்வொன்றும் 1 பிட் பங்களிக்கின்றன. இலக்கங்கள் உண்மையான சீரற்ற இயற்பியல் செயல்முறையிலிருந்து வர வேண்டும்.";
"onboarding.entropy.learn_more.inputs.footer" = "நியாயமான மூலத்தைப் பயன்படுத்தி, ஒவ்வொரு முடிவையும் வரிசையாகப் பதிவு செய்யவும். ஒவ்வொரு ஏற்றுக்கொள்ளப்பட்ட பங்களிப்பும் ஒரே பிட் ஸ்ட்ரீமில் சேருவதால் நீங்கள் முறைகளை மாற்றலாம்.";
"onboarding.entropy.learn_more.conversion.section" = "2. சரியாக 256 பிட்களை உருவாக்கவும்";
"onboarding.entropy.learn_more.conversion.mapping" = "பகடை முடிவுகளையும் தசம இலக்கங்களையும் சார்பற்ற இரண்டின் அடுக்கு குழுக்களாக Oath மாற்றுகிறது. வழங்கப்படும் பிட்களின் எண்ணிக்கை மாறலாம்; ஆனால் சமவாய்ப்புள்ள இயற்பியல் மூலம் எந்த பிட் மதிப்புக்கும் சாதகமாக அமையாது.";
"onboarding.entropy.learn_more.conversion.packing" = "சரியாக 256 பிட்கள் சேகரிக்கப்படும் வரை, உள்ளிட்ட வரிசையில் Oath அவற்றைச் சேர்க்கிறது. பின்னர், மதிப்புமிக்க பிட் முதலில் வருமாறு அவற்றை 32 பைட்டுகளாகப் பொதிக்கிறது.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "தனிப்பயன் என்ட்ரோபியில் நீங்கள் பதிவுசெய்யும் இயற்பியல் உள்ளீடுகள் மட்டுமே இடம்பெறும்; சாதனம் உருவாக்கும் சீரற்ற தன்மையை Oath அதனுடன் கலப்பதில்லை.";
"onboarding.entropy.learn_more.bip39.section" = "3. மீட்புச் சொற்றொடரைப் பெறவும்";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 பிட் என்ட்ரோபி";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8 பிட் BIP-39 சரிபார்ப்புக் கூட்டுத்தொகை";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 பிட்கள், 11 பிட்கள் கொண்ட 24 சொல் சுட்டுகளாகப் பிரிக்கப்படுகின்றன";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-பிட் என்ட்ரோபி மதிப்பு மற்றும் 8-பிட் செக்சம் 264 பிட்களை உருவாக்குகிறது, அவை ஒவ்வொன்றும் 11 பிட்கள் கொண்ட 24 வார்த்தை குறியீடுகளாகப் பிரிக்கப்படுகின்றன.";
"onboarding.entropy.learn_more.bip39.checksum" = "32 பைட் என்ட்ரோபி மதிப்புக்கு BIP-39, SHA-256-ஐக் கணக்கிட்டு, ஹாஷின் முதல் 8 பிட்களைச் சரிபார்ப்புக் கூட்டுத்தொகையாக எடுத்துக்கொள்கிறது. அதைச் சேர்த்தவுடன் மொத்தம் 264 பிட்கள் கிடைக்கின்றன.";
"onboarding.entropy.learn_more.bip39.words" = "264 பிட்கள், தலா 11 பிட்கள் கொண்ட 24 குழுக்களாகப் பிரிக்கப்படுகின்றன. ஒவ்வொரு குழுவும் நிலையான 2,048 சொற்கள் கொண்ட BIP-39 பட்டியலில் ஓர் உள்ளீட்டைத் தேர்ந்தெடுத்து, 24 சொற்கள் கொண்ட மீட்புச் சொற்றொடரை உருவாக்குகிறது.";
"onboarding.entropy.learn_more.bip39.derivation" = "கிடைக்கும் seed-இலிருந்து Wallet Core நிர்ணயிக்கப்பட்ட கணக்குகளையும் முகவரிகளையும் பெறுகிறது. அதே மீட்புச் சொற்றொடரும் விருப்பக் கடவுச்சொற்றொடரும் எப்போதும் அதே வாலெட்டை மீண்டும் உருவாக்கும்.";
"onboarding.entropy.learn_more.security.section" = "இது எவ்வாறு பாதுகாப்பை மேம்படுத்த முடியும்";
"onboarding.entropy.learn_more.security.space.title" = "ஒரு பரந்த சாத்தியக்கூறு இடம்";
"onboarding.entropy.learn_more.security.space.detail" = "சீரான 256-பிட் என்ட்ரோபி 2^256 சாத்தியமான மதிப்புகளைக் கொண்டுள்ளது, இது முழுமையான யூகத்தை சாத்தியமற்றதாக ஆக்குகிறது. இது உள்ளீட்டு இடத்தை விவரிக்கிறது; ஒவ்வொரு கிரிப்டோகிராஃபிக் கூறுகளும் 256-பிட் தாக்குதல் எதிர்ப்பைக் கொண்டிருப்பதாகக் கூறவில்லை.";
"onboarding.entropy.learn_more.security.source.title" = "நீங்கள் வழங்கும் சீரற்ற தன்மை";
"onboarding.entropy.learn_more.security.source.detail" = "சாதனத்தின் சீரற்ற எண் உருவாக்கியை மட்டுமே சார்ந்திருக்காமல், வாலெட்டின் சீரற்ற தன்மைக்கான மூலத்தை இயற்பியல் நிகழ்வுகள் மூலம் நீங்களே தனியாக வழங்கலாம். அந்த நிகழ்வுகள் உண்மையாகவே சீரற்றவையாக இருந்தால் மட்டுமே இது பாதுகாப்பை மேம்படுத்தும்.";
"onboarding.entropy.learn_more.security.local.title" = "முழுவதும் இந்தச் சாதனத்திலேயே செயலாக்கப்படும்";
"onboarding.entropy.learn_more.security.local.detail" = "பதிவுசெய்த வரிசையை Oath மாற்றி, மீட்புச் சொற்றொடரை முழுவதும் இந்தச் சாதனத்திலேயே உருவாக்குகிறது. செயலாக்குவதற்காக உங்கள் வரிசை ஒருபோதும் பதிவேற்றப்படாது.";
"onboarding.entropy.learn_more.security.patterns.title" = "மனிதர்கள் தேர்ந்தெடுக்கும் ரகசியங்களைத் தவிர்க்கவும்";
"onboarding.entropy.learn_more.security.patterns.detail" = "ஒரு நபர் தேர்ந்தெடுத்த பிறந்தநாள்கள், விருப்ப எண்கள், மீண்டும் நிகழும் வடிவங்கள் அல்லது சொற்களை விட, நியாயமான மற்றும் ஒன்றுக்கொன்று சாராத நிகழ்வுகளின் நீண்ட வரிசையை கணிப்பது மிகவும் கடினம்.";
"onboarding.entropy.learn_more.security.footer" = "இயற்பியல் என்ட்ரோபி, சாதனம் உருவாக்கும் வாலெட் சீரற்ற தன்மைக்குப் பதிலாகப் பயன்படுத்தப்படுகிறது; இது கூடுதல் கடவுச்சொல்லோ பாதுகாப்பு அடுக்கோ அல்ல.";
"onboarding.entropy.learn_more.safety.section" = "பாதுகாப்பாக பயன்படுத்தவும்";
"onboarding.entropy.learn_more.safety.fair.title" = "சமவாய்ப்புள்ள, ஒன்றையொன்று சாராத முடிவுகளைப் பதிவுசெய்யவும்";
"onboarding.entropy.learn_more.safety.fair.detail" = "சமவாய்ப்புள்ள நாணயம் அல்லது பகடையைப் பயன்படுத்தி, ஒவ்வொரு முடிவும் மற்றவற்றைச் சாராமல் இருப்பதை உறுதிசெய்யவும். சீரற்ற இலக்கங்கள் நினைவிலிருந்தோ ஒரு வடிவத்திலிருந்தோ அல்லாமல், உண்மையான இயற்பியல் மூலத்திலிருந்து வர வேண்டும்.";
"onboarding.entropy.learn_more.safety.private.title" = "உங்கள் என்ட்ரோபி செயல்முறையைத் தனிப்பட்டதாக வைத்திருக்கவும்";
"onboarding.entropy.learn_more.safety.private.detail" = "பதிவுசெய்த வரிசையையும் முடிக்கப்பட்ட மீட்புச் சொற்றொடரையும் வாலெட் ரகசியங்களாகப் பாதுகாக்கவும். கேமராக்களும் பிற நபர்களும் அவற்றைப் பார்க்காதபடி வைத்திருக்கவும்.";
"onboarding.entropy.learn_more.safety.accurate.title" = "ஒவ்வொரு முடிவையும் துல்லியமாக பதிவு செய்யவும்";
"onboarding.entropy.learn_more.safety.accurate.detail" = "ஒரு முடிவு விடுபட்டாலும், இருமுறை பதிவானாலும் அல்லது வரிசை மாறினாலும் வேறொரு வாலெட் உருவாகும். ஒவ்வொரு உள்ளீட்டையும் மதிப்பாய்வு செய்து, வாலெட்டில் நிதி சேர்ப்பதற்கு முன் முடிக்கப்பட்ட மீட்புச் சொற்றொடரைச் சரிபார்க்கவும்.";
"onboarding.entropy.learn_more.safety.backup.title" = "மீட்பு சொற்றொடரைப் பாதுகாக்கவும்";
"onboarding.entropy.learn_more.safety.backup.detail" = "மீட்புச் சொற்றொடரை இணைய இணைப்பில்லாமல் சேமித்து, அதை ஒருபோதும் பகிர வேண்டாம். காப்புப்பிரதியைச் சரிபார்த்த பிறகு, உங்களுக்குத் தேவையில்லாத எந்த இடைநிலை உள்ளீட்டுப் பதிவையும் பாதுகாப்பாக அழிக்கவும்.";
"onboarding.entropy.learn_more.safety.footer" = "வெளிப்பட்ட மீட்புச் சொற்றொடர், பாதுகாப்பிழந்த சாதனம், தீங்கிழைக்கும் மென்பொருள் அல்லது தவறாகப் பதிவான வரிசை ஆகியவற்றிலிருந்து இயற்பியல் என்ட்ரோபியால் பாதுகாக்க முடியாது. சமவாய்ப்புள்ள, தனிப்பட்ட, துல்லியமான உள்ளீடுகளை உறுதிசெய்ய முடியாவிட்டால், நிலையான வாலெட் உருவாக்க முறையைப் பயன்படுத்தவும்.";
"onboarding.carousel.open_source.eyebrow" = "வடிவமைப்பிலேயே திறந்த மூலமாக";
"onboarding.carousel.open_source.title" = "மூலத்தை ஆய்வுசெய்யுங்கள். Build-ஐச் சரிபாருங்கள்.";
"onboarding.carousel.open_source.message" = "தனித்த ஆய்வுக்காக Oath தனது மூலக் குறியீட்டை வெளியிடுகிறது. மீண்டும் உருவாக்கக்கூடிய build, வெளியிடப்பட்ட செயலியின் fingerprint-உடன் பொருந்தினால் மட்டுமே வெளியீடு சரிபார்க்கப்பட்டதாகும்.";
"onboarding.carousel.open_source.action.github" = "GitHub-இல் பார்க்கவும்";
"onboarding.carousel.open_source.visual.repository" = "பொது மூலக் குறியீட்டு களஞ்சியம்";
"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture ஐப் பார்க்கவும்";
"onboarding.carousel.open_source.visual.source" = "மூலக் குறியீட்டை ஆய்வு செய்யவும்";
"onboarding.carousel.open_source.visual.rebuild" = "வெளியீட்டு build-ஐ மீண்டும் உருவாக்கவும்";
"onboarding.carousel.open_source.visual.compare" = "முடிவுகளை ஒப்பிடவும்";
"onboarding.carousel.open_source.visual.fingerprint" = "வெளியிடப்பட்ட வெளியீட்டு டிஜிட்டல் கைரேகை";
"onboarding.carousel.open_source.visual.match" = "பொருத்தம் உறுதிசெய்யப்பட்டது — BUILD சரிபார்க்கப்பட்டது";
"onboarding.carousel.open_source.visual.accessibility" = "வெளியீட்டைச் சரிபார்க்கப் பொது மூலக் குறியீடு, தனித்த build மறுஉருவாக்கம், பொருந்தும் fingerprint-கள் தேவை என்பதைக் காட்டும் வரைபடம்.";
"onboarding.carousel.passphrase.eyebrow" = "விருப்பமான BIP-39 கடவுச்சொற்றொடர்";
"onboarding.carousel.passphrase.title" = "ஒரு மீட்புச் சொற்றொடர். ஒரு கூடுதல் ரகசியம்.";
"onboarding.carousel.passphrase.message" = "BIP-39 கடவுச்சொற்றொடர் உங்கள் மீட்புச் சொற்றொடருடன் இணைந்து தனி வாலெட்டைப் பெறுகிறது. மீட்புச் சொற்கள் வெளிப்பட்டாலும், அந்த வாலெட்டை அணுகத் துல்லியமான கடவுச்சொற்றொடர் தேவை.";
"onboarding.carousel.passphrase.visual.phrase" = "உங்கள் 24 மீட்புச் சொற்கள்";
"onboarding.carousel.passphrase.visual.passphrase" = "உங்கள் இரகசிய கடவுச்சொற்றொடர்";
"onboarding.carousel.passphrase.visual.output" = "தனித்த கடவுச்சொற்றொடர் வாலெட்";
"onboarding.carousel.passphrase.visual.requirement" = "மீட்பதற்கு இரண்டு ரகசியங்களும் தேவை";
"onboarding.carousel.passphrase.visual.accessibility" = "24 சொற்கள் கொண்ட மீட்புச் சொற்றொடரும் ரகசிய BIP-39 கடவுச்சொற்றொடரும் இணைந்து தனி வாலெட்டைப் பெறுகின்றன; அதை மீட்க இரண்டு ரகசியங்களும் தேவை.";
"onboarding.carousel.passphrase.learn_more.action" = "கூடுதல் விவரங்களை அறியவும்";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 கடவுச்சொற்றொடர்களைப் புரிந்துகொள்ளுங்கள்";
"onboarding.passphrase.learn_more.path.section" = "இரண்டு ரகசியங்கள் ஒரு வாலெட்டைப் பெறுகின்றன";
"onboarding.passphrase.learn_more.overview" = "BIP-39 கடவுச்சொற்றொடர் என்பது உங்கள் மீட்புச் சொற்றொடருடன் இணையும் விருப்பமான ரகசியம். மீட்புச் சொற்றொடர் மட்டும் உருவாக்கும் வாலெட்டிலிருந்து மாறுபட்ட வாலெட்டை இவை இரண்டும் நிர்ணயிக்கப்பட்ட விதத்தில் பெறுகின்றன.";
"onboarding.passphrase.learn_more.visual.phrase" = "24-வார்த்தை மீட்பு சொற்றொடர்";
"onboarding.passphrase.learn_more.visual.passphrase" = "இரகசிய கடவுச்சொற்றொடர்";
"onboarding.passphrase.learn_more.visual.wallet" = "கடவுச்சொற்றொடரால் பாதுகாக்கப்பட்ட வாலெட்";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 சொற்கள் கொண்ட மீட்புச் சொற்றொடரும் ரகசியக் கடவுச்சொற்றொடரும் இணைந்து, கடவுச்சொற்றொடரால் பாதுகாக்கப்பட்ட தனி வாலெட்டைப் பெறுகின்றன.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 வாலெட்டைப் பெறும் விதம்";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "மீட்பு சொற்றொடர் + கடவுச்சொற்றொடர்";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2,048 சுற்றுகள்";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512 பிட் முதன்மை seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "பெறப்பட்ட வாலெட் கணக்குகளும் முகவரிகளும்";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "உங்கள் மீட்புச் சொற்றொடரும் கடவுச்சொற்றொடரும் PBKDF2-HMAC-SHA512 வழியாக 2,048 சுற்றுகள் செயலாக்கப்பட்டு 512 பிட் seed-ஐ உருவாக்குகின்றன; அதிலிருந்து வாலெட் கணக்குகளும் முகவரிகளும் பெறப்படுகின்றன.";
"onboarding.passphrase.learn_more.derivation.standard" = "இயல்பாக்கப்பட்ட மீட்புச் சொற்றொடரை PBKDF2 password ஆகவும், \"mnemonic\" என்பதைத் தொடர்ந்து இயல்பாக்கப்பட்ட கடவுச்சொற்றொடர் வருவதை salt ஆகவும் BIP-39 பயன்படுத்துகிறது. PBKDF2-HMAC-SHA512-இன் 2,048 சுற்றுகளுக்குப் பிறகு, 64 பைட் seed உருவாகிறது.";
"onboarding.passphrase.learn_more.derivation.normalization" = "seed-ஐப் பெறுவதற்கு முன், BIP-39 தேவைப்படுத்தும் Unicode இயல்பாக்கத்தை Oath பயன்படுத்துகிறது. எனவே ஒரே இயல்பாக்கப்பட்ட மீட்புச் சொற்றொடரும் கடவுச்சொற்றொடரும் எப்போதும் அதே வாலெட்டை மீண்டும் உருவாக்கும்.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "கடவுச்சொற்றொடர் உங்கள் மீட்புச் சொற்களைக் குறியாக்காது. அது பெறப்படும் seed-ஐ மாற்றுவதால், ஒவ்வொரு வெவ்வேறு கடவுச்சொற்றொடரும் வெவ்வேறு கணக்குகளையும் முகவரிகளையும் உருவாக்கும்.";
"onboarding.passphrase.learn_more.wallets.section" = "ஒவ்வொரு கடவுச்சொற்றொடரும் தனி வாலெட்டைப் பெறுகிறது";
"onboarding.passphrase.learn_more.wallets.visual.one" = "எடுத்துக்காட்டு கடவுச்சொற்றொடர் 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "எடுத்துக்காட்டு கடவுச்சொற்றொடர் 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "எடுத்துக்காட்டு வாலெட் A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "எடுத்துக்காட்டு வாலெட் B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "ஒரே மீட்புச் சொற்றொடருடன் இரண்டு வெவ்வேறு கடவுச்சொற்றொடர்களை இணைத்தால், வாலெட் A மற்றும் வாலெட் B என்ற இரண்டு தனி வாலெட்டுகள் பெறப்படுகின்றன.";
"onboarding.passphrase.learn_more.wallets.different" = "பொருளுள்ள ஓர் எழுத்தை மாற்றினாலும் வேறொரு seed-உம், அதன் விளைவாக வேறொரு வாலெட்டும் பெறப்படும்; அசல் வாலெட் மாறாது.";
"onboarding.passphrase.learn_more.wallets.empty" = "வெற்றுக் கடவுச்சொற்றொடர், மீட்புச் சொற்றொடர் மட்டுமே பெறும் நிலையான வாலெட்டைத் திறக்கும்; காலியாக இல்லாத கடவுச்சொற்றொடர் அதற்குரிய தனி வாலெட்டைத் திறக்கும்.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39-இல் \"தவறான கடவுச்சொற்றொடர்\" என்ற பதில் இல்லை. ஒவ்வொரு கடவுச்சொற்றொடரும் செல்லுபடியாகும்; எனவே எழுத்துப்பிழை எந்த எச்சரிக்கையும் இன்றி மற்றொரு வாலெட்டைத் திறக்கும்—பொதுவாக இருப்பு ஏதுமில்லாத வாலெட்டை.";
"onboarding.passphrase.learn_more.security.section" = "இது எவ்வாறு பாதுகாப்பைச் சேர்க்கிறது";
"onboarding.passphrase.learn_more.security.words.title" = "மீட்புச் சொற்கள் மட்டும் போதாது";
"onboarding.passphrase.learn_more.security.words.detail" = "உங்கள் மீட்புச் சொற்றொடரை மட்டும் பெறும் ஒருவருக்கு, பாதுகாக்கப்பட்ட வாலெட்டைப் பெற்று அணுக இன்னும் துல்லியமான கடவுச்சொற்றொடர் தேவை.";
"onboarding.passphrase.learn_more.security.strength.title" = "பாதுகாப்பு வலிமையிலிருந்து வருகிறது";
"onboarding.passphrase.learn_more.security.strength.detail" = "ஒரு நீண்ட, கணிக்க முடியாத கடவுச்சொற்றொடர் அர்த்தமுள்ள யூகச் சிரமத்தைச் சேர்க்கிறது. ஒரு சிறிய மேற்கோள், பிறந்த நாள், பெயர் அல்லது மீண்டும் பயன்படுத்தப்பட்ட கடவுச்சொல் ஆகியவை விரைவாக யூகிக்கப்படலாம் மற்றும் சிறிய பாதுகாப்பை வழங்குகிறது.";
"onboarding.passphrase.learn_more.security.separation.title" = "கடவுச்சொற்றொடரைத் தனியாக வைத்திருக்கவும்";
"onboarding.passphrase.learn_more.security.separation.detail" = "வாலெட்டை மீட்கத் தேவையான இரண்டு ரகசியங்களும் ஒரே திருடப்பட்ட காப்புப்பிரதியில் வெளிப்படாதபடி, கடவுச்சொற்றொடரை மீட்புச் சொற்றொடரிலிருந்து தனியாகச் சேமிக்கவும்.";
"onboarding.passphrase.learn_more.security.footer" = "இரண்டு ரகசியங்களும் வெளிப்பட்டால், கடவுச்சொற்றொடர் பலவீனமாக இருந்தால் அல்லது நீங்கள் தட்டச்சிடும்போது பாதுகாப்பிழந்த மென்பொருள் அதைப் பதிவுசெய்தால், கடவுச்சொற்றொடரால் உங்கள் நிதியைப் பாதுகாக்க முடியாது.";
"onboarding.passphrase.learn_more.safety.section" = "பாதுகாப்பாக பயன்படுத்தவும்";
"onboarding.passphrase.learn_more.safety.strong.title" = "வலுவான, தனித்துவமான கடவுச்சொற்றொடரைத் தேர்ந்தெடுக்கவும்";
"onboarding.passphrase.learn_more.safety.strong.detail" = "இந்த வாலெட்டிற்கே உரிய பல சீரற்ற சொற்களையோ, அதிக என்ட்ரோபி கொண்ட வேறொரு மதிப்பையோ தேர்ந்தெடுக்கவும். தனிப்பட்ட தகவல்கள், பழக்கமான சொற்றொடர்கள், வடிவங்கள், வேறு இடங்களில் பயன்படுத்திய கடவுச்சொற்கள் ஆகியவற்றைத் தவிர்க்கவும்.";
"onboarding.passphrase.learn_more.safety.backup.title" = "தனித்தனியாக காப்புப்பிரதி எடுக்கவும்";
"onboarding.passphrase.learn_more.safety.backup.detail" = "சரியான கடவுச்சொற்றொடரின் நீடித்த ஆஃப்லைன் காப்புப்பிரதியை உருவாக்கி, மீட்பு சொற்றொடரிலிருந்து தனித்தனியாக சேமிக்கவும். நினைவாற்றலை மட்டும் சார்ந்திருக்காதீர்கள்.";
"onboarding.passphrase.learn_more.safety.exact.title" = "ஒவ்வோர் எழுத்தும் வாலெட்டை மாற்றும்";
"onboarding.passphrase.learn_more.safety.exact.detail" = "ஒவ்வொரு பெரிய எழுத்து, இடைவெளி, நிறுத்தற்குறி, சொல் உட்பட உருவாக்கியபடியே கடவுச்சொற்றொடரை மீண்டும் உள்ளிடவும். எந்த வேறுபாடும் எச்சரிக்கையின்றி மற்றொரு வாலெட்டைப் பெறும்.";
"onboarding.passphrase.learn_more.safety.verify.title" = "நிதி சேர்ப்பதற்கு முன் மீட்பைச் சரிபார்க்கவும்";
"onboarding.passphrase.learn_more.safety.verify.detail" = "கணிசமான நிதியைப் பெறுவதற்கு முன், மீட்புச் சொற்றொடரும் கடவுச்சொற்றொடரும் எதிர்பார்த்த முகவரிகளை மீண்டும் உருவாக்குகின்றனவா என்பதைத் தனிப்பட்ட, கட்டுப்படுத்தப்பட்ட மீட்புச் சோதனையில் உறுதிசெய்யவும்.";
"onboarding.passphrase.learn_more.safety.footer" = "இழந்த கடவுச்சொற்றொடரை எந்தச் சேவையாலும் மீட்டமைக்கவோ மீட்கவோ முடியாது. மீட்புச் சொற்றொடர் உங்களிடம் இருந்தாலும், சரியான கடவுச்சொற்றொடர் இல்லையெனில் அந்த வாலெட்டிற்கான அணுகலை நிரந்தரமாக இழப்பீர்கள்.";
