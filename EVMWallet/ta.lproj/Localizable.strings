"settings.reset.learn_more.backup.message" = "மீட்டமைப்பதற்கு முன், மீண்டும் தேவைப்படக்கூடிய ஒவ்வொரு வாலெட்டையும் காப்பெடுக்கவும். ஒவ்வொரு மீட்புச் சொற்றொடர், தனிப்பட்ட விசை, தேவையான BIP-39 கடவுச்சொற்றொடர் ஆகியவற்றைச் சரிபார்க்கவும் அல்லது Apple passkey மூலம் குறியாக்கப்பட்ட ஒவ்வொரு iCloud காப்புப்பிரதியும் கிடைப்பதையும் மீட்டெடுக்கக்கூடியதையும் உறுதிசெய்யவும்.";
"settings.reset.learn_more.backup.section" = "மீட்டமைப்பதற்கு முன் ஒவ்வொரு வாலெட்டையும் காப்பெடுக்கவும்";
"settings.reset.learn_more.navigation" = "செயலித் தரவை அழிப்பதற்கு முன்";
"settings.reset.learn_more.next.message" = "நீங்கள் தொடர்ந்ததும், அங்கீகரிக்குமாறு Oath கேட்கக்கூடும். பின்னர் அறிமுகத் திரைக்குத் திரும்புவதற்கு முன், இந்தச் சாதனத்திலிருந்து ஒவ்வொரு வாலெட், அதன் ரகசியம், பாதுகாப்பு அமைப்பு, அறிவிப்பு அமைப்பு, தற்காலிகச் சேமிப்பிலுள்ள உள்ளூர்ப் பதிவையும் நீக்கும். உங்கள் iPhone-உம் Apple passkey மூலம் குறியாக்கப்பட்ட iCloud வாலெட் காப்புப்பிரதிகளும் அழிக்கப்படாது.";
"settings.reset.learn_more.next.section" = "அடுத்து என்ன நடக்கும்";
"settings.reset.learn_more.no_backup.message" = "மென்பொருள் வாலெட்டிற்குப் பயன்படுத்தக்கூடிய மீட்புச் சொற்றொடர், தனிப்பட்ட விசை, தேவையான BIP-39 கடவுச்சொற்றொடர் அல்லது மீட்டெடுக்கக்கூடிய குறியாக்கப்பட்ட iCloud காப்புப்பிரதி எதுவும் இல்லையெனில், இந்தச் சாதனத்தின் நகலை நீக்குவது அந்த வாலெட்டிற்கும் அதன் நிதிக்கும் உங்களுக்குள்ள அணுகலை நிரந்தரமாக அகற்றக்கூடும். Oath-ஆல் அதை உங்களுக்காக மீட்க முடியாது.";
