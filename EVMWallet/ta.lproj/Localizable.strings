"settings.about.history.v354.build53.electrum" = "பழைய மற்றும் மறைகுறியாக்கப்பட்ட வடிவங்கள் உட்பட ஆதரிக்கப்படும் ஒற்றைக் கையொப்ப Electrum கோப்புகளை, அசல் பெறுதல்/மீதித்தொகை முகவரிகள் மற்றும் தனிப்பயன் பெறுவிப்புப் பாதைகளைத் தக்கவைத்து மீட்டெடுங்கள்.";
"settings.about.history.v354.build53.discovery" = "BRD முகவரி தேர்வு, இருப்பு மற்றும் பரிவர்த்தனை கண்டறிதல், அனுப்புதல் மற்றும் சாவி ஏற்றுமதியை ஆதரிக்கிறது. இறக்குமதி செய்யப்பட்ட சாவித் தொகுப்புகள் பெறுதல்/மீதித்தொகை முகவரி கண்டறிதலையும் கலப்பு உள்ளீடுகளைக் கொண்டு செலவிடுவதையும் ஆதரிக்கின்றன.";
"settings.about.history.v354.build53.backup" = "ஏற்றுமதி செய்யும்போதும், மறைகுறியாக்கப்பட்ட iCloud காப்புப்பிரதிகளை மீட்டெடுக்கும்போதும், புதிய சாதனத்திற்கு மாற்றும்போதும் இறக்குமதி செய்யப்பட்ட Bitcoin தொகுப்புகளின் அனைத்துச் சாவிகளும் பாதுகாக்கப்படும்.";

