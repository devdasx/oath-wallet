"settings.about.history.v358.arc.title" = "Arc നെറ്റ്‌വർക്ക്";
"settings.about.history.v358.arc" = "ഫീസ് USDC-യിൽ അടയ്ക്കുന്ന Circle-ന്റെ നെറ്റ്‌വർക്കായ Arc ഇപ്പോൾ സ്വീകരിക്കൽ, അയയ്ക്കൽ, ബാലൻസുകൾ, പ്രവർത്തനം എന്നിവയ്ക്ക് പിന്തുണയ്ക്കുന്നു, ഒപ്പം EURC, Circle Wrapped Bitcoin, മറ്റ് Arc ടോക്കണുകളും. കൈമാറ്റങ്ങൾ സ്ഥിരീകരിക്കാൻ ഫീസ് നെറ്റ്‌വർക്കിന്റെ കുറഞ്ഞ പരിധിക്ക് മുകളിൽ നിലനിൽക്കുന്നു.";
"settings.about.history.v358.stocks.title" = "ടോക്കണൈസ്ഡ് സ്റ്റോക്കുകൾ";
"settings.about.history.v358.stocks" = "BNB Smart Chain-ലെ ടോക്കണൈസ്ഡ് യുഎസ് സ്റ്റോക്കുകളും ETF-കളുമായ Binance bStocks-ന് സ്വീകരിക്കുക, അയയ്ക്കുക എന്നിവയിൽ സ്വന്തം bStocks ഫിൽട്ടർ ഉണ്ട്, അവയുടെ ഫീസ് അടയ്ക്കുന്ന നാണയമായ BNB-ക്ക് ശേഷം പട്ടികപ്പെടുത്തിയിരിക്കുന്നു. അവയുടെ വരികൾ bStocks, BNB എന്നീ രണ്ട് ബാഡ്ജുകളും കാണിക്കുന്നു.";
"settings.about.history.v358.backup" = "സ്വകാര്യ കീ എക്സ്പോർട്ട് സ്ക്രീനുകൾ iCloud ബാക്കപ്പ് വരിയുമായി വിന്യസിച്ചിരിക്കുന്നു, സ്വീകരണ സ്ക്രീനിന്റെ QR കാർഡ് പങ്കിടുന്നു, എല്ലായിടത്തും തുല്യ അകലത്തോടെ.";
"settings.about.history.v358.reliability" = "ആപ്പ് അപ്‌ഡേറ്റ് ചെയ്യുമ്പോൾ ഇപ്പോൾ ടോക്കൺ പട്ടിക ഉടൻ പുതുക്കുന്നു, അതിനാൽ അവസാന അപ്‌ഡേറ്റിനു ശേഷം ചേർത്ത നെറ്റ്‌വർക്കുകളും ടോക്കണുകളും വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യാതെ ദൃശ്യമാകും. പട്ടിക ഈ പതിപ്പ് പിന്തുണയ്ക്കുന്ന നെറ്റ്‌വർക്കുകൾ മാത്രമേ ഡൗൺലോഡ് ചെയ്യൂ, Arc-ലെ നേറ്റീവ് USDC കൈമാറ്റം പ്രവർത്തനത്തിൽ ഒരിക്കൽ മാത്രമേ ദൃശ്യമാകൂ.";

