// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "സ്ഥിരീകരണ ബട്ടണിനു പകരം സ്ലൈഡ് ചെയ്ത് അയയ്ക്കാം. ദിശ കാണിക്കുന്ന അനിമേഷൻ, സ്പർശ പ്രതികരണം, സുഗമമായ ചലനം എന്നിവ രണ്ടു വായനാദിശകളെയും പിന്തുണയ്ക്കുന്നു. അയയ്ക്കാൻ 90% അല്ലെങ്കിൽ അതിനപ്പുറം വിരൽ വിടുക; റദ്ദാക്കാൻ പിന്നിലേക്ക് നീക്കുക.";
"settings.about.history.v355.build56.activity" = "മണി ചിഹ്നം തീർപ്പാകാത്ത പ്രവർത്തനങ്ങൾ തുറക്കുന്നു. ഇടപാട് ക്യാപ്സ്യൂളുകൾ നില ബാഡ്ജുകൾ കാണിക്കുന്നു; സ്വൈപ്പ് ചെയ്ത് മറയ്ക്കാം. സ്ഥിരീകരണത്തിലുള്ളതും സ്ഥിരീകരിച്ചതുമായ ക്യാപ്സ്യൂളുകൾ 3 സെക്കൻഡിൽ മറയും; സ്ഥിരീകരണം അതേ ദൃശ്യമായ ക്യാപ്സ്യൂൾ പുതുക്കും.";
"settings.about.history.v355.build56.status" = "പിന്തുണയ്ക്കുന്ന എല്ലാ നെറ്റ്‌വർക്കുകളിലും കൂടുതൽ വിശ്വസനീയമായ ഇടപാട് നില, തത്സമയ വിവരങ്ങൾ, അയച്ചശേഷം വേഗത്തിലുള്ള ബാലൻസ് പുതുക്കൽ. ആപ്പ് വീണ്ടും തുറക്കുമ്പോൾ തീർപ്പാകാത്ത ഇടപാടുകളുടെ നിരീക്ഷണം തുടരും.";
"settings.about.history.v355.build56.fees" = "അതേ കൈമാറ്റത്തിന്റെ അവലോകനത്തിലേക്ക് മടങ്ങുമ്പോൾ ലഭിച്ച ഫീസ് നിലനിൽക്കും. ഫീസ് ലോഡിംഗും അക്കൗണ്ടിലെ പണാവശ്യത്തിനുള്ള മുന്നറിയിപ്പുകളും കൂടുതൽ വ്യക്തമാണ്; മതിയായ തുകയുണ്ടെങ്കിൽ സജീവമാക്കൽ അറിയിപ്പുകൾ കാണിക്കില്ല.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin, Dogecoin എന്നിവ ഡസ്റ്റ് പരിധിക്കു താഴെയുള്ള തിരികെ വരുന്ന ബാക്കിത്തുക ഉപയോഗശൂന്യമായ ഔട്ട്പുട്ടാക്കാതെ ഫീസിൽ ചേർക്കുന്നു. അവലോകനത്തിലെ ഫീസ് ഒപ്പിടുമ്പോഴുള്ള ഫീസുമായി പൊരുത്തപ്പെടും.";
"settings.about.history.v355.build56.stability" = "പശ്ചാത്തല ജോലിയിലെ ക്രാഷും വാലറ്റ് പുതുക്കലിന്റെ സമയപരിധി മുന്നറിയിപ്പുകളും പരിഹരിച്ചു. പുതുക്കൽ താൽക്കാലികമായി പരാജയപ്പെട്ടാലും നിലവിലുള്ള വാലറ്റ് വിവരങ്ങൾ ലഭ്യമായിരിക്കും.";
"settings.about.history.v355.build56.backup" = "തുറക്കുമ്പോൾ ശരിയായ തലക്കെട്ടുകളും കുറവ് സന്ദേശങ്ങളുമുള്ള വ്യക്തമായ ബാക്കപ്പ് സ്ക്രീനുകൾ. സ്വകാര്യ കീകളിലേക്കുള്ള പ്രവേശനം ആപ്പ് ലോക്ക് ക്രമീകരണങ്ങൾ പാലിക്കുന്നു. ചെറുതും ഗ്ലാസ് രൂപത്തിലുള്ളതുമായ ഇറക്കുമതി മുന്നറിയിപ്പുകളിൽ മറ്റൊരു വീണ്ടെടുക്കൽ പദസമുച്ചയം തിരഞ്ഞെടുക്കുമ്പോൾ നിരസിച്ച ഇൻപുട്ട് മായ്ക്കും.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "അയയ്ക്കാനുള്ള സ്ലൈഡർ വിട്ടാൽ, അവലോകന സ്ക്രീൻ അടയുന്നതിന് മുമ്പ് ആനിമേഷനുള്ള ടിക്ക് അടയാളം പ്രത്യക്ഷപ്പെടും.";
"settings.about.history.v355.build57.activity" = "പ്രവർത്തന നിരകളിൽ സ്ഥിതി കുറഞ്ഞ കനമുള്ള അക്ഷരങ്ങളിലും തുക ഉപശീർഷകമായും കാണിക്കും. ഇടപാട് വിശദാംശങ്ങൾ തുറക്കാൻ അമ്പടയാളവും ഉണ്ട്.";
"settings.about.history.v355.build57.details" = "നെറ്റ്‌വർക്ക് ഫീസ് ഇപ്പോൾ കൈമാറ്റ സംഗ്രഹത്തിലാണ്. ചുരുങ്ങിയ ലേബലുകളും നെറ്റ്‌വർക്കിനായി ഒറ്റ നിരയും വിശദാംശങ്ങൾ കൂടുതൽ വ്യക്തമാക്കുന്നു.";
"settings.about.history.v355.build57.resume" = "പശ്ചാത്തലത്തിൽ നിന്ന് മടങ്ങുമ്പോൾ തുറന്ന സ്ക്രീനുകളും പാനലുകളും നിലനിൽക്കും. കൈമാറ്റ അവലോകനവും ഇടപാട് വിശദാംശങ്ങളും ഇതിൽ ഉൾപ്പെടുന്നു.";
"settings.about.history.v355.build57.secrets" = "ആപ്പിൽ നിന്ന് 20 സെക്കൻഡ് വിട്ടുനിന്നാൽ വീണ്ടെടുക്കൽ പദസമുച്ചയം, സ്വകാര്യ കീ, പാസ്‌ഫ്രെയ്‌സ് എന്നിവയുടെ സ്ക്രീനുകൾ അടയും. ആപ്പ് ലോക്ക് നിങ്ങളുടെ ക്രമീകരണങ്ങൾ അനുസരിച്ചുതന്നെ പ്രവർത്തിക്കും.";
"settings.about.history.v355.build57.filters" = "നെറ്റ്‌വർക്ക് ഫിൽട്ടറുകളിൽ അൽപ്പം ഉയരമുള്ള സിസ്റ്റം ബട്ടണുകളും ഉള്ളടക്കത്തിനനുസരിച്ചുള്ള വലുപ്പവും നാവിഗേഷൻ ബാറിന് താഴെ തിരുത്തിയ അകലവും ഉപയോഗിക്കുന്നു.";
"settings.about.history.v355.build57.units" = "മൂല്യത്തിനുള്ള പ്രത്യേക നിരകൾ നീക്കി. തുകയും നെറ്റ്‌വർക്ക് ഫീസും ആദ്യം പ്രാദേശിക കറൻസിയിൽ കാണിക്കും; ക്രിപ്‌റ്റോ യൂണിറ്റുകളിലേക്കും തിരിച്ചും മാറാൻ അവയിൽ ടാപ്പ് ചെയ്യുക.";
"wallet.transaction.details.toggle_units" = "യൂണിറ്റുകൾ മാറ്റുക.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "മങ്ങൽ അല്ലെങ്കിൽ വലുപ്പമാറ്റ ഇഫക്റ്റുകളില്ലാതെ ഹോം സ്ക്രീൻ തുറക്കുന്നു. ക്രമീകരണ ബട്ടണിൽ ഇപ്പോൾ ഗിയർ ഐക്കൺ ഉപയോഗിക്കുന്നു.";
"settings.about.history.v355.build58.fields" = "ഇടപാട്, അയയ്ക്കൽ ഫീൽഡുകളിൽ സാധാരണ ടെക്സ്റ്റ് നിറങ്ങൾ ഉപയോഗിക്കുന്നു. സ്ക്രീനോ പാനലോ തുറക്കുന്ന വരികളിൽ മാത്രമേ അമ്പടയാളങ്ങൾ കാണൂ; തുകയും ഫീസും ടാപ്പ് ചെയ്യുമ്പോൾ മുമ്പത്തെപ്പോലെ യൂണിറ്റ് മാറും.";
"settings.about.history.v355.build58.banners" = "പ്രദർശിപ്പിച്ച ശേഷം, സ്ഥിരീകരണം നടക്കുന്നതിന്റെയോ പൂർത്തിയായതിന്റെയോ ബാനറുകൾ 3 സെക്കൻഡിൽ മറയും; മറ്റൊരു സ്ക്രീൻ തുറന്നാലും ഇത് തുടരും. ഇതുവരെ കാണിക്കാത്ത സ്ഥിരീകരണ അറിയിപ്പുകൾ മടങ്ങിവരുമ്പോൾ ദൃശ്യമാകും.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "പരമാവധി തുക അയയ്ക്കുമ്പോഴും, അയയ്ക്കേണ്ട തുക കണക്കാക്കുന്നതിന് മുമ്പ് TRON കൈമാറ്റങ്ങൾ ഇപ്പോൾ സജീവമാക്കൽ, ബാൻഡ്‌വിഡ്ത്ത് ഫീസുകൾക്കുള്ള തുക മാറ്റിവയ്ക്കുന്നു. ഫീസ് കുറച്ച ശേഷമുള്ള ശരിയായ തുക അവലോകന സ്ക്രീനിൽ കാണിക്കുന്നു.";
"settings.about.history.v355.build59.fees" = "സ്വയം നിശ്ചയിക്കുന്ന TRON ഫീസ് ആവശ്യമായ നെറ്റ്‌വർക്ക് ചെലവുകൾ നിറവേറ്റണം. TRX ബാലൻസ് കുറവായിരിക്കുമ്പോൾ ഇപ്പോൾ കൂടുതൽ വ്യക്തമായ മാർഗനിർദേശങ്ങൾ കാണിക്കുന്നു. ടോക്കണുകളുടെ അളവ് മാറില്ല; ഫീസ് TRX-ലാണ് അടയ്ക്കുന്നത്.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "ഒരു പുതിയ സ്വാഗതം";
"settings.about.history.v356.welcome" = "ആനിമേറ്റുചെയ്‌ത കലാസൃഷ്‌ടിയും ഒരു വാലറ്റ് സൃഷ്‌ടിക്കുന്നതിനോ ഇറക്കുമതി ചെയ്യുന്നതിനോ ഉള്ള വ്യക്തമായ ഓപ്ഷനുകളുള്ള ഒരു പുതിയ സ്വാഗത സ്‌ക്രീൻ.";
"settings.about.history.v357.tour.title" = "സ്വാഗത പര്യടനം";
"settings.about.history.v357.tour" = "അഞ്ച് പേജുള്ള പര്യടനം പിന്തുണയ്ക്കുന്ന നെറ്റ്‌വർക്കുകൾ, ഭൗതിക എൻട്രോപ്പി, അയയ്ക്കലും സ്വീകരിക്കലും, സുരക്ഷ, പരിശോധിച്ചുറപ്പിച്ച ബിൽഡുകൾ എന്നിവ പരിചയപ്പെടുത്തുന്നു. പേജ് മാറാൻ സ്വൈപ്പ് ചെയ്യുകയോ കുത്തുകളിൽ ടാപ്പ് ചെയ്യുകയോ ചെയ്യുക; ഭാഷ മാറ്റുന്ന ബട്ടൺ നാവിഗേഷൻ ബാറിലാണ്.";
"settings.about.history.v357.backup" = "വാലറ്റ് സൃഷ്ടിച്ചതിനോ ഇറക്കുമതി ചെയ്തതിനോ പുനഃസ്ഥാപിച്ചതിനോ ശേഷം സ്ക്രീൻ ഉടൻ പ്രത്യക്ഷപ്പെടുന്നു, അതിന്റെ ബാക്കപ്പ് ഓപ്ഷനുകൾ സാധാരണ പട്ടിക ഉപയോഗിക്കുന്നു. iCloud പരിശോധന പശ്ചാത്തലത്തിൽ നടക്കുന്നു; വാലറ്റ് സംരക്ഷിച്ചയുടൻ വാലറ്റ് തുറക്കുക തയ്യാറാകും.";
"settings.about.history.v357.reliability" = "മറഞ്ഞിരിക്കുന്ന റിക്കവറി സ്ക്രീൻ കാലഹരണപ്പെടുമ്പോൾ പശ്ചാത്തലത്തിൽ നിന്ന് മടങ്ങുന്നത് ഇനി സെറ്റപ്പ് സ്ക്രീൻ അടയ്ക്കില്ല; എല്ലാ ഡാറ്റയും മായ്ക്കുമ്പോൾ സ്വാഗത സ്ക്രീൻ നേരിട്ട് തുറക്കും.";
"settings.about.history.v357.notifications" = "അറിയിപ്പ് ക്രമീകരണങ്ങൾ വിഭാഗങ്ങൾക്കും നിലയ്ക്കും സാങ്കേതിക വിശദാംശങ്ങളില്ലാതെ ലളിതമായ വാക്കുകൾ ഉപയോഗിക്കുന്നു.";
"settings.about.history.v357.wallets" = "സ്വിച്ചറിൽ വാലറ്റുകൾ ദീർഘനേരം അമർത്തി സിസ്റ്റത്തിന്റെ ഉയർത്തൽ ആനിമേഷനോടെ പുനഃക്രമീകരിക്കുക; വരിയിൽ ടാപ്പ് ചെയ്താൽ അത് സജീവമാകും. റിക്കവറി ഫ്രേസ് പരിശോധന ഓരോ വാക്കിനും നമ്പർ നൽകുന്നു, Return അടുത്ത ഫീൽഡിലേക്ക് നീങ്ങുന്നു.";
"settings.about.history.v357.send" = "കൈമാറ്റം നടക്കുമ്പോൾ അയയ്ക്കൽ തുക കാണിക്കുന്നു, അയയ്ക്കാനാകുന്നില്ലെങ്കിൽ കൂടുതൽ വ്യക്തമായ സന്ദേശം ദൃശ്യമാകുന്നു, താൽക്കാലിക പ്രൊവൈഡർ പിശകുകൾക്കു ശേഷം TRON അഭ്യർത്ഥനകൾ സ്വയമേവ വീണ്ടും ശ്രമിക്കുന്നു.";
"settings.about.history.v357.security" = "ഉടമ അനുമതി മറ്റൊരു കീയിലേക്ക് മാറ്റിയ ഇറക്കുമതി ചെയ്ത TRON അക്കൗണ്ടുകൾ ഓരോ അനുമതിയിലും ഒരൊറ്റ കീ മാത്രമുള്ളപ്പോഴും ഇപ്പോൾ മുന്നറിയിപ്പ് കാണിക്കുകയും അയയ്ക്കാനാകാതെ വരികയും ചെയ്യുന്നു. വെളിപ്പെട്ടതായി അറിയപ്പെടുന്ന കൂടുതൽ റിക്കവറി ഫ്രേസുകളും സ്വകാര്യ കീകളും ഇറക്കുമതി സമയത്ത് നിരസിക്കപ്പെടുന്നു.";
"settings.about.history.v356.localization" = "പിന്തുണയ്ക്കുന്ന എല്ലാ ഭാഷകളിലും സ്വാഗത സ്ക്രീനിലെ വാചകങ്ങൾ കൂടുതൽ സ്വാഭാവികവും വ്യക്തവുമാക്കി.";
"settings.about.history.v356.pricing" = "ടോക്കൺ വിലകൾ ഇപ്പോൾ കൃത്യമായ നെറ്റ്‌വർക്കും ടോക്കൺ വിലാസവുമായി പൊരുത്തപ്പെടുന്നു, ആദ്യം DEX വിലകൾ ഉപയോഗിക്കുന്നു. ചെറിയ വിലകൾ റൗണ്ട് ചെയ്യാതെ 8 ദശാംശ സ്ഥാനങ്ങൾ വരെ കാണിക്കുന്നു.";
"settings.about.history.v356.appearance" = "പ്രാഥമിക, ദ്വിതീയ ബട്ടണുകൾ ഇപ്പോൾ സ്ഥിരമായ ഉയരങ്ങളും സ്‌ക്രീൻ മാർജിനുകളും ഉപയോഗിക്കുന്നു, പ്രാഥമിക പ്രവർത്തനങ്ങൾക്ക് സിസ്റ്റം നീല.";
"settings.about.history.v356.transactions" = "ഇടപാട് വിശദാംശങ്ങൾ, തീയതികൾ, വിലാസങ്ങൾ, തുകകൾ, ഇടപാട് ഐഡികൾ എന്നിവയ്‌ക്കായി ഹ്രസ്വമായ സ്ഥിരീകരിച്ച സ്റ്റാറ്റസും വ്യക്തമായ ചാരനിറത്തിലുള്ള ടെക്‌സ്‌റ്റും ഉപയോഗിക്കുന്നു.";
"settings.about.history.v356.security" = "ഇമ്പോർട്ടുചെയ്യാൻ കഴിയാത്ത അറിയപ്പെടുന്ന വീണ്ടെടുക്കൽ ശൈലികളുടെയും സ്വകാര്യ കീകളുടെയും ലിസ്റ്റ് വിപുലീകരിച്ചു.";

