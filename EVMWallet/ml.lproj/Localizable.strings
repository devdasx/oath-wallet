"onboarding.carousel.entropy.message" = "പകിട എറിയുക, നാണയം ടോസ് ചെയ്യുക, അല്ലെങ്കിൽ ക്രമരഹിത അക്കങ്ങൾ രേഖപ്പെടുത്തുക. 24 വാക്കുകളുള്ള വീണ്ടെടുക്കൽ വാക്യത്തിനായി നിങ്ങളുടെ ഭൗതിക ഇൻപുട്ട് കൃത്യമായി 256 ബിറ്റ് എൻട്രോപ്പിയാക്കി Oath പൂർണ്ണമായും ഈ ഉപകരണത്തിൽ മാറ്റുന്നു.";
"onboarding.carousel.entropy.visual.output" = "ഉപയോക്താവ് സൃഷ്ടിച്ച 256 ബിറ്റ് എൻട്രോപ്പി";
"onboarding.carousel.entropy.visual.local" = "നിങ്ങൾ രേഖപ്പെടുത്തിയ ഇൻപുട്ടുകളിൽ നിന്നു മാത്രം സൃഷ്ടിച്ചത്";
"onboarding.carousel.entropy.visual.accessibility" = "അക്കമിട്ട പകിടയും നാണയവും ക്രമരഹിത അക്കങ്ങളും ചേർന്ന് ഈ ഉപകരണത്തിൽ 256 ബിറ്റ് വാലറ്റ് എൻട്രോപ്പി സൃഷ്ടിക്കുന്നു.";
"onboarding.carousel.entropy.learn_more.action" = "കൂടുതലറിയുക";
"onboarding.entropy.learn_more.navigation" = "ഭൗതിക എൻട്രോപ്പി പ്രവർത്തിക്കുന്ന വിധം";
"onboarding.entropy.learn_more.path.section" = "ഭൗതിക ഫലങ്ങളിൽ നിന്ന് വീണ്ടെടുക്കൽ വാക്കുകളിലേക്ക്";
"onboarding.entropy.learn_more.overview" = "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഭൗതിക ഉറവിടത്തിലെ ഫലങ്ങൾ Oath രേഖപ്പെടുത്തി അവയെ 256 ബിറ്റ് മൂല്യമാക്കി മാറ്റുന്നു. തുടർന്ന് ലഭിക്കുന്ന 32 ബൈറ്റുകൾ ഒരു സാധാരണ BIP-39 വീണ്ടെടുക്കൽ വാക്യം സൃഷ്ടിക്കാൻ Wallet Core-ലേക്ക് കൈമാറുന്നു.";
"onboarding.entropy.learn_more.visual.phrase" = "24 വാക്കുകളുള്ള BIP-39 വീണ്ടെടുക്കൽ വാക്യം";
"onboarding.entropy.learn_more.visual.bits" = "32 ബൈറ്റുകൾ × 8 ബിറ്റുകൾ = 256 ബിറ്റുകൾ";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 ബൈറ്റുകളായി ക്രമീകരിച്ച 256 മാതൃകാ ബിറ്റ് സെല്ലുകളുടെ ഗ്രിഡ്.";
"onboarding.entropy.learn_more.visual.accessibility" = "പകിട ഫലങ്ങളോ നാണയ ടോസുകളോ ക്രമരഹിത അക്കങ്ങളോ 256 ബിറ്റുകളായും തുടർന്ന് 24 വാക്കുകളുള്ള BIP-39 വീണ്ടെടുക്കൽ വാക്യമായും മാറുന്നു.";
"onboarding.entropy.learn_more.inputs.section" = "ഘട്ടം 1: ഭൗതിക ഫലങ്ങൾ രേഖപ്പെടുത്തുക";
"onboarding.entropy.learn_more.inputs.dice.title" = "നിഷ്പക്ഷമായ ആറുമുഖ പകിട എറിയുക";
"onboarding.entropy.learn_more.inputs.dice.detail" = "നിഷ്പക്ഷമായ പകിടയിൽ 1–4 വരെയുള്ള ഓരോ മുഖവും 2 ബിറ്റും 5–6 വരെയുള്ള ഓരോ മുഖവും 1 ബിറ്റും നൽകുന്നു.";
"onboarding.entropy.learn_more.inputs.coin.title" = "ഭൗതിക നാണയ ടോസുകൾ";
"onboarding.entropy.learn_more.inputs.coin.detail" = "നിഷ്പക്ഷവും സ്വതന്ത്രവുമായ ഓരോ നാണയ ടോസും പക്ഷപാതമില്ലാത്ത 1 ബിറ്റ് എൻട്രോപ്പി നൽകുന്നു.";
"onboarding.entropy.learn_more.inputs.digits.title" = "ക്രമരഹിത അക്കങ്ങൾ രേഖപ്പെടുത്തുക";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0-7 അക്കങ്ങൾ ഓരോന്നും 3 ബിറ്റുകൾ സംഭാവന ചെയ്യുന്നു. 8-9 അക്കങ്ങൾ ഓരോന്നും 1 ബിറ്റ് സംഭാവന ചെയ്യുന്നു. അക്കങ്ങൾ യഥാർത്ഥമായി ക്രമരഹിതമായ ശാരീരിക പ്രക്രിയയിൽ നിന്നായിരിക്കണം.";
"onboarding.entropy.learn_more.inputs.footer" = "നിഷ്പക്ഷമായ ഭൗതിക ഉറവിടം ഉപയോഗിച്ച് ഓരോ ഫലവും ക്രമത്തിൽ രേഖപ്പെടുത്തുക. സ്വീകരിക്കുന്ന ഓരോ ഫലവും ഒരേ ബിറ്റ് സ്ട്രീമിലേക്ക് ചേരുന്നതിനാൽ ഇൻപുട്ട് രീതികൾ മാറ്റാം.";
"onboarding.entropy.learn_more.conversion.section" = "2. കൃത്യമായി 256 ബിറ്റുകൾ നിർമ്മിക്കുക";
"onboarding.entropy.learn_more.conversion.mapping" = "പകിട ഫലങ്ങളെയും ദശാംശ അക്കങ്ങളെയും പക്ഷപാതമില്ലാത്ത രണ്ടിന്റെ ഘാത ഗ്രൂപ്പുകളാക്കി Oath മാറ്റുന്നു. ലഭിക്കുന്ന ബിറ്റുകളുടെ എണ്ണം മാറാം; എന്നാൽ ഭൗതിക ഉറവിടം നിഷ്പക്ഷമാണെങ്കിൽ ഒരു ബിറ്റ് മൂല്യത്തിനും മുൻഗണന ലഭിക്കില്ല.";
"onboarding.entropy.learn_more.conversion.packing" = "കൃത്യമായി 256 ബിറ്റ് ശേഖരിക്കുന്നതുവരെ നൽകിയ ക്രമത്തിൽ Oath അവ ചേർക്കുകയും ഏറ്റവും പ്രാധാന്യമുള്ള ബിറ്റ് ആദ്യം എന്ന ക്രമത്തിൽ 32 ബൈറ്റുകളാക്കി പാക്ക് ചെയ്യുകയും ചെയ്യുന്നു.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "ഇഷ്ടാനുസൃത എൻട്രോപ്പിയിൽ നിങ്ങൾ രേഖപ്പെടുത്തുന്ന ഭൗതിക ഇൻപുട്ടുകൾ മാത്രമേ ഉണ്ടാകൂ; ഉപകരണം സൃഷ്ടിക്കുന്ന ക്രമരഹിതത Oath അതിൽ ചേർക്കില്ല.";
"onboarding.entropy.learn_more.bip39.section" = "3. വീണ്ടെടുക്കൽ വാക്യം ഉരുത്തിരിക്കുക";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256-ബിറ്റ് എൻട്രോപ്പി";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-ബിറ്റ് BIP-39 ചെക്ക്സം";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 ബിറ്റുകളെ 11 ബിറ്റ് വീതമുള്ള 24 വാക്ക് സൂചികകളായി വിഭജിക്കുന്നു";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "ഒരു 256-ബിറ്റ് എൻട്രോപ്പി മൂല്യവും ഒരു 8-ബിറ്റ് ചെക്ക്‌സം 264 ബിറ്റുകളും സൃഷ്ടിക്കുന്നു, അത് 11 ബിറ്റുകൾ വീതമുള്ള 24 പദ സൂചികകളായി വിഭജിക്കുന്നു.";
"onboarding.entropy.learn_more.bip39.checksum" = "32 ബൈറ്റ് എൻട്രോപ്പി മൂല്യത്തിന്റെ SHA-256 ഹാഷ് BIP-39 കണക്കാക്കി ആദ്യ 8 ഹാഷ് ബിറ്റുകൾ ചെക്ക്സമായി എടുക്കുന്നു. ആ ചെക്ക്സം ചേർക്കുമ്പോൾ ആകെ 264 ബിറ്റ് ലഭിക്കുന്നു.";
"onboarding.entropy.learn_more.bip39.words" = "264 ബിറ്റുകളെ 11 ബിറ്റ് വീതമുള്ള 24 ഗ്രൂപ്പുകളായി വിഭജിക്കുന്നു. ഓരോ ഗ്രൂപ്പും സാധാരണ 2,048 വാക്കുകളുള്ള BIP-39 പട്ടികയിൽ നിന്ന് ഒരു എൻട്രി തിരഞ്ഞെടുത്ത് 24 വാക്കുകളുള്ള വീണ്ടെടുക്കൽ വാക്യം സൃഷ്ടിക്കുന്നു.";
"onboarding.entropy.learn_more.bip39.derivation" = "ലഭിക്കുന്ന സീഡിൽ നിന്ന് Wallet Core നിർണിത അക്കൗണ്ടുകളും വിലാസങ്ങളും ഉരുത്തിരിക്കുന്നു. അതേ വീണ്ടെടുക്കൽ വാക്യവും ഐച്ഛിക പാസ്‌ഫ്രെയ്‌സും എല്ലായ്പ്പോഴും അതേ വാലറ്റ് പുനഃസൃഷ്ടിക്കും.";
"onboarding.entropy.learn_more.security.section" = "ഇത് എങ്ങനെ സുരക്ഷ മെച്ചപ്പെടുത്താം";
"onboarding.entropy.learn_more.security.space.title" = "വിശാലമായ സാധ്യതയുള്ള ഇടം";
"onboarding.entropy.learn_more.security.space.detail" = "ഏകീകൃത 256-ബിറ്റ് എൻട്രോപ്പിക്ക് 2^256 സാധ്യമായ മൂല്യങ്ങളുണ്ട്, ഇത് സമഗ്രമായ ഊഹത്തെ അപ്രായോഗികമാക്കുന്നു. ഇത് ഇൻപുട്ട് സ്പേസ് വിവരിക്കുന്നു; എല്ലാ ക്രിപ്‌റ്റോഗ്രാഫിക് ഘടകത്തിനും 256-ബിറ്റ് ആക്രമണ പ്രതിരോധം ഉണ്ടെന്ന് അത് അവകാശപ്പെടുന്നില്ല.";
"onboarding.entropy.learn_more.security.source.title" = "നിങ്ങൾ നൽകുന്ന ക്രമരഹിതത";
"onboarding.entropy.learn_more.security.source.detail" = "ഉപകരണത്തിലെ ക്രമരഹിത-സംഖ്യ ജനറേറ്ററിനെ മാത്രം ആശ്രയിക്കാതെ വാലറ്റിനുള്ള ക്രമരഹിതത സ്വതന്ത്രമായി ലഭ്യമാക്കാൻ ഭൗതിക ഫലങ്ങൾ സഹായിക്കുന്നു. ആ ഫലങ്ങൾ യഥാർഥത്തിൽ ക്രമരഹിതമായിരിക്കുമ്പോൾ മാത്രമേ ഇത് സുരക്ഷ മെച്ചപ്പെടുത്തൂ.";
"onboarding.entropy.learn_more.security.local.title" = "ഈ ഉപകരണത്തിൽ പ്രോസസ്സ് ചെയ്തു";
"onboarding.entropy.learn_more.security.local.detail" = "നിങ്ങൾ രേഖപ്പെടുത്തിയ ശ്രേണി Oath ഈ ഉപകരണത്തിൽ തന്നെ മാറ്റി വീണ്ടെടുക്കൽ വാക്യം സൃഷ്ടിക്കുന്നു. പ്രോസസ്സിങ്ങിനായി ശ്രേണി ഒരിക്കലും അപ്‌ലോഡ് ചെയ്യില്ല.";
"onboarding.entropy.learn_more.security.patterns.title" = "മനുഷ്യർ തിരഞ്ഞെടുക്കുന്ന രഹസ്യങ്ങൾ ഒഴിവാക്കുക";
"onboarding.entropy.learn_more.security.patterns.detail" = "നിഷ്പക്ഷവും സ്വതന്ത്രവുമായ ഫലങ്ങളുടെ നീണ്ട ശ്രേണി, ജന്മദിനങ്ങൾ, ഇഷ്ട നമ്പറുകൾ, ആവർത്തിക്കുന്ന പാറ്റേണുകൾ, ഒരാൾ തിരഞ്ഞെടുക്കുന്ന വാക്കുകൾ എന്നിവയെക്കാൾ വളരെ കുറച്ച് മാത്രമേ പ്രവചിക്കാനാകൂ.";
"onboarding.entropy.learn_more.security.footer" = "ഭൗതിക എൻട്രോപ്പി ഉപകരണം സൃഷ്ടിക്കുന്ന വാലറ്റ് ക്രമരഹിതതയ്ക്ക് പകരമാണ്; അത് അധിക പാസ്‌വേഡോ സുരക്ഷാ പാളിയോ അല്ല.";
"onboarding.entropy.learn_more.safety.section" = "ഇത് സുരക്ഷിതമായി ഉപയോഗിക്കുക";
"onboarding.entropy.learn_more.safety.fair.title" = "നിഷ്പക്ഷവും സ്വതന്ത്രവുമായ ഫലങ്ങൾ രേഖപ്പെടുത്തുക";
"onboarding.entropy.learn_more.safety.fair.detail" = "നിഷ്പക്ഷമായ നാണയമോ പകിടയോ ഉപയോഗിച്ച് ഓരോ ഫലവും മുമ്പത്തേതിൽ നിന്ന് സ്വതന്ത്രമാണെന്ന് ഉറപ്പാക്കുക. ക്രമരഹിത അക്കങ്ങൾ ഓർമ്മയിൽ നിന്നോ പാറ്റേണിൽ നിന്നോ അല്ല, യഥാർഥ ഭൗതിക ഉറവിടത്തിൽ നിന്നായിരിക്കണം.";
"onboarding.entropy.learn_more.safety.private.title" = "മുഴുവൻ പ്രക്രിയയും സ്വകാര്യമായി സൂക്ഷിക്കുക";
"onboarding.entropy.learn_more.safety.private.detail" = "രേഖപ്പെടുത്തിയ ശ്രേണിയും പൂർത്തിയായ വീണ്ടെടുക്കൽ വാക്യവും വാലറ്റ് രഹസ്യങ്ങളായി സംരക്ഷിക്കുക. ക്യാമറകൾക്കും മറ്റുള്ളവർക്കും അവ കാണാനാകാതെ സൂക്ഷിക്കുക.";
"onboarding.entropy.learn_more.safety.accurate.title" = "എല്ലാ ഫലങ്ങളും കൃത്യമായി രേഖപ്പെടുത്തുക";
"onboarding.entropy.learn_more.safety.accurate.detail" = "നഷ്‌ടമായതോ തനിപ്പകർപ്പാക്കിയതോ പുനഃക്രമീകരിക്കപ്പെട്ടതോ ആയ ഫലം മറ്റൊരു വാലറ്റ് സൃഷ്‌ടിക്കുന്നു. വാലറ്റിന് ധനസഹായം നൽകുന്നതിന് മുമ്പ് ഓരോ എൻട്രിയും അവലോകനം ചെയ്യുകയും അന്തിമ വീണ്ടെടുക്കൽ ബാക്കപ്പ് പരിശോധിക്കുകയും ചെയ്യുക.";
"onboarding.entropy.learn_more.safety.backup.title" = "വീണ്ടെടുക്കൽ വാക്യം പരിരക്ഷിക്കുക";
"onboarding.entropy.learn_more.safety.backup.detail" = "വീണ്ടെടുക്കൽ വാക്യം ഓഫ്‌ലൈനായി സൂക്ഷിക്കുക; ഒരിക്കലും പങ്കിടരുത്. ബാക്കപ്പ് പരിശോധിച്ച ശേഷം ഇനി ആവശ്യമില്ലാത്ത ഇടക്കാല ഇൻപുട്ട് രേഖകൾ സുരക്ഷിതമായി നശിപ്പിക്കുക.";
"onboarding.entropy.learn_more.safety.footer" = "പുറത്തായ വീണ്ടെടുക്കൽ വാക്യം, വിട്ടുവീഴ്ച ചെയ്യപ്പെട്ട ഉപകരണം, ദോഷകരമായ സോഫ്‌റ്റ്‌വെയർ, തെറ്റായി രേഖപ്പെടുത്തിയ ശ്രേണി എന്നിവയിൽ നിന്ന് ഭൗതിക എൻട്രോപ്പിക്ക് സംരക്ഷിക്കാനാവില്ല. ഇൻപുട്ടുകൾ നിഷ്പക്ഷവും സ്വകാര്യവും കൃത്യവുമാണെന്ന് ഉറപ്പാക്കാനാകുന്നില്ലെങ്കിൽ സാധാരണ വാലറ്റ് സൃഷ്ടിക്കൽ ഉപയോഗിക്കുക.";
"onboarding.carousel.open_source.eyebrow" = "രൂപകൽപ്പനയിൽ തന്നെ ഓപ്പൺ സോഴ്‌സ്";
"onboarding.carousel.open_source.title" = "സോഴ്‌സ് പരിശോധിക്കുക. ബിൽഡ് സ്ഥിരീകരിക്കുക.";
"onboarding.carousel.open_source.message" = "Oath അതിന്റെ സോഴ്‌സ് കോഡ് എല്ലാവർക്കും പരിശോധിക്കാൻ പ്രസിദ്ധീകരിക്കുന്നു. സ്വതന്ത്രമായി പുനർനിർമ്മിച്ച ബിൽഡിന്റെയും പ്രസിദ്ധീകരിച്ച ബിൽഡിന്റെയും ഡിജിറ്റൽ ഫിംഗർപ്രിന്റുകൾ പൊരുത്തപ്പെടുമ്പോൾ മാത്രമേ റിലീസ് പരിശോധിച്ചതായി കണക്കാക്കൂ.";
