"settings.about.history.v354.build53.imports" = "Bitcoin ഇറക്കുമതിക്ക് കൂടുതൽ വഴികൾ: BIP38, ഹെക്സ് കീകൾ, മിനി കീകൾ, വിപുലീകൃത കീകൾ, സ്വകാര്യ ഡിസ്ക്രിപ്റ്ററുകൾ, wallet.dat, Electrum, TXT, CSV, JSON. പിന്തുണയ്ക്കുന്ന എൻക്രിപ്റ്റ് ചെയ്ത കീകളും ബാക്കപ്പുകളും ഒറ്റ ഘട്ടത്തിൽ ഡീക്രിപ്റ്റ് ചെയ്ത് ഇറക്കുമതി ചെയ്യാം.";
