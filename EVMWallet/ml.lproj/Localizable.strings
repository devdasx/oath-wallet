"onboarding.carousel.open_source.visual.repository" = "പൊതു സോഴ്‌സ്-കോഡ് റിപ്പോസിറ്ററി";
"onboarding.carousel.open_source.visual.repository.path" = "github.com/devdasx/aperture കാണുക";
"onboarding.carousel.open_source.visual.source" = "സോഴ്‌സ് കോഡ് പരിശോധിക്കുക";
"onboarding.carousel.open_source.visual.rebuild" = "ആപ്പ് റിലീസ് പുനർനിർമ്മിക്കുക";
"onboarding.carousel.open_source.visual.compare" = "ബിൽഡ് ആർട്ടിഫാക്റ്റുകൾ താരതമ്യം ചെയ്യുക";
"onboarding.carousel.open_source.visual.fingerprint" = "പ്രസിദ്ധീകരിച്ച റിലീസ് ഫിംഗർപ്രിന്റ്";
"onboarding.carousel.open_source.visual.match" = "പൊരുത്തം സ്ഥിരീകരിച്ചു — ബിൽഡ് പരിശോധിച്ചു";
"onboarding.carousel.open_source.visual.accessibility" = "ഒരു സോഫ്റ്റ്‌വെയർ റിലീസ് പരിശോധിക്കാൻ പൊതു സോഴ്‌സ് കോഡ്, സ്വതന്ത്ര ആപ്പ് പുനർനിർമ്മാണം, പൊരുത്തപ്പെടുന്ന ഡിജിറ്റൽ ഫിംഗർപ്രിന്റുകൾ എന്നിവ ആവശ്യമാണ് എന്ന് കാണിക്കുന്ന ചിത്രം.";
"onboarding.carousel.passphrase.eyebrow" = "ഐച്ഛിക BIP-39 പാസ്‌ഫ്രെയ്‌സ്";
"onboarding.carousel.passphrase.title" = "ഒരു വീണ്ടെടുക്കൽ വാക്യം. ഒരു അധിക രഹസ്യം.";
"onboarding.carousel.passphrase.message" = "നിങ്ങളുടെ വീണ്ടെടുക്കൽ വാക്യത്തോടൊപ്പം ഒരു BIP-39 പാസ്‌ഫ്രെയ്‌സ് ചേർത്ത് വേറൊരു വാലറ്റ് ഉരുത്തിരിക്കുന്നു. വീണ്ടെടുക്കൽ വാക്കുകൾ പുറത്തായാലും ആ വാലറ്റ് തുറക്കാൻ കൃത്യമായ പാസ്‌ഫ്രെയ്‌സ് ആവശ്യമാണ്.";
"onboarding.carousel.passphrase.visual.phrase" = "24 വീണ്ടെടുക്കൽ വാക്കുകൾ";
"onboarding.carousel.passphrase.visual.passphrase" = "നിങ്ങളുടെ അധിക രഹസ്യ പാസ്‌ഫ്രെയ്‌സ്";
"onboarding.carousel.passphrase.visual.output" = "വ്യത്യസ്തമായ പാസ്‌ഫ്രെയ്‌സ് വാലറ്റ്";
"onboarding.carousel.passphrase.visual.requirement" = "വീണ്ടെടുക്കാൻ രണ്ട് രഹസ്യങ്ങളും ആവശ്യമാണ്";
"onboarding.carousel.passphrase.visual.accessibility" = "24-പദ വീണ്ടെടുക്കൽ വാക്യം ഒരു രഹസ്യ BIP-39 പാസ്‌ഫ്രെയ്‌സുമായി സംയോജിപ്പിച്ച് ഒരു പ്രത്യേക വാലറ്റ് സൃഷ്ടിക്കുന്നു, അത് വീണ്ടെടുക്കുന്നതിന് രണ്ട് രഹസ്യങ്ങളും ആവശ്യമാണ്.";
"onboarding.carousel.passphrase.learn_more.action" = "കൂടുതലറിയുക";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 പാസ്‌ഫ്രെയ്‌സുകൾ മനസ്സിലാക്കുക";
"onboarding.passphrase.learn_more.path.section" = "രണ്ട് രഹസ്യങ്ങളിൽ നിന്ന് ഒരു വാലറ്റ്";
"onboarding.passphrase.learn_more.overview" = "വീണ്ടെടുക്കൽ വാക്യത്തോടൊപ്പം ചേർക്കുന്ന ഐച്ഛിക രഹസ്യമാണ് BIP-39 പാസ്‌ഫ്രെയ്‌സ്. ഇവ രണ്ടും ചേർന്ന്, വീണ്ടെടുക്കൽ വാക്യം മാത്രം ഉപയോഗിച്ച് സൃഷ്ടിക്കുന്നതിൽ നിന്ന് വ്യത്യസ്തമായ ഒരു വാലറ്റ് നിർണിതമായി ഉരുത്തിരിക്കുന്നു.";
"onboarding.passphrase.learn_more.visual.phrase" = "24-പദ വീണ്ടെടുക്കൽ വാക്യം";
"onboarding.passphrase.learn_more.visual.passphrase" = "രഹസ്യ പാസ്‌ഫ്രെയ്‌സ്";
"onboarding.passphrase.learn_more.visual.wallet" = "പാസ്‌ഫ്രെയ്‌സ്-സംരക്ഷിത വാലറ്റ്";
"onboarding.passphrase.learn_more.visual.accessibility" = "24 വാക്കുകളുള്ള വീണ്ടെടുക്കൽ വാക്യവും രഹസ്യ പാസ്‌ഫ്രെയ്‌സും ചേർന്ന് പാസ്‌ഫ്രെയ്‌സാൽ സംരക്ഷിച്ച വാലറ്റ് ഉരുത്തിരിക്കുന്നു.";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 എങ്ങനെയാണ് ഇത് ഉപയോഗിക്കുന്നത്";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "വീണ്ടെടുക്കൽ വാക്യം + പാസ്‌ഫ്രെയ്‌സ്";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2,048 റൗണ്ടുകൾ";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512 ബിറ്റ് സീഡ്";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "വാലറ്റ് അക്കൗണ്ടുകളും വിലാസങ്ങളും";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "വീണ്ടെടുക്കൽ വാക്യവും പാസ്‌ഫ്രെയ്‌സും PBKDF2-HMAC-SHA512-ന്റെ 2,048 റൗണ്ടുകളിലൂടെ കടന്ന് വാലറ്റ് അക്കൗണ്ടുകളും വിലാസങ്ങളും ഉരുത്തിരിക്കാനുള്ള 512 ബിറ്റ് സീഡ് സൃഷ്ടിക്കുന്നു.";
"onboarding.passphrase.learn_more.derivation.standard" = "സാധാരണവത്കരിച്ച വീണ്ടെടുക്കൽ വാക്യം PBKDF2 പാസ്‌വേഡായും \"mnemonic\" എന്ന വാക്കിനുശേഷം സാധാരണവത്കരിച്ച പാസ്‌ഫ്രെയ്‌സ് ചേർത്തത് സാൾട്ടായും BIP-39 ഉപയോഗിക്കുന്നു. PBKDF2-HMAC-SHA512-ന്റെ 2,048 റൗണ്ടുകൾക്ക് ശേഷം 64 ബൈറ്റ് സീഡ് ലഭിക്കുന്നു.";
"onboarding.passphrase.learn_more.derivation.normalization" = "സീഡ് ഉരുത്തിരിക്കുന്നതിന് മുമ്പ് BIP-39 ആവശ്യപ്പെടുന്ന Unicode സാധാരണവത്കരണം Oath പ്രയോഗിക്കുന്നു. അതിനാൽ അതേ സാധാരണവത്കരിച്ച വീണ്ടെടുക്കൽ വാക്യവും പാസ്‌ഫ്രെയ്‌സും എല്ലായ്പ്പോഴും അതേ വാലറ്റ് പുനഃസൃഷ്ടിക്കും.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "പാസ്‌ഫ്രെയ്‌സ് വീണ്ടെടുക്കൽ വാക്കുകൾ എൻക്രിപ്റ്റ് ചെയ്യുന്നില്ല. അത് ഉരുത്തിരിക്കുന്ന സീഡ് തന്നെ മാറ്റുന്നതിനാൽ ഓരോ വ്യത്യസ്ത പാസ്‌ഫ്രെയ്‌സും വ്യത്യസ്ത അക്കൗണ്ടുകളും വിലാസങ്ങളും സൃഷ്ടിക്കും.";
"onboarding.passphrase.learn_more.wallets.section" = "ഓരോ പാസ്‌ഫ്രെയ്‌സും വ്യത്യസ്‌തമായ വാലറ്റ് തുറക്കുന്നു";
"onboarding.passphrase.learn_more.wallets.visual.one" = "ഉദാഹരണ പാസ്‌ഫ്രെയ്‌സ് 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "ഉദാഹരണ പാസ്‌ഫ്രെയ്‌സ് 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "ഉദാഹരണ വാലറ്റ് A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "ഉദാഹരണ വാലറ്റ് B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "രണ്ട് വ്യത്യസ്ത പാസ്‌ഫ്രെയ്‌സുകളുള്ള ഒരേ വീണ്ടെടുക്കൽ വാക്യം വാലറ്റ് എയും വാലറ്റ് ബിയും സൃഷ്ടിക്കുന്നു.";
"onboarding.passphrase.learn_more.wallets.different" = "അർഥവത്തായ ഒരു പ്രതീകം പോലും മാറ്റുന്നത് മറ്റൊരു വിത്തും അതിനാൽ മറ്റൊരു വാലറ്റും ലഭിക്കും. യഥാർത്ഥ വാലറ്റ് മാറ്റമില്ലാതെ തുടരുന്നു.";
"onboarding.passphrase.learn_more.wallets.empty" = "ശൂന്യമായ പാസ്‌ഫ്രെയ്‌സ് വീണ്ടെടുക്കൽ വാക്യത്തിൽ നിന്ന് മാത്രം ഉരുത്തിരിയുന്ന സാധാരണ വാലറ്റ് തുറക്കും; ശൂന്യമല്ലാത്ത പാസ്‌ഫ്രെയ്‌സ് അതിന്റേതായ വേറൊരു വാലറ്റ് തുറക്കും.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39-ൽ \"തെറ്റായ പാസ്‌ഫ്രെയ്‌സ്\" എന്ന പ്രതികരണമില്ല. എല്ലാ പാസ്‌ഫ്രെയ്‌സും സാധുവായതിനാൽ ഒരു അക്ഷരത്തെറ്റ് അറിയിപ്പില്ലാതെ മറ്റൊരു വാലറ്റ് തുറക്കും—സാധാരണയായി പൂജ്യം ബാലൻസുള്ളത്.";
"onboarding.passphrase.learn_more.security.section" = "ഇത് എങ്ങനെ സംരക്ഷണം ചേർക്കുന്നു";
"onboarding.passphrase.learn_more.security.words.title" = "വീണ്ടെടുക്കൽ വാക്കുകൾ മതിയാവില്ല";
"onboarding.passphrase.learn_more.security.words.detail" = "നിങ്ങളുടെ വീണ്ടെടുക്കൽ വാക്യം മാത്രം ലഭിച്ച ഒരാൾക്ക് സംരക്ഷിത വാലറ്റ് ഉരുത്തിരിക്കാനും തുറക്കാനും കൃത്യമായ പാസ്‌ഫ്രെയ്‌സ് കൂടി ആവശ്യമാണ്.";
"onboarding.passphrase.learn_more.security.strength.title" = "സുരക്ഷ ശക്തിയിൽ നിന്ന് വരുന്നു";
"onboarding.passphrase.learn_more.security.strength.detail" = "നീളമുള്ളതും പ്രവചിക്കാനാകാത്തതുമായ പാസ്‌ഫ്രെയ്‌സ് ഊഹിക്കാൻ ഗണ്യമായ ബുദ്ധിമുട്ടുണ്ടാക്കും. ചെറിയ ഉദ്ധരണിയോ ജന്മദിനമോ പേരോ വീണ്ടും ഉപയോഗിച്ച പാസ്‌വേഡോ വേഗം ഊഹിക്കപ്പെടാം; അവ വളരെ കുറച്ച് സംരക്ഷണം മാത്രമേ നൽകൂ.";
"onboarding.passphrase.learn_more.security.separation.title" = "പാസ്‌ഫ്രെയ്‌സ് പ്രത്യേകം സൂക്ഷിക്കുക";
"onboarding.passphrase.learn_more.security.separation.detail" = "പാസ്‌ഫ്രെയ്‌സ് വീണ്ടെടുക്കൽ വാക്യത്തിൽ നിന്ന് വേർതിരിച്ച് സൂക്ഷിക്കുക. അങ്ങനെ ഒരൊറ്റ ബാക്കപ്പ് മോഷ്ടിക്കപ്പെട്ടാലും വാലറ്റ് വീണ്ടെടുക്കാൻ ആവശ്യമായ രണ്ട് രഹസ്യങ്ങളും പുറത്താകില്ല.";
"onboarding.passphrase.learn_more.security.footer" = "രണ്ട് രഹസ്യങ്ങളും പുറത്താകുകയോ പാസ്‌ഫ്രെയ്‌സ് ദുർബലമാകുകയോ നൽകുന്ന സമയത്ത് വിട്ടുവീഴ്ച ചെയ്യപ്പെട്ട സോഫ്‌റ്റ്‌വെയർ അത് പിടിച്ചെടുക്കുകയോ ചെയ്താൽ പാസ്‌ഫ്രെയ്‌സിന് ഫണ്ടുകൾ സംരക്ഷിക്കാനാവില്ല.";
"onboarding.passphrase.learn_more.safety.section" = "ഇത് സുരക്ഷിതമായി ഉപയോഗിക്കുക";
"onboarding.passphrase.learn_more.safety.strong.title" = "ശക്തവും അതുല്യവുമായ പാസ്‌ഫ്രെയ്‌സ് തിരഞ്ഞെടുക്കുക";
"onboarding.passphrase.learn_more.safety.strong.detail" = "ക്രമരഹിതമായി തിരഞ്ഞെടുത്ത നിരവധി വാക്കുകൾ അല്ലെങ്കിൽ ഈ വാലറ്റിന് മാത്രം ഉപയോഗിക്കുന്ന മറ്റൊരു ഉയർന്ന എൻട്രോപ്പി മൂല്യം തിരഞ്ഞെടുക്കുക. വ്യക്തിപരമായ വസ്തുതകൾ, പരിചിതമായ ശൈലികൾ, പാറ്റേണുകൾ അല്ലെങ്കിൽ മറ്റെവിടെയെങ്കിലും ഉപയോഗിക്കുന്ന പാസ്‌വേഡ് എന്നിവയെ ആശ്രയിക്കരുത്.";
"onboarding.passphrase.learn_more.safety.backup.title" = "ഇത് പ്രത്യേകം ബാക്കപ്പ് ചെയ്യുക";
"onboarding.passphrase.learn_more.safety.backup.detail" = "കൃത്യമായ പാസ്‌ഫ്രെയ്‌സിന്റെ ദീർഘകാലം നിലനിൽക്കുന്ന ഓഫ്‌ലൈൻ പകർപ്പ് തയ്യാറാക്കി വീണ്ടെടുക്കൽ വാക്യത്തിൽ നിന്ന് വേർതിരിച്ച് സൂക്ഷിക്കുക. ഓർമ്മയെ മാത്രം ആശ്രയിക്കരുത്.";
"onboarding.passphrase.learn_more.safety.exact.title" = "ഓരോ പ്രതീകവും വാലറ്റ് മാറ്റും";
"onboarding.passphrase.learn_more.safety.exact.detail" = "ഓരോ വലിയക്ഷരവും സ്‌പെയ്‌സും വിരാമചിഹ്നവും വാക്കും ഉൾപ്പെടെ പാസ്‌ഫ്രെയ്‌സ് സൃഷ്ടിച്ചതുപോലെ കൃത്യമായി വീണ്ടും നൽകുക. എന്തെങ്കിലും വ്യത്യാസമുണ്ടെങ്കിൽ മുന്നറിയിപ്പില്ലാതെ മറ്റൊരു വാലറ്റ് ഉരുത്തിരിയും.";
"onboarding.passphrase.learn_more.safety.verify.title" = "ഫണ്ടിംഗിന് മുമ്പ് വീണ്ടെടുക്കൽ പരിശോധിക്കുക";
"onboarding.passphrase.learn_more.safety.verify.detail" = "ഗണ്യമായ ഫണ്ടുകൾ സ്വീകരിക്കുന്നതിന് മുമ്പ് സ്വകാര്യവും നിയന്ത്രിതവുമായ വീണ്ടെടുക്കൽ പരിശോധന നടത്തി, വീണ്ടെടുക്കൽ വാക്യവും പാസ്‌ഫ്രെയ്‌സും പ്രതീക്ഷിച്ച വിലാസങ്ങൾ പുനഃസൃഷ്ടിക്കുന്നുവെന്ന് സ്ഥിരീകരിക്കുക.";
"onboarding.passphrase.learn_more.safety.footer" = "നഷ്ടപ്പെട്ട പാസ്‌ഫ്രെയ്‌സ് ഒരു സേവനത്തിനും പുനഃസജ്ജമാക്കാനോ വീണ്ടെടുക്കാനോ കഴിയില്ല. വീണ്ടെടുക്കൽ വാക്യം കൈവശമുണ്ടെങ്കിലും കൃത്യമായ പാസ്‌ഫ്രെയ്‌സ് ഇല്ലെങ്കിൽ ആ വാലറ്റിലേക്കുള്ള പ്രവേശനം ശാശ്വതമായി നഷ്ടപ്പെടും.";
