"settings.about.history.v354.build53.send" = "Bitcoin ഇൻപുട്ടുകൾ കൈയോടെ തിരഞ്ഞെടുക്കുന്നതിലെ പ്രശ്നം പരിഹരിച്ചു. ഫീസ്, തിരികെ ലഭിക്കുന്ന തുക, അന്തിമ ഇടപാട് എന്നിവ കണക്കാക്കുമ്പോൾ തിരഞ്ഞെടുത്ത എല്ലാ ഇൻപുട്ടുകളും ഇപ്പോൾ ഉൾപ്പെടും.";

