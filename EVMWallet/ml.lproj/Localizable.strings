"settings.about.history.v354.build55.interface" = "iOS 27 അനുയോജ്യത, വലത്തുനിന്ന് ഇടത്തേക്കുള്ള വിന്യാസം, സ്വീകർത്താവിനുള്ള സൂചനകൾ, വിവർത്തനങ്ങൾ, കീബോർഡിന്റെ സ്ഥിരത എന്നിവ മെച്ചപ്പെടുത്തി. സ്വീകരിക്കൽ സ്ക്രീൻ Avalanche C-Chain വ്യക്തമാക്കുകയും Stellar, Gram മെമ്മോകൾ വിശദീകരിക്കുകയും ചെയ്യുന്നു. വിക്കിപീഡിയ വിവരണങ്ങൾ നീക്കി.";

"settings.about.history.v354.build55.send" = "അവലോകന സ്ക്രീൻ ഫീസ് പരിശോധിക്കുന്നു, നെറ്റ്‌വർക്കിന്റെ സ്വന്തം കോയിൻ നിക്ഷേപിക്കാൻ അവസരം നൽകുന്നു, ഫീസ് വഹിക്കാൻ അതിന്റെ അയയ്ക്കുന്ന തുക ക്രമീകരിക്കുന്നു. കോയിൻ നിയന്ത്രണത്തിൽ വിലാസ തരങ്ങളും തിരഞ്ഞെടുത്ത ഇൻപുട്ടുകളും കാണാം. Solana ലോഡിംഗ്, Sui കൈമാറ്റങ്ങൾ, പഴയ iOS പതിപ്പുകളിലെ Sui ചരിത്രം എന്നിവ മെച്ചപ്പെടുത്തി.";

"settings.about.history.v354.build55.notifications" = "വിവർത്തനം ചെയ്ത അറിയിപ്പുകൾ നിങ്ങളുടെ മുൻഗണനകൾ പാലിക്കുകയും ആസ്തി ലോഗോകൾ, ക്രമപ്പെടുത്തിയ തുകകൾ, നിലവിലെ സ്ഥിതി, ഇടപാടിന്റെ പൂർണ്ണ വിവരങ്ങൾ എന്നിവ കാണിക്കുകയും ചെയ്യുന്നു.";

