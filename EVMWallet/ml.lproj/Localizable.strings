"settings.about.history.v354.build53.encrypted" = "BIP38 കീകൾ ഒറ്റ ഘട്ടത്തിൽ ഡീക്രിപ്റ്റ് ചെയ്ത് ഇംപോർട്ട് ചെയ്യുക. കംപ്രസ് ചെയ്ത കീകൾ Legacy, Nested SegWit, Native SegWit, Taproot എന്നിവയെ പിന്തുണയ്ക്കുന്നു; കംപ്രസ് ചെയ്യാത്തവ Legacy പിന്തുണയ്ക്കുന്നു.";
"settings.about.history.v354.build53.core" = "എൻക്രിപ്റ്റ് ചെയ്ത പഴയതും ഡിസ്ക്രിപ്റ്റർ അടിസ്ഥാനമാക്കിയതുമായ വാലറ്റുകൾ ഉൾപ്പെടെ പിന്തുണയ്ക്കുന്ന Bitcoin Core wallet.dat ബാക്കപ്പുകൾ പുനഃസ്ഥാപിക്കുക.";
"settings.about.history.v354.build53.electrum" = "പഴയതും എൻക്രിപ്റ്റ് ചെയ്തതുമായ ഫോർമാറ്റുകൾ ഉൾപ്പെടെ പിന്തുണയ്ക്കുന്ന ഒറ്റ ഒപ്പുള്ള Electrum ഫയലുകൾ യഥാർത്ഥ സ്വീകരണ/ബാക്കി തുക വിലാസങ്ങളും ഇഷ്ടാനുസൃത ഡെറിവേഷൻ പാതകളും നിലനിർത്തി പുനഃസ്ഥാപിക്കുക.";
"settings.about.history.v354.build53.discovery" = "BRD വിലാസം തിരഞ്ഞെടുക്കൽ, ബാലൻസും ഇടപാടുകളും കണ്ടെത്തൽ, അയയ്ക്കൽ, കീ എക്സ്പോർട്ട് എന്നിവ പിന്തുണയ്ക്കുന്നു. ഇംപോർട്ട് ചെയ്ത കീ ശേഖരങ്ങൾ സ്വീകരണ/ബാക്കി തുക വിലാസങ്ങൾ കണ്ടെത്തുന്നതും വിവിധ ഇൻപുട്ടുകൾ ചേർത്ത് ചെലവഴിക്കുന്നതും പിന്തുണയ്ക്കുന്നു.";
"settings.about.history.v354.build53.backup" = "എക്സ്പോർട്ട് ചെയ്യുമ്പോഴും എൻക്രിപ്റ്റ് ചെയ്ത iCloud ബാക്കപ്പുകൾ പുനഃസ്ഥാപിക്കുമ്പോഴും പുതിയ ഉപകരണത്തിലേക്ക് മാറ്റുമ്പോഴും ഇംപോർട്ട് ചെയ്ത Bitcoin ശേഖരങ്ങളിലെ എല്ലാ കീകളും നിലനിൽക്കും.";

