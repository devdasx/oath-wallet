// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Schuiven om te verzenden vervangt de bevestigingsknop. Richtingsanimatie, haptiek en soepelere beweging ondersteunen beide leesrichtingen. Laat los bij 90% of verder om te verzenden; schuif terug om te annuleren.";
"settings.about.history.v355.build56.activity" = "De bel opent openstaande activiteit. Transactiecapsules tonen statusbadges en kunnen worden weggeveegd. Capsules voor lopende en voltooide bevestigingen verdwijnen na 3 seconden; bevestiging werkt dezelfde zichtbare capsule bij.";
"settings.about.history.v355.build56.status" = "Betrouwbaardere transactiestatus op alle ondersteunde netwerken, live transactiedetails en snellere saldo-updates na verzending. Openstaande transacties worden bij het heropenen van de app opnieuw gevolgd.";
"settings.about.history.v355.build56.fees" = "Terugkeren naar dezelfde overdrachtscontrole behoudt de opgehaalde kosten. Duidelijker laden van kosten en waarschuwingen over accountfinanciering; bij voldoende bedragen verschijnen geen activeringsmeldingen meer.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin en Dogecoin voegen wisselgeld onder de dustdrempel toe aan de kosten in plaats van een onbruikbare output te maken. De gecontroleerde kosten komen overeen met de ondertekening.";
"settings.about.history.v355.build56.stability" = "Een crash in een achtergrondtaak en time-outmeldingen bij walletverversing zijn verholpen. Bij tijdelijke verversingsfouten blijft bestaande walletinformatie beschikbaar.";
"settings.about.history.v355.build56.backup" = "Overzichtelijkere back-upschermen met direct de juiste titels en minder meldingen. Toegang tot privésleutels volgt de appvergrendeling. Compacte importwaarschuwingen in glasstijl wissen afgewezen invoer wanneer je een andere herstelzin kiest.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Nadat je de schuifregelaar voor verzenden loslaat, verschijnt een geanimeerd vinkje voordat het controlescherm sluit.";
"settings.about.history.v355.build57.activity" = "Activiteitsregels tonen de status in een lichter lettertype, het bedrag als subtitel en een pijl om de transactiedetails te openen.";
"settings.about.history.v355.build57.details" = "Netwerkkosten staan nu in het overdrachtsoverzicht. Kortere labels en één netwerkregel maken de details overzichtelijker.";
"settings.about.history.v355.build57.resume" = "Bij terugkeer uit de achtergrond blijven geopende schermen en panelen behouden, waaronder de overdrachtscontrole en transactiedetails.";
"settings.about.history.v355.build57.secrets" = "Schermen met een herstelzin, privésleutel of wachtwoordzin sluiten na 20 seconden afwezigheid. Het appslot blijft je instellingen volgen.";
"settings.about.history.v355.build57.filters" = "Netwerkfilters gebruiken iets hogere systeemeigen knoppen, passen zich aan de inhoud aan en hebben verbeterde tussenruimte onder de navigatiebalk.";
"settings.about.history.v355.build57.units" = "De afzonderlijke waarderegels zijn verwijderd. Bedrag en netwerkkosten verschijnen eerst in lokale valuta; tik op een van beide om naar crypto-eenheden te wisselen en terug.";
"wallet.transaction.details.toggle_units" = "Eenheden wisselen.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Het beginscherm opent zonder vervaag- of schaaleffect. De knop voor instellingen gebruikt nu een tandwielpictogram.";
"settings.about.history.v355.build58.fields" = "Velden bij transacties en verzenden gebruiken standaardtekstkleuren. Pijlen verschijnen alleen bij rijen die een scherm of paneel openen; tikken op bedragen en kosten wisselt nog steeds de eenheid.";
"settings.about.history.v355.build58.banners" = "Zodra ze zijn getoond, verdwijnen banners voor lopende of voltooide bevestiging na 3 seconden, ook als je een ander scherm opent. Nog niet getoonde bevestigingen verschijnen bij terugkeer.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Bij TRON-overboekingen worden activerings- en bandbreedtekosten nu gereserveerd voordat het te versturen bedrag wordt berekend, ook bij het versturen van het maximum. Het controlescherm toont het juiste bedrag na aftrek van de kosten.";
"settings.about.history.v355.build59.fees" = "Zelf ingestelde TRON-kosten moeten de vereiste netwerkkosten dekken. Bij een laag TRX-saldo verschijnen nu duidelijkere aanwijzingen. Het aantal tokens blijft gelijk; de kosten worden in TRX betaald.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Een nieuw welkom";
"settings.about.history.v356.welcome" = "Een nieuw welkomstscherm met geanimeerde illustraties en duidelijke opties om een portemonnee aan te maken of te importeren.";
"settings.about.history.v357.tour.title" = "Welkomstrondleiding";
"settings.about.history.v357.tour" = "Een rondleiding van vijf pagina’s laat de ondersteunde netwerken, fysieke entropie, verzenden en ontvangen, beveiliging en geverifieerde builds zien. Veeg of tik op de stippen om van pagina te wisselen; de taalkeuze staat in de navigatiebalk.";
"settings.about.history.v357.backup" = "Na het aanmaken, importeren of herstellen van een wallet verschijnt het scherm meteen en gebruiken de back-upopties de standaardlijst. De iCloud-controle loopt op de achtergrond en Open wallet is klaar zodra de wallet is opgeslagen.";
"settings.about.history.v357.reliability" = "Terugkeren vanuit de achtergrond sluit het instelscherm niet meer wanneer een verborgen herstelscherm verloopt, en alle gegevens wissen opent direct het welkomstscherm.";
"settings.about.history.v357.notifications" = "De meldingsinstellingen gebruiken eenvoudigere bewoordingen voor categorieën en status, zonder technische details.";
"settings.about.history.v357.wallets" = "Herschik wallets in de wisselaar met een lange druk en de tilanimatie van het systeem; op een rij tikken activeert die. De controle van de herstelzin nummert elk woord en Return gaat naar het volgende veld.";
"settings.about.history.v357.send" = "Bij verzenden wordt het bedrag getoond zolang de overdracht loopt, verschijnt een duidelijkere melding als het niet kan worden verzonden, en worden TRON-verzoeken na tijdelijke providerfouten automatisch opnieuw geprobeerd.";
"settings.about.history.v357.security" = "Geïmporteerde TRON-accounts waarvan de eigenaarsmachtiging naar een andere sleutel is verplaatst, tonen nu de waarschuwing en kunnen niet verzenden, ook als elke machtiging maar één sleutel vermeldt. Meer bekende blootgestelde herstelzinnen en privésleutels worden bij import geweigerd.";
"settings.about.history.v356.localization" = "De teksten op het welkomstscherm zijn nu duidelijker en natuurlijker in alle ondersteunde talen.";
"settings.about.history.v356.pricing" = "Tokenprijzen komen nu overeen met het exacte netwerk en tokenadres, waarbij eerst DEX-prijzen worden gebruikt. Kleine prijzen worden zonder afronding tot op 8 decimalen weergegeven.";
"settings.about.history.v356.appearance" = "Primaire en secundaire knoppen gebruiken nu consistente hoogtes en schermmarges, met systeemblauw voor primaire acties.";
"settings.about.history.v356.transactions" = "Transactiedetails gebruiken een kortere status Bevestigd en duidelijkere grijze tekst voor datums, adressen, bedragen en transactie-ID's.";
"settings.about.history.v356.security" = "De lijst met bekende blootgestelde herstelzinnen en privésleutels die niet kunnen worden geïmporteerd, is uitgebreid.";

