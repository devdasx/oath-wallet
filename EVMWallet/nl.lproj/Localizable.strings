"onboarding.carousel.wallet.title" = "Eén wallet voor elke handeling.";
"onboarding.carousel.wallet.message" = "Oath biedt je cryptoactiva een moderne thuisbasis die overzichtelijk blijft op alle netwerken, snel reageert en volledig onder jouw controle blijft.";
