"onboarding.carousel.entropy.eyebrow" = "ENTROPIE UIT FYSIEKE INVOER";
"onboarding.carousel.entropy.title" = "Maak willekeur die je volledig beheert.";
"onboarding.carousel.entropy.message" = "Gooi een dobbelsteen, werp een munt op of noteer willekeurige cijfers. Oath zet je fysieke invoer volledig op je apparaat om in exact 256 bits entropie voor een herstelzin van 24 woorden.";
"onboarding.carousel.entropy.visual.output" = "256 bits zelfgegenereerde entropie";
"onboarding.carousel.entropy.visual.local" = "Volledig gegenereerd uit je genoteerde invoer";
"onboarding.carousel.entropy.visual.accessibility" = "Een genummerde dobbelsteen, een munt en willekeurige cijfers vormen samen op dit apparaat 256 bits walletentropie.";
"onboarding.carousel.entropy.learn_more.action" = "Meer details bekijken";
"onboarding.entropy.learn_more.navigation" = "Zo werkt fysieke entropie";
"onboarding.entropy.learn_more.path.section" = "Van fysieke uitkomsten naar herstelwoorden";
"onboarding.entropy.learn_more.overview" = "Oath registreert de uitkomsten van de fysieke bron die je kiest en zet ze om in een waarde van 256 bits. De resulterende 32 bytes worden vervolgens aan Wallet Core doorgegeven om een standaard BIP-39-herstelzin te maken.";
"onboarding.entropy.learn_more.visual.phrase" = "Een BIP-39-herstelzin van 24 woorden";
"onboarding.entropy.learn_more.visual.bits" = "32 bytes × 8 bits is 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Een raster van 256 voorbeeldbitcellen, ingedeeld in 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Dobbelsteenworpen, muntworpen of willekeurige cijfers worden omgezet in 256 bits en daarna in een BIP-39-herstelzin van 24 woorden.";
"onboarding.entropy.learn_more.inputs.section" = "Stap 1: noteer fysieke uitkomsten";
"onboarding.entropy.learn_more.inputs.dice.title" = "Gooi met een eerlijke zeszijdige dobbelsteen";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Bij een eerlijke dobbelsteen leveren de zijden 1–4 elk 2 bits op en de zijden 5–6 elk 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fysieke muntworpen";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Elke eerlijke, onafhankelijke muntworp levert 1 onbevooroordeelde bit entropie op.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Noteer willekeurige cijfers";
"onboarding.entropy.learn_more.inputs.digits.detail" = "De cijfers 0–7 leveren elk 3 bits op en de cijfers 8–9 elk 1 bit. De cijfers moeten uit een werkelijk willekeurig fysiek proces komen.";
"onboarding.entropy.learn_more.inputs.footer" = "Gebruik een eerlijke fysieke bron en noteer elke uitkomst in de juiste volgorde. Je kunt van invoermethode wisselen, want elke geaccepteerde uitkomst draagt bij aan dezelfde bitstroom.";
"onboarding.entropy.learn_more.conversion.section" = "2. Stel een waarde van 256 bits samen";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath zet dobbelsteenuitkomsten en decimale cijfers om in onbevooroordeelde groepen met een macht van 2. Het aantal bijgedragen bits kan verschillen, maar bij een eerlijke fysieke bron krijgt geen enkele bitwaarde de voorkeur.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath voegt de bits in de ingevoerde volgorde toe totdat het er exact 256 heeft verzameld. Daarna worden ze in 32 bytes verpakt, met de meest significante bit eerst.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Aangepaste entropie bevat alleen de fysieke invoer die je noteert. Oath voegt geen door het apparaat gegenereerde willekeur toe.";
"onboarding.entropy.learn_more.bip39.section" = "3. Leid de herstelzin af";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bits entropie";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Een BIP-39-controlesom van 8 bits";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits verdeeld over 24 woordindexen van 11 bits";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Aan een entropiewaarde van 256 bits wordt een controlesom van 8 bits toegevoegd. De resulterende 264 bits worden verdeeld over 24 woordindexen van 11 bits.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 berekent SHA-256 over de entropiewaarde van 32 bytes en gebruikt de eerste 8 hashbits als controlesom. Door die controlesom toe te voegen, ontstaan 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "De 264 bits worden verdeeld in 24 groepen van 11 bits. Elke groep selecteert één vermelding uit de standaard BIP-39-lijst met 2.048 woorden om de herstelzin van 24 woorden te vormen.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core leidt deterministische accounts en adressen af uit de resulterende seed. Met dezelfde herstelzin en optionele wachtwoordzin wordt altijd dezelfde wallet hersteld.";
"onboarding.entropy.learn_more.security.section" = "Hoe aangepaste entropie de beveiliging versterkt";
"onboarding.entropy.learn_more.security.space.title" = "Een enorme ruimte aan mogelijkheden";
"onboarding.entropy.learn_more.security.space.detail" = "Uniforme entropie van 256 bits omvat 2^256 unieke waarden, waardoor uitputtend raden rekenkundig onhaalbaar is. Dit beschrijft de omvang van de invoerruimte en betekent niet dat elk cryptografisch onderdeel weerstand tegen aanvallen van 256 bits biedt.";
"onboarding.entropy.learn_more.security.source.title" = "De willekeur komt van jou";
"onboarding.entropy.learn_more.security.source.detail" = "Met fysieke gebeurtenissen kun je de willekeur voor je wallet zelf leveren, in plaats van uitsluitend op de willekeurgenerator van een apparaat te vertrouwen. Dit verbetert de beveiliging alleen als die gebeurtenissen werkelijk willekeurig zijn.";
"onboarding.entropy.learn_more.security.local.title" = "Volledig op dit apparaat verwerkt";
"onboarding.entropy.learn_more.security.local.detail" = "Oath zet je genoteerde reeks volledig op dit apparaat om en maakt hier de herstelzin. Je reeks wordt nooit geüpload voor verwerking.";
"onboarding.entropy.learn_more.security.patterns.title" = "Vermijd zelfbedachte geheimen";
"onboarding.entropy.learn_more.security.patterns.detail" = "Een lange reeks eerlijke, onafhankelijke gebeurtenissen is veel minder voorspelbaar dan verjaardagen, favoriete getallen, herhaalde patronen of woorden die iemand zelf kiest.";
"onboarding.entropy.learn_more.security.footer" = "Fysieke entropie vervangt de door het apparaat gegenereerde willekeur voor de wallet. Het is geen extra wachtwoord of extra beveiligingslaag.";
"onboarding.entropy.learn_more.safety.section" = "Gebruik deze functie veilig";
"onboarding.entropy.learn_more.safety.fair.title" = "Noteer eerlijke, onafhankelijke uitkomsten";
"onboarding.entropy.learn_more.safety.fair.detail" = "Gebruik een eerlijke munt of dobbelsteen en zorg dat elke uitkomst onafhankelijk is. Willekeurige cijfers moeten uit een echte fysieke bron komen, niet uit je geheugen of een patroon.";
"onboarding.entropy.learn_more.safety.private.title" = "Houd je entropieproces privé";
"onboarding.entropy.learn_more.safety.private.detail" = "Bescherm zowel de genoteerde reeks als de voltooide herstelzin als walletgeheimen. Houd ze buiten beeld van camera's en andere mensen.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Noteer elke uitkomst exact";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Eén ontbrekende, dubbele of anders gerangschikte uitkomst maakt een andere wallet. Controleer elke invoer en verifieer de voltooide herstelzin voordat je crypto naar de wallet stuurt.";
"onboarding.entropy.learn_more.safety.backup.title" = "Bescherm de herstelzin";
"onboarding.entropy.learn_more.safety.backup.detail" = "Bewaar de herstelzin offline en deel deze nooit. Vernietig na verificatie van je back-up op veilige wijze alle tussentijdse invoernotities die je niet meer nodig hebt.";
"onboarding.entropy.learn_more.safety.footer" = "Fysieke entropie beschermt niet tegen een uitgelekte herstelzin, een gehackt apparaat, schadelijke software of een verkeerd genoteerde reeks. Kun je geen eerlijke, privé ingevoerde en nauwkeurige uitkomsten garanderen, kies dan voor de standaardmethode om een wallet te maken.";
"onboarding.carousel.open_source.eyebrow" = "ONTWORPEN ALS OPEN SOURCE";
"onboarding.carousel.open_source.title" = "Inspecteer de bron. Verifieer de build.";
"onboarding.carousel.open_source.message" = "Oath publiceert zijn broncode voor onafhankelijke inspectie. Een appversie is pas geverifieerd als een reproduceerbare build overeenkomt met de vingerafdruk van de gepubliceerde app.";
"onboarding.carousel.open_source.action.github" = "Bekijken op GitHub";
"onboarding.carousel.open_source.visual.repository" = "Openbare bronrepository";
"onboarding.carousel.open_source.visual.repository.path" = "Bekijk github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Inspecteer de broncode";
"onboarding.carousel.open_source.visual.rebuild" = "Reproduceer de releasebuild";
"onboarding.carousel.open_source.visual.compare" = "Vergelijk buildartefacten";
"onboarding.carousel.open_source.visual.fingerprint" = "Gepubliceerde releasevingerafdruk";
"onboarding.carousel.open_source.visual.match" = "OVEREENKOMST BEVESTIGD — BUILD GEVERIFIEERD";
"onboarding.carousel.open_source.visual.accessibility" = "Diagram dat laat zien dat voor verificatie van een appversie openbare broncode, een onafhankelijke nieuwe build en overeenkomende vingerafdrukken nodig zijn.";
"onboarding.carousel.passphrase.eyebrow" = "OPTIONELE BIP-39-WACHTWOORDZIN";
"onboarding.carousel.passphrase.title" = "Eén herstelzin. Eén extra geheim.";
"onboarding.carousel.passphrase.message" = "Een BIP-39-wachtwoordzin wordt met je herstelzin gecombineerd om een aparte wallet af te leiden. Zelfs als de herstelwoorden uitlekken, is voor toegang tot die wallet nog steeds de exacte wachtwoordzin nodig.";
"onboarding.carousel.passphrase.visual.phrase" = "Je 24 herstelwoorden";
"onboarding.carousel.passphrase.visual.passphrase" = "Je extra geheime wachtwoordzin";
"onboarding.carousel.passphrase.visual.output" = "Een afzonderlijke wallet met wachtwoordzin";
"onboarding.carousel.passphrase.visual.requirement" = "Beide geheimen zijn nodig voor herstel";
"onboarding.carousel.passphrase.visual.accessibility" = "Een herstelzin van 24 woorden en een geheime BIP-39-wachtwoordzin leiden een aparte wallet af waarvoor beide geheimen nodig zijn bij herstel.";
"onboarding.carousel.passphrase.learn_more.action" = "Meer details bekijken";
"onboarding.passphrase.learn_more.navigation" = "BIP-39-wachtwoordzinnen begrijpen";
"onboarding.passphrase.learn_more.path.section" = "Twee geheimen leiden één wallet af";
"onboarding.passphrase.learn_more.overview" = "Een BIP-39-wachtwoordzin is een optioneel geheim dat met je herstelzin wordt gecombineerd. Samen leiden ze deterministisch een andere wallet af dan de wallet die alleen uit de herstelzin ontstaat.";
"onboarding.passphrase.learn_more.visual.phrase" = "Je herstelzin van 24 woorden";
"onboarding.passphrase.learn_more.visual.passphrase" = "Je geheime wachtwoordzin";
"onboarding.passphrase.learn_more.visual.wallet" = "Een wallet beveiligd met een wachtwoordzin";
"onboarding.passphrase.learn_more.visual.accessibility" = "Een herstelzin van 24 woorden en een geheime wachtwoordzin worden gecombineerd om een aparte, met een wachtwoordzin beveiligde wallet af te leiden.";
"onboarding.passphrase.learn_more.derivation.section" = "Zo leidt BIP-39 de wallet af";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Herstelzin gecombineerd met wachtwoordzin";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 met 2.048 rondes";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Masterseed van 512 bits";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Afgeleide walletaccounts en -adressen";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Je herstelzin en wachtwoordzin doorlopen 2.048 rondes PBKDF2-HMAC-SHA512 om de seed van 512 bits te maken waaruit walletaccounts en -adressen worden afgeleid.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 gebruikt de genormaliseerde herstelzin als PBKDF2-wachtwoord en “mnemonic”, gevolgd door de genormaliseerde wachtwoordzin, als salt. Na 2.048 rondes PBKDF2-HMAC-SHA512 levert dit proces een seed van 64 bytes op.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Voordat Oath de seed afleidt, past het de door BIP-39 vereiste Unicode-normalisatie toe. Zo leveren dezelfde genormaliseerde herstelzin en wachtwoordzin altijd dezelfde wallet op.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Een wachtwoordzin versleutelt je herstelwoorden niet. De wachtwoordzin wijzigt de afgeleide seed, waardoor elke andere wachtwoordzin andere accounts en adressen oplevert.";
"onboarding.passphrase.learn_more.wallets.section" = "Elke wachtwoordzin leidt een aparte wallet af";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Voorbeeldwachtwoordzin 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Voorbeeldwachtwoordzin 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Voorbeeldwallet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Voorbeeldwallet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Dezelfde herstelzin, gecombineerd met twee verschillende wachtwoordzinnen, leidt twee aparte wallets af: Wallet A en Wallet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Als je zelfs maar één betekenisvol teken wijzigt, ontstaat een andere seed en dus een andere wallet. De oorspronkelijke wallet blijft ongewijzigd.";
"onboarding.passphrase.learn_more.wallets.empty" = "Een lege wachtwoordzin opent de standaardwallet die alleen uit de herstelzin is afgeleid. Een niet-lege wachtwoordzin opent een eigen, aparte wallet.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 geeft geen melding voor een “verkeerde wachtwoordzin”. Elke wachtwoordzin is geldig, dus een typefout opent ongemerkt een andere wallet, meestal met een saldo van nul.";
"onboarding.passphrase.learn_more.security.section" = "Zo biedt een wachtwoordzin extra bescherming";
"onboarding.passphrase.learn_more.security.words.title" = "Alleen herstelwoorden zijn niet genoeg";
"onboarding.passphrase.learn_more.security.words.detail" = "Wie alleen je herstelzin bemachtigt, heeft nog steeds de exacte wachtwoordzin nodig om de beveiligde wallet af te leiden en te openen.";
"onboarding.passphrase.learn_more.security.strength.title" = "Een sterke wachtwoordzin biedt betere scheiding";
"onboarding.passphrase.learn_more.security.strength.detail" = "Een lange, onvoorspelbare wachtwoordzin maakt raden aanzienlijk moeilijker. Een kort citaat, een verjaardag, een naam of een hergebruikt wachtwoord kan snel worden geraden en biedt weinig bescherming.";
"onboarding.passphrase.learn_more.security.separation.title" = "Bewaar de wachtwoordzin apart";
"onboarding.passphrase.learn_more.security.separation.detail" = "Bewaar de wachtwoordzin apart van de herstelzin, zodat één gestolen back-up niet beide geheimen prijsgeeft die nodig zijn om de wallet te herstellen.";
"onboarding.passphrase.learn_more.security.footer" = "Een wachtwoordzin kan je crypto niet beschermen als beide geheimen uitlekken, de wachtwoordzin zwak is of gehackte software de zin tijdens het typen onderschept.";
"onboarding.passphrase.learn_more.safety.section" = "Gebruik deze functie veilig";
"onboarding.passphrase.learn_more.safety.strong.title" = "Maak een sterke, unieke wachtwoordzin";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Kies meerdere willekeurige woorden of een andere waarde met hoge entropie die uniek is voor deze wallet. Vermijd persoonlijke gegevens, bekende zinnen, patronen en wachtwoorden die je elders gebruikt.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Maak apart een back-up van de wachtwoordzin";
