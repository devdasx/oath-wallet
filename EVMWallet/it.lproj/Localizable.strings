"onboarding.carousel.entropy.eyebrow" = "ENTROPIA DA INPUT FISICI";
"onboarding.carousel.entropy.title" = "Genera casualità sotto il tuo pieno controllo.";
"onboarding.carousel.entropy.message" = "Lancia i dadi o una moneta oppure registra cifre casuali. Oath converte l’input fisico in esattamente 256 bit di entropia per una frase di recupero di 24 parole, interamente sul tuo dispositivo.";
"onboarding.carousel.entropy.visual.output" = "256 bit di entropia generata dall’utente";
"onboarding.carousel.entropy.visual.local" = "Generata esclusivamente dagli input registrati";
"onboarding.carousel.entropy.visual.accessibility" = "Un dado numerato, una moneta e alcune cifre casuali si combinano per produrre 256 bit di entropia del portafoglio su questo dispositivo.";
"onboarding.carousel.entropy.learn_more.action" = "Scopri di più";
"onboarding.entropy.learn_more.navigation" = "Come funziona l’entropia fisica";
"onboarding.entropy.learn_more.path.section" = "Dagli esiti fisici alle parole di recupero";
"onboarding.entropy.learn_more.overview" = "Oath registra gli esiti della fonte fisica scelta e li converte in un valore a 256 bit. I 32 byte risultanti vengono quindi passati a Wallet Core per creare una frase di recupero BIP-39 standard.";
"onboarding.entropy.learn_more.visual.phrase" = "Una frase di recupero BIP-39 di 24 parole";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit = 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Una griglia di 256 celle di bit campione disposte in 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "I lanci di dadi o monete e le cifre casuali vengono convertiti in 256 bit e poi in una frase di recupero BIP-39 di 24 parole.";
"onboarding.entropy.learn_more.inputs.section" = "Passaggio 1: registra gli esiti fisici";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lancia un dado a 6 facce non truccato";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Con un dado non truccato, le facce da 1 a 4 apportano 2 bit ciascuna; le facce 5–6 ne apportano 1 ciascuna.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lanci di una moneta reale";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Ogni lancio indipendente di una moneta non truccata apporta 1 bit di entropia privo di distorsioni.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registra cifre casuali";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Le cifre da 0 a 7 apportano 3 bit ciascuna; le cifre 8–9 ne apportano 1 ciascuna. Le cifre devono provenire da un processo fisico realmente casuale.";
"onboarding.entropy.learn_more.inputs.footer" = "Usa una fonte fisica non distorta e registra ogni risultato in ordine. Puoi cambiare metodo di input: ogni risultato accettato contribuisce allo stesso flusso di bit.";
"onboarding.entropy.learn_more.conversion.section" = "2. Componi un valore a 256 bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath converte i risultati dei dadi e le cifre decimali in gruppi non distorti basati su potenze di 2. Le lunghezze dei contributi possono variare, ma con una fonte fisica non distorta nessun valore di bit viene favorito.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath aggiunge i bit nell’ordine di inserimento fino a raccoglierne esattamente 256, quindi li raggruppa in 32 byte partendo dal bit più significativo.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "L’entropia personalizzata contiene solo gli input fisici che registri: Oath non vi aggiunge casualità generata dal dispositivo.";
"onboarding.entropy.learn_more.bip39.section" = "3. Ricava la frase di recupero";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Entropia a 256 bit";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Un checksum BIP-39 a 8 bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit suddivisi in 24 indici di parola da 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "A un valore di entropia di 256 bit viene aggiunto un checksum di 8 bit, ottenendo 264 bit suddivisi in 24 indici di parola da 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 calcola SHA-256 sul valore di entropia di 32 byte e usa i primi 8 bit dell’hash come checksum; aggiungendo il checksum si ottengono 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "I 264 bit vengono suddivisi in 24 gruppi di 11 bit. Ogni gruppo seleziona una voce nell’elenco standard BIP-39 di 2.048 parole, generando la frase di recupero di 24 parole.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core ricava dal seed risultante account e indirizzi deterministici. La stessa frase di recupero e la stessa passphrase facoltativa ricreano sempre lo stesso portafoglio.";
"onboarding.entropy.learn_more.security.section" = "Come l’entropia personalizzata rafforza la sicurezza";
"onboarding.entropy.learn_more.security.space.title" = "Un vasto spazio di possibilità";
"onboarding.entropy.learn_more.security.space.detail" = "L’entropia uniforme a 256 bit comprende 2^256 valori univoci e rende computazionalmente impraticabile provarli tutti. Ciò descrive l’ampiezza dello spazio di input, ma non implica che ogni componente crittografico offra una resistenza agli attacchi di 256 bit.";
"onboarding.entropy.learn_more.security.source.title" = "La casualità proviene da te";
"onboarding.entropy.learn_more.security.source.detail" = "Gli eventi fisici consentono di ottenere la casualità del portafoglio in modo indipendente, senza affidarsi soltanto al generatore di numeri casuali del dispositivo. Questo migliora la sicurezza solo se gli eventi sono realmente casuali.";
"onboarding.entropy.learn_more.security.local.title" = "Elaborazione interamente sul dispositivo";
"onboarding.entropy.learn_more.security.local.detail" = "Oath converte la sequenza registrata e crea la frase di recupero interamente su questo dispositivo. La sequenza non viene mai caricata per l’elaborazione.";
"onboarding.entropy.learn_more.security.patterns.title" = "Evita segreti scelti dall’uomo";
"onboarding.entropy.learn_more.security.patterns.detail" = "Una lunga sequenza di eventi non distorti e indipendenti è molto meno prevedibile di compleanni, numeri preferiti, schemi ripetuti o parole scelte da una persona.";
"onboarding.entropy.learn_more.security.footer" = "L’entropia fisica sostituisce la casualità del portafoglio generata dal dispositivo; non è una password o un livello di sicurezza aggiuntivo.";
"onboarding.entropy.learn_more.safety.section" = "Usa questa funzionalità in sicurezza";
"onboarding.entropy.learn_more.safety.fair.title" = "Registra risultati non distorti e indipendenti";
"onboarding.entropy.learn_more.safety.fair.detail" = "Usa una moneta o un dado non truccati e assicurati che ogni risultato sia indipendente. Le cifre casuali devono provenire da una vera fonte fisica, non dalla memoria o da uno schema.";
"onboarding.entropy.learn_more.safety.private.title" = "Mantieni privato il processo di generazione dell’entropia";
"onboarding.entropy.learn_more.safety.private.detail" = "Proteggi sia la sequenza registrata sia la frase di recupero completa come segreti del portafoglio. Non esporle a telecamere né ad altre persone.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registra ogni risultato in modo accurato";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Un risultato mancante, duplicato o in un ordine diverso crea un altro portafoglio. Controlla ogni voce e verifica la frase di recupero completa prima di aggiungere fondi.";
"onboarding.entropy.learn_more.safety.backup.title" = "Proteggi la frase di recupero";
"onboarding.entropy.learn_more.safety.backup.detail" = "Conserva offline la frase di recupero e non condividerla mai. Dopo aver verificato il backup, distruggi in modo sicuro ogni registrazione intermedia degli input che non ti serve più.";
"onboarding.entropy.learn_more.safety.footer" = "L’entropia fisica non può proteggere una frase di recupero esposta, un dispositivo compromesso, software dannoso o una sequenza registrata in modo errato. Se non puoi garantire input non distorti, privati e accurati, usa la creazione standard del portafoglio.";
"onboarding.carousel.open_source.eyebrow" = "OPEN SOURCE FIN DALLA PROGETTAZIONE";
"onboarding.carousel.open_source.title" = "Esamina il codice sorgente. Verifica la build.";
"onboarding.carousel.open_source.message" = "Oath pubblica il proprio codice sorgente per consentirne l’esame indipendente. Una release è verificata solo quando una build riproducibile corrisponde all’impronta digitale dell’app pubblicata.";
"onboarding.carousel.open_source.action.github" = "Esamina su GitHub";
"onboarding.carousel.open_source.visual.repository" = "Repository pubblico del codice sorgente";
"onboarding.carousel.open_source.visual.repository.path" = "Apri github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Esamina il codice sorgente";
"onboarding.carousel.open_source.visual.rebuild" = "Riproduci la build della release";
"onboarding.carousel.open_source.visual.compare" = "Confronta gli artefatti della build";
"onboarding.carousel.open_source.visual.fingerprint" = "Impronta digitale della release pubblicata";
"onboarding.carousel.open_source.visual.match" = "CORRISPONDENZA CONFERMATA — BUILD VERIFICATA";
"onboarding.carousel.open_source.visual.accessibility" = "Un diagramma mostra che per verificare una release servono il codice sorgente pubblico, una build riprodotta in modo indipendente e impronte digitali corrispondenti.";
"onboarding.carousel.passphrase.eyebrow" = "PASSPHRASE BIP-39 FACOLTATIVA";
"onboarding.carousel.passphrase.title" = "Una frase di recupero. Un segreto in più.";
"onboarding.carousel.passphrase.message" = "Una passphrase BIP-39 si combina con la frase di recupero per generare un portafoglio distinto. Anche se le parole di recupero vengono esposte, per accedere a quel portafoglio serve comunque la passphrase esatta.";
"onboarding.carousel.passphrase.visual.phrase" = "Le tue 24 parole di recupero";
"onboarding.carousel.passphrase.visual.passphrase" = "La tua passphrase segreta aggiuntiva";
"onboarding.carousel.passphrase.visual.output" = "Un portafoglio distinto protetto da passphrase";
"onboarding.carousel.passphrase.visual.requirement" = "Per il recupero servono entrambi i segreti";
"onboarding.carousel.passphrase.visual.accessibility" = "Una frase di recupero di 24 parole e una passphrase segreta BIP-39 generano un portafoglio distinto che richiede entrambi i segreti per il recupero.";
"onboarding.carousel.passphrase.learn_more.action" = "Scopri di più";
"onboarding.passphrase.learn_more.navigation" = "Come funzionano le passphrase BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Due segreti generano un solo portafoglio";
"onboarding.passphrase.learn_more.overview" = "Una passphrase BIP-39 è un segreto facoltativo abbinato alla frase di recupero. Insieme generano in modo deterministico un portafoglio diverso da quello creato con la sola frase di recupero.";
"onboarding.passphrase.learn_more.visual.phrase" = "La tua frase di recupero di 24 parole";
"onboarding.passphrase.learn_more.visual.passphrase" = "La tua passphrase segreta";
"onboarding.passphrase.learn_more.visual.wallet" = "Un portafoglio protetto da passphrase";
"onboarding.passphrase.learn_more.visual.accessibility" = "Una frase di recupero di 24 parole e una passphrase segreta generano un portafoglio distinto protetto da passphrase.";
"onboarding.passphrase.learn_more.derivation.section" = "Come BIP-39 genera il portafoglio";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frase di recupero combinata con la passphrase";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 con 2.048 iterazioni";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Seed principale a 512 bit";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Account e indirizzi derivati del portafoglio";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "La frase di recupero e la passphrase vengono elaborate per 2.048 iterazioni con PBKDF2-HMAC-SHA512, producendo il seed a 512 bit da cui derivano gli account e gli indirizzi del portafoglio.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 usa la frase di recupero normalizzata come password PBKDF2 e, come salt, la parola «mnemonic» seguita dalla passphrase normalizzata. Dopo 2.048 iterazioni di PBKDF2-HMAC-SHA512, il processo produce un seed di 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Prima di ricavare il seed, Oath applica la normalizzazione Unicode richiesta da BIP-39, così la stessa frase di recupero e la stessa passphrase normalizzate riproducono sempre lo stesso portafoglio.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "La passphrase non crittografa le parole di recupero. Modifica il seed derivato, quindi ogni passphrase diversa genera account e indirizzi diversi.";
"onboarding.passphrase.learn_more.wallets.section" = "Ogni passphrase genera un portafoglio distinto";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Passphrase di esempio 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Passphrase di esempio 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Portafoglio A di esempio";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Portafoglio B di esempio";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "La stessa frase di recupero abbinata a due passphrase diverse genera due portafogli distinti: il portafoglio A e il portafoglio B.";
"onboarding.passphrase.learn_more.wallets.different" = "Cambiare anche un solo carattere significativo genera un seed e quindi un portafoglio diversi; il portafoglio originale rimane invariato.";
"onboarding.passphrase.learn_more.wallets.empty" = "Una passphrase vuota apre il portafoglio standard derivato solo dalla frase di recupero. Una passphrase non vuota apre un portafoglio distinto.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 non segnala una «passphrase errata»: ogni passphrase è valida, quindi un errore di battitura apre silenziosamente un altro portafoglio, in genere con saldo zero.";
"onboarding.passphrase.learn_more.security.section" = "Come una passphrase aumenta la protezione";
"onboarding.passphrase.learn_more.security.words.title" = "La frase di recupero da sola non basta";
"onboarding.passphrase.learn_more.security.words.detail" = "Chi ottiene soltanto la frase di recupero ha comunque bisogno della passphrase esatta per generare e accedere al portafoglio protetto.";
"onboarding.passphrase.learn_more.security.strength.title" = "Una passphrase robusta offre una separazione migliore";
"onboarding.passphrase.learn_more.security.strength.detail" = "Una passphrase lunga e imprevedibile rende molto più difficile indovinarla; una breve citazione, una data di nascita, un nome o una password riutilizzata possono essere scoperti rapidamente e offrono poca protezione.";
"onboarding.passphrase.learn_more.security.separation.title" = "Conserva la passphrase separatamente";
"onboarding.passphrase.learn_more.security.separation.detail" = "Conserva la passphrase separata dalla frase di recupero, così un singolo backup rubato non rivela entrambi i segreti necessari a ripristinare il portafoglio.";
"onboarding.passphrase.learn_more.security.footer" = "Una passphrase non può proteggere i fondi se entrambi i segreti vengono esposti, se è debole o se un software compromesso la acquisisce durante la digitazione.";
"onboarding.passphrase.learn_more.safety.section" = "Usa questa funzionalità in sicurezza";
"onboarding.passphrase.learn_more.safety.strong.title" = "Scegli una passphrase forte e unica";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Scegli diverse parole casuali o un altro valore ad alta entropia esclusivo di questo portafoglio. Evita dati personali, frasi familiari, schemi e password usate altrove.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Esegui un backup separato della passphrase";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Crea una copia durevole e offline della passphrase esatta, conservala separatamente dalla frase di recupero e non affidarti mai soltanto alla memoria.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Ogni carattere cambia il portafoglio";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Reinserisci la passphrase esattamente come l’hai creata, rispettando ogni maiuscola, spazio, segno di punteggiatura e parola. Qualsiasi differenza genera silenziosamente un altro portafoglio.";
