"onboarding.carousel.wallet.message" = "Oath offre ai tuoi asset uno spazio moderno e nativo, chiaro su tutte le reti, rapido quando serve e sempre sotto il tuo pieno controllo.";
"onboarding.carousel.wallet.visual.networks" = "Una vista unificata su tutte le reti";
