// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Scorri per inviare sostituisce il pulsante di conferma. Animazione direzionale, feedback aptico e movimento più fluido supportano entrambi i sensi di lettura. Rilascia al 90% o oltre per inviare; torna indietro per annullare.";
"settings.about.history.v355.build56.activity" = "La campanella apre le attività in sospeso. Le capsule mostrano badge di stato e si chiudono scorrendo. Quelle in conferma o confermate scompaiono dopo 3 secondi; la conferma aggiorna la stessa capsula visibile.";
"settings.about.history.v355.build56.status" = "Stato delle transazioni più affidabile su tutte le reti supportate, dettagli aggiornati in tempo reale e saldo aggiornato più rapidamente dopo l’invio. Il monitoraggio riprende alla riapertura dell’app.";
"settings.about.history.v355.build56.fees" = "Tornando alla stessa verifica del trasferimento, la commissione già ottenuta viene mantenuta. Caricamento delle commissioni e avvisi sui fondi più chiari; gli importi sufficienti non mostrano più avvisi di attivazione.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin e Dogecoin aggiungono il resto sotto la soglia dust alla commissione, senza creare un output inutilizzabile. La commissione verificata coincide con quella della firma.";
"settings.about.history.v355.build56.stability" = "Risolti un arresto anomalo delle attività in background e gli avvisi di timeout dell’aggiornamento del portafoglio. In caso di errore temporaneo, le informazioni esistenti restano disponibili.";
"settings.about.history.v355.build56.backup" = "Schermate di backup più chiare, con titoli corretti all’apertura e meno messaggi. L’accesso alle chiavi private rispetta il blocco dell’app. Gli avvisi d’importazione compatti in vetro cancellano l’input rifiutato quando scegli un’altra frase di recupero.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Dopo aver rilasciato il cursore di invio, appare un segno di spunta animato prima che si chiuda la schermata di verifica.";
"settings.about.history.v355.build57.activity" = "Le righe delle attività mostrano lo stato con un carattere meno marcato, l’importo come sottotitolo e una freccia per aprire i dettagli della transazione.";
"settings.about.history.v355.build57.details" = "Le commissioni di rete ora compaiono nel riepilogo del trasferimento. Etichette più brevi e una sola riga per la rete rendono i dettagli più chiari.";
"settings.about.history.v355.build57.resume" = "Al ritorno dall’esecuzione in background, le schermate e i pannelli aperti vengono mantenuti, inclusi la verifica del trasferimento e i dettagli della transazione.";
"settings.about.history.v355.build57.secrets" = "Le schermate con frase di recupero, chiave privata e passphrase si chiudono dopo 20 secondi fuori dall’app. Il blocco dell’app continua a rispettare le tue impostazioni.";
"settings.about.history.v355.build57.filters" = "I filtri di rete usano pulsanti nativi leggermente più alti, dimensionati in base al contenuto, con una spaziatura corretta sotto la barra di navigazione.";
"settings.about.history.v355.build57.units" = "Rimosse le righe separate del valore. Importo e commissione di rete appaiono inizialmente in valuta locale; tocca uno dei due per passare alle unità cripto e viceversa.";
"wallet.transaction.details.toggle_units" = "Cambia unità.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "La schermata iniziale si apre senza effetti di dissolvenza o ridimensionamento. Il pulsante Impostazioni ora usa un’icona a ingranaggio.";
"settings.about.history.v355.build58.fields" = "I campi delle transazioni e dell’invio usano i normali colori del testo. Le frecce compaiono solo nelle righe che aprono una schermata o un pannello; toccando importi e commissioni si continua a cambiare unità.";
"settings.about.history.v355.build58.banners" = "Una volta mostrati, i banner di conferma in corso o completata scompaiono dopo 3 secondi, anche se apri un’altra schermata. Le conferme non ancora mostrate compaiono al tuo ritorno.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "I trasferimenti TRON ora accantonano le commissioni di attivazione e larghezza di banda prima di calcolare l’importo da inviare, anche quando si invia il massimo. La schermata di verifica mostra l’importo corretto al netto delle commissioni.";
"settings.about.history.v355.build59.fees" = "Le commissioni TRON personalizzate devono coprire i costi di rete necessari. Quando il saldo TRX è basso, ora vengono mostrate indicazioni più chiare. La quantità di token resta invariata; le commissioni vengono pagate in TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Una nuova schermata di benvenuto";
"settings.about.history.v356.welcome" = "Una nuova schermata di benvenuto con grafica animata e opzioni chiare per creare o importare un portafoglio.";
"settings.about.history.v357.tour.title" = "Tour di benvenuto";
"settings.about.history.v357.tour" = "Un tour di cinque pagine presenta le reti supportate, l’entropia fisica, l’invio e la ricezione, la sicurezza e le build verificate. Scorri o tocca i punti per cambiare pagina; il selettore della lingua è nella barra di navigazione.";
"settings.about.history.v357.backup" = "Dopo la creazione, l’importazione o il ripristino di un portafoglio, la schermata compare subito e le opzioni di backup usano l’elenco standard. Il controllo iCloud avviene in background e Apri portafoglio è pronto non appena il portafoglio è salvato.";
"settings.about.history.v357.reliability" = "Tornare dallo sfondo non chiude più la schermata di configurazione quando scade una schermata di recupero nascosta, e la cancellazione di tutti i dati apre direttamente la schermata di benvenuto.";
"settings.about.history.v357.notifications" = "Le impostazioni delle notifiche usano un linguaggio più semplice per categorie e stato, senza dettagli tecnici.";
"settings.about.history.v357.wallets" = "Riordina i portafogli nel selettore con una pressione prolungata e l’animazione di sollevamento di sistema; toccare una riga la attiva. La verifica della frase di recupero numera ogni parola e il tasto Invio passa al campo successivo.";
"settings.about.history.v357.send" = "L’invio mostra l’importo mentre il trasferimento è in corso, appare un messaggio più chiaro se non può essere inviato e le richieste TRON vengono ritentate automaticamente dopo errori temporanei del provider.";
"settings.about.history.v357.security" = "Gli account TRON importati la cui autorizzazione di proprietario è stata trasferita a un’altra chiave ora mostrano l’avviso e non possono inviare, anche quando ogni autorizzazione elenca una sola chiave. All’importazione vengono rifiutate più frasi di recupero e chiavi private note come esposte.";
"settings.about.history.v356.localization" = "I testi della schermata di benvenuto sono ora più chiari e naturali in tutte le lingue supportate.";
"settings.about.history.v356.pricing" = "I prezzi dei token vengono ora cercati in base alla rete e all’indirizzo esatti, dando priorità ai prezzi dei DEX. I prezzi più piccoli mostrano fino a 8 cifre decimali senza arrotondamento.";
"settings.about.history.v356.appearance" = "I pulsanti principali e secondari hanno ora altezze e margini laterali uniformi. Le azioni principali usano il blu di sistema.";
"settings.about.history.v356.transactions" = "I dettagli delle transazioni mostrano lo stato abbreviato Confermata e un testo grigio più leggibile per date, indirizzi, importi e ID delle transazioni.";
"settings.about.history.v356.security" = "Ampliato l’elenco delle frasi di recupero e delle chiavi private note per essere state esposte, la cui importazione è bloccata.";

