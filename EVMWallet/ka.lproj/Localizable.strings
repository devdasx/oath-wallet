"onboarding.entropy.learn_more.inputs.dice.detail" = "თანაბრად დაბალანსებული კამათლის წახნაგები 1–4 თითოეული 2 ბიტს იძლევა, ხოლო წახნაგები 5–6 — თითოეული 1 ბიტს.";
"onboarding.entropy.learn_more.inputs.coin.title" = "მონეტის ფიზიკური აგდება";
"onboarding.entropy.learn_more.inputs.coin.detail" = "თანაბრად დაბალანსებული მონეტის ყოველი დამოუკიდებელი აგდება ენტროპიის ერთ მიუკერძოებელ ბიტს იძლევა.";
"onboarding.entropy.learn_more.inputs.digits.title" = "ჩაწერეთ შემთხვევითი ციფრები";
"onboarding.entropy.learn_more.inputs.digits.detail" = "ციფრები 0–7 თითოეულში მონაწილეობს 3 ბიტი; ციფრები 8–9 თითოეულში მონაწილეობენ 1 ბიტით. ციფრები უნდა მოდიოდეს ჭეშმარიტად შემთხვევითი ფიზიკური პროცესიდან.";
"onboarding.entropy.learn_more.inputs.footer" = "გამოიყენეთ მიუკერძოებელი ფიზიკური წყარო და ყველა შედეგი თანმიმდევრობით ჩაიწერეთ. შეყვანის მეთოდების შეცვლა შეგიძლიათ, რადგან თითოეული მიღებული შედეგი იმავე ბიტურ ნაკადს ემატება.";
"onboarding.entropy.learn_more.conversion.section" = "2. აკრიფეთ 256-ბიტიანი მნიშვნელობა";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath კამათლის შედეგებსა და ათობით ციფრებს მიუკერძოებელ, ორის ხარისხებზე დაფუძნებულ ჯგუფებად გარდაქმნის. მიღებული ბიტების რაოდენობა შეიძლება განსხვავდებოდეს, თუმცა მიუკერძოებელი ფიზიკური წყარო არც ერთ ბიტურ მნიშვნელობას უპირატესობას არ ანიჭებს.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath ამატებს ბიტებს შეყვანილი თანმიმდევრობით, სანამ არ შეაგროვებს ზუსტად 256-ს, შემდეგ ათავსებს მათ 32 ბაიტად, ჯერ ყველაზე მნიშვნელოვანი ბიტით.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "მორგებული ენტროპია შეიცავს მხოლოდ თქვენ მიერ ჩაწერილ ფიზიკურ მონაცემებს; Oath არ ერევა მოწყობილობის მიერ წარმოქმნილ შემთხვევითობას.";
"onboarding.entropy.learn_more.bip39.section" = "3. გამოიღეთ აღდგენის ფრაზა";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "ენტროპიის 256 ბიტი";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-ბიტიანი BIP-39 საკონტროლო ჯამი";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 ბიტი დაყოფილი 24 თერთმეტბიტიან სიტყვის ინდექსად";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-ბიტიანი ენტროპიის მნიშვნელობა იღებს 8-ბიტიან საკონტროლო ჯამს, წარმოქმნის 264 ბიტს, რომელიც იყოფა 24 თერთმეტბიტიან სიტყვის ინდექსად.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 ითვლის SHA-256-ს 32-ბაიტიანი ენტროპიის მნიშვნელობით და იღებს პირველ 8 ჰეშის ბიტს საკონტროლო ჯამად; ამ საკონტროლო ჯამის დამატება წარმოქმნის 264 ბიტს.";
"onboarding.entropy.learn_more.bip39.words" = "264 ბიტი იყოფა 11 ბიტიან 24 ჯგუფად. თითოეული ჯგუფი ირჩევს ერთ ჩანაწერს სტანდარტული 2048-სიტყვიანი BIP-39 სიიდან 24-სიტყვიანი აღდგენის ფრაზის შესაქმნელად.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core გამოყოფს დეტერმინისტულ ანგარიშებს და მისამართებს მიღებული თესლიდან. აღდგენის ერთი და იგივე ფრაზა და არასავალდებულო საიდუმლო ფრაზა ყოველთვის განაახლებს ერთსა და იმავე საფულეს.";
"onboarding.entropy.learn_more.security.section" = "როგორ აძლიერებს უსაფრთხოებას მორგებული ენტროპია";
"onboarding.entropy.learn_more.security.space.title" = "უზარმაზარი შესაძლებლობების სივრცე";
"onboarding.entropy.learn_more.security.space.detail" = "ერთიანი 256-ბიტიანი ენტროპია შეიცავს 2^256 უნიკალურ მნიშვნელობას, რაც ამომწურავ გამოცნობას გამოთვლით შეუძლებელს ხდის. ეს აღწერს შეყვანის სივრცის ზომას; ეს არ ნიშნავს, რომ ყველა კრიპტოგრაფიული კომპონენტი უზრუნველყოფს 256-ბიტიან თავდასხმის წინააღმდეგობას.";
"onboarding.entropy.learn_more.security.source.title" = "შემთხვევითობა შენგან მოდის";
"onboarding.entropy.learn_more.security.source.detail" = "ფიზიკური მოვლენები საშუალებას გაძლევთ დამოუკიდებლად მოიპოვოთ საფულის შემთხვევითობა იმის ნაცვლად, რომ დაეყრდნოთ მხოლოდ მოწყობილობის შემთხვევითი რიცხვების გენერატორს. ეს აუმჯობესებს უსაფრთხოებას მხოლოდ მაშინ, როდესაც ეს მოვლენები ჭეშმარიტად შემთხვევითია.";
"onboarding.entropy.learn_more.security.local.title" = "მთლიანად დამუშავებულია ამ მოწყობილობაზე";
"onboarding.entropy.learn_more.security.local.detail" = "Oath გარდაქმნის თქვენს ჩაწერილ თანმიმდევრობას და ქმნის აღდგენის ფრაზას მთლიანად ამ მოწყობილობაზე. თქვენი თანმიმდევრობა არასოდეს აიტვირთება დასამუშავებლად.";
"onboarding.entropy.learn_more.security.patterns.title" = "მოერიდეთ ადამიანის მიერ არჩეულ საიდუმლოებებს";
"onboarding.entropy.learn_more.security.patterns.detail" = "სამართლიანი, დამოუკიდებელი მოვლენების გრძელი თანმიმდევრობა გაცილებით ნაკლებად პროგნოზირებადია, ვიდრე დაბადების დღეები, საყვარელი რიცხვები, განმეორებითი შაბლონები ან პიროვნების მიერ არჩეული სიტყვები.";
"onboarding.entropy.learn_more.security.footer" = "ფიზიკური ენტროპია ცვლის მოწყობილობის მიერ გენერირებულ საფულის შემთხვევითობას; ეს არ არის დამატებითი პაროლი ან უსაფრთხოების ფენა.";
"onboarding.entropy.learn_more.safety.section" = "გამოიყენეთ ეს ფუნქცია უსაფრთხოდ";
"onboarding.entropy.learn_more.safety.fair.title" = "ჩაწერეთ მიუკერძოებელი, დამოუკიდებელი შედეგები";
"onboarding.entropy.learn_more.safety.fair.detail" = "გამოიყენეთ თანაბრად დაბალანსებული მონეტა ან კამათელი და დარწმუნდით, რომ ყოველი შედეგი დამოუკიდებელია. შემთხვევითი ციფრები რეალური ფიზიკური წყაროდან უნდა მოდიოდეს და არა მეხსიერებიდან ან ნიმუშიდან.";
"onboarding.entropy.learn_more.safety.private.title" = "შეინახეთ თქვენი ენტროპიის პროცესი პირადი";
"onboarding.entropy.learn_more.safety.private.detail" = "დაიცავით როგორც ჩაწერილი თანმიმდევრობა, ასევე დასრულებული აღდგენის ფრაზა საფულის საიდუმლოებად. შეინახეთ ისინი კამერებისა და სხვა ადამიანების ხედვისგან.";
"onboarding.entropy.learn_more.safety.accurate.title" = "ჩაწერეთ ყველა შედეგი ზუსტად";
"onboarding.entropy.learn_more.safety.accurate.detail" = "ერთი გამოტოვებული, დუბლირებული ან ხელახლა შეკვეთილი შედეგი ქმნის განსხვავებულ საფულეს. გადახედეთ ყველა ჩანაწერს და გადაამოწმეთ დასრულებული აღდგენის ფრაზა საფულის დაფინანსებამდე.";
"onboarding.entropy.learn_more.safety.backup.title" = "დაიცავით აღდგენის ფრაზა";
"onboarding.entropy.learn_more.safety.backup.detail" = "შეინახეთ აღდგენის ფრაზა ხაზგარეშე და არასოდეს გააზიაროთ იგი. თქვენი სარეზერვო ასლის გადამოწმების შემდეგ, უსაფრთხოდ გაანადგურეთ შუალედური შეყვანის ჩანაწერი, რომელიც აღარ გჭირდებათ.";
"onboarding.entropy.learn_more.safety.footer" = "ფიზიკურ ენტროპიას არ შეუძლია უზრუნველყოს ღია აღდგენის ფრაზა, გატეხილი მოწყობილობა, მავნე პროგრამული უზრუნველყოფა ან არასწორად ჩაწერილი თანმიმდევრობა. თუ არ შეგიძლიათ გარანტირებული იყოს სამართლიანი, პირადი და ზუსტი მონაცემები, გამოიყენეთ სტანდარტული საფულის შექმნა.";
"onboarding.carousel.open_source.eyebrow" = "ღია კოდი — დიზაინის საფუძველი";
"onboarding.carousel.open_source.title" = "შეამოწმეთ საწყისი კოდი. გადაამოწმეთ ბილდი.";
