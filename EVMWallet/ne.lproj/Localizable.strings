"onboarding.carousel.open_source.visual.accessibility" = "रिलिज प्रमाणित गर्न सार्वजनिक स्रोत कोड, स्वतन्त्र पुनर्बिल्ड र मिल्दो फिङ्गरप्रिन्ट आवश्यक हुन्छन् भन्ने देखाउने चित्र।";
"onboarding.carousel.passphrase.eyebrow" = "वैकल्पिक BIP-39 पासफ्रेज";
"onboarding.carousel.passphrase.title" = "एउटा रिकभरी वाक्यांश। अर्को एउटा गोप्य कुरा।";
"onboarding.carousel.passphrase.message" = "BIP-39 पासफ्रेज तपाईंको रिकभरी वाक्यांशसँग मिलेर छुट्टै वालेट निकाल्छ। रिकभरी शब्द सार्वजनिक भए पनि त्यो वालेट चलाउन ठ्याक्कै उही पासफ्रेज चाहिन्छ।";
"onboarding.carousel.passphrase.visual.phrase" = "तपाईंका 24 रिकभरी शब्द";
"onboarding.carousel.passphrase.visual.passphrase" = "तपाईंको अतिरिक्त गोप्य पासफ्रेज";
"onboarding.carousel.passphrase.visual.output" = "छुट्टै पासफ्रेज वालेट";
"onboarding.carousel.passphrase.visual.requirement" = "रिकभरीका लागि दुवै गोप्य विवरण आवश्यक";
"onboarding.carousel.passphrase.visual.accessibility" = "24-शब्दको रिकभरी वाक्यांश र गोप्य BIP-39 पासफ्रेज मिलेर छुट्टै वालेट निकाल्छन्, जसलाई रिकभर गर्न दुवै गोप्य विवरण चाहिन्छ।";
"onboarding.carousel.passphrase.learn_more.action" = "थप विवरण हेर्नुहोस्";
"onboarding.passphrase.learn_more.navigation" = "BIP-39 पासफ्रेज बुझ्नुहोस्";
"onboarding.passphrase.learn_more.path.section" = "दुई गोप्य विवरणबाट एउटा वालेट";
"onboarding.passphrase.learn_more.overview" = "BIP-39 पासफ्रेज रिकभरी वाक्यांशसँग जोडिने वैकल्पिक गोप्य विवरण हो। दुवै मिलेर रिकभरी वाक्यांश मात्रबाट बन्ने वालेटभन्दा फरक वालेट नियतात्मक रूपमा निकाल्छन्।";
