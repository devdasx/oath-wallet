"onboarding.passphrase.learn_more.security.strength.title" = "बलियो पासफ्रेजले राम्रो छुट्याउँछ";
"onboarding.passphrase.learn_more.security.strength.detail" = "लामो र अनुमान गर्न नसकिने पासफ्रेज अनुमान गर्न निकै कठिन हुन्छ; छोटो भनाइ, जन्ममिति, नाम वा अरू ठाउँमा चलाएको पासवर्ड छिट्टै अनुमान हुन सक्छ र थोरै मात्र सुरक्षा दिन्छ।";
"onboarding.passphrase.learn_more.security.separation.title" = "पासफ्रेज छुट्टै राख्नुहोस्";
"onboarding.passphrase.learn_more.security.separation.detail" = "एउटै चोरी भएको ब्याकअपबाट वालेट पुनर्स्थापना गर्न चाहिने दुवै गोप्य विवरण नखुलून् भनेर पासफ्रेजलाई रिकभरी वाक्यांशभन्दा छुट्टै राख्नुहोस्।";
"onboarding.passphrase.learn_more.security.footer" = "दुवै गोप्य विवरण सार्वजनिक भएमा, पासफ्रेज कमजोर भएमा वा हानिकारक सफ्टवेयरले टाइप गर्दागर्दै टिपेमा पासफ्रेजले तपाईंको रकम जोगाउन सक्दैन।";
