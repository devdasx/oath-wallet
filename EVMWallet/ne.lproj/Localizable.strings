// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "पुष्टि बटनको सट्टा अब स्लाइड गरेर पठाउन सकिन्छ। दिशात्मक एनिमेसन, ह्याप्टिक प्रतिक्रिया र सहज चालले पढ्ने दुवै दिशा समर्थन गर्छन्। पठाउन 90% वा अगाडि पुगेपछि औँला छोड्नुहोस्; रद्द गर्न पछाडि सार्नुहोस्।";
"settings.about.history.v355.build56.activity" = "घण्टीले विचाराधीन गतिविधि खोल्छ। कारोबार क्याप्सुलमा स्थितिका ब्याज देखिन्छन् र स्वाइप गरेर लुकाउन सकिन्छ। पुष्टि हुँदै गरेका र पुष्टि भएका क्याप्सुल 3 सेकेन्डपछि लुक्छन्; पुष्टि हुँदा त्यही देखिएको क्याप्सुल अद्यावधिक हुन्छ।";
"settings.about.history.v355.build56.status" = "सबै समर्थित नेटवर्कमा थप भरपर्दो कारोबार स्थिति, तत्काल अद्यावधिक विवरण र पठाएपछि छिटो मौज्दात अद्यावधिक। एप फेरि खोल्दा विचाराधीन कारोबारको निगरानी पुनः सुरु हुन्छ।";
"settings.about.history.v355.build56.fees" = "उही स्थानान्तरणको समीक्षामा फर्कँदा तयार शुल्क कायम रहन्छ। शुल्क लोड हुने र खातामा रकम आवश्यक पर्ने चेतावनी अझ स्पष्ट छन्; पर्याप्त रकम हुँदा सक्रियताका सूचना देखिँदैनन्।";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin र Dogecoinमा डस्ट सीमाभन्दा कम फिर्ता रकम अनुपयोगी आउटपुट बनाउनुको सट्टा शुल्कमा थपिन्छ। समीक्षाको शुल्क हस्ताक्षर गर्दाको शुल्कसँग मिल्छ।";
"settings.about.history.v355.build56.stability" = "पृष्ठभूमि कार्यको क्र्यास र वालेट रिफ्रेसको समयसीमा सकिने चेतावनी सच्याइयो। अस्थायी रिफ्रेस विफलतामा वालेटको विद्यमान जानकारी उपलब्ध रहन्छ।";
"settings.about.history.v355.build56.backup" = "खुल्दाखेरि सही शीर्षक र कम सन्देशसहित सफा ब्याकअप स्क्रिनहरू। निजी कुञ्जी पहुँचले एप लक सेटिङ पालना गर्छ। साना काँच-जस्ता आयात चेतावनीमा अर्को पुनःप्राप्ति वाक्यांश छान्दा अस्वीकृत इनपुट मेटिन्छ।";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "पठाउने स्लाइडर छोडेपछि, समीक्षा स्क्रिन बन्द हुनुअघि एनिमेटेड ठीक चिह्न देखिन्छ।";
"settings.about.history.v355.build57.activity" = "गतिविधिका पङ्क्तिहरूमा स्थिति कम बाक्लो अक्षरमा, रकम उपशीर्षकका रूपमा र कारोबारको विवरण खोल्न तीर देखाइन्छ।";
"settings.about.history.v355.build57.details" = "नेटवर्क शुल्क अब स्थानान्तरण सारांशमा देखिन्छ। छोटा लेबल र नेटवर्कको एउटै पङ्क्तिले विवरण अझ स्पष्ट बनाउँछन्।";
"settings.about.history.v355.build57.resume" = "पृष्ठभूमिबाट फर्कँदा खुला स्क्रिन र प्यानलहरू यथावत् रहन्छन्, जसमा स्थानान्तरण समीक्षा र कारोबारको विवरण पनि पर्छन्।";
"settings.about.history.v355.build57.secrets" = "एपबाट 20 सेकेन्ड टाढा रहँदा पुनःप्राप्ति वाक्यांश, निजी कुञ्जी र पासफ्रेजका स्क्रिन बन्द हुन्छन्। एप लक तपाईंका सेटिङअनुसार चलिरहन्छ।";
"settings.about.history.v355.build57.filters" = "नेटवर्क फिल्टरमा अलि अग्ला प्रणाली बटन, सामग्रीअनुसारको आकार र नेभिगेसन पट्टीमुनि सुधारिएको खाली ठाउँ प्रयोग गरिन्छ।";
"settings.about.history.v355.build57.units" = "मूल्यका छुट्टै पङ्क्तिहरू हटाइएका छन्। रकम र नेटवर्क शुल्क पहिले स्थानीय मुद्रामा देखिन्छन्; क्रिप्टो एकाइमा बदल्न र फर्कन कुनैमा ट्याप गर्नुहोस्।";
"wallet.transaction.details.toggle_units" = "एकाइ बदल्नुहोस्।";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "होम स्क्रिन फेड वा आकार परिवर्तन हुने प्रभावबिना खुल्छ। सेटिङ बटनमा अब गियरको चिह्न छ।";
"settings.about.history.v355.build58.fields" = "कारोबार र पठाउने क्षेत्रहरूमा पाठका सामान्य रङ प्रयोग गरिन्छ। स्क्रिन वा प्यानल खोल्ने पङ्क्तिहरूमा मात्र तीर देखिन्छन्; रकम र शुल्कमा ट्याप गर्दा पहिलेझैँ एकाइ बदलिन्छ।";
"settings.about.history.v355.build58.banners" = "देखिएपछि, पुष्टि हुँदै गरेको वा पूरा भएको ब्यानर 3 सेकेन्डमा हट्छ, तपाईंले अर्को स्क्रिन खोले पनि। पुष्टि सम्बन्धी अझै नदेखाइएका अपडेटहरू फर्कंदा देखिन्छन्।";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON स्थानान्तरणमा अब अधिकतम रकम पठाउँदा पनि पठाउने रकम गणना गर्नुअघि सक्रियकरण र ब्यान्डविथ शुल्कका लागि रकम छुट्याइन्छ। समीक्षा स्क्रिनमा शुल्क कटाएपछिको सही रकम देखिन्छ।";
"settings.about.history.v355.build59.fees" = "आफूले तोकेको TRON शुल्कले नेटवर्कको आवश्यक खर्च धान्नुपर्छ। TRX मौज्दात कम हुँदा अब अझ स्पष्ट निर्देशन देखिन्छ। टोकनको परिमाण बदलिँदैन; शुल्क TRX मा तिरिन्छ।";

