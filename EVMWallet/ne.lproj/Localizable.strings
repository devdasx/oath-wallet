"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 ले वालेट कसरी निकाल्छ";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "रिकभरी वाक्यांश र पासफ्रेजको संयोजन";
"onboarding.passphrase.learn_more.derivation.visual.function" = "2,048 राउन्डसहित PBKDF2-HMAC-SHA512";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-बिट मास्टर सिड";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "निकालिएका वालेट खाता र ठेगानाहरू";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "तपाईंको रिकभरी वाक्यांश र पासफ्रेज PBKDF2-HMAC-SHA512 का 2,048 राउन्डबाट गुज्रेर 512-बिट सिड बनाउँछन्, जसबाट वालेट खाता र ठेगाना निकालिन्छन्।";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 ले सामान्यीकृत रिकभरी वाक्यांशलाई PBKDF2 पासवर्ड र \"mnemonic\" पछि सामान्यीकृत पासफ्रेज जोडिएको मानलाई साल्टका रूपमा प्रयोग गर्छ। PBKDF2-HMAC-SHA512 का 2,048 राउन्डपछि 64-बाइट सिड बन्छ।";
"onboarding.passphrase.learn_more.derivation.normalization" = "सिड निकाल्नुअघि Oath ले BIP-39 ले मागेको Unicode सामान्यीकरण लागू गर्छ, जसले उही सामान्यीकृत रिकभरी वाक्यांश र पासफ्रेजबाट सधैँ उही वालेट पुनः बनाउँछ।";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "पासफ्रेजले रिकभरी शब्द इन्क्रिप्ट गर्दैन। यसले निकालिने सिड बदल्छ, त्यसैले हरेक फरक पासफ्रेजले फरक खाता र ठेगाना बनाउँछ।";
"onboarding.passphrase.learn_more.wallets.section" = "हरेक पासफ्रेजले छुट्टै वालेट निकाल्छ";
"onboarding.passphrase.learn_more.wallets.visual.one" = "नमुना पासफ्रेज 1";
