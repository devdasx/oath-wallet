"onboarding.passphrase.learn_more.wallets.different" = "अर्थपूर्ण एउटै वर्ण बदल्दा पनि फरक सिड र त्यसैले फरक वालेट निस्कन्छ; मूल वालेटमा कुनै परिवर्तन हुँदैन।";
"onboarding.passphrase.learn_more.wallets.empty" = "खाली पासफ्रेजले रिकभरी वाक्यांश मात्रबाट निकालिएको मानक वालेट खोल्छ; पासफ्रेज खाली नभए त्यसको आफ्नै छुट्टै वालेट खुल्छ।";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 मा \"गलत पासफ्रेज\" भन्ने प्रतिक्रिया हुँदैन; हरेक पासफ्रेज मान्य हुन्छ, त्यसैले टाइप गर्दा गल्ती भए चुपचाप अर्को वालेट खुल्छ—सामान्यतः शून्य ब्यालेन्स भएको।";
"onboarding.passphrase.learn_more.security.section" = "पासफ्रेजले सुरक्षा कसरी थप्छ";
