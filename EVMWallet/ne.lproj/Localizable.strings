"onboarding.carousel.entropy.visual.accessibility" = "क्रमाङ्कित पासा, एउटा सिक्का र अनियमित अंकहरू मिलेर यही यन्त्रमा 256 बिट वालेट एन्ट्रोपी बनाउँछन्।";
"onboarding.carousel.entropy.learn_more.action" = "थप विवरण हेर्नुहोस्";
"onboarding.entropy.learn_more.navigation" = "भौतिक एन्ट्रोपीले कसरी काम गर्छ";
"onboarding.entropy.learn_more.path.section" = "भौतिक नतिजादेखि रिकभरी शब्दसम्म";
"onboarding.entropy.learn_more.overview" = "Oath ले तपाईंले छानेको भौतिक स्रोतका नतिजा रेकर्ड गरी तिनलाई 256-बिट मानमा रूपान्तरण गर्छ। त्यसबाट बनेका 32 बाइट मानक BIP-39 रिकभरी वाक्यांश बनाउन Wallet Core मा पठाइन्छन्।";
"onboarding.entropy.learn_more.visual.phrase" = "24-शब्दको BIP-39 रिकभरी वाक्यांश";
"onboarding.entropy.learn_more.visual.bits" = "32 बाइट × 8 बिट बराबर 256 बिट";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "32 बाइटमा मिलाइएका 256 नमुना बिट कक्षहरूको ग्रिड।";
"onboarding.entropy.learn_more.visual.accessibility" = "पासाका नतिजा, सिक्का उछालका नतिजा वा अनियमित अंकलाई 256 बिटमा र त्यसपछि 24-शब्दको BIP-39 रिकभरी वाक्यांशमा रूपान्तरण गरिन्छ।";
"onboarding.entropy.learn_more.inputs.section" = "चरण 1: भौतिक नतिजाहरू रेकर्ड गर्नुहोस्";
"onboarding.entropy.learn_more.inputs.dice.title" = "निष्पक्ष छ-पक्षीय पासा पल्टाउनुहोस्";
"onboarding.entropy.learn_more.inputs.dice.detail" = "निष्पक्ष पासामा 1–4 का प्रत्येक पाटाले 2 बिट र 5–6 का प्रत्येक पाटाले 1 बिट योगदान गर्छन्।";
"onboarding.entropy.learn_more.inputs.coin.title" = "भौतिक रूपमा सिक्का उछाल्नुहोस्";
"onboarding.entropy.learn_more.inputs.coin.detail" = "निष्पक्ष र स्वतन्त्र रूपमा सिक्का उछाल्दा हरेक नतिजाले एन्ट्रोपीको 1 निष्पक्ष बिट योगदान गर्छ।";
"onboarding.entropy.learn_more.inputs.digits.title" = "अनियमित अंकहरू रेकर्ड गर्नुहोस्";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 का प्रत्येक अंकले 3 बिट र 8–9 का प्रत्येक अंकले 1 बिट योगदान गर्छन्। अंकहरू वास्तविक अनियमित भौतिक प्रक्रियाबाट आउनुपर्छ।";
"onboarding.entropy.learn_more.inputs.footer" = "निष्पक्ष भौतिक स्रोत प्रयोग गरी हरेक नतिजा क्रमअनुसार रेकर्ड गर्नुहोस्। हरेक स्वीकृत नतिजा एउटै बिट स्ट्रिममा जोडिने भएकाले इनपुट विधि बदल्न सक्नुहुन्छ।";
"onboarding.entropy.learn_more.conversion.section" = "2. 256-बिट मान तयार गर्नुहोस्";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath ले पासाका नतिजा र दशमलव अंकलाई निष्पक्ष दुईको घात समूहहरूमा रूपान्तरण गर्छ। योगदानको लम्बाइ फरक हुन सक्छ, तर निष्पक्ष भौतिक स्रोतले कुनै बिट मानलाई प्राथमिकता दिँदैन।";
"onboarding.entropy.learn_more.conversion.packing" = "ठ्याक्कै 256 बिट सङ्कलन नहुँदासम्म Oath ले प्रविष्ट गरिएको क्रममै बिटहरू जोड्छ, त्यसपछि सबैभन्दा महत्त्वपूर्ण बिटलाई पहिले राखेर तिनलाई 32 बाइटमा प्याक गर्छ।";
"onboarding.entropy.learn_more.conversion.no_mixing" = "आफूले बनाएको एन्ट्रोपीमा तपाईंले रेकर्ड गरेका भौतिक इनपुट मात्र हुन्छन्; Oath ले यन्त्रबाट बनेको अनियमितता मिसाउँदैन।";
"onboarding.entropy.learn_more.bip39.section" = "3. रिकभरी वाक्यांश निकाल्नुहोस्";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 बिट एन्ट्रोपी";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-बिटको BIP-39 चेकसम";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 बिटलाई 11-बिटका 24 शब्द सूचकाङ्कमा विभाजन";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-बिट एन्ट्रोपी मानमा 8-बिट चेकसम थप्दा 264 बिट बन्छन्, जसलाई 11-बिटका 24 शब्द सूचकाङ्कमा विभाजन गरिन्छ।";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 ले 32-बाइट एन्ट्रोपी मानमा SHA-256 गणना गरी ह्यासका पहिलो 8 बिटलाई चेकसमका रूपमा लिन्छ; त्यो चेकसम जोड्दा 264 बिट बन्छन्।";
"onboarding.entropy.learn_more.bip39.words" = "264 बिटलाई 11 बिटका 24 समूहमा विभाजन गरिन्छ। प्रत्येक समूहले मानक 2,048-शब्दको BIP-39 सूचीबाट एउटा प्रविष्टि छानी 24-शब्दको रिकभरी वाक्यांश बनाउँछ।";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core ले बनेको सिडबाट नियतात्मक खाता र ठेगानाहरू निकाल्छ। उही रिकभरी वाक्यांश र वैकल्पिक पासफ्रेजले सधैँ उही वालेट पुनः बनाउँछन्।";
"onboarding.entropy.learn_more.security.section" = "आफूले बनाएको एन्ट्रोपीले सुरक्षा कसरी बलियो बनाउँछ";
"onboarding.entropy.learn_more.security.space.title" = "सम्भावनाको विशाल क्षेत्र";
"onboarding.entropy.learn_more.security.space.detail" = "समान रूपमा वितरित 256-बिट एन्ट्रोपीमा 2^256 फरक मान हुन्छन्, त्यसैले सबै सम्भावना अनुमान गर्नु कम्प्युटरका लागि व्यावहारिक हुँदैन। यसले इनपुट क्षेत्रको आकार जनाउँछ; हरेक क्रिप्टोग्राफिक भागले 256-बिट आक्रमण प्रतिरोध दिन्छ भन्ने अर्थ लाग्दैन।";
"onboarding.entropy.learn_more.security.source.title" = "अनियमितता तपाईंबाट आउँछ";
"onboarding.entropy.learn_more.security.source.detail" = "यन्त्रको अनियमित-सङ्ख्या जेनेरेटरमा मात्र निर्भर हुनुको सट्टा भौतिक घटनाबाट वालेटको अनियमितता स्वतन्त्र रूपमा लिन सकिन्छ। ती घटना साँच्चिकै अनियमित भए मात्र यसले सुरक्षा बढाउँछ।";
"onboarding.entropy.learn_more.security.local.title" = "पूर्णतः यही यन्त्रमा प्रशोधन";
"onboarding.entropy.learn_more.security.local.detail" = "Oath ले तपाईंले रेकर्ड गरेको क्रमलाई रूपान्तरण गरी रिकभरी वाक्यांश पूर्णतः यही यन्त्रमा बनाउँछ। प्रशोधनका लागि यो क्रम कहिल्यै अपलोड हुँदैन।";
"onboarding.entropy.learn_more.security.patterns.title" = "मानिसले छानेका गोप्य कुरा नचलाउनुहोस्";
"onboarding.entropy.learn_more.security.patterns.detail" = "निष्पक्ष र स्वतन्त्र घटनाहरूको लामो क्रम जन्ममिति, मनपर्ने सङ्ख्या, दोहोरिने ढाँचा वा मानिसले छानेका शब्दभन्दा निकै कम अनुमान गर्न सकिने हुन्छ।";
"onboarding.entropy.learn_more.security.footer" = "भौतिक एन्ट्रोपीले यन्त्रबाट बन्ने वालेट अनियमिततालाई प्रतिस्थापन गर्छ; यो थप पासवर्ड वा सुरक्षा तह होइन।";
"onboarding.entropy.learn_more.safety.section" = "यो सुविधा सुरक्षित रूपमा प्रयोग गर्नुहोस्";
"onboarding.entropy.learn_more.safety.fair.title" = "निष्पक्ष र स्वतन्त्र नतिजाहरू रेकर्ड गर्नुहोस्";
"onboarding.entropy.learn_more.safety.fair.detail" = "निष्पक्ष सिक्का वा पासा प्रयोग गर्नुहोस् र हरेक नतिजा स्वतन्त्र भएको सुनिश्चित गर्नुहोस्। अनियमित अंक वास्तविक भौतिक स्रोतबाट आउनुपर्छ—सम्झना वा ढाँचाबाट होइन।";
"onboarding.entropy.learn_more.safety.private.title" = "आफ्नो एन्ट्रोपी प्रक्रिया गोप्य राख्नुहोस्";
"onboarding.entropy.learn_more.safety.private.detail" = "रेकर्ड गरिएको क्रम र तयार रिकभरी वाक्यांश दुवैलाई वालेटको गोप्य विवरणसरह जोगाउनुहोस्। क्यामेरा र अरू मानिसको नजरबाट टाढा राख्नुहोस्।";
"onboarding.entropy.learn_more.safety.accurate.title" = "हरेक नतिजा ठ्याक्कै रेकर्ड गर्नुहोस्";
"onboarding.entropy.learn_more.safety.accurate.detail" = "एउटा नतिजा छुटेमा, दोहोरिएमा वा क्रम बदलिएमा फरक वालेट बन्छ। हरेक प्रविष्टि जाँच्नुहोस् र वालेटमा रकम राख्नुअघि पूरा रिकभरी वाक्यांश प्रमाणित गर्नुहोस्।";
"onboarding.entropy.learn_more.safety.backup.title" = "रिकभरी वाक्यांश सुरक्षित गर्नुहोस्";
"onboarding.entropy.learn_more.safety.backup.detail" = "रिकभरी वाक्यांश अफलाइन राख्नुहोस् र कहिल्यै साझा नगर्नुहोस्। ब्याकअप प्रमाणित गरेपछि अब नचाहिने कुनै पनि मध्यवर्ती इनपुट रेकर्ड सुरक्षित रूपमा नष्ट गर्नुहोस्।";
"onboarding.entropy.learn_more.safety.footer" = "भौतिक एन्ट्रोपीले सार्वजनिक भएको रिकभरी वाक्यांश, नियन्त्रण गुमेको यन्त्र, हानिकारक सफ्टवेयर वा गलत रूपमा रेकर्ड गरिएको क्रमलाई सुरक्षित गर्न सक्दैन। निष्पक्ष, गोप्य र सही इनपुट सुनिश्चित गर्न नसके मानक वालेट सिर्जना प्रयोग गर्नुहोस्।";
"onboarding.carousel.open_source.eyebrow" = "डिजाइनदेखि नै ओपन सोर्स";
"onboarding.carousel.open_source.title" = "स्रोत जाँच्नुहोस्। बिल्ड प्रमाणित गर्नुहोस्।";
"onboarding.carousel.open_source.message" = "Oath ले स्वतन्त्र जाँचका लागि आफ्नो स्रोत कोड प्रकाशित गर्छ। पुनरुत्पादन गर्न सकिने बिल्ड प्रकाशित एपको फिङ्गरप्रिन्टसँग मिलेपछि मात्र रिलिज प्रमाणित हुन्छ।";
