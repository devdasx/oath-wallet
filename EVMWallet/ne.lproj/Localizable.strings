"settings.about.history.v356.welcome" = "एनिमेटेड कलाकृति र वालेट सिर्जना गर्न वा आयात गर्न स्पष्ट विकल्पहरूको साथ एउटा नयाँ स्वागत स्क्रिन।";
"settings.about.history.v357.tour.title" = "स्वागत भ्रमण";
"settings.about.history.v357.tour" = "पाँच पृष्ठको भ्रमणले समर्थित नेटवर्क, भौतिक एन्ट्रोपी, पठाउने र प्राप्त गर्ने, सुरक्षा र प्रमाणित बिल्डहरू चिनाउँछ। पृष्ठ बदल्न स्वाइप गर्नुहोस् वा थोप्लाहरूमा ट्याप गर्नुहोस्; भाषा परिवर्तन गर्ने बटन नेभिगेसन बारमा छ।";
"settings.about.history.v357.backup" = "वालेट सिर्जना, आयात वा पुनर्स्थापना गरेपछि स्क्रिन तुरुन्तै देखिन्छ र यसका ब्याकअप विकल्पहरूले मानक सूची प्रयोग गर्छन्। iCloud जाँच पृष्ठभूमिमा चल्छ, र वालेट सुरक्षित हुनासाथ वालेट खोल्नुहोस् तयार हुन्छ।";
"settings.about.history.v357.reliability" = "लुकेको रिकभरी स्क्रिनको म्याद सकिँदा पृष्ठभूमिबाट फर्कँदा अब सेटअप स्क्रिन बन्द हुँदैन, र सबै डेटा मेटाउँदा सिधै स्वागत स्क्रिन खुल्छ।";
"settings.about.history.v357.notifications" = "सूचना सेटिङहरूले वर्ग र स्थितिका लागि प्राविधिक विवरणबिना सरल शब्दहरू प्रयोग गर्छन्।";
"settings.about.history.v357.wallets" = "स्विचरमा वालेटहरू लामो थिचेर प्रणालीको उठाउने एनिमेसनसहित पुनः क्रमबद्ध गर्नुहोस्; पङ्क्तिमा ट्याप गर्दा त्यो सक्रिय हुन्छ। रिकभरी वाक्यांश प्रमाणीकरणले हरेक शब्दलाई क्रमांक दिन्छ, र Return अर्को फिल्डमा जान्छ।";
"settings.about.history.v357.send" = "स्थानान्तरण चलिरहँदा पठाउँदा रकम देखिन्छ, पठाउन नसकिए स्पष्ट सन्देश देखिन्छ, र अस्थायी प्रदायक त्रुटिपछि TRON अनुरोधहरू स्वतः पुनः प्रयास हुन्छन्।";
"settings.about.history.v357.security" = "जसको स्वामी अनुमति अर्को साँचोमा सारिएको छ, त्यस्ता आयातित TRON खाताहरूले अब हरेक अनुमतिमा एउटै साँचो भए पनि चेतावनी देखाउँछन् र पठाउन सक्दैनन्। सार्वजनिक भएको भनी ज्ञात थप रिकभरी वाक्यांश र निजी साँचोहरू आयात गर्दा अस्वीकार गरिन्छन्।";
"settings.about.history.v356.localization" = "सबै समर्थित भाषामा स्वागत स्क्रिनको पाठलाई अझ स्वाभाविक र स्पष्ट बनाइएको छ।";
"settings.about.history.v356.pricing" = "टोकन मूल्यहरू अब सही नेटवर्क र टोकन ठेगानासँग मेल खान्छ, पहिले DEX मूल्यहरू प्रयोग गरेर। साना मूल्यहरू राउन्डिङ बिना 8 दशमलव स्थानहरू देखाउँछन्।";
"settings.about.history.v356.appearance" = "प्राथमिक र माध्यमिक बटनहरूले अब प्राथमिक कार्यहरूका लागि प्रणाली नीलोको साथ लगातार उचाइ र स्क्रिन मार्जिनहरू प्रयोग गर्दछ।";
"settings.about.history.v356.transactions" = "लेनदेन विवरणहरूले मितिहरू, ठेगानाहरू, रकमहरू, र लेनदेन आईडीहरूको लागि छोटो पुष्टि गरिएको स्थिति र स्पष्ट खैरो पाठ प्रयोग गर्दछ।";
"settings.about.history.v356.security" = "आयात गर्न नसकिने ज्ञात रिकभरी वाक्यांश र निजी कुञ्जीहरूको सूची विस्तार गरियो।";

