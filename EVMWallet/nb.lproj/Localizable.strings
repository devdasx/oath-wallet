"onboarding.carousel.entropy.eyebrow" = "ENTROPI FRA FYSISKE INNDATA";
"onboarding.carousel.entropy.title" = "Skap tilfeldighet du har full kontroll over.";
"onboarding.carousel.entropy.message" = "Kast terninger, vend en mynt eller skriv tilfeldige sifre. Oath konverterer den fysiske inngangen din til nøyaktig 256 biter med entropi for en 24-ords gjenopprettingsfrase, helt på enheten din.";
"onboarding.carousel.entropy.visual.output" = "256 biter av brukergenerert entropi";
"onboarding.carousel.entropy.visual.local" = "Generert utelukkende fra de registrerte inndataene dine";
"onboarding.carousel.entropy.visual.accessibility" = "En nummerert terning, en mynt og tilfeldige sifre produserer sammen 256 biter med lommebokentropi på denne enheten.";
"onboarding.carousel.entropy.learn_more.action" = "Utforsk flere detaljer";
"onboarding.entropy.learn_more.navigation" = "Hvordan fysisk entropi fungerer";
"onboarding.entropy.learn_more.path.section" = "Fra fysiske utfall til gjenopprettingsord";
"onboarding.entropy.learn_more.overview" = "Oath registrerer utfall fra den valgte fysiske kilden og konverterer dem til en 256-bits verdi. De resulterende 32 bytene sendes deretter til Wallet Core for å lage en standard BIP-39-gjenopprettingsfrase.";
"onboarding.entropy.learn_more.visual.phrase" = "En 24-ords BIP-39-gjenopprettingsfrase";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 biter tilsvarer 256 biter";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Et rutenett med 256 prøvebitceller arrangert i 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Terningkast, myntkast eller tilfeldige sifre konverteres til 256 biter og deretter til en 24-ords BIP-39-gjenopprettingsfrase.";
"onboarding.entropy.learn_more.inputs.section" = "Trinn 1: Registrer fysiske resultater";
"onboarding.entropy.learn_more.inputs.dice.title" = "Kast en rettferdig sekssidig terning";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Med en rettferdig terning bidrar side 1–4 hver med 2 bits; side 5–6 bidrar hver med 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fysiske myntkast";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Hvert rettferdige, uavhengige myntkast bidrar med én upartisk entropibit.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registrer tilfeldige sifre";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Siffer 0–7 bidrar hver med 3 biter; sifrene 8–9 bidrar hver med 1 bit. Sifrene må komme fra en genuint tilfeldig fysisk prosess.";
"onboarding.entropy.learn_more.inputs.footer" = "Bruk en rettferdig fysisk kilde og registrer hvert resultat i rekkefølge. Du kan bytte inndatametode fordi hvert akseptert resultat bidrar til den samme bitstrømmen.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sett sammen en 256-biters verdi";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath konverterer terningresultater og desimalsifre til objektive to-styrker. Bidragslengdene kan variere, men en rettferdig fysisk kilde favoriserer ingen bitverdi.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath legger til biter i den angitte rekkefølgen til den samler nøyaktig 256, og pakker dem deretter inn i 32 byte med den mest signifikante biten først.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Egendefinert entropi inneholder bare de fysiske inndataene du registrerer. Oath blander ikke inn enhetsgenerert tilfeldighet.";
"onboarding.entropy.learn_more.bip39.section" = "3. Utled gjenopprettingsfrasen";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 biter av entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "En 8-bits BIP-39 sjekksum";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 biter fordelt på 24 elleve-bits ordindekser";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "En 256-biters entropiverdi mottar en 8-biters kontrollsum, og produserer 264 biter som deler seg i 24 elleve-biters ordindekser.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 beregner SHA-256 over 32-byte entropiverdien og tar de første 8 hashbitene som en kontrollsum; ved å legge til at kontrollsum produserer 264 biter.";
"onboarding.entropy.learn_more.bip39.words" = "De 264 bitene er delt inn i 24 grupper på 11 biter. Hver gruppe velger én oppføring fra standard BIP-39-listen på 2048 ord for å produsere gjenopprettingsfrasen på 24 ord.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core utleder deterministiske kontoer og adresser fra det resulterende frøet. Den samme gjenopprettingsfrasen og valgfrie passfrasen vil alltid gjenskape den samme lommeboken.";
"onboarding.entropy.learn_more.security.section" = "Hvordan tilpasset entropi styrker sikkerheten";
"onboarding.entropy.learn_more.security.space.title" = "Et enormt mulighetsrom";
"onboarding.entropy.learn_more.security.space.detail" = "Ensartet 256-biters entropi inneholder 2^256 unike verdier, noe som gjør uttømmende gjetting beregningsmessig umulig. Dette beskriver størrelsen på inndataområdet; det betyr ikke at hver kryptografisk komponent gir 256-bit angrepsmotstand.";
"onboarding.entropy.learn_more.security.source.title" = "Tilfeldighet kommer fra deg";
"onboarding.entropy.learn_more.security.source.detail" = "Fysiske hendelser lar deg hente lommebokens tilfeldighet uavhengig i stedet for å stole utelukkende på en enhetsgenerator for tilfeldige tall. Dette forbedrer sikkerheten bare når disse hendelsene er virkelig tilfeldige.";
"onboarding.entropy.learn_more.security.local.title" = "Behandlet i sin helhet på denne enheten";
"onboarding.entropy.learn_more.security.local.detail" = "Oath konverterer den innspilte sekvensen din og oppretter gjenopprettingsfrasen helt på denne enheten. Sekvensen din lastes aldri opp for behandling.";
"onboarding.entropy.learn_more.security.patterns.title" = "Unngå menneskevalgte hemmeligheter";
"onboarding.entropy.learn_more.security.patterns.detail" = "En lang sekvens av rettferdige, uavhengige hendelser er langt mindre forutsigbar enn fødselsdager, favoritttall, gjentatte mønstre eller ord valgt av en person.";
"onboarding.entropy.learn_more.security.footer" = "Fysisk entropi erstatter enhetsgenerert lommeboktilfeldighet; det er ikke et ekstra passord eller sikkerhetslag.";
"onboarding.entropy.learn_more.safety.section" = "Bruk denne funksjonen trygt";
"onboarding.entropy.learn_more.safety.fair.title" = "Registrer rettferdige, uavhengige resultater";
"onboarding.entropy.learn_more.safety.fair.detail" = "Bruk en rettferdig mynt eller terning, og sørg for at hvert resultat er uavhengig. Tilfeldige sifre må komme fra en ekte fysisk kilde – ikke fra minnet eller et mønster.";
"onboarding.entropy.learn_more.safety.private.title" = "Hold entropiprosessen din privat";
"onboarding.entropy.learn_more.safety.private.detail" = "Beskytt både den innspilte sekvensen og den fullførte gjenopprettingsfrasen som lommebokhemmeligheter. Hold dem unna kameraer og andre mennesker.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registrer hvert resultat nøyaktig";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Ett manglende, duplisert eller omorganisert resultat skaper en annen lommebok. Gå gjennom hver oppføring og bekreft den fullførte gjenopprettingsfrasen før du finansierer lommeboken.";
"onboarding.entropy.learn_more.safety.backup.title" = "Sikre gjenopprettingsfrasen";
"onboarding.entropy.learn_more.safety.backup.detail" = "Hold gjenopprettingsfrasen frakoblet og del den aldri. Etter å ha verifisert sikkerhetskopien, må du på en sikker måte ødelegge eventuelle mellomliggende inndataposter du ikke lenger trenger.";
"onboarding.entropy.learn_more.safety.footer" = "Fysisk entropi kan ikke sikre en eksponert gjenopprettingsfrase, en kompromittert enhet, skadelig programvare eller en feilregistrert sekvens. Hvis du ikke kan garantere rettferdige, private og nøyaktige inndata, bruk standard lommebokoppretting i stedet.";
"onboarding.carousel.open_source.eyebrow" = "ÅPEN KILDEKODE FRA STARTEN";
"onboarding.carousel.open_source.title" = "Undersøk kildekoden. Bekreft bygget.";
"onboarding.carousel.open_source.message" = "Oath publiserer sin kildekode for uavhengig inspeksjon. En utgivelse verifiseres bare når en reproduserbar versjon samsvarer med fingeravtrykket til den publiserte appen.";
"onboarding.carousel.open_source.action.github" = "Se gjennom på GitHub";
