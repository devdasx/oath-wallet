"onboarding.carousel.passphrase.eyebrow" = "VALGFRI BIP-39-PASSFRASE";
"onboarding.carousel.passphrase.title" = "En gjenopprettingsfrase. En ekstra hemmelighet.";
"onboarding.carousel.passphrase.message" = "En BIP-39-passfrase kombineres med gjenopprettingsfrasen din for å utlede en separat lommebok. Selv om gjenopprettingsordene avsløres, krever tilgang til denne lommeboken fortsatt den nøyaktige passfrasen.";
"onboarding.carousel.passphrase.visual.phrase" = "Dine 24 gjenopprettingsord";
"onboarding.carousel.passphrase.visual.passphrase" = "Din ekstra hemmelige passfrase";
"onboarding.carousel.passphrase.visual.output" = "En distinkt passfrase-lommebok";
"onboarding.carousel.passphrase.visual.requirement" = "Begge hemmelighetene kreves for gjenoppretting";
"onboarding.carousel.passphrase.visual.accessibility" = "En gjenopprettingsfrase på 24 ord og en hemmelig BIP-39-passfrase utleder en separat lommebok som krever begge hemmelighetene for gjenoppretting.";
"onboarding.carousel.passphrase.learn_more.action" = "Utforsk flere detaljer";
"onboarding.passphrase.learn_more.navigation" = "Slik fungerer BIP-39-passfraser";
"onboarding.passphrase.learn_more.path.section" = "To hemmeligheter utleder én lommebok";
"onboarding.passphrase.learn_more.overview" = "En BIP-39-passfrase er en valgfri hemmelighet kombinert med gjenopprettingsfrasen. Sammen utleder de deterministisk en lommebok som er forskjellig fra den som er opprettet av gjenopprettingsfrasen alene.";
"onboarding.passphrase.learn_more.visual.phrase" = "Din 24-ords gjenopprettingsfrase";
"onboarding.passphrase.learn_more.visual.passphrase" = "Din hemmelige passfrase";
"onboarding.passphrase.learn_more.visual.wallet" = "En passfrasebeskyttet lommebok";
"onboarding.passphrase.learn_more.visual.accessibility" = "En gjenopprettingsfrase på 24 ord og en hemmelig passfrase kombineres for å utlede en separat, passfrasebeskyttet lommebok.";
"onboarding.passphrase.learn_more.derivation.section" = "Slik utleder BIP-39 lommeboken";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Gjenopprettingsfrase kombinert med passfrase";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 med 2048 runder";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bits masterfrø";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Avledede lommebokkontoer og adresser";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Gjenopprettingsfrasen og passfrasen din går gjennom 2048 runder med PBKDF2-HMAC-SHA512 for å produsere 512-bits frøet som lommebokkontoer og adresser er avledet fra.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 behandler den normaliserte gjenopprettingsfrasen som PBKDF2-passordet og bruker \"mnemonic\" etterfulgt av den normaliserte passfrasen som saltet. Etter 2048 runder med PBKDF2-HMAC-SHA512, produserer prosessen et 64-byte frø.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Før du utleder frøet, bruker Oath Unicode-normaliseringen som kreves av BIP-39, slik at den samme normaliserte gjenopprettingsfrasen og passfrasen alltid gjengir den samme lommeboken.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "En passfrase krypterer ikke gjenopprettingsordene dine. Det endrer det avledede frøet, slik at hver forskjellig passfrase produserer forskjellige kontoer og adresser.";
"onboarding.passphrase.learn_more.wallets.section" = "Hver passfrase utleder en separat lommebok";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Eksempel på passfrase 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Eksempel på passfrase 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Eksempel Lommebok A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Eksempel lommebok B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Den samme gjenopprettingsfrasen kombinert med to forskjellige passfraser utleder to separate lommebøker: Lommebok A og Lommebok B.";
"onboarding.passphrase.learn_more.wallets.different" = "Å endre til og med en meningsfull karakter gir et annet frø og derfor en annen lommebok; den opprinnelige lommeboken forblir uendret.";
"onboarding.passphrase.learn_more.wallets.empty" = "En tom passfrase åpner standardlommeboken som er hentet fra gjenopprettingsfrasen alene; en ikke-tom passfrase åpner sin egen separate lommebok.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 har ingen \"feil passfrase\"-respons; hver passfrase er gyldig, så en skrivefeil åpner en annen lommebok stille – vanligvis med nullsaldo.";
"onboarding.passphrase.learn_more.security.section" = "Hvordan en passfrase gir beskyttelse";
"onboarding.passphrase.learn_more.security.words.title" = "Gjenopprettingsord alene er ikke nok";
"onboarding.passphrase.learn_more.security.words.detail" = "Noen som bare får gjenopprettingsfrasen din trenger fortsatt den nøyaktige passfrasen for å utlede og få tilgang til den beskyttede lommeboken.";
"onboarding.passphrase.learn_more.security.strength.title" = "En sterk passfrase gir bedre beskyttelse";
"onboarding.passphrase.learn_more.security.strength.detail" = "En lang, uforutsigbar passfrase gir meningsfulle gjettevansker; et kort sitat, fødselsdag, navn eller gjenbrukt passord kan gjettes raskt og gir liten beskyttelse.";
"onboarding.passphrase.learn_more.security.separation.title" = "Hold passfrasen atskilt";
"onboarding.passphrase.learn_more.security.separation.detail" = "Lagre passfrasen separat fra gjenopprettingsfrasen slik at en enkelt stjålet sikkerhetskopi ikke avslører begge hemmelighetene som kreves for å gjenopprette lommeboken.";
"onboarding.passphrase.learn_more.security.footer" = "En passfrase kan ikke beskytte pengene dine hvis begge hemmelighetene er avslørt, passfrasen er svak, eller kompromittert programvare fanger den opp mens du skriver.";
"onboarding.passphrase.learn_more.safety.section" = "Bruk denne funksjonen trygt";
"onboarding.passphrase.learn_more.safety.strong.title" = "Lag en sterk, unik passfrase";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Velg flere tilfeldige ord eller en annen høyentropiverdi som er unik for denne lommeboken. Unngå personlige fakta, kjente fraser, mønstre og passord som brukes andre steder.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Sikkerhetskopier passfrasen separat";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Lag en holdbar offline-kopi av den nøyaktige passfrasen, lagre den separat fra gjenopprettingsfrasen, og stol aldri på minnet alene.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Hvert tegn endrer lommeboken";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Skriv inn passordet på nytt nøyaktig slik det er opprettet, inkludert hver stor bokstav, mellomrom, skilletegn og ord. Enhver forskjell avleder stille en annen lommebok.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Bekreft gjenoppretting før du legger til midler";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Før du mottar betydelige midler, utfør en privat, kontrollert gjenopprettingstest for å bekrefte at gjenopprettingsfrasen og passfrasen gjenskaper de forventede adressene.";
"onboarding.passphrase.learn_more.safety.footer" = "Ingen tjeneste kan tilbakestille eller gjenopprette en tapt passfrase. Uten den nøyaktige passfrasen er tilgangen til den lommeboken permanent tapt – selv om du fortsatt har gjenopprettingsfrasen.";
