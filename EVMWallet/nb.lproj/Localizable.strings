"onboarding.carousel.wallet.eyebrow" = "DIN OATH WALLET";
"onboarding.carousel.wallet.title" = "Én lommebok for alle handlinger.";
"onboarding.carousel.wallet.message" = "Oath gir eiendelene dine et moderne, innfødt hjem som forblir klart på tvers av nettverk, reagerer raskt og forblir helt under din kontroll.";
"onboarding.carousel.wallet.visual.networks" = "En enhetlig visning på tvers av nettverk";
