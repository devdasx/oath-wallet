// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Skyv for å sende erstatter bekreftelsesknappen. Retningsanimasjon, haptikk og jevnere bevegelse støtter begge leseretninger. Slipp ved minst 90% for å sende; skyv tilbake for å avbryte.";
"settings.about.history.v355.build56.activity" = "Bjellen åpner ventende aktivitet. Transaksjonskapsler viser statusmerker og kan sveipes bort. Kapsler under bekreftelse og bekreftede kapsler skjules etter 3 sekunder; bekreftelsen oppdaterer den samme synlige kapselen.";
"settings.about.history.v355.build56.status" = "Mer pålitelig transaksjonsstatus på alle støttede nettverk, løpende oppdaterte transaksjonsdetaljer og raskere saldooppdateringer etter sending. Oppfølging av ventende transaksjoner fortsetter når appen åpnes igjen.";
"settings.about.history.v355.build56.fees" = "Når du går tilbake til samme overføringsgjennomgang, beholdes det hentede gebyret. Tydeligere gebyrinnlasting og varsler om kontofinansiering; tilstrekkelige beløp viser ikke lenger aktiveringsmeldinger.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin og Dogecoin legger veksel under støvgrensen til gebyret i stedet for å opprette en ubrukelig utgang. Gebyret i gjennomgangen samsvarer med signeringen.";
"settings.about.history.v355.build56.stability" = "Rettet en krasj i en bakgrunnsoppgave og tidsavbruddsvarsler ved oppdatering av lommeboken. Eksisterende lommebokinformasjon er fortsatt tilgjengelig ved midlertidige oppdateringsfeil.";
"settings.about.history.v355.build56.backup" = "Ryddigere sikkerhetskopiskjermer med riktige titler ved åpning og færre meldinger. Tilgang til private nøkler følger innstillingene for applås. Kompakte importvarsler med glassutseende tømmer avvist inndata når du velger en annen gjenopprettingsfrase.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Når du slipper glidebryteren for sending, vises en animert hake før gjennomgangen lukkes.";
"settings.about.history.v355.build57.activity" = "Aktivitetsrader viser status med lettere skrift, beløpet som undertekst og en pil for å åpne transaksjonsdetaljene.";
"settings.about.history.v355.build57.details" = "Nettverksgebyrer vises nå i overføringsoversikten. Kortere etiketter og én nettverksrad gjør detaljene mer oversiktlige.";
"settings.about.history.v355.build57.resume" = "Når du kommer tilbake fra bakgrunnen, beholdes åpne skjermer og paneler, inkludert gjennomgang av overføringer og transaksjonsdetaljer.";
"settings.about.history.v355.build57.secrets" = "Skjermer med gjenopprettingsfrase, privat nøkkel og passfrase lukkes etter 20 sekunders fravær. Applåsen følger fortsatt innstillingene dine.";
"settings.about.history.v355.build57.filters" = "Nettverksfiltre bruker litt høyere systemknapper, innholdstilpasset størrelse og korrigert avstand under navigasjonslinjen.";
"settings.about.history.v355.build57.units" = "Separate verdirader er fjernet. Beløp og nettverksgebyr vises først i lokal valuta; trykk på et av dem for å bytte til kryptoenheter og tilbake.";
"wallet.transaction.details.toggle_units" = "Bytt enheter.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Hjemskjermen åpnes uten tonings- eller skaleringseffekter. Innstillingsknappen bruker nå et tannhjulikon.";
"settings.about.history.v355.build58.fields" = "Feltene for transaksjoner og sending bruker vanlige tekstfarger. Piler vises bare på rader som åpner en skjerm eller et panel; et trykk på beløp og gebyrer bytter fortsatt enhet.";
"settings.about.history.v355.build58.banners" = "Når bannere for pågående eller fullført bekreftelse er vist, forsvinner de etter 3 sekunder, selv om du åpner en annen skjerm. Bekreftelser som ennå ikke er vist, vises når du kommer tilbake.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON-overføringer setter nå av aktiverings- og båndbreddegebyrer før beløpet som skal sendes, beregnes, også når du sender maksimalt beløp. Gjennomgangen viser riktig beløp etter gebyrer.";
"settings.about.history.v355.build59.fees" = "Egendefinerte TRON-gebyrer må dekke de nødvendige nettverkskostnadene. Ved lav TRX-saldo vises nå tydeligere veiledning. Tokenbeløpet forblir uendret; gebyrer betales i TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "En ny velkomst";
"settings.about.history.v356.welcome" = "En ny velkomstskjerm med animerte kunstverk og klare alternativer for å lage eller importere en lommebok.";
"settings.about.history.v357.tour.title" = "Velkomstomvisning";
"settings.about.history.v357.tour" = "En omvisning på fem sider presenterer støttede nettverk, fysisk entropi, sending og mottak, sikkerhet og verifiserte bygg. Sveip eller trykk på prikkene for å bytte side; språkvelgeren ligger i navigasjonslinjen.";
"settings.about.history.v357.backup" = "Etter at du har opprettet, importert eller gjenopprettet en lommebok, vises skjermen med en gang, og sikkerhetskopialternativene bruker standardlisten. iCloud-kontrollen kjører i bakgrunnen, og Åpne lommebok er klar så snart lommeboken er lagret.";
"settings.about.history.v357.reliability" = "Å komme tilbake fra bakgrunnen lukker ikke lenger oppsettskjermen når en skjult gjenopprettingsskjerm utløper, og sletting av alle data åpner velkomstskjermen direkte.";
"settings.about.history.v357.notifications" = "Varslingsinnstillingene bruker enklere formuleringer for kategorier og status, uten tekniske detaljer.";
"settings.about.history.v357.wallets" = "Endre rekkefølgen på lommebøker i velgeren med et langt trykk og systemets løfteanimasjon; et trykk på en rad aktiverer den. Bekreftelse av gjenopprettingsfrasen nummererer hvert ord, og Retur går til neste felt.";
"settings.about.history.v357.send" = "Sending viser beløpet mens overføringen pågår, en tydeligere melding vises hvis den ikke kan sendes, og TRON-forespørsler prøves automatisk på nytt etter midlertidige leverandørfeil.";
"settings.about.history.v357.security" = "Importerte TRON-kontoer der eiertillatelsen er flyttet til en annen nøkkel, viser nå advarselen og kan ikke sende, selv når hver tillatelse bare oppgir én nøkkel. Flere kjente eksponerte gjenopprettingsfraser og private nøkler avvises ved import.";
"settings.about.history.v356.localization" = "Teksten på velkomstskjermen er nå mer naturlig og tydelig på alle støttede språk.";
"settings.about.history.v356.pricing" = "Tokenpriser samsvarer nå med det eksakte nettverket og tokenadressen, ved å bruke DEX-priser først. Små priser viser opptil 8 desimaler uten avrunding.";
"settings.about.history.v356.appearance" = "Primære og sekundære knapper bruker nå konsekvente høyder og skjermmarger, med blått system for primærhandlinger.";
"settings.about.history.v356.transactions" = "Transaksjonsdetaljer bruker en kortere bekreftet-status og klarere grå tekst for datoer, adresser, beløp og transaksjons-ID-er.";
"settings.about.history.v356.security" = "Utvidet listen over kjente eksponerte gjenopprettingsfraser og private nøkler som ikke kan importeres.";

