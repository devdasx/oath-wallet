"onboarding.carousel.passphrase.eyebrow" = "FRASE SECRETA BIP-39 OPCIONAL";
"onboarding.carousel.passphrase.title" = "Uma frase de recuperação. Um segredo adicional.";
"onboarding.carousel.passphrase.message" = "Uma frase secreta BIP-39 se combina à sua frase de recuperação para derivar outra carteira. Mesmo que as palavras de recuperação sejam expostas, o acesso a essa carteira ainda exige a frase secreta exata.";
"onboarding.carousel.passphrase.visual.phrase" = "Suas 24 palavras de recuperação";
"onboarding.carousel.passphrase.visual.passphrase" = "Sua frase secreta adicional";
"onboarding.carousel.passphrase.visual.output" = "Uma carteira distinta com frase secreta";
"onboarding.carousel.passphrase.visual.requirement" = "Os dois segredos são necessários para a recuperação";
"onboarding.carousel.passphrase.visual.accessibility" = "Uma frase de recuperação de 24 palavras e uma frase secreta BIP-39 derivam outra carteira, que exige os dois segredos para ser recuperada.";
"onboarding.carousel.passphrase.learn_more.action" = "Ver mais detalhes";
"onboarding.passphrase.learn_more.navigation" = "Compreender as frases secretas BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dois segredos derivam uma carteira";
"onboarding.passphrase.learn_more.overview" = "Uma frase secreta BIP-39 é um segredo opcional combinado à sua frase de recuperação. Juntas, elas derivam de forma determinística uma carteira diferente daquela criada apenas pela frase de recuperação.";
"onboarding.passphrase.learn_more.visual.phrase" = "Sua frase de recuperação de 24 palavras";
"onboarding.passphrase.learn_more.visual.passphrase" = "Sua frase secreta";
"onboarding.passphrase.learn_more.visual.wallet" = "Uma carteira protegida por frase secreta";
"onboarding.passphrase.learn_more.visual.accessibility" = "Uma frase de recuperação de 24 palavras e uma frase secreta se combinam para derivar outra carteira, protegida pela frase secreta.";
"onboarding.passphrase.learn_more.derivation.section" = "Como o BIP-39 deriva a carteira";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frase de recuperação combinada à frase secreta";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 em 2.048 iterações";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Semente mestra de 512 bits";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Contas e endereços derivados da carteira";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "A sua frase de recuperação e a sua frase secreta passam por 2.048 iterações de PBKDF2-HMAC-SHA512 para produzir a semente de 512 bits da qual são derivadas as contas e os endereços da carteira.";
"onboarding.passphrase.learn_more.derivation.standard" = "O BIP-39 trata a frase de recuperação normalizada como a palavra-passe do PBKDF2 e utiliza como salt a palavra “mnemonic” seguida da frase secreta normalizada. Após 2.048 iterações de PBKDF2-HMAC-SHA512, o processo produz uma semente de 64 bytes.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Antes de derivar a semente, o Oath aplica a normalização Unicode exigida pelo BIP-39. Assim, a mesma frase de recuperação normalizada e a mesma frase secreta sempre reproduzem a mesma carteira.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Uma frase secreta não encripta as suas palavras de recuperação. Altera a semente derivada, pelo que cada frase secreta diferente produz contas e endereços diferentes.";
"onboarding.passphrase.learn_more.wallets.section" = "Cada frase secreta deriva uma carteira diferente";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Exemplo de frase secreta 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Exemplo de frase secreta 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Exemplo de carteira A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Exemplo de carteira B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "A mesma frase de recuperação combinada a duas frases secretas diferentes deriva duas carteiras distintas: a Carteira A e a Carteira B.";
"onboarding.passphrase.learn_more.wallets.different" = "Alterar até um único caráter significativo deriva outra semente e, consequentemente, outra carteira; a carteira original permanece inalterada.";
"onboarding.passphrase.learn_more.wallets.empty" = "Uma frase secreta vazia abre a carteira padrão derivada apenas da frase de recuperação; uma frase secreta preenchida abre sua própria carteira separada.";
"onboarding.passphrase.learn_more.wallets.footer" = "O BIP-39 não apresenta uma resposta de “frase secreta incorreta”; toda frase secreta é válida. Por isso, um erro de digitação abre silenciosamente outra carteira, normalmente com saldo zero.";
"onboarding.passphrase.learn_more.security.section" = "Como uma frase secreta reforça a proteção";
"onboarding.passphrase.learn_more.security.words.title" = "Só as palavras de recuperação não bastam";
"onboarding.passphrase.learn_more.security.words.detail" = "Quem obtiver apenas sua frase de recuperação ainda precisará da frase secreta exata para derivar e aceder à carteira protegida.";
"onboarding.passphrase.learn_more.security.strength.title" = "Maior complexidade cria uma separação mais segura";
"onboarding.passphrase.learn_more.security.strength.detail" = "Uma frase secreta longa e imprevisível dificulta consideravelmente as tentativas de descoberta. Uma frase curta, data de aniversário, nome ou palavra-passe reutilizada pode ser descoberta rapidamente e oferece pouca proteção.";
"onboarding.passphrase.learn_more.security.separation.title" = "Mantenha a frase secreta separada";
"onboarding.passphrase.learn_more.security.separation.detail" = "Guarde a frase secreta separadamente da frase de recuperação para que uma única cópia de segurança roubada não revele os dois segredos necessários para restaurar a carteira.";
