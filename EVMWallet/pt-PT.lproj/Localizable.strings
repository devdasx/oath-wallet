"onboarding.carousel.entropy.eyebrow" = "ENTROPIA DE ENTRADAS FÍSICAS";
"onboarding.carousel.entropy.title" = "Crie uma aleatoriedade sob seu total controlo.";
"onboarding.carousel.entropy.message" = "Lance um dado, jogue uma moeda ou registe dígitos aleatórios. O Oath converte sua entrada física em exatamente 256 bits de entropia para uma frase de recuperação de 24 palavras, tudo no o seu dispositivo.";
"onboarding.carousel.entropy.visual.output" = "256 bits de entropia gerada por si";
"onboarding.carousel.entropy.visual.local" = "Gerada inteiramente a partir das entradas registadas";
"onboarding.carousel.entropy.visual.accessibility" = "Um dado numerado, uma moeda e dígitos aleatórios se combinam para produzir 256 bits de entropia da carteira neste dispositivo.";
"onboarding.carousel.entropy.learn_more.action" = "Ver mais detalhes";
"onboarding.entropy.learn_more.navigation" = "Como funciona a entropia física";
"onboarding.entropy.learn_more.path.section" = "Dos resultados físicos às palavras de recuperação";
"onboarding.entropy.learn_more.overview" = "O Oath regista os resultados da fonte física escolhida e converte-os num valor de 256 bits. Em seguida, os 32 bytes resultantes são enviados ao Wallet Core para criar uma frase de recuperação BIP-39 padrão.";
"onboarding.entropy.learn_more.visual.phrase" = "Frase de recuperação BIP-39 de 24 palavras";
"onboarding.entropy.learn_more.visual.bits" = "32 bytes × 8 bits equivalem a 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Uma grade com 256 células de bits de exemplo, organizadas em 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Lançamentos de dado, lançamentos de moeda ou dígitos aleatórios são convertidos em 256 bits e depois numa frase de recuperação BIP-39 de 24 palavras.";
"onboarding.entropy.learn_more.inputs.section" = "Etapa 1: registe os resultados físicos";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lance um dado não viciado de seis faces";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Com um dado não viciado, cada face de 1–4 contribui com 2 bits; cada face de 5–6 contribui com 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lançamentos físicos de moeda";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Cada lançamento independente de uma moeda não viciada contribui com 1 bit de entropia sem viés.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registe dígitos aleatórios";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cada dígito de 0–7 contribui com 3 bits; cada dígito de 8–9 contribui com 1 bit. Os dígitos devem vir de um processo físico realmente aleatório.";
"onboarding.entropy.learn_more.inputs.footer" = "Use uma fonte física sem viés e registe todos os resultados na ordem. Pode alternar entre os métodos, pois cada resultado aceito contribui para o mesmo fluxo de bits.";
"onboarding.entropy.learn_more.conversion.section" = "2. Monte um valor de 256 bits";
"onboarding.entropy.learn_more.conversion.mapping" = "O Oath converte resultados do dado e dígitos decimais em grupos de potências de dois sem viés. O tamanho das contribuições pode variar, mas uma fonte física sem viés não favorece nenhum valor de bit.";
"onboarding.entropy.learn_more.conversion.packing" = "O Oath acrescenta os bits pela ordem de introdução até reunir exatamente 256. Depois, compacta-os em 32 bytes, a começar pelo bit mais significativo.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "A entropia personalizada contém apenas as entradas físicas que regista; o Oath não adiciona aleatoriedade gerada pelo dispositivo.";
"onboarding.entropy.learn_more.bip39.section" = "3. Derive a frase de recuperação";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bits de entropia";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Uma soma de verificação BIP-39 de 8 bits";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits divididos em 24 índices de palavras de 11 bits";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Um valor de entropia de 256 bits recebe uma soma de verificação de 8 bits e produz 264 bits, divididos em 24 índices de palavras de 11 bits.";
"onboarding.entropy.learn_more.bip39.checksum" = "O BIP-39 calcula o SHA-256 do valor de entropia de 32 bytes e usa os primeiros 8 bits do hash como soma de verificação; anexar essa soma produz 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "Os 264 bits são divididos em 24 grupos de 11 bits. Cada grupo seleciona uma entrada da lista BIP-39 padrão de 2.048 palavras para produzir a frase de recuperação de 24 palavras.";
"onboarding.entropy.learn_more.bip39.derivation" = "O Wallet Core deriva contas e endereços determinísticos da semente resultante. A mesma frase de recuperação e a mesma frase secreta opcional sempre recriarão a mesma carteira.";
"onboarding.entropy.learn_more.security.section" = "Como a entropia personalizada reforça a segurança";
"onboarding.entropy.learn_more.security.space.title" = "Um vasto espaço de possibilidades";
"onboarding.entropy.learn_more.security.space.detail" = "A entropia uniforme de 256 bits contém 2^256 valores únicos, o que torna uma tentativa exaustiva computacionalmente inviável. Isto descreve o tamanho do espaço de entrada; não significa que todos os componentes criptográficos ofereçam resistência a ataques de 256 bits.";
"onboarding.entropy.learn_more.security.source.title" = "A aleatoriedade vem de si";
"onboarding.entropy.learn_more.security.source.detail" = "Os eventos físicos permitem gerar a aleatoriedade da carteira de forma independente, sem depender apenas do gerador de números aleatórios do dispositivo. Isto só reforça a segurança quando os eventos são verdadeiramente aleatórios.";
"onboarding.entropy.learn_more.security.local.title" = "Processado inteiramente neste dispositivo";
"onboarding.entropy.learn_more.security.local.detail" = "O Oath converte a sequência registada e cria a frase de recuperação inteiramente neste dispositivo. A sequência nunca é enviada para processamento.";
"onboarding.entropy.learn_more.security.patterns.title" = "Evite segredos escolhidos por pessoas";
"onboarding.entropy.learn_more.security.patterns.detail" = "Uma longa sequência de eventos aleatórios, equiprováveis e independentes é muito menos previsível do que aniversários, números favoritos, padrões repetidos ou palavras escolhidas por uma pessoa.";
"onboarding.entropy.learn_more.security.footer" = "A entropia física substitui a aleatoriedade da carteira gerada pelo dispositivo; ela não é uma palavra-passe adicional nem outra camada de segurança.";
"onboarding.entropy.learn_more.safety.section" = "Use este recurso com segurança";
"onboarding.entropy.learn_more.safety.fair.title" = "Registe resultados sem viés e independentes";
"onboarding.entropy.learn_more.safety.fair.detail" = "Use uma moeda ou um dado não viciado e garanta que cada resultado seja independente. Os dígitos aleatórios devem vir de uma fonte física realmente aleatória, não da memória nem de um padrão.";
"onboarding.entropy.learn_more.safety.private.title" = "Mantenha seu processo de entropia em sigilo";
"onboarding.entropy.learn_more.safety.private.detail" = "Proteja tanto a sequência registada quanto a frase de recuperação concluída como segredos da carteira. Mantenha-as fora do alcance de câmaras e de outras pessoas.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registe cada resultado com exatidão";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Um resultado ausente, duplicado ou fora de ordem cria outra carteira. Reveja cada entrada e verifique a frase de recuperação concluída antes de adicionar fundos à carteira.";
"onboarding.entropy.learn_more.safety.backup.title" = "Proteja a frase de recuperação";
"onboarding.entropy.learn_more.safety.backup.detail" = "Mantenha a frase de recuperação offline e nunca a partilhe. Depois de verificar a cópia de segurança, destrua com segurança qualquer registo intermediário das entradas que não seja mais necessário.";
"onboarding.entropy.learn_more.safety.footer" = "A entropia física não protege uma frase de recuperação exposta, um dispositivo comprometido, software malicioso nem uma sequência registada incorretamente. Se não puder garantir entradas imparciais, privadas e exatas, utilize a criação padrão da carteira.";
"onboarding.carousel.open_source.eyebrow" = "CÓDIGO ABERTO POR CONCEPÇÃO";
"onboarding.carousel.open_source.title" = "Inspecione o código-fonte. Verifique a compilação.";
"onboarding.carousel.open_source.message" = "O Oath publica o seu código-fonte para inspeção independente. Uma versão só é verificada quando uma compilação reproduzível coincide com a impressão digital da app publicada.";
