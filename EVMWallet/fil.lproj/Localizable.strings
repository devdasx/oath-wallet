"onboarding.carousel.entropy.eyebrow" = "ENTROPY MULA SA MGA PISIKAL NA INPUT";
"onboarding.carousel.entropy.title" = "Gumawa ng Randomness na Ganap Mong Kontrolado.";
"onboarding.carousel.entropy.message" = "Maghagis ng dice, mag-flip ng barya, o magtala ng mga random na digit. Kino-convert ng Oath ang iyong pisikal na input sa eksaktong 256 bits ng entropy para sa isang 24-word recovery phrase, lahat ay ginagawa sa iyong device.";
"onboarding.carousel.entropy.visual.output" = "256 Bits ng Entropy na Binuo ng User";
"onboarding.carousel.entropy.visual.local" = "Ganap na Binuo mula sa Iyong mga Itinalang Input";
"onboarding.carousel.entropy.visual.accessibility" = "Pinagsasama ang isang dice na may mga numero, isang barya, at mga random na digit para makabuo ng 256 bits ng wallet entropy sa device na ito.";
"onboarding.carousel.entropy.learn_more.action" = "Tuklasin ang Higit Pang Detalye";
"onboarding.entropy.learn_more.navigation" = "Paano Gumagana ang Pisikal na Entropy";
"onboarding.entropy.learn_more.path.section" = "Mula sa Pisikal na Resulta tungo sa mga Recovery Word";
"onboarding.entropy.learn_more.overview" = "Itinatala ng Oath ang mga resulta mula sa napili mong pisikal na source at kino-convert ang mga ito sa 256-bit na value. Pagkatapos, ipinapasa sa Wallet Core ang nabuong 32 bytes para gumawa ng karaniwang BIP-39 recovery phrase.";
"onboarding.entropy.learn_more.visual.phrase" = "Isang 24-Word BIP-39 Recovery Phrase";
"onboarding.entropy.learn_more.visual.bits" = "Ang 32 bytes × 8 bits ay 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Grid ng 256 halimbawang bit cell na nakaayos sa 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Kino-convert ang mga paghagis ng dice, pag-flip ng barya, o mga random na digit sa 256 bits at pagkatapos ay sa isang 24-word BIP-39 recovery phrase.";
"onboarding.entropy.learn_more.inputs.section" = "Hakbang 1: Magtala ng mga Pisikal na Resulta";
"onboarding.entropy.learn_more.inputs.dice.title" = "Maghagis ng Patas na Six-Sided Die";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Sa patas na die, ang bawat face na 1–4 ay nag-aambag ng 2 bits; ang bawat face na 5–6 ay nag-aambag ng 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Pisikal na Pag-flip ng Barya";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Ang bawat patas at independent na pag-flip ng barya ay nag-aambag ng 1 unbiased na bit ng entropy.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Magtala ng mga Random na Digit";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Ang bawat digit na 0–7 ay nag-aambag ng 3 bits; ang bawat digit na 8–9 ay nag-aambag ng 1 bit. Dapat manggaling ang mga digit sa isang tunay na random na pisikal na proseso.";
"onboarding.entropy.learn_more.inputs.footer" = "Gumamit ng patas na pisikal na source at itala ang bawat resulta sa tamang pagkakasunod-sunod. Maaari kang magpalit ng paraan ng pag-input dahil ang bawat tinatanggap na resulta ay nag-aambag sa iisang bit stream.";
"onboarding.entropy.learn_more.conversion.section" = "2. Bumuo ng 256-Bit na Value";
"onboarding.entropy.learn_more.conversion.mapping" = "Kino-convert ng Oath ang mga resulta ng dice at decimal digit sa mga unbiased na power-of-two group. Maaaring magkakaiba ang haba ng kontribusyon, pero walang bit value na pinapaboran ng patas na pisikal na source.";
"onboarding.entropy.learn_more.conversion.packing" = "Idinaragdag ng Oath ang mga bit sa pagkakasunod-sunod ng pagpasok hanggang eksaktong 256 ang makolekta, pagkatapos ay inilalagay ang mga ito sa 32 bytes na inuuna ang most significant bit.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Mga pisikal na input lang na itinatala mo ang nilalaman ng custom entropy; hindi ito hinahaluan ng Oath ng randomness na binuo ng device.";
"onboarding.entropy.learn_more.bip39.section" = "3. I-derive ang Recovery Phrase";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 Bits ng Entropy";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Isang 8-Bit BIP-39 Checksum";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits na hinati sa 24 na 11-bit word index";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Dinadagdagan ng 8-bit checksum ang isang 256-bit entropy value para makabuo ng 264 bits na hinahati sa 24 na 11-bit word index.";
"onboarding.entropy.learn_more.bip39.checksum" = "Kinukuwenta ng BIP-39 ang SHA-256 ng 32-byte entropy value at ginagamit ang unang 8 hash bit bilang checksum; ang pagdaragdag ng checksum na iyon ay bumubuo ng 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "Hinahati ang 264 bits sa 24 na grupo ng tig-11 bits. Pumipili ang bawat grupo ng 1 entry mula sa karaniwang 2,048-word BIP-39 list para mabuo ang 24-word recovery phrase.";
"onboarding.entropy.learn_more.bip39.derivation" = "Dina-derive ng Wallet Core mula sa nabuong seed ang mga deterministic na account at address. Palaging muling bubuuin ng parehong recovery phrase at opsyonal na passphrase ang parehong wallet.";
"onboarding.entropy.learn_more.security.section" = "Paano Pinatitibay ng Custom Entropy ang Seguridad";
"onboarding.entropy.learn_more.security.space.title" = "Napakalawak na Saklaw ng mga Posibilidad";
"onboarding.entropy.learn_more.security.space.detail" = "May 2^256 natatanging value ang uniform na 256-bit entropy, kaya hindi praktikal sa pagkuwenta ang pagsubok sa lahat ng posibilidad. Inilalarawan nito ang laki ng input space; hindi nito ipinahihiwatig na nagbibigay ng 256-bit attack resistance ang bawat cryptographic component.";
"onboarding.entropy.learn_more.security.source.title" = "Sa Iyo Nagmumula ang Randomness";
"onboarding.entropy.learn_more.security.source.detail" = "Hinahayaan ka ng mga pisikal na event na malayang pagkunan ng randomness ng wallet sa halip na umasa lang sa random-number generator ng device. Napapahusay lang nito ang seguridad kapag talagang random ang mga event.";
"onboarding.entropy.learn_more.security.local.title" = "Ganap na Pinoproseso sa Device na Ito";
"onboarding.entropy.learn_more.security.local.detail" = "Kino-convert ng Oath ang iyong itinalang sequence at ginagawa ang recovery phrase nang buo sa device na ito. Hindi kailanman ina-upload ang sequence para iproseso.";
"onboarding.entropy.learn_more.security.patterns.title" = "Iwasan ang mga Lihim na Ikaw ang Pumili";
"onboarding.entropy.learn_more.security.patterns.detail" = "Mas mahirap hulaan ang mahabang sequence ng patas at independent na mga event kaysa sa mga kaarawan, paboritong numero, paulit-ulit na pattern, o mga salitang pinili ng tao.";
"onboarding.entropy.learn_more.security.footer" = "Pinapalitan ng pisikal na entropy ang randomness ng wallet na binuo ng device; hindi ito karagdagang password o security layer.";
"onboarding.entropy.learn_more.safety.section" = "Gamitin nang Ligtas ang Feature na Ito";
"onboarding.entropy.learn_more.safety.fair.title" = "Magtala ng Patas at Independent na mga Resulta";
"onboarding.entropy.learn_more.safety.fair.detail" = "Gumamit ng patas na barya o die, at tiyaking independent ang bawat resulta. Dapat manggaling sa tunay na pisikal na source ang mga random na digit—hindi sa memorya o isang pattern.";
"onboarding.entropy.learn_more.safety.private.title" = "Panatilihing Pribado ang Buong Proseso";
"onboarding.entropy.learn_more.safety.private.detail" = "Protektahan bilang mga lihim ng wallet ang itinalang sequence at nakumpletong recovery phrase. Ilayo ang mga ito sa paningin ng mga camera at ibang tao.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Itala nang Eksakto ang Bawat Resulta";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Kapag may isang resultang nawawala, nadoble, o nagbago ang ayos, ibang wallet ang mabubuo. Suriin ang bawat entry at i-verify ang nakumpletong recovery phrase bago pondohan ang wallet.";
"onboarding.entropy.learn_more.safety.backup.title" = "Protektahan ang Recovery Phrase";
"onboarding.entropy.learn_more.safety.backup.detail" = "Panatilihing offline ang recovery phrase at huwag itong ibahagi kailanman. Pagkatapos i-verify ang iyong backup, ligtas na sirain ang anumang pansamantalang tala ng input na hindi mo na kailangan.";
"onboarding.entropy.learn_more.safety.footer" = "Hindi mapoprotektahan ng pisikal na entropy ang nakalantad na recovery phrase, nakompromisong device, mapaminsalang software, o maling naitalang sequence. Kung hindi mo matitiyak na patas, pribado, at tumpak ang mga input, gamitin na lang ang karaniwang paggawa ng wallet.";
"onboarding.carousel.open_source.eyebrow" = "DINISENYONG OPEN-SOURCE";
"onboarding.carousel.open_source.title" = "Suriin ang Source. I-verify ang Build.";
"onboarding.carousel.open_source.message" = "Inilalathala ng Oath ang source code nito para masuri nang hiwalay. Mave-verify lang ang isang release kapag tumugma sa fingerprint ng inilathalang app ang isang reproducible build.";
