// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Pinalitan ng I-slide para Ipadala ang pindutan ng kumpirmasyon. Sinusuportahan ng animasyon ng direksiyon, haptic feedback at mas maayos na galaw ang parehong direksiyon ng pagbasa. Bitawan sa 90% o higit pa para ipadala; iurong para kanselahin.";
"settings.about.history.v355.build56.activity" = "Binubuksan ng kampana ang mga nakabinbing aktibidad. May badge ng estado ang mga kapsula ng transaksiyon at maaaring i-swipe para itago. Nagtatago ang mga kinukumpirma o nakumpirmang kapsula pagkaraan ng 3 segundo; ina-update ang parehong nakikitang kapsula kapag nakumpirma.";
"settings.about.history.v355.build56.status" = "Mas maaasahang estado sa lahat ng suportadong network, agarang pag-update ng detalye ng transaksiyon at mas mabilis na pag-update ng balanse matapos magpadala. Nagpapatuloy ang pagsubaybay sa nakabinbing transaksiyon kapag binuksang muli ang app.";
"settings.about.history.v355.build56.fees" = "Nananatili ang nakuhang bayarin kapag bumalik sa pagsusuri ng parehong paglilipat. Mas malinaw ang pagkuha ng bayarin at babala sa pagpopondo ng account; wala nang abiso sa pag-activate kapag sapat ang halaga.";
"settings.about.history.v355.build56.dust" = "Idinaragdag ng Bitcoin Cash, Bitcoin, Litecoin at Dogecoin sa bayarin ang sukling mas mababa sa dust threshold sa halip na gumawa ng hindi magagamit na output. Tugma ang sinuring bayarin sa ginagamit sa pagpirma.";
"settings.about.history.v355.build56.stability" = "Inayos ang pag-crash ng gawain sa background at mga alerto sa timeout ng pag-refresh ng wallet. Nananatiling magagamit ang kasalukuyang impormasyon ng wallet kapag pansamantalang pumalya ang pag-refresh.";
"settings.about.history.v355.build56.backup" = "Mas maayos na mga backup screen, tamang pamagat sa pagbukas at mas kaunting mensahe. Iginagalang ng pag-access sa private key ang mga setting ng App Lock. Binubura ng maliliit na babalang may disenyong salamin ang tinanggihang input kapag pumili ng ibang parirala sa pagbawi.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Pagbitaw mo sa slider para magpadala, may lilitaw na animated na tsek bago magsara ang screen ng pagsusuri.";
"settings.about.history.v355.build57.activity" = "Sa mga row ng aktibidad, mas manipis ang teksto ng status, pangalawang teksto ang halaga, at may palaso para buksan ang mga detalye ng transaksyon.";
"settings.about.history.v355.build57.details" = "Makikita na ngayon ang mga bayarin sa network sa buod ng paglilipat. Mas malinaw ang mga detalye dahil sa mas maiikling label at iisang row para sa network.";
"settings.about.history.v355.build57.resume" = "Kapag bumalik mula sa background, mananatili ang mga bukas na screen at panel, kasama ang pagsusuri ng paglilipat at mga detalye ng transaksyon.";
"settings.about.history.v355.build57.secrets" = "Magsasara ang mga screen ng recovery phrase, private key at passphrase kapag 20 segundo kang wala sa app. Patuloy na susundin ng lock ng app ang mga setting mo.";
"settings.about.history.v355.build57.filters" = "Gumagamit ang mga filter ng network ng bahagyang mas matataas na native na button, laki na naaayon sa nilalaman at inayos na espasyo sa ilalim ng navigation bar.";
"settings.about.history.v355.build57.units" = "Inalis ang magkahiwalay na row ng halaga. Lokal na pera muna ang ipinapakita sa halaga at bayarin sa network; i-tap ang alinman para lumipat sa crypto unit at bumalik.";
"wallet.transaction.details.toggle_units" = "Palitan ang yunit.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Bumubukas ang Home nang walang pag-fade o pagbabago ng laki. Gear icon na ngayon ang gamit ng button ng Mga Setting.";
"settings.about.history.v355.build58.fields" = "Karaniwang kulay ng text na ang gamit ng mga field sa transaksyon at pagpapadala. May arrow lang ang mga row na nagbubukas ng screen o panel; maaari pa ring palitan ang unit sa pamamagitan ng pag-tap sa halaga o bayarin.";
"settings.about.history.v355.build58.banners" = "Kapag naipakita na, nawawala ang mga banner ng kasalukuyan o tapos nang pagkumpirma pagkalipas ng 3 segundo, kahit magbukas ka ng ibang screen. Lalabas sa pagbalik mo ang mga kumpirmasyong hindi pa naipakita.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Inilalaan na ngayon ng mga TRON transfer ang bayad sa pag-activate at bandwidth bago kalkulahin ang halagang ipapadala, kahit kapag pinili ang pinakamataas na halaga. Ipinapakita sa pagsusuri ang tamang halaga matapos ibawas ang mga bayad.";
"settings.about.history.v355.build59.fees" = "Dapat sapat ang pasadyang bayad sa TRON para sa mga kinakailangang gastos sa network. Mas malinaw na ngayon ang gabay kapag mababa ang balanseng TRX. Hindi nagbabago ang dami ng token; sa TRX binabayaran ang mga bayad.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Isang bagong pagtanggap";
"settings.about.history.v356.welcome" = "Isang bagong welcome screen na may animated na likhang sining at malinaw na mga opsyon para gumawa o mag-import ng wallet.";
"settings.about.history.v357.tour.title" = "Panimulang paglilibot";
"settings.about.history.v357.tour" = "Isang limang-pahinang tour ang nagpapakilala sa mga suportadong network, physical entropy, pagpapadala at pagtanggap, seguridad, at mga na-verify na build. Mag-swipe o i-tap ang mga tuldok para lumipat ng pahina; nasa navigation bar ang pagpapalit ng wika.";
"settings.about.history.v357.backup" = "Pagkatapos gumawa, mag-import, o mag-restore ng wallet, agad na lumalabas ang screen at ginagamit ng mga opsyon sa backup ang karaniwang listahan. Tumatakbo sa background ang pagsusuri ng iCloud, at handa na ang Buksan ang Wallet sa sandaling ma-save ang wallet.";
"settings.about.history.v357.reliability" = "Hindi na isinasara ng pagbabalik mula sa background ang setup screen kapag nag-expire ang nakatagong recovery screen, at direktang binubuksan ng pagbura ng lahat ng data ang welcome screen.";
"settings.about.history.v357.notifications" = "Gumagamit ang mga setting ng notification ng mas simpleng salita para sa mga kategorya at status, nang walang teknikal na detalye.";
"settings.about.history.v357.wallets" = "Ayusin muli ang mga wallet sa switcher gamit ang matagal na pagpindot at ang lift animation ng system; ang pag-tap sa row ay nagpapagana nito. Binibilang ng pag-verify ng recovery phrase ang bawat salita, at lumilipat ang Return sa susunod na field.";
"settings.about.history.v357.send" = "Ipinapakita ng pagpapadala ang halaga habang isinasagawa ang paglilipat, lumalabas ang mas malinaw na mensahe kung hindi ito maipadala, at awtomatikong sinusubukang muli ang mga TRON request pagkatapos ng pansamantalang error ng provider.";
"settings.about.history.v357.security" = "Ang mga na-import na TRON account na ang pahintulot ng may-ari ay inilipat sa ibang key ay nagpapakita na ngayon ng babala at hindi makakapagpadala, kahit isang key lang ang nakalista sa bawat pahintulot. Mas maraming kilalang nakalantad na recovery phrase at private key ang tinatanggihan sa pag-import.";
"settings.about.history.v356.localization" = "Mas malinaw at natural na ang mga teksto sa welcome screen sa lahat ng suportadong wika.";
"settings.about.history.v356.pricing" = "Ang mga presyo ng token ay tumutugma na ngayon sa eksaktong network at token address, gamit muna ang mga presyo ng DEX. Ang maliliit na presyo ay nagpapakita ng hanggang 8 decimal na lugar nang walang pag-ikot.";
"settings.about.history.v356.appearance" = "Gumagamit na ngayon ang mga pangunahin at pangalawang button ng pare-parehong taas at mga margin ng screen, na may system blue para sa mga pangunahing aksyon.";
"settings.about.history.v356.transactions" = "Gumagamit ang mga detalye ng transaksyon ng mas maikling status na Nakumpirma at mas malinaw na gray na text para sa mga petsa, address, halaga, at transaction ID.";
"settings.about.history.v356.security" = "Pinalawak ang listahan ng mga kilalang nakalantad na mga parirala sa pagbawi at pribadong key na hindi ma-import.";

