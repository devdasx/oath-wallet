"onboarding.carousel.passphrase.eyebrow" = "OPSYONAL NA BIP-39 PASSPHRASE";
"onboarding.carousel.passphrase.title" = "Isang Recovery Phrase. Isang Karagdagang Lihim.";
"onboarding.carousel.passphrase.message" = "Pinagsasama ang BIP-39 passphrase at iyong recovery phrase para mag-derive ng hiwalay na wallet. Kahit malantad ang mga recovery word, kailangan pa rin ang eksaktong passphrase para ma-access ang wallet na iyon.";
"onboarding.carousel.passphrase.visual.phrase" = "Iyong 24 Recovery Word";
"onboarding.carousel.passphrase.visual.passphrase" = "Iyong Karagdagang Lihim na Passphrase";
"onboarding.carousel.passphrase.visual.output" = "Isang Natatanging Passphrase Wallet";
"onboarding.carousel.passphrase.visual.requirement" = "Kailangan ang Parehong Lihim para sa Recovery";
"onboarding.carousel.passphrase.visual.accessibility" = "Nagde-derive ang 24-word recovery phrase at lihim na BIP-39 passphrase ng hiwalay na wallet na nangangailangan ng parehong lihim para sa recovery.";
"onboarding.carousel.passphrase.learn_more.action" = "Tuklasin ang Higit Pang Detalye";
"onboarding.passphrase.learn_more.navigation" = "Pag-unawa sa mga BIP-39 Passphrase";
"onboarding.passphrase.learn_more.path.section" = "Dalawang Lihim ang Nagde-derive ng Isang Wallet";
"onboarding.passphrase.learn_more.overview" = "Ang BIP-39 passphrase ay opsyonal na lihim na isinasama sa iyong recovery phrase. Magkasama nilang deterministic na dine-derive ang wallet na naiiba sa ginawa gamit ang recovery phrase lang.";
"onboarding.passphrase.learn_more.visual.phrase" = "Iyong 24-Word Recovery Phrase";
"onboarding.passphrase.learn_more.visual.passphrase" = "Iyong Lihim na Passphrase";
"onboarding.passphrase.learn_more.visual.wallet" = "Wallet na Protektado ng Passphrase";
"onboarding.passphrase.learn_more.visual.accessibility" = "Pinagsasama ang 24-word recovery phrase at lihim na passphrase para mag-derive ng hiwalay na wallet na protektado ng passphrase.";
"onboarding.passphrase.learn_more.derivation.section" = "Paano Dina-derive ng BIP-39 ang Wallet";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Recovery Phrase na Pinagsama sa Passphrase";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 na may 2,048 Round";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bit na Master Seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Mga Na-derive na Wallet Account at Address";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Dumadaan ang iyong recovery phrase at passphrase sa 2,048 round ng PBKDF2-HMAC-SHA512 para buuin ang 512-bit seed kung saan dine-derive ang mga wallet account at address.";
"onboarding.passphrase.learn_more.derivation.standard" = "Itinuturing ng BIP-39 ang normalized recovery phrase bilang PBKDF2 password at ginagamit bilang salt ang salitang “mnemonic” na sinusundan ng normalized passphrase. Pagkatapos ng 2,048 round ng PBKDF2-HMAC-SHA512, bumubuo ang proseso ng 64-byte seed.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Bago i-derive ang seed, inilalapat ng Oath ang Unicode normalization na hinihingi ng BIP-39 para palaging muling mabuo ng parehong normalized recovery phrase at passphrase ang parehong wallet.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Hindi ine-encrypt ng passphrase ang iyong mga recovery word. Binabago nito ang na-derive na seed, kaya nagbubunga ng magkakaibang account at address ang bawat magkaibang passphrase.";
"onboarding.passphrase.learn_more.wallets.section" = "Bawat Passphrase ay Nagde-derive ng Hiwalay na Wallet";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Halimbawang Passphrase 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Halimbawang Passphrase 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Halimbawang Wallet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Halimbawang Wallet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Nagde-derive ng dalawang hiwalay na wallet—Wallet A at Wallet B—ang parehong recovery phrase na pinagsama sa dalawang magkaibang passphrase.";
"onboarding.passphrase.learn_more.wallets.different" = "Ang pagbabago ng kahit isang character ay nagde-derive ng ibang seed at samakatuwid ay ibang wallet; hindi nagbabago ang orihinal na wallet.";
"onboarding.passphrase.learn_more.wallets.empty" = "Binubuksan ng walang lamang passphrase ang karaniwang wallet na na-derive sa recovery phrase lang; binubuksan naman ng passphrase na may laman ang sarili nitong hiwalay na wallet.";
"onboarding.passphrase.learn_more.wallets.footer" = "Walang tugon na “maling passphrase” ang BIP-39; valid ang bawat passphrase, kaya tahimik na nagbubukas ng ibang wallet ang isang typo—karaniwan ay zero ang balance.";
"onboarding.passphrase.learn_more.security.section" = "Paano Nagdaragdag ng Proteksyon ang Passphrase";
"onboarding.passphrase.learn_more.security.words.title" = "Hindi Sapat ang mga Recovery Word Lang";
"onboarding.passphrase.learn_more.security.words.detail" = "Kailangan pa rin ng eksaktong passphrase para ma-derive at ma-access ang protektadong wallet, kahit makuha ng isang tao ang iyong recovery phrase.";
"onboarding.passphrase.learn_more.security.strength.title" = "Mas Malakas, Mas Mahusay ang Pagkakahiwalay";
"onboarding.passphrase.learn_more.security.strength.detail" = "Lubhang pinahihirap ng mahaba at hindi nahuhulaang passphrase ang paghula; maaaring mabilis hulaan ang maikling sipi, kaarawan, pangalan, o muling ginamit na password at kaunti lang ang proteksyong ibinibigay nito.";
"onboarding.passphrase.learn_more.security.separation.title" = "Panatilihing Hiwalay ang Passphrase";
"onboarding.passphrase.learn_more.security.separation.detail" = "Itago ang passphrase nang hiwalay sa recovery phrase para hindi maibunyag ng iisang ninakaw na backup ang dalawang lihim na kailangan para i-restore ang wallet.";
"onboarding.passphrase.learn_more.security.footer" = "Hindi mapoprotektahan ng passphrase ang iyong mga pondo kung malantad ang parehong lihim, mahina ang passphrase, o makuha ito ng nakompromisong software habang tina-type mo.";
"onboarding.passphrase.learn_more.safety.section" = "Gamitin nang Ligtas ang Feature na Ito";
"onboarding.passphrase.learn_more.safety.strong.title" = "Gumawa ng Malakas at Natatanging Passphrase";
