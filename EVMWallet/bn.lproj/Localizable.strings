"onboarding.carousel.passphrase.message" = "BIP-39 পাসফ্রেজ আপনার রিকভারি ফ্রেজের সঙ্গে মিলে একটি আলাদা ওয়ালেট তৈরি করে। রিকভারি শব্দ প্রকাশ পেলেও সেই ওয়ালেটে ঢুকতে সঠিক পাসফ্রেজটি লাগবে।";
