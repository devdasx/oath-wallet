"onboarding.entropy.learn_more.inputs.dice.detail" = "নিরপেক্ষ পাশার 1–4 প্রতিটি ফলাফল 2 বিট এবং 5–6 প্রতিটি ফলাফল 1 বিট যোগ করে।";
"onboarding.entropy.learn_more.inputs.coin.title" = "কয়েনের ভৌত টস";
"onboarding.entropy.learn_more.inputs.coin.detail" = "নিরপেক্ষ কয়েনের প্রতিটি স্বাধীন টস 1 বিট পক্ষপাতহীন এনট্রপি যোগ করে।";
"onboarding.entropy.learn_more.inputs.digits.title" = "র‍্যান্ডম অঙ্ক রেকর্ড করুন";
"onboarding.entropy.learn_more.inputs.digits.detail" = "0–7 প্রতিটি অঙ্ক 3 বিট এবং 8–9 প্রতিটি অঙ্ক 1 বিট যোগ করে। অঙ্কগুলো অবশ্যই সত্যিকারের র‍্যান্ডম ভৌত প্রক্রিয়া থেকে আসতে হবে।";
"onboarding.entropy.learn_more.inputs.footer" = "একটি নিরপেক্ষ ভৌত উৎস ব্যবহার করে প্রতিটি ফলাফল ক্রমানুসারে রেকর্ড করুন। ইনপুট পদ্ধতি বদলাতে পারেন, কারণ গৃহীত প্রতিটি ফলাফল একই বিট স্ট্রিমে যোগ হয়।";
"onboarding.entropy.learn_more.conversion.section" = "ধাপ 2: একটি 256-বিট মান তৈরি করুন";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath পাশার ফলাফল ও দশমিক অঙ্ককে পক্ষপাতহীন 2-এর ঘাতভিত্তিক গ্রুপে রূপান্তর করে। অবদানের দৈর্ঘ্য ভিন্ন হতে পারে, তবে নিরপেক্ষ ভৌত উৎস কোনো বিট মানের প্রতি পক্ষপাত করে না।";
"onboarding.entropy.learn_more.conversion.packing" = "ঠিক 256 বিট সংগ্রহ না হওয়া পর্যন্ত Oath লেখা ক্রমে বিট যোগ করে, তারপর সর্বোচ্চ তাৎপর্যপূর্ণ বিট আগে রেখে সেগুলোকে 32 বাইটে প্যাক করে।";
"onboarding.entropy.learn_more.conversion.no_mixing" = "কাস্টম এনট্রপিতে শুধু আপনার রেকর্ড করা ভৌত ইনপুট থাকে; Oath এতে ডিভাইসের তৈরি র‍্যান্ডমনেস মেশায় না।";
"onboarding.entropy.learn_more.bip39.section" = "ধাপ 3: রিকভারি ফ্রেজ তৈরি করুন";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 বিট এনট্রপি";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-বিটের BIP-39 চেকসাম";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 বিটকে 24টি 11-বিট শব্দ সূচকে ভাগ করা হয়েছে";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "একটি 256-বিট এনট্রপি মানে 8-বিট চেকসাম যোগ করে 264 বিট তৈরি হয়, যা 24টি 11-বিট শব্দ সূচকে ভাগ হয়।";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 32-বাইট এনট্রপি মানের ওপর SHA-256 হিসাব করে হ্যাশের প্রথম 8 বিটকে চেকসাম হিসেবে নেয়; সেই চেকসাম যোগ করলে 264 বিট হয়।";
"onboarding.entropy.learn_more.bip39.words" = "264 বিটকে 11 বিটের 24টি গ্রুপে ভাগ করা হয়। প্রতিটি গ্রুপ আদর্শ 2,048-শব্দের BIP-39 তালিকা থেকে একটি এন্ট্রি বেছে নিয়ে 24-শব্দের রিকভারি ফ্রেজ তৈরি করে।";
"onboarding.entropy.learn_more.bip39.derivation" = "ফলাফলের সিড থেকে Wallet Core নির্ধারিতভাবে অ্যাকাউন্ট ও ঠিকানা তৈরি করে। একই রিকভারি ফ্রেজ ও ঐচ্ছিক পাসফ্রেজ সব সময় একই ওয়ালেট পুনরায় তৈরি করবে।";
"onboarding.entropy.learn_more.security.section" = "কাস্টম এনট্রপি যেভাবে নিরাপত্তা বাড়ায়";
"onboarding.entropy.learn_more.security.space.title" = "সম্ভাবনার বিশাল পরিসর";
"onboarding.entropy.learn_more.security.space.detail" = "সমভাবে বিতরিত 256-বিট এনট্রপিতে 2^256টি অনন্য মান থাকে, তাই সব সম্ভাবনা পরীক্ষা করে অনুমান করা কম্পিউটেশনগতভাবে অসম্ভব। এটি ইনপুট পরিসরের আকার বোঝায়; প্রতিটি ক্রিপ্টোগ্রাফিক উপাদান 256-বিট আক্রমণ প্রতিরোধ দেয়, এমনটি বোঝায় না।";
"onboarding.entropy.learn_more.security.source.title" = "র‍্যান্ডমনেস আসে আপনার কাছ থেকে";
"onboarding.entropy.learn_more.security.source.detail" = "ভৌত ঘটনা ব্যবহার করে কেবল ডিভাইসের র‍্যান্ডম নম্বর জেনারেটরের ওপর নির্ভর না করে আপনি স্বাধীনভাবে ওয়ালেটের র‍্যান্ডমনেসের উৎস তৈরি করতে পারেন। ঘটনাগুলো সত্যিকার অর্থে র‍্যান্ডম হলেই এতে নিরাপত্তা বাড়ে।";
"onboarding.entropy.learn_more.security.local.title" = "সম্পূর্ণ এই ডিভাইসে প্রক্রিয়াকৃত";
"onboarding.entropy.learn_more.security.local.detail" = "Oath আপনার রেকর্ড করা ক্রমকে রূপান্তর করে সম্পূর্ণ এই ডিভাইসেই রিকভারি ফ্রেজ তৈরি করে। প্রক্রিয়াকরণের জন্য আপনার ক্রম কখনো আপলোড করা হয় না।";
"onboarding.entropy.learn_more.security.patterns.title" = "মানুষের বেছে নেওয়া গোপন তথ্য এড়িয়ে চলুন";
"onboarding.entropy.learn_more.security.patterns.detail" = "নিরপেক্ষ ও স্বাধীন ঘটনার দীর্ঘ ক্রম জন্মদিন, প্রিয় সংখ্যা, পুনরাবৃত্ত প্যাটার্ন বা মানুষের বেছে নেওয়া শব্দের চেয়ে অনেক কম অনুমানযোগ্য।";
"onboarding.entropy.learn_more.security.footer" = "ভৌত এনট্রপি ডিভাইসের তৈরি ওয়ালেট র‍্যান্ডমনেসের বিকল্প; এটি অতিরিক্ত পাসওয়ার্ড বা নিরাপত্তার আরেকটি স্তর নয়।";
"onboarding.entropy.learn_more.safety.section" = "এই সুবিধা নিরাপদে ব্যবহার করুন";
"onboarding.entropy.learn_more.safety.fair.title" = "নিরপেক্ষ, স্বাধীন ফলাফল রেকর্ড করুন";
"onboarding.entropy.learn_more.safety.fair.detail" = "নিরপেক্ষ কয়েন বা পাশা ব্যবহার করুন এবং প্রতিটি ফলাফল স্বাধীন কিনা নিশ্চিত করুন। র‍্যান্ডম অঙ্ক অবশ্যই সত্যিকারের ভৌত উৎস থেকে আসতে হবে—স্মৃতি বা কোনো প্যাটার্ন থেকে নয়।";
"onboarding.entropy.learn_more.safety.private.title" = "এনট্রপি তৈরির প্রক্রিয়া গোপন রাখুন";
"onboarding.entropy.learn_more.safety.private.detail" = "রেকর্ড করা ক্রম ও সম্পূর্ণ রিকভারি ফ্রেজ—দুটিকেই ওয়ালেটের গোপন তথ্য হিসেবে সুরক্ষিত রাখুন। ক্যামেরা ও অন্য মানুষের দৃষ্টির বাইরে রাখুন।";
"onboarding.entropy.learn_more.safety.accurate.title" = "প্রতিটি ফলাফল সঠিকভাবে রেকর্ড করুন";
"onboarding.entropy.learn_more.safety.accurate.detail" = "একটি ফলাফল বাদ পড়লে, নকল হলে বা ক্রম বদলালে আলাদা ওয়ালেট তৈরি হয়। প্রতিটি এন্ট্রি পর্যালোচনা করুন এবং ওয়ালেটে অর্থ যোগ করার আগে সম্পূর্ণ রিকভারি ফ্রেজ যাচাই করুন।";
"onboarding.entropy.learn_more.safety.backup.title" = "রিকভারি ফ্রেজ সুরক্ষিত রাখুন";
"onboarding.entropy.learn_more.safety.backup.detail" = "রিকভারি ফ্রেজ অফলাইনে রাখুন এবং কখনো শেয়ার করবেন না। ব্যাকআপ যাচাই করার পর আর প্রয়োজন নেই এমন মধ্যবর্তী ইনপুট রেকর্ড নিরাপদে ধ্বংস করুন।";
"onboarding.entropy.learn_more.safety.footer" = "প্রকাশিত রিকভারি ফ্রেজ, আপসকৃত ডিভাইস, ক্ষতিকর সফটওয়্যার বা ভুলভাবে রেকর্ড করা ক্রমকে ভৌত এনট্রপি সুরক্ষিত করতে পারে না। নিরপেক্ষ, গোপন ও নির্ভুল ইনপুট নিশ্চিত করতে না পারলে সাধারণ ওয়ালেট তৈরির পদ্ধতি ব্যবহার করুন।";
"onboarding.carousel.open_source.eyebrow" = "পরিকল্পনাতেই ওপেন সোর্স";
"onboarding.carousel.open_source.title" = "সোর্স পরীক্ষা করুন। বিল্ড যাচাই করুন।";
"onboarding.carousel.open_source.message" = "স্বাধীনভাবে পরীক্ষার জন্য Oath তার সোর্স কোড প্রকাশ করে। পুনরুৎপাদনযোগ্য বিল্ড প্রকাশিত অ্যাপের ফিঙ্গারপ্রিন্টের সঙ্গে মিললেই কেবল রিলিজটি যাচাইকৃত হয়।";
