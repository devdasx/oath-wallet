"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-বিট মাস্টার সিড";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "উৎপন্ন ওয়ালেট অ্যাকাউন্ট ও ঠিকানা";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "আপনার রিকভারি ফ্রেজ ও পাসফ্রেজ PBKDF2-HMAC-SHA512-এর 2,048 রাউন্ড অতিক্রম করে 512-বিট সিড তৈরি করে, যেখান থেকে ওয়ালেট অ্যাকাউন্ট ও ঠিকানা উৎপন্ন হয়।";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 স্বাভাবিকীকৃত রিকভারি ফ্রেজকে PBKDF2 পাসওয়ার্ড হিসেবে এবং “mnemonic”-এর পরে স্বাভাবিকীকৃত পাসফ্রেজকে সল্ট হিসেবে ব্যবহার করে। PBKDF2-HMAC-SHA512-এর 2,048 রাউন্ডের পর প্রক্রিয়াটি 64-বাইট সিড তৈরি করে।";
"onboarding.passphrase.learn_more.derivation.normalization" = "সিড তৈরির আগে Oath BIP-39-এ নির্ধারিত Unicode স্বাভাবিকীকরণ প্রয়োগ করে, ফলে একই স্বাভাবিকীকৃত রিকভারি ফ্রেজ ও পাসফ্রেজ সব সময় একই ওয়ালেট পুনরায় তৈরি করে।";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "পাসফ্রেজ আপনার রিকভারি শব্দগুলো এনক্রিপ্ট করে না। এটি উৎপন্ন সিড বদলে দেয়, তাই প্রতিটি আলাদা পাসফ্রেজ আলাদা অ্যাকাউন্ট ও ঠিকানা তৈরি করে।";
"onboarding.passphrase.learn_more.wallets.section" = "প্রতিটি পাসফ্রেজ আলাদা ওয়ালেট তৈরি করে";
"onboarding.passphrase.learn_more.wallets.visual.one" = "উদাহরণ পাসফ্রেজ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "উদাহরণ পাসফ্রেজ 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "উদাহরণ ওয়ালেট A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "উদাহরণ ওয়ালেট B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "একই রিকভারি ফ্রেজের সঙ্গে দুটি আলাদা পাসফ্রেজ মেলালে দুটি আলাদা ওয়ালেট তৈরি হয়: ওয়ালেট A ও ওয়ালেট B।";
"onboarding.passphrase.learn_more.wallets.different" = "অর্থবহ একটি অক্ষর বদলালেও আলাদা সিড এবং তাই আলাদা ওয়ালেট তৈরি হয়; মূল ওয়ালেট অপরিবর্তিত থাকে।";
"onboarding.passphrase.learn_more.wallets.empty" = "খালি পাসফ্রেজ কেবল রিকভারি ফ্রেজ থেকে তৈরি আদর্শ ওয়ালেট খোলে; খালি নয় এমন পাসফ্রেজ তার নিজস্ব আলাদা ওয়ালেট খোলে।";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39-এ “ভুল পাসফ্রেজ” বলে কোনো প্রতিক্রিয়া নেই; প্রতিটি পাসফ্রেজ বৈধ, তাই টাইপো হলে নীরবে অন্য একটি ওয়ালেট খোলে—সাধারণত শূন্য ব্যালেন্সের।";
"onboarding.passphrase.learn_more.security.section" = "পাসফ্রেজ যেভাবে সুরক্ষা যোগ করে";
"onboarding.passphrase.learn_more.security.words.title" = "শুধু রিকভারি শব্দ যথেষ্ট নয়";
"onboarding.passphrase.learn_more.security.words.detail" = "কেবল আপনার রিকভারি ফ্রেজ পাওয়া ব্যক্তিরও সুরক্ষিত ওয়ালেট তৈরি করে তাতে ঢুকতে সঠিক পাসফ্রেজটি প্রয়োজন।";
"onboarding.passphrase.learn_more.security.strength.title" = "শক্তিশালী পাসফ্রেজ ওয়ালেটকে আরও স্বতন্ত্র রাখে";
"onboarding.passphrase.learn_more.security.strength.detail" = "দীর্ঘ, অপ্রত্যাশিত পাসফ্রেজ অনুমান করা যথেষ্ট কঠিন করে; ছোট উদ্ধৃতি, জন্মদিন, নাম বা পুনর্ব্যবহৃত পাসওয়ার্ড দ্রুত অনুমান করা যেতে পারে এবং সামান্য সুরক্ষা দেয়।";
"onboarding.passphrase.learn_more.security.separation.title" = "পাসফ্রেজ আলাদা রাখুন";
"onboarding.passphrase.learn_more.security.separation.detail" = "পাসফ্রেজটি রিকভারি ফ্রেজ থেকে আলাদা জায়গায় রাখুন, যেন একটি ব্যাকআপ চুরি হলেও ওয়ালেট পুনরুদ্ধারের জন্য প্রয়োজনীয় দুটি গোপন তথ্য একসঙ্গে প্রকাশ না পায়।";
"onboarding.passphrase.learn_more.security.footer" = "দুটি গোপন তথ্যই প্রকাশ পেলে, পাসফ্রেজ দুর্বল হলে বা লেখার সময় আপসকৃত সফটওয়্যার সেটি ধরে ফেললে পাসফ্রেজ আপনার তহবিল সুরক্ষিত রাখতে পারবে না।";
"onboarding.passphrase.learn_more.safety.section" = "এই সুবিধা নিরাপদে ব্যবহার করুন";
"onboarding.passphrase.learn_more.safety.strong.title" = "শক্তিশালী, অনন্য পাসফ্রেজ তৈরি করুন";
"onboarding.passphrase.learn_more.safety.strong.detail" = "এই ওয়ালেটের জন্য অনন্য কয়েকটি র‍্যান্ডম শব্দ বা অন্য কোনো উচ্চ-এনট্রপি মান বেছে নিন। ব্যক্তিগত তথ্য, পরিচিত বাক্যাংশ, প্যাটার্ন এবং অন্যত্র ব্যবহৃত পাসওয়ার্ড এড়িয়ে চলুন।";
"onboarding.passphrase.learn_more.safety.backup.title" = "পাসফ্রেজ আলাদাভাবে ব্যাকআপ নিন";
"onboarding.passphrase.learn_more.safety.backup.detail" = "সঠিক পাসফ্রেজের টেকসই অফলাইন কপি তৈরি করে রিকভারি ফ্রেজ থেকে আলাদা জায়গায় রাখুন এবং কখনো শুধু স্মৃতির ওপর নির্ভর করবেন না।";
"onboarding.passphrase.learn_more.safety.exact.title" = "প্রতিটি অক্ষর ওয়ালেট বদলে দেয়";
"onboarding.passphrase.learn_more.safety.exact.detail" = "বড় হাতের প্রতিটি অক্ষর, স্পেস, বিরামচিহ্ন ও শব্দসহ পাসফ্রেজটি ঠিক যেভাবে তৈরি করেছিলেন সেভাবে আবার লিখুন। যেকোনো পার্থক্য নীরবে অন্য একটি ওয়ালেট তৈরি করে।";
"onboarding.passphrase.learn_more.safety.verify.title" = "তহবিল যোগ করার আগে পুনরুদ্ধার যাচাই করুন";
"onboarding.passphrase.learn_more.safety.verify.detail" = "উল্লেখযোগ্য পরিমাণ তহবিল গ্রহণের আগে, গোপন ও নিয়ন্ত্রিত পুনরুদ্ধার পরীক্ষায় নিশ্চিত করুন যে রিকভারি ফ্রেজ ও পাসফ্রেজ প্রত্যাশিত ঠিকানাগুলো আবার তৈরি করে।";
"onboarding.passphrase.learn_more.safety.footer" = "হারানো পাসফ্রেজ কোনো পরিষেবাই রিসেট বা পুনরুদ্ধার করতে পারে না। সঠিক পাসফ্রেজ ছাড়া ওই ওয়ালেটে প্রবেশাধিকার স্থায়ীভাবে হারিয়ে যায়—রিকভারি ফ্রেজ আপনার কাছে থাকলেও।";
