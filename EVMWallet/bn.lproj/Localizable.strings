"onboarding.passphrase.learn_more.overview" = "BIP-39 পাসফ্রেজ হলো আপনার রিকভারি ফ্রেজের সঙ্গে যুক্ত একটি ঐচ্ছিক গোপন তথ্য। দুটো মিলে নির্ধারিতভাবে এমন একটি ওয়ালেট তৈরি করে, যা কেবল রিকভারি ফ্রেজ দিয়ে তৈরি ওয়ালেট থেকে আলাদা।";
