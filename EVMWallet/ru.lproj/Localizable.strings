// Version 3.5.2 release notes.
"settings.about.history.v352.typing.title" = "Ввод и редактирование";
"settings.about.history.v352.navigation.title" = "Навигация по формам";
"settings.about.history.v352.icon.title" = "Значок приложения";
"settings.about.history.v352.recovery" = "Пронумерованные капсулы слов растут при вводе, плавно анимируются, получают пунктирную рамку при редактировании и сохраняют положение при удалении слов.";
"settings.about.history.v352.typing" = "Автофокус, дополнение в строке пробелом или вводом, двухэтапное редактирование клавишей удаления, удаление удержанием и автопрокрутка. Ввод скрывает клавиатуру только при корректной фразе.";
"settings.about.history.v352.passphrase" = "Первое поле парольной фразы фокусируется автоматически. Ввод переводит к проверке, затем скрывает клавиатуру. Возвращено сохранение кнопкой с галочкой.";
"settings.about.history.v352.navigation" = "Подтверждённый ввод сохраняется при возврате в рамках процесса; его закрытие очищает незавершённые записи.";
"settings.about.history.v352.scanner" = "Сканирование QR открывает отдельное окно камеры с системной кнопкой закрытия.";
"settings.about.history.v352.recipients" = "Пустая история получателей больше не показывает ошибку или предложение повторить попытку.";
"settings.about.history.v352.amount" = "Нажмите капсулу пересчёта для переключения между местной валютой и нативными единицами; она показывает эквивалентную сумму в другой единице.";
"settings.about.history.v352.visibility" = "Адреса и идентификаторы транзакций остаются видимыми после аутентификации или переключения приложений. Длинные значения переносятся без добавления дефисов.";
"settings.about.history.v352.op_return" = "Сообщения Bitcoin поддерживают до 99,994 байт UTF-8 в пределах ограничений транзакции. Исправлена подпись максимальной суммы; длинные сообщения занимают три строки и полностью открываются в отдельном окне.";
"settings.about.history.v352.repeat" = "Повторная отправка сначала проверяет средства и показывает диалог о недостаточном балансе до начала нового перевода.";
"settings.about.history.v352.sharing" = "Для отправки идентификатора транзакции теперь используется отдельная корректно переведённая подпись.";
"settings.about.history.v352.localization" = "Исправлены непереведённые и устаревшие подписи, подсказки полей и названия сетей на всех 57 языках; усилены проверки локализации.";
"settings.about.history.v352.icon" = "Исправлена прозрачность значка для распространения через App Store с сохранением исходного оформления.";
"settings.about.history.v352.backup" = "Существующие резервные копии iCloud можно заменить после подтверждения.";

"settings.about.history.v352.build48" = "Сборка 48: Добавлены переведённые примечания к выпуску. Удалены экспорт журналов производительности и ведение журналов для разработчиков. Старые диагностические файлы удаляются автоматически.";

"settings.about.history.v352.build49" = "Сборка 49: Упрощены примечания к выпуску в истории версий.";

"send.submit.error.tron_signature" = "TRON не удалось проверить подпись транзакции. Проверьте разрешения на подписание для аккаунта: могут потребоваться дополнительные подписи или другой авторизованный ключ.";

"tron.permissions.warning.title" = "Кошелёк TRON с мультиподписью";
"tron.permissions.warning.body" = "Для этого кошелька требуется несколько подписей TRON. Отправка, получение и действия с кошельком отключены в этом приложении.\n\nМультиподпись может использоваться законно. Если кто-то передал вам этот кошелёк, не вносите TRX для разблокировки его токенов. Этот человек может контролировать нужные подписи и украсть внесённые средства.";
"tron.permissions.unavailable" = "Не удалось проверить разрешения на подписание TRON.";

