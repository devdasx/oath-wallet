"onboarding.carousel.entropy.eyebrow" = "ENTROPIA Z FYZICKÝCH VSTUPOV";
"onboarding.carousel.entropy.title" = "Vytvorte náhodnosť, ktorú plne ovládate.";
"onboarding.carousel.entropy.message" = "Hoďte kockami, mincou alebo zaznamenajte náhodné číslice. Oath prevedie váš fyzický vstup na presne 256 bitov entropie pre 24-slovnú obnovovaciu frázu, a to výlučne na vašom zariadení.";
"onboarding.carousel.entropy.visual.output" = "256 bitov entropie generovanej používateľom";
"onboarding.carousel.entropy.visual.local" = "Generované výlučne z vašich zaznamenaných vstupov";
"onboarding.carousel.entropy.visual.accessibility" = "Očíslovaná kocka, minca a náhodné číslice sa spoja a vytvoria 256 bitov entropie peňaženky na tomto zariadení.";
"onboarding.carousel.entropy.learn_more.action" = "Preskúmajte viac podrobností";
"onboarding.entropy.learn_more.navigation" = "Ako funguje fyzická entropia";
"onboarding.entropy.learn_more.path.section" = "Od fyzických výsledkov k obnovovacím slovám";
"onboarding.entropy.learn_more.overview" = "Oath zaznamenáva výsledky z vami zvoleného fyzického zdroja a prevádza ich na 256-bitovú hodnotu. Výsledných 32 bajtov sa potom odošle do Wallet Core na vytvorenie štandardnej obnovovacej frázy BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "24-slovná obnovovacia fráza BIP-39";
"onboarding.entropy.learn_more.visual.bits" = "32 bajtov × 8 bitov sa rovná 256 bitom";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Mriežka s 256 vzorkovacími bitovými bunkami usporiadanými do 32 bajtov.";
"onboarding.entropy.learn_more.visual.accessibility" = "Hodenie kockou, hodenie mincou alebo náhodné číslice sa prevedú na 256 bitov a potom na 24-slovnú obnovovaciu frázu BIP-39.";
"onboarding.entropy.learn_more.inputs.section" = "Krok 1: Zaznamenanie fyzických výsledkov";
"onboarding.entropy.learn_more.inputs.dice.title" = "Hodenie spravodlivou šesťstrannou kockou";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Pri spravodlivom hode kockou strany 1 – 4 prispievajú 2 bitmi; strany 5 – 6 prispievajú 1 bitom.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fyzické hody mincou";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Každý spravodlivý, nezávislý hod mincou prispieva jedným nestranným bitom entropie.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Zaznamenávanie náhodných číslic";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Číslice 0–7 prispievajú 3 bitmi; číslice 8–9 prispievajú 1 bitom. Číslice musia pochádzať zo skutočne náhodného fyzikálneho procesu.";
"onboarding.entropy.learn_more.inputs.footer" = "Použite férový fyzikálny zdroj a zaznamenajte každý výsledok v poradí. Môžete prepínať vstupné metódy, pretože každý akceptovaný výsledok prispieva k rovnakému bitovému toku.";
"onboarding.entropy.learn_more.conversion.section" = "2. Zostavenie 256-bitovej hodnoty";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath prevádza výsledky hodov kockami a desatinné číslice na nestranné skupiny mocnín dvoch. Dĺžky príspevkov sa môžu líšiť, ale férový fyzikálny zdroj neuprednostňuje žiadnu bitovú hodnotu.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath pridáva bity v zadanom poradí, kým nezhromaždí presne 256, a potom ich zbalí do 32 bajtov, pričom najvýznamnejší bit je prvý.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Vlastná entropia obsahuje iba fyzické vstupy, ktoré zaznamenávate; Oath nezahŕňa náhodnosť generovanú zariadením.";
"onboarding.entropy.learn_more.bip39.section" = "3. Odvodenie obnovovacej frázy";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bitov entropie";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "8-bitový kontrolný súčet BIP-39";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bitov rozdelených do 24 jedenásťbitových slovných indexov";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "256-bitová hodnota entropie dostane 8-bitový kontrolný súčet, čím vytvorí 264 bitov, ktoré sa rozdelia do 24 jedenásťbitových slovných indexov.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 vypočíta SHA-256 nad 32-bajtovou hodnotou entropie a prvých 8 hash bitov berie ako kontrolný súčet; pridaním tohto kontrolného súčtu vytvorí 264 bitov.";
"onboarding.entropy.learn_more.bip39.words" = "264 bitov je rozdelených do 24 skupín po 11 bitoch. Každá skupina vyberie jeden záznam zo štandardného 2 048-slovného zoznamu BIP-39 na vytvorenie 24-slovnej obnovovacej frázy.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core odvodzuje deterministické účty a adresy z výsledného semena. Rovnaká obnovovacia fráza a voliteľná prístupová fráza vždy znovu vytvoria tú istú peňaženku.";
"onboarding.entropy.learn_more.security.section" = "Ako vlastná entropia posilňuje bezpečnosť";
"onboarding.entropy.learn_more.security.space.title" = "Priestor obrovských možností";
"onboarding.entropy.learn_more.security.space.detail" = "Jednotná 256-bitová entropia obsahuje 2^256 jedinečných hodnôt, čo robí vyčerpávajúce hádanie výpočtovo nemožným. Toto popisuje veľkosť vstupného priestoru; neznamená to, že každý kryptografický komponent poskytuje 256-bitovú odolnosť voči útokom.";
"onboarding.entropy.learn_more.security.source.title" = "Náhodnosť pochádza od vás";
"onboarding.entropy.learn_more.security.source.detail" = "Fyzické udalosti vám umožňujú nezávisle získavať náhodnosť peňaženky namiesto toho, aby ste sa spoliehali výlučne na generátor náhodných čísel zariadenia. To zlepšuje bezpečnosť iba vtedy, keď sú tieto udalosti skutočne náhodné.";
"onboarding.entropy.learn_more.security.local.title" = "Spracované výlučne na tomto zariadení";
"onboarding.entropy.learn_more.security.local.detail" = "Oath prevedie vašu zaznamenanú sekvenciu a vytvorí obnovovaciu frázu výlučne na tomto zariadení. Vaša sekvencia sa nikdy neodošle na spracovanie.";
"onboarding.entropy.learn_more.security.patterns.title" = "Vyhnite sa tajomstvám vybraným človekom";
"onboarding.entropy.learn_more.security.patterns.detail" = "Dlhá sekvencia spravodlivých, nezávislých udalostí je oveľa menej predvídateľná ako narodeniny, obľúbené čísla, opakované vzory alebo slová vybrané osobou.";
"onboarding.entropy.learn_more.security.footer" = "Fyzická entropia nahrádza náhodnosť peňaženky generovanú zariadením; nie je to ďalšie heslo ani bezpečnostná vrstva.";
"onboarding.entropy.learn_more.safety.section" = "Používajte túto funkciu bezpečne";
"onboarding.entropy.learn_more.safety.fair.title" = "Zaznamenávajte férové, nezávislé výsledky";
"onboarding.entropy.learn_more.safety.fair.detail" = "Použite férovú mincu alebo kocku a uistite sa, že každý výsledok je nezávislý. Náhodné číslice musia pochádzať zo skutočného fyzického zdroja – nie z pamäte alebo vzoru.";
"onboarding.entropy.learn_more.safety.private.title" = "Udržujte svoj proces entropie v súkromí";
"onboarding.entropy.learn_more.safety.private.detail" = "Chráňte zaznamenanú sekvenciu aj dokončenú obnovovaciu frázu ako tajomstvá peňaženky. Uchovávajte ich mimo dohľadu kamier a iných ľudí.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Zaznamenajte každý výsledok presne";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Jeden chýbajúci, duplikovaný alebo preusporiadaný výsledok vytvorí inú peňaženku. Pred vložením finančných prostriedkov do peňaženky skontrolujte každý záznam a overte dokončenú obnovovaciu frázu.";
"onboarding.entropy.learn_more.safety.backup.title" = "Zabezpečte obnovovaciu frázu";
"onboarding.entropy.learn_more.safety.backup.detail" = "Uchovávajte obnovovaciu frázu offline a nikdy ju nezdieľajte. Po overení zálohy bezpečne zničte všetky prechodné vstupné záznamy, ktoré už nepotrebujete.";
"onboarding.entropy.learn_more.safety.footer" = "Fyzická entropia nedokáže zabezpečiť odhalenú obnovovaciu frázu, napadnuté zariadenie, škodlivý softvér ani nesprávne zaznamenanú sekvenciu. Ak nemôžete zaručiť férové, súkromné a presné vstupy, použite namiesto toho štandardné vytvorenie peňaženky.";
"onboarding.carousel.open_source.eyebrow" = "OTVORENÝ ZDROJOVÝ KÓD UŽ V NÁVRHU";
"onboarding.carousel.open_source.title" = "Skontrolujte zdroj. Overte zostavenie.";
"onboarding.carousel.open_source.message" = "Oath zverejňuje svoj zdrojový kód na nezávislú kontrolu. Vydanie je overené iba vtedy, keď reprodukovateľné zostavenie zodpovedá odtlačku publikovanej aplikácie.";
