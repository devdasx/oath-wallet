"onboarding.passphrase.learn_more.visual.passphrase" = "Vaša tajná prístupová fráza";
"onboarding.passphrase.learn_more.visual.wallet" = "Peňaženka chránená heslom";
"onboarding.passphrase.learn_more.visual.accessibility" = "24-slovná obnovovacia fráza a tajná prístupová fráza sa spoja a vytvoria samostatnú peňaženku chránenú prístupovou frázou.";
"onboarding.passphrase.learn_more.derivation.section" = "Ako BIP-39 odvodzuje peňaženku";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Obnovovacia fráza spojená s prístupovou frázou";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 s 2 048 kolami";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bitový hlavný seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Odvodené účty a adresy peňaženiek";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Obnovovacia a prístupová fráza prejdú 2 048 kolami PBKDF2-HMAC-SHA512, čím vznikne 512-bitový seed, z ktorého sa odvodia účty a adresy peňaženky.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 považuje normalizovanú obnovovaciu frázu za heslo PBKDF2 a ako soľ používa reťazec „mnemonic“, za ktorým nasleduje normalizovaná prístupová fráza. Po 2 048 kolách PBKDF2-HMAC-SHA512 vznikne 64-bajtový seed.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Pred odvodením seedu Oath použije normalizáciu Unicode vyžadovanú štandardom BIP-39, takže rovnaká normalizovaná obnovovacia a prístupová fráza vždy znova vytvoria tú istú peňaženku.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Prístupová fráza nešifruje vaše obnovovacie slová. Mení odvodený seed, takže každá odlišná prístupová fráza vytvorí iné účty a adresy.";
"onboarding.passphrase.learn_more.wallets.section" = "Každá prístupová fráza odvodzuje samostatnú peňaženku";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Príklad prístupovej frázy 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Príklad prístupovej frázy 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Príklad peňaženky A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Príklad peňaženky B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Rovnaká obnovovacia fráza spojená s dvoma odlišnými prístupovými frázami vytvorí dve samostatné peňaženky: Peňaženku A a Peňaženku B.";
"onboarding.passphrase.learn_more.wallets.different" = "Zmena čo i len jedného významového znaku odvodí iný seed, a teda aj inú peňaženku; pôvodná peňaženka zostane nezmenená.";
"onboarding.passphrase.learn_more.wallets.empty" = "Prázdna prístupová fráza otvorí štandardnú peňaženku odvodenú len z obnovovacej frázy. Neprázdna prístupová fráza otvorí vlastnú samostatnú peňaženku.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 nevracia chybu „nesprávna prístupová fráza“. Každá prístupová fráza je platná, takže preklep bez upozornenia otvorí inú peňaženku – zvyčajne s nulovým zostatkom.";
"onboarding.passphrase.learn_more.security.section" = "Ako prístupová fráza zvyšuje ochranu";
"onboarding.passphrase.learn_more.security.words.title" = "Samotné obnovovacie slová nestačia";
"onboarding.passphrase.learn_more.security.words.detail" = "Ak niekto získa iba vašu obnovovaciu frázu, na odvodenie chránenej peňaženky a prístup k nej stále potrebuje presnú prístupovú frázu.";
"onboarding.passphrase.learn_more.security.strength.title" = "Silnejšia fráza lepšie oddeľuje peňaženky";
"onboarding.passphrase.learn_more.security.strength.detail" = "Dlhá a nepredvídateľná prístupová fráza sa háda podstatne ťažšie. Krátky citát, dátum narodenia, meno alebo opakovane používané heslo možno uhádnuť rýchlo a poskytuje len malú ochranu.";
"onboarding.passphrase.learn_more.security.separation.title" = "Uchovávajte prístupovú frázu oddelene";
"onboarding.passphrase.learn_more.security.separation.detail" = "Uchovávajte prístupovú frázu oddelene od obnovovacej frázy, aby jedna ukradnutá záloha neodhalila obe tajné položky potrebné na obnovenie peňaženky.";
"onboarding.passphrase.learn_more.security.footer" = "Prístupová fráza nemôže ochrániť vaše finančné prostriedky, ak sú obe tajné položky odhalené, prístupová fráza je slabá alebo ju kompromitovaný softvér zachytí počas písania.";
"onboarding.passphrase.learn_more.safety.section" = "Používajte túto funkciu bezpečne";
"onboarding.passphrase.learn_more.safety.strong.title" = "Vytvorte si silnú a jedinečnú prístupovú frázu";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Vyberte si niekoľko náhodných slov alebo inú hodnotu s vysokou entropiou, ktorá je jedinečná pre túto peňaženku. Vyhnite sa osobným faktom, známym frázam, vzorom a heslám používaným inde.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Zálohujte si prístupovú frázu samostatne";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Vytvorte si trvalú offline kópiu presnej prístupovej frázy, uložte ju oddelene od obnovovacej frázy a nikdy sa nespoliehajte len na pamäť.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Každý znak mení peňaženku";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Znovu zadajte prístupovú frázu presne tak, ako bola vytvorená, vrátane každého veľkého písmena, medzery, interpunkčného znamienka a slova. Akýkoľvek rozdiel potichu generuje ďalšiu peňaženku.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Pred pridaním prostriedkov overte obnovenie";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Pred prijatím väčšieho množstva finančných prostriedkov vykonajte súkromný, kontrolovaný test obnovy, aby ste potvrdili, že obnovovacia fráza a prístupová fráza zodpovedajú očakávaným adresám.";
"onboarding.passphrase.learn_more.safety.footer" = "Žiadna služba nemôže resetovať ani obnoviť stratenú prístupovú frázu. Bez presnej prístupovej frázy je prístup k danej peňaženke natrvalo stratený – aj keď stále máte obnovovaciu frázu.";
