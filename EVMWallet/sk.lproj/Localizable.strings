"onboarding.carousel.passphrase.visual.requirement" = "Na obnovenie sú potrebné obe tajomstvá";
"onboarding.carousel.passphrase.visual.accessibility" = "24-slovná obnovovacia fráza a tajná prístupová fráza BIP-39 vytvárajú samostatnú peňaženku, ktorá vyžaduje obe tajomstvá na obnovenie.";
"onboarding.carousel.passphrase.learn_more.action" = "Preskúmajte viac podrobností";
"onboarding.passphrase.learn_more.navigation" = "Pochopenie prístupových fráz BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dve tajomstvá vytvárajú jednu peňaženku";
"onboarding.passphrase.learn_more.overview" = "Prístupová fráza BIP-39 je voliteľné tajomstvo kombinované s vašou obnovovacou frázou. Spoločne deterministicky vytvárajú peňaženku, ktorá sa líši od tej, ktorú vytvorila samotná obnovovacia fráza.";
