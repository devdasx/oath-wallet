"onboarding.carousel.open_source.visual.accessibility" = "Diagram znázorňujúci, že overenie vydania vyžaduje verejný zdrojový kód, nezávislú prestavbu a zodpovedajúce odtlačky.";
"onboarding.carousel.passphrase.eyebrow" = "VOLITEĽNÁ PRÍSTUPOVÁ FRÁZA BIP-39";
"onboarding.carousel.passphrase.title" = "Jedna obnovovacia fráza. Jedno ďalšie tajné heslo.";
"onboarding.carousel.passphrase.message" = "Prístupová fráza BIP-39 sa kombinuje s vašou obnovovacou frázou a vytvára samostatnú peňaženku. Aj keď sú obnovovacie slová odhalené, prístup k tejto peňaženke stále vyžaduje presnú prístupovú frázu.";
"onboarding.carousel.passphrase.visual.phrase" = "Vašich 24 obnovovacích slov";
"onboarding.carousel.passphrase.visual.passphrase" = "Vaša dodatočná tajná prístupová fráza";
