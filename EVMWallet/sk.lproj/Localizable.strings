// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Odoslanie posunutím nahrádza potvrdzovacie tlačidlo. Smerová animácia, haptika a plynulejší pohyb podporujú oba smery čítania. Na odoslanie uvoľnite pri aspoň 90%; posunutím späť akciu zrušíte.";
"settings.about.history.v355.build56.activity" = "Zvonček otvára čakajúcu aktivitu. Kapsuly transakcií zobrazujú stavové odznaky a možno ich odsunúť. Kapsuly potvrdzovania aj potvrdených transakcií sa skryjú po 3 sekundách; potvrdenie aktualizuje tú istú viditeľnú kapsulu.";
"settings.about.history.v355.build56.status" = "Spoľahlivejší stav transakcií vo všetkých podporovaných sieťach, priebežne aktualizované podrobnosti a rýchlejšie aktualizácie zostatku po odoslaní. Sledovanie čakajúcich transakcií sa obnoví pri opätovnom otvorení aplikácie.";
"settings.about.history.v355.build56.fees" = "Návrat ku kontrole rovnakého prevodu zachová zistený poplatok. Prehľadnejšie načítanie poplatkov a upozornenia na financovanie účtu; dostatočné sumy už nezobrazujú oznámenia o aktivácii.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin a Dogecoin pridávajú vratnú sumu pod hranicou prachu k poplatku namiesto vytvorenia nepoužiteľného výstupu. Poplatok pri kontrole zodpovedá poplatku pri podpise.";
"settings.about.history.v355.build56.stability" = "Opravený pád úlohy na pozadí a upozornenia na vypršanie času obnovovania peňaženky. Pri dočasnom zlyhaní obnovovania zostávajú doterajšie informácie dostupné.";
"settings.about.history.v355.build56.backup" = "Prehľadnejšie obrazovky zálohovania so správnymi úvodnými názvami a menším počtom správ. Prístup k súkromným kľúčom rešpektuje zámok aplikácie. Kompaktné sklenené upozornenia pri importe vymažú odmietnutý vstup pri výbere inej obnovovacej frázy.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Po uvoľnení posuvníka na odoslanie sa pred zatvorením kontroly zobrazí animované začiarknutie.";
"settings.about.history.v355.build57.activity" = "Riadky aktivity zobrazujú stav tenším písmom, sumu ako podnadpis a šípku na otvorenie podrobností transakcie.";
"settings.about.history.v355.build57.details" = "Sieťové poplatky sa teraz zobrazujú v súhrne prevodu. Kratšie označenia a jediný riadok siete sprehľadňujú podrobnosti.";
"settings.about.history.v355.build57.resume" = "Po návrate z pozadia zostanú otvorené obrazovky a panely zachované vrátane kontroly prevodu a podrobností transakcie.";
"settings.about.history.v355.build57.secrets" = "Obrazovky s obnovovacou frázou, súkromným kľúčom a prístupovou frázou sa po 20 sekundách mimo aplikácie zatvoria. Zámok aplikácie sa naďalej riadi vašimi nastaveniami.";
"settings.about.history.v355.build57.filters" = "Filtre sietí používajú o niečo vyššie natívne tlačidlá s veľkosťou podľa obsahu a opravenými rozostupmi pod navigačnou lištou.";
"settings.about.history.v355.build57.units" = "Samostatné riadky hodnoty boli odstránené. Suma a sieťový poplatok sa najprv zobrazia v miestnej mene; klepnutím prepnete na kryptomenové jednotky a späť.";
"wallet.transaction.details.toggle_units" = "Prepnúť jednotky.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Domovská obrazovka sa otvára bez prelínania alebo zmeny veľkosti. Tlačidlo nastavení teraz používa ikonu ozubeného kolesa.";
"settings.about.history.v355.build58.fields" = "Polia transakcií a odosielania používajú bežné farby textu. Šípky sa zobrazujú iba pri riadkoch, ktoré otvárajú obrazovku alebo panel; klepnutie na sumu či poplatok naďalej prepína jednotky.";
"settings.about.history.v355.build58.banners" = "Po zobrazení zmiznú oznámenia o prebiehajúcom či dokončenom potvrdení za 3 sekundy, aj keď otvoríte inú obrazovku. Dosiaľ nezobrazené potvrdenia sa objavia po návrate.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Prevody TRON teraz vyhradia prostriedky na aktiváciu a šírku pásma pred výpočtom odosielanej sumy, aj pri odosielaní maxima. Kontrola prevodu zobrazuje správnu sumu po odpočítaní poplatkov.";
"settings.about.history.v355.build59.fees" = "Vlastné poplatky TRON musia pokryť požadované sieťové náklady. Pri nízkom zostatku TRX sa teraz zobrazujú zrozumiteľnejšie pokyny. Množstvo tokenov sa nemení; poplatky sa platia v TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Nové privítanie";
"settings.about.history.v356.welcome" = "Nová uvítacia obrazovka s animovanými kresbami a jasnými možnosťami vytvorenia alebo importu peňaženky.";
"settings.about.history.v357.tour.title" = "Úvodná prehliadka";
"settings.about.history.v357.tour" = "Päťstranová prehliadka predstavuje podporované siete, fyzickú entropiu, odosielanie a prijímanie, zabezpečenie a overené zostavenia. Medzi stránkami prechádzajte potiahnutím alebo ťuknutím na bodky; prepínač jazyka je v navigačnom paneli.";
"settings.about.history.v357.backup" = "Po vytvorení, importe alebo obnovení peňaženky sa obrazovka zobrazí okamžite a možnosti zálohovania používajú štandardný zoznam. Kontrola iCloudu prebieha na pozadí a tlačidlo Otvoriť peňaženku je pripravené hneď po uložení peňaženky.";
"settings.about.history.v357.reliability" = "Návrat z pozadia už nezatvorí obrazovku nastavenia, keď vyprší skrytá obrazovka obnovy, a vymazanie všetkých údajov otvorí úvodnú obrazovku priamo.";
"settings.about.history.v357.notifications" = "Nastavenia upozornení používajú pre kategórie a stav jednoduchšie formulácie bez technických podrobností.";
"settings.about.history.v357.wallets" = "Peňaženky v prepínači preusporiadate dlhým stlačením so systémovou animáciou zdvihnutia; ťuknutie na riadok ho aktivuje. Overenie frázy na obnovenie čísluje každé slovo a kláves Return prechádza na ďalšie pole.";
"settings.about.history.v357.send" = "Počas prevodu sa pri odosielaní zobrazuje suma, ak sa nedá odoslať, objaví sa zrozumiteľnejšia správa, a požiadavky TRON sa po dočasných chybách poskytovateľa automaticky zopakujú.";
"settings.about.history.v357.security" = "Importované účty TRON, ktorých oprávnenie vlastníka bolo presunuté na iný kľúč, teraz zobrazujú upozornenie a nemôžu odosielať, aj keď každé oprávnenie uvádza jediný kľúč. Pri importe sa odmieta viac známych odhalených fráz na obnovenie a súkromných kľúčov.";
"settings.about.history.v356.localization" = "Texty uvítacej obrazovky sú vo všetkých podporovaných jazykoch prirodzenejšie a zrozumiteľnejšie.";
"settings.about.history.v356.pricing" = "Ceny tokenov sa teraz zhodujú s presnou sieťou a adresou tokenu, pričom sa najprv použijú ceny DEX. Malé ceny zobrazujú až 8 desatinných miest bez zaokrúhľovania.";
"settings.about.history.v356.appearance" = "Primárne a sekundárne tlačidlá teraz používajú konzistentné výšky a okraje obrazovky so systémovou modrou pre primárne akcie.";
"settings.about.history.v356.transactions" = "Podrobnosti transakcie používajú kratší stav Potvrdené a jasnejší sivý text pre dátumy, adresy, sumy a ID transakcie.";
