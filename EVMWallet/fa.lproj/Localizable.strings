"onboarding.entropy.learn_more.security.source.title" = "تصادفی‌بودن از شما می‌آید";
"onboarding.entropy.learn_more.security.source.detail" = "رویدادهای فیزیکی به شما اجازه می‌دهند به‌جای اتکای کامل به مولد اعداد تصادفی دستگاه، منبع تصادفی‌بودن کیف پول را مستقل تأمین کنید. این کار فقط هنگامی امنیت را افزایش می‌دهد که رویدادها واقعاً تصادفی باشند.";
