"settings.about.history.v355.build56.fees" = "بازگشت به بازبینی همان انتقال، کارمزد آماده‌شده را حفظ می‌کند. نمایش بارگیری کارمزد و هشدارهای تأمین موجودی حساب روشن‌تر شده‌اند؛ مبلغ کافی دیگر پیام فعال‌سازی نشان نمی‌دهد.";
