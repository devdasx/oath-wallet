"onboarding.carousel.passphrase.title" = "አንድ የመልሶ ማግኛ ሐረግ። አንድ ተጨማሪ ሚስጥር።";
"onboarding.carousel.passphrase.message" = "የBIP-39 ይለፍ ሐረግ ከመልሶ ማግኛ ሐረግዎ ጋር ተጣምሮ የተለየ ዋሌት ያመነጫል። የመልሶ ማግኛ ቃላቱ ቢጋለጡም፣ ያንን ዋሌት ለመድረስ አሁንም ትክክለኛው የይለፍ ሐረግ ያስፈልጋል።";
"onboarding.carousel.passphrase.visual.phrase" = "የእርስዎ 24 የመልሶ ማግኛ ቃላት";
"onboarding.carousel.passphrase.visual.passphrase" = "የእርስዎ ተጨማሪ ሚስጥራዊ የይለፍ ሐረግ";
"onboarding.carousel.passphrase.visual.output" = "የተለየ የይለፍ ሐረግ ዋሌት";
"onboarding.carousel.passphrase.visual.requirement" = "መልሶ ለማግኘት ሁለቱም ሚስጥሮች ያስፈልጋሉ";
"onboarding.carousel.passphrase.visual.accessibility" = "ባለ 24 ቃላት የመልሶ ማግኛ ሐረግና ሚስጥራዊ የBIP-39 ይለፍ ሐረግ ተጣምረው መልሶ ለማግኘት ሁለቱንም ሚስጥሮች የሚፈልግ የተለየ ዋሌት ያመነጫሉ።";
"onboarding.carousel.passphrase.learn_more.action" = "ተጨማሪ ዝርዝሮችን ያስሱ";
"onboarding.passphrase.learn_more.navigation" = "የBIP-39 ይለፍ ሐረጎችን መረዳት";
"onboarding.passphrase.learn_more.path.section" = "ሁለት ሚስጥሮች አንድ ዋሌት ያመነጫሉ";
"onboarding.passphrase.learn_more.overview" = "የBIP-39 ይለፍ ሐረግ ከመልሶ ማግኛ ሐረግዎ ጋር የሚጣመር አማራጭ ሚስጥር ነው። ሁለቱ በአንድነት በመልሶ ማግኛ ሐረጉ ብቻ ከተፈጠረው የተለየ ዋሌት በተወሰነ ሥርዓት ያመነጫሉ።";
"onboarding.passphrase.learn_more.visual.phrase" = "የእርስዎ ባለ 24 ቃላት የመልሶ ማግኛ ሐረግ";
"onboarding.passphrase.learn_more.visual.passphrase" = "የእርስዎ ሚስጥራዊ የይለፍ ሐረግ";
"onboarding.passphrase.learn_more.visual.wallet" = "በይለፍ ሐረግ የተጠበቀ ዋሌት";
"onboarding.passphrase.learn_more.visual.accessibility" = "ባለ 24 ቃላት የመልሶ ማግኛ ሐረግና ሚስጥራዊ የይለፍ ሐረግ ተጣምረው በይለፍ ሐረግ የተጠበቀ የተለየ ዋሌት ያመነጫሉ።";
"onboarding.passphrase.learn_more.derivation.section" = "BIP-39 ዋሌቱን እንዴት ያመነጫል";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "የመልሶ ማግኛ ሐረግ ከይለፍ ሐረግ ጋር ተጣምሯል";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 በ2,048 ዙሮች";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "ባለ 512 ቢት ዋና ዘር";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "የተመነጩ የዋሌት መለያዎችና አድራሻዎች";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "የመልሶ ማግኛ ሐረግዎና የይለፍ ሐረግዎ በ2,048 ዙሮች የPBKDF2-HMAC-SHA512 ሂደት አልፈው፣ የዋሌት መለያዎችና አድራሻዎች የሚመነጩበትን ባለ 512 ቢት ዘር ያፈራሉ።";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 መደበኛ ቅርጽ የተሰጠውን የመልሶ ማግኛ ሐረግ እንደ PBKDF2 የይለፍ ቃል፣ \"mnemonic\"ን ተከትሎ መደበኛ ቅርጽ የተሰጠውን የይለፍ ሐረግ ደግሞ እንደ ሶልት ይጠቀማል። ከ2,048 ዙሮች የPBKDF2-HMAC-SHA512 በኋላ ሂደቱ ባለ 64 ባይት ዘር ያፈራል።";
"onboarding.passphrase.learn_more.derivation.normalization" = "ዘሩን ከማመንጨቱ በፊት Oath በBIP-39 የሚፈለገውን የUnicode መደበኛ ቅርጽ ይተገብራል፤ በዚህም ተመሳሳዩ መደበኛ ቅርጽ ያለው የመልሶ ማግኛ ሐረግና የይለፍ ሐረግ ሁልጊዜ ተመሳሳዩን ዋሌት እንደገና ይፈጥራሉ።";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "የይለፍ ሐረጉ የመልሶ ማግኛ ቃላትን አያመሰጥርም። ዘሩን ራሱ ይለውጣል፣ ስለዚህ የተለየ የይለፍ ሐረግ የተለያዩ መለያዎችን እና አድራሻዎችን ይፈጥራል።";
"onboarding.passphrase.learn_more.wallets.section" = "እያንዳንዱ የይለፍ ሐረግ የተለየ ዋሌት ያመነጫል";
"onboarding.passphrase.learn_more.wallets.visual.one" = "ምሳሌ የይለፍ ሐረግ 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "ምሳሌ የይለፍ ሐረግ 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "ምሳሌ ዋሌት A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "ምሳሌ ዋሌት B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "ተመሳሳዩ የመልሶ ማግኛ ሐረግ ከሁለት የተለያዩ የይለፍ ሐረጎች ጋር ተጣምሮ ሁለት የተለያዩ ዋሌቶችን ያመነጫል፦ ዋሌት A እና ዋሌት B።";
"onboarding.passphrase.learn_more.wallets.different" = "ትርጉም ያለውን አንድ ቁምፊ እንኳን መለወጥ የተለየ ዘርና በዚህም የተለየ ዋሌት ያመነጫል፤ የመጀመሪያው ዋሌት ሳይለወጥ ይቆያል።";
"onboarding.passphrase.learn_more.wallets.empty" = "ባዶ የይለፍ ሐረግ ከመልሶ ማግኛ ሐረጉ ብቻ የሚገኘውን መደበኛ ዋሌት ይከፍታል። ባዶ ያልሆነ የይለፍ ሐረግ ደግሞ የራሱን የተለየ ዋሌት ይከፍታል።";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 “የተሳሳተ የይለፍ ሐረግ” የሚል ምላሽ የለውም፤ እያንዳንዱ የይለፍ ሐረግ ተቀባይነት ስላለው የትየባ ስህተት ያለ ማስጠንቀቂያ ሌላ ዋሌት ይከፍታል፤ ይህም ብዙውን ጊዜ ዜሮ ቀሪ ሂሳብ ይኖረዋል።";
"onboarding.passphrase.learn_more.security.section" = "ጥበቃን እንዴት እንደሚጨምር";
"onboarding.passphrase.learn_more.security.words.title" = "የመልሶ ማግኛ ቃላት በቂ አይደሉም";
"onboarding.passphrase.learn_more.security.words.detail" = "የመልሶ ማግኛ ሐረግዎን ብቻ ያገኘ ሰው የተጠበቀውን ዋሌት ለማመንጨትና ለመድረስ አሁንም ትክክለኛውን የይለፍ ሐረግ ይፈልጋል።";
