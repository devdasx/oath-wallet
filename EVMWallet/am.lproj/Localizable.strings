"onboarding.entropy.learn_more.navigation" = "አካላዊ ኢንትሮፒ እንዴት ይሠራል";
"onboarding.entropy.learn_more.path.section" = "ከአካላዊ ውጤቶች ወደ መልሶ ማግኛ ቃላት";
"onboarding.entropy.learn_more.overview" = "Oath ከመረጡት አካላዊ ምንጭ የሚገኙ ውጤቶችን መዝግቦ ወደ ባለ 256 ቢት እሴት ይለውጣቸዋል። ከዚያም የተገኙት 32 ባይቶች መደበኛ የBIP-39 መልሶ ማግኛ ሐረግ እንዲፈጠር ወደ Wallet Core ይተላለፋሉ።";
"onboarding.entropy.learn_more.visual.phrase" = "24-ቃል BIP-39 የመልሶ ማግኛ ሐረግ";
"onboarding.entropy.learn_more.visual.bits" = "32 ባይት × 8 ቢት = 256 ቢት";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "በ32 ባይቶች የተደረደሩ 256 የናሙና ቢት ሕዋሶች ፍርግርግ።";
"onboarding.entropy.learn_more.visual.accessibility" = "የዳይስ ውጤቶች፣ የሳንቲም ግልበጣዎች ወይም የዘፈቀደ አሃዞች ወደ 256 ቢት ከዚያም ወደ ባለ 24 ቃላት የBIP-39 መልሶ ማግኛ ሐረግ ይለወጣሉ።";
"onboarding.entropy.learn_more.inputs.section" = "ደረጃ 1፦ አካላዊ ውጤቶችን ይመዝግቡ";
"onboarding.entropy.learn_more.inputs.dice.title" = "ሚዛናዊ ባለ 6 ጎን ዳይ ይጣሉ";
"onboarding.entropy.learn_more.inputs.dice.detail" = "ሚዛናዊ ዳይ ሲጠቀሙ ገጾች 1–4 እያንዳንዳቸው 2 ቢት፣ ገጾች 5–6 ደግሞ እያንዳንዳቸው 1 ቢት ያበረክታሉ።";
"onboarding.entropy.learn_more.inputs.coin.title" = "አካላዊ የሳንቲም ግልበጣዎች";
"onboarding.entropy.learn_more.inputs.coin.detail" = "እያንዳንዱ ሚዛናዊና ገለልተኛ የሳንቲም ግልበጣ አድልዎ የሌለው 1 ቢት ኢንትሮፒ ያበረክታል።";
"onboarding.entropy.learn_more.inputs.digits.title" = "የዘፈቀደ አሃዞችን ይመዝግቡ";
"onboarding.entropy.learn_more.inputs.digits.detail" = "አሃዞች 0–7 እያንዳንዳቸው 3 ቢት ያበረክታሉ። አሃዞች 8–9 እያንዳንዳቸው 1 ቢት ያበረክታሉ። አሃዞች ከእውነተኛ የዘፈቀደ አካላዊ ሂደት መምጣት አለባቸው።";
"onboarding.entropy.learn_more.inputs.footer" = "ሚዛናዊ አካላዊ ምንጭ ይጠቀሙ እና እያንዳንዱን ውጤት በቅደም ተከተል ይመዝግቡ። እያንዳንዱ ተቀባይነት ያገኘ ውጤት ለተመሳሳዩ የቢት ፍሰት ስለሚያበረክት የግብዓት ዘዴዎችን መቀየር ይችላሉ።";
"onboarding.entropy.learn_more.conversion.section" = "2. ባለ 256 ቢት እሴት ያዋቅሩ";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath የዳይስ ውጤቶችንና የአስርዮሽ አሃዞችን አድልዎ ወደሌላቸው የ2 ኃይል ቡድኖች ይለውጣል። የሚያበረክቱት ርዝመት ሊለያይ ይችላል፣ ነገር ግን ሚዛናዊ አካላዊ ምንጭ ለማንኛውም የቢት እሴት አያደላም።";
"onboarding.entropy.learn_more.conversion.packing" = "Oath በትክክል 256 ቢት እስኪሰበስብ ድረስ ቢቶችን ባስገቡበት ቅደም ተከተል ይጨምራል፤ ከዚያም ከፍተኛ ስፍራ ያለውን ቢት በማስቀደም ወደ 32 ባይቶች ያጠቃልላቸዋል።";
"onboarding.entropy.learn_more.conversion.no_mixing" = "ብጁ ኢንትሮፒ እርስዎ የመዘገቧቸውን አካላዊ ግብዓቶች ብቻ ይይዛል፤ Oath በመሣሪያው የሚመነጭ የዘፈቀደነትን አይቀላቅልበትም።";
"onboarding.entropy.learn_more.bip39.section" = "3. የመልሶ ማግኛ ሐረጉን ይመንጩ";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 ቢት ኢንትሮፒ";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "ባለ 8 ቢት የBIP-39 ቼክሰም";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 ቢት በ24 ባለ 11 ቢት የቃል መረጃ ጠቋሚዎች ይከፈላል";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "ባለ 256-ቢት ኢንትሮፒ እሴት እና ባለ 8-ቢት ቼክሰም 264 ቢት ይፈጥራል፣ ይህም እያንዳንዳቸው 11 ቢት ባላቸው 24 የቃላት ኢንዴክሶች ይከፈላሉ።";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 በባለ 32 ባይት ኢንትሮፒ እሴት ላይ SHA-256ን ያሰላልና የመጀመሪያዎቹን 8 የሃሽ ቢቶች እንደ ቼክሰም ይወስዳል፤ ያንን ቼክሰም ሲጨምር 264 ቢት ይፈጠራል።";
"onboarding.entropy.learn_more.bip39.words" = "264 ቢቶቹ በ24 ባለ 11 ቢት ቡድኖች ይከፈላሉ። እያንዳንዱ ቡድን ከመደበኛው ባለ 2,048 ቃላት የBIP-39 ዝርዝር አንድ ግቤት በመምረጥ ባለ 24 ቃላት የመልሶ ማግኛ ሐረጉን ይፈጥራል።";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core ከተገኘው ዘር በተወሰነ ሥርዓት የዋሌት መለያዎችንና አድራሻዎችን ያመነጫል። ተመሳሳዩ የመልሶ ማግኛ ሐረግና አማራጭ የይለፍ ሐረግ ሁልጊዜ ተመሳሳዩን ዋሌት እንደገና ይፈጥራሉ።";
"onboarding.entropy.learn_more.security.section" = "ብጁ ኢንትሮፒ ደህንነትን እንዴት ያጠናክራል";
"onboarding.entropy.learn_more.security.space.title" = "እጅግ ሰፊ የእድሎች ክልል";
"onboarding.entropy.learn_more.security.space.detail" = "ወጥ የሆነ ባለ 256 ቢት ኢንትሮፒ 2^256 ልዩ እሴቶችን ይይዛል፤ ስለዚህ ሁሉንም በመሞከር መገመት በስሌት አዋጭ አይደለም። ይህ የግብዓት ክልሉን መጠን ይገልጻል፤ እያንዳንዱ የምስጠራ አካል ባለ 256 ቢት የጥቃት መቋቋም እንዳለው አያመለክትም።";
"onboarding.entropy.learn_more.security.source.title" = "እርስዎ የሚያቀርቡት የዘፈቀደነት";
"onboarding.entropy.learn_more.security.source.detail" = "በመሣሪያ የዘፈቀደ ቁጥር አመንጪ ላይ ብቻ ከመተማመን ይልቅ፣ አካላዊ ክስተቶች የዋሌቱን የዘፈቀደነት ምንጭ ራስዎ ችለው እንዲያቀርቡ ያስችሉዎታል። ይህ ደህንነትን የሚያሻሽለው ክስተቶቹ በእውነት የዘፈቀደ ሲሆኑ ብቻ ነው።";
"onboarding.entropy.learn_more.security.local.title" = "ሙሉ በሙሉ በዚህ መሣሪያ ላይ ይከናወናል";
"onboarding.entropy.learn_more.security.local.detail" = "Oath የመዘገቡትን ቅደም ተከተል በመለወጥ የመልሶ ማግኛ ሐረጉን ሙሉ በሙሉ በዚህ መሣሪያ ላይ ይፈጥራል። ቅደም ተከተሉ ለማስኬድ በፍጹም አይሰቀልም።";
"onboarding.entropy.learn_more.security.patterns.title" = "ሰው የመረጣቸውን ሚስጥሮች ያስወግዱ";
"onboarding.entropy.learn_more.security.patterns.detail" = "ረጅም ተከታታይ ፍትሃዊ እና ገለልተኛ ክስተቶች ከልደት ቀኖች፣ ከተወዳጅ ቁጥሮች፣ ከተደጋገሙ ስርዓተ ጥለቶች ወይም በአንድ ሰው ከተመረጡ ቃላቶች እጅግ ያነሰ ነው የሚገመተው።";
"onboarding.entropy.learn_more.security.footer" = "አካላዊ ኢንትሮፒ በመሣሪያው የሚመነጨውን የዋሌት የዘፈቀደነት ይተካል፤ ተጨማሪ የይለፍ ቃል ወይም የደህንነት ንብርብር አይደለም።";
"onboarding.entropy.learn_more.safety.section" = "ደህንነቱ በተጠበቀ ሁኔታ ይጠቀሙበት";
"onboarding.entropy.learn_more.safety.fair.title" = "ሚዛናዊና ገለልተኛ ውጤቶችን ይመዝግቡ";
"onboarding.entropy.learn_more.safety.fair.detail" = "ሚዛናዊ ሳንቲም ወይም ዳይ ይጠቀሙ፣ እያንዳንዱ ውጤትም ከሌላው ገለልተኛ መሆኑን ያረጋግጡ። የዘፈቀደ አሃዞቹ ከማስታወስ ወይም ከሥርዓተ ጥለት ሳይሆን ከእውነተኛ አካላዊ ምንጭ መምጣት አለባቸው።";
"onboarding.entropy.learn_more.safety.private.title" = "የኢንትሮፒ ሂደትዎን በሚስጥር ይጠብቁ";
"onboarding.entropy.learn_more.safety.private.detail" = "የተመዘገበውን ቅደም ተከተልና የተጠናቀቀውን የመልሶ ማግኛ ሐረግ እንደ ዋሌት ሚስጥሮች ይጠብቁ። ካሜራዎችና ሌሎች ሰዎች ሊያዩአቸው ከሚችሉበት ቦታ ያርቁ።";
"onboarding.entropy.learn_more.safety.accurate.title" = "እያንዳንዱን ውጤት በትክክል ይመዝግቡ";
"onboarding.entropy.learn_more.safety.accurate.detail" = "አንድ የጎደለ፣ የተደገመ ወይም ቅደም ተከተሉ የተለወጠ ውጤት የተለየ ዋሌት ይፈጥራል። ወደ ዋሌቱ ገንዘብ ከማስገባትዎ በፊት እያንዳንዱን ግቤት ይመርምሩና የተጠናቀቀውን የመልሶ ማግኛ ሐረግ ያረጋግጡ።";
"onboarding.entropy.learn_more.safety.backup.title" = "የመልሶ ማግኛ ሐረጉን ይጠብቁ";
"onboarding.entropy.learn_more.safety.backup.detail" = "የመልሶ ማግኛ ሐረጉን ከመስመር ውጭ ያከማቹ እና በጭራሽ አያጋሩት። ምትኬውን ካረጋገጡ በኋላ የማያስፈልጉዎትን መካከለኛ የግቤት መዝገብ ደህንነቱ በተጠበቀ ሁኔታ ያጥፉ።";
"onboarding.entropy.learn_more.safety.footer" = "አካላዊ ኢንትሮፒ የተጋለጠ የመልሶ ማግኛ ሐረግን፣ ጥቃት የደረሰበትን መሣሪያ፣ ተንኮል አዘል ሶፍትዌርን ወይም በስህተት የተመዘገበ ቅደም ተከተልን ሊጠብቅ አይችልም። ሚዛናዊ፣ የግልና ትክክለኛ ግብዓቶችን ማረጋገጥ ካልቻሉ በምትኩ መደበኛውን የዋሌት መፍጠሪያ ይጠቀሙ።";
