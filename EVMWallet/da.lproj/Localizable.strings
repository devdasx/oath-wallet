"onboarding.carousel.wallet.eyebrow" = "DIN OATH WALLET";
"onboarding.carousel.wallet.title" = "Én wallet til alle dine handlinger.";
"onboarding.carousel.wallet.message" = "Oath giver dine aktiver et moderne, integreret hjem med overblik på tværs af netværk, hurtig respons og fuld kontrol.";
