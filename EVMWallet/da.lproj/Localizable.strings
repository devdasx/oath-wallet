"onboarding.carousel.entropy.eyebrow" = "ENTROPI FRA FYSISKE KILDER";
"onboarding.carousel.entropy.title" = "Skab tilfældighed, du selv har fuld kontrol over.";
"onboarding.carousel.entropy.message" = "Kast terninger, slå plat eller krone, eller registrér tilfældige cifre. Oath omdanner dine fysiske input til præcis 256 bit entropi til brug for en gendannelsessætning på 24 ord – udelukkende på din enhed.";
"onboarding.carousel.entropy.visual.output" = "256 bit brugergenereret entropi";
"onboarding.carousel.entropy.visual.local" = "Genereret udelukkende ud fra dine registrerede input";
"onboarding.carousel.entropy.visual.accessibility" = "En nummereret terning, en mønt og tilfældige cifre kombineres til 256 bit walletentropi på denne enhed.";
"onboarding.carousel.entropy.learn_more.action" = "Se flere oplysninger";
"onboarding.entropy.learn_more.navigation" = "Sådan fungerer fysisk entropi";
"onboarding.entropy.learn_more.path.section" = "Fra fysiske udfald til gendannelsesord";
"onboarding.entropy.learn_more.overview" = "Oath registrerer udfaldene fra den valgte fysiske kilde og omdanner dem til en værdi på 256 bit. De resulterende 32 byte sendes derefter til Wallet Core, som opretter en standardiseret BIP-39-gendannelsessætning.";
"onboarding.entropy.learn_more.visual.phrase" = "En BIP-39-gendannelsessætning på 24 ord";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit er lig med 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Et gitter med 256 bitceller fordelt på 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Terningekast, møntkast eller tilfældige cifre omdannes til 256 bit og derefter til en BIP-39-gendannelsessætning på 24 ord.";
"onboarding.entropy.learn_more.inputs.section" = "Trin 1: Registrér fysiske udfald";
"onboarding.entropy.learn_more.inputs.dice.title" = "Kast en balanceret seksidet terning";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Med en balanceret terning bidrager siderne 1-4 hver med 2 bit, mens siderne 5-6 hver bidrager med 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Fysiske møntkast";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Hvert uafhængigt kast med en balanceret mønt bidrager med 1 upartisk entropibit.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registrér tilfældige cifre";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cifrene 0-7 bidrager hver med 3 bit. Cifrene 8-9 bidrager hver med 1 bit. Cifrene skal komme fra en virkelig tilfældig fysisk proces.";
"onboarding.entropy.learn_more.inputs.footer" = "Brug en upartisk fysisk kilde, og registrér hvert resultat i rækkefølge. Du kan skifte inputmetode, fordi hvert godkendt resultat indgår i den samme bitstrøm.";
"onboarding.entropy.learn_more.conversion.section" = "2. Sammensæt en værdi på 256 bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath omdanner terningeudfald og decimale cifre til upartiske grupper med størrelser, der er potenser af 2. Bidragenes længde kan variere, men en upartisk fysisk kilde favoriserer ingen bitværdi.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath tilføjer bit i den indtastede rækkefølge, indtil den har indsamlet præcis 256 bit, og pakker dem derefter i 32 byte med den mest betydende bit først.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Brugerdefineret entropi indeholder kun de fysiske input, du registrerer. Oath blander ingen enhedsgenereret tilfældighed i.";
"onboarding.entropy.learn_more.bip39.section" = "3. Udled gendannelsessætningen";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bit entropi";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "En BIP-39-kontrolsum på 8 bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit opdelt i 24 ordindekser på 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "En 256-bit entropiværdi plus en 8-bit kontrolsum skaber 264 bit, som opdeles i 24 ordindekser på hver 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 beregner SHA-256 af entropiværdien på 32 byte og bruger de første 8 hashbit som kontrolsum. Når kontrolsummen tilføjes, bliver resultatet 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "De 264 bit opdeles i 24 grupper på 11 bit. Hver gruppe vælger én post fra BIP-39-standardlisten med 2.048 ord og danner dermed gendannelsessætningen på 24 ord.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core udleder deterministiske konti og adresser fra det resulterende seed. Den samme gendannelsessætning og valgfrie adgangssætning genskaber altid den samme wallet.";
"onboarding.entropy.learn_more.security.section" = "Sådan styrker brugerdefineret entropi sikkerheden";
"onboarding.entropy.learn_more.security.space.title" = "Et enormt antal muligheder";
"onboarding.entropy.learn_more.security.space.detail" = "Ensartet entropi på 256 bit rummer 2^256 unikke værdier, hvilket gør udtømmende afprøvning beregningsmæssigt urealistisk. Dette beskriver inputrummets størrelse, men betyder ikke, at alle kryptografiske komponenter yder modstandsdygtighed på 256 bit over for angreb.";
"onboarding.entropy.learn_more.security.source.title" = "Tilfældigheden kommer fra dig";
"onboarding.entropy.learn_more.security.source.detail" = "Fysiske hændelser lader dig skabe tilfældigheden til din wallet uafhængigt i stedet for udelukkende at stole på enhedens generator af tilfældige tal. Det forbedrer kun sikkerheden, hvis hændelserne reelt er tilfældige.";
"onboarding.entropy.learn_more.security.local.title" = "Behandles udelukkende på denne enhed";
"onboarding.entropy.learn_more.security.local.detail" = "Oath omdanner din registrerede sekvens og opretter gendannelsessætningen udelukkende på denne enhed. Sekvensen uploades aldrig til behandling.";
"onboarding.entropy.learn_more.security.patterns.title" = "Undgå menneskevalgte hemmeligheder";
"onboarding.entropy.learn_more.security.patterns.detail" = "En lang sekvens af upartiske, uafhængige hændelser er langt mindre forudsigelig end fødselsdage, yndlingstal, gentagne mønstre eller ord valgt af et menneske.";
"onboarding.entropy.learn_more.security.footer" = "Fysisk entropi erstatter den enhedsgenererede tilfældighed til walleten. Den er ikke en ekstra adgangskode eller et ekstra sikkerhedslag.";
"onboarding.entropy.learn_more.safety.section" = "Brug funktionen på sikker vis";
"onboarding.entropy.learn_more.safety.fair.title" = "Registrér upartiske, uafhængige resultater";
"onboarding.entropy.learn_more.safety.fair.detail" = "Brug en balanceret mønt eller terning, og sørg for, at hvert resultat er uafhængigt. Tilfældige cifre skal komme fra en ægte fysisk kilde – ikke fra hukommelsen eller et mønster.";
"onboarding.entropy.learn_more.safety.private.title" = "Hold entropiprocessen privat";
"onboarding.entropy.learn_more.safety.private.detail" = "Beskyt både den registrerede sekvens og den færdige gendannelsessætning som hemmelige walletoplysninger. Hold dem ude af syne for kameraer og andre personer.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registrér hvert resultat præcist";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Ét manglende, gentaget eller omrokeret resultat skaber en anden wallet. Gennemgå hver indtastning, og bekræft den færdige gendannelsessætning, før du overfører midler til walleten.";
"onboarding.entropy.learn_more.safety.backup.title" = "Beskyt gendannelsessætningen";
"onboarding.entropy.learn_more.safety.backup.detail" = "Opbevar gendannelsessætningen offline, og del den aldrig. Når du har bekræftet sikkerhedskopien, skal du destruere alle mellemliggende inputregistreringer, du ikke længere har brug for, på sikker vis.";
"onboarding.entropy.learn_more.safety.footer" = "Fysisk entropi kan ikke beskytte en afsløret gendannelsessætning, en kompromitteret enhed, skadelig software eller en forkert registreret sekvens. Hvis du ikke kan garantere upartiske, private og præcise input, bør du bruge standardoprettelse af en wallet i stedet.";
"onboarding.carousel.open_source.eyebrow" = "ÅBEN KILDEKODE FRA STARTEN";
"onboarding.carousel.open_source.title" = "Undersøg kildekoden. Verificér buildet.";
"onboarding.carousel.open_source.message" = "Oath offentliggør sin kildekode, så den kan undersøges uafhængigt. En udgivelse er kun verificeret, når et reproducerbart build matcher den offentliggjorte apps fingeraftryk.";
"onboarding.carousel.open_source.action.github" = "Gennemgå på GitHub";
"onboarding.carousel.open_source.visual.repository" = "Offentligt kodedepot";
"onboarding.carousel.open_source.visual.repository.path" = "Se github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Gennemgå kildekoden";
"onboarding.carousel.open_source.visual.rebuild" = "Reproducér udgivelsesbuildet";
"onboarding.carousel.open_source.visual.compare" = "Sammenlign buildartefakter";
"onboarding.carousel.open_source.visual.fingerprint" = "Offentliggjort udgivelsesfingeraftryk";
"onboarding.carousel.open_source.visual.match" = "OVERENSSTEMMELSE BEKRÆFTET — BUILD VERIFICERET";
"onboarding.carousel.open_source.visual.accessibility" = "Et diagram, der viser, at verificering af en udgivelse kræver offentlig kildekode, en uafhængig reproduktion af buildet og matchende fingeraftryk.";
"onboarding.carousel.passphrase.eyebrow" = "VALGFRI BIP-39-ADGANGSSÆTNING";
"onboarding.carousel.passphrase.title" = "Én gendannelsessætning. Én ekstra hemmelighed.";
"onboarding.carousel.passphrase.message" = "En BIP-39-adgangssætning kombineres med din gendannelsessætning for at udlede en separat wallet. Selvom gendannelsesordene afsløres, kræver adgang til denne wallet stadig den nøjagtige adgangssætning.";
"onboarding.carousel.passphrase.visual.phrase" = "Dine 24 gendannelsesord";
"onboarding.carousel.passphrase.visual.passphrase" = "Din ekstra hemmelige adgangssætning";
"onboarding.carousel.passphrase.visual.output" = "En separat wallet med adgangssætning";
"onboarding.carousel.passphrase.visual.requirement" = "Begge hemmeligheder kræves til gendannelse";
"onboarding.carousel.passphrase.visual.accessibility" = "En gendannelsessætning på 24 ord og en hemmelig BIP-39-adgangssætning udleder en separat wallet, som kræver begge hemmeligheder ved gendannelse.";
"onboarding.carousel.passphrase.learn_more.action" = "Se flere oplysninger";
"onboarding.passphrase.learn_more.navigation" = "Sådan fungerer BIP-39-adgangssætninger";
"onboarding.passphrase.learn_more.path.section" = "To hemmeligheder udleder én wallet";
"onboarding.passphrase.learn_more.overview" = "En BIP-39-adgangssætning er en valgfri hemmelighed, der kombineres med din gendannelsessætning. Sammen udleder de deterministisk en wallet, som adskiller sig fra den, gendannelsessætningen alene opretter.";
"onboarding.passphrase.learn_more.visual.phrase" = "Din gendannelsessætning på 24 ord";
"onboarding.passphrase.learn_more.visual.passphrase" = "Din hemmelige adgangssætning";
"onboarding.passphrase.learn_more.visual.wallet" = "En wallet beskyttet med adgangssætning";
"onboarding.passphrase.learn_more.visual.accessibility" = "En gendannelsessætning på 24 ord og en hemmelig adgangssætning kombineres og udleder en separat wallet, der er beskyttet med adgangssætningen.";
"onboarding.passphrase.learn_more.derivation.section" = "Sådan udleder BIP-39 din wallet";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Gendannelsessætning kombineret med adgangssætning";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2.048 runder";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Masterseed på 512 bit";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Udledte walletkonti og -adresser";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Din gendannelsessætning og adgangssætning behandles gennem 2.048 runder med PBKDF2-HMAC-SHA512 og danner et seed på 512 bit, som walletkonti og -adresser udledes fra.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 bruger den normaliserede gendannelsessætning som PBKDF2-adgangskode og ordet \"mnemonic\" efterfulgt af den normaliserede adgangssætning som salt. Efter 2.048 runder med PBKDF2-HMAC-SHA512 danner processen et seed på 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Før seedet udledes, anvender Oath den Unicode-normalisering, som BIP-39 kræver, så den samme normaliserede gendannelsessætning og adgangssætning altid genskaber den samme wallet.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "En adgangssætning krypterer ikke dine gendannelsesord. Den ændrer det udledte seed, så enhver anden adgangssætning danner andre konti og adresser.";
"onboarding.passphrase.learn_more.wallets.section" = "Hver adgangssætning udleder en separat wallet";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Eksempel på adgangssætning 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Eksempel på adgangssætning 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Eksempelwallet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Eksempelwallet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Den samme gendannelsessætning kombineret med to forskellige adgangssætninger udleder to separate wallets: Wallet A og Wallet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Ændres blot ét betydningsbærende tegn, udledes et andet seed og dermed en anden wallet. Den oprindelige wallet forbliver uændret.";
"onboarding.passphrase.learn_more.wallets.empty" = "En tom adgangssætning åbner den standardwallet, der udledes af gendannelsessætningen alene. En adgangssætning, der ikke er tom, åbner sin egen separate wallet.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 viser ingen fejl om en \"forkert adgangssætning\". Alle adgangssætninger er gyldige, så en tastefejl åbner en anden wallet uden varsel – typisk med en saldo på nul.";
"onboarding.passphrase.learn_more.security.section" = "Sådan giver en adgangssætning ekstra beskyttelse";
"onboarding.passphrase.learn_more.security.words.title" = "Gendannelsesordene alene er ikke nok";
"onboarding.passphrase.learn_more.security.words.detail" = "En person, der kun får fat i din gendannelsessætning, skal stadig have den nøjagtige adgangssætning for at udlede og få adgang til den beskyttede wallet.";
"onboarding.passphrase.learn_more.security.strength.title" = "En stærk adgangssætning giver bedre adskillelse";
"onboarding.passphrase.learn_more.security.strength.detail" = "En lang og uforudsigelig adgangssætning gør det væsentligt sværere at gætte. Et kort citat, en fødselsdag, et navn eller en genbrugt adgangskode kan gættes hurtigt og giver kun ringe beskyttelse.";
"onboarding.passphrase.learn_more.security.separation.title" = "Hold adgangssætningen adskilt";
"onboarding.passphrase.learn_more.security.separation.detail" = "Opbevar adgangssætningen adskilt fra gendannelsessætningen, så en enkelt stjålet sikkerhedskopi ikke afslører begge hemmeligheder, som kræves for at gendanne din wallet.";
"onboarding.passphrase.learn_more.security.footer" = "En adgangssætning kan ikke beskytte dine midler, hvis begge hemmeligheder afsløres, hvis adgangssætningen er svag, eller hvis kompromitteret software opsnapper den under indtastningen.";
"onboarding.passphrase.learn_more.safety.section" = "Brug funktionen på sikker vis";
"onboarding.passphrase.learn_more.safety.strong.title" = "Opret en stærk, unik adgangssætning";
