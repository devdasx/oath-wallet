// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Skub for at sende erstatter bekræftelsesknappen. Retningsanimation, haptik og jævnere bevægelse understøtter begge læseretninger. Slip ved mindst 90% for at sende; skub tilbage for at annullere.";
"settings.about.history.v355.build56.activity" = "Klokken åbner afventende aktivitet. Transaktionskapsler viser statusmærker og kan stryges væk. Kapsler under bekræftelse og bekræftede kapsler skjules efter 3 sekunder; bekræftelsen opdaterer den samme synlige kapsel.";
"settings.about.history.v355.build56.status" = "Mere pålidelig transaktionsstatus på alle understøttede netværk, løbende opdaterede transaktionsdetaljer og hurtigere saldoopdateringer efter afsendelse. Overvågning af afventende transaktioner genoptages, når appen åbnes igen.";
"settings.about.history.v355.build56.fees" = "Når du vender tilbage til samme overførselsgennemgang, bevares det hentede gebyr. Tydeligere gebyrindlæsning og advarsler om kontofinansiering; tilstrækkelige beløb viser ikke længere aktiveringsmeddelelser.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin og Dogecoin lægger byttepenge under støvgrænsen til gebyret i stedet for at oprette et ubrugeligt output. Det gennemgåede gebyr stemmer med underskrivningen.";
"settings.about.history.v355.build56.stability" = "Rettede et nedbrud i en baggrundsopgave og timeoutadvarsler ved opdatering af tegnebogen. Ved midlertidige opdateringsfejl er eksisterende tegnebogsoplysninger stadig tilgængelige.";
"settings.about.history.v355.build56.backup" = "Enklere sikkerhedskopiskærme med korrekte titler ved åbning og færre meddelelser. Adgang til private nøgler respekterer indstillingerne for applås. Kompakte importadvarsler med glasudseende rydder afvist input, når du vælger en anden gendannelsessætning.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Når du slipper skyderen til afsendelse, vises et animeret flueben, før gennemgangen lukkes.";
"settings.about.history.v355.build57.activity" = "Aktivitetsrækker viser status i en lettere skrifttype, beløbet som undertekst og en pil til at åbne transaktionsoplysninger.";
"settings.about.history.v355.build57.details" = "Netværksgebyrer vises nu i overførselsoversigten. Kortere etiketter og én netværksrække gør oplysningerne mere overskuelige.";
"settings.about.history.v355.build57.resume" = "Når du vender tilbage fra baggrunden, bevares åbne skærme og paneler, herunder gennemgang af overførsler og transaktionsoplysninger.";
"settings.about.history.v355.build57.secrets" = "Skærme med gendannelsesfrase, privat nøgle og adgangsfrase lukkes efter 20 sekunders fravær. Appens lås følger fortsat dine indstillinger.";
"settings.about.history.v355.build57.filters" = "Netværksfiltre bruger lidt højere systemknapper, tilpasser størrelsen til indholdet og har rettet afstand under navigationslinjen.";
"settings.about.history.v355.build57.units" = "Separate værdirækker er fjernet. Beløb og netværksgebyr vises først i lokal valuta; tryk på et af dem for at skifte til kryptoenheder og tilbage.";
"wallet.transaction.details.toggle_units" = "Skift enheder.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Startskærmen åbner uden udtonings- eller skaleringseffekter. Knappen til indstillinger bruger nu et tandhjulsikon.";
"settings.about.history.v355.build58.fields" = "Felter for transaktioner og afsendelse bruger almindelige tekstfarver. Pile vises kun på rækker, der åbner en skærm eller et panel; tryk på beløb og gebyrer skifter stadig enhed.";
"settings.about.history.v355.build58.banners" = "Når bannere for igangværende eller afsluttet bekræftelse er vist, forsvinder de efter 3 sekunder, også hvis du åbner en anden skærm. Bekræftelser, der endnu ikke er vist, vises, når du vender tilbage.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "TRON-overførsler reserverer nu aktiverings- og båndbreddegebyrer, før beløbet, der skal sendes, beregnes, også når du sender det maksimale beløb. Gennemgangen viser det korrekte beløb efter gebyrer.";
"settings.about.history.v355.build59.fees" = "Brugerdefinerede TRON-gebyrer skal dække de nødvendige netværksomkostninger. Ved lav TRX-saldo vises nu tydeligere vejledning. Tokenbeløbet forbliver uændret; gebyrer betales i TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "En ny velkomst";
"settings.about.history.v356.welcome" = "En ny velkomstskærm med animerede illustrationer og klare muligheder for at oprette eller importere en tegnebog.";
"settings.about.history.v357.tour.title" = "Velkomstrundvisning";
"settings.about.history.v357.tour" = "En rundvisning på fem sider præsenterer understøttede netværk, fysisk entropi, afsendelse og modtagelse, sikkerhed og verificerede builds. Stryg eller tryk på prikkerne for at skifte side; sprogvælgeren sidder i navigationslinjen.";
"settings.about.history.v357.backup" = "Når du har oprettet, importeret eller gendannet en tegnebog, vises skærmen med det samme, og dens sikkerhedskopimuligheder bruger standardlisten. iCloud-kontrollen kører i baggrunden, og Åbn tegnebog er klar, så snart tegnebogen er gemt.";
"settings.about.history.v357.reliability" = "Når du vender tilbage fra baggrunden, lukkes opsætningsskærmen ikke længere, hvis en skjult gendannelsesskærm udløber, og sletning af alle data åbner velkomstskærmen direkte.";
"settings.about.history.v357.notifications" = "Notifikationsindstillingerne bruger enklere formuleringer for kategorier og status uden tekniske detaljer.";
"settings.about.history.v357.wallets" = "Omarranger tegnebøger i skifteren med et langt tryk og systemets løfteanimation; et tryk på en række aktiverer den. Bekræftelse af gendannelsesfrasen nummererer hvert ord, og Retur går videre til næste felt.";
"settings.about.history.v357.send" = "Afsendelse viser beløbet, mens overførslen er i gang, en tydeligere besked vises, hvis den ikke kan sendes, og TRON-anmodninger prøver automatisk igen efter midlertidige udbyderfejl.";
"settings.about.history.v357.security" = "Importerede TRON-konti, hvis ejertilladelse er flyttet til en anden nøgle, viser nu advarslen og kan ikke sende, selv når hver tilladelse kun angiver én nøgle. Flere kendte eksponerede gendannelsesfraser og private nøgler afvises ved import.";
"settings.about.history.v356.localization" = "Teksten på velkomstskærmen er nu mere naturlig og tydelig på alle understøttede sprog.";
"settings.about.history.v356.pricing" = "Tokenpriser matcher nu det nøjagtige netværk og tokenadresse, ved at bruge DEX-priser først. Små priser viser op til 8 decimaler uden afrunding.";
"settings.about.history.v356.appearance" = "Primære og sekundære knapper bruger nu ensartede højder og skærmmargener, med blå system til primære handlinger.";
"settings.about.history.v356.transactions" = "Transaktionsdetaljer bruger en kortere bekræftet status og klarere grå tekst for datoer, adresser, beløb og transaktions-id'er.";
"settings.about.history.v356.security" = "Udvidede listen over kendte udsatte gendannelsessætninger og private nøgler, der ikke kan importeres.";

