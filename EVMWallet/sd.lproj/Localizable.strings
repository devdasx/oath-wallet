"onboarding.entropy.learn_more.inputs.footer" = "مناسب جسماني ذريعو استعمال ڪريو ۽ هر نتيجو ترتيب سان رڪارڊ ڪريو. توهان ان پٽ جو طريقو بدلائي سگهو ٿا، ڇو ته هر قبول ٿيل نتيجو ساڳئي بٽ وهڪري ۾ شامل ٿئي ٿو.";
"onboarding.entropy.learn_more.conversion.section" = "2. 256 بٽ قدر گڏ ڪريو";
