"onboarding.entropy.learn_more.security.space.detail" = "هڪجهڙي ورڇ واري 256 بٽ اينٽروپي ۾ 2^256 منفرد قدر هوندا آهن، جنهن ڪري هر امڪان آزمائڻ ڳڻپيوڪر لحاظ کان ممڪن نٿو رهي. هي ان پٽ جي دائري جي ماپ بيان ڪري ٿو؛ ان مان اهو مراد ناهي ته هر ڪرپٽوگرافڪ جزو 256 بٽ حملي جي مزاحمت ڏئي ٿو.";
"onboarding.entropy.learn_more.security.source.title" = "بي ترتيبي توهان وٽان اچي ٿي";
"onboarding.entropy.learn_more.security.source.detail" = "جسماني واقعا توهان کي رڳو ڊوائيس جي بي ترتيب انگ ٺاهيندڙ تي ڀاڙڻ بدران، والٽ جي بي ترتيبي آزاديءَ سان مهيا ڪرڻ ڏين ٿا. سيڪيورٽي تڏهن ئي بهتر ٿيندي، جڏهن اهي واقعا واقعي بي ترتيب هجن.";
"onboarding.entropy.learn_more.security.local.title" = "مڪمل عمل هن ڊوائيس تي";
"onboarding.entropy.learn_more.security.local.detail" = "Oath توهان جي رڪارڊ ڪيل سلسلي کي بدلائي، بحالي وارو جملو مڪمل طور هن ڊوائيس تي ٺاهي ٿو. توهان جو سلسلو پروسيسنگ لاءِ ڪڏهن به اپلوڊ نٿو ٿئي.";
"onboarding.entropy.learn_more.security.patterns.title" = "ماڻهوءَ جي چونڊيل رازن کان پاسو ڪريو";
"onboarding.entropy.learn_more.security.patterns.detail" = "منصفانه، آزاد واقعن جو هڪ ڊگهو سلسلو سالگره، پسنديده انگ، ورجايل نمونن، يا ڪنهن شخص جي چونڊيل لفظن جي ڀيٽ ۾ تمام گهٽ اڳڪٿي لائق آهي.";
"onboarding.entropy.learn_more.security.footer" = "جسماني اينٽروپي ڊوائيس جي ٺاهيل والٽ بي ترتيبيءَ جي جاءِ وٺي ٿي؛ اها ڪو اضافي پاسورڊ يا سيڪيورٽي پرت ناهي.";
