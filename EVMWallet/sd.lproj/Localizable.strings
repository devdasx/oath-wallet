"onboarding.entropy.learn_more.safety.fair.detail" = "مناسب سڪو يا پاسو استعمال ڪريو ۽ پڪ ڪريو ته هر نتيجو آزاد هجي. بي ترتيب انگ ڪنهن حقيقي جسماني ذريعي مان اچڻ گهرجن—يادگيري يا نموني مان نه.";
"onboarding.entropy.learn_more.safety.private.title" = "پنهنجي اينٽروپي جو عمل خانگي رکو";
"onboarding.entropy.learn_more.safety.private.detail" = "رڪارڊ ڪيل سلسلي ۽ مڪمل ٿيل بحالي واري جملي، ٻنهي کي والٽ جي رازن وانگر محفوظ رکو. انهن کي ڪئميرائن ۽ ٻين ماڻهن جي نظر کان پري رکو.";
"onboarding.entropy.learn_more.safety.accurate.title" = "هر نتيجو بلڪل صحيح رڪارڊ ڪريو";
"onboarding.entropy.learn_more.safety.accurate.detail" = "هڪ نتيجو رهجي وڃڻ، ورجائجڻ يا ترتيب بدلجڻ سان مختلف والٽ ٺهي ٿو. هر داخلا جاچيو ۽ والٽ ۾ رقم وجهڻ کان اڳ مڪمل ٿيل بحالي واري جملي جي تصديق ڪريو.";
"onboarding.entropy.learn_more.safety.backup.title" = "بحالي واري جملي کي محفوظ ڪريو";
"onboarding.entropy.learn_more.safety.backup.detail" = "بحالي وارو جملو آف لائن محفوظ رکو ۽ ڪڏهن به شيئر نه ڪريو. بيڪ اپ جي تصديق کان پوءِ، وچ وارا اهي سڀ ان پٽ رڪارڊ محفوظ طريقي سان تباهه ڪريو، جن جي هاڻي ضرورت ناهي.";
"onboarding.entropy.learn_more.safety.footer" = "جسماني اينٽروپي ظاهر ٿيل بحالي واري جملي، سمجهوتو ٿيل ڊوائيس، نقصانڪار سافٽ ويئر يا غلط رڪارڊ ڪيل سلسلي کان بچاءُ نٿي ڪري سگهي. جيڪڏهن توهان مناسب، خانگي ۽ بلڪل صحيح ان پٽن جي ضمانت نٿا ڏئي سگهو ته معياري والٽ ٺاهڻ وارو طريقو استعمال ڪريو.";
