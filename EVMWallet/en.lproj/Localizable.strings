"onboarding.carousel.entropy.eyebrow" = "ENTROPY FROM PHYSICAL INPUTS";
"onboarding.carousel.entropy.title" = "Create Randomness You Fully Control.";
"onboarding.carousel.entropy.message" = "Roll dice, flip a coin, or record random digits. Oath converts your physical input into exactly 256 bits of entropy for a 24-word recovery phrase, entirely on your device.";
"onboarding.carousel.entropy.visual.output" = "256 Bits of User-Generated Entropy";
"onboarding.carousel.entropy.visual.local" = "Generated Entirely from Your Recorded Inputs";
"onboarding.carousel.entropy.visual.accessibility" = "A numbered die, a coin, and random digits combine to produce 256 bits of wallet entropy on this device.";
"onboarding.carousel.entropy.learn_more.action" = "Explore More Details";
"onboarding.entropy.learn_more.navigation" = "How Physical Entropy Works";
"onboarding.entropy.learn_more.path.section" = "From Physical Outcomes to Recovery Words";
"onboarding.entropy.learn_more.overview" = "Oath records outcomes from your chosen physical source and converts them into a 256-bit value. The resulting 32 bytes are then passed to Wallet Core to create a standard BIP-39 recovery phrase.";
"onboarding.entropy.learn_more.visual.phrase" = "A 24-Word BIP-39 Recovery Phrase";
"onboarding.entropy.learn_more.visual.bits" = "32 bytes × 8 bits equals 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "A grid of 256 sample bit cells arranged into 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Dice rolls, coin flips, or random digits are converted into 256 bits and then into a 24-word BIP-39 recovery phrase.";
"onboarding.entropy.learn_more.inputs.section" = "Step 1: Record Physical Outcomes";
"onboarding.entropy.learn_more.inputs.dice.title" = "Roll a Fair Six-Sided Die";
"onboarding.entropy.learn_more.inputs.dice.detail" = "With a fair die, faces 1–4 each contribute 2 bits; faces 5–6 each contribute 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Physical Coin Flips";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Each fair, independent coin flip contributes one unbiased bit of entropy.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Record Random Digits";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Digits 0–7 each contribute 3 bits; digits 8–9 each contribute 1 bit. The digits must come from a genuinely random physical process.";
"onboarding.entropy.learn_more.inputs.footer" = "Use a fair physical source and record every result in order. You may switch input methods because each accepted result contributes to the same bit stream.";
"onboarding.entropy.learn_more.conversion.section" = "2. Assemble a 256-Bit Value";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath converts dice results and decimal digits into unbiased power-of-two groups. Contribution lengths may vary, but a fair physical source does not favor any bit value.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath appends bits in the order entered until it collects exactly 256, then packs them into 32 bytes with the most significant bit first.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Custom entropy contains only the physical inputs you record; Oath does not mix in device-generated randomness.";
"onboarding.entropy.learn_more.bip39.section" = "3. Derive the Recovery Phrase";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 Bits of Entropy";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "An 8-Bit BIP-39 Checksum";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits divided into 24 eleven-bit word indexes";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "A 256-bit entropy value receives an 8-bit checksum, producing 264 bits that divide into 24 eleven-bit word indexes.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 computes SHA-256 over the 32-byte entropy value and takes the first 8 hash bits as a checksum; appending that checksum produces 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "The 264 bits are divided into 24 groups of 11 bits. Each group selects one entry from the standard 2,048-word BIP-39 list to produce the 24-word recovery phrase.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core derives deterministic accounts and addresses from the resulting seed. The same recovery phrase and optional passphrase will always recreate the same wallet.";
"onboarding.entropy.learn_more.security.section" = "How Custom Entropy Strengthens Security";
"onboarding.entropy.learn_more.security.space.title" = "An Enormous Possibility Space";
"onboarding.entropy.learn_more.security.space.detail" = "Uniform 256-bit entropy contains 2^256 unique values, making exhaustive guessing computationally infeasible. This describes the size of the input space; it does not imply that every cryptographic component provides 256-bit attack resistance.";
"onboarding.entropy.learn_more.security.source.title" = "Randomness Comes from You";
"onboarding.entropy.learn_more.security.source.detail" = "Physical events let you source the wallet’s randomness independently instead of relying solely on a device random-number generator. This improves security only when those events are genuinely random.";
"onboarding.entropy.learn_more.security.local.title" = "Processed Entirely on This Device";
"onboarding.entropy.learn_more.security.local.detail" = "Oath converts your recorded sequence and creates the recovery phrase entirely on this device. Your sequence is never uploaded for processing.";
"onboarding.entropy.learn_more.security.patterns.title" = "Avoid Human-Chosen Secrets";
"onboarding.entropy.learn_more.security.patterns.detail" = "A long sequence of fair, independent events is far less predictable than birthdays, favorite numbers, repeated patterns, or words chosen by a person.";
"onboarding.entropy.learn_more.security.footer" = "Physical entropy replaces device-generated wallet randomness; it is not an additional password or security layer.";
"onboarding.entropy.learn_more.safety.section" = "Use This Feature Safely";
"onboarding.entropy.learn_more.safety.fair.title" = "Record Fair, Independent Results";
"onboarding.entropy.learn_more.safety.fair.detail" = "Use a fair coin or die, and ensure that every result is independent. Random digits must come from a genuine physical source—not from memory or a pattern.";
"onboarding.entropy.learn_more.safety.private.title" = "Keep Your Entropy Process Private";
"onboarding.entropy.learn_more.safety.private.detail" = "Protect both the recorded sequence and the completed recovery phrase as wallet secrets. Keep them out of view of cameras and other people.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Record Every Result Exactly";
"onboarding.entropy.learn_more.safety.accurate.detail" = "One missing, duplicated, or reordered result creates a different wallet. Review every entry and verify the completed recovery phrase before funding the wallet.";
"onboarding.entropy.learn_more.safety.backup.title" = "Secure the Recovery Phrase";
"onboarding.entropy.learn_more.safety.backup.detail" = "Keep the recovery phrase offline and never share it. After verifying your backup, securely destroy any intermediate input record you no longer need.";
"onboarding.entropy.learn_more.safety.footer" = "Physical entropy cannot secure an exposed recovery phrase, a compromised device, malicious software, or an incorrectly recorded sequence. If you cannot guarantee fair, private, and accurate inputs, use standard wallet creation instead.";
"onboarding.carousel.open_source.eyebrow" = "OPEN-SOURCE BY DESIGN";
"onboarding.carousel.open_source.title" = "Inspect the Source. Verify the Build.";
"onboarding.carousel.open_source.message" = "Oath publishes its source code for independent inspection. A release is verified only when a reproducible build matches the fingerprint of the published app.";
