/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "A new welcome";
"settings.about.history.v356.welcome" = "A new welcome screen with animated artwork and clear options to create or import a wallet.";
"settings.about.history.v357.tour.title" = "Welcome tour";
"settings.about.history.v357.tour" = "A five-page tour introduces supported networks, physical entropy, sending and receiving, security, and verified builds. Swipe or tap the dots to move between pages; the language switch is in the navigation bar.";
"settings.about.history.v357.backup" = "After creating, importing, or restoring a wallet, the screen appears immediately and its backup options use the standard list. The iCloud check runs in the background, and Open Wallet is ready as soon as the wallet is saved.";
"settings.about.history.v357.reliability" = "Returning from the background no longer closes the setup screen when a hidden recovery screen expires, and erasing all data opens the welcome screen directly.";
"settings.about.history.v357.notifications" = "Notification settings use plainer wording for categories and status, without technical details.";
"settings.about.history.v357.wallets" = "Reorder wallets in the switcher with a long press using the system lift animation; tapping a row activates it. Recovery phrase verification numbers each word, and Return moves to the next field.";
"settings.about.history.v357.send" = "Sending shows the amount while the transfer is in progress, a clearer message appears if it cannot be sent, and TRON requests retry automatically after temporary provider errors.";
"settings.about.history.v357.security" = "Imported TRON accounts whose owner permission was moved to another key now show the warning and cannot send, even when each permission lists a single key. More known exposed recovery phrases and private keys are refused at import.";
"settings.about.history.v356.localization" = "Refined the welcome screen wording in every supported language for a clearer, more natural introduction.";
"settings.about.history.v356.pricing" = "Token prices now match the exact network and token address, using DEX prices first. Small prices show up to 8 decimal places without rounding.";
"settings.about.history.v356.appearance" = "Primary and secondary buttons now use consistent heights and screen margins, with system blue for primary actions.";
"settings.about.history.v356.transactions" = "Transaction details use a shorter Confirmed status and clearer gray text for dates, addresses, amounts, and transaction IDs.";
"settings.about.history.v356.security" = "Expanded the list of known exposed recovery phrases and private keys that cannot be imported.";

