"onboarding.carousel.passphrase.eyebrow" = "OPTIONAL BIP-39 PASSPHRASE";
"onboarding.carousel.passphrase.title" = "One Recovery Phrase. One Additional Secret.";
"onboarding.carousel.passphrase.message" = "A BIP-39 passphrase combines with your recovery phrase to derive a separate wallet. Even if the recovery words are exposed, accessing that wallet still requires the exact passphrase.";
"onboarding.carousel.passphrase.visual.phrase" = "Your 24 Recovery Words";
"onboarding.carousel.passphrase.visual.passphrase" = "Your Additional Secret Passphrase";
"onboarding.carousel.passphrase.visual.output" = "A Distinct Passphrase Wallet";
"onboarding.carousel.passphrase.visual.requirement" = "Both Secrets Are Required for Recovery";
"onboarding.carousel.passphrase.visual.accessibility" = "A 24-word recovery phrase and a secret BIP-39 passphrase derive a separate wallet that requires both secrets for recovery.";
"onboarding.carousel.passphrase.learn_more.action" = "Explore More Details";
"onboarding.passphrase.learn_more.navigation" = "Understanding BIP-39 Passphrases";
"onboarding.passphrase.learn_more.path.section" = "Two Secrets Derive One Wallet";
"onboarding.passphrase.learn_more.overview" = "A BIP-39 passphrase is an optional secret combined with your recovery phrase. Together, they deterministically derive a wallet that differs from the one created by the recovery phrase alone.";
"onboarding.passphrase.learn_more.visual.phrase" = "Your 24-Word Recovery Phrase";
"onboarding.passphrase.learn_more.visual.passphrase" = "Your Secret Passphrase";
"onboarding.passphrase.learn_more.visual.wallet" = "A Passphrase-Protected Wallet";
"onboarding.passphrase.learn_more.visual.accessibility" = "A 24-word recovery phrase and a secret passphrase combine to derive a separate, passphrase-protected wallet.";
"onboarding.passphrase.learn_more.derivation.section" = "How BIP-39 Derives the Wallet";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Recovery Phrase Combined with Passphrase";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 with 2,048 Rounds";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "512-bit master seed";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Derived Wallet Accounts and Addresses";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Your recovery phrase and passphrase pass through 2,048 rounds of PBKDF2-HMAC-SHA512 to produce the 512-bit seed from which wallet accounts and addresses are derived.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 treats the normalized recovery phrase as the PBKDF2 password and uses “mnemonic” followed by the normalized passphrase as the salt. After 2,048 rounds of PBKDF2-HMAC-SHA512, the process produces a 64-byte seed.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Before deriving the seed, Oath applies the Unicode normalization required by BIP-39 so the same normalized recovery phrase and passphrase always reproduce the same wallet.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "A passphrase does not encrypt your recovery words. It changes the derived seed, so every different passphrase produces different accounts and addresses.";
"onboarding.passphrase.learn_more.wallets.section" = "Each Passphrase Derives a Separate Wallet";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Example Passphrase 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Example Passphrase 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Example Wallet A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Example Wallet B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "The same recovery phrase combined with two different passphrases derives two separate wallets: Wallet A and Wallet B.";
"onboarding.passphrase.learn_more.wallets.different" = "Changing even one meaningful character derives a different seed and therefore a different wallet; the original wallet remains unchanged.";
"onboarding.passphrase.learn_more.wallets.empty" = "An empty passphrase opens the standard wallet derived from the recovery phrase alone; a nonempty passphrase opens its own separate wallet.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 has no “wrong passphrase” response; every passphrase is valid, so a typo silently opens another wallet—usually with a zero balance.";
"onboarding.passphrase.learn_more.security.section" = "How a Passphrase Adds Protection";
"onboarding.passphrase.learn_more.security.words.title" = "Recovery Words Alone Are Not Enough";
"onboarding.passphrase.learn_more.security.words.detail" = "Someone who obtains only your recovery phrase still needs the exact passphrase to derive and access the protected wallet.";
"onboarding.passphrase.learn_more.security.strength.title" = "Strength Creates Better Separation";
"onboarding.passphrase.learn_more.security.strength.detail" = "A long, unpredictable passphrase adds meaningful guessing difficulty; a short quote, birthday, name, or reused password may be guessed quickly and provides little protection.";
"onboarding.passphrase.learn_more.security.separation.title" = "Keep the Passphrase Separate";
"onboarding.passphrase.learn_more.security.separation.detail" = "Store the passphrase separately from the recovery phrase so a single stolen backup does not reveal both secrets required to restore the wallet.";
"onboarding.passphrase.learn_more.security.footer" = "A passphrase cannot protect your funds if both secrets are exposed, the passphrase is weak, or compromised software captures it while you type.";
"onboarding.passphrase.learn_more.safety.section" = "Use This Feature Safely";
"onboarding.passphrase.learn_more.safety.strong.title" = "Create a Strong, Unique Passphrase";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Choose several random words or another high-entropy value that is unique to this wallet. Avoid personal facts, familiar phrases, patterns, and passwords used elsewhere.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Back Up the Passphrase Separately";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Make a durable offline copy of the exact passphrase, store it separately from the recovery phrase, and never rely on memory alone.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Every Character Changes the Wallet";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Re-enter the passphrase exactly as created, including every capital letter, space, punctuation mark, and word. Any difference silently derives another wallet.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Verify Recovery Before Adding Funds";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Before receiving substantial funds, perform a private, controlled recovery test to confirm that the recovery phrase and passphrase recreate the expected addresses.";
"onboarding.passphrase.learn_more.safety.footer" = "No service can reset or recover a lost passphrase. Without the exact passphrase, access to that wallet is permanently lost—even if you still have the recovery phrase.";
