// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Deslizar para enviar sustituye al botón de confirmación. La animación direccional, la respuesta háptica y el movimiento más fluido admiten ambos sentidos de lectura. Suelta al llegar al 90% o más para enviar; retrocede para cancelar.";
"settings.about.history.v355.build56.activity" = "La campana abre la actividad pendiente. Las cápsulas muestran distintivos de estado y se ocultan deslizando. Las que están confirmándose o confirmadas desaparecen tras 3 segundos; la confirmación actualiza la misma cápsula visible.";
"settings.about.history.v355.build56.status" = "Estados más fiables en todas las redes compatibles, detalles de transacciones en directo y actualización del saldo más rápida tras enviar. El seguimiento de operaciones pendientes se reanuda al abrir la app.";
"settings.about.history.v355.build56.fees" = "Volver a la misma revisión de transferencia conserva la comisión obtenida. Carga de comisiones y avisos de fondos para cuentas más claros; los importes suficientes ya no muestran avisos de activación.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin y Dogecoin añaden el cambio inferior al umbral de polvo a la comisión, en lugar de crear una salida inutilizable. La comisión revisada coincide con la de la firma.";
"settings.about.history.v355.build56.stability" = "Corregidos un cierre inesperado de tareas en segundo plano y las alertas de tiempo agotado al actualizar la cartera. Los fallos temporales de actualización mantienen disponible la información existente.";
"settings.about.history.v355.build56.backup" = "Pantallas de copia de seguridad más claras, con títulos correctos al abrir y menos mensajes. El acceso a claves privadas respeta el bloqueo de la app. Los avisos de importación compactos de cristal borran la entrada rechazada al elegir otra frase de recuperación.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Al soltar el control deslizante de envío, aparece una marca de verificación animada antes de que se cierre la revisión.";
"settings.about.history.v355.build57.activity" = "Las filas de actividad muestran el estado con una tipografía más ligera, el importe como subtítulo y una flecha para abrir los detalles de la transacción.";
"settings.about.history.v355.build57.details" = "Las comisiones de red aparecen ahora en el resumen de la transferencia. Las etiquetas más breves y una sola fila para la red aclaran los detalles.";
"settings.about.history.v355.build57.resume" = "Al volver desde segundo plano, se conservan las pantallas y hojas abiertas, incluidas la revisión de transferencias y los detalles de las transacciones.";
"settings.about.history.v355.build57.secrets" = "Las pantallas de frase de recuperación, clave privada y frase de contraseña se cierran tras 20 segundos fuera de la app. El bloqueo de la app sigue respetando tus ajustes.";
"settings.about.history.v355.build57.filters" = "Los filtros de red usan botones nativos ligeramente más altos, con un tamaño adaptado al contenido y un espaciado corregido bajo la barra de navegación.";
"settings.about.history.v355.build57.units" = "Se eliminaron las filas de valor separadas. El importe y la comisión de red se muestran primero en moneda local; toca cualquiera para alternar con las unidades cripto.";
"wallet.transaction.details.toggle_units" = "Cambiar unidades.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "La pantalla de inicio se abre sin efectos de desvanecimiento ni de escala. El botón de ajustes ahora usa un icono de engranaje.";
"settings.about.history.v355.build58.fields" = "Los campos de transacciones y envíos usan los colores de texto habituales. Las flechas aparecen solo en las filas que abren una pantalla o un panel; al tocar importes y comisiones, se sigue cambiando de unidad.";
"settings.about.history.v355.build58.banners" = "Una vez mostrados, los avisos de confirmación en curso o completada desaparecen tras 3 segundos, incluso si abres otra pantalla. Las confirmaciones que aún no se han mostrado aparecen al volver.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Las transferencias de TRON ahora reservan las comisiones de activación y ancho de banda antes de calcular el importe que se enviará, también al enviar el máximo. La revisión muestra el importe correcto tras descontar las comisiones.";
"settings.about.history.v355.build59.fees" = "Las comisiones personalizadas de TRON deben cubrir los costes de red necesarios. Ahora se muestran indicaciones más claras cuando el saldo de TRX es bajo. La cantidad de tokens no cambia; las comisiones se pagan en TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.welcome.title" = "Una nueva pantalla de bienvenida";
"settings.about.history.v356.welcome" = "Una nueva pantalla de bienvenida con ilustraciones animadas y opciones claras para crear o importar una billetera.";
"settings.about.history.v357.tour.title" = "Recorrido de bienvenida";
"settings.about.history.v357.tour" = "Un recorrido de cinco páginas presenta las redes compatibles, la entropía física, el envío y la recepción, la seguridad y las compilaciones verificadas. Desliza o toca los puntos para cambiar de página; el selector de idioma está en la barra de navegación.";
"settings.about.history.v357.backup" = "Tras crear, importar o restaurar una cartera, la pantalla aparece de inmediato y sus opciones de copia de seguridad usan la lista estándar. La comprobación de iCloud se realiza en segundo plano y Abrir cartera está listo en cuanto se guarda la cartera.";
"settings.about.history.v357.reliability" = "Volver desde segundo plano ya no cierra la pantalla de configuración cuando caduca una pantalla de recuperación oculta, y borrar todos los datos abre directamente la pantalla de bienvenida.";
"settings.about.history.v357.notifications" = "Los ajustes de notificaciones usan un lenguaje más sencillo para las categorías y el estado, sin detalles técnicos.";
"settings.about.history.v357.wallets" = "Reordena las carteras en el selector con una pulsación larga y la animación de elevación del sistema; tocar una fila la activa. La verificación de la frase de recuperación numera cada palabra y la tecla Retorno pasa al siguiente campo.";
"settings.about.history.v357.send" = "Al enviar se muestra el importe mientras la transferencia está en curso, aparece un mensaje más claro si no se puede enviar y las solicitudes de TRON se reintentan automáticamente tras errores temporales del proveedor.";
"settings.about.history.v357.security" = "Las cuentas de TRON importadas cuyo permiso de propietario se movió a otra clave ahora muestran el aviso y no pueden enviar, incluso cuando cada permiso incluye una sola clave. Se rechazan al importar más frases de recuperación y claves privadas conocidas como expuestas.";
"settings.about.history.v356.localization" = "Mejoramos los textos de la pantalla de bienvenida en todos los idiomas disponibles para que sean más claros y naturales.";
"settings.about.history.v356.pricing" = "Los precios de los tokens ahora se consultan según la red y la dirección exactas, dando prioridad a los precios de los DEX. Los precios pequeños muestran hasta 8 decimales sin redondear.";
"settings.about.history.v356.appearance" = "Los botones principales y secundarios ahora tienen alturas y márgenes laterales uniformes. Las acciones principales usan el azul del sistema.";
"settings.about.history.v356.transactions" = "Los detalles de las transacciones muestran el estado abreviado Confirmada y un texto gris más legible para fechas, direcciones, importes e identificadores de transacción.";
"settings.about.history.v356.security" = "Se amplió la lista de frases de recuperación y claves privadas que se sabe que han sido expuestas y cuya importación está bloqueada.";

