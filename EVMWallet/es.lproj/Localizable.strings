"onboarding.carousel.wallet.eyebrow" = "TU CARTERA OATH";
"onboarding.carousel.wallet.title" = "Una cartera para cada operación.";
"onboarding.carousel.wallet.message" = "Oath ofrece a tus activos un entorno moderno y nativo, claro en todas las redes, ágil y siempre bajo tu control absoluto.";
"onboarding.carousel.wallet.visual.networks" = "Una vista unificada de todas tus redes";
"onboarding.carousel.wallet.visual.accessibility" = "Una vista previa de Oath mostrando el saldo de la cartera; botones de enviar, recibir y escanear; y los activos Ethereum y Bitcoin.";
"onboarding.carousel.entropy.eyebrow" = "ENTROPÍA DE FUENTES FÍSICAS";
"onboarding.carousel.entropy.title" = "Crea una aleatoriedad que controles por completo.";
"onboarding.carousel.entropy.message" = "Lanza un dado, una moneda o registra dígitos aleatorios. Oath convierte tus datos físicos en exactamente 256 bits de entropía para una frase de recuperación de 24 palabras, íntegramente en tu dispositivo.";
"onboarding.carousel.entropy.visual.output" = "256 bits de entropía generada por ti";
"onboarding.carousel.entropy.visual.local" = "Generada íntegramente a partir de los datos que registraste";
"onboarding.carousel.entropy.visual.accessibility" = "Un dado numerado de seis caras, una moneda y dígitos aleatorios se combinan en un valor de entropía de cartera completo de 256 bits en este dispositivo.";
"onboarding.carousel.entropy.learn_more.action" = "Ver más detalles";
"onboarding.entropy.learn_more.navigation" = "Cómo funciona la entropía física";
"onboarding.entropy.learn_more.path.section" = "De resultados físicos a palabras de recuperación";
"onboarding.entropy.learn_more.overview" = "Oath registra los resultados de la fuente física que elijas y los convierte en un valor de 256 bits. Después, envía los 32 bytes resultantes a Wallet Core para crear una frase de recuperación BIP-39 estándar.";
"onboarding.entropy.learn_more.visual.phrase" = "Frase de recuperación BIP-39 de 24 palabras";
"onboarding.entropy.learn_more.visual.bits" = "32 bytes × 8 bits equivalen a 256 bits";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Una cuadrícula de 256 celdas de bits de muestra distribuidas en 32 bytes.";
"onboarding.entropy.learn_more.visual.accessibility" = "Los dados, los lanzamientos de monedas o los dígitos aleatorios se convierten en exactamente 256 bits y luego en una frase de recuperación BIP-39 de 24 palabras.";
"onboarding.entropy.learn_more.inputs.section" = "Paso 1: registra resultados físicos";
"onboarding.entropy.learn_more.inputs.dice.title" = "Lanza un dado imparcial de seis caras";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Con un dado imparcial, cada cara del 1 al 4 aporta 2 bits y cada cara del 5 al 6 aporta 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Lanzamientos físicos de una moneda";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Cada lanzamiento independiente de una moneda imparcial aporta 1 bit de entropía sin sesgo.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Registra dígitos aleatorios";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Cada dígito del 0 al 7 aporta 3 bits y cada dígito del 8 al 9 aporta 1 bit. Los dígitos deben proceder de un proceso físico realmente aleatorio.";
"onboarding.entropy.learn_more.inputs.footer" = "Usa una fuente física imparcial y registra cada resultado en orden. Puedes cambiar de método de entrada porque cada resultado aceptado contribuye al mismo flujo de bits.";
"onboarding.entropy.learn_more.conversion.section" = "2. Forma un valor de 256 bits";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath convierte los resultados del dado y los dígitos decimales en grupos sin sesgo cuyo tamaño es una potencia de 2. La longitud de cada aportación puede variar, pero una fuente física imparcial no favorece ningún valor de bit.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath añade los bits en el orden introducido hasta reunir exactamente 256 y después los empaqueta en 32 bytes, empezando por el bit más significativo.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "La entropía personalizada solo contiene los datos físicos que registras; Oath no incorpora aleatoriedad generada por el dispositivo.";
"onboarding.entropy.learn_more.bip39.section" = "3. Deriva la frase de recuperación";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "256 bits de entropía";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Una suma de comprobación BIP-39 de 8 bits";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bits divididos en 24 índices de palabras de 11 bits";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Un valor de entropía de 256 bits más una suma de comprobación de 8 bits crea 264 bits, que se dividen en índices de 24 palabras de 11 bits cada uno.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 calcula SHA-256 sobre el valor de entropía de 32 bytes y toma los primeros 8 bits del hash como suma de comprobación; al añadirla se obtienen 264 bits.";
"onboarding.entropy.learn_more.bip39.words" = "Los 264 bits se dividen en 24 grupos de 11 bits. Cada grupo selecciona una entrada de la lista BIP-39 estándar de 2048 palabras para producir la frase de recuperación de 24 palabras.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core deriva cuentas y direcciones deterministas a partir de la semilla resultante. La misma frase de recuperación y la misma frase de contraseña opcional siempre volverán a crear la misma cartera.";
"onboarding.entropy.learn_more.security.section" = "Cómo refuerza la seguridad la entropía personalizada";
"onboarding.entropy.learn_more.security.space.title" = "Un inmenso espacio de posibilidades";
"onboarding.entropy.learn_more.security.space.detail" = "La entropía uniforme de 256 bits contiene 2^256 valores únicos, por lo que resulta inviable probarlos todos por fuerza bruta. Esto describe el tamaño del espacio de entrada; no implica que todos los componentes criptográficos ofrezcan 256 bits de resistencia frente a ataques.";
"onboarding.entropy.learn_more.security.source.title" = "La aleatoriedad procede de ti";
"onboarding.entropy.learn_more.security.source.detail" = "Los eventos físicos te permiten obtener de forma independiente la aleatoriedad de la cartera, sin depender únicamente de un generador de números aleatorios del dispositivo. Esto solo mejora la seguridad cuando los eventos son realmente aleatorios.";
"onboarding.entropy.learn_more.security.local.title" = "Procesamiento íntegro en este dispositivo";
"onboarding.entropy.learn_more.security.local.detail" = "Oath convierte la secuencia que registraste y crea la frase de recuperación íntegramente en este dispositivo. Tu secuencia nunca se carga para procesarla.";
"onboarding.entropy.learn_more.security.patterns.title" = "Evita los secretos elegidos por personas";
"onboarding.entropy.learn_more.security.patterns.detail" = "Una secuencia larga de eventos imparciales e independientes es mucho menos predecible que fechas de nacimiento, números favoritos, patrones repetidos o palabras elegidas por una persona.";
"onboarding.entropy.learn_more.security.footer" = "La entropía física sustituye la aleatoriedad de la cartera generada por el dispositivo; no es una contraseña ni una capa de seguridad adicional.";
"onboarding.entropy.learn_more.safety.section" = "Usa esta función de forma segura";
"onboarding.entropy.learn_more.safety.fair.title" = "Registra resultados imparciales e independientes";
"onboarding.entropy.learn_more.safety.fair.detail" = "Usa una moneda o un dado imparciales y asegúrate de que cada resultado sea independiente. Los dígitos aleatorios deben proceder de una fuente física real, no de la memoria ni de un patrón.";
"onboarding.entropy.learn_more.safety.private.title" = "Mantén en privado el proceso de entropía";
"onboarding.entropy.learn_more.safety.private.detail" = "Protege como secretos de la cartera tanto la secuencia registrada como la frase de recuperación completa. Mantenlas fuera de la vista de cámaras y otras personas.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Registra cada resultado con exactitud";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Un resultado omitido, duplicado o desordenado crea una cartera distinta. Revisa cada entrada y verifica la frase de recuperación completa antes de añadir fondos a la cartera.";
"onboarding.entropy.learn_more.safety.backup.title" = "Protege la frase de recuperación";
"onboarding.entropy.learn_more.safety.backup.detail" = "Guarda la frase de recuperación sin conexión y nunca la compartas. Después de verificar la copia de seguridad, destruye de forma segura cualquier registro intermedio que ya no necesites.";
"onboarding.entropy.learn_more.safety.footer" = "La entropía física no puede proteger una frase de recuperación expuesta, un dispositivo comprometido, software malicioso ni una secuencia registrada de forma incorrecta. Si no puedes garantizar datos imparciales, privados y exactos, usa la creación estándar de carteras.";
"onboarding.carousel.open_source.eyebrow" = "CÓDIGO ABIERTO POR DISEÑO";
"onboarding.carousel.open_source.title" = "Inspecciona el código fuente. Verifica la compilación.";
"onboarding.carousel.open_source.message" = "Oath publica su código fuente para que pueda inspeccionarse de forma independiente. Una versión solo se verifica cuando una compilación reproducible coincide con la huella digital de la app publicada.";
"onboarding.carousel.open_source.action.github" = "Revisar en GitHub";
"onboarding.carousel.open_source.visual.repository" = "Repositorio público de código fuente";
"onboarding.carousel.open_source.visual.repository.path" = "Visitar github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Revisar el código fuente";
"onboarding.carousel.open_source.visual.rebuild" = "Reproducir la compilación de la versión";
"onboarding.carousel.open_source.visual.compare" = "Comparar los artefactos de compilación";
"onboarding.carousel.open_source.visual.fingerprint" = "Huella digital de la versión publicada";
"onboarding.carousel.open_source.visual.match" = "COINCIDENCIA CONFIRMADA — COMPILACIÓN VERIFICADA";
"onboarding.carousel.open_source.visual.accessibility" = "Diagrama que muestra que verificar una versión requiere código fuente público, una recompilación independiente y huellas digitales coincidentes.";
"onboarding.carousel.passphrase.eyebrow" = "FRASE DE CONTRASEÑA BIP-39 OPCIONAL";
"onboarding.carousel.passphrase.title" = "Una frase de recuperación. Un secreto adicional.";
"onboarding.carousel.passphrase.message" = "Una frase de contraseña BIP-39 se combina con tu frase de recuperación para derivar una cartera distinta. Aunque se expongan las palabras de recuperación, acceder a esa cartera seguirá exigiendo la frase de contraseña exacta.";
"onboarding.carousel.passphrase.visual.phrase" = "Tus 24 palabras de recuperación";
"onboarding.carousel.passphrase.visual.passphrase" = "Tu frase de contraseña secreta adicional";
"onboarding.carousel.passphrase.visual.output" = "Una cartera distinta protegida con frase de contraseña";
"onboarding.carousel.passphrase.visual.requirement" = "Se necesitan ambos secretos para recuperarla";
"onboarding.carousel.passphrase.visual.accessibility" = "Una frase de recuperación de 24 palabras y una frase de contraseña BIP-39 secreta derivan una cartera distinta que requiere ambos secretos para recuperarla.";
"onboarding.carousel.passphrase.learn_more.action" = "Ver más detalles";
"onboarding.passphrase.learn_more.navigation" = "Cómo funcionan las frases de contraseña BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Dos secretos derivan una cartera";
"onboarding.passphrase.learn_more.overview" = "Una frase de contraseña BIP-39 es un secreto opcional que se combina con tu frase de recuperación. Juntas derivan de forma determinista una cartera distinta de la creada únicamente con la frase de recuperación.";
"onboarding.passphrase.learn_more.visual.phrase" = "Tu frase de recuperación de 24 palabras";
"onboarding.passphrase.learn_more.visual.passphrase" = "Tu frase de contraseña secreta";
"onboarding.passphrase.learn_more.visual.wallet" = "Cartera protegida con frase de contraseña";
"onboarding.passphrase.learn_more.visual.accessibility" = "Una frase de recuperación de 24 palabras y una frase de contraseña secreta se combinan para derivar una cartera distinta protegida con frase de contraseña.";
"onboarding.passphrase.learn_more.derivation.section" = "Cómo deriva BIP-39 la cartera";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "Frase de recuperación + frase de contraseña";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 · 2048 rondas";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Semilla maestra de 512 bits";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Cuentas y direcciones derivadas de la cartera";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Tu frase de recuperación y tu frase de contraseña pasan por 2048 rondas de PBKDF2-HMAC-SHA512 para producir la semilla de 512 bits de la que se derivan las cuentas y direcciones de la cartera.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 trata la frase de recuperación normalizada como contraseña de PBKDF2 y usa «mnemonic» seguida de la frase de contraseña normalizada como sal. Tras 2048 rondas de PBKDF2-HMAC-SHA512, el proceso produce una semilla de 64 bytes.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Antes de derivar la semilla, Oath aplica la normalización Unicode exigida por BIP-39 para que la misma frase de recuperación y frase de contraseña normalizadas siempre reproduzcan la misma cartera.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Una frase de contraseña no cifra tus palabras de recuperación. Cambia la semilla derivada, por lo que cada frase de contraseña diferente produce cuentas y direcciones distintas.";
"onboarding.passphrase.learn_more.wallets.section" = "Cada frase de contraseña deriva una cartera distinta";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Frase de contraseña de ejemplo 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Frase de contraseña de ejemplo 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Cartera A de ejemplo";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Cartera B de ejemplo";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "La misma frase de recuperación combinada con dos frases de contraseña distintas deriva dos carteras separadas: la cartera A y la cartera B.";
"onboarding.passphrase.learn_more.wallets.different" = "Cambiar incluso un solo carácter significativo deriva una semilla y, por tanto, una cartera distintas; la cartera original no cambia.";
"onboarding.passphrase.learn_more.wallets.empty" = "Una frase de contraseña vacía abre la cartera estándar derivada únicamente de la frase de recuperación; una frase de contraseña no vacía abre su propia cartera independiente.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 no responde que una frase de contraseña es «incorrecta»: todas son válidas, por lo que un error tipográfico abre silenciosamente otra cartera, normalmente con saldo cero.";
"onboarding.passphrase.learn_more.security.section" = "Cómo añade protección una frase de contraseña";
"onboarding.passphrase.learn_more.security.words.title" = "Las palabras de recuperación no son suficientes";
"onboarding.passphrase.learn_more.security.words.detail" = "Quien obtenga solo tu frase de recuperación seguirá necesitando la frase de contraseña exacta para derivar la cartera protegida y acceder a ella.";
"onboarding.passphrase.learn_more.security.strength.title" = "Una frase sólida ofrece mayor separación";
"onboarding.passphrase.learn_more.security.strength.detail" = "Una frase de contraseña larga e impredecible aumenta de forma significativa la dificultad de adivinarla; una cita breve, una fecha de nacimiento, un nombre o una contraseña reutilizada pueden descubrirse rápidamente y ofrecen poca protección.";
"onboarding.passphrase.learn_more.security.separation.title" = "Guarda la frase de contraseña por separado";
"onboarding.passphrase.learn_more.security.separation.detail" = "Guarda la frase de contraseña separada de la frase de recuperación para que el robo de una sola copia de seguridad no revele los dos secretos necesarios para restaurar la cartera.";
"onboarding.passphrase.learn_more.security.footer" = "Una frase de contraseña no puede proteger tus fondos si se exponen ambos secretos, si la frase es débil o si un software comprometido la captura mientras la escribes.";
"onboarding.passphrase.learn_more.safety.section" = "Usa esta función de forma segura";
"onboarding.passphrase.learn_more.safety.strong.title" = "Crea una frase de contraseña sólida y única";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Elige varias palabras aleatorias u otro valor de alta entropía que sea exclusivo de esta cartera. Evita datos personales, frases conocidas, patrones y contraseñas que uses en otros sitios.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Haz una copia aparte de la frase de contraseña";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Crea una copia duradera y sin conexión de la frase de contraseña exacta, guárdala separada de la frase de recuperación y nunca dependas solo de tu memoria.";
