"onboarding.carousel.wallet.eyebrow" = "OATH WALLET ƊINKA";
"onboarding.carousel.wallet.title" = "Walat Guda don Kowane Motsi.";
"onboarding.carousel.wallet.message" = "Oath yana ba wa kadarorinka matsuguni na zamani da ya dace da iOS, mai sauƙin fahimta a duk hanyoyin sadarwa, mai saurin amsawa, kuma gaba ɗaya ƙarƙashin ikonka.";
