"onboarding.carousel.entropy.eyebrow" = "ENTROPY DAGA SHIGARWAR ZAHIRI";
"onboarding.carousel.entropy.title" = "Ƙirƙiri Bazuwar da Ke Gaba Ɗaya Ƙarƙashin Ikonka.";
"onboarding.carousel.entropy.message" = "Jefa ɗan lido, jefa tsabar kuɗi, ko rubuta lambobin bazuwar. Oath yana sauya shigarwarka ta zahiri zuwa daidai bit 256 na entropy don jumlar farfadowa mai kalmomi 24, gaba ɗaya a na'urarka.";
"onboarding.carousel.entropy.visual.output" = "Bit 256 na Entropy da Mai Amfani Ya Ƙirƙira";
"onboarding.carousel.entropy.visual.local" = "An Ƙirƙira Gaba Ɗaya daga Shigarwar da Ka Rubuta";
"onboarding.carousel.entropy.visual.accessibility" = "Ɗan lido mai lamba, tsabar kuɗi, da lambobin bazuwar suna haɗuwa su samar da bit 256 na entropy na walat a wannan na'urar.";
"onboarding.carousel.entropy.learn_more.action" = "Bincika Ƙarin Bayani";
"onboarding.entropy.learn_more.navigation" = "Yadda Entropy na Zahiri Ke Aiki";
"onboarding.entropy.learn_more.path.section" = "Daga Sakamakon Zahiri zuwa Kalmomin Farfadowa";
"onboarding.entropy.learn_more.overview" = "Oath yana rubuta sakamako daga tushen zahiri da ka zaɓa, sannan ya sauya su zuwa ƙimar bit 256. Daga nan ana tura byte 32 da aka samu zuwa Wallet Core don ƙirƙirar daidaitacciyar jumlar farfadowa ta BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "Jumlar Farfadowa ta BIP-39 Mai Kalmomi 24";
"onboarding.entropy.learn_more.visual.bits" = "Byte 32 × bit 8 ya yi daidai da bit 256";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Jadawalin ƙwayoyin bit 256 na misali da aka tsara zuwa byte 32.";
"onboarding.entropy.learn_more.visual.accessibility" = "Ana sauya jefa ɗan lido, jefa tsabar kuɗi, ko lambobin bazuwar zuwa bit 256, sannan zuwa jumlar farfadowa ta BIP-39 mai kalmomi 24.";
"onboarding.entropy.learn_more.inputs.section" = "Mataki na 1: Rubuta Sakamakon Zahiri";
"onboarding.entropy.learn_more.inputs.dice.title" = "Jefa Ɗan Lido Mai Fuska Shida Marar Son Kai";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Idan ɗan lido ba ya nuna son kai, fuska 1–4 kowacce tana ba da bit 2; fuska 5–6 kowacce tana ba da bit 1.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Jefa Tsabar Kuɗi ta Zahiri";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Kowane jefa tsabar kuɗi marar son kai kuma mai zaman kansa yana ba da bit guda na entropy marar karkata.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Rubuta Lambobin Bazuwar";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Lambobi 0–7 kowanne yana ba da bit 3; lambobi 8–9 kowanne yana ba da bit 1. Dole lambobin su fito daga wani tsari na zahiri da yake bazuwar gaske.";
"onboarding.entropy.learn_more.inputs.footer" = "Yi amfani da tushen zahiri marar son kai, kuma ka rubuta kowane sakamako a jere. Kana iya sauya hanyar shigarwa domin kowane sakamakon da aka karɓa yana shiga rafin bit guda.";
"onboarding.entropy.learn_more.conversion.section" = "2. Haɗa Ƙimar Bit 256";
"onboarding.entropy.learn_more.conversion.mapping" = "Oath yana sauya sakamakon ɗan lido da lambobin goma zuwa rukunin da girmansu ƙarfin 2 ne, ba tare da karkata ba. Tsawon gudummawar na iya bambanta, amma tushen zahiri marar son kai ba ya fifita kowace ƙimar bit.";
"onboarding.entropy.learn_more.conversion.packing" = "Oath yana ƙara bit a jerin da aka shigar har ya tattara daidai bit 256, sannan ya cushe su cikin byte 32, yana fara da bit mafi muhimmanci.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Entropy na musamman ya ƙunshi shigarwar zahiri da ka rubuta kaɗai; Oath ba ya gauraya shi da bazuwar da na'ura ta ƙirƙira.";
"onboarding.entropy.learn_more.bip39.section" = "3. Samar da Jumlar Farfadowa";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Bit 256 na Entropy";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Checksum na BIP-39 Mai Bit 8";
"onboarding.entropy.learn_more.bip39.visual.words" = "An raba bit 264 zuwa fihirisar kalmomi 24, kowacce mai bit 11";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Ana ƙara checksum mai bit 8 ga ƙimar entropy mai bit 256, ta samar da bit 264 da ake raba su zuwa fihirisar kalmomi 24, kowacce mai bit 11.";
"onboarding.entropy.learn_more.bip39.checksum" = "BIP-39 yana lissafa SHA-256 a kan ƙimar entropy mai byte 32, ya ɗauki bit 8 na farko na hash a matsayin checksum; ƙara wannan checksum yana samar da bit 264.";
"onboarding.entropy.learn_more.bip39.words" = "Ana raba bit 264 zuwa rukuni 24 na bit 11. Kowane rukuni yana zaɓar shigarwa guda daga daidaitaccen jerin BIP-39 mai kalmomi 2,048 domin samar da jumlar farfadowa mai kalmomi 24.";
"onboarding.entropy.learn_more.bip39.derivation" = "Wallet Core yana samar da asusu da adireshi masu tabbataccen maimaituwa daga seed ɗin da aka samu. Jumlar farfadowa ɗaya da kalmar wucewa ta zaɓi za su sake ƙirƙirar walat ɗin nan ɗaya a kowane lokaci.";
"onboarding.entropy.learn_more.security.section" = "Yadda Entropy na Musamman Ke Ƙarfafa Tsaro";
"onboarding.entropy.learn_more.security.space.title" = "Sararin Zaɓuɓɓuka Mai Matuƙar Faɗi";
"onboarding.entropy.learn_more.security.space.detail" = "Entropy mai bit 256 da ya bazu daidai yana da ƙimomi na musamman 2^256, wanda ke sa gwada dukkansu ya gagari lissafi. Wannan yana bayyana girman sararin shigarwa; ba ya nufin cewa kowane ɓangaren cryptography yana ba da juriyar hari ta bit 256.";
"onboarding.entropy.learn_more.security.source.title" = "Bazuwar Tana Fitowa daga Gare Ka";
"onboarding.entropy.learn_more.security.source.detail" = "Abubuwan zahiri suna ba ka damar samo bazuwar walat da kanka maimakon dogaro gaba ɗaya ga mai samar da lambobin bazuwar na na'ura. Wannan yana ƙara tsaro ne kawai idan abubuwan sun kasance bazuwar gaske.";
"onboarding.entropy.learn_more.security.local.title" = "Ana Sarrafa Komai a Wannan Na'urar";
"onboarding.entropy.learn_more.security.local.detail" = "Oath yana sauya jerin da ka rubuta kuma ya ƙirƙiri jumlar farfadowa gaba ɗaya a wannan na'urar. Ba a taɓa loda jerinka domin sarrafawa ba.";
"onboarding.entropy.learn_more.security.patterns.title" = "Guji Sirrin da Mutum Ya Zaɓa";
"onboarding.entropy.learn_more.security.patterns.detail" = "Dogon jeri na abubuwa marasa son kai kuma masu zaman kansu ya fi ranar haihuwa, lambobin da aka fi so, maimaita tsari, ko kalmomin da mutum ya zaɓa wahalar hango nesa ba kusa ba.";
"onboarding.entropy.learn_more.security.footer" = "Entropy na zahiri yana maye gurbin bazuwar walat da na'ura ke samarwa; ba ƙarin kalmar sirri ko wani matakin tsaro ba ne.";
"onboarding.entropy.learn_more.safety.section" = "Yi Amfani da Wannan Fasalin Cikin Aminci";
"onboarding.entropy.learn_more.safety.fair.title" = "Rubuta Sakamako Marasa Son Kai, Masu Zaman Kansu";
"onboarding.entropy.learn_more.safety.fair.detail" = "Yi amfani da tsabar kuɗi ko ɗan lido marar son kai, kuma ka tabbatar kowane sakamako mai zaman kansa ne. Dole lambobin bazuwar su fito daga tushen zahiri na gaske—ba daga ƙwaƙwalwa ko wani tsari ba.";
"onboarding.entropy.learn_more.safety.private.title" = "Ka Ɓoye Tsarin Samar da Entropy";
"onboarding.entropy.learn_more.safety.private.detail" = "Kare jerin da ka rubuta da jumlar farfadowa da aka kammala a matsayin sirrin walat. Kada kyamara ko wasu mutane su gan su.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Rubuta Kowane Sakamako Daidai";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Sakamako guda da ya ɓace, ya maimaitu, ko aka sauya matsayinsa yana ƙirƙirar wani walat dabam. Yi bitar kowace shigarwa, kuma ka tabbatar da jumlar farfadowa da aka kammala kafin ka saka kuɗi a walat.";
"onboarding.entropy.learn_more.safety.backup.title" = "Kare Jumlar Farfadowa";
"onboarding.entropy.learn_more.safety.backup.detail" = "Ajiye jumlar farfadowa ba tare da intanet ba, kuma kada ka taɓa raba ta. Bayan ka tabbatar da ajiyarka, lalata duk wani rikodin shigarwa na wucin gadi da ba ka ƙara buƙata cikin aminci.";
"onboarding.entropy.learn_more.safety.footer" = "Entropy na zahiri ba zai iya kare jumlar farfadowa da aka fallasa, na'urar da aka kutsa, software mai cutarwa, ko jerin da aka rubuta ba daidai ba. Idan ba za ka iya tabbatar da shigarwa marar son kai, a ɓoye, kuma daidai ba, yi amfani da ƙirƙirar walat ta yau da kullum.";
"onboarding.carousel.open_source.eyebrow" = "BUƊAƊƊEN TUSHE TA TSARI";
"onboarding.carousel.open_source.title" = "Bincika Lambar Tushe. Tabbatar da Ginin.";
"onboarding.carousel.open_source.message" = "Oath yana wallafa lambar tushensa domin a bincika ta ba tare da dogaro da shi ba. Ana tabbatar da wani sakin manhaja ne kawai idan ginin da za a iya maimaitawa ya yi daidai da sawun dijital na manhajar da aka wallafa.";
"onboarding.carousel.open_source.action.github" = "Yi Bita a GitHub";
"onboarding.carousel.open_source.visual.repository" = "Ma'ajiyar Lambar Tushe ta Jama'a";
"onboarding.carousel.open_source.visual.repository.path" = "Duba github.com/devdasx/aperture";
"onboarding.carousel.open_source.visual.source" = "Yi Bitar Lambar Tushe";
"onboarding.carousel.open_source.visual.rebuild" = "Sake Samar da Ginin Sakin";
"onboarding.carousel.open_source.visual.compare" = "Kwatanta Abubuwan Ginin";
"onboarding.carousel.open_source.visual.fingerprint" = "Sawun Dijital na Sakin da Aka Wallafa";
"onboarding.carousel.open_source.visual.match" = "AN TABBATAR DA DAIDAITO — AN TABBATAR DA GININ";
"onboarding.carousel.open_source.visual.accessibility" = "Zane da ke nuna cewa tabbatar da sakin manhaja yana buƙatar lambar tushe ta jama'a, sake ginawa ba tare da dogaro da mai wallafawa ba, da sawun dijital masu daidaito.";
"onboarding.carousel.passphrase.eyebrow" = "KALMAR WUCEWA TA BIP-39 TA ZAƁI";
"onboarding.carousel.passphrase.title" = "Jumlar Farfadowa Guda. Ƙarin Sirri Guda.";
"onboarding.carousel.passphrase.message" = "Kalmar wucewa ta BIP-39 tana haɗuwa da jumlar farfadowarka domin samar da wani walat dabam. Ko da an fallasa kalmomin farfadowa, har yanzu ana buƙatar ainihin kalmar wucewa domin shiga walat ɗin.";
"onboarding.carousel.passphrase.visual.phrase" = "Kalmomin Farfadowarka 24";
"onboarding.carousel.passphrase.visual.passphrase" = "Ƙarin Kalmar Wucewarka ta Sirri";
"onboarding.carousel.passphrase.visual.output" = "Walat na Kalmar Wucewa na Musamman";
"onboarding.carousel.passphrase.visual.requirement" = "Ana Buƙatar Sirrin Biyu don Farfadowa";
"onboarding.carousel.passphrase.visual.accessibility" = "Jumlar farfadowa mai kalmomi 24 da kalmar wucewa ta BIP-39 ta sirri suna samar da wani walat dabam da ke buƙatar sirrin biyu domin farfadowa.";
"onboarding.carousel.passphrase.learn_more.action" = "Bincika Ƙarin Bayani";
"onboarding.passphrase.learn_more.navigation" = "Fahimtar Kalmomin Wucewa na BIP-39";
"onboarding.passphrase.learn_more.path.section" = "Sirri Biyu Suna Samar da Walat Guda";
"onboarding.passphrase.learn_more.overview" = "Kalmar wucewa ta BIP-39 ƙarin sirri ce ta zaɓi da ake haɗawa da jumlar farfadowarka. Tare, suna samar da walat mai tabbataccen maimaituwa wanda ya bambanta da walat ɗin da jumlar farfadowa kaɗai ta samar.";
"onboarding.passphrase.learn_more.visual.phrase" = "Jumlar Farfadowarka Mai Kalmomi 24";
"onboarding.passphrase.learn_more.visual.passphrase" = "Kalmar Wucewarka ta Sirri";
"onboarding.passphrase.learn_more.visual.wallet" = "Walat da Kalmar Wucewa Ke Karewa";
"onboarding.passphrase.learn_more.visual.accessibility" = "Jumlar farfadowa mai kalmomi 24 da kalmar wucewa ta sirri suna haɗuwa su samar da wani walat dabam da kalmar wucewa ke karewa.";
"onboarding.passphrase.learn_more.derivation.section" = "Yadda BIP-39 Ke Samar da Walat";
"onboarding.passphrase.learn_more.derivation.visual.inputs" = "An Haɗa Jumlar Farfadowa da Kalmar Wucewa";
"onboarding.passphrase.learn_more.derivation.visual.function" = "PBKDF2-HMAC-SHA512 da Zagaye 2,048";
"onboarding.passphrase.learn_more.derivation.visual.seed" = "Babban Seed Mai Bit 512";
"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Asusu da Adireshin Walat da Aka Samar";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Jumlar farfadowarka da kalmar wucewa suna bi ta zagaye 2,048 na PBKDF2-HMAC-SHA512 domin samar da seed mai bit 512 da ake samar da asusu da adireshin walat daga gare shi.";
"onboarding.passphrase.learn_more.derivation.standard" = "BIP-39 yana ɗaukar jumlar farfadowa da aka daidaita a matsayin kalmar sirri ta PBKDF2, sannan yana amfani da “mnemonic” da kalmar wucewa da aka daidaita a bayansa a matsayin salt. Bayan zagaye 2,048 na PBKDF2-HMAC-SHA512, tsarin yana samar da seed mai byte 64.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Kafin samar da seed, Oath yana aiwatar da Unicode normalization da BIP-39 ke buƙata, domin jumlar farfadowa da kalmar wucewa da aka daidaita iri ɗaya su sake samar da walat ɗin nan ɗaya a kowane lokaci.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Kalmar wucewa ba ta ɓoye kalmomin farfadowarka. Tana sauya seed ɗin da ake samarwa, don haka kowace kalmar wucewa dabam tana samar da asusu da adireshi dabam.";
"onboarding.passphrase.learn_more.wallets.section" = "Kowace Kalmar Wucewa Tana Samar da Walat Dabam";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Misalin Kalmar Wucewa ta 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Misalin Kalmar Wucewa ta 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Misalin Walat A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Misalin Walat B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Jumlar farfadowa ɗaya da aka haɗa da kalmomin wucewa biyu mabambanta tana samar da walat biyu dabam: Walat A da Walat B.";
"onboarding.passphrase.learn_more.wallets.different" = "Sauya ko da harafi guda mai ma'ana yana samar da wani seed dabam, saboda haka wani walat dabam; walat na asali ba ya canzawa.";
"onboarding.passphrase.learn_more.wallets.empty" = "Kalmar wucewa marar komai tana buɗe daidaitaccen walat da jumlar farfadowa kaɗai ta samar; kalmar wucewa da ba ta zama fanko ba tana buɗe nata walat na daban.";
"onboarding.passphrase.learn_more.wallets.footer" = "BIP-39 ba ya bayar da amsar “kalmar wucewa ba daidai ba”; kowace kalmar wucewa tana aiki, don haka kuskuren rubutu yana buɗe wani walat dabam a ɓoye—galibi mai ma'aunin sifili.";
"onboarding.passphrase.learn_more.security.section" = "Yadda Kalmar Wucewa Ke Ƙara Kariya";
"onboarding.passphrase.learn_more.security.words.title" = "Kalmomin Farfadowa Kaɗai Ba Su Isa ba";
"onboarding.passphrase.learn_more.security.words.detail" = "Duk wanda ya sami jumlar farfadowarka kaɗai har yanzu yana buƙatar ainihin kalmar wucewa domin samarwa da shiga walat ɗin da aka kare.";
"onboarding.passphrase.learn_more.security.strength.title" = "Ƙarfi Yana Samar da Rabuwa Mai Kyau";
"onboarding.passphrase.learn_more.security.strength.detail" = "Doguwar kalmar wucewa marar sauƙin hangowa tana ƙara wahalar hasashe mai ma'ana; gajeriyar magana, ranar haihuwa, suna, ko kalmar sirri da aka sake amfani da ita ana iya hasashe da sauri kuma ba ta ba da kariya sosai.";
"onboarding.passphrase.learn_more.security.separation.title" = "Ajiye Kalmar Wucewa Dabam";
"onboarding.passphrase.learn_more.security.separation.detail" = "Ajiye kalmar wucewa dabam da jumlar farfadowa, domin ajiyar da aka sace guda ɗaya kada ta bayyana sirrin biyu da ake buƙata don dawo da walat.";
"onboarding.passphrase.learn_more.security.footer" = "Kalmar wucewa ba za ta iya kare kuɗinka ba idan an fallasa sirrin biyu, kalmar wucewar ba ta da ƙarfi, ko wata software da aka kutsa ta ɗauke ta yayin da kake rubutawa.";
"onboarding.passphrase.learn_more.safety.section" = "Yi Amfani da Wannan Fasalin Cikin Aminci";
"onboarding.passphrase.learn_more.safety.strong.title" = "Ƙirƙiri Kalmar Wucewa Mai Ƙarfi kuma ta Musamman";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Zaɓi kalmomin bazuwar da yawa ko wata ƙima mai babban entropy wadda ta keɓanta ga wannan walat. Guji bayanan kai, sanannun jimloli, tsare-tsare, da kalmomin sirri da ake amfani da su a wani wuri.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Ajiye Kalmar Wucewa Dabam";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Yi kwafin ainihin kalmar wucewa mai ɗorewa ba tare da intanet ba, ka ajiye shi dabam da jumlar farfadowa, kuma kada ka taɓa dogaro da ƙwaƙwalwa kaɗai.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Kowane Harafi Yana Sauya Walat";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Sake shigar da kalmar wucewa daidai yadda aka ƙirƙire ta, har da kowane babban harafi, sarari, alamar rubutu, da kalma. Duk wani bambanci yana samar da wani walat dabam ba tare da gargadi ba.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Tabbatar da Farfadowa Kafin Ƙara Kuɗi";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Kafin karɓar kuɗi masu yawa, yi gwajin farfadowa na sirri kuma ƙarƙashin kulawa domin tabbatar da cewa jumlar farfadowa da kalmar wucewa suna sake samar da adiresoshin da ake tsammani.";
"onboarding.passphrase.learn_more.safety.footer" = "Babu wani sabis da zai iya sake saita ko dawo da kalmar wucewa da ta ɓace. Ba tare da ainihin kalmar wucewa ba, damar shiga wannan walat ta ɓace har abada—ko da har yanzu kana da jumlar farfadowa.";
