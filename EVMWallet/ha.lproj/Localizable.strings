// Oath 3.5.5 (56) release history.
"settings.about.history.v355.build56.slide" = "Zamar da maɓalli don aikawa ya maye gurbin maɓallin tabbatarwa. Motsi mai nuna alkibla, martanin taɓawa da motsi mai laushi suna aiki a alkiblan karatu biyu. Saki yatsa a 90% ko fiye don aikawa; ja baya don sokewa.";
"settings.about.history.v355.build56.activity" = "Ƙararrawa tana buɗe ayyukan da ke jira. Kapsulolin ma’amala suna nuna alamomin matsayi kuma ana ɓoye su da shafawa. Masu jiran tabbaci da waɗanda aka tabbatar suna ɓoyewa bayan sakan 3; tabbaci yana sabunta kapsul ɗin da ake gani.";
"settings.about.history.v355.build56.status" = "Matsayin ma’amala mafi inganci a duk hanyoyin sadarwar da ake tallafawa, bayanai masu sabuntawa kai tsaye da sabunta ma’auni da sauri bayan aikawa. Bibiyar ma’amalolin da ke jira tana ci gaba idan an sake buɗe manhajar.";
"settings.about.history.v355.build56.fees" = "Komawa bitar wannan turawar yana riƙe kuɗin caji da aka samu. Loda caji da gargaɗin samar wa asusu kuɗi sun fi bayyana; adadi mai isa ba ya nuna sanarwar kunnawa.";
"settings.about.history.v355.build56.dust" = "Bitcoin Cash, Bitcoin, Litecoin da Dogecoin suna ƙara canjin da za a dawo da shi, idan yana ƙasa da iyakar dust, cikin caji maimakon samar da output marar amfani. Cajin da aka bita ya dace da na sa hannu.";
"settings.about.history.v355.build56.stability" = "An gyara rushewar aikin bango da faɗakarwar ƙarewar lokacin sabunta walat. Bayanan walat da ake da su suna nan idan sabuntawa ya gaza na ɗan lokaci.";
"settings.about.history.v355.build56.backup" = "Fuskar ajiyar madadi ta fi tsabta, da madaidaicin take yayin buɗewa da saƙonni kaɗan. Samun maɓallan sirri yana bin saitunan kulle manhaja. Gajerun gargaɗin shigo da bayanai masu kamannin gilashi suna share abin da aka ƙi idan ka zaɓi wata jimlar dawo da walat.";

// Oath 3.5.5 (57) release history.
"settings.about.history.v355.build57.slide" = "Bayan ka saki madannin zamewa na aikawa, alamar daidai mai motsi za ta bayyana kafin shafin dubawa ya rufe.";
"settings.about.history.v355.build57.activity" = "Layukan ayyuka suna nuna matsayi da rubutu marar kauri sosai, adadi a matsayin ƙaramin bayani, da kibiya don buɗe bayanan ma'amala.";
"settings.about.history.v355.build57.details" = "Kuɗin hanyar sadarwa yanzu yana cikin taƙaitaccen bayani na turawa. Gajerun lakabi da layi guda na hanyar sadarwa sun sa bayanan sun fi bayyana.";
"settings.about.history.v355.build57.resume" = "Idan ka dawo daga bayan fage, shafuka da bangarorin da ka buɗe suna nan, har da duban turawa da bayanan ma'amala.";
"settings.about.history.v355.build57.secrets" = "Shafukan kalmomin dawo da walat, maɓallin sirri da jimlar sirri suna rufewa bayan ka bar manhajar na daƙiƙa 20. Kulle manhajar yana ci gaba da bin saitunanka.";
"settings.about.history.v355.build57.filters" = "Matatun hanyar sadarwa suna amfani da maɓallan tsarin da suka ɗan fi tsayi, girman da ya dace da abun ciki, da gyararren tazara a ƙarƙashin sandar kewayawa.";
"settings.about.history.v355.build57.units" = "An cire layukan ƙima na daban. Adadi da kuɗin hanyar sadarwa suna fara bayyana a kuɗin gida; taɓa ɗayansu don sauyawa zuwa ma'aunin kiripto da komawa.";
"wallet.transaction.details.toggle_units" = "Sauya ma'auni.";

// Oath 3.5.5 (58) release history.
"settings.about.history.v355.build58.home" = "Shafin farko yana buɗewa ba tare da tasirin bayyana a hankali ko sauya girma ba. Maballin saituna yanzu yana amfani da alamar giya.";
"settings.about.history.v355.build58.fields" = "Filayen ma’amala da aikawa suna amfani da launukan rubutu na yau da kullum. Kibiyoyi suna bayyana ne kawai a layukan da ke buɗe shafi ko taga; taɓa adadi ko kuɗin caji har yanzu yana sauya naúrar nunawa.";
"settings.about.history.v355.build58.banners" = "Bayan an nuna su, sanarwar tabbatarwa da ake yi ko wadda aka kammala tana ɓacewa bayan daƙiƙa 3, ko da ka buɗe wani shafi. Sanarwar tabbatarwa da ba a riga an nuna ba za ta bayyana idan ka dawo.";

// Oath 3.5.5 (59) release history.
"settings.about.history.v355.build59.maximum" = "Canja wurin TRON yanzu yana keɓe kuɗin kunna asusu da na bandwidth kafin ƙididdige adadin da za a aika, har ma idan an zaɓi aika mafi yawan adadi. Shafin dubawa yana nuna adadin da ya dace bayan cire kuɗaɗen.";
"settings.about.history.v355.build59.fees" = "Kuɗin TRON da ka saita da kanka dole ne ya biya kuɗaɗen hanyar sadarwa da ake buƙata. Yanzu ana nuna bayani mafi sauƙin fahimta idan kuɗin TRX da ya rage ya yi kaɗan. Adadin token ba ya canzawa; ana biyan kuɗaɗen da TRX.";

/* Version 3.5.6 */
"settings.about.history.v356.appearance" = "Maɓallai na farko da na sakandare yanzu suna amfani da madaidaiciyar tsayi da gefen allo, tare da shuɗin tsarin don ayyukan farko.";
"settings.about.history.v356.welcome.title" = "Sabuwar maraba";
"settings.about.history.v356.welcome" = "Sabon allon maraba tare da zane-zane mai rai da bayyanannun zaɓuɓɓuka don ƙirƙira ko shigo da walat.";
"settings.about.history.v357.tour.title" = "Rangadin maraba";
"settings.about.history.v357.tour" = "Rangadi mai shafuka biyar yana gabatar da hanyoyin sadarwa da ake tallafawa, entropy na zahiri, aikawa da karɓa, tsaro, da gine-ginen da aka tabbatar. Shafa ko taɓa ɗigogin don sauya shafi; maɓallin canza harshe yana cikin sandar kewayawa.";
"settings.about.history.v357.backup" = "Bayan ƙirƙira, shigo da, ko dawo da walat, allon yana bayyana nan take kuma zaɓuɓɓukan madadinsa suna amfani da jerin da aka saba. Binciken iCloud yana gudana a bayan fage, kuma Buɗe Walat yana shirye da zarar an adana walat ɗin.";
"settings.about.history.v357.reliability" = "Dawowa daga bayan fage ba ya ƙara rufe allon saiti lokacin da allon dawo da asusu ɓoyayye ya ƙare, kuma goge duk bayanai yana buɗe allon maraba kai tsaye.";
"settings.about.history.v357.notifications" = "Saitunan sanarwa suna amfani da kalmomi masu sauƙi don rukunoni da matsayi, ba tare da cikakkun bayanan fasaha ba.";
"settings.about.history.v357.wallets" = "Sake tsara walat a cikin mai sauyawa ta danna na dogon lokaci tare da motsin ɗagawa na tsarin; taɓa layi yana kunna shi. Tabbatar da jimlar dawo da asusu yana ƙidaya kowace kalma, kuma Return yana zuwa fili na gaba.";
"settings.about.history.v357.send" = "Aikawa yana nuna adadin yayin da canja wuri ke gudana, saƙo mafi bayyana yana bayyana idan ba za a iya aikawa ba, kuma buƙatun TRON suna sake gwadawa ta atomatik bayan kurakuran mai bayarwa na ɗan lokaci.";
"settings.about.history.v357.security" = "Asusun TRON da aka shigo da su waɗanda aka mayar da izinin mai shi zuwa wani maɓalli yanzu suna nuna gargaɗin kuma ba za su iya aikawa ba, ko da kowane izini ya lissafa maɓalli ɗaya kawai. Ana ƙin ƙarin sanannun jimlolin dawo da asusu da maɓallan sirri da suka fallasa a lokacin shigo da su.";
"settings.about.history.v356.localization" = "An inganta rubutun shafin maraba a duk harsunan da ake tallafawa domin ya zama mai sauƙin fahimta da salo na halitta.";
"settings.about.history.v356.pricing" = "Farashin Token yanzu yayi daidai da ainihin hanyar sadarwa da adireshin alamar, ta amfani da farashin DEX da farko. Ƙananan farashin suna nuna har zuwa wurare goma sha takwas ba tare da zagaye ba.";
"settings.about.history.v356.transactions" = "Cikakkun bayanai na ma'amala suna amfani da gajeriyar Matsayin Tabbatarwa da mafi kyawun rubutu mai launin toka don kwanan wata, adireshi, adadi, da ID na ma'amala.";
"settings.about.history.v356.security" = "Faɗaɗɗen jerin sanannun maganganun dawo da bayanan da aka fallasa da maɓallan sirri waɗanda ba za a iya shigo da su ba.";

