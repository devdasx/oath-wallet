"onboarding.passphrase.learn_more.derivation.visual.accounts" = "Παραγόμενοι λογαριασμοί και διευθύνσεις πορτοφολιού";
"onboarding.passphrase.learn_more.derivation.visual.accessibility" = "Η φράση ανάκτησης και η φράση πρόσβασής σας περνούν από 2.048 γύρους PBKDF2-HMAC-SHA512, παράγοντας την τιμή seed 512 bit από την οποία προκύπτουν οι λογαριασμοί και οι διευθύνσεις πορτοφολιού.";
"onboarding.passphrase.learn_more.derivation.standard" = "Το BIP-39 χρησιμοποιεί την κανονικοποιημένη φράση ανάκτησης ως κωδικό πρόσβασης PBKDF2 και τη λέξη \"mnemonic\", ακολουθούμενη από την κανονικοποιημένη φράση πρόσβασης, ως τιμή salt. Μετά από 2.048 γύρους PBKDF2-HMAC-SHA512, η διαδικασία παράγει μια τιμή seed 64 byte.";
"onboarding.passphrase.learn_more.derivation.normalization" = "Πριν από την παραγωγή της τιμής seed, το Oath εφαρμόζει την κανονικοποίηση Unicode που απαιτεί το BIP-39, ώστε η ίδια κανονικοποιημένη φράση ανάκτησης και φράση πρόσβασης να αναπαράγουν πάντα το ίδιο πορτοφόλι.";
"onboarding.passphrase.learn_more.derivation.not_encryption" = "Η φράση πρόσβασης δεν κρυπτογραφεί τις λέξεις ανάκτησης. Αλλάζει την παραγόμενη τιμή seed, επομένως κάθε διαφορετική φράση πρόσβασης παράγει διαφορετικούς λογαριασμούς και διευθύνσεις.";
"onboarding.passphrase.learn_more.wallets.section" = "Κάθε φράση πρόσβασης παράγει ξεχωριστό πορτοφόλι";
"onboarding.passphrase.learn_more.wallets.visual.one" = "Παράδειγμα φράσης πρόσβασης 1";
"onboarding.passphrase.learn_more.wallets.visual.two" = "Παράδειγμα φράσης πρόσβασης 2";
"onboarding.passphrase.learn_more.wallets.visual.wallet_a" = "Παράδειγμα πορτοφολιού A";
"onboarding.passphrase.learn_more.wallets.visual.wallet_b" = "Παράδειγμα πορτοφολιού B";
"onboarding.passphrase.learn_more.wallets.visual.accessibility" = "Η ίδια φράση ανάκτησης, σε συνδυασμό με δύο διαφορετικές φράσεις πρόσβασης, παράγει δύο ξεχωριστά πορτοφόλια: το Πορτοφόλι A και το Πορτοφόλι B.";
"onboarding.passphrase.learn_more.wallets.different" = "Η αλλαγή ακόμη και ενός χαρακτήρα παράγει διαφορετική τιμή seed και, επομένως, διαφορετικό πορτοφόλι. Το αρχικό πορτοφόλι παραμένει αμετάβλητο.";
"onboarding.passphrase.learn_more.wallets.empty" = "Μια κενή φράση πρόσβασης ανοίγει το τυπικό πορτοφόλι που παράγεται μόνο από τη φράση ανάκτησης· μια μη κενή φράση πρόσβασης ανοίγει το δικό της ξεχωριστό πορτοφόλι.";
"onboarding.passphrase.learn_more.wallets.footer" = "Το BIP-39 δεν εμφανίζει μήνυμα «λανθασμένη φράση πρόσβασης». Κάθε φράση πρόσβασης είναι έγκυρη, επομένως ένα τυπογραφικό λάθος ανοίγει σιωπηλά άλλο πορτοφόλι, συνήθως με μηδενικό υπόλοιπο.";
"onboarding.passphrase.learn_more.security.section" = "Πώς μια φράση πρόσβασης προσθέτει προστασία";
"onboarding.passphrase.learn_more.security.words.title" = "Οι λέξεις ανάκτησης από μόνες τους δεν αρκούν";
"onboarding.passphrase.learn_more.security.words.detail" = "Όποιος αποκτήσει μόνο τη φράση ανάκτησής σας εξακολουθεί να χρειάζεται την ακριβή φράση πρόσβασης για να παραγάγει και να προσπελάσει το προστατευμένο πορτοφόλι.";
"onboarding.passphrase.learn_more.security.strength.title" = "Η ισχύς εξασφαλίζει καλύτερο διαχωρισμό";
"onboarding.passphrase.learn_more.security.strength.detail" = "Μια μεγάλη, απρόβλεπτη φράση πρόσβασης δυσκολεύει ουσιαστικά τις απόπειρες εύρεσής της. Ένα σύντομο απόσπασμα, μια ημερομηνία γέννησης, ένα όνομα ή ένας επαναχρησιμοποιημένος κωδικός μπορεί να μαντευτεί γρήγορα και παρέχει ελάχιστη προστασία.";
"onboarding.passphrase.learn_more.security.separation.title" = "Φυλάξτε τη φράση πρόσβασης χωριστά";
"onboarding.passphrase.learn_more.security.separation.detail" = "Αποθηκεύστε τη φράση πρόσβασης χωριστά από τη φράση ανάκτησης, ώστε ένα κλεμμένο αντίγραφο ασφαλείας να μην αποκαλύψει και τα δύο μυστικά που απαιτούνται για την επαναφορά του πορτοφολιού.";
"onboarding.passphrase.learn_more.security.footer" = "Η φράση πρόσβασης δεν μπορεί να προστατεύσει τα κεφάλαιά σας αν αποκαλυφθούν και τα δύο μυστικά, αν η φράση πρόσβασης είναι αδύναμη ή αν παραβιασμένο λογισμικό την υποκλέψει κατά την πληκτρολόγηση.";
"onboarding.passphrase.learn_more.safety.section" = "Ασφαλής χρήση αυτής της λειτουργίας";
"onboarding.passphrase.learn_more.safety.strong.title" = "Δημιουργήστε μια ισχυρή, μοναδική φράση πρόσβασης";
"onboarding.passphrase.learn_more.safety.strong.detail" = "Επιλέξτε πολλές τυχαίες λέξεις ή άλλη τιμή υψηλής εντροπίας, μοναδική για αυτό το πορτοφόλι. Αποφύγετε προσωπικά στοιχεία, γνωστές φράσεις, μοτίβα και κωδικούς που χρησιμοποιείτε αλλού.";
"onboarding.passphrase.learn_more.safety.backup.title" = "Δημιουργήστε ξεχωριστό αντίγραφο ασφαλείας της φράσης πρόσβασης";
"onboarding.passphrase.learn_more.safety.backup.detail" = "Δημιουργήστε ένα ανθεκτικό αντίγραφο ασφαλείας εκτός σύνδεσης της ακριβούς φράσης πρόσβασης και αποθηκεύστε το ξεχωριστά από τη φράση ανάκτησης. Μην βασίζεστε μόνο στη μνήμη.";
"onboarding.passphrase.learn_more.safety.exact.title" = "Κάθε χαρακτήρας αλλάζει το πορτοφόλι";
"onboarding.passphrase.learn_more.safety.exact.detail" = "Εισαγάγετε ξανά τη φράση πρόσβασης ακριβώς όπως τη δημιουργήσατε, συμπεριλαμβανομένων όλων των κεφαλαίων γραμμάτων, διαστημάτων, σημείων στίξης και λέξεων. Οποιαδήποτε διαφορά παράγει σιωπηλά άλλο πορτοφόλι.";
"onboarding.passphrase.learn_more.safety.verify.title" = "Επαληθεύστε την ανάκτηση πριν προσθέσετε κεφάλαια";
"onboarding.passphrase.learn_more.safety.verify.detail" = "Προτού λάβετε σημαντικό ποσό, πραγματοποιήστε μια ιδιωτική, ελεγχόμενη δοκιμή ανάκτησης, για να επιβεβαιώσετε ότι η φράση ανάκτησης και η φράση πρόσβασης αναδημιουργούν τις αναμενόμενες διευθύνσεις.";
"onboarding.passphrase.learn_more.safety.footer" = "Καμία υπηρεσία δεν μπορεί να επαναφέρει ή να ανακτήσει μια χαμένη φράση πρόσβασης. Χωρίς την ακριβή φράση πρόσβασης, η πρόσβαση σε αυτό το πορτοφόλι χάνεται οριστικά, ακόμη και αν εξακολουθείτε να έχετε τη φράση ανάκτησης.";
