"onboarding.carousel.entropy.eyebrow" = "ΕΝΤΡΟΠΙΑ ΑΠΟ ΦΥΣΙΚΕΣ ΕΙΣΟΔΟΥΣ";
"onboarding.carousel.entropy.title" = "Δημιουργήστε τυχαιότητα που ελέγχετε πλήρως.";
"onboarding.carousel.entropy.message" = "Ρίξτε ζάρια, ένα νόμισμα ή καταγράψτε τυχαία ψηφία. Το Oath μετατρέπει τη φυσική σας είσοδο σε ακριβώς 256 bit εντροπίας για μια φράση ανάκτησης 24 λέξεων, εξ ολοκλήρου στη συσκευή σας.";
"onboarding.carousel.entropy.visual.output" = "256 bit εντροπίας που δημιουργήσατε εσείς";
"onboarding.carousel.entropy.visual.local" = "Δημιουργείται εξ ολοκλήρου από τις εισόδους που καταγράψατε";
"onboarding.carousel.entropy.visual.accessibility" = "Ένα αριθμημένο ζάρι, ένα νόμισμα και τυχαία ψηφία συνδυάζονται για την παραγωγή 256 bit εντροπίας πορτοφολιού σε αυτή τη συσκευή.";
"onboarding.carousel.entropy.learn_more.action" = "Περισσότερες λεπτομέρειες";
"onboarding.entropy.learn_more.navigation" = "Πώς λειτουργεί η φυσική εντροπία";
"onboarding.entropy.learn_more.path.section" = "Από τα φυσικά αποτελέσματα στις λέξεις ανάκτησης";
"onboarding.entropy.learn_more.overview" = "Το Oath καταγράφει αποτελέσματα από τη φυσική πηγή που επιλέγετε και τα μετατρέπει σε τιμή 256 bit. Στη συνέχεια, τα 32 byte που προκύπτουν διαβιβάζονται στο Wallet Core για τη δημιουργία μιας τυπικής φράσης ανάκτησης BIP-39.";
"onboarding.entropy.learn_more.visual.phrase" = "Φράση ανάκτησης BIP-39 24 λέξεων";
"onboarding.entropy.learn_more.visual.bits" = "32 byte × 8 bit ισούνται με 256 bit";
"onboarding.entropy.learn_more.visual.bits.accessibility" = "Ένα πλέγμα 256 κελιών bit, διατεταγμένων σε 32 byte.";
"onboarding.entropy.learn_more.visual.accessibility" = "Οι ρίψεις ζαριού, οι ρίψεις νομίσματος ή τα τυχαία ψηφία μετατρέπονται σε 256 bit και κατόπιν σε μια φράση ανάκτησης BIP-39 24 λέξεων.";
"onboarding.entropy.learn_more.inputs.section" = "Βήμα 1: Καταγράψτε φυσικά αποτελέσματα";
"onboarding.entropy.learn_more.inputs.dice.title" = "Ρίξτε ένα αμερόληπτο ζάρι έξι όψεων";
"onboarding.entropy.learn_more.inputs.dice.detail" = "Με ένα αμερόληπτο ζάρι, καθεμία από τις όψεις 1–4 συνεισφέρει 2 bit, ενώ καθεμία από τις όψεις 5–6 συνεισφέρει 1 bit.";
"onboarding.entropy.learn_more.inputs.coin.title" = "Ρίψεις φυσικού νομίσματος";
"onboarding.entropy.learn_more.inputs.coin.detail" = "Κάθε αμερόληπτη, ανεξάρτητη ρίψη νομίσματος συνεισφέρει 1 αμερόληπτο bit εντροπίας.";
"onboarding.entropy.learn_more.inputs.digits.title" = "Καταγράψτε τυχαία ψηφία";
"onboarding.entropy.learn_more.inputs.digits.detail" = "Καθένα από τα ψηφία 0–7 συνεισφέρει 3 bit, ενώ καθένα από τα ψηφία 8–9 συνεισφέρει 1 bit. Τα ψηφία πρέπει να προέρχονται από μια πραγματικά τυχαία φυσική διαδικασία.";
"onboarding.entropy.learn_more.inputs.footer" = "Χρησιμοποιήστε μια αμερόληπτη φυσική πηγή και καταγράψτε κάθε αποτέλεσμα με τη σειρά. Μπορείτε να αλλάζετε μέθοδο εισόδου, επειδή κάθε αποδεκτό αποτέλεσμα συνεισφέρει στην ίδια ροή bit.";
"onboarding.entropy.learn_more.conversion.section" = "2. Σχηματίστε μια τιμή 256 bit";
"onboarding.entropy.learn_more.conversion.mapping" = "Το Oath μετατρέπει τα αποτελέσματα ζαριού και τα δεκαδικά ψηφία σε αμερόληπτες ομάδες μεγέθους δύναμης του 2. Το μήκος κάθε συνεισφοράς μπορεί να διαφέρει, αλλά μια αμερόληπτη φυσική πηγή δεν ευνοεί καμία τιμή bit.";
"onboarding.entropy.learn_more.conversion.packing" = "Το Oath προσαρτά τα bit με τη σειρά εισαγωγής μέχρι να συγκεντρώσει ακριβώς 256 και έπειτα τα συσκευάζει σε 32 byte, με πρώτο το σημαντικότερο bit.";
"onboarding.entropy.learn_more.conversion.no_mixing" = "Η προσαρμοσμένη εντροπία περιλαμβάνει μόνο τις φυσικές εισόδους που καταγράφετε. Το Oath δεν προσθέτει τυχαιότητα που δημιουργεί η συσκευή.";
"onboarding.entropy.learn_more.bip39.section" = "3. Παραγωγή της φράσης ανάκτησης";
"onboarding.entropy.learn_more.bip39.visual.entropy" = "Εντροπία 256 bit";
"onboarding.entropy.learn_more.bip39.visual.checksum" = "Άθροισμα ελέγχου BIP-39 8 bit";
"onboarding.entropy.learn_more.bip39.visual.words" = "264 bit χωρισμένα σε 24 δείκτες λέξεων των 11 bit";
"onboarding.entropy.learn_more.bip39.visual.accessibility" = "Σε μια τιμή εντροπίας 256 bit προστίθεται ένα άθροισμα ελέγχου 8 bit, παράγοντας 264 bit που χωρίζονται σε 24 δείκτες λέξεων των 11 bit.";
"onboarding.entropy.learn_more.bip39.checksum" = "Το BIP-39 υπολογίζει το SHA-256 για την τιμή εντροπίας των 32 byte και λαμβάνει τα πρώτα 8 bit του κατακερματισμού ως άθροισμα ελέγχου. Η προσάρτηση αυτού του αθροίσματος ελέγχου παράγει 264 bit.";
"onboarding.entropy.learn_more.bip39.words" = "Τα 264 bit χωρίζονται σε 24 ομάδες των 11 bit. Κάθε ομάδα επιλέγει μία καταχώριση από την τυπική λίστα 2.048 λέξεων του BIP-39, παράγοντας τη φράση ανάκτησης 24 λέξεων.";
"onboarding.entropy.learn_more.bip39.derivation" = "Το Wallet Core παράγει ντετερμινιστικούς λογαριασμούς και διευθύνσεις από την τιμή seed που προκύπτει. Η ίδια φράση ανάκτησης και η ίδια προαιρετική φράση πρόσβασης θα αναδημιουργούν πάντα το ίδιο πορτοφόλι.";
"onboarding.entropy.learn_more.security.section" = "Πώς η προσαρμοσμένη εντροπία ενισχύει την ασφάλεια";
"onboarding.entropy.learn_more.security.space.title" = "Ένας τεράστιος χώρος πιθανών τιμών";
"onboarding.entropy.learn_more.security.space.detail" = "Η ομοιόμορφη εντροπία 256 bit περιλαμβάνει 2^256 μοναδικές τιμές, καθιστώντας την εξαντλητική δοκιμή υπολογιστικά ανέφικτη. Αυτό περιγράφει το μέγεθος του χώρου εισόδου· δεν σημαίνει ότι κάθε κρυπτογραφικό στοιχείο παρέχει αντίσταση σε επιθέσεις ισχύος 256 bit.";
"onboarding.entropy.learn_more.security.source.title" = "Η τυχαιότητα προέρχεται από εσάς";
"onboarding.entropy.learn_more.security.source.detail" = "Τα φυσικά συμβάντα σάς επιτρέπουν να εξασφαλίζετε ανεξάρτητα την τυχαιότητα του πορτοφολιού, αντί να βασίζεστε αποκλειστικά σε μια γεννήτρια τυχαίων αριθμών της συσκευής. Αυτό ενισχύει την ασφάλεια μόνο όταν τα συμβάντα είναι πραγματικά τυχαία.";
"onboarding.entropy.learn_more.security.local.title" = "Επεξεργασία αποκλειστικά σε αυτή τη συσκευή";
"onboarding.entropy.learn_more.security.local.detail" = "Το Oath μετατρέπει την καταγεγραμμένη ακολουθία σας και δημιουργεί τη φράση ανάκτησης εξ ολοκλήρου σε αυτή τη συσκευή. Η ακολουθία σας δεν αποστέλλεται ποτέ για επεξεργασία.";
"onboarding.entropy.learn_more.security.patterns.title" = "Αποφύγετε μυστικά ανθρώπινης επιλογής";
"onboarding.entropy.learn_more.security.patterns.detail" = "Μια μεγάλη ακολουθία δίκαιων, ανεξάρτητων γεγονότων είναι πολύ λιγότερο προβλέψιμη από τα γενέθλια, τους αγαπημένους αριθμούς, τα επαναλαμβανόμενα μοτίβα ή τις λέξεις που επιλέγονται από ένα άτομο.";
"onboarding.entropy.learn_more.security.footer" = "Η φυσική εντροπία αντικαθιστά την τυχαιότητα πορτοφολιού που δημιουργεί η συσκευή· δεν αποτελεί πρόσθετο κωδικό πρόσβασης ή επίπεδο ασφαλείας.";
"onboarding.entropy.learn_more.safety.section" = "Ασφαλής χρήση αυτής της λειτουργίας";
"onboarding.entropy.learn_more.safety.fair.title" = "Καταγράψτε αμερόληπτα, ανεξάρτητα αποτελέσματα";
"onboarding.entropy.learn_more.safety.fair.detail" = "Χρησιμοποιήστε ένα αμερόληπτο νόμισμα ή ζάρι και βεβαιωθείτε ότι κάθε αποτέλεσμα είναι ανεξάρτητο. Τα τυχαία ψηφία πρέπει να προέρχονται από πραγματική φυσική πηγή, όχι από τη μνήμη ή κάποιο μοτίβο.";
"onboarding.entropy.learn_more.safety.private.title" = "Κρατήστε ιδιωτική τη διαδικασία εντροπίας";
"onboarding.entropy.learn_more.safety.private.detail" = "Προστατεύστε τόσο την καταγεγραμμένη ακολουθία όσο και την ολοκληρωμένη φράση ανάκτησης ως μυστικά πορτοφολιού. Φροντίστε να μην είναι ορατές σε κάμερες ή άλλα άτομα.";
"onboarding.entropy.learn_more.safety.accurate.title" = "Καταγράψτε ακριβώς κάθε αποτέλεσμα";
"onboarding.entropy.learn_more.safety.accurate.detail" = "Ένα αποτέλεσμα που λείπει, έχει καταγραφεί δύο φορές ή βρίσκεται σε λάθος σειρά δημιουργεί διαφορετικό πορτοφόλι. Ελέγξτε κάθε καταχώριση και επαληθεύστε την ολοκληρωμένη φράση ανάκτησης προτού χρηματοδοτήσετε το πορτοφόλι.";
"onboarding.entropy.learn_more.safety.backup.title" = "Προστατέψτε τη φράση ανάκτησης";
"onboarding.entropy.learn_more.safety.backup.detail" = "Αποθηκεύστε τη φράση ανάκτησης εκτός σύνδεσης και μην την κοινοποιείτε ποτέ. Αφού επαληθεύσετε το αντίγραφο ασφαλείας, καταστρέψτε με ασφάλεια κάθε ενδιάμεση εγγραφή εισόδου που δεν χρειάζεστε πλέον.";
"onboarding.entropy.learn_more.safety.footer" = "Η φυσική εντροπία δεν μπορεί να προστατεύσει μια εκτεθειμένη φράση ανάκτησης, μια παραβιασμένη συσκευή, κακόβουλο λογισμικό ή μια εσφαλμένα καταγεγραμμένη ακολουθία. Αν δεν μπορείτε να εξασφαλίσετε αμερόληπτες, ιδιωτικές και ακριβείς εισόδους, χρησιμοποιήστε την τυπική δημιουργία πορτοφολιού.";
