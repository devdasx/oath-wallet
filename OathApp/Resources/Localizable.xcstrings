    "sendNativeFeeRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የአውታረ መረብ ክፍያውን ለመክፈል በቂ %@ የለም። ክፍያውን በሚከፍለው መለያ ውስጥ የዚህን አውታረ መረብ መነሻ ሳንቲም ያስገቡ፣ ከዚያ ይህን ዝውውር ያድሱ። ቶከኖችን በሚልኩበት ጊዜም የአውታረ መረብ ክፍያዎች መነሻ ሳንቲሙን ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد رصيد كافٍ من %@ لدفع رسوم الشبكة. أضف العملة الأصلية لهذه الشبكة إلى الحساب الذي يدفع الرسوم، ثم حدّث التحويل. تتطلب رسوم الشبكة العملة الأصلية حتى عند إرسال الرموز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নেটওয়ার্ক ফি দেওয়ার জন্য পর্যাপ্ত %@ নেই। যে অ্যাকাউন্ট থেকে ফি দেওয়া হবে, তাতে এই নেটওয়ার্কের নিজস্ব কয়েন যোগ করুন, তারপর এই স্থানান্তর রিফ্রেশ করুন। টোকেন পাঠালেও নেটওয়ার্ক ফি দিতে নিজস্ব কয়েন প্রয়োজন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostatek %@ na zaplacení síťového poplatku. Doplňte nativní minci této sítě na účet, který hradí poplatek, a poté obnovte údaje o tomto převodu. Síťové poplatky vyžadují nativní minci i při odesílání tokenů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke nok %@ til at betale netværksgebyret. Indsæt netværkets egen valuta på den konto, der betaler gebyret, og opdatér derefter denne overførsel. Netværksgebyrer kræver netværkets egen valuta, også når du sender tokens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend %@ für die Netzwerkgebühr. Lade das Konto, das die Gebühr bezahlt, mit der nativen Kryptowährung dieses Netzwerks auf und aktualisiere dann diese Übertragung. Netzwerkgebühren müssen auch beim Senden von Token mit der nativen Kryptowährung bezahlt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει αρκετό %@ για την προμήθεια δικτύου. Προσθέστε το εγγενές νόμισμα αυτού του δικτύου στον λογαριασμό που πληρώνει την προμήθεια και έπειτα ανανεώστε αυτή τη μεταφορά. Οι προμήθειες δικτύου απαιτούν το εγγενές νόμισμα ακόμη και όταν στέλνετε token."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough %@ to pay the network fee. Add this network’s native coin to the account paying the fee, then refresh this transfer. Network fees require the native coin even when sending tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente %@ para pagar la comisión de red. Añade moneda nativa de esta red a la cuenta que paga la comisión y actualiza esta transferencia. Las comisiones de red requieren la moneda nativa, incluso al enviar tokens."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجودی %@ برای پرداخت کارمزد شبکه کافی نیست. کوین بومی این شبکه را به حسابی که کارمزد را می‌پردازد واریز کنید، سپس این انتقال را تازه‌سازی کنید. برای پرداخت کارمزد شبکه، حتی هنگام ارسال توکن‌ها، به کوین بومی نیاز است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei riitä verkkomaksun maksamiseen. Lisää tämän verkon omaa kolikkoa maksun maksavalle tilille ja päivitä sitten tämä siirto. Verkkomaksut vaativat verkon omaa kolikkoa myös tokeneita lähetettäessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi sapat ang %@ para bayaran ang bayarin sa network. Dagdagan ng katutubong coin ng network na ito ang account na nagbabayad ng bayarin, pagkatapos ay i-refresh ang paglilipat na ito. Kailangan ng katutubong coin para sa mga bayarin sa network kahit token ang ipinapadala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas assez de %@ pour payer les frais de réseau. Ajoutez de la monnaie native de ce réseau au compte qui paie les frais, puis actualisez ce transfert. Les frais de réseau nécessitent la monnaie native, même lors d’un envoi de jetons."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નેટવર્ક ફી ચૂકવવા પૂરતું %@ નથી. ફી ચૂકવનાર ખાતામાં આ નેટવર્કના મૂળ સિક્કા ઉમેરો, પછી આ ટ્રાન્સફર રિફ્રેશ કરો. ટોકન મોકલતી વખતે પણ નેટવર્ક ફી માટે મૂળ સિક્કા જરૂરી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bai isa ya biya kuɗin hanyar sadarwa ba. Ƙara kuɗin asali na wannan hanyar sadarwa a asusun da ke biyan kuɗin mu'amala, sannan sabunta bayanan wannan turawa. Ana buƙatar kuɗin asali don biyan kuɗin hanyar sadarwa ko da token ake aikawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מספיק %@ לתשלום עמלת הרשת. יש להוסיף את המטבע המקורי של הרשת לחשבון שמשלם את העמלה, ואז לרענן את ההעברה. עמלות הרשת דורשות את המטבע המקורי גם בעת שליחת אסימונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क चुकाने के लिए पर्याप्त %@ नहीं है। शुल्क चुकाने वाले खाते में इस नेटवर्क का मूल कॉइन डालें, फिर इस ट्रांसफ़र को रीफ़्रेश करें। टोकन भेजते समय भी नेटवर्क शुल्क के लिए मूल कॉइन चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dovoljno %@ za plaćanje mrežne naknade. Dodajte izvornu kriptovalutu ove mreže na račun koji plaća naknadu, zatim osvježite ovaj prijenos. Mrežne naknade zahtijevaju izvornu kriptovalutu i pri slanju tokena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs elegendő %@ a hálózati díj kifizetéséhez. Küldj a hálózat natív érméjéből a díjat fizető számlára, majd frissítsd ezt az átutalást. A hálózati díjakhoz tokenek küldésekor is a natív érme szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak cukup untuk membayar biaya jaringan. Tambahkan koin asli jaringan ini ke akun yang membayar biaya, lalu muat ulang transfer ini. Biaya jaringan memerlukan koin asli meskipun yang dikirim adalah token."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono abbastanza %@ per pagare la commissione di rete. Aggiungi la moneta nativa di questa rete all’account che paga la commissione, poi aggiorna questo trasferimento. Le commissioni di rete richiedono la moneta nativa anche quando invii token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク手数料を支払うための %@ が不足しています。手数料を支払うアカウントに、このネットワークのネイティブコインを入金してから、この送金を更新してください。トークンを送信する場合も、ネットワーク手数料にはネイティブコインが必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ქსელის საკომისიოს გადასახდელად საკმარისი %@ არ არის. საკომისიოს გადამხდელ ანგარიშს დაამატეთ ამ ქსელის ძირითადი მონეტა, შემდეგ განაახლეთ ეს გადარიცხვა. ქსელის საკომისიოსთვის ძირითადი მონეტა ტოკენების გაგზავნის დროსაც საჭიროა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ មិនគ្រប់គ្រាន់សម្រាប់បង់ថ្លៃបណ្តាញទេ។ បន្ថែមកាក់ដើមរបស់បណ្តាញនេះទៅគណនីដែលបង់ថ្លៃសេវា រួចផ្ទុកការផ្ទេរនេះឡើងវិញ។ ថ្លៃបណ្តាញត្រូវការកាក់ដើម ទោះបីជាផ្ញើថូខិនក៏ដោយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ಪಾವತಿಸಲು ಸಾಕಷ್ಟು %@ ಇಲ್ಲ. ಶುಲ್ಕ ಪಾವತಿಸುವ ಖಾತೆಗೆ ಈ ನೆಟ್‌ವರ್ಕ್‌ನ ಮೂಲ ನಾಣ್ಯವನ್ನು ಸೇರಿಸಿ, ನಂತರ ಈ ವರ್ಗಾವಣೆಯನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಿ. ಟೋಕನ್‌ಗಳನ್ನು ಕಳುಹಿಸುವಾಗಲೂ ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕಗಳಿಗೆ ಮೂಲ ನಾಣ್ಯವೇ ಅಗತ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 수수료를 지불할 %@가 부족합니다. 수수료를 지불하는 계정에 이 네트워크의 기본 코인을 추가한 다음 이 전송을 새로 고침하세요. 토큰을 보낼 때도 네트워크 수수료에는 기본 코인이 필요합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നെറ്റ്‌വർക്ക് ഫീസ് അടയ്ക്കാൻ മതിയായ %@ ഇല്ല. ഫീസ് അടയ്ക്കുന്ന അക്കൗണ്ടിലേക്ക് ഈ നെറ്റ്‌വർക്കിന്റെ സ്വന്തം നാണയം ചേർക്കുക, തുടർന്ന് ഈ കൈമാറ്റം പുതുക്കുക. ടോക്കണുകൾ അയയ്ക്കുമ്പോഴും നെറ്റ്‌വർക്ക് ഫീസിന് സ്വന്തം നാണയം ആവശ്യമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क भरण्यासाठी पुरेसे %@ नाही. शुल्क भरणाऱ्या खात्यात या नेटवर्कचे मूळ नाणे जमा करा, नंतर हे हस्तांतरण रिफ्रेश करा. टोकन पाठवतानाही नेटवर्क शुल्कासाठी मूळ नाणे आवश्यक असते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak mencukupi untuk membayar yuran rangkaian. Tambah syiling asli rangkaian ini ke akaun yang membayar yuran, kemudian muat semula pindahan ini. Yuran rangkaian memerlukan syiling asli walaupun anda menghantar token."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကွန်ရက်အခကြေးငွေ ပေးရန် %@ မလုံလောက်ပါ။ အခကြေးငွေပေးသည့်အကောင့်သို့ ဤကွန်ရက်၏မူရင်းဒင်္ဂါး ဖြည့်ပြီး ဤငွေလွှဲမှုကို ပြန်လည်စစ်ဆေးပါ။ တိုကင်များပို့သည့်အခါတွင်လည်း ကွန်ရက်အခကြေးငွေအတွက် မူရင်းဒင်္ဂါး လိုအပ်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke nok %@ til å betale nettverksgebyret. Fyll på nettverkets egen mynt på kontoen som betaler gebyret, og oppdater deretter denne overføringen. Nettverksgebyrer krever nettverkets egen mynt også når du sender tokener."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क तिर्न पर्याप्त %@ छैन। शुल्क तिर्ने खातामा यस नेटवर्कको मूल कोइन थप्नुहोस्, त्यसपछि यो स्थानान्तरण रिफ्रेस गर्नुहोस्। टोकन पठाउँदा पनि नेटवर्क शुल्कका लागि मूल कोइन नै चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onvoldoende %@ om de netwerkkosten te betalen. Voeg de eigen munt van dit netwerk toe aan het account dat de kosten betaalt en vernieuw daarna deze overdracht. Voor netwerkkosten is de eigen munt nodig, ook wanneer je tokens verstuurt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନେଟୱର୍କ ଶୁଳ୍କ ପୈଠ କରିବାକୁ ଯଥେଷ୍ଟ %@ ନାହିଁ। ଶୁଳ୍କ ପୈଠ କରୁଥିବା ଖାତାକୁ ଏହି ନେଟୱର୍କର ନିଜସ୍ୱ କଏନ୍ ଯୋଡ଼ନ୍ତୁ, ତାପରେ ଏହି ସ୍ଥାନାନ୍ତର ରିଫ୍ରେଶ୍ କରନ୍ତୁ। ଟୋକେନ ପଠାଇବା ବେଳେ ମଧ୍ୟ ନେଟୱର୍କ ଶୁଳ୍କ ପାଇଁ ନିଜସ୍ୱ କଏନ୍ ଆବଶ୍ୟକ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੈੱਟਵਰਕ ਫੀਸ ਭਰਨ ਲਈ ਕਾਫ਼ੀ %@ ਨਹੀਂ ਹੈ। ਫੀਸ ਭਰਨ ਵਾਲੇ ਖਾਤੇ ਵਿੱਚ ਇਸ ਨੈੱਟਵਰਕ ਦੇ ਮੂਲ ਸਿੱਕੇ ਜੋੜੋ, ਫਿਰ ਇਹ ਟ੍ਰਾਂਸਫਰ ਰਿਫ੍ਰੈਸ਼ ਕਰੋ। ਟੋਕਨ ਭੇਜਣ ਵੇਲੇ ਵੀ ਨੈੱਟਵਰਕ ਫੀਸ ਲਈ ਮੂਲ ਸਿੱਕੇ ਚਾਹੀਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mało %@, aby opłacić transakcję w sieci. Dodaj natywną monetę tej sieci do konta pokrywającego opłatę, a następnie odśwież ten przelew. Opłaty sieciowe wymagają natywnej monety nawet przy wysyłaniu tokenów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há %@ suficiente para pagar a taxa de rede. Adicione a moeda nativa desta rede à conta que paga a taxa e atualize esta transferência. As taxas de rede exigem a moeda nativa mesmo ao enviar tokens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há %@ suficiente para pagar a taxa de rede. Adicione a moeda nativa desta rede à conta que paga a taxa e atualize esta transferência. As taxas de rede exigem a moeda nativa mesmo ao enviar tokens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ai suficient %@ pentru a plăti comisionul de rețea. Adaugă moneda nativă a acestei rețele în contul care plătește comisionul, apoi reîmprospătează acest transfer. Comisioanele de rețea necesită moneda nativă chiar și atunci când trimiți tokenuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно %@ для оплаты комиссии сети. Пополните аккаунт, с которого оплачивается комиссия, нативной монетой этой сети, затем обновите данные перевода. Для комиссий сети нужна нативная монета даже при отправке токенов."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نيٽ ورڪ فيس ادا ڪرڻ لاءِ ڪافي %@ ناهي. فيس ادا ڪندڙ اڪائونٽ ۾ هن نيٽ ورڪ جو اصل سڪو وجهو، پوءِ هن منتقلي کي ريفريش ڪريو. ٽوڪن موڪلڻ وقت به نيٽ ورڪ فيسن لاءِ اصل سڪو ضروري آهي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ජාල ගාස්තුව ගෙවීමට ප්‍රමාණවත් %@ නැත. ගාස්තුව ගෙවන ගිණුමට මෙම ජාලයේ ස්වදේශීය කාසිය එක් කර, ඉන්පසු මෙම මාරුව නැවුම් කරන්න. ටෝකන යවන විට පවා ජාල ගාස්තු සඳහා ස්වදේශීය කාසිය අවශ්‍යයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostatok %@ na zaplatenie sieťového poplatku. Doplňte natívnu mincu tejto siete na účet, ktorý hradí poplatok, a potom obnovte údaje o tomto prevode. Sieťové poplatky vyžadujú natívnu mincu aj pri odosielaní tokenov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni dovolj %@ za plačilo omrežne provizije. Na račun, ki plačuje provizijo, dodajte izvorni kovanec tega omrežja in nato osvežite ta prenos. Za omrežne provizije potrebujete izvorni kovanec tudi pri pošiljanju žetonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inte tillräckligt med %@ för att betala nätverksavgiften. Sätt in nätverkets egen valuta på kontot som betalar avgiften och uppdatera sedan överföringen. Nätverksavgifter kräver nätverkets egen valuta även när du skickar token."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ haitoshi kulipa ada ya mtandao. Ongeza sarafu ya asili ya mtandao huu kwenye akaunti inayolipa ada, kisha onyesha upya uhamisho huu. Ada za mtandao zinahitaji sarafu ya asili hata unapotuma tokeni."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நெட்வொர்க் கட்டணத்தைச் செலுத்தப் போதுமான %@ இல்லை. கட்டணம் செலுத்தும் கணக்கில் இந்த நெட்வொர்க்கின் சொந்த நாணயத்தைச் சேர்த்து, பின்னர் இந்தப் பரிமாற்றத்தைப் புதுப்பிக்கவும். டோக்கன்களை அனுப்பும்போதும் நெட்வொர்க் கட்டணங்களுக்குச் சொந்த நாணயம் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెట్‌వర్క్ రుసుము చెల్లించడానికి సరిపడా %@ లేదు. రుసుము చెల్లించే ఖాతాకు ఈ నెట్‌వర్క్ సొంత నాణేలను పంపి, ఆపై ఈ బదిలీని రిఫ్రెష్ చేయండి. టోకెన్‌లు పంపేటప్పుడు కూడా నెట్‌వర్క్ రుసుములకు సొంత నాణేలు అవసరం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่พอชำระค่าธรรมเนียมเครือข่าย เติมเหรียญหลักของเครือข่ายนี้เข้าบัญชีที่ชำระค่าธรรมเนียม แล้วรีเฟรชการโอนนี้ ค่าธรรมเนียมเครือข่ายต้องใช้เหรียญหลัก แม้จะส่งโทเค็นก็ตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ ücretini ödemek için yeterli %@ yok. Ücreti ödeyen hesaba bu ağın yerel coin'ini ekleyin, ardından bu transferi yenileyin. Token gönderirken de ağ ücretleri için yerel coin gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостатньо %@ для сплати комісії мережі. Поповніть обліковий запис, з якого сплачується комісія, нативною монетою цієї мережі, а потім оновіть дані переказу. Для комісій мережі потрібна нативна монета навіть під час надсилання токенів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیٹ ورک فیس ادا کرنے کے لیے کافی %@ نہیں ہیں۔ فیس ادا کرنے والے اکاؤنٹ میں اس نیٹ ورک کا مقامی کوائن شامل کریں، پھر اس منتقلی کو ریفریش کریں۔ ٹوکن بھیجتے وقت بھی نیٹ ورک فیس کے لیے مقامی کوائن درکار ہوتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarmoq komissiyasini toʻlash uchun %@ yetarli emas. Komissiyani toʻlovchi hisobga bu tarmoqning asosiy tangasini qoʻshing, soʻng bu oʻtkazmani yangilang. Token yuborganda ham tarmoq komissiyalari uchun asosiy tanga kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ %@ để trả phí mạng. Nạp đồng coin gốc của mạng này vào tài khoản trả phí, rồi làm mới lần chuyển này. Phí mạng luôn cần đồng coin gốc, kể cả khi gửi token."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kò tó láti san owó iṣẹ́ nẹ́tíwọ́ọ̀kì. Fi owó ìbílẹ̀ nẹ́tíwọ́ọ̀kì yìí kún àkọọ́lẹ̀ tó ń san owó iṣẹ́, lẹ́yìn náà ṣe ìmúdójúìwọ̀n gbígbé owó yìí. Owó ìbílẹ̀ ni a nílò fún owó iṣẹ́ nẹ́tíwọ́ọ̀kì, kódà nígbà tí o bá ń fi tóókìnì ránṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有足够的 %@ 来支付网络手续费。请向支付手续费的账户存入此网络的原生币，然后刷新此转账。即使发送的是代币，网络手续费也需要使用原生币支付。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有足夠的 %@ 來支付網路手續費。請向支付手續費的帳戶存入此網路的原生幣，再重新整理此筆轉帳。即使傳送的是代幣，網路手續費仍須使用原生幣支付。"
          }
        }
      }
    },
