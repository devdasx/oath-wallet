        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ സ്വീകർത്താവിന് ഡെസ്റ്റിനേഷൻ ടാഗ് ആവശ്യമാണ്. സ്വീകർത്താവ് എന്ന ഭാഗത്തേക്ക് മടങ്ങി കൃത്യമായ ടാഗ് നൽകുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या प्राप्तकर्त्याला गंतव्य टॅग आवश्यक आहे. प्राप्तकर्त्याकडे परत जाऊन अचूक टॅग भरा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
