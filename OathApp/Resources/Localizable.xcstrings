        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වියදම් කරන්නාට මෙම සීමාව වැය වන, කල් ඉකුත් වන හෝ අවලංගු කරන තුරු භාවිත කළ හැක. අත්සන යොමු කිරීමේ අවසාන කාලය වෙනමය."
