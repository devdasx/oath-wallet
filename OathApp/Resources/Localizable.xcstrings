        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သုံးစွဲသူသည် ဤသုံးစွဲခွင့်ကို ကုန်သည်အထိ၊ သက်တမ်းကုန်သည်အထိ သို့မဟုတ် ရုပ်သိမ်းသည်အထိ သုံးနိုင်သည်။ လက်မှတ်တင်သွင်းနောက်ဆုံးအချိန်သည် သီးခြားဖြစ်သည်။"
