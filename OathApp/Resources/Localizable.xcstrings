        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON 已確認此錢包的簽章規則。擁有者權限與轉帳權限都需要所選數量的金鑰。所有簽署者的金鑰都儲存在此裝置上。"
          }
        }
      }
