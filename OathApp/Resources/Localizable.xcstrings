            "value" : "వాలెట్ పునరుద్ధరించలేకపోయాము. మీ ఉన్న వాలెట్‌లు సురక్షితంగా ఉన్నాయి. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนกระเป๋าไม่ได้ กระเป๋าที่มีอยู่ยังปลอดภัย โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cüzdan geri yüklenemedi. Mevcut cüzdanlarınız güvende. Lütfen tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відновити гаманець. Ваші наявні гаманці в безпеці. Спробуйте ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والیٹ بحال نہیں ہو سکا۔ آپ کے موجودہ والیٹس محفوظ ہیں۔ دوبارہ کوشش کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamyonni tiklab bo‘lmadi. Mavjud hamyonlaringiz xavfsiz. Qayta urinib ko‘ring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khôi phục ví. Các ví hiện có vẫn an toàn. Vui lòng thử lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kò lè mú àpamọ́wọ́ padà. Àwọn àpamọ́wọ́ rẹ tó ti wà wà láìléwu. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kan sí i."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法恢复钱包。现有钱包安全无虞。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法還原錢包。您的現有錢包仍然安全。請再試一次。"
          }
        }
      }
    },
