    "biometrics.storage_failed" : {
      "comment" : "App interface text.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መክፈቻ ኮድህ ተቀምጧል፣ ነገር ግን የባዮሜትሪክ መግቢያው ሊቀመጥ አልቻለም። እንደገና ሞክር ወይም መክፈቻ ኮድህን ተጠቀም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ رمز الدخول، لكن تعذر حفظ الوصول البيومتري. حاول مجددًا أو استخدم رمز الدخول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পাসকোড সংরক্ষিত হয়েছে, কিন্তু বায়োমেট্রিক প্রবেশ সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন বা পাসকোড ব্যবহার করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístupový kód je uložen, ale biometrický přístup se nepodařilo uložit. Zkuste to znovu nebo použijte kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din PIN-kode er gemt, men biometrisk adgang kunne ikke gemmes. Prøv igen, eller brug din PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Code wurde gespeichert, der biometrische Zugriff jedoch nicht. Versuche es erneut oder nutze deinen Code."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός εισόδου σας αποθηκεύτηκε, αλλά δεν ήταν δυνατή η αποθήκευση της βιομετρικής πρόσβασης. Δοκιμάστε ξανά ή χρησιμοποιήστε τον κωδικό εισόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your passcode is saved, but biometric access couldn’t be saved. Try again or use your passcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu código está guardado, pero no se pudo guardar el acceso biométrico. Reintenta o usa tu código."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز ورود برنامه ذخیره شد، اما دسترسی زیست‌سنجی ذخیره نشد. دوباره تلاش کنید یا از رمز ورود برنامه استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pääsykoodisi on tallennettu, mutta biometristä tunnistusta ei voitu tallentaa. Yritä uudelleen tai käytä pääsykoodia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-save ang passcode mo, pero hindi na-save ang biometric access. Subukan muli o gamitin ang passcode mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre code d’accès est enregistré, mais l’accès biométrique n’a pas pu l’être. Réessayez ou utilisez votre code."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારો ઍપ પાસકોડ સાચવ્યો છે, પણ બાયોમેટ્રિક પ્રવેશ સાચવી શકાયો નહીં. ફરી પ્રયાસ કરો અથવા તમારા પાસકોડનો ઉપયોગ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ajiye lambar buɗewarka, amma ba a iya ajiye damar tantance halitta ba. Sake gwadawa ko yi amfani da lambar buɗewarka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוד הגישה נשמר, אך לא ניתן לשמור את הגישה הביומטרית. יש לנסות שוב או להשתמש בקוד הגישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासकोड सेव है, लेकिन बायोमेट्रिक ऐक्सेस सेव नहीं हो सका। फिर कोशिश करें या पासकोड इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša je pristupna šifra spremljena, ali biometrijski pristup nije moguće spremiti. Pokušajte ponovno ili koristite pristupnu šifru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazáskód mentve, de a biometrikus hozzáférést nem sikerült menteni. Próbáld újra, vagy használd az alkalmazáskódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode sandi tersimpan, tetapi akses biometrik tidak dapat disimpan. Coba lagi atau gunakan kode sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice è salvato, ma non è stato possibile salvare l'accesso biometrico. Riprova o usa il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードは保存されましたが、生体認証の設定を保存できませんでした。再試行するか、パスコードを使用してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი წვდომის კოდი შენახულია, თუმცა ბიომეტრიული წვდომის შენახვა ვერ მოხერხდა. ხელახლა სცადეთ ან გამოიყენეთ წვდომის კოდი."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កូដសម្ងាត់បានរក្សាទុក ប៉ុន្តែមិនអាចរក្សាទុកការចូលប្រើដោយជីវមាត្រ។ ព្យាយាមម្ដងទៀត ឬប្រើកូដសម្ងាត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಪಾಸ್‌ಕೋಡ್ ಉಳಿಸಲಾಗಿದೆ, ಆದರೆ ಬಯೋಮೆಟ್ರಿಕ್ ಪ್ರವೇಶವನ್ನು ಉಳಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ನಿಮ್ಮ ಪಾಸ್‌ಕೋಡ್ ಬಳಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 암호가 저장되었으나 생체 인증 설정을 저장하지 못했습니다. 다시 시도하거나 앱 암호를 사용하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ആപ്പ് പാസ്‌കോഡ് സംരക്ഷിച്ചു, പക്ഷേ ബയോമെട്രിക് പ്രവേശനം സംരക്ഷിക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ പാസ്‌കോഡ് ഉപയോഗിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा पासकोड जतन झाला, पण बायोमेट्रिक प्रवेश जतन करता आला नाही. पुन्हा प्रयत्न करा किंवा पासकोड वापरा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod laluan anda telah disimpan, tetapi akses biometrik tidak dapat disimpan. Cuba lagi atau gunakan kod laluan anda."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်ဝင်ခွင့်ကုဒ်ကို သိမ်းပြီးပါပြီ၊ သို့သော် ဇီဝအမှတ်အသားဖြင့် ဝင်ရောက်မှုကို မသိမ်းနိုင်ပါ။ ထပ်စမ်းပါ သို့မဟုတ် ဝင်ခွင့်ကုဒ် သုံးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appkoden din er lagret, men biometrisk tilgang kunne ikke lagres. Prøv igjen, eller bruk appkoden."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासकोड सुरक्षित छ तर बायोमेट्रिक पहुँच सुरक्षित गर्न सकिएन। फेरि प्रयास गर्नुहोस् वा पासकोड प्रयोग गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je toegangscode is opgeslagen, maar biometrische toegang kon niet worden opgeslagen. Probeer het opnieuw of gebruik je toegangscode."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ପାସକୋଡ୍ ସେଭ୍ ହୋଇଛି, କିନ୍ତୁ ବାୟୋମେଟ୍ରିକ୍ ପ୍ରବେଶ ସେଭ୍ ହୋଇପାରିଲା ନାହିଁ। ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ କିମ୍ବା ପାସକୋଡ୍ ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡਾ ਪਾਸਕੋਡ ਸੁਰੱਖਿਅਤ ਹੈ, ਪਰ ਬਾਇਓਮੈਟ੍ਰਿਕ ਪਹੁੰਚ ਸੁਰੱਖਿਅਤ ਨਹੀਂ ਹੋ ਸਕੀ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਜਾਂ ਪਾਸਕੋਡ ਵਰਤੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod dostępu został zapisany, ale nie udało się zapisać dostępu biometrycznego. Spróbuj ponownie lub użyj kodu dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu código foi salvo, mas não foi possível salvar o acesso biométrico. Tente novamente ou use seu código."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu código foi guardado, mas não foi possível guardar o acesso biométrico. Tente novamente ou utilize o código."
