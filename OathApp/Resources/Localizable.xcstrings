    "preferences.rates_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀሪ ሂሳቦች በየቀኑ የምንዛሬ ተመን ይቀየራሉ። ዋጋዎቹ ግምቶች ናቸው፤ ባንኮችና የልውውጥ መድረኮች ከሚያቀርቡት ተመን ሊለዩ ይችላሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحوّل الأرصدة بأسعار صرف يومية. القيم تقديرية وقد تختلف عن أسعار البنوك أو منصات التداول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিদিনের বিনিময় হার দিয়ে ব্যালেন্স রূপান্তর করা হয়। মূল্য আনুমানিক এবং ব্যাংক বা এক্সচেঞ্জের হার থেকে ভিন্ন হতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstatky se přepočítávají denními směnnými kurzy. Hodnoty jsou odhadované a mohou se lišit od kurzů bank či burz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldi omregnes med daglige valutakurser. Værdierne er estimater og kan afvige fra kurser hos banker eller børser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guthaben werden mit täglichen Wechselkursen umgerechnet. Die Werte sind Schätzungen und können von Bank- oder Börsenkursen abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα υπόλοιπα μετατρέπονται με ημερήσιες ισοτιμίες. Οι τιμές είναι εκτιμήσεις και ενδέχεται να διαφέρουν από τις ισοτιμίες τραπεζών ή ανταλλακτηρίων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balances are converted using daily exchange rates. Values are estimates and may differ from rates offered by banks or exchanges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saldos se convierten con tipos de cambio diarios. Los valores son estimaciones y pueden diferir de las tasas de bancos o plataformas de intercambio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجودی‌ها با نرخ روزانهٔ ارز تبدیل می‌شوند. مقدارها تخمینی هستند و ممکن است با نرخ بانک‌ها یا صرافی‌ها تفاوت داشته باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldot muunnetaan päivittäisillä valuuttakursseilla. Arvot ovat arvioita ja voivat erota pankkien tai pörssien tarjoamista kursseista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinukuwenta ang mga balanse gamit ang arawang palitan ng pera. Tantiya ang mga halaga at maaaring iba sa mga rate ng bangko o exchange."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soldes sont convertis selon des taux de change quotidiens. Les valeurs sont estimées et peuvent différer des taux des banques ou plateformes d’échange."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બેલેન્સ દૈનિક વિનિમય દરથી રૂપાંતરિત થાય છે. મૂલ્યો અંદાજિત છે અને બૅન્કો અથવા એક્સચેન્જના દરથી અલગ હોઈ શકે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana juya ma'aunai da farashin musaya na kullum. Ƙimomin kiyasi ne kuma suna iya bambanta da farashin bankuna ko wuraren musaya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היתרות מומרות לפי שערי חליפין יומיים. הערכים הם אומדנים ועשויים להיות שונים מהשערים שמציעים בנקים או בורסות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैलेंस दैनिक विनिमय दरों से बदले जाते हैं। मूल्य अनुमानित हैं और बैंक या एक्सचेंज की दरों से अलग हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salda se pretvaraju prema dnevnim tečajevima. Vrijednosti su procjene i mogu se razlikovati od tečajeva banaka ili mjenjačnica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyenlegek átváltása napi árfolyamokkal történik. Az értékek becslések, és eltérhetnek a bankok vagy tőzsdék által kínált árfolyamoktól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo dikonversi menggunakan kurs harian. Nilai merupakan perkiraan dan mungkin berbeda dari kurs bank atau bursa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I saldi sono convertiti usando tassi di cambio giornalieri. I valori sono stime e possono differire dai tassi offerti da banche o piattaforme di scambio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高は日次為替レートで換算されます。金額は概算で、銀行や取引所のレートと異なる場合があります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ბალანსები ყოველდღიური გაცვლითი კურსებით გადაითვლება. მნიშვნელობები სავარაუდოა და შესაძლოა ბანკებისა თუ ბირჟების კურსებისგან განსხვავდებოდეს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សមតុល្យត្រូវបានបម្លែងដោយប្រើអត្រាប្ដូរប្រាក់ប្រចាំថ្ងៃ។ តម្លៃជាការប៉ាន់ស្មាន ហើយអាចខុសពីអត្រាដែលធនាគារ ឬទីផ្សារប្ដូរប្រាក់ផ្ដល់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೈನಂದಿನ ವಿನಿಮಯ ದರಗಳ ಮೂಲಕ ಶಿಲ್ಕುಗಳನ್ನು ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ. ಮೌಲ್ಯಗಳು ಅಂದಾಜುಗಳಾಗಿದ್ದು ಬ್ಯಾಂಕ್‌ಗಳು ಅಥವಾ ವಿನಿಮಯ ಕೇಂದ್ರಗಳು ನೀಡುವ ದರಗಳಿಂದ ಭಿನ್ನವಾಗಿರಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔액은 일일 환율로 환산됩니다. 표시 금액은 예상치이며 은행이나 거래소의 환율과 다를 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ദിവസേനയുള്ള വിനിമയ നിരക്കുകൾ ഉപയോഗിച്ചാണ് ബാലൻസുകൾ മാറ്റുന്നത്. മൂല്യങ്ങൾ ഏകദേശമാണ്; ബാങ്കുകളുടെയോ എക്സ്ചേഞ്ചുകളുടെയോ നിരക്കുകളിൽ നിന്ന് വ്യത്യാസപ്പെടാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक विनिमय दरांनुसार शिल्लक रूपांतरित होते. मूल्ये अंदाजे आहेत आणि बँका किंवा एक्स्चेंजच्या दरांपेक्षा वेगळी असू शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baki ditukar menggunakan kadar pertukaran harian. Nilai ialah anggaran dan mungkin berbeza daripada kadar yang ditawarkan bank atau bursa."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လက်ကျန်များကို နေ့စဉ်ငွေလဲနှုန်းဖြင့် ပြောင်းလဲထားသည်။ တန်ဖိုးများသည် ခန့်မှန်းချက်ဖြစ်ပြီး ဘဏ်များ သို့မဟုတ် ငွေလဲဝန်ဆောင်မှုများ၏ နှုန်းနှင့် ကွာခြားနိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldoer omregnes med daglige valutakurser. Verdiene er anslag og kan avvike fra kursene til banker eller børser."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौज्दात दैनिक विनिमय दरमा रूपान्तरण गरिन्छ। मूल्य अनुमान हुन् र बैंक वा एक्सचेन्जले दिने दरभन्दा फरक हुन सक्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldi worden omgerekend met dagelijkse wisselkoersen. Waarden zijn schattingen en kunnen afwijken van koersen van banken of beurzen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଦୈନିକ ବିନିମୟ ହାରରେ ବାଲାନ୍ସ ରୂପାନ୍ତର ହୁଏ। ମୂଲ୍ୟଗୁଡ଼ିକ ଆକଳନ ମାତ୍ର ଏବଂ ବ୍ୟାଙ୍କ କିମ୍ବା ଏକ୍ସଚେଞ୍ଜର ହାରଠାରୁ ଭିନ୍ନ ହୋଇପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਕਾਏ ਰੋਜ਼ਾਨਾ ਵਟਾਂਦਰਾ ਦਰਾਂ ਨਾਲ ਬਦਲੇ ਜਾਂਦੇ ਹਨ। ਮੁੱਲ ਅੰਦਾਜ਼ੇ ਹਨ ਅਤੇ ਬੈਂਕਾਂ ਜਾਂ ਐਕਸਚੇਂਜਾਂ ਦੀਆਂ ਦਰਾਂ ਤੋਂ ਵੱਖ ਹੋ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salda są przeliczane według dziennych kursów walut. Wartości są szacunkowe i mogą różnić się od kursów oferowanych przez banki lub giełdy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os saldos são convertidos com taxas de câmbio diárias. Os valores são estimativas e podem diferir das taxas de bancos ou corretoras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os saldos são convertidos com taxas de câmbio diárias. Os valores são estimativas e podem diferir das taxas de bancos ou bolsas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldurile sunt convertite folosind cursuri de schimb zilnice. Valorile sunt estimative și pot diferi de cursurile oferite de bănci sau burse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балансы пересчитываются по ежедневным курсам. Суммы приблизительные и могут отличаться от курсов банков и бирж."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيلنس روزاني مٽاسٽا جي اگهن سان بدلايا وڃن ٿا. قدر اندازا آهن ۽ بئنڪن يا ايڪسچينجن جي اگهن کان مختلف ٿي سگهن ٿا."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ශේෂ දෛනික විනිමය අනුපාතයෙන් පරිවර්තනය කෙරේ. වටිනාකම් ඇස්තමේන්තු වන අතර බැංකු හෝ හුවමාරු මධ්‍යස්ථාන අනුපාතවලින් වෙනස් විය හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostatky sa prepočítavajú dennými výmennými kurzami. Hodnoty sú odhadované a môžu sa líšiť od kurzov bánk či búrz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanja se preračunavajo z dnevnimi menjalnimi tečaji. Vrednosti so ocene in se lahko razlikujejo od tečajev bank ali borz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldon räknas om med dagliga växelkurser. Värdena är uppskattningar och kan skilja sig från bankernas eller handelsplatsernas kurser."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salio hubadilishwa kwa kutumia viwango vya kila siku. Thamani ni makadirio na zinaweza kutofautiana na viwango vya benki au masoko ya kubadilishana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தினசரி மாற்று விகிதங்களைப் பயன்படுத்தி இருப்புகள் மாற்றப்படும். மதிப்புகள் மதிப்பீடுகளே; வங்கிகள் அல்லது வர்த்தக நிலையங்கள் வழங்கும் விகிதங்களிலிருந்து வேறுபடலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రోజువారీ మారకపు రేట్లతో నిల్వలు మారుస్తారు. విలువలు అంచనాలు; బ్యాంకులు లేదా ఎక్స్చేంజ్‌ల రేట్లకు భిన్నంగా ఉండవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลงยอดด้วยอัตราแลกเปลี่ยนรายวัน มูลค่าเป็นค่าประมาณและอาจต่างจากอัตราของธนาคารหรือศูนย์ซื้อขาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakiyeler günlük döviz kurlarıyla çevrilir. Değerler tahminidir ve bankaların veya borsaların sunduğu kurlardan farklı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланси конвертуються за щоденними курсами валют. Значення приблизні й можуть відрізнятися від курсів банків або бірж."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیلنس روزانہ کی شرحِ مبادلہ سے تبدیل ہوتے ہیں۔ مالیت تخمینی ہے اور بینکوں یا ایکسچینجز کی شرحوں سے مختلف ہو سکتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanslar kunlik valyuta kurslari bo‘yicha aylantiriladi. Qiymatlar taxminiy bo‘lib, bank yoki birjalar taklif etadigan kurslardan farq qilishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dư được quy đổi theo tỷ giá hằng ngày. Giá trị chỉ là ước tính và có thể khác tỷ giá do ngân hàng hoặc sàn giao dịch cung cấp."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ń yí ìyókù padà pẹ̀lú oṣùwọ̀n pàṣípààrọ̀ ojoojúmọ́. Àwọn iye jẹ́ ìṣírò, wọ́n sì lè yàtọ̀ sí oṣùwọ̀n ilé ìfowópamọ́ tàbí ọjà pàṣípààrọ̀."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余额使用每日汇率换算。金额为估算值，可能与银行或交易所提供的汇率不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "餘額依每日匯率換算。顯示的價值為估計值，可能與銀行或交易所提供的匯率不同。"
          }
        }
      }
    },
