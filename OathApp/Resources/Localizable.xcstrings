    "multisigStellarFeeDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar ለእያንዳንዱ ፈራሚ እና የእምነት መስመር XLM በመጠባበቂያ ያስቀምጣል። መጠባበቂያው በመለያዎ ውስጥ ይቀራል፤ የአውታረ መረብ ክፍያው ለStellar ይከፈላል፣ ለOath አይደለም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحجز Stellar رصيدًا من XLM لكل موقّع وخط ثقة. يبقى هذا الرصيد في حسابك؛ وتُدفع رسوم الشبكة إلى Stellar، وليس إلى Oath."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar প্রতিটি স্বাক্ষরকারী ও ট্রাস্টলাইনের জন্য XLM সংরক্ষিত রাখে। সংরক্ষিত অর্থ আপনার অ্যাকাউন্টেই থাকে; নেটওয়ার্ক ফি Stellar-কে দেওয়া হয়, Oath-কে নয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar rezervuje XLM pro každého podepisujícího a každou linku důvěry. Rezerva zůstává na vašem účtu; síťový poplatek se platí síti Stellar, nikoli aplikaci Oath."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar reserverer XLM til hver underskriver og tillidslinje. Reserven bliver på din konto. Netværksgebyret betales til Stellar, ikke til Oath."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar reserviert XLM für jeden Unterzeichner und jede Vertrauenslinie. Die Reserve bleibt auf deinem Konto. Die Netzwerkgebühr geht an Stellar, nicht an Oath."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Stellar δεσμεύει XLM για κάθε υπογράφοντα και γραμμή εμπιστοσύνης. Το αποθεματικό παραμένει στον λογαριασμό σας· η προμήθεια δικτύου καταβάλλεται στο Stellar, όχι στο Oath."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar reserves XLM for each signer and trustline. The reserve remains in your account; the network fee is paid to Stellar, not Oath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar reserva XLM por cada firmante y línea de confianza. La reserva permanece en tu cuenta; la comisión de red se paga a Stellar, no a Oath."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar برای هر امضاکننده و خط اعتماد، مقداری XLM به‌عنوان ذخیره نگه می‌دارد. این ذخیره در حساب شما می‌ماند؛ کارمزد شبکه به Stellar پرداخت می‌شود، نه به Oath."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar varaa XLM-kolikoita jokaista allekirjoittajaa ja luottolinjaa varten. Varaus säilyy tililläsi. Verkkomaksu maksetaan Stellar-verkolle, ei Oath-sovellukselle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrereserba ang Stellar ng XLM para sa bawat lumalagda at trustline. Nananatili ang reserba sa iyong account; sa Stellar ibinabayad ang bayarin sa network, hindi sa Oath."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar réserve des XLM pour chaque signataire et chaque ligne de confiance. La réserve reste sur votre compte ; les frais de réseau sont versés à Stellar, et non à Oath."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar દરેક હસ્તાક્ષરકર્તા અને ટ્રસ્ટલાઇન માટે XLM અનામત રાખે છે. અનામત તમારા ખાતામાં જ રહે છે; નેટવર્ક ફી Stellar ને ચૂકવાય છે, Oath ને નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar yana ware XLM don kowane mai sa hannu da amincewar karɓar token. Kuɗin ajiyar yana nan a asusunka; ana biyan kuɗin hanyar sadarwa ga Stellar, ba Oath ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar שומרת רזרבה של XLM עבור כל חותם וקו אמון. הרזרבה נשארת בחשבון שלך; עמלת הרשת משולמת ל-Stellar, ולא ל-Oath."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar हर हस्ताक्षरकर्ता और ट्रस्टलाइन के लिए XLM आरक्षित रखता है। आरक्षित राशि आपके खाते में रहती है; नेटवर्क शुल्क Stellar को दिया जाता है, Oath को नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar rezervira XLM za svakog potpisnika i svaku liniju povjerenja. Pričuva ostaje na vašem računu; mrežna naknada plaća se mreži Stellar, a ne aplikaciji Oath."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Stellar minden aláíróhoz és bizalmi kapcsolathoz XLM-tartalékot köt le. A tartalék a számládon marad; a hálózati díjat a Stellar kapja, nem az Oath."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar mencadangkan XLM untuk setiap penanda tangan dan jalur kepercayaan. Cadangan tetap berada di akun Anda; biaya jaringan dibayarkan kepada Stellar, bukan Oath."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar riserva XLM per ogni firmatario e linea di fiducia. La riserva rimane nel tuo account; la commissione di rete viene pagata a Stellar, non a Oath."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar では、署名者やトラストラインを追加するごとに XLM の準備金が必要です。準備金はアカウントに残ります。ネットワーク手数料は Oath ではなく Stellar に支払われます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar თითოეული ხელმომწერისა და ნდობის ხაზისთვის XLM-ს არეზერვებს. რეზერვი თქვენს ანგარიშზე რჩება; ქსელის საკომისიოს იღებს Stellar და არა Oath."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar កំណត់ប្រាក់បម្រុង XLM សម្រាប់អ្នកចុះហត្ថលេខាម្នាក់ៗ និងខ្សែទំនាក់ទំនងទុកចិត្តនីមួយៗ។ ប្រាក់បម្រុងនៅតែក្នុងគណនីរបស់អ្នក។ ថ្លៃបណ្តាញត្រូវបង់ទៅ Stellar មិនមែនទៅ Oath ទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಸಹಿದಾರರು ಮತ್ತು ಟ್ರಸ್ಟ್‌ಲೈನ್‌ಗಾಗಿ Stellar XLM ಮೀಸಲಿಡುತ್ತದೆ. ಮೀಸಲು ನಿಮ್ಮ ಖಾತೆಯಲ್ಲೇ ಉಳಿಯುತ್ತದೆ; ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕವನ್ನು Stellar ಗೆ ಪಾವತಿಸಲಾಗುತ್ತದೆ, Oath ಗೆ ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar는 각 서명자와 신뢰선마다 XLM을 준비금으로 요구합니다. 준비금은 계정에 남아 있으며, 네트워크 수수료는 Oath가 아닌 Stellar에 지급됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ ഒപ്പിടുന്നയാൾക്കും ട്രസ്റ്റ്‌ലൈനിനും Stellar, XLM കരുതൽതുകയായി മാറ്റിവയ്ക്കുന്നു. ആ കരുതൽതുക നിങ്ങളുടെ അക്കൗണ്ടിൽത്തന്നെ തുടരും; നെറ്റ്‌വർക്ക് ഫീസ് Stellar-നാണ് നൽകുന്നത്, Oath-നല്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar प्रत्येक स्वाक्षरीकर्ता आणि ट्रस्टलाइनसाठी XLM राखून ठेवते. हा राखीव निधी तुमच्या खात्यातच राहतो; नेटवर्क शुल्क Stellar ला दिले जाते, Oath ला नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar merizabkan XLM untuk setiap penandatangan dan talian kepercayaan. Rizab kekal dalam akaun anda; yuran rangkaian dibayar kepada Stellar, bukan Oath."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar သည် လက်မှတ်ထိုးသူတစ်ဦးစီနှင့် ယုံကြည်မှုချိတ်ဆက်မှုတစ်ခုစီအတွက် XLM အရန်ငွေ သတ်မှတ်သည်။ အရန်ငွေသည် သင့်အကောင့်ထဲတွင် ဆက်ရှိနေသည်။ ကွန်ရက်အခကြေးငွေကို Oath သို့ မဟုတ်ဘဲ Stellar သို့ ပေးသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar reserverer XLM for hver signatar og tillitslinje. Reserven blir på kontoen din. Nettverksgebyret betales til Stellar, ikke til Oath."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar ले हरेक हस्ताक्षरकर्ता र ट्रस्टलाइनका लागि XLM सञ्चित राख्छ। सञ्चिति तपाईंको खातामै रहन्छ; नेटवर्क शुल्क Stellar लाई तिरिन्छ, Oath लाई होइन।"
