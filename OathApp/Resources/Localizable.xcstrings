        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබේ %@ පසුම්බි ලිපිනය බෙදාගන්න. යවන්නාගේ පසුම්බිය ටෝකනය එහි අදාළ ටෝකන ගිණුමට යවයි. මුලින් එම ගිණුම සාදා ගබඩා වියදම ගෙවීමට සිදු විය හැක."
