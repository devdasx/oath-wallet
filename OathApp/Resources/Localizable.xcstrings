    "feature.accessibility" : {
      "comment" : "App interface text.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለብዙ ብሎክቼይኖች ዋሌት። ክሪፕቶ ላክ፣ ተቀበል፣ ክፈል እና ጠይቅ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفظة متعددة الشبكات. أرسل العملات الرقمية واستلمها وادفع واطلبها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাল্টিচেইন ওয়ালেট। ক্রিপ্টো পাঠান, গ্রহণ করুন, পেমেন্ট করুন ও চেয়ে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peněženka pro více sítí. Odesílejte, přijímejte, plaťte a žádejte o kryptoměny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallet til flere blockchains. Send, modtag, betal og anmod om krypto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multichain-Wallet. Krypto senden, empfangen, bezahlen und anfordern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πορτοφόλι για πολλά δίκτυα. Στείλτε, λάβετε, πληρώστε και ζητήστε κρυπτονομίσματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multichain wallet. Send, receive, pay, and request crypto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartera multicadena. Envía, recibe, paga y solicita criptomonedas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیف پول چندزنجیره‌ای. رمزارز بفرستید، دریافت کنید، پرداخت کنید و درخواست دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
