        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny typy adres patří této peněžence. Oath kontroluje přijímací adresy i adresy pro vrácení zbytku každého typu bez ohledu na zde zobrazenou adresu."
