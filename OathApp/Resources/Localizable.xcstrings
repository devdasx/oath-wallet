    "multisigNearFeeDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR ለውሉ ማከማቻ መጠባበቂያ ይፈልጋል። የአውታረ መረብ ክፍያዎች ለNEAR ይከፈላሉ፤ Oath የማንቃት ክፍያ አያስከፍልም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب NEAR رصيدًا محجوزًا لتخزين العقد. تُدفع رسوم الشبكة إلى NEAR؛ ولا تفرض Oath رسوم تفعيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR-এ চুক্তির জন্য সঞ্চয়স্থানের সংরক্ষিত অর্থ প্রয়োজন। নেটওয়ার্ক ফি NEAR-কে দেওয়া হয়; Oath সক্রিয় করার কোনো ফি নেয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR vyžaduje rezervu na úložiště kontraktu. Síťové poplatky se platí síti NEAR; Oath neúčtuje žádný aktivační poplatek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR kræver en lagerreserve til kontrakten. Netværksgebyrer betales til NEAR. Oath opkræver ikke noget aktiveringsgebyr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR benötigt eine Speicherreserve für den Vertrag. Netzwerkgebühren werden an NEAR gezahlt. Oath erhebt keine Aktivierungsgebühr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το NEAR απαιτεί αποθεματικό αποθήκευσης για το συμβόλαιο. Οι προμήθειες δικτύου καταβάλλονται στο NEAR· το Oath δεν χρεώνει προμήθεια ενεργοποίησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR requires a storage reserve for the contract. Network fees are paid to NEAR; Oath charges no activation fee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR requiere una reserva de almacenamiento para el contrato. Las comisiones de red se pagan a NEAR; Oath no cobra ninguna comisión de activación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR برای ذخیره‌سازی قرارداد به موجودی ذخیره نیاز دارد. کارمزدهای شبکه به NEAR پرداخت می‌شوند؛ Oath کارمزدی برای فعال‌سازی دریافت نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR vaatii sopimukselle tallennusvarauksen. Verkkomaksut maksetaan NEAR-verkolle. Oath ei veloita aktivointimaksua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nangangailangan ang NEAR ng reserba para sa imbakan ng kontrata. Sa NEAR ibinabayad ang mga bayarin sa network; walang sinisingil ang Oath para sa pag-activate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR exige une réserve de stockage pour le contrat. Les frais de réseau sont versés à NEAR ; Oath ne facture aucuns frais d’activation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR ને કરાર માટે સંગ્રહ અનામત જરૂરી છે. નેટવર્ક ફી NEAR ને ચૂકવાય છે; Oath સક્રિય કરવા માટે કોઈ ફી લેતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR yana buƙatar ajiyar kuɗi don adana kwangilar. Ana biyan kuɗin hanyar sadarwa ga NEAR; Oath ba ya karɓar kuɗin kunnawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR דורשת רזרבה עבור אחסון החוזה. עמלות הרשת משולמות ל-NEAR; אין עמלת הפעלה מצד Oath."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR को कॉन्ट्रैक्ट के लिए आरक्षित संग्रहण राशि चाहिए। नेटवर्क शुल्क NEAR को दिया जाता है; Oath सक्रिय करने का कोई शुल्क नहीं लेता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR zahtijeva pričuvu za pohranu ugovora. Mrežne naknade plaćaju se mreži NEAR; Oath ne naplaćuje aktivaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A NEAR tárolási tartalékot követel meg a szerződéshez. A hálózati díjakat a NEAR kapja; az Oath nem számít fel aktiválási díjat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR mewajibkan cadangan untuk penyimpanan kontrak. Biaya jaringan dibayarkan kepada NEAR; Oath tidak mengenakan biaya aktivasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR richiede una riserva per l’archiviazione del contratto. Le commissioni di rete vengono pagate a NEAR; Oath non addebita commissioni di attivazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR では、コントラクトのストレージ用準備金が必要です。ネットワーク手数料は NEAR に支払われます。Oath は有効化の手数料を請求しません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR კონტრაქტის შესანახად რეზერვს მოითხოვს. ქსელის საკომისიოებს იღებს NEAR; Oath გააქტიურების საფასურს არ აწესებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR តម្រូវឱ្យមានប្រាក់បម្រុងសម្រាប់ទំហំផ្ទុកកិច្ចសន្យា។ ថ្លៃបណ្តាញត្រូវបង់ទៅ NEAR។ Oath មិនគិតថ្លៃបើកប្រើទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಪ್ಪಂದಕ್ಕಾಗಿ NEAR ಸಂಗ್ರಹಣೆ ಮೀಸಲನ್ನು ಅಗತ್ಯವಾಗಿಸುತ್ತದೆ. ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕವನ್ನು NEAR ಗೆ ಪಾವತಿಸಲಾಗುತ್ತದೆ; Oath ಸಕ್ರಿಯಗೊಳಿಸುವ ಶುಲ್ಕ ವಿಧಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR는 컨트랙트 저장 공간을 위한 준비금을 요구합니다. 네트워크 수수료는 NEAR에 지급되며, Oath는 활성화 수수료를 받지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കരാറിന്റെ സംഭരണത്തിനായി NEAR ഒരു കരുതൽതുക ആവശ്യപ്പെടുന്നു. നെറ്റ്‌വർക്ക് ഫീസ് NEAR-നാണ് നൽകുന്നത്; Oath സജീവമാക്കൽ ഫീസ് ഈടാക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR ला करारासाठी साठवणुकीचा राखीव निधी आवश्यक आहे. नेटवर्क शुल्क NEAR ला दिले जाते; Oath सक्रिय करण्यासाठी शुल्क आकारत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR memerlukan rizab storan untuk kontrak. Yuran rangkaian dibayar kepada NEAR; Oath tidak mengenakan yuran pengaktifan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR သည် စာချုပ်သိုလှောင်ရန် အရန်ငွေလိုအပ်သည်။ ကွန်ရက်အခကြေးငွေကို NEAR သို့ ပေးသည်။ Oath က ဖွင့်သုံးခ မကောက်ခံပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAR krever en lagringsreserve for kontrakten. Nettverksgebyrer betales til NEAR. Oath tar ikke noe aktiveringsgebyr."
