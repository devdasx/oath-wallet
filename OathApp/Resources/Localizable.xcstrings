        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे वॉलेट पुनर्संचयित करण्याचे शब्द पहा. ते गुप्त आणि सुरक्षित ठिकाणी ठेवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat perkataan untuk memulihkan dompet ini. Rahsiakan dan simpan di tempat selamat."
