            "value" : "محفوظ %@ پتا هتي ظاهر ٿيندا. اڳتي وڌڻ لاءِ مٿي پتو لکو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සුරැකි %@ ලිපින මෙහි දිස්වනු ඇත. ඉදිරියට යාමට ඉහත ලිපිනයක් ඇතුළත් කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sa zobrazia uložené adresy %@. Na pokračovanie zadajte adresu vyššie."
