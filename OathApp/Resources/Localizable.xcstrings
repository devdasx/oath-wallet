    "history.filter.invalid_range" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክልሎችህን አረጋግጥ። አሉታዊ ያልሆኑ መጠኖችን ተጠቀም፣ ዝቅተኛውም ከከፍተኛው አይብለጥ፤ የመጨረሻ ቀን ከመጀመሪያው ቀን ጋር እኩል ወይም ከእሱ በኋላ ይሁን።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من النطاقات. استخدم مبالغ غير سالبة، وحدًا أدنى لا يتجاوز الأعلى، وتاريخ انتهاء يوافق البداية أو يليها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিসর যাচাই করুন। ঋণাত্মক নয় এমন পরিমাণ দিন; সর্বনিম্ন যেন সর্বোচ্চের বেশি না হয় এবং শেষের তারিখ শুরুর তারিখের আগে না হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte rozsahy. Částky musí být nezáporné, minimum nesmí převyšovat maximum a koncové datum nesmí předcházet počátečnímu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér intervallerne. Beløb skal være mindst nul, minimum må ikke overstige maksimum, og slutdatoen må ikke ligge før startdatoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Bereiche. Beträge dürfen nicht negativ sein, das Minimum darf das Maximum nicht überschreiten und das Enddatum muss am oder nach dem Startdatum liegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τα εύρη. Τα ποσά πρέπει να είναι μη αρνητικά, το ελάχιστο να μην υπερβαίνει το μέγιστο και η ημερομηνία λήξης να μην προηγείται της έναρξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your ranges. Use nonnegative amounts, with the minimum no greater than the maximum, and an end date on or after the start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los intervalos. Usa importes no negativos, un mínimo que no supere al máximo y una fecha final igual o posterior a la inicial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازه‌ها را بررسی کنید. مقدارها باید نامنفی باشند، حداقل از حداکثر بیشتر نباشد و تاریخ پایان پیش از تاریخ شروع نباشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista rajat. Määrät eivät saa olla negatiivisia, vähimmäismäärä ei saa ylittää enimmäismäärää eikä loppupäivä saa olla ennen alkupäivää."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang mga saklaw. Gumamit ng di-negatibong halaga; hindi dapat lumampas ang minimum sa maximum, at ang petsa ng pagtatapos ay hindi dapat mauna sa simula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les plages. Utilisez des montants positifs ou nuls, un minimum inférieur ou égal au maximum et une date de fin égale ou postérieure à celle de début."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા ગાળા તપાસો. શૂન્ય અથવા વધુ રકમ વાપરો, લઘુતમ રકમ મહત્તમથી વધુ ન હોય અને અંતિમ તારીખ શરૂઆતની તારીખે અથવા તે પછી હોય."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duba zangonka. Yi amfani da adadi marasa ƙasa da sifili, ƙarami kada ya fi babba, kuma ƙarshen kwanan wata ya kasance a ranar farko ko bayanta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבדוק את הטווחים. יש להשתמש בכמויות לא שליליות, כשערך המינימום אינו עולה על המקסימום, ובתאריך סיום שחל בתאריך ההתחלה או אחריו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमाएँ जाँचें। रकम ऋणात्मक न हो, न्यूनतम अधिकतम से अधिक न हो, और अंतिम तारीख शुरुआती तारीख से पहले न हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerite raspone. Iznosi ne smiju biti negativni, najmanji iznos ne smije biti veći od najvećeg, a završni datum ne smije biti prije početnog."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizd a tartományokat. Nemnegatív összegeket használj, a minimum ne haladja meg a maximumot, a záró dátum pedig ne előzze meg a kezdőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa rentang Anda. Gunakan jumlah nonnegatif, minimum tidak melebihi maksimum, dan tanggal akhir sama dengan atau setelah tanggal awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla gli intervalli. Usa importi non negativi, con il minimo non superiore al massimo e una data finale non precedente a quella iniziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲を確認してください。数量は0以上、最小値は最大値以下、終了日は開始日以降にしてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეამოწმეთ დიაპაზონები. თანხები არ უნდა იყოს უარყოფითი, მინიმუმი არ უნდა აღემატებოდეს მაქსიმუმს, ხოლო დასრულების თარიღი არ უნდა იყოს დაწყების თარიღზე ადრე."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពិនិត្យចន្លោះរបស់អ្នក។ ប្រើចំនួនមិនអវិជ្ជមាន អប្បបរមាមិនលើសអតិបរមា ហើយកាលបរិច្ឆេទបញ្ចប់មិនមុនកាលបរិច្ឆេទចាប់ផ្ដើម។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ವ್ಯಾಪ್ತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಿ. ಋಣಾತ್ಮಕವಲ್ಲದ ಮೊತ್ತ ಬಳಸಿ, ಕನಿಷ್ಠ ಮೊತ್ತವು ಗರಿಷ್ಠಕ್ಕಿಂತ ಹೆಚ್ಚಿರಬಾರದು ಮತ್ತು ಅಂತಿಮ ದಿನಾಂಕವು ಆರಂಭದ ದಿನಾಂಕಕ್ಕಿಂತ ಮೊದಲಿರಬಾರದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범위를 확인하세요. 수량은 음수가 될 수 없고 최솟값은 최댓값을 넘을 수 없으며 종료일은 시작일과 같거나 이후여야 합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിധികൾ പരിശോധിക്കുക. നെഗറ്റീവ് അല്ലാത്ത തുകകൾ ഉപയോഗിക്കുക; കുറഞ്ഞ തുക കൂടിയ തുകയെ കവിയരുത്. അവസാന തീയതി ആരംഭ തീയതിയിലോ അതിന് ശേഷമോ ആയിരിക്കണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मर्यादा तपासा. ऋण नसलेल्या रकमा वापरा; किमान रक्कम कमालपेक्षा जास्त नसावी आणि शेवटची तारीख सुरुवातीच्या तारखेला किंवा त्यानंतर असावी."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak julat anda. Gunakan amaun bukan negatif, minimum tidak melebihi maksimum, dan tarikh tamat pada atau selepas tarikh mula."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အပိုင်းအခြားများကို စစ်ပါ။ အနုတ်မဟုတ်သော ပမာဏများ သုံးပါ။ အနည်းဆုံးပမာဏသည် အများဆုံးထက် မကြီးရ၊ နောက်ဆုံးရက်သည် စရက်နှင့် တူရမည် သို့မဟုတ် နောက်ကျရမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller intervallene. Beløp må være minst null, minimum må ikke overstige maksimum, og sluttdatoen må ikke være før startdatoen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दायरा जाँच्नुहोस्। परिमाण ऋणात्मक नराख्नुहोस्, न्यूनतम अधिकतमभन्दा बढी नहोस् र अन्त्य मिति सुरुआतभन्दा अघि नहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je bereiken. Gebruik niet-negatieve bedragen, met een minimum dat niet hoger is dan het maximum, en een einddatum op of na de begindatum."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସୀମା ଯାଞ୍ଚ କରନ୍ତୁ। ଋଣାତ୍ମକ ନଥିବା ପରିମାଣ ଦିଅନ୍ତୁ, ସର୍ବନିମ୍ନ ଯେପରି ସର୍ବାଧିକଠାରୁ ବେଶି ନ ହୁଏ ଏବଂ ଶେଷ ତାରିଖ ଆରମ୍ଭ ତାରିଖର ପୂର୍ବରୁ ନ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੀਆਂ ਹੱਦਾਂ ਜਾਂਚੋ। ਗੈਰ-ਨਕਾਰਾਤਮਕ ਮਾਤਰਾਵਾਂ ਵਰਤੋ; ਘੱਟੋ-ਘੱਟ ਵੱਧ ਤੋਂ ਵੱਧ ਤੋਂ ਵੱਡਾ ਨਾ ਹੋਵੇ ਅਤੇ ਅੰਤ ਦੀ ਤਾਰੀਖ ਸ਼ੁਰੂਆਤ ਤੋਂ ਪਹਿਲਾਂ ਨਾ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź zakresy. Kwoty nie mogą być ujemne, minimum nie może przekraczać maksimum, a data końcowa nie może poprzedzać początkowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique os intervalos. Use valores não negativos, com o mínimo menor ou igual ao máximo, e uma data final igual ou posterior à inicial."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique os intervalos. Utilize valores não negativos, com o mínimo inferior ou igual ao máximo, e uma data final igual ou posterior à inicial."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică intervalele. Folosește sume nenegative, cu minimul cel mult egal cu maximul, și o dată de sfârșit egală sau ulterioară celei de început."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте диапазоны. Суммы должны быть неотрицательными, минимум — не больше максимума, дата окончания — не раньше даты начала."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پنهنجون حدون ڏسو. مقدار منفي نه هجن، گهٽ ۾ گهٽ مقدار وڌ ۾ وڌ کان وڌيڪ نه هجي، ۽ آخري تاريخ شروعاتي تاريخ کان اڳ نه هجي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පරාස පරීක්ෂා කරන්න. ඍණ නොවන ප්‍රමාණ භාවිත කර අවමය උපරිමයට නොවැඩි බවත් අවසන් දිනය ආරම්භක දිනයට පෙර නොවන බවත් බලන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte rozsahy. Sumy musia byť nezáporné, minimum nesmie prevyšovať maximum a koncový dátum nesmie predchádzať počiatočnému."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preverite razpone. Zneski morajo biti nenegativni, najmanjši ne sme presegati največjega, končni datum pa ne sme biti pred začetnim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera intervallen. Ange belopp som inte är negativa, med minimum högst lika stort som maximum, och ett slutdatum samma dag som eller efter startdatumet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angalia mipaka yako. Tumia kiasi kisicho hasi, cha chini kisizidi cha juu, na tarehe ya mwisho iwe sawa na au baada ya tarehe ya mwanzo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வரம்புகளைச் சரிபார்க்கவும். எதிர்மறை அல்லாத அளவுகளைப் பயன்படுத்தவும்; குறைந்தபட்சம் அதிகபட்சத்தை மீறக்கூடாது. முடிவுத் தேதி தொடக்கத் தேதியில் அல்லது அதற்குப் பிறகு இருக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ పరిధులను తనిఖీ చేయండి. రుణేతర మొత్తాలు వాడండి, కనిష్ఠం గరిష్ఠాన్ని మించకూడదు, ముగింపు తేదీ ప్రారంభ తేదీకి సమానంగా లేదా తర్వాత ఉండాలి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบช่วงที่ระบุ ใช้จำนวนที่ไม่ติดลบ โดยค่าต่ำสุดไม่เกินค่าสูงสุด และวันที่สิ้นสุดต้องตรงกับหรือหลังวันที่เริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aralıklarınızı kontrol edin. Negatif olmayan miktarlar kullanın; en düşük tutar en yüksek tutardan büyük olmamalı ve bitiş tarihi başlangıç tarihiyle aynı veya daha sonra olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте діапазони. Суми мають бути невід’ємними, мінімум не повинен перевищувати максимум, а кінцева дата не може бути раніше початкової."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی حدود دیکھیں۔ مقدار منفی نہ ہو، کم از کم مقدار زیادہ سے زیادہ سے بڑی نہ ہو، اور آخری تاریخ ابتدائی تاریخ سے پہلے نہ ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraliqlarni tekshiring. Miqdorlar manfiy bo‘lmasin, eng kichik qiymat eng kattasidan oshmasin va tugash sanasi boshlanishdan oldin bo‘lmasin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra các khoảng đã nhập. Dùng số lượng không âm, giá trị tối thiểu không lớn hơn tối đa và ngày kết thúc không trước ngày bắt đầu."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣàyẹ̀wò àwọn ààlà rẹ. Lo iye tí kò kéré ju òdo lọ, kí iye tó kéré jù má kọjá èyí tó pọ̀ jù, kí ọjọ́ ìparí má sì ṣáájú ọjọ́ ìbẹ̀rẹ̀."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查范围。金额须为非负数，最小值不得大于最大值，结束日期不得早于开始日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查範圍。數量必須為非負值，最小值不得大於最大值，結束日期不得早於開始日期。"
          }
        }
      }
    },
