    "token.invalid_address" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የውል ወይም mint አድራሻውን አረጋግጥና እንደገና ሞክር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من عنوان العقد أو mint وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কন্ট্র্যাক্ট বা মিন্টের ঠিকানা দেখে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte adresu kontraktu nebo mintu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér kontrakt- eller mintadressen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Vertrags- oder Mint-Adresse und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τη διεύθυνση συμβολαίου ή έκδοσης και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the contract or mint address and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la dirección de contrato o mint y reintenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانی قرارداد یا مینت را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista sopimus- tai mint-osoite ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang address ng kontrata o mint at subukan muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’adresse du contrat ou du mint et réessayez."
