        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有簽署者擁有足夠的 SOL 來支付此次傳送的手續費和提案儲存費用。請向任一簽署者存入資金，或在錢包設定中開啟「Solana 簽章規則」以複製簽署者地址，然後再試一次。"
          }
        }
      }
