        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබේ පසුම්බි ආරක්ෂිතව මාරු කරමින් පවතී. මෙය අතරමඟ නතර වුවද ඔබේ මුල් දත්ත නැවත ලබාගත හැක."
