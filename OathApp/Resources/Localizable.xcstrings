            "value" : "සුරැකි විනිමය අනුපාත භාවිත වේ. නවතම යාවත්කාලීනය නොමැත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používajú sa uložené výmenné kurzy. Najnovšia aktualizácia nie je dostupná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabljajo se shranjeni menjalni tečaji. Zadnja posodobitev ni na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade växelkurser används. Den senaste uppdateringen är inte tillgänglig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inatumia viwango vya ubadilishaji vilivyohifadhiwa. Sasisho la karibuni halipatikani."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமித்த மாற்று விகிதங்கள் பயன்படுத்தப்படுகின்றன. சமீபத்திய புதுப்பிப்பு கிடைக்கவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసిన మారకపు రేట్లను ఉపయోగిస్తోంది. తాజా నవీకరణ అందుబాటులో లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้อัตราแลกเปลี่ยนที่บันทึกไว้ ไม่สามารถอัปเดตล่าสุดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı döviz kurları kullanılıyor. Son güncelleme alınamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуються збережені курси валют. Останнє оновлення недоступне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ شرحِ مبادلہ استعمال ہو رہی ہے۔ تازہ ترین اپ ڈیٹ دستیاب نہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saqlangan valyuta kurslari ishlatilmoqda. Eng so‘nggi yangilanish mavjud emas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang dùng tỷ giá đã lưu. Chưa có bản cập nhật mới nhất."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn oṣùwọ̀n pàṣípààrọ̀ tí a fi pamọ́ ni a ń lò. Ìmúdójúìwọ̀n tó ṣẹ̀ṣẹ̀ jù kò sí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用已保存的汇率。无法获取最新更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已儲存的匯率。無法取得最新更新。"
          }
        }
      }
    },
