          "stringUnit" : {
            "state" : "translated",
            "value" : "ସଂଯୋଗ ମିଳିଲେ iCloud ଅପଲୋଡ୍ ଜାରି ରଖିବ। iCloud Drive ସକ୍ରିୟ ରଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਨੈਕਸ਼ਨ ਮਿਲਣ 'ਤੇ iCloud ਅੱਪਲੋਡ ਜਾਰੀ ਰੱਖੇਗਾ। iCloud Drive ਚਾਲੂ ਰੱਖੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud wznowi przesyłanie, gdy połączenie będzie dostępne. Pozostaw iCloud Drive włączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud continuará o envio quando houver conexão. Mantenha o iCloud Drive ativado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud continuará o envio quando existir ligação. Mantenha o iCloud Drive ativado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud va continua încărcarea când va fi disponibilă o conexiune. Păstrează iCloud Drive activat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud продолжит загрузку, когда появится соединение. Не отключайте iCloud Drive."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڪنيڪشن ملڻ تي iCloud اپلوڊ جاري رکندو. iCloud Drive فعال رکو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සම්බන්ධතාවක් ඇති විට iCloud උඩුගත කිරීම දිගටම කරයි. iCloud Drive සක්‍රියව තබන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud bude pokračovať v nahrávaní po pripojení k sieti. Ponechajte iCloud Drive zapnutý."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud bo nadaljeval nalaganje, ko bo povezava na voljo. iCloud Drive naj ostane omogočen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud fortsätter överföringen när en anslutning är tillgänglig. Behåll iCloud Drive aktiverat."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud itaendelea kupakia muunganisho ukipatikana. Acha iCloud Drive ikiwa imewashwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைப்பு கிடைக்கும்போது iCloud பதிவேற்றத்தைத் தொடரும். iCloud Drive-ஐ இயக்கியே வைத்திருக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కనెక్షన్ అందుబాటులోకి రాగానే iCloud అప్‌లోడ్ కొనసాగిస్తుంది. iCloud Driveను ఆన్‌లో ఉంచండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud จะอัปโหลดต่อเมื่อมีการเชื่อมต่อ เปิดใช้ iCloud Drive ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı olduğunda iCloud yüklemeye devam edecek. iCloud Drive'ı açık tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud продовжить вивантаження, коли з’явиться з’єднання. Залиште iCloud Drive ввімкненим."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کنکشن دستیاب ہونے پر iCloud اپ لوڈ جاری رکھے گا۔ iCloud Drive فعال رکھیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulanish mavjud bo‘lganda iCloud yuklashni davom ettiradi. iCloud Drive ni yoqilgan holda qoldiring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sẽ tiếp tục tải lên khi có kết nối. Hãy giữ iCloud Drive ở trạng thái bật."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud yóò tẹ̀síwájú láti gbé e sókè nígbà tí ìsopọ̀ bá wà. Jẹ́ kí iCloud Drive máa ṣiṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有网络连接时，iCloud 将继续上传。请保持 iCloud Drive 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有可用連線時，iCloud 會繼續上傳。請保持 iCloud Drive 啟用。"
          }
        }
      }
    },
