        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath nigdy o niego nie poprosi. Nie wysyłaj go nikomu, nie wklejaj na stronach internetowych ani nie udostępniaj pomocy technicznej."
