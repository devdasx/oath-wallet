      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ በ%@ ላይ ያለው የመለያ አድራሻህ ነው። ተተኪ ቶከን ከመቀበሉ በፊት መለያው ማንቃትና በቶከኑ ውል መመዝገብ፣ የማከማቻ ተቀማጭንም ጨምሮ፣ ሊያስፈልገው ይችላል። Oath ይህን ገና አያዘጋጅም።"
