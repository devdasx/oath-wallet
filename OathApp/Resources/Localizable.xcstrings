    "private_key_view.qr_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ኮድ በቀደመው ገጽ የታየውን የግል ቁልፍ ይዟል። ማንኛውም ሰው ስካን ካደረገው ያንን አድራሻ መቆጣጠር ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي هذا الرمز على المفتاح الخاص المعروض في الشاشة السابقة. يمكن لمن يمسحه التحكم بهذا العنوان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কোডে আগের পর্দায় দেখানো ব্যক্তিগত কী আছে। যে কেউ স্ক্যান করলে সেই ঠিকানা নিয়ন্ত্রণ করতে পারবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kód obsahuje soukromý klíč z předchozí obrazovky. Každý, kdo ho naskenuje, může tuto adresu ovládat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kode indeholder den private nøgle, der blev vist på forrige skærm. Enhver, der scanner den, kan kontrollere den adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code enthält den privaten Schlüssel des vorherigen Bildschirms. Jeder, der ihn scannt, kann diese Adresse kontrollieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο κωδικός περιέχει το ιδιωτικό κλειδί της προηγούμενης οθόνης. Όποιος τον σαρώσει μπορεί να ελέγχει αυτή τη διεύθυνση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code contains the private key shown on the previous screen. Anyone who scans it can control that address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código contiene la clave privada de la pantalla anterior. Quien lo escanee puede controlar esa dirección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کد شامل کلید خصوصی نمایش‌داده‌شده در صفحهٔ قبل است. هرکس آن را اسکن کند می‌تواند آن نشانی را کنترل کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä koodi sisältää edellisessä näkymässä näytetyn yksityisavaimen. Sen skannaaja voi hallita kyseistä osoitetta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa code na ito ang pribadong key na ipinakita sa naunang screen. Makokontrol ng sinumang mag-scan nito ang address na iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code contient la clé privée affichée à l’écran précédent. Toute personne qui le scanne peut contrôler cette adresse."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ કોડમાં અગાઉની સ્ક્રીન પર દર્શાવેલી ખાનગી કી છે. તેને સ્કૅન કરનાર કોઈપણ તે સરનામું નિયંત્રિત કરી શકે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan lambar tana ɗauke da maɓallin sirrin da aka nuna a shafin baya. Duk wanda ya duba ta da kyamara zai iya sarrafa wannan adireshin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקוד הזה מכיל את המפתח הפרטי שהוצג במסך הקודם. כל מי שסורק אותו יכול לשלוט בכתובת הזו."
          }
        },
        "hi" : {
