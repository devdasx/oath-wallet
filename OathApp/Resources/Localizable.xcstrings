          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અનેક ચેઇનનું વૉલેટ. ક્રિપ્ટો મોકલો, મેળવો, ચૂકવો અને માગો."
          }
