        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම ගිණුමේ පැවරූ කේතය ඉවත් කරයි. ටෝකන අනුමැති වෙනම පවතී. වත්කම් මාරු නොකරයි; ජාල ගාස්තුවක් අය කෙරේ."
