    "wcFeeDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዋሌቱ ይህን ከፍተኛ ክፍያ ይይዛል። አውታረ መረቡ በእውነት የተጠቀመውን ጋዝ ያስከፍላል። ክፍያዎች ሊቀየሩ ይችላሉ፤ ጊዜው ያለፈ ግምት እንደገና መታየት አለበት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحجز المحفظة هذا الحد الأقصى للرسوم. تفرض الشبكة تكلفة الغاز المستخدم فعليًا. قد تتغير الرسوم؛ ويجب مراجعة التقدير المنتهي مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়ালেট এই সর্বোচ্চ ফি রাখে। নেটওয়ার্ক প্রকৃত ব্যবহৃত গ্যাস কাটে। ফি বদলাতে পারে; মেয়াদ শেষ হওয়া দর আবার পর্যালোচনা করতে হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peněženka rezervuje tento maximální poplatek. Síť účtuje skutečně použitý gas. Poplatky se mohou měnit; odhad po vypršení platnosti je nutné znovu zkontrolovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din wallet reserverer dette maksimale gebyr. Netværket opkræver kun den gas, der faktisk bruges. Gebyrer kan ændre sig; et udløbet gebyroverslag skal gennemgås igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wallet reserviert diese Höchstgebühr. Das Netzwerk berechnet das tatsächlich verbrauchte Gas. Gebühren können sich ändern; abgelaufene Angebote müssen erneut geprüft werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πορτοφόλι δεσμεύει αυτή τη μέγιστη προμήθεια. Το δίκτυο χρεώνει το gas που χρησιμοποιείται πραγματικά. Οι προμήθειες μπορεί να αλλάξουν· μια ληγμένη προσφορά πρέπει να ελεγχθεί ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallet reserves this maximum fee. The network charges the gas actually used. Fees may change; an expired quote must be reviewed again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartera reserva esta comisión máxima. La red cobra el gas realmente utilizado. Las comisiones pueden cambiar; una cotización caducada debe revisarse de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیف پول این حداکثر کارمزد را رزرو می‌کند. شبکه گس واقعاً مصرف‌شده را دریافت می‌کند. کارمزد ممکن است تغییر کند؛ برآورد منقضی‌شده باید دوباره بررسی شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lompakko varaa tämän enimmäismaksun. Verkko veloittaa vain todellisuudessa käytetyn gasin. Maksut voivat muuttua. Vanhentunut arvio on tarkistettava uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inilalaan ng wallet ang pinakamataas na bayad na ito. Aktuwal na nagamit na gas ang sinisingil ng network. Maaaring magbago ang bayad; kailangang suriin muli ang nag-expire na tantiya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le portefeuille réserve ces frais maximaux. Le réseau prélève le gas réellement utilisé. Les frais peuvent changer ; une estimation expirée doit être vérifiée à nouveau."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વૉલેટ આ મહત્તમ ફી અનામત રાખે છે. નેટવર્ક વાસ્તવમાં વપરાયેલા ગૅસનો ચાર્જ લે છે. ફી બદલાઈ શકે છે; મુદત પૂરી થયેલા અંદાજની ફરી સમીક્ષા કરવી જરૂરી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walat yana ware wannan mafi yawan kuɗin caji. Hanyar sadarwa tana cajar gas da aka yi amfani da shi a zahiri. Kuɗin caji na iya canzawa; dole a sake yin bitar kimantawar da ta ƙare."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הארנק שומר סכום עבור העמלה המרבית הזו. הרשת גובה תשלום לפי הגז שנוצל בפועל. העמלות עשויות להשתנות; יש לבדוק מחדש הצעת עמלה שפג תוקפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलेट यह अधिकतम शुल्क आरक्षित करता है। नेटवर्क असल में इस्तेमाल गैस का शुल्क लेता है। शुल्क बदल सकते हैं; समाप्त अनुमान की फिर समीक्षा चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novčanik rezervira ovu najveću naknadu. Mreža naplaćuje stvarno iskorišteni plin. Naknade se mogu mijenjati; isteklu procjenu treba ponovno pregledati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tárca ezt a legmagasabb díjat különíti el. A hálózat a ténylegesen felhasznált gázért számít fel díjat. A díjak változhatnak; a lejárt díjbecslést újra át kell nézned."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet mencadangkan biaya maksimum ini. Jaringan mengenakan gas yang benar-benar digunakan. Biaya dapat berubah; penawaran kedaluwarsa harus ditinjau lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il wallet riserva questa commissione massima. La rete addebita il gas effettivamente usato. Le commissioni possono cambiare; una stima scaduta va esaminata di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォレットはこの上限手数料を確保します。ネットワークは実際のガス使用量を請求します。手数料は変動し、期限切れの見積もりは再確認が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "საფულე ამ მაქსიმალურ საკომისიოს რეზერვში ტოვებს. ქსელი ფაქტობრივად გამოყენებულ გაზს ჩამოჭრის. საკომისიო შეიძლება შეიცვალოს; ვადაგასულ შეფასებას ხელახლა უნდა გადახედოთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កាបូបបម្រុងថ្លៃអតិបរមានេះ។ បណ្ដាញគិតថ្លៃហ្គាសដែលប្រើពិត។ ថ្លៃអាចប្ដូរ ហើយត្រូវពិនិត្យការប៉ាន់តម្លៃផុតកំណត់ម្ដងទៀត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವ್ಯಾಲೆಟ್ ಈ ಗರಿಷ್ಠ ಶುಲ್ಕ ಮೀಸಲಿಡುತ್ತದೆ. ನಿಜವಾಗಿ ಬಳಸಿದ gas ಗೆ ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ವಿಧಿಸುತ್ತದೆ. ಶುಲ್ಕಗಳು ಬದಲಾಗಬಹುದು; ಅವಧಿ ಮುಗಿದ ಅಂದಾಜನ್ನು ಮತ್ತೆ ಪರಿಶೀಲಿಸಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑은 이 최대 수수료를 예약합니다. 네트워크는 실제 사용한 가스만 청구합니다. 수수료는 바뀔 수 있으며 만료된 견적은 다시 검토해야 합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാലറ്റ് ഈ പരമാവധി ഫീസ് കരുതിവയ്ക്കുന്നു. യഥാർത്ഥത്തിൽ ഉപയോഗിച്ച ഗ്യാസിനാണ് നെറ്റ്‌വർക്ക് ചാർജ് ചെയ്യുന്നത്. ഫീസുകൾ മാറാം; കാലാവധി കഴിഞ്ഞ കണക്ക് വീണ്ടും അവലോകനം ചെയ്യണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉलेट हे कमाल शुल्क राखून ठेवते. नेटवर्क प्रत्यक्ष वापरलेला गॅस आकारते. शुल्क बदलू शकते; कालबाह्य अंदाज पुन्हा तपासावा लागतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet merizabkan yuran maksimum ini. Rangkaian mengenakan gas sebenar digunakan. Yuran boleh berubah; sebut harga luput mesti disemak semula."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပိုက်ဆံအိတ်က ဤအများဆုံးအခကြေးငွေကို သီးသန့်ဖယ်ထားသည်။ ကွန်ရက်က အမှန်တကယ်သုံးသော gas ကို ကောက်ခံသည်။ အခကြေးငွေ ပြောင်းနိုင်ပြီး သက်တမ်းကုန်ခန့်မှန်းချက်ကို ပြန်စစ်ရမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lommeboken reserverer dette maksimale gebyret. Nettverket belaster bare gas som faktisk brukes. Gebyrer kan endres. Et utløpt prisanslag må gjennomgås på nytt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वालेटले यो अधिकतम शुल्क आरक्षित गर्छ। नेटवर्कले वास्तवमा प्रयोग भएको ग्यासको शुल्क लिन्छ। शुल्क फेरिन सक्छ; म्याद सकिएको अनुमान फेरि समीक्षा गर्नुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wallet reserveert deze maximale kosten. Het netwerk berekent het werkelijk gebruikte gas. Kosten kunnen veranderen; een verlopen berekening moet opnieuw worden gecontroleerd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ୱାଲେଟ ଏହି ସର୍ବାଧିକ ଶୁଳ୍କ ସଂରକ୍ଷିତ ରଖେ। ନେଟୱର୍କ ପ୍ରକୃତରେ ବ୍ୟବହୃତ gas ପାଇଁ ଶୁଳ୍କ ନିଏ। ଶୁଳ୍କ ବଦଳିପାରେ; ସମୟସୀମା ସରିଥିବା ଆକଳନ ପୁଣି ସମୀକ୍ଷା କରିବା ଆବଶ୍ୟକ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਾਲਿਟ ਇਹ ਵੱਧ ਤੋਂ ਵੱਧ ਫੀਸ ਰਾਖਵੀਂ ਰੱਖਦਾ ਹੈ। ਨੈੱਟਵਰਕ ਅਸਲ ਵਰਤੀ ਗੈਸ ਦਾ ਖ਼ਰਚਾ ਲੈਂਦਾ ਹੈ। ਫੀਸਾਂ ਬਦਲ ਸਕਦੀਆਂ ਹਨ; ਮਿਆਦ ਮੁੱਕੇ ਅੰਦਾਜ਼ੇ ਦੀ ਮੁੜ ਸਮੀਖਿਆ ਲਾਜ਼ਮੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfel rezerwuje tę maksymalną opłatę. Sieć pobiera opłatę za faktycznie zużyty gaz. Opłaty mogą się zmieniać; wygasła wycena wymaga ponownego sprawdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carteira reserva esta taxa máxima. A rede cobra o gás realmente usado. As taxas podem mudar; uma cotação expirada precisa ser revisada novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carteira reserva esta taxa máxima. A rede cobra o gás efetivamente utilizado. As taxas podem mudar; uma cotação expirada tem de ser revista novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portofelul rezervă acest comision maxim. Rețeaua percepe gazul efectiv utilizat. Comisioanele se pot schimba; o estimare expirată trebuie verificată din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кошелёк резервирует эту максимальную комиссию. Сеть списывает фактически использованный газ. Комиссии могут меняться; просроченный расчёт нужно проверить снова."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والٽ هي وڌ ۾ وڌ في مخصوص ڪري ٿو. نيٽ ورڪ واقعي استعمال ٿيل gas جي في وٺي ٿو. فيون بدلجي سگهن ٿيون؛ مدي پوري اندازي جو ٻيهر جائزو ضروري آهي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පසුම්බිය මෙම උපරිම ගාස්තුව වෙන් කරයි. ජාලය සැබවින් භාවිත කළ ගෑස් සඳහා අය කරයි. ගාස්තු වෙනස් විය හැක; කල් ඉකුත් මිල ගණනයක් නැවත සමාලෝචනය කළ යුතුය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peňaženka rezervuje tento maximálny poplatok. Sieť účtuje skutočne použitý gas. Poplatky sa môžu meniť; odhad po vypršaní platnosti je potrebné znova skontrolovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denarnica rezervira to najvišjo provizijo. Omrežje zaračuna dejansko porabljeni plin. Provizije se lahko spremenijo; poteklo oceno je treba znova pregledati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plånboken reserverar denna högsta avgift. Nätverket tar betalt för den gas som faktiskt används. Avgifter kan ändras. En utgången offert måste granskas igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochi hutenga ada hii ya juu. Mtandao hutoza gesi iliyotumika kweli. Ada zinaweza kubadilika; makadirio yaliyopitwa na muda lazima yakaguliwe tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பணப்பை இந்த அதிகபட்சக் கட்டணத்தை ஒதுக்கும். உண்மையில் பயன்படுத்திய gas-க்குப் பிணையம் கட்டணம் வசூலிக்கும். கட்டணங்கள் மாறலாம்; காலாவதியான மதிப்பீட்டை மீண்டும் பரிசீலிக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వాలెట్ ఈ గరిష్ఠ రుసుమును రిజర్వు చేస్తుంది. నెట్‌వర్క్ నిజంగా వాడిన గ్యాస్‌కు వసూలు చేస్తుంది. రుసుములు మారవచ్చు; గడువు ముగిసిన కోట్‌ను మళ్లీ సమీక్షించాలి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระเป๋ากันค่าธรรมเนียมสูงสุดนี้ไว้ เครือข่ายเรียกเก็บตามแก๊สที่ใช้จริง ค่าธรรมเนียมอาจเปลี่ยนแปลง ใบเสนอราคาที่หมดอายุต้องตรวจสอบใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cüzdan bu azami ücreti ayırır. Ağ, gerçekten kullanılan gas için ücret alır. Ücretler değişebilir; süresi dolan fiyatlandırma yeniden incelenmelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гаманець резервує цю максимальну комісію. Мережа стягує плату за фактично використаний газ. Комісії можуть змінюватися; прострочений розрахунок потрібно переглянути знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والیٹ یہ زیادہ سے زیادہ فیس محفوظ کرتا ہے۔ نیٹ ورک اصل استعمال شدہ گیس وصول کرتا ہے۔ فیس بدل سکتی ہے؛ میعاد ختم تخمینہ دوبارہ دیکھنا ضروری ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamyon bu eng yuqori komissiyani zaxiralaydi. Tarmoq amalda ishlatilgan gas uchun oladi. Komissiyalar o‘zgarishi mumkin; muddati tugagan hisob-kitobni qayta ko‘rib chiqish kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví giữ lại mức phí tối đa này. Mạng thu phí theo gas thực tế đã dùng. Phí có thể thay đổi; báo giá hết hạn phải được xem lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àpamọ́wọ́ ń fi owó iṣẹ́ tó pọ̀ jù yìí sílẹ̀. Nẹ́tíwọ́ọ̀kì ń gba owó fún gas tí a lò gan-an. Owó iṣẹ́ lè yí padà; a gbọ́dọ̀ tún ṣàgbéyẹ̀wò ìṣírò tó kọjá àsìkò rẹ̀."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钱包会预留此最高费用。网络按实际使用的 gas 收费。费用可能变化；过期报价必须重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錢包會保留此最高手續費。網路會依實際使用的 gas 收費。手續費可能變動；報價過期後必須重新檢視。"
          }
        }
      }
    },
