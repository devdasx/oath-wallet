    "wcAmbiguousApproval" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ approve ጥሪ ቶከኖችን ወይም አንድ NFT ለማውጣት ፈቃድ ሊሰጥ ይችላል። የቶከኑ መስፈርት ሊረጋገጥ ስላልቻለ፣ ዋጋው እዚህ ሊቀየር አይችልም። ሙሉውን ውልና የግብይት መረጃ እይ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يسمح استدعاء approve هذا برموز أو NFT واحد. تعذر تأكيد معيار الرمز، لذا لا يمكن تعديل قيمته هنا. راجع بيانات العقد والمعاملة كاملة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অনুমোদন কল টোকেন বা একটি NFT এর অনুমতি দিতে পারে। টোকেনের মান নিশ্চিত করা যায়নি, তাই এখানে পরিমাণ বদলানো যাবে না। পূর্ণ কন্ট্র্যাক্ট ও লেনদেনের তথ্য দেখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto volání approve může povolit tokeny nebo jedno NFT. Standard tokenu nelze potvrdit, proto zde nelze upravit jeho hodnotu. Zkontrolujte celý kontrakt a data transakce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette approve-kald kan godkende tokens eller én NFT. Tokenstandarden kunne ikke bekræftes, så værdien kan ikke redigeres her. Gennemgå alle kontrakt- og transaktionsdata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser approve-Aufruf kann Token oder ein NFT freigeben. Der Token-Standard konnte nicht bestätigt werden, daher ist der Wert hier nicht bearbeitbar. Prüfe die vollständigen Vertrags- und Transaktionsdaten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η κλήση approve ενδέχεται να εξουσιοδοτεί token ή ένα NFT. Το πρότυπο token δεν επιβεβαιώθηκε, επομένως η τιμή δεν μπορεί να αλλάξει εδώ. Ελέγξτε το πλήρες συμβόλαιο και τα δεδομένα συναλλαγής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This approve call may authorize tokens or one NFT. The token standard could not be confirmed, so its value cannot be edited here. Review the full contract and transaction data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta llamada approve puede autorizar tokens o un NFT. No se pudo confirmar el estándar del token, por lo que no puedes editar el valor aquí. Revisa todos los datos del contrato y de la transacción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این فراخوانی approve ممکن است مجوز توکن یا یک NFT بدهد. استاندارد توکن تأیید نشد، بنابراین مقدار آن اینجا قابل‌ویرایش نیست. داده‌های کامل قرارداد و تراکنش را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä approve-kutsu voi antaa oikeuden tokeneihin tai yhteen NFT:hen. Tokenstandardia ei voitu vahvistaa, joten arvoa ei voi muokata täällä. Tarkista kaikki sopimus- ja tapahtumatiedot."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring magpahintulot ng mga token o isang NFT ang approve call na ito. Hindi makumpirma ang pamantayan ng token kaya hindi ma-edit dito ang halaga. Suriin ang buong kontrata at datos ng transaksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel approve peut autoriser des jetons ou un NFT. Le standard du jeton n’a pas pu être confirmé ; sa valeur ne peut donc pas être modifiée ici. Vérifiez le contrat complet et les données de transaction."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ મંજૂરી કૉલ ટોકન અથવા એક NFT અધિકૃત કરી શકે છે. ટોકન માનકની ખાતરી થઈ શકી નહીં, તેથી અહીં તેનું મૂલ્ય બદલી શકાતું નથી. સંપૂર્ણ કોન્ટ્રેક્ટ અને વ્યવહાર ડેટા તપાસો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan kiran amincewa na iya ba da izinin token ko NFT guda. Ba a iya tabbatar da matsayin token ba, don haka ba a iya gyara ƙimarsa a nan. Yi bitar cikakkiyar kwangila da bayanan ma'amala."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קריאת approve הזו עשויה לאשר טוקנים או NFT יחיד. לא ניתן לאמת את תקן הטוקן, ולכן לא ניתן לערוך את הערך כאן. יש לבדוק את החוזה המלא ואת נתוני העסקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह approve कॉल टोकन या एक NFT अधिकृत कर सकता है। टोकन मानक की पुष्टि नहीं हुई, इसलिए इसका मान यहाँ बदला नहीं जा सकता। पूरे कॉन्ट्रैक्ट और लेन-देन डेटा की समीक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poziv approve može odobriti tokene ili jedan NFT. Standard tokena nije moguće potvrditi pa se vrijednost ovdje ne može urediti. Pregledajte cijeli ugovor i podatke transakcije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az approve-hívás tokeneket vagy egy NFT-t is engedélyezhet. A tokenszabványt nem sikerült megerősíteni, ezért az értéke itt nem szerkeszthető. Nézd át a teljes szerződést és a tranzakció adatait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan approve ini dapat mengotorisasi token atau satu NFT. Standar token tidak dapat dikonfirmasi sehingga nilainya tidak dapat diedit di sini. Tinjau seluruh data kontrak dan transaksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chiamata di approvazione può autorizzare token o un NFT. Lo standard del token non è stato confermato, quindi il valore non è modificabile qui. Controlla tutti i dati del contratto e della transazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このapprove呼び出しはトークンまたは1つのNFTを承認する可能性があります。規格を確認できなかったため、ここでは値を編集できません。コントラクトと取引データ全体を確認してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ approve გამოძახებამ შესაძლოა ტოკენების ან ერთი NFT-ის უფლება გასცეს. ტოკენის სტანდარტი ვერ დადასტურდა, ამიტომ მნიშვნელობა აქ ვერ შეიცვლება. გადახედეთ სრულ კონტრაქტსა და ტრანზაქციის მონაცემებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការហៅ approve នេះអាចអនុញ្ញាតថូខិន ឬ NFT មួយ។ មិនអាចបញ្ជាក់ស្តង់ដារថូខិន ដូច្នេះមិនអាចកែតម្លៃទីនេះ។ ពិនិត្យកិច្ចសន្យា និងទិន្នន័យប្រតិបត្តិការពេញលេញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
