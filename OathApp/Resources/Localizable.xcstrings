    "multisigXrplPending" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አውታረ መረቡ ይህን ደረጃ እስኪያረጋግጥ በመጠባበቅ ላይ። ከማረጋገጫው በኋላ ቀጣዩን ደረጃ ማከናወን ይቻላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بانتظار تأكيد الشبكة لهذه الخطوة. تتاح الخطوة التالية بعد التأكيد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নেটওয়ার্কে এই ধাপের নিশ্চিতকরণের অপেক্ষায়। নিশ্চিত হওয়ার পরে পরবর্তী ধাপ উপলব্ধ হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká se na potvrzení tohoto kroku sítí. Další krok bude dostupný po potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afventer netværkets bekræftelse af dette trin. Det næste trin bliver tilgængeligt efter bekræftelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkbestätigung für diesen Schritt steht noch aus. Der nächste Schritt ist nach der Bestätigung verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμένεται επιβεβαίωση αυτού του βήματος από το δίκτυο. Το επόμενο βήμα γίνεται διαθέσιμο μετά την επιβεβαίωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for the network to confirm this step. The next step becomes available after confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando que la red confirme este paso. El siguiente paso estará disponible después de la confirmación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در انتظار تأیید این مرحله توسط شبکه. پس از تأیید، مرحلهٔ بعدی در دسترس قرار می‌گیرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan, että verkko vahvistaa tämän vaiheen. Seuraava vaihe tulee saataville vahvistuksen jälkeen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naghihintay na kumpirmahin ng network ang hakbang na ito. Magiging available ang susunod na hakbang pagkatapos makumpirma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de confirmation de cette étape par le réseau. L’étape suivante sera disponible après confirmation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નેટવર્ક આ પગલાની પુષ્ટિ કરે તેની રાહ જોવાઈ રહી છે. પુષ્ટિ પછી આગળનું પગલું ઉપલબ્ધ થશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana jiran hanyar sadarwar ta tabbatar da wannan matakin. Mataki na gaba zai samu bayan tabbatarwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממתינים לאישור הרשת לשלב זה. השלב הבא יהיה זמין לאחר האישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क द्वारा इस चरण की पुष्टि की प्रतीक्षा है। पुष्टि के बाद अगला चरण उपलब्ध होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeka se potvrda mreže za ovaj korak. Sljedeći korak postaje dostupan nakon potvrde."
