        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი დამტკიცებული ხელმოწერა dApp-ს დაუბრუნდა. მხოლოდ ხელმოწერა გადარიცხვას არ ადასტურებს."
