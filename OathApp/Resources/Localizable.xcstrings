        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgiften tas från ditt återstående saldo. Om det inte räcker dras den från beloppet. Granska det exakta beloppet och avgiften innan du skickar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada hutoka kwenye salio lako lililobaki. Lisipotosha, hukatwa kwenye kiasi. Kagua kiasi kamili na ada kabla ya kutuma."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கட்டணம் மீதமுள்ள இருப்பிலிருந்து எடுக்கப்படும். அது போதவில்லை என்றால் அனுப்பும் தொகையிலிருந்து கழிக்கப்படும். அனுப்பும் முன் சரியான தொகையையும் கட்டணத்தையும் பரிசீலிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రుసుము మీ మిగిలిన నిల్వ నుంచి వస్తుంది. అది సరిపోకపోతే మొత్తం నుంచి తీసివేయబడుతుంది. పంపే ముందు ఖచ్చితమైన మొత్తం, రుసుమును సమీక్షించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าธรรมเนียมหักจากยอดที่เหลือ หากไม่พอจะหักจากจำนวนที่จะส่ง ตรวจสอบจำนวนและค่าธรรมเนียมที่แน่นอนก่อนส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücret kalan bakiyenizden karşılanır. Yeterli değilse gönderim tutarından düşülür. Göndermeden önce kesin tutarı ve ücreti inceleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комісія сплачується із залишку балансу. Якщо його недостатньо, вона віднімається від суми. Перед надсиланням перевірте точну суму й комісію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فیس آپ کے باقی بیلنس سے آتی ہے۔ ناکافی ہو تو رقم سے کاٹی جاتی ہے۔ بھیجنے سے پہلے عین رقم اور فیس دیکھیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komissiya qolgan balansingizdan olinadi. U yetmasa, miqdordan chegiriladi. Yuborishdan oldin aniq miqdor va komissiyani tekshiring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phí được lấy từ số dư còn lại. Nếu không đủ, phí được trừ vào số tiền gửi. Xem lại số tiền và phí chính xác trước khi gửi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owó iṣẹ́ wá láti ìyókù rẹ tó kù. Bí kò bá tó, a ó yọ ọ́ kúrò nínú iye náà. Ṣàgbéyẹ̀wò iye àti owó iṣẹ́ gan-an kí o tó firánṣẹ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手续费从剩余余额中扣除。如果不足，则从转账金额中扣除。发送前请核对准确金额及手续费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手續費會從剩餘餘額支付。若不足，則會從傳送金額中扣除。傳送前請檢視確切金額與手續費。"
          }
        }
      }
    },
