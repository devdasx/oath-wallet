    "receive.aptos_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የ%@ መለያህ ተስማሚ ተተኪ ንብረቶችን በዚህ አድራሻ መቀበል ይችላል። ላኪው ትክክለኛውን የንብረት ዓይነት መጠቀም አለበት፤ አንዳንድ የቆዩ የሳንቲም ዓይነቶች ከመቀበል በፊት ምዝገባ ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لحساب %@ لديك استلام أصول متوافقة قابلة للاستبدال على هذا العنوان. يجب أن يستخدم المرسل نوع الأصل الصحيح؛ فبعض أنواع العملات الأقدم تتطلب التسجيل قبل الاستلام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার %@ অ্যাকাউন্ট এই ঠিকানায় উপযুক্ত বিনিময়যোগ্য সম্পদ গ্রহণ করতে পারে। প্রেরককে সঠিক সম্পদের ধরন ব্যবহার করতে হবে; পুরোনো কিছু কয়েনের ধরনে গ্রহণের আগে নিবন্ধন লাগে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet %@ může na tuto adresu přijímat kompatibilní zastupitelná aktiva. Odesílatel musí použít správný typ aktiva; některé starší typy mincí vyžadují před přijetím registraci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto på %@ kan modtage kompatible fungible aktiver på denne adresse. Afsenderen skal bruge den korrekte aktivtype; nogle ældre mønttyper kræver registrering før modtagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@-Konto kann kompatible fungible Vermögenswerte an dieser Adresse empfangen. Der Absender muss den richtigen Vermögenswerttyp verwenden; manche älteren Coin-Typen erfordern vor dem Empfang eine Registrierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός σας %@ μπορεί να λαμβάνει συμβατά ανταλλάξιμα στοιχεία σε αυτή τη διεύθυνση. Ο αποστολέας πρέπει να χρησιμοποιεί τον σωστό τύπο στοιχείου· ορισμένοι παλαιότεροι τύποι νομισμάτων απαιτούν εγγραφή πριν από τη λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your %@ account can receive compatible fungible assets at this address. The sender must use the correct asset type; some older coin types require registration before receiving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta %@ puede recibir activos fungibles compatibles en esta dirección. El remitente debe usar el tipo de activo correcto; algunos tipos de moneda antiguos requieren registrarse antes de recibir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب %@ شما می‌تواند دارایی‌های تعویض‌پذیر سازگار را در این نشانی دریافت کند. فرستنده باید از نوع درست دارایی استفاده کند؛ برخی انواع قدیمی کوین پیش از دریافت به ثبت نیاز دارند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi verkossa %@ voi vastaanottaa tähän osoitteeseen yhteensopivia vaihdettavia varoja. Lähettäjän on käytettävä oikeaa varatyyppiä. Jotkin vanhemmat kolikkotyypit vaativat rekisteröinnin ennen vastaanottamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makakatanggap ang %@ account mo ng mga katugmang fungible asset sa address na ito. Dapat gamitin ng nagpapadala ang tamang uri ng asset; kailangang irehistro muna ang ilang mas lumang uri ng coin bago makatanggap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte %@ peut recevoir des actifs fongibles compatibles à cette adresse. L’expéditeur doit utiliser le bon type d’actif ; certains anciens types de monnaies nécessitent une inscription avant réception."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું %@ ખાતું આ સરનામે સુસંગત પરસ્પર વિનિમયક્ષમ સંપત્તિઓ મેળવી શકે છે. મોકલનારે સાચો સંપત્તિ પ્રકાર વાપરવો જરૂરી છે; કેટલાક જૂના સિક્કા પ્રકારો મેળવતાં પહેલાં નોંધણી માગે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asusunka na %@ zai iya karɓar kadarori masu musanyawa da suka dace a wannan adireshin. Dole mai aikawa ya yi amfani da nau'in kadara daidai; wasu tsofaffin nau'in tsaba suna buƙatar rijista kafin karɓa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבון %@ שלך יכול לקבל נכסים חליפיים תואמים בכתובת הזו. על השולח להשתמש בסוג הנכס הנכון; סוגי מטבעות ישנים מסוימים דורשים רישום לפני קבלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
