    "wcSwitchNetworkDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ለዚህ ግንኙነት አውታረ መረቡን ይቀይራል። ገንዘብ አያዘዋውርም። ቀደም ሲል ለሌላ አውታረ መረብ የቀረቡ ጥያቄዎች ይሰረዛሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر الشبكة لهذا الاتصال. لا ينقل أي أموال. ستُلغى الطلبات السابقة لشبكة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সংযোগের নেটওয়ার্ক বদলায়। অর্থ সরায় না। অন্য নেটওয়ার্কের আগের অনুরোধ বাতিল হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se změní síť tohoto připojení. Žádné prostředky se nepřesunou. Dřívější požadavky pro jinou síť budou zrušeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette ændrer netværket for denne forbindelse. Det flytter ingen midler. Tidligere anmodninger til et andet netværk annulleres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ändert das Netzwerk dieser Verbindung und verschiebt kein Guthaben. Frühere Anfragen für andere Netzwerke werden abgebrochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό αλλάζει το δίκτυο για αυτή τη σύνδεση. Δεν μετακινεί χρήματα. Προηγούμενα αιτήματα για άλλο δίκτυο θα ακυρωθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This changes the network for this connection. It does not move any funds. Earlier requests for another network will be cancelled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la red de esta conexión. No mueve fondos. Se cancelarán las solicitudes anteriores de otra red."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبکهٔ این اتصال را تغییر می‌دهد. دارایی‌ای جابه‌جا نمی‌شود. درخواست‌های قبلی برای شبکهٔ دیگر لغو می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vaihtaa tämän yhteyden verkon. Se ei siirrä varoja. Aiemmat toisen verkon pyynnöt perutaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapalitan nito ang network para sa koneksyon. Walang pondong inililipat. Kakanselahin ang mga naunang kahilingan para sa ibang network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change le réseau de cette connexion. Aucun fonds n’est déplacé. Les demandes précédentes pour un autre réseau seront annulées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ આ કનેક્શનનું નેટવર્ક બદલે છે. કોઈ ભંડોળ ખસેડતું નથી. બીજા નેટવર્કની અગાઉની વિનંતીઓ રદ થશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan yana sauya hanyar sadarwa ga wannan haɗin. Ba ya motsa kuɗi. Za a soke buƙatun baya na wata hanyar sadarwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעולה משנה את הרשת של החיבור הזה. היא אינה מעבירה כספים. בקשות קודמות עבור רשת אחרת יבוטלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इस कनेक्शन का नेटवर्क बदलता है। कोई धन नहीं जाता। दूसरे नेटवर्क के पिछले अनुरोध रद्द हो जाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se mijenja mreža za ovu vezu. Sredstva se ne premještaju. Raniji zahtjevi za drugu mrežu bit će otkazani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kapcsolat hálózatát módosítja. Nem mozgat pénzeszközöket. A másik hálózathoz tartozó korábbi kérések törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mengubah jaringan untuk koneksi ini. Dana tidak berpindah. Permintaan sebelumnya untuk jaringan lain akan dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la rete di questa connessione. Non sposta fondi. Le richieste precedenti per un'altra rete verranno annullate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続のネットワークを変更します。資金は移動しません。別のネットワークへの以前のリクエストはキャンセルされます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ამ კავშირის ქსელს ცვლის. თანხები არ გადაადგილდება. სხვა ქსელისთვის ადრინდელი მოთხოვნები გაუქმდება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "វាប្ដូរបណ្ដាញសម្រាប់ការតភ្ជាប់នេះ។ មិនផ្លាស់ទីប្រាក់ទេ។ សំណើមុនសម្រាប់បណ្ដាញផ្សេងនឹងត្រូវបោះបង់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಈ ಸಂಪರ್ಕದ ನೆಟ್‌ವರ್ಕ್ ಬದಲಿಸುತ್ತದೆ. ಯಾವುದೇ ಹಣ ಸ್ಥಳಾಂತರಿಸುವುದಿಲ್ಲ. ಬೇರೆ ನೆಟ್‌ವರ್ಕ್‌ಗಾಗಿ ಹಿಂದಿನ ವಿನಂತಿಗಳನ್ನು ರದ್ದುಮಾಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결의 네트워크를 변경합니다. 자금은 이동하지 않습니다. 다른 네트워크의 이전 요청은 취소됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ കണക്ഷന്റെ നെറ്റ്‌വർക്ക് മാറ്റുന്നു. പണമൊന്നും നീക്കുന്നില്ല. മറ്റൊരു നെറ്റ്‌വർക്കിനുള്ള മുൻ അഭ്യർത്ഥനകൾ റദ്ദാക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे या कनेक्शनचे नेटवर्क बदलते. निधी हलत नाही. दुसऱ्या नेटवर्कच्या आधीच्या विनंत्या रद्द होतील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menukar rangkaian sambungan ini. Ia tidak memindahkan dana. Permintaan terdahulu bagi rangkaian lain dibatalkan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤချိတ်ဆက်မှုအတွက် ကွန်ရက်ကို ပြောင်းသည်။ ငွေမရွှေ့ပါ။ အခြားကွန်ရက်အတွက် ယခင်တောင်းဆိုချက်များကို ပယ်ဖျက်မည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette endrer nettverket for denne tilkoblingen. Det flytter ingen midler. Tidligere forespørsler for et annet nettverk blir kansellert."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले यो जडानको नेटवर्क फेर्छ। रकम सार्दैन। अर्को नेटवर्कका अघिल्ला अनुरोध रद्द हुन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit wijzigt het netwerk voor deze verbinding. Er wordt geen geld verplaatst. Eerdere verzoeken voor een ander netwerk worden geannuleerd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଏହି ସଂଯୋଗର ନେଟୱର୍କ ବଦଳାଏ। କୌଣସି ଅର୍ଥ ସ୍ଥାନାନ୍ତର କରେ ନାହିଁ। ଅନ୍ୟ ନେଟୱର୍କ ପାଇଁ ପୂର୍ବ ଅନୁରୋଧ ବାତିଲ ହେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਇਸ ਕਨੈਕਸ਼ਨ ਦਾ ਨੈੱਟਵਰਕ ਬਦਲਦਾ ਹੈ। ਕੋਈ ਫੰਡ ਨਹੀਂ ਹਿਲਦੇ। ਹੋਰ ਨੈੱਟਵਰਕ ਦੀਆਂ ਪਿਛਲੀਆਂ ਬੇਨਤੀਆਂ ਰੱਦ ਹੋਣਗੀਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienia sieć tego połączenia. Nie przenosi żadnych środków. Wcześniejsze żądania dla innej sieci zostaną anulowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso altera a rede desta conexão. Não move fundos. Solicitações anteriores de outra rede serão canceladas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação altera a rede desta ligação. Não move fundos. Os pedidos anteriores para outra rede serão cancelados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă rețeaua pentru această conexiune. Nu mută fonduri. Cererile anterioare pentru altă rețea vor fi anulate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяет сеть этого подключения. Средства не перемещаются. Предыдущие запросы для другой сети будут отменены."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي هن ڪنيڪشن جو نيٽ ورڪ بدلائي ٿو. ڪا رقم منتقل نٿو ڪري. ٻئي نيٽ ورڪ جون اڳيون درخواستون رد ٿينديون."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙය සම්බන්ධතාවේ ජාලය වෙනස් කරයි. මුදල් මාරු නොකරයි. වෙනත් ජාලයක පෙර ඉල්ලීම් අවලංගු වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tým sa zmení sieť tohto pripojenia. Žiadne prostriedky sa nepresunú. Skoršie požiadavky pre inú sieť budú zrušené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To spremeni omrežje za to povezavo. Ne premakne sredstev. Prejšnje zahteve za drugo omrežje bodo preklicane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta ändrar nätverket för anslutningen. Inga medel flyttas. Tidigare förfrågningar för ett annat nätverk avbryts."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hii hubadilisha mtandao wa muunganisho huu. Haihamishi fedha zozote. Maombi ya awali ya mtandao mwingine yataghairiwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது இந்த இணைப்பிற்கான பிணையத்தை மாற்றும். நிதியை நகர்த்தாது. வேறொரு பிணையத்திற்கான முந்தைய கோரிக்கைகள் ரத்துசெய்யப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది ఈ కనెక్షన్ నెట్‌వర్క్‌ను మారుస్తుంది. నిధులు తరలించదు. వేరే నెట్‌వర్క్‌కు మునుపటి అభ్యర్థనలు రద్దవుతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเครือข่ายของการเชื่อมต่อนี้ ไม่ย้ายเงินใดๆ คำขอก่อนหน้าสำหรับเครือข่ายอื่นจะถูกยกเลิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem bu bağlantının ağını değiştirir. Fonları taşımaz. Başka bir ağ için önceki istekler iptal edilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінює мережу для цього підключення. Кошти не переміщуються. Попередні запити для іншої мережі буде скасовано."
          }
