        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ሁለቱንም መልሶ ማግኛ ቁልፎች በመጠቀም ባለሁለት ደረጃ ማረጋገጫ የElectrum ቦርሳዎን ይመልሳል። Oath ያለ TrustedCoin ወይም የእሱ የሁለት ደረጃ ፈቃድ በመሣሪያው ላይ ይፈርማል። Bitcoin ብቻ ይመለሳል።"
