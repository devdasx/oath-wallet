          "stringUnit" : {
            "state" : "translated",
            "value" : "या साइन-इनमध्ये मागितलेली संसाधने आहेत. त्यांची व्याप्ती तपासण्यासाठी पूर्ण संदेश वाचा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk ini menyertakan sumber yang diminta. Baca mesej penuh untuk menyemak skopnya."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤဝင်ရောက်မှုတွင် တောင်းခံထားသော ရင်းမြစ်များ ပါဝင်သည်။ ၎င်းတို့၏ အကျုံးဝင်မှုကို ပြန်စစ်ရန် စာအပြည့် ဖတ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innloggingen omfatter forespurte ressurser. Les hele meldingen for å gjennomgå omfanget."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो साइन इनमा मागिएका स्रोत समावेश छन्। तिनको दायरा समीक्षा गर्न पूरा सन्देश पढ्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze aanmelding bevat aangevraagde bronnen. Lees het volledige bericht om hun reikwijdte te controleren."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ସାଇନ୍ ଇନ୍‌ରେ ଅନୁରୋଧ ହୋଇଥିବା ସମ୍ପଦ ସାମିଲ ଅଛି। ତାହାର ପରିସର ସମୀକ୍ଷା ପାଇଁ ସମ୍ପୂର୍ଣ୍ଣ ବାର୍ତ୍ତା ପଢ଼ନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਸਾਈਨ-ਇਨ ਵਿੱਚ ਮੰਗੇ ਸਰੋਤ ਸ਼ਾਮਲ ਹਨ। ਉਹਨਾਂ ਦਾ ਦਾਇਰਾ ਜਾਂਚਣ ਲਈ ਪੂਰਾ ਸੁਨੇਹਾ ਪੜ੍ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To logowanie obejmuje żądane zasoby. Przeczytaj całą wiadomość, aby sprawdzić ich zakres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este acesso inclui recursos solicitados. Leia a mensagem completa para conferir o alcance deles."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este início de sessão inclui recursos pedidos. Leia a mensagem completa para rever o seu alcance."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această autentificare include resurse solicitate. Citește mesajul complet pentru a le verifica domeniul de aplicare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход включает запрошенные ресурсы. Прочитайте полное сообщение, чтобы проверить их область действия."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هن داخلا ۾ گهربل وسيلا شامل آهن. سندن دائرو ڏسڻ لاءِ پورو پيغام پڙهو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම පිවිසීමට ඉල්ලූ සම්පත් ඇතුළත්ය. ඒවායේ පරාසය බැලීමට සම්පූර්ණ පණිවිඩය කියවන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto prihlásenie obsahuje požadované zdroje. Prečítajte celú správu a skontrolujte ich rozsah."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prijava vključuje zahtevane vire. Za pregled njihovega obsega preberite celotno sporočilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna inloggning omfattar begärda resurser. Läs hela meddelandet för att granska omfattningen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuingia huku kunajumuisha rasilimali zilizoombwa. Soma ujumbe mzima kukagua upeo wake."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த உள்நுழைவில் கோரப்பட்ட வளங்கள் உள்ளன. அவற்றின் வரம்பைப் பரிசீலிக்க முழுச் செய்தியையும் படிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ సైన్ ఇన్‌లో అభ్యర్థించిన వనరులు ఉన్నాయి. వాటి పరిధిని సమీక్షించడానికి పూర్తి సందేశం చదవండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงชื่อเข้านี้รวมทรัพยากรที่ร้องขอ อ่านข้อความทั้งหมดเพื่อตรวจสอบขอบเขต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu giriş, talep edilen kaynakları içerir. Kapsamlarını incelemek için mesajın tamamını okuyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей вхід включає запитані ресурси. Прочитайте повне повідомлення, щоб перевірити їхнє охоплення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس سائن ان میں درخواست کردہ وسائل شامل ہیں۔ ان کے دائرے کا جائزہ لینے کو مکمل پیغام پڑھیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kirish so‘ralgan resurslarni o‘z ichiga oladi. Qamrovini ko‘rish uchun to‘liq xabarni o‘qing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần đăng nhập này bao gồm các tài nguyên được yêu cầu. Đọc toàn bộ thông điệp để xem phạm vi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ìwọlé yìí ní àwọn ohun àmúṣọrọ̀ tí a béèrè. Ka gbogbo ọ̀rọ̀ láti ṣàgbéyẹ̀wò ààlà wọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登录包含请求的资源。请阅读完整消息以检查其范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登入包含請求的資源。請閱讀完整訊息以檢視其範圍。"
          }
        }
      }
    },
