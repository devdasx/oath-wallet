    "multisigSolanaTransferFeeDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath የአውታረ መረብ ክፍያዎችን እና የሐሳብ ማከማቻን ለመክፈል በቂ SOL ያለውን ፈራሚ በራስ-ሰር ይመርጣል። የቶከን መለያ ተቀማጮች ሲያስፈልጉ ከማከማቻው ይወጣሉ። Oath እነዚህን መጠኖች አይሰበስብም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختار Oath تلقائيًا أحد الموقّعين الذي يملك ما يكفي من SOL لدفع رسوم الشبكة وتخزين المقترح. وتُدفع ودائع حسابات الرموز، عند الحاجة، من الخزنة. لا تحصل Oath على هذه المبالغ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath স্বয়ংক্রিয়ভাবে এমন একজন স্বাক্ষরকারীকে বেছে নেয় যার কাছে নেটওয়ার্ক ফি ও প্রস্তাব সংরক্ষণের জন্য পর্যাপ্ত SOL আছে। প্রয়োজন হলে টোকেন অ্যাকাউন্টের জামানত ভল্ট থেকে দেওয়া হয়। Oath এই অর্থ নেয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath automaticky vybere podepisujícího s dostatkem SOL na síťové poplatky a úložiště návrhu. Případné zálohy na tokenové účty se hradí z trezoru. Oath tyto částky nevybírá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath vælger automatisk en underskriver med nok SOL til netværksgebyrer og lagring af forslaget. Depositummer til tokenkonti betales fra boksen, når det er nødvendigt. Oath modtager ikke disse beløb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath wählt automatisch einen Unterzeichner mit genügend SOL aus, um Netzwerkgebühren und Vorschlagsspeicher zu bezahlen. Bei Bedarf werden Kautionen für Token-Konten aus dem Tresor bezahlt. Oath zieht diese Beträge nicht ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Oath επιλέγει αυτόματα έναν υπογράφοντα με αρκετό SOL για τις προμήθειες δικτύου και την αποθήκευση της πρότασης. Οι εγγυήσεις για λογαριασμούς token, όταν απαιτούνται, καλύπτονται από το θησαυροφυλάκιο. Το Oath δεν εισπράττει αυτά τα ποσά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath automatically selects a signer with enough SOL to pay network fees and proposal storage. Token-account deposits, when needed, come from the vault. Oath does not collect these amounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath selecciona automáticamente a un firmante con suficiente SOL para pagar las comisiones de red y el almacenamiento de propuestas. Los depósitos de las cuentas de tokens, cuando sean necesarios, salen de la bóveda. Oath no cobra estos importes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath به‌طور خودکار امضاکننده‌ای را انتخاب می‌کند که SOL کافی برای کارمزد شبکه و ذخیره‌سازی پیشنهاد داشته باشد. سپردهٔ حساب‌های توکن، در صورت نیاز، از خزانه پرداخت می‌شود. Oath این مبالغ را دریافت نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath valitsee automaattisesti allekirjoittajan, jolla on riittävästi SOL-kolikoita verkkomaksuihin ja ehdotuksen tallennukseen. Tarvittavat token-tilien talletukset maksetaan holvista. Oath ei peri näitä summia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awtomatikong pumipili ang Oath ng lumalagda na may sapat na SOL para bayaran ang mga bayarin sa network at imbakan ng panukala. Mula sa vault kinukuha ang mga deposito para sa token account kapag kailangan. Hindi kinokolekta ng Oath ang mga halagang ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath sélectionne automatiquement un signataire disposant de suffisamment de SOL pour payer les frais de réseau et le stockage des propositions. Les dépôts pour les comptes de jetons, lorsqu’ils sont nécessaires, proviennent du coffre. Oath ne perçoit pas ces montants."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નેટવર્ક ફી અને પ્રસ્તાવના સંગ્રહ માટે પૂરતું SOL ધરાવતા હસ્તાક્ષરકર્તાને Oath આપમેળે પસંદ કરે છે. જરૂર હોય ત્યારે ટોકન ખાતાની ડિપૉઝિટ તિજોરીમાંથી ચૂકવાય છે. Oath આ રકમો વસૂલતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath yana zaɓar mai sa hannu da ke da isasshen SOL don biyan kuɗin hanyar sadarwa da ajiyar shawarar mu'amala da kansa. Kuɗin ajiyar asusun token, idan ana buƙata, yana fitowa daga ma'ajiyar kadarori. Oath ba ya karɓar waɗannan kuɗaɗe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath בוחר אוטומטית חותם שיש לו מספיק SOL לתשלום עמלות רשת ואחסון הצעות. פיקדונות לחשבונות אסימונים, במידת הצורך, משולמים מהכספת. Oath אינו גובה את הסכומים האלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ऐसे हस्ताक्षरकर्ता को अपने आप चुनता है जिसके पास नेटवर्क शुल्क और प्रस्ताव के संग्रहण के लिए पर्याप्त SOL हो। ज़रूरत पड़ने पर टोकन खाते की जमा राशि वॉल्ट से दी जाती है। Oath ये राशियाँ नहीं लेता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath automatski odabire potpisnika s dovoljno SOL za mrežne naknade i pohranu prijedloga. Polozi za račune tokena, kada su potrebni, plaćaju se iz trezora. Oath ne prima te iznose."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Oath automatikusan olyan aláírót választ, akinek elegendő SOL áll rendelkezésére a hálózati díjakhoz és a javaslat tárolásához. A tokenszámlák letétei szükség esetén a trezorból származnak. Ezeket az összegeket nem az Oath kapja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath otomatis memilih penanda tangan yang memiliki cukup SOL untuk membayar biaya jaringan dan penyimpanan usulan. Deposit akun token, jika diperlukan, diambil dari brankas. Oath tidak memungut dana ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath seleziona automaticamente un firmatario con SOL sufficienti per pagare le commissioni di rete e l’archiviazione della proposta. I depositi per gli account dei token, quando necessari, vengono prelevati dalla cassaforte. Oath non riscuote questi importi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath は、ネットワーク手数料と提案のストレージ費用に足りる SOL を持つ署名者を自動で選択します。トークンアカウントの預託金が必要な場合は、保管庫から支払われます。Oath がこれらの金額を受け取ることはありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ავტომატურად ირჩევს ხელმომწერს, რომელსაც ქსელის საკომისიოებისა და წინადადების შენახვისთვის საკმარისი SOL აქვს. საჭიროების შემთხვევაში ტოკენის ანგარიშის დეპოზიტი საცავიდან იფარება. Oath ამ თანხებს არ იღებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ជ្រើសអ្នកចុះហត្ថលេខាដែលមាន SOL គ្រប់គ្រាន់សម្រាប់ថ្លៃបណ្តាញ និងទំហំផ្ទុកសំណើដោយស្វ័យប្រវត្តិ។ ប្រាក់កក់គណនីថូខិន បើត្រូវការ ត្រូវយកពីឃ្លាំងទ្រព្យ។ Oath មិនប្រមូលប្រាក់ទាំងនេះទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ಮತ್ತು ಪ್ರಸ್ತಾವನೆ ಸಂಗ್ರಹಣೆಗೆ ಸಾಕಷ್ಟು SOL ಇರುವ ಸಹಿದಾರರನ್ನು Oath ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಆಯ್ಕೆಮಾಡುತ್ತದೆ. ಅಗತ್ಯವಿದ್ದಾಗ ಟೋಕನ್ ಖಾತೆಯ ಠೇವಣಿಗಳನ್ನು ವಾಲ್ಟ್‌ನಿಂದ ಪಾವತಿಸಲಾಗುತ್ತದೆ. Oath ಈ ಮೊತ್ತಗಳನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath는 네트워크 수수료와 제안 저장 공간을 지불할 만큼 SOL이 있는 서명자를 자동으로 선택합니다. 토큰 계정 예치금이 필요할 경우 금고에서 지급됩니다. Oath는 이 금액을 수취하지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നെറ്റ്‌വർക്ക് ഫീസും നിർദേശ സംഭരണച്ചെലവും അടയ്ക്കാൻ മതിയായ SOL ഉള്ള ഒപ്പിടുന്നയാളെ Oath സ്വയമേവ തിരഞ്ഞെടുക്കുന്നു. ടോക്കൺ അക്കൗണ്ട് നിക്ഷേപങ്ങൾ ആവശ്യമായാൽ സുരക്ഷാഭണ്ഡാരത്തിൽ നിന്ന് എടുക്കും. Oath ഈ തുകകൾ ഈടാക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क आणि प्रस्तावाची साठवणूक भरण्यासाठी पुरेसे SOL असलेला स्वाक्षरीकर्ता Oath आपोआप निवडते. गरज असल्यास टोकन खात्यांच्या ठेवी तिजोरीतून भरल्या जातात. Oath या रकमा गोळा करत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath memilih penandatangan yang mempunyai SOL yang mencukupi secara automatik untuk membayar yuran rangkaian dan storan cadangan. Deposit akaun token, jika diperlukan, diambil daripada peti simpanan. Oath tidak memungut jumlah ini."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကွန်ရက်အခကြေးငွေနှင့် အဆိုပြုချက်သိုလှောင်မှုအတွက် SOL လုံလောက်သော လက်မှတ်ထိုးသူကို Oath က အလိုအလျောက်ရွေးသည်။ တိုကင်အကောင့်အာမခံအပ်ငွေ လိုအပ်လျှင် သိုလှောင်ခန်းမှ ပေးသည်။ Oath က ဤငွေပမာဏများကို မကောက်ခံပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath velger automatisk en signatar med nok SOL til nettverksgebyrer og lagring av forslag. Eventuelle depositumer for tokenkontoer tas fra hvelvet. Oath mottar ikke disse beløpene."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क र प्रस्ताव भण्डारण तिर्न पर्याप्त SOL भएको हस्ताक्षरकर्ता Oath ले स्वतः छान्छ। आवश्यक हुँदा टोकन खाताका धरौटीहरू भल्टबाट तिरिन्छन्। Oath ले यी रकमहरू लिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath selecteert automatisch een ondertekenaar met voldoende SOL voor de netwerkkosten en de opslag van het voorstel. Waarborgen voor tokenaccounts worden indien nodig uit de kluis betaald. Oath ontvangt deze bedragen niet."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନେଟୱର୍କ ଶୁଳ୍କ ଓ ପ୍ରସ୍ତାବ ଷ୍ଟୋରେଜ୍ ପୈଠ କରିବାକୁ ଯଥେଷ୍ଟ SOL ଥିବା ଜଣେ ସ୍ୱାକ୍ଷରକାରୀଙ୍କୁ Oath ସ୍ୱୟଂଚାଳିତ ଭାବେ ବାଛେ। ଆବଶ୍ୟକ ହେଲେ ଟୋକେନ ଖାତାର ଜମା ଭଲ୍ଟରୁ ଦିଆଯାଏ। Oath ଏହି ରାଶି ନିଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ਨੈੱਟਵਰਕ ਫੀਸ ਅਤੇ ਪ੍ਰਸਤਾਵ ਸਟੋਰੇਜ ਭਰਨ ਲਈ ਕਾਫ਼ੀ SOL ਵਾਲਾ ਦਸਤਖ਼ਤਕਰਤਾ ਆਪਣੇ ਆਪ ਚੁਣਦਾ ਹੈ। ਲੋੜ ਪੈਣ ਉੱਤੇ ਟੋਕਨ ਖਾਤੇ ਦੀਆਂ ਜਮ੍ਹਾਂ ਰਕਮਾਂ ਤਿਜੋਰੀ ਵਿੱਚੋਂ ਆਉਂਦੀਆਂ ਹਨ। Oath ਇਹ ਰਕਮਾਂ ਨਹੀਂ ਲੈਂਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath automatycznie wybiera podpisującego z wystarczającą ilością SOL na opłaty sieciowe i przechowywanie propozycji. Depozyty za konta tokenów są w razie potrzeby pokrywane ze skarbca. Oath nie pobiera tych kwot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath seleciona automaticamente um signatário com SOL suficiente para pagar as taxas de rede e o armazenamento da proposta. Os depósitos para contas de tokens, quando necessários, saem do cofre. Oath não recebe esses valores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath seleciona automaticamente um signatário com SOL suficiente para pagar as taxas de rede e o armazenamento da proposta. Os depósitos para contas de tokens, quando necessários, saem do cofre. Oath não recebe estes valores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath selectează automat un semnatar cu suficient SOL pentru a plăti comisioanele de rețea și stocarea propunerii. Depozitele pentru conturile de tokenuri, când sunt necesare, provin din seif. Oath nu încasează aceste sume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath автоматически выбирает подписанта, у которого достаточно SOL для оплаты комиссий сети и хранения предложения. При необходимости залог за токен-аккаунты списывается из хранилища. Oath не получает эти средства."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath پاڻمرادو اهڙو صحيح ڪندڙ چونڊي ٿو جنهن وٽ نيٽ ورڪ فيسن ۽ تجويز جي اسٽوريج لاءِ ڪافي SOL هجي. ٽوڪن اڪائونٽ جون جمع رقمون، ضرورت پوڻ تي، خزاني مان ادا ٿين ٿيون. Oath اهي رقمون وصول نٿو ڪري."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ජාල ගාස්තු සහ යෝජනා ගබඩාව සඳහා ගෙවීමට ප්‍රමාණවත් SOL ඇති අත්සන්කරුවෙකු Oath ස්වයංක්‍රීයව තෝරයි. අවශ්‍ය වූ විට ටෝකන ගිණුම් තැන්පතු සේප්පුවෙන් ලබාගනී. Oath මෙම මුදල් ලබා නොගනී."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath automaticky vyberie podpisujúceho s dostatkom SOL na sieťové poplatky a úložisko návrhu. Prípadné zálohy na tokenové účty sa hradia z trezoru. Oath tieto sumy nevyberá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath samodejno izbere podpisnika z dovolj SOL za omrežne provizije in hrambo predloga. Pologi za račune žetonov se po potrebi plačajo iz trezorja. Oath teh zneskov ne prejme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath väljer automatiskt en undertecknare med tillräckligt med SOL för att betala nätverksavgifterna och lagringen av förslaget. Depositioner för tokenkonton tas vid behov från valvet. Oath tar inte emot dessa belopp."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath huchagua kiotomatiki mtia sahihi mwenye SOL ya kutosha kulipia ada za mtandao na hifadhi ya pendekezo. Amana za akaunti za tokeni, zinapohitajika, hutoka kwenye hifadhi. Oath haipokei kiasi hiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நெட்வொர்க் கட்டணங்கள் மற்றும் முன்மொழிவுச் சேமிப்பிற்குப் போதுமான SOL உள்ள கையொப்பமிடுபவரை Oath தானாகத் தேர்ந்தெடுக்கிறது. டோக்கன் கணக்கு வைப்புத்தொகை தேவைப்பட்டால் அது பாதுகாப்பகத்திலிருந்து எடுக்கப்படும். Oath இந்தத் தொகைகளை வசூலிப்பதில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెట్‌వర్క్ రుసుములు, ప్రతిపాదన నిల్వ ఖర్చులను చెల్లించడానికి సరిపడా SOL ఉన్న సంతకదారుడిని Oath స్వయంచాలకంగా ఎంచుకుంటుంది. టోకెన్ ఖాతా డిపాజిట్లు అవసరమైనప్పుడు భద్రగది నుంచి తీసుకోబడతాయి. Oath ఈ మొత్తాలను వసూలు చేయదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath เลือกผู้ลงนามที่มี SOL พอชำระค่าธรรมเนียมเครือข่ายและพื้นที่จัดเก็บข้อเสนอให้อัตโนมัติ เงินมัดจำบัญชีโทเค็นจะจ่ายจากคลังสินทรัพย์เมื่อจำเป็น Oath ไม่ได้รับเงินจำนวนเหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath, ağ ücretlerini ve teklif depolamasını ödemeye yetecek SOL bulunan bir imzalayanı otomatik seçer. Gerektiğinde token hesabı depozitoları kasadan karşılanır. Oath bu tutarları tahsil etmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath автоматично вибирає підписанта, у якого достатньо SOL для сплати комісій мережі та зберігання пропозиції. За потреби застава за токен-рахунки списується зі сховища. Oath не отримує ці кошти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath خودکار طور پر ایسا دستخط کنندہ منتخب کرتا ہے جس کے پاس نیٹ ورک فیس اور تجویز محفوظ کرنے کے لیے کافی SOL ہوں۔ ضرورت پڑنے پر ٹوکن اکاؤنٹ کی ضمانتی رقم والٹ سے ادا ہوتی ہے۔ Oath یہ رقوم وصول نہیں کرتا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath tarmoq komissiyalari va taklifni saqlash uchun yetarli SOL’i bor imzolovchini avtomatik tanlaydi. Token hisobi uchun depozit kerak boʻlsa, u seyfdan olinadi. Oath bu mablagʻlarni olmaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath tự chọn người ký có đủ SOL để trả phí mạng và lưu trữ đề xuất. Khi cần khoản đặt cọc cho tài khoản token, khoản đó sẽ được trích từ kho tiền. Oath không thu những khoản này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ń yan olùfọwọ́sí tó ní SOL tó tó láti san owó iṣẹ́ nẹ́tíwọ́ọ̀kì àti ìpamọ́ àbá ìṣòwò fúnra rẹ̀. Owó ìdógò àkọọ́lẹ̀ tóókìnì, nígbà tí a bá nílò rẹ̀, ń jáde láti ibi ìpamọ́ ohun ìní. Oath kò gba àwọn owó wọ̀nyí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath 会自动选择拥有足够 SOL 的签名者来支付网络手续费和提案存储费用。如需代币账户押金，将从金库支付。Oath 不收取这些款项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath 會自動選擇擁有足夠 SOL 的簽署者來支付網路手續費與提案儲存費用。如需代幣帳戶押金，將由金庫支付。Oath 不收取這些款項。"
          }
        }
      }
