    "multisigRecoveryDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱን ቁልፍና የሚያስፈልጉትን የፊርማዎች ብዛት ያስቀምጡ። ይህን ቦርሳ ለመመለስ ሁለቱም ያስፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بكل مفتاح وعدد التوقيعات المطلوبة. تحتاج إليهما لاسترداد هذه المحفظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি কী এবং প্রয়োজনীয় স্বাক্ষরের সংখ্যা সংরক্ষণ করুন। এই ওয়ালেট পুনরুদ্ধারে দুটিই প্রয়োজন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovejte každý klíč a požadovaný počet podpisů. Obojí je nutné k obnově této peněženky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem hver nøgle og det krævede antal signaturer. Begge dele er nødvendige for at gendanne tegnebogen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre jeden Schlüssel und die erforderliche Anzahl an Signaturen auf. Beides ist zur Wiederherstellung dieser Wallet nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φυλάξτε κάθε κλειδί και τον απαιτούμενο αριθμό υπογραφών. Χρειάζονται και τα δύο για την επαναφορά του πορτοφολιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep every key and the required signature count. Both are needed to restore this wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cada clave y el número de firmas necesarias. Necesitas ambos para restaurar esta cartera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه کلیدها و تعداد امضاهای لازم را نگه دارید. برای بازیابی این کیف پول به هر دو نیاز دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä jokainen avain ja vaadittujen allekirjoitusten määrä. Molempia tarvitaan lompakon palauttamiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itago ang bawat key at ang kinakailangang bilang ng mga lagda. Kailangan ang dalawa para maibalik ang wallet na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez chaque clé et le nombre de signatures requises. Les deux sont nécessaires pour restaurer ce portefeuille."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક કી અને જરૂરી હસ્તાક્ષરોની સંખ્યા સાચવી રાખો. આ વૉલેટ પુનઃસ્થાપિત કરવા બંને જરૂરી છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adana kowane maɓalli da adadin sa hannun da ake buƙata. Ana buƙatar duka biyun don maido da wannan walat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לשמור כל מפתח ואת מספר החתימות הנדרשות. שניהם נחוצים לשחזור הארנק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कुंजी और आवश्यक हस्ताक्षरों की संख्या सुरक्षित रखें। इस वॉलेट को पुनर्स्थापित करने के लिए दोनों चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sačuvajte svaki ključ i potreban broj potpisa. Oboje je potrebno za oporavak ovog novčanika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őrizz meg minden kulcsot és a szükséges aláírások számát. Mindkettő szükséges a tárca helyreállításához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan setiap kunci dan jumlah tanda tangan yang diperlukan. Keduanya dibutuhkan untuk memulihkan dompet ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva ogni chiave e il numero di firme richieste. Servono entrambi per ripristinare questo portafoglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのキーと必要な署名数を保管してください。このウォレットの復元には両方が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეინახეთ ყველა გასაღები და საჭირო ხელმოწერების რაოდენობა. საფულის აღსადგენად ორივე აუცილებელია."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រក្សាសោនីមួយៗ និងចំនួនហត្ថលេខាដែលត្រូវការ។ ទាំងពីរចាំបាច់សម្រាប់ស្តារកាបូបនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಕೀ ಮತ್ತು ಅಗತ್ಯ ಸಹಿಗಳ ಸಂಖ್ಯೆಯನ್ನು ಸುರಕ್ಷಿತವಾಗಿಡಿ. ಈ ವ್ಯಾಲೆಟ್ ಮರುಸ್ಥಾಪಿಸಲು ಎರಡೂ ಅಗತ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 키와 필요한 서명 수를 보관하세요. 이 지갑을 복구하려면 둘 다 필요합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ കീയും ആവശ്യമായ ഒപ്പുകളുടെ എണ്ണവും സൂക്ഷിക്കുക. ഈ വാലറ്റ് വീണ്ടെടുക്കാൻ രണ്ടും ആവശ്യമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक कळ आणि आवश्यक स्वाक्षऱ्यांची संख्या जपून ठेवा. हे वॉलेट पुनर्संचयित करण्यासाठी दोन्ही आवश्यक आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan setiap kunci dan bilangan tandatangan yang diperlukan. Kedua-duanya diperlukan untuk memulihkan dompet ini."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သော့တိုင်းနှင့် လိုအပ်သောလက်မှတ်အရေအတွက်ကို သိမ်းထားပါ။ ဤပိုက်ဆံအိတ်ကို ပြန်လည်ရယူရန် နှစ်ခုလုံးလိုအပ်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
