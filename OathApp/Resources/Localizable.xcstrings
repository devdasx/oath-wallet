        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రుసుము చెల్లించే చిరునామాలో ఈ నెట్‌వర్క్ సొంత నాణెం ఇంకా అవసరం. ఆ చిరునామాను కాపీ చేయడానికి బహుళ సంతకాల సెటప్, నెట్‌వర్క్ రుసుముల విభాగాన్ని తెరవండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
