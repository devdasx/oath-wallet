        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuweka upya hakukuweza kukamilika. Fungua kifaa chako na ujaribu tena. Ufikiaji wa pochi hubaki umezuiwa hadi kuweka upya kukamilike."
