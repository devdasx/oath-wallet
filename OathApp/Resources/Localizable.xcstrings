        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගාස්තු ගෙවන ලිපිනයට මෙම ජාලයේ ස්වදේශීය කාසිය තවත් අවශ්‍යයි. එම ලිපිනය පිටපත් කිරීමට බහු අත්සන් සැකසුම සහ ජාල ගාස්තු විවෘත කරන්න."
