        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အခကြေးငွေကို ကျန်လက်ကျန်မှ ပေးရသည်။ မလုံလောက်လျှင် ပို့ပမာဏမှ နုတ်သည်။ မပို့မီ ပမာဏအတိအကျနှင့် အခကြေးငွေကို ပြန်စစ်ပါ။"
