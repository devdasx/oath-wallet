    "multisigXrplReadyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሰነድ መዝገቡ ከፈራሚዎችዎ ዝርዝር እና የፊርማ ገደብ ጋር ይዛመዳል። ዋናው ቁልፍ ተሰናክሏል፣ እና ፊርማዎችዎን ሊያልፍ የሚችል መደበኛ ቁልፍ የለም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطابق قائمة الموقّعين وعتبة التوقيع المسجّلتان في دفتر السجل إعداداتك. المفتاح الرئيسي معطّل، ولا يمكن لأي مفتاح عادي تجاوز توقيعاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেজার আপনার স্বাক্ষরকারীদের তালিকা ও প্রয়োজনীয় স্বাক্ষরের সংখ্যার সঙ্গে মেলে। মাস্টার কী নিষ্ক্রিয় এবং কোনো নিয়মিত কী আপনার স্বাক্ষরের প্রয়োজন এড়িয়ে যেতে পারে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účetní kniha odpovídá vašemu seznamu podepisujících a prahovému počtu podpisů. Hlavní klíč je deaktivován a žádný běžný klíč nemůže obejít vaše podpisy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovedbogen stemmer overens med din underskriverliste og signaturtærskel. Hovednøglen er deaktiveret, og ingen almindelig nøgle kan omgå dine signaturer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ledger stimmt mit deiner Unterzeichnerliste und Signaturschwelle überein. Der Hauptschlüssel ist deaktiviert, und kein regulärer Schlüssel kann deine Signaturen umgehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καθολικό αντιστοιχεί στη λίστα υπογραφόντων και στον απαιτούμενο αριθμό υπογραφών σας. Το κύριο κλειδί είναι απενεργοποιημένο και κανένα κανονικό κλειδί δεν μπορεί να παρακάμψει τις υπογραφές σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ledger matches your signer list and threshold. The master key is disabled and no regular key can bypass your signatures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro coincide con tu lista de firmantes y tu umbral de firmas. La clave maestra está deshabilitada y ninguna clave normal puede eludir tus firmas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دفتر کل با فهرست امضاکنندگان و آستانهٔ شما مطابقت دارد. کلید اصلی غیرفعال است و هیچ کلید معمولی نمی‌تواند امضاهای شما را دور بزند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilikirja vastaa allekirjoittajaluetteloasi ja allekirjoitusrajaasi. Pääavain on poistettu käytöstä, eikä mikään tavallinen avain voi ohittaa allekirjoituksiasi."
          }
        },
        "fil" : {
          "stringUnit" : {
