    "receive.registration_notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ በ%2$@ ተቀበል። አንዳንድ ቶከኖች ከመቀበል በፊት ምዝገባ ይፈልጋሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استلم %1$@ على %2$@. تتطلب بعض الرموز التسجيل قبل الاستلام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ নেটওয়ার্কে %1$@ গ্রহণ করুন। কিছু টোকেন পেতে আগে নিবন্ধন লাগে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přijímejte %1$@ v síti %2$@. Některé tokeny vyžadují před přijetím registraci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modtag %1$@ på %2$@. Nogle tokens kræver registrering før modtagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ auf %2$@ empfangen. Manche Token erfordern vorher eine Registrierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε %1$@ στο %2$@. Ορισμένα token απαιτούν εγγραφή πριν από τη λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive %1$@ on %2$@. Some tokens require registration before receiving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe %1$@ en %2$@. Algunos tokens requieren registrarse antes de recibir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ را روی %2$@ دریافت کنید. برخی توکن‌ها پیش از دریافت به ثبت نیاز دارند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaanota %1$@-varoja verkossa %2$@. Jotkin tokenit vaativat rekisteröinnin ennen vastaanottamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumanggap ng %1$@ sa %2$@. Kailangang irehistro muna ang ilang token bago makatanggap."
          }
        },
