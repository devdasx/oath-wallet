      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ የይለፍ ቃል የElectrum የዘር ቅጥያ ነው። ከተመሳሳይ መልሶ ማግኛ ሐረግ የተለየ Bitcoin ቦርሳ ይፈጥራል። ቦርሳውን ለመመለስ ሐረጉንም የይለፍ ቃሉንም ያስቀምጡ።"
