        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရှေ့မဆက်မီ ဤလွှဲပြောင်းမှုကို ပြန်ရယူပါ။ မည်သည့်အရာမျှ မတင်သွင်းရသေးပါ။"
          }
