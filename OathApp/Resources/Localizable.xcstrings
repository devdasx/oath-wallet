        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cheie nu este validă pentru rețeaua selectată. Verifică formatul și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ не подходит для выбранной сети. Проверьте формат и повторите попытку."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي ڪنجي چونڊيل نيٽ ورڪ لاءِ صحيح ناهي. فارميٽ ڏسو ۽ ٻيهر ڪوشش ڪريو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම යතුර තෝරාගත් ජාලයට වලංගු නැත. ආකෘතිය පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kľúč nie je platný pre vybranú sieť. Skontrolujte formát a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ključ ni veljaven za izbrano omrežje. Preverite obliko in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyckeln är inte giltig för det valda nätverket. Kontrollera formatet och försök igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufunguo huu si halali kwa mtandao uliochaguliwa. Angalia umbizo na ujaribu tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்ந்தெடுத்த பிணையத்திற்கு இந்தச் சாவி செல்லாது. வடிவத்தைச் சரிபார்த்து மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకున్న నెట్‌వర్క్‌కు ఈ కీ చెల్లదు. ఫార్మాట్ తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์นี้ใช้ไม่ได้กับเครือข่ายที่เลือก ตรวจสอบรูปแบบแล้วลองอีกครั้ง"
