    "scannerHelpDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የዋሌት አድራሻ፣ የክፍያ ጥያቄ፣ BIP-39 የመመለሻ ሐረግ ወይም WalletConnect QR ኮድ ስካን አድርግ። ከመቀጠልህ በፊት እያንዳንዱን ውጤት ታያለህ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح عنوان محفظة أو طلب دفع أو عبارة استرداد BIP-39 أو رمز QR لـ WalletConnect. تراجع كل نتيجة قبل المتابعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়ালেটের ঠিকানা, পেমেন্ট অনুরোধ, BIP-39 পুনরুদ্ধার বাক্যাংশ বা WalletConnect QR কোড স্ক্যান করুন। এগোনোর আগে প্রতিটি ফল পর্যালোচনা করবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte adresu peněženky, žádost o platbu, obnovovací frázi BIP-39 nebo QR kód WalletConnect. Před pokračováním každý výsledek zkontrolujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan en walletadresse, en betalingsanmodning, en BIP-39-gendannelsesfrase eller en WalletConnect-QR-kode. Du gennemgår hvert resultat, før du fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne eine Wallet-Adresse, Zahlungsanforderung, BIP-39-Wiederherstellungsphrase oder einen WalletConnect-QR-Code. Du prüfst jedes Ergebnis vor dem Fortfahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε διεύθυνση πορτοφολιού, αίτημα πληρωμής, φράση ανάκτησης BIP-39 ή κωδικό QR WalletConnect. Ελέγχετε κάθε αποτέλεσμα πριν συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan a wallet address, a payment request, a BIP-39 recovery phrase, or a WalletConnect QR code. You review every result before continuing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea una dirección de cartera, una solicitud de pago, una frase de recuperación BIP-39 o un QR de WalletConnect. Revisarás cada resultado antes de continuar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانی کیف پول، درخواست پرداخت، عبارت بازیابی BIP-39 یا کد QR مربوط به WalletConnect را اسکن کنید. پیش از ادامه، هر نتیجه را بررسی می‌کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa lompakko-osoite, maksupyyntö, BIP-39-palautuslause tai WalletConnect-QR-koodi. Tarkistat jokaisen tuloksen ennen jatkamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-scan ng wallet address, kahilingan sa bayad, BIP-39 recovery phrase, o WalletConnect QR code. Susuriin mo ang bawat resulta bago magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez une adresse de portefeuille, une demande de paiement, une phrase de récupération BIP-39 ou un code QR WalletConnect. Vous vérifiez chaque résultat avant de continuer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વૉલેટ સરનામું, ચુકવણીની વિનંતી, BIP-39 પુનઃપ્રાપ્તિ શબ્દસમૂહ અથવા WalletConnect QR કોડ સ્કૅન કરો. આગળ વધતાં પહેલાં તમે દરેક પરિણામની સમીક્ષા કરો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
