          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polkadot Asset Hub-ൽ DOT, പിന്തുണയ്ക്കുന്ന ആസ്തികൾ എന്നിവ സ്വീകരിക്കാൻ ഈ Polkadot വിലാസം ഉപയോഗിക്കുക. എക്സ്ചേഞ്ചിൽനിന്ന് പിൻവലിക്കുമ്പോൾ Asset Hub തിരഞ്ഞെടുക്കുക."
          }
        },
        "si" : {
          "stringUnit" : {
