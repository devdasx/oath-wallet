        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो dApp ले सार्वजनिक ठेगाना हेर्न र हस्ताक्षर वा कारोबार माग्न सक्छ। तपाईं हरेक अनुरोध छुट्टै समीक्षा र स्वीकृत गर्नुहुन्छ।"
