    "permissions.permissionPermanentDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የቶከኑ አውጪ ይህን ቋሚ ወኪል ይቆጣጠራል። የቶከን ባለቤቶች ሊያስወግዱት አይችሉም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم مُصدر الرمز بهذا المفوّض الدائم. لا يمكن لحاملي الرموز إزالته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টোকেনের ইস্যুকারী এই স্থায়ী প্রতিনিধি নিয়ন্ত্রণ করেন। টোকেনধারীরা এটি সরাতে পারেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohoto trvalého delegáta ovládá vydavatel tokenu. Držitelé tokenu ho nemohou odebrat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenets udsteder styrer denne permanente delegerede. Tokenindehavere kan ikke fjerne den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Token-Emittent kontrolliert diesen permanenten Bevollmächtigten. Token-Inhaber können ihn nicht entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο εκδότης του token ελέγχει αυτόν τον μόνιμο εκπρόσωπο. Οι κάτοχοι token δεν μπορούν να τον αφαιρέσουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token issuer controls this permanent delegate. Token holders cannot remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emisor del token controla este delegado permanente. Los titulares no pueden eliminarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادرکنندهٔ توکن این نمایندهٔ دائمی را کنترل می‌کند. دارندگان توکن نمی‌توانند آن را حذف کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenin liikkeeseenlaskija hallitsee tätä pysyvää valtuutettua. Tokenin omistajat eivät voi poistaa sitä."
          }
        },
        "fil" : {
