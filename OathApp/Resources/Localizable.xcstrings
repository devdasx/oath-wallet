        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي ٻاهرين دستخطي ڪنجي هٽائي ٿو. ٻيون ڪنجيون، حدون ۽ اجازتون نه بدلجنديون. توهان جي مالڪ واري ڪنجي وٽ ڪنٽرول رهڻ ضروري آهي. نيٽ ورڪ في وٺندو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම බාහිර අත්සන් යතුර ඉවත් කරයි. වෙනත් යතුරු, සීමා සහ අවසර නොවෙනස්ව පවතී. ඔබේ හිමිකරු යතුරේ පාලනය රැඳිය යුතුය. ජාල ගාස්තුවක් අය කෙරේ."
