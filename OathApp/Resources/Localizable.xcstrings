    "passphrase.recovery_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን የማለፊያ ሐረግ ከመመለሻ መረጃህ ጋር አስቀምጥ። ይህን ዋሌት ለመመለስ ሁለቱም ያስፈልጋሉ። ክፍተቶችና የፊደል መጠን የሐረጉ ክፍል ናቸው፤ መቅዳት በትክክል ይጠብቃቸዋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بعبارة المرور هذه مع معلومات الاسترداد. تحتاج إليهما لاستعادة هذه المحفظة. المسافات وحالة الأحرف جزء من العبارة؛ ويحافظ النسخ عليها تمامًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পাসফ্রেজ পুনরুদ্ধারের তথ্যের সঙ্গে রাখুন। ওয়ালেট পুনরুদ্ধারে দুটিই প্রয়োজন। ফাঁকা স্থান ও বড়-ছোট হাতের অক্ষর পাসফ্রেজের অংশ; কপি করলে হুবহু থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovejte tuto přístupovou frázi s údaji pro obnovení. K obnovení této peněženky potřebujete obojí. Mezery a velikost písmen jsou součástí přístupové fráze; kopírování je přesně zachová."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbevar denne adgangssætning sammen med dine gendannelsesoplysninger. Du skal bruge begge dele for at gendanne denne wallet. Mellemrum og store bogstaver er en del af adgangssætningen; Kopiér bevarer dem nøjagtigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre diese Passphrase mit deinen Wiederherstellungsdaten auf. Du brauchst beides zur Wiederherstellung. Leerzeichen und Groß-/Kleinschreibung gehören dazu; „Kopieren“ erhält sie exakt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φυλάξτε αυτή τη μυστική φράση μαζί με τα στοιχεία ανάκτησης. Χρειάζεστε και τα δύο για την επαναφορά αυτού του πορτοφολιού. Τα κενά και τα κεφαλαία είναι μέρος της μυστικής φράσης· η αντιγραφή τα διατηρεί ακριβώς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this passphrase with your recovery information. You need both to restore this wallet. Spaces and capitalization are part of the passphrase; Copy preserves them exactly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda esta frase de contraseña junto con tus datos de recuperación. Necesitas ambos para restaurar esta cartera. Los espacios y las mayúsculas forman parte de la frase; Copiar los conserva exactamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این عبارت عبور را همراه اطلاعات بازیابی نگه دارید. برای بازیابی این کیف پول به هر دو نیاز دارید. فاصله‌ها و بزرگی و کوچکی حروف بخشی از عبارت عبورند؛ کپی کردن آن‌ها را دقیقاً حفظ می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä tämä salalause palautustietojesi yhteydessä. Tarvitset molemmat tämän lompakon palauttamiseen. Välilyönnit sekä isot ja pienet kirjaimet ovat osa salalausetta. Kopiointi säilyttää ne täsmälleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itago ang passphrase na ito kasama ng impormasyon mo sa pagbawi. Pareho silang kailangan para maibalik ang wallet. Bahagi ng passphrase ang mga espasyo at laki ng mga titik; eksaktong pinapanatili ng pagkopya ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez cette phrase secrète avec vos informations de récupération. Les deux sont nécessaires pour restaurer ce portefeuille. Les espaces et les majuscules font partie de la phrase ; Copier les préserve à l’identique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ પાસફ્રેઝ તમારી પુનઃપ્રાપ્તિ માહિતી સાથે રાખો. આ વૉલેટ પુનઃસ્થાપિત કરવા બંને જોઈએ. ખાલી જગ્યા અને મોટા-નાના અક્ષર પાસફ્રેઝનો ભાગ છે; કૉપિ કરવાથી તે બરાબર જળવાય છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka kiyaye wannan jimlar sirri tare da bayanan dawo da walat. Kana buƙatar dukkansu don dawo da wannan walat. Sarari da manya ko ƙananan haruffa sashe ne na jimlar sirri; Kwafi yana kiyaye su daidai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לשמור את ביטוי הסיסמה הזה עם פרטי השחזור שלך. שניהם נדרשים לשחזור הארנק הזה. רווחים ואותיות גדולות וקטנות הם חלק מביטוי הסיסמה; ההעתקה שומרת עליהם במדויק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पासफ़्रेज़ अपनी रिकवरी जानकारी के साथ रखें। वॉलेट बहाल करने के लिए दोनों चाहिए। स्पेस और बड़े-छोटे अक्षर पासफ़्रेज़ का हिस्सा हैं; कॉपी करने पर वे हूबहू रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuvajte ovu tajnu frazu uz podatke za oporavak. Za obnovu ovog novčanika trebate oboje. Razmaci i velika slova dio su tajne fraze; kopiranje ih točno čuva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őrizd meg ezt a jelmondatot a helyreállítási adataiddal együtt. Mindkettő szükséges a tárca visszaállításához. A szóközök és a kis- és nagybetűk a jelmondat részei; a Másolás pontosan megőrzi őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan frasa sandi ini bersama informasi pemulihan. Keduanya diperlukan untuk memulihkan dompet ini. Spasi dan kapitalisasi merupakan bagian dari frasa sandi; Salin mempertahankannya persis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva questa passphrase insieme alle informazioni di recupero. Servono entrambe per ripristinare il wallet. Spazi e maiuscole fanno parte della passphrase; la funzione Copia li mantiene esattamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスフレーズを復元情報と一緒に保管してください。復元には両方が必要です。スペースや大文字・小文字もパスフレーズの一部です。コピーすると正確に保持されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეინახეთ ეს საიდუმლო ფრაზა აღდგენის ინფორმაციასთან ერთად. ამ საფულის აღსადგენად ორივე გჭირდებათ. გამოტოვებები და დიდი ასოები საიდუმლო ფრაზის ნაწილია; კოპირება მათ ზუსტად ინარჩუნებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រក្សាឃ្លាសម្ងាត់នេះជាមួយព័ត៌មានស្ដាររបស់អ្នក។ អ្នកត្រូវការទាំងពីរដើម្បីស្ដារកាបូបនេះ។ ដកឃ្លា និងទំហំអក្សរជាផ្នែកនៃឃ្លាសម្ងាត់ ហើយការចម្លងរក្សាវាដូចដើម។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಿಮ್ಮ ಮರುಪಡೆಯುವ ಮಾಹಿತಿಯೊಂದಿಗೆ ಇಟ್ಟುಕೊಳ್ಳಿ. ಈ ವ್ಯಾಲೆಟ್ ಮರುಸ್ಥಾಪಿಸಲು ಎರಡೂ ಅಗತ್ಯ. ಖಾಲಿ ಜಾಗಗಳು ಮತ್ತು ದೊಡ್ಡ-ಸಣ್ಣ ಅಕ್ಷರಗಳು ಪಾಸ್‌ಫ್ರೇಸ್‌ನ ಭಾಗವಾಗಿವೆ; ನಕಲಿಸುವಾಗ ಅವು ಹಾಗೆಯೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 추가 암호문을 복구 정보와 함께 보관하세요. 지갑을 복원하려면 둘 다 필요합니다. 공백과 대소문자도 추가 암호문의 일부이며, 복사하면 정확하게 유지됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ പാസ്‌ഫ്രെയ്‌സ് നിങ്ങളുടെ വീണ്ടെടുക്കൽ വിവരങ്ങളോടൊപ്പം സൂക്ഷിക്കുക. വാലറ്റ് വീണ്ടെടുക്കാൻ രണ്ടും ആവശ്യമാണ്. സ്പേസുകളും അക്ഷരങ്ങളുടെ വലുപ്പവും പാസ്‌ഫ്രെയ്‌സിന്റെ ഭാഗമാണ്; പകർത്തുമ്പോൾ അവ കൃത്യമായി നിലനിൽക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा अतिरिक्त गुप्त वाक्यांश पुनर्प्राप्ती माहितीसोबत ठेवा. वॉलेट पुनर्संचयित करण्यासाठी दोन्ही लागतात. मोकळ्या जागा आणि मोठी-लहान अक्षरे त्याचा भाग आहेत; कॉपी केल्यावर ती तशीच राहतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan frasa laluan ini bersama maklumat pemulihan anda. Kedua-duanya diperlukan untuk memulihkan dompet ini. Ruang dan huruf besar/kecil adalah sebahagian daripada frasa laluan; Salin mengekalkannya tepat."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
