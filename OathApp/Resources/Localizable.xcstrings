      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ገንዘብ ወደ THORChain ፕሮቶኮል ይሄዳል። ማስታወሻው እርምጃውን፣ መድረሻውንና ማንኛውንም የልውውጥ ገደቦች ይገልጻል። ከመፈረምህ በፊት ሙሉውን ማስታወሻ አረጋግጥ።"
