    "multisigXrplKeyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባለ32 ባይት secp256k1 የግል ቁልፍ በ64 ሄክሳዴሲማል ቁምፊዎች ያስገቡ። መልሶ ማግኛ ሐረጎች የXRP መነሻ ማውጫ መንገድን ይጠቀማሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل مفتاح secp256k1 خاصًا بطول 32 بايت على هيئة 64 محرفًا بالنظام الست عشري. تستخدم عبارات الاسترداد مسار اشتقاق XRP."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "64টি হেক্সাডেসিমাল অক্ষর হিসেবে একটি 32-বাইটের secp256k1 ব্যক্তিগত কী লিখুন। পুনরুদ্ধার বাক্যাংশে XRP-এর ডেরিভেশন পাথ ব্যবহার করা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte 32bajtový soukromý klíč secp256k1 v podobě 64 šestnáctkových znaků. Obnovovací fráze používají derivační cestu XRP."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast en privat secp256k1-nøgle på 32 byte som 64 hexadecimale tegn. Gendannelsesfraser bruger XRP-afledningsstien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen 32 Byte langen privaten secp256k1-Schlüssel als 64 Hexadezimalzeichen ein. Wiederherstellungsphrasen verwenden den XRP-Ableitungspfad."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε ένα ιδιωτικό κλειδί secp256k1 32 byte ως 64 δεκαεξαδικούς χαρακτήρες. Οι φράσεις ανάκτησης χρησιμοποιούν τη διαδρομή παραγωγής κλειδιών XRP."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a 32-byte secp256k1 private key as 64 hexadecimal characters. Recovery phrases use the XRP derivation path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una clave privada secp256k1 de 32 bytes como 64 caracteres hexadecimales. Las frases de recuperación utilizan la ruta de derivación de XRP."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک کلید خصوصی ۳۲ بایتی secp256k1 به‌صورت ۶۴ نویسهٔ شانزده‌شانزدهی وارد کنید. عبارت‌های بازیابی از مسیر مشتق‌سازی XRP استفاده می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna 32 tavun secp256k1-yksityisavain 64 heksadesimaalimerkkinä. Palautuslauseet käyttävät XRP-avainpolkua."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maglagay ng 32-byte na pribadong key na secp256k1 bilang 64 na hexadecimal na karakter. Ginagamit ng mga recovery phrase ang derivation path ng XRP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une clé privée secp256k1 de 32 octets sous forme de 64 caractères hexadécimaux. Les phrases de récupération utilisent le chemin de dérivation XRP."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32-બાઇટની secp256k1 ખાનગી કી 64 હેક્સાડેસિમલ અક્ષરો તરીકે દાખલ કરો. પુનઃપ્રાપ્તિ શબ્દસમૂહો XRP ઉત્પત્તિ પાથ વાપરે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shigar da maɓallin sirri na secp256k1 mai baiti 32 a matsayin haruffan hexadecimal 64. Jimlolin dawo da walat suna amfani da hanyar samar da maɓalli ta XRP."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין מפתח פרטי מסוג secp256k1 באורך 32 בתים, כ-64 תווים הקסדצימליים. ביטויי שחזור משתמשים בנתיב הגזירה של XRP."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "32-बाइट की secp256k1 निजी कुंजी 64 हेक्साडेसिमल वर्णों के रूप में दर्ज करें। रिकवरी फ़्रेज़ XRP के व्युत्पत्ति पथ का इस्तेमाल करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesite 32-bajtni privatni ključ secp256k1 kao 64 heksadekadska znaka. Fraze za oporavak koriste put izvođenja XRP."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj meg egy 32 bájtos secp256k1 privát kulcsot 64 hexadecimális karakterként. A helyreállító kifejezések az XRP származtatási útvonalát használják."
          }
