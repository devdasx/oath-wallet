        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සියලු පසුම්බි, ප්‍රතිසාධන වාක්‍ය ඛණ්ඩ, පෞද්ගලික යතුරු, යෙදුම් මුරකේත සහ Face ID අක්තපත්‍ර මෙම යෙදුමෙන් ඉවත් කෙරේ. නැවත පසුම්බිවලට ප්‍රවේශ වීමට ප්‍රතිසාධන තොරතුරු අවශ්‍යය."
          }
        },
        "sk" : {
          "stringUnit" : {
