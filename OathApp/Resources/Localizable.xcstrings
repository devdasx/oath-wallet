        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আপনার পাঠানো পরিমাণের অংশ। মোটে আগে থেকেই আছে এবং আবার কাটা হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jde o část odesílané částky. V součtu je již zahrnuta a znovu se neúčtuje."
