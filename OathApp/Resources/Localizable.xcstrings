        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dana ini masuk ke protokol THORChain. Memo menentukan tindakan, tujuan, dan batas swap jika ada. Periksa memo lengkap sebelum menandatangani."
