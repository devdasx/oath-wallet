        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várakozás a lépés hálózati megerősítésére. A következő lépés a megerősítés után válik elérhetővé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu konfirmasi jaringan untuk langkah ini. Langkah berikutnya tersedia setelah dikonfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa che la rete confermi questo passaggio. Il passaggio successivo sarà disponibile dopo la conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この手順のネットワーク承認を待っています。承認されると次の手順に進めます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მიმდინარეობს ქსელის მიერ ამ ნაბიჯის დადასტურების მოლოდინი. შემდეგი ნაბიჯი დადასტურების შემდეგ გახდება ხელმისაწვდომი."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កំពុងរង់ចាំបណ្តាញបញ្ជាក់ជំហាននេះ។ ជំហានបន្ទាប់នឹងអាចធ្វើបាន ក្រោយពេលបញ្ជាក់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೆಟ್‌ವರ್ಕ್ ಈ ಹಂತವನ್ನು ದೃಢೀಕರಿಸಲು ಕಾಯಲಾಗುತ್ತಿದೆ. ದೃಢೀಕರಣದ ನಂತರ ಮುಂದಿನ ಹಂತ ಲಭ್ಯವಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 이 단계를 확인하기를 기다리는 중입니다. 확인이 끝나면 다음 단계를 진행할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നെറ്റ്‌വർക്ക് ഈ ഘട്ടം സ്ഥിരീകരിക്കുന്നതിനായി കാത്തിരിക്കുന്നു. സ്ഥിരീകരണത്തിന് ശേഷം അടുത്ത ഘട്ടം ലഭ്യമാകും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या टप्प्याला नेटवर्कची पुष्टी मिळण्याची प्रतीक्षा आहे. पुष्टी झाल्यावर पुढील टप्पा उपलब्ध होईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu rangkaian mengesahkan langkah ini. Langkah seterusnya tersedia selepas pengesahan."
