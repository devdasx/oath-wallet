        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे वॉलेट पुनर्प्राप्त करण्यासाठी पुनर्प्राप्ती वाक्यांश आणि हा अतिरिक्त गुप्त वाक्यांश दोन्ही आवश्यक आहेत. फक्त पुनर्प्राप्ती वाक्यांशाने मूळ वॉलेट उघडते. Oath वॉलेटचा अतिरिक्त गुप्त वाक्यांश रीसेट करू शकत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
