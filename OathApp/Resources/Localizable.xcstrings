    "permissions.permissionPendingDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አውታረ መረቡ ማስወገዱን እስኪያረጋግጥ መዳረሻው ንቁ ይቀጥላል። ይህን ገጽ መዝጋት ትችላለህ፤ Oath መፈተሹን ይቀጥላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى الوصول نشطًا حتى تؤكد الشبكة إزالته. يمكنك إغلاق هذه الشاشة؛ وسيواصل Oath التحقق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নেটওয়ার্ক সরানো নিশ্চিত না করা পর্যন্ত প্রবেশাধিকার সক্রিয় থাকে। এই পর্দা বন্ধ করতে পারেন; Oath যাচাই চালিয়ে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup zůstává aktivní, dokud síť nepotvrdí odebrání. Tuto obrazovku můžete zavřít; Oath bude pokračovat v kontrole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangen forbliver aktiv, indtil netværket bekræfter fjernelsen. Du kan lukke denne skærm; Oath fortsætter med at kontrollere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff bleibt aktiv, bis das Netzwerk die Entfernung bestätigt. Du kannst diesen Bildschirm schließen; Oath prüft weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση παραμένει ενεργή μέχρι το δίκτυο να επιβεβαιώσει την αφαίρεση. Μπορείτε να κλείσετε αυτή την οθόνη· το Oath θα συνεχίσει τον έλεγχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access stays active until the network confirms removal. You can close this screen; Oath will keep checking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso sigue activo hasta que la red confirme su eliminación. Puedes cerrar esta pantalla; Oath seguirá comprobándolo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی تا زمان تأیید لغو در شبکه فعال می‌ماند. می‌توانید این صفحه را ببندید؛ Oath بررسی را ادامه می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttöoikeus pysyy voimassa, kunnes verkko vahvistaa poistamisen. Voit sulkea tämän näkymän. Oath jatkaa tarkistamista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatiling aktibo ang access hanggang kumpirmahin ng network ang pag-alis. Maaari mong isara ang screen na ito; patuloy na susuriin ng Oath."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès reste actif jusqu’à confirmation du retrait par le réseau. Vous pouvez fermer cet écran ; Oath poursuivra la vérification."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નેટવર્ક દૂર કરવાની પુષ્ટિ ન કરે ત્યાં સુધી પ્રવેશ સક્રિય રહે છે. તમે આ સ્ક્રીન બંધ કરી શકો છો; Oath તપાસ ચાલુ રાખશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dama tana nan a kunne har hanyar sadarwa ta tabbatar da cirewa. Za ka iya rufe wannan shafin; Oath zai ci gaba da dubawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה נשארת פעילה עד שהרשת מאשרת את ההסרה. ניתן לסגור את המסך הזה; Oath תמשיך לבדוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क द्वारा हटाने की पुष्टि तक ऐक्सेस सक्रिय रहता है। यह स्क्रीन बंद कर सकते हैं; Oath जाँच जारी रखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup ostaje aktivan dok mreža ne potvrdi uklanjanje. Možete zatvoriti ovaj zaslon; Oath će nastaviti provjeravati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáférés addig aktív, amíg a hálózat meg nem erősíti az eltávolítást. Bezárhatod ezt a képernyőt; az Oath tovább ellenőrzi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses tetap aktif hingga jaringan mengonfirmasi penghapusan. Anda dapat menutup layar ini; Oath akan terus memeriksa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso resta attivo finché la rete non conferma la rimozione. Puoi chiudere questa schermata; Oath continuerà a controllare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークが削除を確認するまでアクセス権は有効です。この画面を閉じてもOathが確認を続けます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წვდომა აქტიურია, სანამ ქსელი გაუქმებას არ დაადასტურებს. შეგიძლიათ დახუროთ ეს ეკრანი; Oath შემოწმებას გააგრძელებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការចូលប្រើនៅសកម្មរហូតដល់បណ្ដាញបញ្ជាក់ការដកចេញ។ អ្នកអាចបិទអេក្រង់នេះបាន Oath នឹងបន្តពិនិត្យ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೆಟ್‌ವರ್ಕ್ ತೆಗೆದುಹಾಕುವುದನ್ನು ದೃಢೀಕರಿಸುವವರೆಗೆ ಪ್ರವೇಶ ಸಕ್ರಿಯವಾಗಿರುತ್ತದೆ. ಈ ಪರದೆ ಮುಚ್ಚಬಹುದು; Oath ಪರಿಶೀಲಿಸುತ್ತಲೇ ಇರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크에서 삭제를 확인할 때까지 접근 권한이 유지됩니다. 이 화면을 닫아도 Oath가 계속 확인합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നെറ്റ്‌വർക്ക് നീക്കം ചെയ്യൽ സ്ഥിരീകരിക്കുന്നത് വരെ പ്രവേശനം സജീവമായിരിക്കും. ഈ സ്ക്രീൻ അടയ്ക്കാം; Oath പരിശോധിക്കുന്നത് തുടരും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्कने काढण्याची पुष्टी करेपर्यंत प्रवेश सक्रिय राहतो. हा पडदा बंद करू शकता; Oath तपासत राहील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kekal aktif sehingga rangkaian mengesahkan pengalihan keluar. Anda boleh menutup skrin ini; Oath akan terus menyemak."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကွန်ရက်က ဖယ်ရှားမှုကို အတည်မပြုမချင်း ဝင်ရောက်ခွင့် ဆက်ရှိမည်။ ဤမျက်နှာပြင်ကို ပိတ်နိုင်သည်။ Oath က ဆက်စစ်နေမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgangen forblir aktiv til nettverket bekrefter fjerningen. Du kan lukke denne skjermen. Oath fortsetter å kontrollere."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्कले हटाएको पुष्टि नगरेसम्म पहुँच सक्रिय रहन्छ। यो स्क्रिन बन्द गर्न सक्नुहुन्छ; Oath ले जाँचिरहनेछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegang blijft actief totdat het netwerk de intrekking bevestigt. Je kunt dit scherm sluiten; Oath blijft controleren."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନେଟୱର୍କ ହଟାଇବାକୁ ନିଶ୍ଚିତ ନ କରିବା ପର୍ଯ୍ୟନ୍ତ ପ୍ରବେଶାଧିକାର ସକ୍ରିୟ ରହେ। ଆପଣ ଏହି ପରଦା ବନ୍ଦ କରିପାରିବେ; Oath ଯାଞ୍ଚ ଜାରି ରଖିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੈੱਟਵਰਕ ਵੱਲੋਂ ਹਟਾਉਣ ਦੀ ਪੁਸ਼ਟੀ ਤੱਕ ਪਹੁੰਚ ਚਾਲੂ ਰਹਿੰਦੀ ਹੈ। ਇਹ ਸਕ੍ਰੀਨ ਬੰਦ ਕਰ ਸਕਦੇ ਹੋ; Oath ਜਾਂਚ ਕਰਦਾ ਰਹੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp pozostaje aktywny, dopóki sieć nie potwierdzi usunięcia. Możesz zamknąć ten ekran; Oath będzie nadal sprawdzać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso continua ativo até a rede confirmar a remoção. Você pode fechar esta tela; Oath continuará verificando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso mantém-se ativo até a rede confirmar a remoção. Pode fechar este ecrã; Oath continuará a verificar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul rămâne activ până când rețeaua confirmă eliminarea. Poți închide acest ecran; Oath va continua verificarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ остаётся активным, пока сеть не подтвердит удаление. Можно закрыть экран; Oath продолжит проверку."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جيستائين نيٽ ورڪ هٽائڻ جي تصديق نه ڪري، رسائي فعال رهندي. توهان هي اسڪرين بند ڪري سگهو ٿا؛ Oath جاچ جاري رکندو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ජාලය ඉවත් කිරීම තහවුරු කරන තුරු ප්‍රවේශය සක්‍රියව පවතී. මෙම තිරය වැසිය හැක; Oath දිගටම පරීක්ෂා කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup zostáva aktívny, kým sieť nepotvrdí odobratie. Túto obrazovku môžete zavrieť; Oath bude pokračovať v kontrole."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop ostane aktiven, dokler omrežje ne potrdi odstranitve. Ta zaslon lahko zaprete; Oath bo preverjanje nadaljeval."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomsten är aktiv tills nätverket bekräftar borttagningen. Du kan stänga den här skärmen; Oath fortsätter kontrollera."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ufikiaji hubaki unatumika hadi mtandao uthibitishe kuondolewa. Unaweza kufunga skrini hii; Oath itaendelea kukagua."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிணையம் அகற்றலை உறுதிசெய்யும் வரை அணுகல் செயலில் இருக்கும். இந்தத் திரையை மூடலாம்; Oath தொடர்ந்து சரிபார்க்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నెట్‌వర్క్ తొలగింపును నిర్ధారించే వరకు ప్రవేశం ఉంటుంది. ఈ తెరను మూసివేయవచ్చు; Oath తనిఖీ చేస్తూనే ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิทธิ์ยังคงใช้งานได้จนกว่าเครือข่ายจะยืนยันการถอน คุณปิดหน้านี้ได้ Oath จะตรวจสอบต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ kaldırmayı onaylayana kadar erişim etkin kalır. Bu ekranı kapatabilirsiniz; Oath kontrol etmeye devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ діє, доки мережа не підтвердить скасування. Можете закрити цей екран; Oath продовжить перевірку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب تک نیٹ ورک ہٹانے کی تصدیق نہ کرے رسائی فعال رہتی ہے۔ یہ اسکرین بند کر سکتے ہیں؛ Oath جانچ جاری رکھے گا۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarmoq olib tashlashni tasdiqlaguncha kirish huquqi faol qoladi. Bu ekranni yopishingiz mumkin; Oath tekshirishda davom etadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vẫn có hiệu lực cho đến khi mạng xác nhận thu hồi. Bạn có thể đóng màn hình này; Oath sẽ tiếp tục kiểm tra."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àṣẹ yóò máa ṣiṣẹ́ títí nẹ́tíwọ́ọ̀kì yóò fi jẹ́rìí yíyọ rẹ̀ kúrò. O lè pa ojú ìwé yìí dé; Oath yóò tẹ̀síwájú láti ṣàyẹ̀wò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络确认移除之前，访问权限仍然有效。您可以关闭此页面；Oath 会继续检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網路確認移除前，存取權仍會有效。您可以關閉此畫面；Oath 會持續檢查。"
          }
        }
      }
    },
