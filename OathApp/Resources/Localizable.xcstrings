    "send.message_does_not_fit" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ መልእክትና ዝውውር የግብይቱን የመጠን ገደብ ያልፋሉ። መጠኑን አርትዕ፣ መልእክቱንም ለማሳጠር የዝውውር አማራጮችን ክፈት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجاوز هذه الرسالة والتحويل حد حجم المعاملة. عدّل المبلغ وافتح «خيارات التحويل» لتقصير الرسالة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বার্তা ও স্থানান্তর লেনদেনের আকারের সীমা ছাড়িয়েছে। পরিমাণ বদলান এবং স্থানান্তরের বিকল্প খুলে বার্তা ছোট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato zpráva s převodem překračují limit velikosti transakce. Upravte částku a otevřete Možnosti převodu pro zkrácení zprávy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne meddelelse og overførsel overstiger transaktionens størrelsesgrænse. Rediger beløbet, og åbn Overførselsindstillinger for at forkorte meddelelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachricht und Übertragung überschreiten das Größenlimit. Ändere den Betrag und öffne die Übertragungsoptionen, um die Nachricht zu kürzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το μήνυμα και η μεταφορά υπερβαίνουν το όριο μεγέθους συναλλαγής. Αλλάξτε το ποσό και ανοίξτε τις Επιλογές μεταφοράς για να συντομεύσετε το μήνυμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message and transfer exceed the transaction size limit. Edit the amount and open Transfer options to shorten the message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje y la transferencia superan el límite de tamaño de transacción. Edita el importe y abre Opciones de transferencia para acortar el mensaje."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پیام و انتقال از سقف اندازهٔ تراکنش بیشترند. مبلغ را ویرایش کنید و برای کوتاه کردن پیام، گزینه‌های انتقال را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä viesti ja siirto ylittävät tapahtuman kokorajan. Muokkaa määrää ja lyhennä viestiä kohdassa Siirron asetukset."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lampas sa limitasyon ng laki ng transaksyon ang mensahe at paglipat na ito. I-edit ang halaga at buksan ang mga opsyon ng paglipat para paikliin ang mensahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message et ce transfert dépassent la taille maximale d’une transaction. Modifiez le montant et ouvrez Options de transfert pour raccourcir le message."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ સંદેશ અને ટ્રાન્સફર વ્યવહારના કદની મર્યાદાથી વધુ છે. સંદેશ ટૂંકો કરવા રકમમાં ફેરફાર કરો અને ટ્રાન્સફર વિકલ્પો ખોલો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan saƙon da canja wurin sun wuce iyakar girman ma'amala. Gyara adadin ka buɗe Zaɓuɓɓukan canja wurin don taƙaita saƙon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההודעה וההעברה האלה חורגות ממגבלת גודל העסקה. יש לערוך את הסכום ולפתוח את אפשרויות ההעברה כדי לקצר את ההודעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह संदेश और ट्रांसफ़र लेन-देन के आकार की सीमा से बड़े हैं। रकम बदलें और संदेश छोटा करने के लिए ट्रांसफ़र विकल्प खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova poruka i prijenos premašuju ograničenje veličine transakcije. Uredite iznos i otvorite Opcije prijenosa za skraćivanje poruke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az üzenet és átutalás meghaladja a tranzakció méretkorlátját. Szerkeszd az összeget, és az Átutalási lehetőségeknél rövidítsd az üzenetet."
