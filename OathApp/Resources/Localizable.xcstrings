        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ውሉ፣ የአባላቱ ቁልፎች እና የፊርማ መስፈርቱ ተረጋግጠዋል። ሙሉ መዳረሻ ያለው ቁልፍ አልቀረም።"
