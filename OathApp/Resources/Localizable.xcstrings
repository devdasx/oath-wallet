        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang password na ito ay isang seed extension ng Electrum. Gumagawa ito ng hiwalay na Bitcoin wallet mula sa parehong recovery phrase. Itago ang parehong phrase at password para maibalik ito."
