    "wallet.recovery_safety" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እነዚህን ቃላት በቅደም ተከተል ጻፍና በግል ቦታ ያዝ። ይህ ሐረግ ያለው ሰው ገንዘብህን መድረስ ይችላል። ፈጽሞ አታጋራው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوّن هذه الكلمات بالترتيب واحفظها في مكان خاص. يمكن لأي شخص يملك هذه العبارة الوصول إلى أموالك. لا تشاركها أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দগুলো ক্রম অনুযায়ী লিখে গোপন জায়গায় রাখুন। এই বাক্যাংশ যার কাছে থাকবে সে আপনার অর্থ ব্যবহার করতে পারবে। কাউকে দেবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapište tato slova v pořadí a uložte je na soukromé místo. Každý s touto frází má přístup k vašim prostředkům. Nikdy ji nesdílejte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ordene ned i rækkefølge, og opbevar dem privat. Enhver med frasen kan få adgang til dine midler. Del den aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe diese Wörter in der richtigen Reihenfolge auf und bewahre sie privat auf. Jeder mit dieser Phrase kann auf dein Guthaben zugreifen. Teile sie niemals."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε αυτές τις λέξεις με τη σειρά και φυλάξτε τις σε ιδιωτικό μέρος. Όποιος έχει τη φράση μπορεί να αποκτήσει πρόσβαση στα χρήματά σας. Μην την κοινοποιείτε ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write these words down in order and keep them somewhere private. Anyone with this phrase can access your funds. Never share it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota estas palabras en orden y guárdalas en un lugar privado. Quien tenga esta frase puede acceder a tus fondos. Nunca la compartas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این واژه‌ها را به ترتیب بنویسید و در جایی محرمانه نگه دارید. هرکس این عبارت را داشته باشد به دارایی شما دسترسی دارد. هرگز به اشتراک نگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita nämä sanat muistiin oikeassa järjestyksessä ja säilytä yksityisessä paikassa. Lauseen haltija voi käyttää varojasi. Älä koskaan jaa sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isulat ang mga salitang ito sa tamang pagkakasunod at itago sa pribadong lugar. Maa-access ng sinumang may pariralang ito ang pondo mo. Huwag itong ibahagi kailanman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ces mots dans l’ordre et gardez-les en lieu privé. Quiconque possède cette phrase peut accéder à vos fonds. Ne la partagez jamais."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ શબ્દો ક્રમમાં લખો અને અંગત જગ્યાએ રાખો. આ શબ્દસમૂહ ધરાવનાર કોઈપણ તમારું ભંડોળ ઍક્સેસ કરી શકે છે. ક્યારેય વહેંચશો નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rubuta waɗannan kalmomi a jere ka ajiye su a wuri mai sirri. Duk wanda yake da wannan jimla zai iya samun kuɗinka. Kada ka taɓa raba ta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לרשום את המילים האלה בסדר הנכון ולשמור אותן במקום פרטי. כל מי שמחזיק בביטוי הזה יכול לגשת לכספים שלך. לעולם אין לשתף אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शब्द क्रम में लिखें और निजी जगह रखें। इस फ़्रेज़ वाला कोई भी आपका धन पा सकता है। इसे कभी साझा न करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapišite ove riječi redom i čuvajte ih na privatnom mjestu. Svatko s ovom frazom može pristupiti vašim sredstvima. Nikada je ne dijelite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írd le ezeket a szavakat sorrendben, és őrizd őket bizalmas helyen. Aki ismeri ezt a szósort, hozzáférhet a pénzedhez. Soha ne oszd meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis kata-kata ini berurutan dan simpan di tempat pribadi. Siapa pun yang memiliki frasa ini dapat mengakses dana Anda. Jangan pernah membagikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi queste parole nell'ordine corretto e conservale in un luogo privato. Chiunque le possieda può accedere ai tuoi fondi. Non condividerle mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語を順番どおりに書き留め、人に見られない場所に保管してください。このフレーズを持つ人は資金にアクセスできます。絶対に共有しないでください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩაიწერეთ ეს სიტყვები თანმიმდევრობით და კონფიდენციალურ ადგილას შეინახეთ. ამ ფრაზის მქონე ნებისმიერ პირს შეუძლია თქვენს თანხებზე წვდომა. არასოდეს გააზიაროთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សរសេរពាក្យទាំងនេះតាមលំដាប់ ហើយរក្សាកន្លែងឯកជន។ អ្នកដែលមានឃ្លានេះអាចចូលប្រើប្រាក់អ្នក។ កុំចែករំលែក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಪದಗಳನ್ನು ಕ್ರಮವಾಗಿ ಬರೆದು ಖಾಸಗಿ ಸ್ಥಳದಲ್ಲಿ ಇಡಿ. ಈ ನುಡಿಗಟ್ಟು ಹೊಂದಿರುವ ಯಾರಾದರೂ ನಿಮ್ಮ ಹಣ ಪ್ರವೇಶಿಸಬಹುದು. ಅದನ್ನು ಎಂದಿಗೂ ಹಂಚಿಕೊಳ್ಳಬೇಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단어들을 순서대로 적어 다른 사람이 볼 수 없는 곳에 보관하세요. 구문을 가진 사람은 자금에 접근할 수 있습니다. 절대 공유하지 마세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ വാക്കുകൾ ക്രമത്തിൽ എഴുതിവച്ച് സ്വകാര്യമായിടത്ത് സൂക്ഷിക്കുക. ഈ വാക്യം ഉള്ള ആർക്കും നിങ്ങളുടെ പണത്തിലേക്ക് പ്രവേശിക്കാം. ഒരിക്കലും പങ്കിടരുത്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे शब्द क्रमाने लिहून खाजगी ठिकाणी ठेवा. हा वाक्यांश असलेला कोणीही निधी वापरू शकतो. कधीही शेअर करू नका."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis perkataan ini mengikut susunan dan simpan di tempat peribadi. Sesiapa dengan frasa ini boleh mengakses dana anda. Jangan kongsikannya."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤစကားလုံးများကို အစဉ်အတိုင်း ရေးမှတ်ပြီး သီးသန့်နေရာတွင် သိမ်းပါ။ ဤစကားစုရှိသူ မည်သူမဆို သင့်ငွေကို ရယူနိုင်သည်။ မည်သည့်အခါမျှ မမျှဝေပါနှင့်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ned ordene i riktig rekkefølge og oppbevar dem privat. Alle med denne frasen kan få tilgang til midlene dine. Del den aldri."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यी शब्द क्रममै लेखेर निजी ठाउँमा राख्नुहोस्। यो वाक्यांश भएको जोसुकैले रकम पहुँच गर्न सक्छ। कहिल्यै नबाँड्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf deze woorden in de juiste volgorde op en bewaar ze op een privéplek. Iedereen met deze zin heeft toegang tot je geld. Deel de zin nooit."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଶବ୍ଦ କ୍ରମରେ ଲେଖି ଏକ ଗୁପ୍ତ ସ୍ଥାନରେ ରଖନ୍ତୁ। ଏହି ଫ୍ରେଜ୍ ଥିବା ଯେକେହି ଆପଣଙ୍କ ଅର୍ଥ ପାଇପାରିବେ। ଏହା କେବେ ଶେୟାର କରନ୍ତୁ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਸ਼ਬਦ ਕ੍ਰਮ ਵਿੱਚ ਲਿਖੋ ਅਤੇ ਨਿੱਜੀ ਥਾਂ ਰੱਖੋ। ਇਹ ਸ਼ਬਦ ਰੱਖਣ ਵਾਲਾ ਕੋਈ ਵੀ ਤੁਹਾਡੀ ਰਕਮ ਤੱਕ ਪਹੁੰਚ ਸਕਦਾ ਹੈ। ਕਦੇ ਸਾਂਝੇ ਨਾ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz te słowa w kolejności i przechowuj w prywatnym miejscu. Każdy, kto ma tę frazę, może uzyskać dostęp do Twoich środków. Nigdy jej nie udostępniaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote estas palavras na ordem e guarde-as em um lugar privado. Quem tiver esta frase poderá acessar seus fundos. Nunca a compartilhe."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote estas palavras pela ordem e guarde-as num local privado. Quem tiver esta frase pode aceder aos seus fundos. Nunca a partilhe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notează aceste cuvinte în ordine și păstrează-le într-un loc privat. Oricine are această frază îți poate accesa fondurile. Nu o divulga niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите слова по порядку и храните в тайном месте. Любой обладатель фразы может получить доступ к средствам. Никому её не передавайте."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي لفظ ترتيب سان لکو ۽ خانگي هنڌ رکو. هن جملي وارو ڪو به شخص توهان جي رقم تائين رسائي رکي ٿو. ڪڏهن به ونڊيو نه."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම වචන අනුපිළිවෙළට ලියා රහසිගත තැනක තබන්න. වාක්‍ය ඛණ්ඩය ඇති ඕනෑම අයෙකුට මුදල්වලට ප්‍රවේශ විය හැක. කිසිවිටක බෙදා නොගන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapíšte tieto slová v poradí a uložte ich na súkromné miesto. Každý s touto frázou má prístup k vašim prostriedkom. Nikdy ju nezdieľajte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te besede zapišite po vrsti in jih hranite na zasebnem mestu. Vsakdo s to frazo lahko dostopa do vaših sredstev. Nikoli je ne delite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ner orden i rätt ordning och förvara dem privat. Alla som har frasen kan komma åt dina medel. Dela den aldrig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andika maneno haya kwa mpangilio na uyaweke mahali pa faragha. Yeyote mwenye maneno haya anaweza kufikia fedha zako. Usiyashiriki kamwe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சொற்களை வரிசையாக எழுதி தனிப்பட்ட இடத்தில் வைத்திருக்கவும். இந்தச் சொற்றொடர் உள்ள எவரும் உங்கள் நிதியை அணுகலாம். ஒருபோதும் பகிர வேண்டாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ పదాలను క్రమంలో రాసి వ్యక్తిగత ప్రదేశంలో ఉంచండి. ఈ పదబంధం ఉన్న ఎవరైనా మీ నిధులను యాక్సెస్ చేయవచ్చు. ఎప్పుడూ పంచుకోవద్దు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดคำเหล่านี้ตามลำดับและเก็บในที่ส่วนตัว ใครก็ตามที่มีวลีนี้เข้าถึงเงินของคุณได้ อย่าแบ่งปัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kelimeleri sırayla yazıp gizli bir yerde saklayın. Bu ifadeye sahip olan herkes fonlarınıza erişebilir. Asla paylaşmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишіть ці слова по порядку й зберігайте в приватному місці. Кожен, хто має цю фразу, може отримати доступ до ваших коштів. Ніколи її не розголошуйте."
