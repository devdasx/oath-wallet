        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath guarda a frase-passe no cofre local cifrado. Mantenha também a sua própria cópia segura. Uma cópia iCloud criada para a nova carteira inclui a frase-passe; a cópia da carteira original não a inclui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath salvează fraza de acces în seiful local criptat. Păstrează și o copie proprie în siguranță. O copie iCloud creată pentru noul portofel include fraza sa de acces; copia portofelului original nu o include."
