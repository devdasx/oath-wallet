        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ કોડ પસંદ કરેલા નેટવર્ક સાથે મળતો નથી. આ નેટવર્કનું સરનામું સ્કૅન કરો અથવા બીજી સંપત્તિ પસંદ કરવા પાછા જાઓ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan lambar ba ta dace da hanyar sadarwar da aka zaɓa ba. Duba adireshi na wannan hanyar sadarwa ko koma baya ka zaɓi wata kadara."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקוד הזה אינו תואם לרשת שנבחרה. יש לסרוק כתובת עבור הרשת הזו או לחזור ולבחור נכס אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कोड चुने नेटवर्क से मेल नहीं खाता। इस नेटवर्क का पता स्कैन करें या दूसरा एसेट चुनने के लिए वापस जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj kod ne odgovara odabranoj mreži. Skenirajte adresu za ovu mrežu ili se vratite i odaberite drugu imovinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kód nem felel meg a kiválasztott hálózatnak. Olvass be ehhez a hálózathoz tartozó címet, vagy lépj vissza másik eszköz választásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode ini tidak cocok dengan jaringan yang dipilih. Pindai alamat untuk jaringan ini atau kembali untuk memilih aset lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice non corrisponde alla rete selezionata. Scansiona un indirizzo di questa rete o torna indietro per scegliere un altro asset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したネットワークと一致しません。このネットワークのアドレスをスキャンするか、戻って別の資産を選んでください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს კოდი არჩეულ ქსელს არ შეესაბამება. დაასკანერეთ ამ ქსელის მისამართი ან დაბრუნდით სხვა აქტივის ასარჩევად."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កូដនេះមិនត្រូវនឹងបណ្ដាញដែលបានជ្រើស។ ស្កេនអាសយដ្ឋានសម្រាប់បណ្ដាញនេះ ឬត្រឡប់ក្រោយដើម្បីជ្រើសទ្រព្យផ្សេង។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಕೋಡ್ ಆಯ್ಕೆಮಾಡಿದ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ. ಈ ನೆಟ್‌ವರ್ಕ್‌ನ ವಿಳಾಸ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ ಅಥವಾ ಹಿಂದಕ್ಕೆ ಹೋಗಿ ಬೇರೆ ಸ್ವತ್ತು ಆಯ್ಕೆ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코드가 선택한 네트워크와 일치하지 않습니다. 이 네트워크의 주소를 스캔하거나 뒤로 돌아가 다른 자산을 선택하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ കോഡ് തിരഞ്ഞെടുത്ത നെറ്റ്‌വർക്കുമായി പൊരുത്തപ്പെടുന്നില്ല. ഈ നെറ്റ്‌വർക്കിനുള്ള വിലാസം സ്കാൻ ചെയ്യുക, അല്ലെങ്കിൽ മറ്റൊരു ആസ്തി തിരഞ്ഞെടുക്കാൻ തിരികെ പോകുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा कोड निवडलेल्या नेटवर्कशी जुळत नाही. या नेटवर्कचा पत्ता स्कॅन करा किंवा मागे जाऊन दुसरी मालमत्ता निवडा."
