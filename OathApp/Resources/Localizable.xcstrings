    "receive.indexed_tracking" : {
      "comment" : "Account indexer status. Provider failures preserve cached data.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዚህ አድራሻ የተቀበልካቸው የሚደገፉ ቶከኖች፣ የአውታረ መረቡ መረጃ አቅራቢ ከመዘገባቸው በኋላ፣ ስታድስ በራስ ሰር ይታያሉ። ቶከን ገና ካልታየ፣ ለመጨመር የውል አድራሻውን ፈልግ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الرموز المدعومة المستلمة على هذا العنوان تلقائيًا عند التحديث، بعد فهرستها لدى مزوّد بيانات الشبكة. إن لم يظهر رمز بعد، فابحث بعنوان عقده لإضافته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ঠিকানায় পাওয়া সমর্থিত টোকেন নেটওয়ার্ক ডেটা প্রদানকারী সূচিবদ্ধ করার পরে রিফ্রেশ করলে নিজে থেকেই দেখা যায়। টোকেন এখনও না থাকলে কন্ট্র্যাক্টের ঠিকানা খুঁজে যোগ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporované tokeny přijaté na tuto adresu se při obnovení zobrazí automaticky, jakmile je poskytovatel síťových dat zaindexuje. Pokud token ještě není uveden, vyhledejte adresu jeho kontraktu a přidejte ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøttede tokens modtaget på denne adresse vises automatisk, når du opdaterer, efter at netværkets dataudbyder har indekseret dem. Hvis et token endnu ikke vises, kan du søge efter kontraktadressen for at tilføje det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfangene unterstützte Token erscheinen nach der Indexierung durch den Netzwerkdatenanbieter beim Aktualisieren automatisch. Ist ein Token noch nicht aufgeführt, suche seine Vertragsadresse, um ihn hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
