        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het opnieuw instellen kon niet worden voltooid. Ontgrendel je apparaat en probeer het opnieuw. De toegang tot je wallets blijft geblokkeerd totdat het opnieuw instellen is voltooid."
