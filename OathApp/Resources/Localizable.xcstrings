    "wcConnectionSummary" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ dApp ይፋዊ አድራሻዎችህን ማየትና ፊርማዎች ወይም ግብይቶች መጠየቅ ይችላል። እያንዳንዱን ጥያቄ በተናጠል ታያለህ፣ ታጸድቃለህም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لهذا التطبيق اللامركزي رؤية عناوينك العامة وطلب توقيعات أو معاملات. تراجع وتوافق على كل طلب بشكل منفصل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই dApp আপনার প্রকাশ্য ঠিকানা দেখতে এবং স্বাক্ষর বা লেনদেন চাইতে পারে। প্রতিটি অনুরোধ আলাদা দেখে অনুমোদন করেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato dApp vidí vaše veřejné adresy a může žádat o podpisy či transakce. Každý požadavek kontrolujete a schvalujete samostatně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne dApp kan se dine offentlige adresser og anmode om signaturer eller transaktioner. Du gennemgår og godkender hver anmodning separat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese dApp kann deine öffentlichen Adressen sehen und Signaturen oder Transaktionen anfordern. Du prüfst und bestätigst jede Anfrage einzeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η dApp μπορεί να βλέπει τις δημόσιες διευθύνσεις σας και να ζητά υπογραφές ή συναλλαγές. Ελέγχετε και εγκρίνετε κάθε αίτημα ξεχωριστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This dApp can see your public addresses and request signatures or transactions. You review and approve each request separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dApp puede ver tus direcciones públicas y solicitar firmas o transacciones. Revisas y apruebas cada solicitud por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامهٔ غیرمتمرکز می‌تواند نشانی‌های عمومی شما را ببیند و درخواست امضا یا تراکنش کند. هر درخواست را جداگانه بررسی و تأیید می‌کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä dApp voi nähdä julkiset osoitteesi ja pyytää allekirjoituksia tai tapahtumia. Tarkistat ja hyväksyt jokaisen pyynnön erikseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makikita ng dApp na ito ang mga pampublikong address mo at makahihiling ng pirma o transaksyon. Hiwalay mong susuriin at aaprubahan ang bawat kahilingan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette dApp peut voir vos adresses publiques et demander des signatures ou transactions. Vous vérifiez et approuvez chaque demande séparément."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ dApp તમારા જાહેર સરનામાં જોઈ શકે છે અને હસ્તાક્ષર અથવા વ્યવહારો માગી શકે છે. તમે દરેક વિનંતીની અલગ સમીક્ષા અને મંજૂરી આપો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan dApp zai iya ganin adiresoshinka na jama'a da neman sa hannu ko ma'amaloli. Kana yin bita da amincewa da kowace buƙata daban."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יישום ה־dApp הזה יכול לראות את הכתובות הציבוריות שלך ולבקש חתימות או עסקאות. כל בקשה נבדקת ומאושרת על ידך בנפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह dApp आपके सार्वजनिक पते देख सकता है और हस्ताक्षर या लेन-देन माँग सकता है। हर अनुरोध की आप अलग समीक्षा और मंज़ूरी देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova dApp aplikacija može vidjeti vaše javne adrese i tražiti potpise ili transakcije. Svaki zahtjev pregledavate i odobravate zasebno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a dApp láthatja a nyilvános címeidet, és aláírásokat vagy tranzakciókat kérhet. Minden kérést külön tekintesz át és hagysz jóvá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dApp ini dapat melihat alamat publik Anda dan meminta tanda tangan atau transaksi. Anda meninjau dan menyetujui setiap permintaan secara terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa dApp può vedere i tuoi indirizzi pubblici e richiedere firme o transazioni. Esamini e approvi ogni richiesta separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このdAppは公開アドレスを閲覧し、署名や取引を要求できます。リクエストごとに個別の確認・承認が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ dApp-ს თქვენი საჯარო მისამართების ნახვა და ხელმოწერების ან ტრანზაქციების მოთხოვნა შეუძლია. თითოეულ მოთხოვნას ცალ-ცალკე გადახედავთ და ამტკიცებთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dApp នេះអាចមើលអាសយដ្ឋានសាធារណៈ និងស្នើហត្ថលេខា ឬប្រតិបត្តិការ។ អ្នកពិនិត្យ និងអនុម័តសំណើនីមួយៗដោយឡែក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ dApp ನಿಮ್ಮ ಸಾರ್ವಜನಿಕ ವಿಳಾಸಗಳನ್ನು ನೋಡಿ ಸಹಿಗಳು ಅಥವಾ ವಹಿವಾಟುಗಳನ್ನು ವಿನಂತಿಸಬಹುದು. ಪ್ರತಿ ವಿನಂತಿಯನ್ನು ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿ ಪರಿಶೀಲಿಸಿ ಅನುಮೋದಿಸುತ್ತೀರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 dApp은 공개 주소를 보고 서명이나 거래를 요청할 수 있습니다. 요청마다 개별적으로 검토하고 승인합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ dApp-ന് നിങ്ങളുടെ പൊതു വിലാസങ്ങൾ കാണാനും ഒപ്പുകളോ ഇടപാടുകളോ അഭ്യർത്ഥിക്കാനും കഴിയും. ഓരോ അഭ്യർത്ഥനയും നിങ്ങൾ പ്രത്യേകം പരിശോധിച്ച് അംഗീകരിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा dApp तुमचे सार्वजनिक पत्ते पाहून स्वाक्षऱ्या किंवा व्यवहार मागू शकतो. प्रत्येक विनंती तुम्ही स्वतंत्रपणे तपासून मंजूर करता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dApp ini boleh melihat alamat awam dan meminta tandatangan atau transaksi. Anda menyemak dan meluluskan setiap permintaan secara berasingan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤ dApp သည် သင့်အများမြင်လိပ်စာများကို ကြည့်ပြီး လက်မှတ် သို့မဟုတ် အရောင်းအဝယ်များ တောင်းနိုင်သည်။ တောင်းဆိုချက်တစ်ခုစီကို သီးခြား ပြန်စစ်ပြီး ခွင့်ပြုရသည်။"
