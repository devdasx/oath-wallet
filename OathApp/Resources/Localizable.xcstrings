    "send.account_cost.extra_explanation" : {
      "comment" : "Send review: verified recipient account funding and cost breakdown.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ወጪ ተቀባዩ ከሚቀበለው መጠን የተለየ ነው። በመገምገሚያ ገጹ ከሚታየው ጠቅላላ መጠን ውስጥ አስቀድሞ አንድ ጊዜ ተካትቷል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه التكلفة منفصلة عن المبلغ الذي يستلمه المستلم. وهي مضمنة مرة واحدة في الإجمالي المعروض على شاشة المراجعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই খরচ প্রাপকের পাওয়া পরিমাণ থেকে আলাদা। পর্যালোচনার মোটে এটি ইতিমধ্যে একবার ধরা হয়েছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento náklad je oddělený od částky, kterou příjemce obdrží. V celkové částce na obrazovce kontroly je již jednou zahrnut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne omkostning er adskilt fra det beløb, modtageren får. Den er allerede medregnet én gang i totalen på gennemgangsskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kosten sind vom Empfangsbetrag getrennt. Sie sind bereits einmal im Gesamtbetrag der Prüfungsansicht enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το κόστος είναι ξεχωριστό από το ποσό που λαμβάνει ο παραλήπτης. Περιλαμβάνεται ήδη μία φορά στο σύνολο της οθόνης ελέγχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cost is separate from the amount the recipient receives. It is already included once in the total shown on the review screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este coste es independiente del importe que recibe el destinatario. Ya está incluido una vez en el total de la pantalla de revisión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این هزینه از مبلغ دریافتی گیرنده جداست. قبلاً یک بار در مجموع صفحهٔ بررسی حساب شده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kulu on erillinen vastaanottajan saamasta määrästä. Se on jo laskettu kerran mukaan tarkistusnäkymän kokonaissummaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiwalay ang gastos na ito sa halagang matatanggap ng tatanggap. Isinama na ito nang isang beses sa kabuuang ipinapakita sa pagsusuri."
          }
        },
        "fr" : {
          "stringUnit" : {
