        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ کلید منتخب نیٹ ورک کے لیے درست نہیں۔ فارمیٹ دیکھیں اور دوبارہ کوشش کریں۔"
