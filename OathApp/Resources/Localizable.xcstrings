    "passphrase.entry_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጠንካራ የማለፊያ ሐረግ ምረጥና ለማረጋገጥ እንደገና አስገባው። ይህ ከመተግበሪያው መክፈቻ ኮድና ከiCloud ምትኬ ይለፍ ቃል የተለየ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر عبارة مرور قوية وأدخلها مجددًا للتأكيد. وهي منفصلة عن رمز دخول التطبيق وكلمة سر نسخة iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শক্তিশালী পাসফ্রেজ বেছে নিয়ে নিশ্চিত করতে আবার লিখুন। এটি অ্যাপের পাসকোড ও iCloud ব্যাকআপের পাসওয়ার্ড থেকে আলাদা।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte silnou přístupovou frázi a zadejte ji znovu pro potvrzení. Liší se od přístupového kódu aplikace i hesla zálohy iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en stærk adgangssætning, og indtast den igen for at bekræfte. Den er forskellig fra appens PIN-kode og adgangskoden til iCloud-sikkerhedskopien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine starke Passphrase und gib sie zur Bestätigung erneut ein. Sie ist von deinem App-Code und iCloud-Sicherungspasswort getrennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ισχυρή μυστική φράση και πληκτρολογήστε την ξανά για επιβεβαίωση. Είναι διαφορετική από τον κωδικό εισόδου της εφαρμογής και τον κωδικό αντιγράφου ασφαλείας iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a strong passphrase and enter it again to confirm. This is separate from your app passcode and iCloud backup password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una frase de contraseña segura y repítela para confirmar. Es independiente del código de acceso de la app y de la contraseña de copia en iCloud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک عبارت عبور قوی انتخاب کنید و برای تأیید دوباره وارد کنید. این عبارت از رمز ورود برنامه و گذرواژهٔ پشتیبان iCloud جداست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vahva salalause ja vahvista se kirjoittamalla se uudelleen. Se on eri asia kuin sovelluksen pääsykoodi ja iCloud-varmuuskopion salasana."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng matibay na passphrase at ilagay itong muli para kumpirmahin. Hiwalay ito sa passcode ng app at password ng iCloud backup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une phrase secrète robuste et saisissez-la à nouveau pour confirmer. Elle est distincte du code d’accès de l’app et du mot de passe de sauvegarde iCloud."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મજબૂત પાસફ્રેઝ પસંદ કરો અને ખાતરી કરવા ફરી દાખલ કરો. આ તમારા ઍપ પાસકોડ અને iCloud બૅકઅપ પાસવર્ડથી અલગ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi jimlar sirri mai ƙarfi ka sake shigar da ita don tabbatarwa. Wannan daban yake da lambar buɗewar manhajarka da kalmar sirrin madadin iCloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור ביטוי סיסמה חזק ולהזין אותו שוב לאימות. הוא נפרד מקוד הגישה ליישום ומסיסמת הגיבוי ב־iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मज़बूत पासफ़्रेज़ चुनें और पुष्टि के लिए दोबारा डालें। यह आपके ऐप पासकोड और iCloud बैकअप पासवर्ड से अलग है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite snažnu tajnu frazu i ponovno je unesite za potvrdu. Ona je odvojena od pristupne šifre aplikacije i lozinke sigurnosne kopije na iCloudu."
          }
        },
        "hu" : {
