        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar ର ନିଶ୍ଚିତକରଣକୁ ଅପେକ୍ଷା କରାଯାଉଛି। ଆପଣଙ୍କ ସ୍ୱାକ୍ଷରିତ କାରବାର ସଂରକ୍ଷିତ ଅଛି; ଆଉ ଏକ କାରବାର ତିଆରି କରନ୍ତୁ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar ਦੀ ਪੁਸ਼ਟੀ ਦੀ ਉਡੀਕ ਹੈ। ਤੁਹਾਡਾ ਦਸਤਖ਼ਤ ਕੀਤਾ ਲੈਣ-ਦੇਣ ਸੰਭਾਲਿਆ ਹੋਇਆ ਹੈ; ਹੋਰ ਨਾ ਬਣਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
