          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই dApp এর আর ওয়ালেটে প্রবেশাধিকার নেই। সংযোগ পেলে Oath আবার তাকে জানানোর চেষ্টা করবে। এখন নিজেও আবার চেষ্টা করতে পারেন।"
