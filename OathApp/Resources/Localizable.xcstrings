        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ලබන්නාට දැනටමත් සක්‍රිය XRP ගිණුමක් තිබිය යුතුය. ගිණුම වසා දැමීමෙන් නව ලබන්නෙකු සක්‍රිය කළ නොහැක. සක්‍රිය ලිපිනයක් තෝරන්න."
