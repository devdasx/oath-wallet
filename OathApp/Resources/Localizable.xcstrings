        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क उपलब्ध XLM किंवा समर्थित शुल्क मर्यादेपेक्षा जास्त आहे."
          }
        },
        "ms" : {
