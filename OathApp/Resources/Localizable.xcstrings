    },
    "electrumAmbiguous" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እነዚህ ቃላት ከሁለቱም ቅርጸቶች ጋር ይዛመዳሉ። ይህ ቦርሳ ሲፈጠር የተጠቀሙበትን ቅርጸት ይምረጡ፤ እያንዳንዱ ቅርጸት የተለያዩ አድራሻዎችን ይመልሳል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوافق هذه الكلمات مع كلتا الصيغتين. اختر الصيغة المستخدمة عند إنشاء هذه المحفظة؛ تستعيد كل صيغة عناوين مختلفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শব্দগুলো দুটি বিন্যাসের সঙ্গেই মেলে। ওয়ালেট তৈরির সময় যে বিন্যাস ব্যবহার করা হয়েছিল, সেটি বেছে নিন; প্রতিটি বিন্যাস আলাদা ঠিকানা পুনরুদ্ধার করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato slova odpovídají oběma formátům. Vyberte formát použitý při vytvoření peněženky; každý formát obnoví jiné adresy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse ord passer til begge formater. Vælg det format, der blev brugt, da tegnebogen blev oprettet. Hvert format gendanner forskellige adresser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wörter passen zu beiden Formaten. Wähle das Format, mit dem diese Wallet erstellt wurde. Jedes Format stellt andere Adressen wieder her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι λέξεις αντιστοιχούν και στις δύο μορφές. Επιλέξτε τη μορφή που χρησιμοποιήθηκε κατά τη δημιουργία αυτού του πορτοφολιού· κάθε μορφή επαναφέρει διαφορετικές διευθύνσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These words match both formats. Select the format used when this wallet was created; each format restores different addresses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas palabras coinciden con ambos formatos. Selecciona el formato que se usó al crear esta cartera; cada formato restaura direcciones diferentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این واژه‌ها با هر دو قالب مطابقت دارند. قالبی را انتخاب کنید که هنگام ساخت این کیف پول استفاده شده است؛ هر قالب آدرس‌های متفاوتی را بازیابی می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä sanat sopivat kumpaankin muotoon. Valitse lompakon luomisessa käytetty muoto, sillä eri muodot palauttavat eri osoitteet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tugma ang mga salitang ito sa parehong format. Piliin ang format na ginamit noong ginawa ang wallet na ito; magkaibang address ang naibabalik ng bawat format."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces mots correspondent aux deux formats. Sélectionnez le format utilisé lors de la création de ce portefeuille : chaque format restaure des adresses différentes."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ શબ્દો બંને સ્વરૂપો સાથે મેળ ખાય છે. આ વૉલેટ બનાવતી વખતે વપરાયેલું સ્વરૂપ પસંદ કરો; દરેક સ્વરૂપ અલગ સરનામાં પુનઃસ્થાપિત કરે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waɗannan kalmomi sun dace da tsarin biyu. Zaɓi tsarin da aka yi amfani da shi lokacin ƙirƙirar wannan walat; kowane tsari yana dawo da adireshi daban-daban."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המילים האלה תואמות לשני הפורמטים. יש לבחור בפורמט ששימש ליצירת הארנק; כל פורמט משחזר כתובות שונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शब्द दोनों प्रारूपों से मेल खाते हैं। वॉलेट बनाते समय इस्तेमाल किया गया प्रारूप चुनें; हर प्रारूप अलग पते पुनर्स्थापित करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ove riječi odgovaraju obama formatima. Odaberite format korišten pri izradi ovog novčanika; svaki format obnavlja različite adrese."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a szavak mindkét formátumnak megfelelnek. Válaszd ki a tárca létrehozásakor használt formátumot; a két formátum eltérő címeket állít helyre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata-kata ini cocok dengan kedua format. Pilih format yang digunakan saat dompet ini dibuat; setiap format memulihkan alamat yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste parole corrispondono a entrambi i formati. Seleziona il formato usato alla creazione di questo portafoglio; ciascun formato ripristina indirizzi diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの単語は両方の形式に一致します。このウォレットの作成時に使用した形式を選択してください。形式によって復元されるアドレスが異なります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს სიტყვები ორივე ფორმატს შეესაბამება. აირჩიეთ ფორმატი, რომელიც საფულის შექმნისას გამოიყენეთ; თითოეული ფორმატი განსხვავებულ მისამართებს აღადგენს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពាក្យទាំងនេះត្រូវនឹងទម្រង់ទាំងពីរ។ ជ្រើសទម្រង់ដែលបានប្រើពេលបង្កើតកាបូបនេះ ព្រោះទម្រង់នីមួយៗស្តារអាសយដ្ឋានផ្សេងគ្នា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಪದಗಳು ಎರಡೂ ಸ್ವರೂಪಗಳಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತವೆ. ಈ ವ್ಯಾಲೆಟ್ ರಚಿಸಿದಾಗ ಬಳಸಿದ ಸ್ವರೂಪವನ್ನು ಆಯ್ಕೆಮಾಡಿ; ಪ್ರತಿ ಸ್ವರೂಪವು ಬೇರೆ ವಿಳಾಸಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단어들은 두 형식 모두에 해당합니다. 지갑을 만들 때 사용한 형식을 선택하세요. 형식에 따라 복구되는 주소가 다릅니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
