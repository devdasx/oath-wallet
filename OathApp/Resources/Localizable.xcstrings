          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez %1$@ sur %2$@. Certains jetons nécessitent une inscription avant réception."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ પર %1$@ મેળવો. કેટલાક ટોકન મેળવતાં પહેલાં નોંધણી જરૂરી છે."
          }
        },
