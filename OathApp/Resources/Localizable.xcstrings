            "value" : "تصديق ڪريو ته هي والٽ توهان جو آهي. دستخط کان اڳ پيغام ڏسو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පසුම්බිය ඔබට අයත් බව තහවුරු කරන්න. අත්සන් කිරීමට පෙර පණිවිඩය සමාලෝචනය කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrďte, že vám táto peňaženka patrí. Pred podpisom skontrolujte správu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrdite, da ta denarnica pripada vam. Pred podpisom preglejte sporočilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekräfta att plånboken tillhör dig. Granska meddelandet innan du signerar."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thibitisha kuwa pochi hii ni yako. Kagua ujumbe kabla ya kusaini."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தப் பணப்பை உங்களுடையது என உறுதிசெய்யவும். கையொப்பமிடும் முன் செய்தியைப் பரிசீலிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ వాలెట్ మీదని నిర్ధారించండి. సంతకం చేసే ముందు సందేశాన్ని సమీక్షించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันว่ากระเป๋านี้เป็นของคุณ ตรวจสอบข้อความก่อนลงนาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cüzdanın size ait olduğunu doğrulayın. İmzalamadan önce mesajı inceleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтвердьте, що цей гаманець належить вам. Перегляньте повідомлення перед підписанням."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصدیق کریں یہ والیٹ آپ کا ہے۔ دستخط سے پہلے پیغام دیکھیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hamyon sizniki ekanini tasdiqlang. Imzolashdan oldin xabarni ko‘rib chiqing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác nhận ví này thuộc về bạn. Xem thông điệp trước khi ký."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jẹ́rìí pé àpamọ́wọ́ yìí jẹ́ tirẹ. Ṣàgbéyẹ̀wò ọ̀rọ̀ náà kí o tó fọwọ́ sí i."
