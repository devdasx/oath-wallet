          "stringUnit" : {
            "state" : "translated",
            "value" : "මුදල් වර්ගය, භාෂාව, පෙනුම, යෙදුම් නිරූපකය සහ වෙනත් මනාප එලෙසම පවතී. බාගත් මිල සහ විනිමය අනුපාත රඳවාගනී."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mena, jazyk, vzhľad, ikona aplikácie a ďalšie predvoľby zostanú rovnaké. Stiahnuté ceny a výmenné kurzy sa zachovajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta, jezik, videz, ikona aplikacije in druge nastavitve ostanejo enaki. Prenesene cene in menjalni tečaji se ohranijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta, språk, utseende, appsymbol och andra appinställningar behålls. Hämtade priser och växelkurser behålls också."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarafu, lugha, mwonekano, aikoni ya programu na mapendeleo mengine ya programu hayatabadilika. Bei na viwango vya ubadilishaji vilivyopakuliwa vitahifadhiwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நாணயம், மொழி, தோற்றம், செயலி சின்னம் மற்றும் பிற செயலி விருப்பங்கள் மாறாது. பதிவிறக்கிய விலைகளும் மாற்று விகிதங்களும் பாதுகாக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కరెన్సీ, భాష, రూపం, యాప్ చిహ్నం, ఇతర యాప్ ప్రాధాన్యతలు అలాగే ఉంటాయి. డౌన్‌లోడ్ చేసిన ధరలు, మారకపు రేట్లు ఉంటాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สกุลเงิน ภาษา รูปลักษณ์ ไอคอนแอป และการตั้งค่าอื่นจะเหมือนเดิม ราคาและอัตราแลกเปลี่ยนที่ดาวน์โหลดไว้จะถูกเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para birimi, dil, görünüm, uygulama simgesi ve diğer uygulama tercihleri aynı kalır. İndirilen fiyatlar ve döviz kurları korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Валюта, мова, вигляд, іконка й інші налаштування застосунку не зміняться. Завантажені ціни та курси валют збережуться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کرنسی، زبان، ظاہری شکل، ایپ آئیکن اور دیگر ترجیحات وہی رہیں گی۔ ڈاؤن لوڈ شدہ قیمتیں اور شرحِ مبادلہ برقرار رہیں گے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valyuta, til, ko‘rinish, ilova belgisi va boshqa sozlamalar o‘zgarmaydi. Yuklangan narxlar va valyuta kurslari saqlanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền tệ, ngôn ngữ, giao diện, biểu tượng ứng dụng và các tùy chọn khác vẫn giữ nguyên. Giá và tỷ giá đã tải vẫn được giữ lại."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owó, èdè, ìrísí, àmì ètò àti àwọn ohun míì tí o fẹ́ yóò dúró bí wọ́n ti wà. A ó pa àwọn iye àti oṣùwọ̀n pàṣípààrọ̀ tí a ti kó wá mọ́."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "货币、语言、外观、应用图标及其他偏好设置保持不变。已下载的价格和汇率会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貨幣、語言、外觀、App 圖像及其他 App 偏好設定都會維持不變。已下載的價格與匯率也會保留。"
          }
        }
      }
    },
