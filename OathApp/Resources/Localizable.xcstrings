        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لعنوان %@ لديك استلام TRX ورموز TRC-20 المتوافقة. استخدم عنوان المحفظة هذا للمستلم، وليس عنوان عقد الرمز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার %@ ঠিকানায় TRX ও উপযুক্ত TRC-20 টোকেন পাওয়া যায়। প্রাপক হিসেবে এই ওয়ালেট ঠিকানা দিন, টোকেন কন্ট্র্যাক্টের ঠিকানা নয়।"
