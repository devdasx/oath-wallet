        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଗକୁ ବଢ଼ିବା ପୂର୍ବରୁ ଏହି ଟ୍ରାନ୍ସଫର ରିଫ୍ରେଶ କରନ୍ତୁ। କିଛି ଦାଖଲ ହୋଇନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਰੀ ਰੱਖਣ ਤੋਂ ਪਹਿਲਾਂ ਟ੍ਰਾਂਸਫ਼ਰ ਤਾਜ਼ਾ ਕਰੋ। ਕੁਝ ਵੀ ਭੇਜਿਆ ਨਹੀਂ ਗਿਆ।"
          }
        },
        "pl" : {
          "stringUnit" : {
