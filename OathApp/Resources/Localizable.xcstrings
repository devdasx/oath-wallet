        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido não tem um valor mínimo de receção. O resultado final poderá ser inferior à estimativa. Volte à dApp para definir a proteção de preço antes de assinar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cerere nu are o sumă minimă de primit. Rezultatul final poate fi mai mic decât această estimare. Revino la dApp pentru a seta protecția de preț înainte de semnare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В запросе нет минимальной суммы получения. Итог может быть ниже оценки. Вернитесь в dApp и задайте защиту цены перед подписью."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هن درخواست ۾ گهٽ ۾ گهٽ وصولي مقدار ناهي. آخري نتيجو هن اندازي کان گهٽ ٿي سگهي ٿو. دستخط کان اڳ قيمت جي حفاظت مقرر ڪرڻ لاءِ dApp ڏانهن موٽو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉල්ලීමට අවම ලැබීම් ප්‍රමාණයක් නැත. අවසන් ලැබීම ඇස්තමේන්තුවට අඩු විය හැක. අත්සන් කිරීමට පෙර මිල ආරක්ෂාව සැකසීමට dApp වෙත ආපසු යන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto požiadavka nemá minimálnu prijímanú sumu. Konečný výstup môže byť nižší ako odhad. Pred podpisom sa vráťte do dApp a nastavte cenovú ochranu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zahteva nima najmanjšega zneska za prejem. Končni izhod je lahko nižji od te ocene. Pred podpisom se vrnite v dApp in nastavite cenovno zaščito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
