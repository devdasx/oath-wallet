    "receive.tron_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የ%@ አድራሻህ TRX እና ተስማሚ TRC-20 ቶከኖችን መቀበል ይችላል። እንደ ተቀባይ ይህን የዋሌት አድራሻ ተጠቀም፣ የቶከኑን ውል አድራሻ አይደለም።"
          }
