        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አውታረ መረቡ ይህን ግብይት በስኬት አላጠናቀቀም። ነገር ግን የአውታረ መረብ ክፍያ ሊኖር ይችላል።"
