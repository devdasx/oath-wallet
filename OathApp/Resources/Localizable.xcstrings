        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ വാലറ്റ് വീണ്ടെടുക്കാനുപയോഗിക്കുന്ന വാക്കുകൾ കാണുക. അവ രഹസ്യമായി സുരക്ഷിതമായിടത്ത് സൂക്ഷിക്കുക."
