        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಖಾಸಗಿ ಕೀಲಿಗೆ ಬೆಂಬಲಿತ ಪ್ರತಿ ವಿಧದಲ್ಲಿ ಒಂದು ವಿಳಾಸವಿದೆ. Oath ಅವೆಲ್ಲವನ್ನೂ ಪರಿಶೀಲಿಸುತ್ತದೆ. ಒಂದೇ ಖಾಸಗಿ ಕೀಲಿಯಿಂದ ಹೊಸ ವಿಳಾಸಗಳ ಸರಣಿಯನ್ನು ಸೃಷ್ಟಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
