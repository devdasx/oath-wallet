        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს შეტყობინება და გადარიცხვა ტრანზაქციის ზომის ზღვარს აჭარბებს. შეცვალეთ თანხა და შეტყობინების შესამოკლებლად გახსენით გადარიცხვის პარამეტრები."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សារ និងការផ្ទេរនេះលើសដែនទំហំប្រតិបត្តិការ។ កែចំនួន ហើយបើកជម្រើសផ្ទេរដើម្បីបន្ថយសារ។"
          }
