        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provizija se krije iz vašega preostalega stanja. Če to ne zadošča, se odšteje od zneska. Pred pošiljanjem preverite točen znesek in provizijo."
