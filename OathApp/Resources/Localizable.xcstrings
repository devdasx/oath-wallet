        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لفظ، لفظن جو انگ يا چيڪ سم صحيح ناهن. اصل بحالي وارو جملو ڏسو ۽ ٻيهر ڪوشش ڪريو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "වචන, වචන ගණන හෝ පරීක්ෂණ එකතුව වලංගු නැත. මුල් ප්‍රතිසාධන වාක්‍ය ඛණ්ඩය පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slová, ich počet alebo kontrolný súčet nie sú platné. Skontrolujte pôvodnú obnovovaciu frázu a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besede, njihovo število ali kontrolna vsota niso veljavni. Preverite izvirno obnovitveno frazo in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden, antalet ord eller kontrollsumman är ogiltiga. Kontrollera den ursprungliga återställningsfrasen och försök igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maneno, idadi ya maneno au cheksamu si halali. Angalia maneno ya kurejesha ya asili na ujaribu tena."
