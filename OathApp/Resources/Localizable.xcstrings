    "reset.wallets_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሁሉም ዋሌቶች፣ የመመለሻ ሐረጎች፣ የግል ቁልፎች፣ የመተግበሪያ መክፈቻ ኮድና የFace ID ማረጋገጫ ከዚህ መተግበሪያ ይወገዳሉ። ዋሌቶችህን እንደገና ለመክፈት የመመለሻ መረጃህ ያስፈልግሃል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال من هذا التطبيق كل محفظة وعبارة استرداد ومفتاح خاص ورمز دخول وبيانات اعتماد Face ID. ستحتاج إلى معلومات الاسترداد للوصول إلى محافظك مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাপ থেকে সব ওয়ালেট, পুনরুদ্ধার বাক্যাংশ, ব্যক্তিগত কী, অ্যাপ পাসকোড ও Face ID পরিচয়তথ্য সরানো হবে। ওয়ালেট আবার খুলতে আপনার পুনরুদ্ধারের তথ্য লাগবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z aplikace se odstraní všechny peněženky, obnovovací fráze, soukromé klíče, přístupový kód aplikace a přihlašovací údaj Face ID. K opětovnému přístupu k peněženkám budete potřebovat údaje pro obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle wallets, gendannelsesfraser, private nøgler, appens PIN-kode og Face ID-oplysninger fjernes fra appen. Du skal bruge dine gendannelsesoplysninger for at få adgang til dine wallets igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Wallets, Wiederherstellungsphrasen, privaten Schlüssel, App-Codes und Face ID-Zugangsdaten werden aus dieser App entfernt. Du brauchst deine Wiederherstellungsdaten, um wieder auf deine Wallets zuzugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε πορτοφόλι, φράση ανάκτησης, ιδιωτικό κλειδί, κωδικός εισόδου και διαπιστευτήριο Face ID θα αφαιρεθεί από αυτή την εφαρμογή. Θα χρειαστείτε τα στοιχεία ανάκτησής σας για να αποκτήσετε ξανά πρόσβαση στα πορτοφόλια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every wallet, recovery phrase, private key, app passcode and Face ID credential will be removed from this app. You will need your recovery information to access your wallets again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de esta app todas las carteras, frases de recuperación, claves privadas, el código de acceso y las credenciales de Face ID. Necesitarás tus datos de recuperación para volver a acceder a tus carteras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همهٔ کیف پول‌ها، عبارت‌های بازیابی، کلیدهای خصوصی، رمز ورود برنامه و اطلاعات احراز هویت Face ID از این برنامه حذف می‌شوند. برای دسترسی دوباره به کیف پول‌ها به اطلاعات بازیابی نیاز دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki lompakot, palautuslauseet, yksityisavaimet, sovelluksen pääsykoodi ja Face ID -tunnistetiedot poistetaan tästä sovelluksesta. Tarvitset palautustietosi päästäksesi lompakkoihisi uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalisin sa app na ito ang bawat wallet, recovery phrase, pribadong key, passcode ng app at kredensyal ng Face ID. Kailangan mo ang impormasyon sa pagbawi para ma-access muli ang mga wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les portefeuilles, phrases de récupération, clés privées, le code d’accès et les identifiants Face ID seront retirés de l’app. Vos informations de récupération seront nécessaires pour accéder à nouveau à vos portefeuilles."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક વૉલેટ, પુનઃપ્રાપ્તિ શબ્દસમૂહ, ખાનગી કી, ઍપ પાસકોડ અને Face ID પ્રમાણપત્ર આ ઍપમાંથી દૂર થશે. તમારા વૉલેટ ફરી ઍક્સેસ કરવા તમારી પુનઃપ્રાપ્તિ માહિતીની જરૂર પડશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za a cire duk walat, jimlar dawo da walat, maɓallin sirri, lambar buɗewar manhaja da shaidar Face ID daga wannan manhajar. Za ka buƙaci bayanan dawo da walat ɗinka don sake shiga walat ɗinka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ארנק, ביטוי שחזור, מפתח פרטי, קוד גישה ופרט אימות של Face ID יוסרו מהיישום הזה. כדי לגשת שוב לארנקים, יידרשו פרטי השחזור שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप से हर वॉलेट, रिकवरी फ़्रेज़, निजी कुंजी, ऐप पासकोड और Face ID क्रेडेंशियल हटा दिए जाएँगे। अपने वॉलेट फिर खोलने के लिए आपको रिकवरी जानकारी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki novčanik, fraza za oporavak, privatni ključ, pristupna šifra aplikacije i Face ID vjerodajnica bit će uklonjeni iz ove aplikacije. Za ponovni pristup novčanicima trebat ćete podatke za oporavak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden tárca, helyreállító szósor, privát kulcs, alkalmazáskód és Face ID-hitelesítő adat eltávolításra kerül az alkalmazásból. A tárcák újbóli eléréséhez szükséged lesz a helyreállítási adataidra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap dompet, frasa pemulihan, kunci privat, kode sandi aplikasi, dan kredensial Face ID akan dihapus dari aplikasi ini. Anda memerlukan informasi pemulihan untuk mengakses dompet lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni wallet, frase di recupero, chiave privata, codice dell'app e credenziale Face ID verrà rimosso dall'app. Per accedere di nuovo ai wallet serviranno le informazioni di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全ウォレット、リカバリーフレーズ、秘密鍵、アプリのパスコード、Face ID認証情報をこのアプリから削除します。再アクセスには復元情報が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ აპიდან წაიშლება ყველა საფულე, აღდგენის ფრაზა, პირადი გასაღები, აპის წვდომის კოდი და Face ID-ის ავტორიზაციის მონაცემი. საფულეებზე ხელახლა წვდომისთვის აღდგენის ინფორმაცია დაგჭირდებათ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "គ្រប់កាបូប ឃ្លាស្ដារ សោឯកជន កូដសម្ងាត់កម្មវិធី និងព័ត៌មានសម្គាល់ Face ID នឹងត្រូវដកពីកម្មវិធីនេះ។ អ្នកត្រូវការព័ត៌មានស្ដារដើម្បីចូលកាបូបម្ដងទៀត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ವ್ಯಾಲೆಟ್, ಮರುಪಡೆಯುವ ನುಡಿಗಟ್ಟು, ಖಾಸಗಿ ಕೀಲಿ, ಆ್ಯಪ್ ಪಾಸ್‌ಕೋಡ್ ಮತ್ತು Face ID ದೃಢೀಕರಣ ಮಾಹಿತಿ ಈ ಆ್ಯಪ್‌ನಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಮತ್ತೆ ವ್ಯಾಲೆಟ್‌ಗಳನ್ನು ಪ್ರವೇಶಿಸಲು ನಿಮ್ಮ ಮರುಪಡೆಯುವ ಮಾಹಿತಿ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 지갑, 복구 구문, 개인 키, 앱 암호 및 Face ID 인증 정보가 이 앱에서 삭제됩니다. 지갑에 다시 접근하려면 복구 정보가 필요합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എല്ലാ വാലറ്റുകളും വീണ്ടെടുക്കൽ വാക്യങ്ങളും സ്വകാര്യ കീകളും ആപ്പ് പാസ്‌കോഡും Face ID പ്രവേശന വിവരങ്ങളും ഈ ആപ്പിൽ നിന്ന് നീക്കം ചെയ്യും. വാലറ്റുകളിൽ വീണ്ടും പ്രവേശിക്കാൻ വീണ്ടെടുക്കൽ വിവരങ്ങൾ ആവശ്യമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक वॉलेट, पुनर्प्राप्ती वाक्यांश, खाजगी की, ॲप पासकोड आणि Face ID प्रवेशमाहिती या ॲपमधून काढली जाईल. वॉलेट पुन्हा वापरण्यासाठी पुनर्प्राप्ती माहिती लागेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua dompet, frasa pemulihan, kunci peribadi, kod laluan aplikasi dan kelayakan Face ID akan dialih keluar daripada aplikasi ini. Anda memerlukan maklumat pemulihan untuk mengakses dompet semula."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပိုက်ဆံအိတ်၊ ပြန်လည်ရယူရေးစကားစု၊ ကိုယ်ပိုင်ကီး၊ အက်ပ်ဝင်ခွင့်ကုဒ်နှင့် Face ID အထောက်အထားအားလုံးကို ဤအက်ပ်မှ ဖယ်ရှားမည်။ ပိုက်ဆံအိတ်များသို့ ပြန်ဝင်ရန် ပြန်လည်ရယူရေးအချက်အလက် လိုအပ်မည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle lommebøker, gjenopprettingsfraser, privatnøkler, appkoden og Face ID-opplysningene fjernes fra denne appen. Du trenger gjenopprettingsinformasjonen for å få tilgang til lommebøkene igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हरेक वालेट, पुनःप्राप्ति वाक्यांश, निजी कुञ्जी, एप पासकोड र Face ID प्रमाण यस एपबाट हटाइनेछ। फेरि वालेट पहुँच गर्न पुनःप्राप्ति जानकारी चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle wallets, herstelzinnen, privésleutels, de app-toegangscode en de Face ID-inloggegevens worden uit deze app verwijderd. Je hebt je herstelgegevens nodig om weer toegang tot je wallets te krijgen."
