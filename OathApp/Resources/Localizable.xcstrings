        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అవసరమైనప్పుడు energy, bandwidth, ఖాతా సక్రియానికి రుసుము మొత్తం రిజర్వు అయింది. అసలు రుసుము తక్కువగా ఉండవచ్చు."
