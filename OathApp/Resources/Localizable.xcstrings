          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ٹوکن اور خرچ کنندہ کے لیے پرانے Permit2 خرچ کی اجازت کے دستخط منسوخ کرتا ہے۔ یہ الگ ٹرانزیکشن ہے اور اس کی موجودہ خرچ کی اجازت یا ہر ممکن آف چین دستخط نہیں ہٹاتی۔"
