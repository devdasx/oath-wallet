          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนรหัสผ่านที่คุณเลือกตอนสำรองกระเป๋านี้ รหัสผ่านมีอย่างน้อย 8 อักขระและต่างจากรหัสปลดล็อกแอป"
