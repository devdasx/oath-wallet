        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોન્ટ્રેક્ટ અથવા મિન્ટ સરનામું તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duba adireshin kwangila ko mint ka sake gwadawa."
