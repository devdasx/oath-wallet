    "multisigTronReadyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON የዚህን ቦርሳ የፊርማ ደንቦች አረጋግጧል። የባለቤት እና የዝውውር ፈቃዶች ሁለቱም የተመረጠውን የቁልፎች ብዛት ይፈልጋሉ። የሁሉም ፈራሚዎች ቁልፎች በዚህ መሣሪያ ላይ ይቀመጣሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكدت شبكة TRON قواعد توقيع هذه المحفظة. تتطلب صلاحيات المالك والتحويل العدد المحدد من المفاتيح. جميع مفاتيح التوقيع مخزّنة على هذا الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON এই ওয়ালেটের স্বাক্ষরের নিয়ম নিশ্চিত করেছে। মালিকানা ও স্থানান্তর, উভয় অনুমতির জন্যই বেছে নেওয়া সংখ্যক কী প্রয়োজন। সব স্বাক্ষরকারীর কী এই ডিভাইসে রাখা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON potvrdil pravidla podepisování této peněženky. Oprávnění vlastníka i převodů vyžadují zvolený počet klíčů. Všechny klíče podepisujících jsou uloženy v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON har bekræftet tegnebogens signaturregler. Både ejer- og overførselstilladelser kræver det valgte antal nøgler. Alle underskrivernes nøgler gemmes på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON hat die Signaturregeln dieser Wallet bestätigt. Sowohl Eigentümer- als auch Übertragungsberechtigungen erfordern die gewählte Anzahl an Schlüsseln. Alle Unterzeichnerschlüssel werden auf diesem Gerät gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το TRON επιβεβαίωσε τους κανόνες υπογραφών αυτού του πορτοφολιού. Τόσο τα δικαιώματα κατόχου όσο και τα δικαιώματα μεταφοράς απαιτούν τον επιλεγμένο αριθμό κλειδιών. Όλα τα κλειδιά των υπογραφόντων αποθηκεύονται σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON has confirmed this wallet’s signature rules. Both owner and transfer permissions require the selected number of keys. All signer keys are stored on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ha confirmado las reglas de firma de esta cartera. Tanto los permisos de propietario como los de transferencia requieren el número de claves seleccionado. Todas las claves de los firmantes se guardan en este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON قواعد امضای این کیف پول را تأیید کرده است. مجوزهای مالک و انتقال، هر دو به تعداد کلیدهای انتخاب‌شده نیاز دارند. همهٔ کلیدهای امضاکنندگان روی این دستگاه ذخیره می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON on vahvistanut tämän lompakon allekirjoitussäännöt. Sekä omistajan että siirtojen käyttöoikeudet vaativat valitun määrän avaimia. Kaikki allekirjoittajien avaimet tallennetaan tälle laitteelle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakumpirma na ng TRON ang mga panuntunan sa paglagda ng wallet na ito. Parehong nangangailangan ng piniling bilang ng mga key ang mga pahintulot ng may-ari at ng paglilipat. Nakaimbak sa device na ito ang lahat ng key ng mga lumalagda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON a confirmé les règles de signature de ce portefeuille. Les autorisations de propriétaire et de transfert exigent toutes deux le nombre de clés sélectionné. Toutes les clés des signataires sont stockées sur cet appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON એ આ વૉલેટના હસ્તાક્ષરના નિયમોની પુષ્ટિ કરી છે. માલિકી અને ટ્રાન્સફર બંને પરવાનગીઓ માટે પસંદ કરેલી સંખ્યા જેટલી કીઓ જરૂરી છે. બધા હસ્તાક્ષરકર્તાઓની કીઓ આ ઉપકરણ પર સંગ્રહિત છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ya tabbatar da ƙa'idojin sa hannu na wannan walat. Izinin mai asusu da na turawa duka suna buƙatar adadin maɓallan da aka zaɓa. Ana adana duk maɓallan masu sa hannu a wannan na'urar."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON אישרה את כללי החתימה של הארנק הזה. גם הרשאות הבעלים וגם הרשאות ההעברה דורשות את מספר המפתחות שנבחר. כל מפתחות החותמים מאוחסנים במכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ने इस वॉलेट के हस्ताक्षर नियमों की पुष्टि कर दी है। मालिक और ट्रांसफ़र, दोनों अनुमतियों के लिए चुनी हुई संख्या में कुंजियाँ चाहिए। सभी हस्ताक्षरकर्ताओं की कुंजियाँ इस डिवाइस पर रखी जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON je potvrdio pravila potpisivanja ovog novčanika. I vlasničke dozvole i dozvole za prijenos zahtijevaju odabrani broj ključeva. Svi ključevi potpisnika pohranjeni su na ovom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TRON megerősítette a tárca aláírási szabályait. A tulajdonosi és az átutalási jogosultságokhoz is a kiválasztott számú kulcs szükséges. Minden aláíró kulcsa ezen az eszközön tárolódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON telah mengonfirmasi aturan tanda tangan dompet ini. Izin pemilik maupun transfer mewajibkan jumlah kunci yang dipilih. Semua kunci penanda tangan disimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ha confermato le regole di firma di questo portafoglio. Sia le autorizzazioni del proprietario sia quelle di trasferimento richiedono il numero di chiavi selezionato. Tutte le chiavi dei firmatari sono salvate su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON がこのウォレットの署名ルールを承認しました。所有者権限にも送金権限にも、選択した数のキーが必要です。すべての署名者のキーはこのデバイスに保存されています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON-მა დაადასტურა ამ საფულის ხელმოწერის წესები. როგორც მფლობელის, ისე გადარიცხვის ნებართვები გასაღებების არჩეულ რაოდენობას მოითხოვს. ყველა ხელმომწერის გასაღები ამ მოწყობილობაზე ინახება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON បានបញ្ជាក់ច្បាប់ហត្ថលេខារបស់កាបូបនេះ។ ទាំងសិទ្ធិម្ចាស់ និងសិទ្ធិផ្ទេរតម្រូវឱ្យមានសោតាមចំនួនដែលបានជ្រើស។ សោអ្នកចុះហត្ថលេខាទាំងអស់ត្រូវបានរក្សាទុកលើឧបករណ៍នេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ವ್ಯಾಲೆಟ್‌ನ ಸಹಿ ನಿಯಮಗಳನ್ನು TRON ದೃಢೀಕರಿಸಿದೆ. ಮಾಲೀಕತ್ವ ಮತ್ತು ವರ್ಗಾವಣೆ ಅನುಮತಿಗಳೆರಡಕ್ಕೂ ಆಯ್ಕೆಮಾಡಿದ ಸಂಖ್ಯೆಯ ಕೀಗಳು ಅಗತ್ಯ. ಎಲ್ಲಾ ಸಹಿದಾರರ ಕೀಗಳನ್ನು ಈ ಸಾಧನದಲ್ಲಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON이 이 지갑의 서명 규칙을 확인했습니다. 소유자 권한과 전송 권한 모두 선택한 수의 키를 요구합니다. 모든 서명자 키는 이 기기에 저장됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ വാലറ്റിന്റെ ഒപ്പ് നിയമങ്ങൾ TRON സ്ഥിരീകരിച്ചു. ഉടമസ്ഥ അനുമതികൾക്കും കൈമാറ്റ അനുമതികൾക്കും തിരഞ്ഞെടുത്ത എണ്ണത്തിലുള്ള കീകൾ ആവശ്യമാണ്. ഒപ്പിടുന്നവരുടെ എല്ലാ കീകളും ഈ ഉപകരണത്തിലാണ് സൂക്ഷിക്കുന്നത്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ने या वॉलेटच्या स्वाक्षरीच्या नियमांची पुष्टी केली आहे. मालकी आणि हस्तांतरण या दोन्ही परवानग्यांसाठी निवडलेल्या संख्येइतक्या कळा आवश्यक आहेत. सर्व स्वाक्षरीकर्त्यांच्या कळा या उपकरणावर साठवल्या जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON telah mengesahkan peraturan tandatangan dompet ini. Kebenaran pemilik dan pindahan kedua-duanya memerlukan bilangan kunci yang dipilih. Semua kunci penandatangan disimpan pada peranti ini."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON က ဤပိုက်ဆံအိတ်၏လက်မှတ်စည်းမျဉ်းများကို အတည်ပြုပြီးပါပြီ။ ပိုင်ရှင်နှင့် ငွေလွှဲလုပ်ပိုင်ခွင့် နှစ်မျိုးလုံးအတွက် ရွေးထားသောသော့အရေအတွက် လိုအပ်သည်။ လက်မှတ်ထိုးသူသော့အားလုံးကို ဤစက်တွင် သိမ်းထားသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON har bekreftet signaturreglene for denne lommeboken. Både eier- og overføringstillatelser krever det valgte antallet nøkler. Alle signatarnøkler lagres på denne enheten."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ले यस वालेटका हस्ताक्षर नियमहरू पुष्टि गरेको छ। मालिक र स्थानान्तरण दुवै अनुमतिका लागि छानिएको संख्यामा कुञ्जीहरू चाहिन्छन्। सबै हस्ताक्षरकर्ताका कुञ्जीहरू यस उपकरणमा भण्डारण गरिएका छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON heeft de ondertekeningsregels van deze wallet bevestigd. Zowel eigenaarsrechten als overdrachtsrechten vereisen het gekozen aantal sleutels. Alle sleutels van ondertekenaars worden op dit apparaat opgeslagen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ଏହି ୱାଲେଟ୍‌ର ସ୍ୱାକ୍ଷର ନିୟମ ନିଶ୍ଚିତ କରିଛି। ମାଲିକାନା ଓ ସ୍ଥାନାନ୍ତର ଅନୁମତି ଉଭୟ ପାଇଁ ବାଛିଥିବା ସଂଖ୍ୟକ କୀ ଆବଶ୍ୟକ। ସମସ୍ତ ସ୍ୱାକ୍ଷରକାରୀଙ୍କ କୀ ଏହି ଡିଭାଇସରେ ସଂରକ୍ଷିତ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ਨੇ ਇਸ ਵਾਲਿਟ ਦੇ ਦਸਤਖ਼ਤਾਂ ਦੇ ਨਿਯਮਾਂ ਦੀ ਪੁਸ਼ਟੀ ਕਰ ਦਿੱਤੀ ਹੈ। ਮਾਲਕੀ ਅਤੇ ਟ੍ਰਾਂਸਫਰ ਦੋਵਾਂ ਇਜਾਜ਼ਤਾਂ ਲਈ ਚੁਣੀ ਗਿਣਤੀ ਦੀਆਂ ਕੁੰਜੀਆਂ ਚਾਹੀਦੀਆਂ ਹਨ। ਸਾਰੀਆਂ ਦਸਤਖ਼ਤਕਰਤਾ ਕੁੰਜੀਆਂ ਇਸ ਡਿਵਾਈਸ ਉੱਤੇ ਸਟੋਰ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON potwierdziła zasady podpisywania tego portfela. Zarówno uprawnienia właściciela, jak i uprawnienia do przelewów wymagają wybranej liczby kluczy. Wszystkie klucze podpisujących są przechowywane na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON confirmou as regras de assinatura desta carteira. Tanto as permissões de proprietário quanto as de transferência exigem o número de chaves selecionado. Todas as chaves dos signatários ficam neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON confirmou as regras de assinatura desta carteira. Tanto as permissões de proprietário como as de transferência exigem o número de chaves selecionado. Todas as chaves dos signatários ficam neste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON a confirmat regulile de semnare ale acestui portofel. Atât permisiunile de proprietar, cât și cele de transfer necesită numărul de chei selectat. Toate cheile semnatarilor sunt stocate pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON подтвердила правила подписания этого кошелька. И полномочия владельца, и разрешения на переводы требуют выбранного количества ключей. Все ключи подписантов хранятся на этом устройстве."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON هن والٽ جي صحيحن جي ضابطن جي تصديق ڪئي آهي. مالڪ ۽ منتقلي جي ٻنهي اجازتن لاءِ چونڊيل تعداد ۾ ڪنجيون گهرجن. سڀني صحيح ڪندڙن جون ڪنجيون هن ڊوائيس تي محفوظ آهن."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON මෙම පසුම්බියේ අත්සන් නීති තහවුරු කර ඇත. හිමිකරු සහ මාරු අවසර දෙකටම තෝරාගත් යතුරු ගණන අවශ්‍යයි. සියලු අත්සන්කරුවන්ගේ යතුරු මෙම උපාංගයේ ගබඩා වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON potvrdil pravidlá podpisovania tejto peňaženky. Oprávnenia vlastníka aj prevodov vyžadujú zvolený počet kľúčov. Všetky kľúče podpisujúcich sú uložené v tomto zariadení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON je potrdil pravila podpisovanja te denarnice. Tako lastniška dovoljenja kot dovoljenja za prenose zahtevajo izbrano število ključev. Vsi ključi podpisnikov so shranjeni v tej napravi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON har bekräftat plånbokens signaturregler. Både ägar- och överföringsbehörigheter kräver det valda antalet nycklar. Alla undertecknares nycklar lagras på den här enheten."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON imethibitisha masharti ya sahihi ya pochi hii. Ruhusa za mmiliki na za kuhamisha zote zinahitaji idadi ya funguo iliyochaguliwa. Funguo zote za watia sahihi zinahifadhiwa kwenye kifaa hiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த வாலட்டின் கையொப்ப விதிகளை TRON உறுதிப்படுத்தியுள்ளது. உரிமையாளர் மற்றும் பரிமாற்ற அனுமதிகள் இரண்டிற்கும் தேர்ந்தெடுத்த எண்ணிக்கையிலான விசைகள் தேவை. கையொப்பமிடுபவர்களின் அனைத்து விசைகளும் இந்தச் சாதனத்தில் சேமிக்கப்படுகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ వాలెట్ సంతకాల నియమాలను TRON నిర్ధారించింది. యజమాని, బదిలీ అనుమతులు రెండింటికీ ఎంచుకున్న సంఖ్యలో కీలు అవసరం. సంతకదారుల కీలు అన్నీ ఈ పరికరంలో నిల్వ చేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ยืนยันข้อกำหนดลายเซ็นของกระเป๋านี้แล้ว ทั้งสิทธิ์เจ้าของและสิทธิ์โอนต้องใช้คีย์ตามจำนวนที่เลือก คีย์ของผู้ลงนามทั้งหมดเก็บอยู่ในอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON, bu cüzdanın imza kurallarını onayladı. Hem sahip hem transfer izinleri seçilen sayıda anahtar gerektirir. Tüm imzalayan anahtarları bu cihazda saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON підтвердила правила підписання цього гаманця. І повноваження власника, і дозволи на перекази вимагають вибраної кількості ключів. Усі ключі підписантів зберігаються на цьому пристрої."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON نے اس والیٹ کے دستخط کے قواعد کی تصدیق کر دی ہے۔ مالک اور منتقلی، دونوں اجازتوں کے لیے منتخب تعداد میں کلیدیں درکار ہیں۔ تمام دستخط کنندگان کی کلیدیں اس آلے پر محفوظ ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON bu hamyonning imzo qoidalarini tasdiqladi. Egasi va oʻtkazma ruxsatlarining ikkalasi ham tanlangan miqdordagi kalitlarni talab qiladi. Barcha imzolovchi kalitlari shu qurilmada saqlanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON đã xác nhận quy tắc chữ ký của ví này. Cả quyền chủ sở hữu và quyền chuyển tiền đều yêu cầu số khóa đã chọn. Mọi khóa của người ký đều được lưu trên thiết bị này."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON ti jẹ́rìí àwọn òfin ìbuwọ́lu àpamọ́wọ́ yìí. Àṣẹ oníni àti àṣẹ gbígbé owó méjèèjì nílò iye kọ́kọ́rọ́ tí a yàn. A pa gbogbo kọ́kọ́rọ́ olùfọwọ́sí mọ́ lórí ẹ̀rọ yìí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRON 已确认此钱包的签名规则。所有者权限和转账权限都需要所选数量的密钥。所有签名者的密钥都存储在此设备上。"
