    "recovery_view.never_share_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የOath ድጋፍ ሰጪዎች የመመለሻ ሐረግህን ፈጽሞ አይጠይቁህም። በድረ ገጾች አታስገባው፣ ለማንምም አትላከው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يطلب دعم Oath عبارة استردادك أبدًا. لا تُدخلها في مواقع الإنترنت ولا ترسلها لأحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath সহায়তা কখনও আপনার পুনরুদ্ধার বাক্যাংশ চাইবে না। এটি ওয়েবসাইটে লিখবেন না বা কাউকে পাঠাবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpora Oath nikdy nebude chtít vaši obnovovací frázi. Nezadávejte ji na webech ani ji nikomu neposílejte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath-support vil aldrig bede om din gendannelsesfrase. Indtast den ikke på websteder, og send den ikke til nogen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Oath-Support fragt niemals nach deiner Wiederherstellungsphrase. Gib sie nicht auf Websites ein und sende sie niemandem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υποστήριξη του Oath δεν θα ζητήσει ποτέ τη φράση ανάκτησής σας. Μην την εισάγετε σε ιστοτόπους και μην τη στείλετε σε κανέναν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath support will never ask for your recovery phrase. Do not enter it on websites or send it to anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El soporte de Oath nunca te pedirá tu frase de recuperación. No la introduzcas en sitios web ni la envíes a nadie."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبانی Oath هرگز عبارت بازیابی شما را نمی‌خواهد. آن را در وب‌سایت‌ها وارد نکنید و برای کسی نفرستید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath-tuki ei koskaan pyydä palautuslausettasi. Älä kirjoita sitä verkkosivuille tai lähetä kenellekään."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi kailanman hihingin ng Oath support ang recovery phrase mo. Huwag itong ilagay sa mga website o ipadala kaninuman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistance Oath ne vous demandera jamais votre phrase de récupération. Ne la saisissez pas sur un site et ne l’envoyez à personne."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath સહાય વિભાગ ક્યારેય તમારો પુનઃપ્રાપ્તિ શબ્દસમૂહ માગશે નહીં. તે વેબસાઇટ પર દાખલ કરશો નહીં કે કોઈને મોકલશો નહીં."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masu tallafin Oath ba za su taɓa tambayar jimlar dawo da walat ɗinka ba. Kada ka shigar da ita a shafukan yanar gizo ko aika ta ga kowa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמיכה של Oath לעולם לא תבקש את ביטוי השחזור שלך. אין להזין אותו באתרים או לשלוח אותו לאיש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath सहायता टीम आपका रिकवरी फ़्रेज़ कभी नहीं माँगेगी। इसे वेबसाइट पर न डालें और किसी को न भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrška aplikacije Oath nikada neće tražiti vašu frazu za oporavak. Nemojte je unositi na web-stranice ni slati drugima."
          }
        },
        "hu" : {
