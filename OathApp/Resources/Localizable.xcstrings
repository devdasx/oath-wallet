    "multisigStellarKeyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በS የሚጀምር የStellar ሚስጥራዊ ዘር ያስገቡ። ይፋዊ አድራሻዎች መፈረም አይችሉም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل بذرة Stellar سرّية تبدأ بالحرف S. لا يمكن التوقيع باستخدام العناوين العامة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S দিয়ে শুরু হওয়া একটি Stellar গোপন সিড লিখুন। সর্বজনীন ঠিকানা দিয়ে স্বাক্ষর করা যায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte tajný počáteční klíč Stellar začínající na S. Veřejné adresy nemohou podepisovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast et hemmeligt Stellar-seed, der begynder med S. Offentlige adresser kan ikke underskrive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen geheimen Stellar-Seed ein, der mit S beginnt. Öffentliche Adressen können nicht signieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε ένα μυστικό αρχικό κλειδί Stellar που αρχίζει με S. Οι δημόσιες διευθύνσεις δεν μπορούν να υπογράψουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a Stellar secret seed starting with S. Public addresses cannot sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una semilla secreta Stellar que empiece por S. Las direcciones públicas no pueden firmar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بذر محرمانهٔ Stellar را که با S شروع می‌شود وارد کنید. با آدرس‌های عمومی نمی‌توان امضا کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna S-kirjaimella alkava Stellar-siemenavain. Julkisilla osoitteilla ei voi allekirjoittaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maglagay ng lihim na seed ng Stellar na nagsisimula sa S. Hindi maaaring lumagda ang mga pampublikong address."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une graine secrète Stellar commençant par S. Les adresses publiques ne permettent pas de signer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S થી શરૂ થતું Stellar ગુપ્ત સીડ દાખલ કરો. જાહેર સરનામાં હસ્તાક્ષર કરી શકતાં નથી."
          }
        },
        "ha" : {
