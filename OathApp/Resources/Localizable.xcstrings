    "scannerPausedDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝግጁ ስትሆን ወደ ስካን ተመለስ። ፎቶዎች ወይም ለጥፍ መጠቀምም ትችላለህ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُد للمسح عندما تكون جاهزًا. يمكنك أيضًا استخدام الصور أو اللصق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রস্তুত হলে স্ক্যান চালু করুন। ছবি বা পেস্টও ব্যবহার করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke skenování se vraťte, až budete připraveni. Můžete také použít Fotky nebo Vložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genoptag scanning, når du er klar. Du kan også bruge Fotos eller Indsæt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze das Scannen fort, sobald du bereit bist. Du kannst auch „Fotos“ oder „Einfügen“ nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιστρέψτε στη σάρωση όταν είστε έτοιμοι. Μπορείτε επίσης να χρησιμοποιήσετε Φωτογραφίες ή Επικόλληση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return to scanning when you’re ready. You can also use Photos or Paste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a escanear cuando estés listo. También puedes usar Fotos o Pegar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر زمان آماده بودید به اسکن برگردید. همچنین می‌توانید از عکس‌ها یا چسباندن استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka skannaamista, kun olet valmis. Voit myös käyttää Kuvat- tai Liitä-toimintoa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumalik sa pag-scan kapag handa ka na. Maaari mo ring gamitin ang Mga Larawan o I-paste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez le scan quand vous le souhaitez. Vous pouvez aussi utiliser Photos ou Coller."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તૈયાર થાઓ ત્યારે સ્કૅનિંગ પર પાછા આવો. તમે ફોટા અથવા પેસ્ટ પણ વાપરી શકો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koma dubawa idan ka shirya. Haka kuma za ka iya amfani da Hotuna ko Manna."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לחזור לסריקה כשיהיה לך נוח. אפשר גם להשתמש בתמונות או בהדבקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तैयार होने पर स्कैनिंग पर लौटें। फ़ोटो या पेस्ट भी इस्तेमाल कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vratite se skeniranju kada budete spremni. Možete koristiti i Fotografije ili Zalijepi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Térj vissza a beolvasáshoz, amikor készen állsz. A Fotók vagy Beillesztés lehetőséget is használhatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali memindai saat Anda siap. Anda juga dapat menggunakan Foto atau Tempel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi la scansione quando sei pronto. Puoi anche usare Foto o Incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたらスキャンを再開してください。「写真」や「ペースト」も使えます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როცა მზად იქნებით, დაუბრუნდით სკანირებას. ასევე შეგიძლიათ გამოიყენოთ ფოტოები ან ჩასმა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ត្រឡប់ទៅស្កេនពេលអ្នករួចរាល់។ អ្នកក៏អាចប្រើរូបថត ឬបិទភ្ជាប់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಿದ್ಧರಾದಾಗ ಸ್ಕ್ಯಾನಿಂಗ್‌ಗೆ ಹಿಂತಿರುಗಿ. ಫೋಟೋಗಳು ಅಥವಾ ಅಂಟಿಸಿ ಆಯ್ಕೆಯನ್ನೂ ಬಳಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비되면 스캔으로 돌아오세요. 사진이나 붙여넣기를 사용할 수도 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തയ്യാറാകുമ്പോൾ സ്കാനിങ്ങിലേക്ക് മടങ്ങുക. ഫോട്ടോകളോ ഒട്ടിക്കുക എന്ന ഓപ്ഷനോ ഉപയോഗിക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तयार असताना स्कॅनिंगकडे परत या. फोटो किंवा पेस्टही वापरू शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambung mengimbas apabila bersedia. Anda juga boleh menggunakan Foto atau Tampal."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အသင့်ဖြစ်လျှင် စကင်ဖတ်ခြင်းသို့ ပြန်သွားပါ။ ဓာတ်ပုံများ သို့မဟုတ် ကူးထည့်ခြင်းကိုလည်း သုံးနိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett skanningen når du er klar. Du kan også bruke Bilder eller Lim inn."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तयार भएपछि स्क्यानमा फर्कनुहोस्। फोटो वा टाँस्ने सुविधा पनि प्रयोग गर्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga verder met scannen wanneer je klaar bent. Je kunt ook Foto's of Plakken gebruiken."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରସ୍ତୁତ ହେଲେ ସ୍କାନିଂକୁ ଫେରନ୍ତୁ। ଫଟୋ କିମ୍ବା ପେଷ୍ଟ ମଧ୍ୟ ବ୍ୟବହାର କରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤਿਆਰ ਹੋਣ 'ਤੇ ਮੁੜ ਸਕੈਨ ਕਰੋ। ਫ਼ੋਟੋਆਂ ਜਾਂ ਪੇਸਟ ਵੀ ਵਰਤ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć do skanowania, gdy będziesz gotowy. Możesz także użyć Zdjęć lub opcji Wklej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte a escanear quando quiser. Você também pode usar Fotos ou Colar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retome a leitura quando quiser. Também pode utilizar Fotografias ou Colar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reia scanarea când ești gata. Poți folosi și Poze sau Lipește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь к сканированию, когда будете готовы. Также можно использовать фото или вставку."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جڏهن تيار ٿيو ته اسڪين ڏانهن واپس اچو. تصويرون يا پيسٽ به استعمال ڪري سگهو ٿا."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සූදානම් විට ස්කෑන් කිරීමට ආපසු යන්න. ඡායාරූප හෝ අලවන්නද භාවිත කළ හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku skenovaniu sa vráťte, keď budete pripravení. Môžete tiež použiť Fotky alebo Vložiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko boste pripravljeni, nadaljujte skeniranje. Uporabite lahko tudi Fotografije ali Prilepi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återgå till skanningen när du är redo. Du kan också använda Bilder eller Klistra in."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rudi kuchanganua ukiwa tayari. Unaweza pia kutumia Picha au Bandika."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தயாரானதும் ஸ்கேனிங்கிற்குத் திரும்பவும். படங்கள் அல்லது ஒட்டு என்பதையும் பயன்படுத்தலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సిద్ధమైనప్పుడు స్కానింగ్‌కు తిరిగి రండి. ఫోటోలు లేదా పేస్ట్ కూడా వాడవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลับมาสแกนเมื่อพร้อม คุณยังใช้รูปภาพหรือวางได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olduğunuzda taramaya dönün. Fotoğraflar'ı veya Yapıştır'ı da kullanabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поверніться до сканування, коли будете готові. Також можна використати Фото або вставлення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تیار ہوں تو اسکیننگ پر واپس آئیں۔ تصاویر یا پیسٹ بھی استعمال کر سکتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tayyor bo‘lgach skanerlashga qayting. Suratlar yoki Joylash dan ham foydalanishingiz mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quay lại quét khi bạn sẵn sàng. Bạn cũng có thể dùng Ảnh hoặc Dán."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padà sí àyẹ̀wò nígbà tí o bá ṣetán. O tún lè lo Fọ́tò tàbí Lẹ̀ mọ́ ọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好后可继续扫描。您也可以使用“照片”或“粘贴”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備好後即可繼續掃描。您也可以使用「照片」或「貼上」。"
          }
        }
      }
    },
