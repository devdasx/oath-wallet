        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাকাউন্টের অর্পিত কোড মুছে দেয়। টোকেনের অনুমোদন আলাদা থাকে। এতে সম্পদ স্থানান্তর হয় না; নেটওয়ার্ক ফি কাটে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní delegovaný kód z tohoto účtu. Schválení tokenů zůstávají samostatná. Aktiva se tím nepřevádějí; síť účtuje poplatek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner delegeret kode fra denne konto. Tokengodkendelser håndteres separat. Dette overfører ikke aktiver; netværket opkræver et gebyr."
