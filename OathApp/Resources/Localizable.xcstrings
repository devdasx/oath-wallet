        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath هرگز آن را از شما نمی‌خواهد. برای کسی نفرستید، در وب‌سایتی نچسبانید و با پشتیبانی به اشتراک نگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
