        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම TRON ගිණුම සක්‍රිය කිරීමට TRX ලබා ගන්න. TRC-20 මාරු පමණක් එය සක්‍රිය නොකරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
