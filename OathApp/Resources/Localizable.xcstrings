        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සෑම යතුරක්ම සහ අවශ්‍ය අත්සන් ගණන සුරකින්න. මෙම පසුම්බිය ප්‍රතිසාධනය කිරීමට දෙකම අවශ්‍යයි."
