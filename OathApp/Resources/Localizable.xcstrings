        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هن مرحلي لاءِ نيٽ ورڪ جي تصديق جو انتظار آهي. تصديق کان پوءِ ايندڙ مرحلو دستياب ٿيندو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ජාලය මෙම පියවර තහවුරු කරන තුරු බලා සිටී. තහවුරු කිරීමෙන් පසු ඊළඟ පියවර ලබාගත හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaká sa na potvrdenie tohto kroku sieťou. Ďalší krok bude dostupný po potvrdení."
