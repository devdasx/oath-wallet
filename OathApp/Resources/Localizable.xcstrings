    "wcNetworkUnavailableDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath በዝርዝሩ ያሉትን አውታረ መረቦች ይደግፋል። dApp የራሱን አውታረ መረብ ወይም RPC አድራሻ መጨመር አይችልም። ወደ dApp ተመለስና የሚደገፍ አውታረ መረብ ምረጥ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم Oath الشبكات المدرجة فيه. لا يمكن لتطبيق لامركزي إضافة شبكته أو عنوان RPC الخاص به. عُد إلى التطبيق واختر شبكة مدعومة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath তার তালিকার নেটওয়ার্ক সমর্থন করে। dApp নিজস্ব নেটওয়ার্ক বা RPC ঠিকানা যোগ করতে পারে না। dApp এ ফিরে সমর্থিত নেটওয়ার্ক নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath podporuje uvedené sítě. dApp nemůže přidat vlastní síť ani adresu RPC. Vraťte se do dApp a vyberte podporovanou síť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath understøtter de viste netværk. En dApp kan ikke tilføje sit eget netværk eller sin egen RPC-adresse. Vend tilbage til dAppen, og vælg et understøttet netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath unterstützt die aufgeführten Netzwerke. Eine dApp kann kein eigenes Netzwerk oder RPC hinzufügen. Kehre zur dApp zurück und wähle ein unterstütztes Netzwerk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Oath υποστηρίζει τα δίκτυα που παραθέτει. Μια dApp δεν μπορεί να προσθέσει δικό της δίκτυο ή διεύθυνση RPC. Επιστρέψτε στη dApp και επιλέξτε υποστηριζόμενο δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath supports its listed networks. A dApp cannot add its own network or RPC address. Return to the dApp and choose a supported network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath admite las redes de su lista. Una dApp no puede añadir su propia red o dirección RPC. Vuelve a la dApp y elige una red admitida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath از شبکه‌های فهرست‌شدهٔ خود پشتیبانی می‌کند. برنامهٔ غیرمتمرکز نمی‌تواند شبکه یا نشانی RPC خودش را اضافه کند. به برنامه برگردید و شبکه‌ای پشتیبانی‌شده انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath tukee lueteltuja verkkojaan. dApp ei voi lisätä omaa verkkoa tai RPC-osoitetta. Palaa dAppiin ja valitse tuettu verkko."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinusuportahan ng Oath ang mga network sa listahan nito. Hindi maaaring magdagdag ng sariling network o RPC address ang dApp. Bumalik sa dApp at pumili ng suportadong network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath prend en charge les réseaux de sa liste. Une dApp ne peut pas ajouter son propre réseau ou adresse RPC. Retournez dans la dApp et choisissez un réseau pris en charge."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath પોતાની સૂચિમાંનાં નેટવર્ક સમર્થન કરે છે. dApp પોતાનું નેટવર્ક અથવા RPC સરનામું ઉમેરી શકતું નથી. dApp પર પાછા જઈને સમર્થિત નેટવર્ક પસંદ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath yana tallafa wa hanyoyin sadarwar da ya jera. dApp ba zai iya ƙara nasa hanyar sadarwa ko adireshin RPC ba. Koma dApp ka zaɓi hanyar sadarwar da ake tallafa wa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath תומכת ברשתות שמופיעות ברשימה שלה. ה־dApp אינו יכול להוסיף רשת או כתובת RPC משלו. יש לחזור ל־dApp ולבחור רשת נתמכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath अपनी सूची के नेटवर्क समर्थित करता है। dApp अपना नेटवर्क या RPC पता नहीं जोड़ सकता। dApp पर लौटकर समर्थित नेटवर्क चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath podržava navedene mreže. dApp aplikacija ne može dodati vlastitu mrežu ni RPC adresu. Vratite se u dApp aplikaciju i odaberite podržanu mrežu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Oath a felsorolt hálózatokat támogatja. A dApp nem adhat hozzá saját hálózatot vagy RPC-címet. Térj vissza a dApphoz, és válassz támogatott hálózatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath mendukung jaringan yang tercantum. dApp tidak dapat menambahkan jaringan atau alamat RPC sendiri. Kembali ke dApp dan pilih jaringan yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath supporta le reti elencate. Una dApp non può aggiungere una propria rete o un indirizzo RPC. Torna alla dApp e scegli una rete supportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oathは一覧のネットワークに対応します。dAppが独自ネットワークやRPCアドレスを追加することはできません。戻って対応ネットワークを選んでください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ჩამოთვლილ ქსელებს უჭერს მხარს. dApp საკუთარ ქსელს ან RPC მისამართს ვერ დაამატებს. დაბრუნდით dApp-ში და მხარდაჭერილი ქსელი აირჩიეთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath គាំទ្របណ្ដាញក្នុងបញ្ជី។ dApp មិនអាចបន្ថែមបណ្ដាញ ឬអាសយដ្ឋាន RPC ផ្ទាល់ខ្លួន។ ត្រឡប់ទៅ dApp ហើយជ្រើសបណ្ដាញដែលគាំទ្រ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ತನ್ನ ಪಟ್ಟಿಯಲ್ಲಿರುವ ನೆಟ್‌ವರ್ಕ್‌ಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ. dApp ತನ್ನದೇ ನೆಟ್‌ವರ್ಕ್ ಅಥವಾ RPC ವಿಳಾಸ ಸೇರಿಸಲಾಗುವುದಿಲ್ಲ. dApp ಗೆ ಹಿಂತಿರುಗಿ ಬೆಂಬಲಿತ ನೆಟ್‌ವರ್ಕ್ ಆಯ್ಕೆ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
