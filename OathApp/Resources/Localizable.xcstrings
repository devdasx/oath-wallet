    "asset.filter.value_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ገደብ ካልፈለግህ የገደቡን ቦታ ባዶ ተው። ገደብ ሲወሰን፣ በዚህ ምንዛሬ ዋጋ የሌላቸው ንብረቶች አይካተቱም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك الحد فارغًا لعدم تقييده. عند تحديد حد، تُستبعد الأصول التي لا قيمة لها بهذه العملة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সীমা না রাখতে ঘরটি ফাঁকা রাখুন। সীমা নির্ধারণ করলে এই মুদ্রায় মূল্যহীন সম্পদ বাদ যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdné pole znamená bez omezení. Po nastavení limitu se nezobrazí aktiva bez hodnoty v této měně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad en grænse stå tom, hvis der ikke skal være en grænse. Aktiver uden en værdi i denne valuta udelades, når en grænse er angivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasse ein Limit leer, um es aufzuheben. Vermögenswerte ohne Wert in dieser Währung werden bei gesetztem Limit ausgeschlossen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε ένα όριο κενό για απεριόριστη τιμή. Όταν ορίζεται όριο, εξαιρούνται τα περιουσιακά στοιχεία χωρίς αξία σε αυτό το νόμισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave a limit empty for no limit. Assets without a value in this currency are excluded when a limit is set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja un límite vacío para no aplicar límites. Al establecer uno, se excluyen los activos sin valor en esta moneda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نداشتن محدودیت، حد را خالی بگذارید. با تعیین حد، دارایی‌هایی که ارزش آن‌ها با این ارز مشخص نیست حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä raja tyhjäksi, jos et halua rajoitusta. Kun raja on asetettu, varat, joille ei ole arvoa tässä valuutassa, jätetään pois."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwanang blangko ang limitasyon kung walang hangganan. Hindi isasama ang mga asset na walang halaga sa perang ito kapag may limitasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez une limite vide pour ne pas en appliquer. Si une limite est définie, les actifs sans valeur dans cette devise sont exclus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મર્યાદા ન રાખવી હોય તો ખાનું ખાલી રાખો. મર્યાદા સેટ હોય ત્યારે આ ચલણમાં મૂલ્ય ન હોય તેવી સંપત્તિઓ સામેલ થતી નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar iyaka babu komai idan ba a son iyaka. Idan an sa iyaka, ba a nuna kadarorin da ba su da ƙima a wannan kuɗin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסרת מגבלה, יש להשאיר את השדה ריק. כאשר מוגדרת מגבלה, נכסים שאין להם שווי במטבע הזה אינם נכללים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमा न रखने के लिए उसे खाली छोड़ें। सीमा तय करने पर इस मुद्रा में मूल्य न रखने वाले एसेट हटा दिए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za neograničenu vrijednost ostavite polje prazno. Ako postavite ograničenje, imovina bez vrijednosti u ovoj valuti neće biti uključena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha nem szeretnél korlátot, hagyd üresen a mezőt. Beállított korlát esetén azok az eszközök kimaradnak, amelyeknek nincs értékük ebben a pénznemben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan batas jika tidak ingin membatasi. Aset tanpa nilai dalam mata uang ini dikecualikan saat batas ditetapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto un limite per non applicarlo. Se imposti un limite, gli asset senza valore in questa valuta vengono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限しない場合は空欄にしてください。上限または下限を設定すると、この通貨で評価額のない資産は除外されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეუზღუდავი მნიშვნელობისთვის ველი ცარიელი დატოვეთ. ზღვრის მითითებისას ამ ვალუტაში ღირებულების არმქონე აქტივები გამოირიცხება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទុកដែនកំណត់ទទេបើមិនចង់កំណត់។ ពេលកំណត់ដែន ទ្រព្យដែលគ្មានតម្លៃជារូបិយប័ណ្ណនេះនឹងត្រូវដកចេញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಿತಿ ಬೇಡವಾದರೆ ಆ ಮಿತಿಯನ್ನು ಖಾಲಿ ಬಿಡಿ. ಮಿತಿಯನ್ನು ಹೊಂದಿಸಿದಾಗ ಈ ಕರೆನ್ಸಿಯಲ್ಲಿ ಮೌಲ್ಯವಿಲ್ಲದ ಸ್ವತ್ತುಗಳನ್ನು ಹೊರಗಿಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한을 두지 않으려면 한도를 비워 두세요. 한도를 설정하면 이 통화로 가치를 알 수 없는 자산은 제외됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിധി വേണ്ടെങ്കിൽ പരിധിയുടെ ഫീൽഡ് ഒഴിച്ചിടുക. പരിധി നൽകിയാൽ ഈ കറൻസിയിൽ മൂല്യം ലഭ്യമല്ലാത്ത ആസ്തികൾ ഒഴിവാക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मर्यादा नको असल्यास रकाना रिकामा ठेवा. मर्यादा सेट केल्यावर या चलनात मूल्य नसलेल्या मालमत्ता वगळल्या जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan had kosong untuk tanpa had. Aset tanpa nilai dalam mata wang ini dikecualikan apabila had ditetapkan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကန့်သတ်ချက် မထားလိုလျှင် ကွက်လပ်ထားပါ။ ကန့်သတ်ချက်ထားလျှင် ဤငွေကြေးဖြင့် တန်ဖိုးမရှိသော ပိုင်ဆိုင်မှုများကို ချန်လှပ်မည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La en grense stå tom hvis du ikke vil ha en grense. Eiendeler uten verdi i denne valutaen utelates når en grense er angitt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीमा नराख्न खाली छोड्नुहोस्। सीमा तोक्दा यस मुद्रामा मूल्य नभएका सम्पत्ति हटाइन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een limiet leeg voor geen limiet. Activa zonder waarde in deze valuta worden uitgesloten als er een limiet is ingesteld."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସୀମା ନ ରଖିବା ପାଇଁ ସୀମା ଘର ଖାଲି ଛାଡ଼ନ୍ତୁ। ସୀମା ରଖାଗଲେ ଏହି ମୁଦ୍ରାରେ ମୂଲ୍ୟ ନଥିବା ସମ୍ପତ୍ତିକୁ ବାଦ୍ ଦିଆଯାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਹੱਦ ਨਾ ਰੱਖਣ ਲਈ ਖ਼ਾਨਾ ਖ਼ਾਲੀ ਛੱਡੋ। ਹੱਦ ਲੱਗਣ 'ਤੇ ਇਸ ਮੁਦਰਾ ਵਿੱਚ ਮੁੱਲ ਨਾ ਰੱਖਣ ਵਾਲੀਆਂ ਸੰਪਤੀਆਂ ਬਾਹਰ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw puste pole, aby nie ustawiać limitu. Po ustawieniu limitu aktywa bez wyceny w tej walucie są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe um limite em branco para não limitar. Ativos sem valor nesta moeda são excluídos quando um limite é definido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe um limite em branco para não limitar. Os ativos sem valor nesta moeda são excluídos quando define um limite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă limita necompletată pentru a nu impune o limită. Activele fără valoare în această monedă sunt excluse când este stabilită o limită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте поле пустым, чтобы не задавать предел. Если предел задан, активы без оценки в этой валюте исключаются."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حد نه رکڻ لاءِ حد وارو خانو خالي ڇڏيو. حد رکڻ سان اهي اثاثا شامل نه ٿيندا جن جو هن ڪرنسي ۾ قدر ناهي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සීමාවක් අවශ්‍ය නැතිනම් හිස්ව තබන්න. සීමාවක් සකසා ඇති විට මෙම මුදලින් වටිනාකමක් නැති වත්කම් ඉවත් කෙරේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdne pole znamená bez obmedzenia. Po nastavení limitu sa nezobrazia aktíva bez hodnoty v tejto mene."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazno polje pomeni brez omejitve. Ko nastavite omejitev, so sredstva brez vrednosti v tej valuti izključena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna en gräns tom för att inte begränsa värdet. Tillgångar utan ett värde i den här valutan utesluts när en gräns är inställd."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acha kikomo wazi ili kusiwe na kikomo. Kikomo kikiwekwa, mali zisizo na thamani katika sarafu hii hazitajumuishwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரம்பு வேண்டாம் என்றால் அந்தப் புலத்தைக் காலியாக விடவும். வரம்பு அமைக்கப்பட்டால், இந்த நாணயத்தில் மதிப்பு இல்லாத சொத்துகள் விலக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పరిమితి వద్దంటే ఖాళీగా వదలండి. పరిమితి పెట్టినప్పుడు ఈ కరెన్సీలో విలువ లేని ఆస్తులు మినహాయించబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว้นช่องขีดจำกัดว่างไว้หากไม่จำกัด เมื่อกำหนดขีดจำกัด ระบบจะไม่รวมสินทรัพย์ที่ไม่มีมูลค่าในสกุลเงินนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınır koymamak için alanı boş bırakın. Sınır belirlendiğinde, bu para biriminde değeri olmayan varlıklar gösterilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залиште поле ліміту порожнім, щоб не обмежувати значення. Якщо задано ліміт, активи без вартості в цій валюті не показуються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حد نہ رکھنے کے لیے خانہ خالی چھوڑیں۔ حد مقرر ہونے پر اس کرنسی میں مالیت کے بغیر اثاثے شامل نہیں ہوں گے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheklov bo‘lmasligi uchun maydonni bo‘sh qoldiring. Cheklov o‘rnatilganda bu valyutada qiymati yo‘q aktivlar chiqarib tashlanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống giới hạn nếu không muốn giới hạn. Khi đặt giới hạn, tài sản không có giá trị theo đơn vị tiền tệ này sẽ bị loại trừ."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fi ààlà sílẹ̀ ní òfo bí o kò bá fẹ́ ààlà. Nígbà tí ààlà bá wà, a ó yọ ohun ìní tí kò ní iye nínú owó yìí kúrò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空表示不设限。设置限额后，将排除没有此货币估值的资产。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將欄位留白即表示不設限。設定限制後，未提供此貨幣計價價值的資產將被排除。"
          }
        }
      }
    },
