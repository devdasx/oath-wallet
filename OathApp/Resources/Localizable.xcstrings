    "cloud_backup.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተመሰጠረ የመመለሻ ምትኬ በiCloud Drive › Oath Wallet › Wallet Backups ውስጥ አስቀምጥ። የምትኬ ይለፍ ቃልህን በጥንቃቄ ያዝ፤ ይህን ዋሌት ለመመለስ ያስፈልጋል። ይህን ማጥፋት ነባር ምትኬዎችን በiCloud Drive ያስቀራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ نسخة استرداد مشفّرة في iCloud Drive › Oath Wallet › Wallet Backups. احتفظ بكلمة سر النسخة بأمان؛ فهي مطلوبة لاستعادة هذه المحفظة. تعطيل هذا الخيار يُبقي النسخ الموجودة في iCloud Drive."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive › Oath Wallet › Wallet Backups এ এনক্রিপ্ট করা পুনরুদ্ধার ব্যাকআপ রাখুন। ব্যাকআপের পাসওয়ার্ড নিরাপদে রাখুন; এই ওয়ালেট পুনরুদ্ধারে এটি প্রয়োজন। এটি বন্ধ করলেও iCloud Drive এ আগের ব্যাকআপগুলো থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte šifrovanou zálohu pro obnovení do iCloud Drive › Oath Wallet › Wallet Backups. Heslo zálohy bezpečně uschovejte; je nutné k obnovení této peněženky. Vypnutím této volby se stávající zálohy na iCloud Drive zachovají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en krypteret gendannelseskopi i iCloud Drive › Oath Wallet › Wallet Backups. Opbevar adgangskoden til sikkerhedskopien sikkert; den er nødvendig for at gendanne denne wallet. Eksisterende sikkerhedskopier bliver i iCloud Drive, hvis du slår funktionen fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere eine verschlüsselte Wiederherstellungssicherung in iCloud Drive › Oath Wallet › Wallet Backups. Bewahre dein Sicherungspasswort sicher auf; es wird zur Wiederherstellung dieser Wallet benötigt. Beim Deaktivieren bleiben vorhandene Sicherungen in iCloud Drive erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε ένα κρυπτογραφημένο αντίγραφο ανάκτησης στο iCloud Drive › Oath Wallet › Wallet Backups. Φυλάξτε τον κωδικό του αντιγράφου· απαιτείται για την επαναφορά αυτού του πορτοφολιού. Η απενεργοποίηση διατηρεί τα υπάρχοντα αντίγραφα στο iCloud Drive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save an encrypted recovery backup in iCloud Drive › Oath Wallet › Wallet Backups. Keep your backup password safe; it is required to restore this wallet. Turning this off keeps existing backups in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una copia de recuperación cifrada en iCloud Drive › Oath Wallet › Wallet Backups. Protege tu contraseña de copia; la necesitas para restaurar esta cartera. Desactivar esta opción conserva las copias existentes en iCloud Drive."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک نسخهٔ پشتیبان بازیابی رمزگذاری‌شده در iCloud Drive › Oath Wallet › Wallet Backups ذخیره کنید. گذرواژهٔ پشتیبان را امن نگه دارید؛ برای بازیابی این کیف پول لازم است. خاموش کردن این گزینه، نسخه‌های موجود در iCloud Drive را نگه می‌دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna salattu palautusvarmuuskopio sijaintiin iCloud Drive › Oath Wallet › Wallet Backups. Säilytä varmuuskopion salasana turvallisesti, sillä sitä tarvitaan tämän lompakon palauttamiseen. Toiminnon poistaminen käytöstä ei poista olemassa olevia varmuuskopioita iCloud Drivesta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-save ng naka-encrypt na backup para sa pagbawi sa iCloud Drive › Oath Wallet › Wallet Backups. Ingatan ang password ng backup; kailangan ito para maibalik ang wallet na ito. Mananatili sa iCloud Drive ang mga kasalukuyang backup kapag na-off ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une sauvegarde de récupération chiffrée dans iCloud Drive › Oath Wallet › Wallet Backups. Gardez votre mot de passe de sauvegarde en lieu sûr ; il est nécessaire pour restaurer ce portefeuille. La désactivation conserve les sauvegardes existantes dans iCloud Drive."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive › Oath Wallet › Wallet Backups માં એન્ક્રિપ્ટેડ પુનઃપ્રાપ્તિ બૅકઅપ સાચવો. બૅકઅપનો પાસવર્ડ સુરક્ષિત રાખો; આ વૉલેટ પુનઃસ્થાપિત કરવા તે જરૂરી છે. આ બંધ કરવાથી iCloud Drive પરના હાલના બૅકઅપ જળવાઈ રહે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajiye madadin dawo da walat mai ɓoyayyen tsari a iCloud Drive › Oath Wallet › Wallet Backups. Ka kiyaye kalmar sirrin madadi; ana buƙatarta don dawo da wannan walat. Kashe wannan ba ya cire madadin da ke iCloud Drive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לשמור גיבוי שחזור מוצפן ב־iCloud Drive › Oath Wallet › Wallet Backups. יש לשמור את סיסמת הגיבוי במקום בטוח; היא נדרשת לשחזור הארנק הזה. כיבוי האפשרות משאיר את הגיבויים הקיימים ב־iCloud Drive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive › Oath Wallet › Wallet Backups में एन्क्रिप्टेड रिकवरी बैकअप सेव करें। बैकअप पासवर्ड सुरक्षित रखें; इस वॉलेट को बहाल करने के लिए इसकी ज़रूरत है। इसे बंद करने पर मौजूदा बैकअप iCloud Drive में बने रहेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremite šifriranu kopiju za oporavak u iCloud Drive › Oath Wallet › Wallet Backups. Čuvajte lozinku sigurnosne kopije; potrebna je za obnovu ovog novčanika. Isključivanje ove opcije zadržava postojeće kopije na iCloud Driveu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ments titkosított helyreállítási másolatot az iCloud Drive › Oath Wallet › Wallet Backups mappába. Őrizd meg biztonságosan a mentés jelszavát, mert szükséges a tárca visszaállításához. Kikapcsoláskor a meglévő mentések megmaradnak az iCloud Drive-ban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan cadangan pemulihan terenkripsi di iCloud Drive › Oath Wallet › Wallet Backups. Simpan kata sandi cadangan dengan aman; Anda memerlukannya untuk memulihkan dompet ini. Menonaktifkan ini tetap menyimpan cadangan yang ada di iCloud Drive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un backup di recupero crittografato in iCloud Drive › Oath Wallet › Wallet Backups. Conserva al sicuro la password del backup: serve per ripristinare questo wallet. Disattivando questa opzione, i backup esistenti rimangono su iCloud Drive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化した復元用バックアップをiCloud Drive › Oath Wallet › Wallet Backupsに保存します。復元にはバックアップパスワードが必要です。安全に保管してください。オフにしても既存のバックアップはiCloud Driveに残ります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აღდგენის დაშიფრული სარეზერვო ასლი შეინახეთ საქაღალდეში iCloud Drive › Oath Wallet › Wallet Backups. სარეზერვო ასლის პაროლი უსაფრთხოდ შეინახეთ; ის ამ საფულის აღსადგენად დაგჭირდებათ. ამ პარამეტრის გამორთვისას არსებული ასლები iCloud Drive-ში რჩება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
