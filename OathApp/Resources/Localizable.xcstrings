    "multisigEVMFeeDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክፍያ የሚከፍለው አድራሻ ከዚህ ቦርሳ ጋር በተመሳሳይ አውታረ መረብ ላይ ነው። ቁልፉ የሚያስፈልጉት የባለቤቶች ፊርማዎች ሳይኖሩ የቦርሳውን ንብረቶች ማዘዋወር አይችልም። የአውታረ መረብ ክፍያዎች ለአውታረ መረቡ ይከፈላሉ፣ ለOath አይደሉም። የዚህን ቦርሳ ሙሉ መልሶ ማግኛ ፋይል በመጠባበቂያ ያስቀምጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان دفع الرسوم على شبكة المحفظة نفسها. لا يستطيع مفتاحه نقل أصول المحفظة دون توقيعات المالكين المطلوبة. تُدفع رسوم الشبكة للشبكة، وليس إلى Oath. احتفظ بنسخة احتياطية من ملف استرداد هذه المحفظة الكامل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফি প্রদানকারী ঠিকানাটি এই ওয়ালেটের একই নেটওয়ার্কে আছে। প্রয়োজনীয় মালিকদের স্বাক্ষর ছাড়া এর কী দিয়ে ওয়ালেটের সম্পদ সরানো যায় না। নেটওয়ার্ক ফি নেটওয়ার্ককে দেওয়া হয়, Oath-কে নয়। এই ওয়ালেটের সম্পূর্ণ পুনরুদ্ধার ফাইলের ব্যাকআপ রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa plátce poplatků je ve stejné síti jako tato peněženka. Její klíč nemůže převádět aktiva peněženky bez požadovaných podpisů vlastníků. Síťové poplatky se platí síti, nikoli aplikaci Oath. Zálohujte si úplný soubor pro obnovu této peněženky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gebyrbetalende adresse er på samme netværk som denne tegnebog. Dens nøgle kan ikke flytte tegnebogens aktiver uden de krævede ejersignaturer. Netværksgebyrer betales til netværket, ikke til Oath. Sikkerhedskopiér hele tegnebogens gendannelsesfil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gebührenzahler-Adresse befindet sich im selben Netzwerk wie diese Wallet. Ihr Schlüssel kann ohne die erforderlichen Eigentümersignaturen keine Wallet-Vermögenswerte übertragen. Netzwerkgebühren gehen an das Netzwerk, nicht an Oath. Sichere die vollständige Wiederherstellungsdatei dieser Wallet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση που πληρώνει τις προμήθειες βρίσκεται στο ίδιο δίκτυο με αυτό το πορτοφόλι. Το κλειδί της δεν μπορεί να μετακινήσει στοιχεία του πορτοφολιού χωρίς τις απαιτούμενες υπογραφές των κατόχων. Οι προμήθειες δικτύου καταβάλλονται στο δίκτυο, όχι στο Oath. Κρατήστε αντίγραφο ασφαλείας του πλήρους αρχείου ανάκτησης αυτού του πορτοφολιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fee-payer address is on the same network as this wallet. Its key cannot move wallet assets without the required owner signatures. Network fees are paid to the network, not Oath. Back up this wallet’s complete recovery file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección que paga las comisiones está en la misma red que esta cartera. Su clave no puede mover los activos de la cartera sin las firmas necesarias de los propietarios. Las comisiones de red se pagan a la red, no a Oath. Guarda una copia del archivo de recuperación completo de esta cartera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آدرس پرداخت‌کنندهٔ کارمزد روی همان شبکهٔ این کیف پول است. کلید آن بدون امضاهای لازم از مالکان نمی‌تواند دارایی‌های کیف پول را جابه‌جا کند. کارمزدهای شبکه به شبکه پرداخت می‌شوند، نه به Oath. از فایل کامل بازیابی این کیف پول نسخهٔ پشتیبان بگیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksajan osoite on samassa verkossa kuin tämä lompakko. Sen avaimella ei voi siirtää lompakon varoja ilman vaadittuja omistajien allekirjoituksia. Verkkomaksut maksetaan verkolle, ei Oath-sovellukselle. Varmuuskopioi tämän lompakon koko palautustiedosto."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasa parehong network ng wallet na ito ang address na pambayad. Hindi maililipat ng key nito ang mga asset ng wallet nang wala ang mga kinakailangang lagda ng mga may-ari. Sa network ibinabayad ang mga bayarin sa network, hindi sa Oath. I-back up ang kumpletong recovery file ng wallet na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du payeur des frais se trouve sur le même réseau que ce portefeuille. Sa clé ne peut pas transférer les actifs du portefeuille sans les signatures requises des propriétaires. Les frais de réseau sont versés au réseau, et non à Oath. Sauvegardez le fichier de récupération complet de ce portefeuille."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફી ચૂકવનાર સરનામું આ વૉલેટના જ નેટવર્ક પર છે. માલિકોના જરૂરી હસ્તાક્ષરો વિના તેની કી વૉલેટની સંપત્તિ ખસેડી શકતી નથી. નેટવર્ક ફી નેટવર્કને ચૂકવાય છે, Oath ને નહીં. આ વૉલેટની સંપૂર્ણ પુનઃપ્રાપ્તિ ફાઇલનો બૅકઅપ રાખો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adireshin da ke biyan kuɗin mu'amala yana kan hanyar sadarwa ɗaya da wannan walat. Maɓallinsa ba zai iya motsa kadarorin walat ba sai da sa hannun masu shi da ake buƙata. Ana biyan kuɗin hanyar sadarwa ga hanyar sadarwar, ba Oath ba. Ajiye kwafin cikakken fayil ɗin dawo da wannan walat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכתובת לתשלום עמלות נמצאת באותה רשת כמו הארנק הזה. המפתח שלה אינו יכול להעביר נכסים מהארנק ללא חתימות הבעלים הנדרשות. עמלות הרשת משולמות לרשת, ולא ל-Oath. יש לגבות את קובץ השחזור המלא של הארנק הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुल्क चुकाने वाला पता इस वॉलेट के ही नेटवर्क पर है। आवश्यक मालिकों के हस्ताक्षरों के बिना उसकी कुंजी वॉलेट की संपत्तियाँ स्थानांतरित नहीं कर सकती। नेटवर्क शुल्क नेटवर्क को दिया जाता है, Oath को नहीं। इस वॉलेट की पूरी रिकवरी फ़ाइल का बैकअप रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa platitelja naknade nalazi se na istoj mreži kao ovaj novčanik. Njezin ključ ne može premještati sredstva novčanika bez potrebnih potpisa vlasnika. Mrežne naknade plaćaju se mreži, a ne aplikaciji Oath. Sigurnosno kopirajte cijelu datoteku za oporavak ovog novčanika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A díjfizető címe ugyanazon a hálózaton van, mint ez a tárca. A kulcsa nem mozgathatja a tárca eszközeit a szükséges tulajdonosi aláírások nélkül. A hálózati díjakat a hálózat kapja, nem az Oath. Készíts biztonsági másolatot a tárca teljes helyreállítási fájljáról."
          }
        },
        "id" : {
