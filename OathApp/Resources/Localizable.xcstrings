    "receive.deferred_tracking" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዝውውሮች በአውታረ መረቡ ይመዘገባሉ። ለዚህ አውታረ መረብ ቶከኖችን ማሳየትና ቀሪ ሂሳብ ማደስ በOath ገና አይገኝም። ዝውውሩን በአውታረ መረብ አሳሽ ለመፈተሽ የግብይት መለያውን ያዝ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُسجّل التحويلات على الشبكة. عرض الرموز وتحديث الأرصدة لهذه الشبكة غير متاحين في Oath بعد. احتفظ بمعرّف المعاملة لفحص التحويل عبر مستكشف الشبكة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্থানান্তর নেটওয়ার্কে নথিভুক্ত হয়। এই নেটওয়ার্কের টোকেন দেখানো ও ব্যালেন্স হালনাগাদ Oath এ এখনও নেই। নেটওয়ার্ক এক্সপ্লোরারে স্থানান্তর দেখতে লেনদেনের ID রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Převody se zaznamenávají v síti. Zobrazení tokenů a aktualizace zůstatku pro tuto síť zatím nejsou v Oath dostupné. Uschovejte ID transakce pro kontrolu převodu v průzkumníku sítě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overførsler registreres på netværket. Visning af tokens og saldoopdateringer for dette netværk er endnu ikke tilgængelige i Oath. Gem transaktions-ID’et for at kontrollere overførslen i en netværksudforsker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertragungen werden im Netzwerk gespeichert. Token-Anzeige und Guthabenaktualisierung für dieses Netzwerk sind in Oath noch nicht verfügbar. Bewahre die Transaktions-ID zur Prüfung in einem Netzwerk-Explorer auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μεταφορές καταγράφονται στο δίκτυο. Η εμφάνιση token και οι ενημερώσεις υπολοίπου για αυτό το δίκτυο δεν είναι ακόμη διαθέσιμες στο Oath. Κρατήστε το ID συναλλαγής για έλεγχο της μεταφοράς σε εξερευνητή δικτύου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfers are recorded on the network. Token display and balance updates for this network are not available in Oath yet. Keep the transaction ID to check the transfer with a network explorer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transferencias se registran en la red. Oath aún no muestra tokens ni actualiza saldos de esta red. Conserva el ID de transacción para comprobar la transferencia en un explorador de red."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقال‌ها در شبکه ثبت می‌شوند. نمایش توکن و به‌روزرسانی موجودی این شبکه هنوز در Oath در دسترس نیست. شناسهٔ تراکنش را برای بررسی انتقال در کاوشگر شبکه نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrot tallennetaan verkkoon. Oath ei vielä näytä tämän verkon tokeneita eikä päivitä niiden saldoja. Säilytä tapahtumatunnus, jotta voit tarkistaa siirron lohkoketjuselaimessa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinatala sa network ang mga paglipat. Wala pang pagpapakita ng token at pag-update ng balanse para sa network na ito sa Oath. Itago ang ID ng transaksyon para masuri ito sa network explorer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transferts sont enregistrés sur le réseau. Oath ne permet pas encore l’affichage des jetons ni l’actualisation des soldes de ce réseau. Gardez l’identifiant de transaction pour vérifier le transfert dans un explorateur du réseau."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટ્રાન્સફર નેટવર્ક પર નોંધાય છે. આ નેટવર્ક માટે ટોકન દર્શાવવાનું અને બેલેન્સ અપડેટ હજી Oath માં ઉપલબ્ધ નથી. નેટવર્ક એક્સપ્લોરરમાં ટ્રાન્સફર તપાસવા વ્યવહાર ID રાખો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
