        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അയയ്ക്കൽ ഇതുവരെ ലഭ്യമല്ല. ഈ വിവരങ്ങൾ പരിശോധിക്കാം, പക്ഷേ പണമൊന്നും അയയ്ക്കില്ല."
