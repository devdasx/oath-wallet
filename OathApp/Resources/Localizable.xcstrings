    "wcTransactionSignedDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተፈረመው ግብይት ወደ dApp ተመልሷል። ወደ አውታረ መረቡ መላክ አለበት። እስካሁን የአውታረ መረብ ማረጋገጫ አልደረሰም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُعيدت المعاملة الموقّعة إلى التطبيق اللامركزي. يجب عليه إرسالها إلى الشبكة. لم يُستلم تأكيد من الشبكة بعد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বাক্ষরিত লেনদেন dApp এ ফিরেছে। সেটিকে নেটওয়ার্কে জমা দিতে হবে। এখনও নেটওয়ার্ক নিশ্চিতকরণ আসেনি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podepsaná transakce byla vrácena dApp. Ta ji musí odeslat do sítě. Dosud nebylo přijato síťové potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den signerede transaktion blev sendt tilbage til dAppen. Den skal indsende transaktionen til netværket. Der er endnu ikke modtaget nogen netværksbekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die signierte Transaktion wurde an die dApp zurückgegeben. Sie muss sie ins Netzwerk übermitteln. Es liegt noch keine Netzwerkbestätigung vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υπογεγραμμένη συναλλαγή επιστράφηκε στη dApp. Πρέπει να την υποβάλει στο δίκτυο. Δεν έχει ληφθεί ακόμη επιβεβαίωση δικτύου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The signed transaction was returned to the dApp. It must submit it to the network. No network confirmation has been received yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transacción firmada se devolvió a la dApp, que debe enviarla a la red. Aún no se ha recibido confirmación de red."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تراکنش امضاشده به برنامهٔ غیرمتمرکز بازگردانده شد. باید آن را به شبکه ارسال کند. هنوز تأیید شبکه دریافت نشده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allekirjoitettu tapahtuma palautettiin dAppille. Sen on lähetettävä tapahtuma verkkoon. Verkkovahvistusta ei ole vielä saatu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naibalik sa dApp ang pinirmahang transaksyon. Dapat nitong isumite iyon sa network. Wala pang natatanggap na kumpirmasyon ng network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transaction signée a été renvoyée à la dApp. Elle doit la soumettre au réseau. Aucune confirmation réseau n’a encore été reçue."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હસ્તાક્ષરિત વ્યવહાર dApp ને પરત આપ્યો છે. તેણે નેટવર્ક પર સબમિટ કરવો જરૂરી છે. હજી નેટવર્ક પુષ્ટિ મળી નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An mayar da ma'amalar da aka sanya wa hannu zuwa dApp. Dole ya miƙa ta ga hanyar sadarwa. Ba a karɓi tabbacin hanyar sadarwa ba tukuna."
