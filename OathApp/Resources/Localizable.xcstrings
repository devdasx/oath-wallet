    "permissions.control_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን ውጫዊ የፊርማ ቁልፍ ያስወግዳል። ሌሎች ቁልፎች፣ የፊርማ ገደቦችና ፈቃዶች አይቀየሩም። የባለቤት ቁልፍህ ቁጥጥሩን ማስቀጠል አለበት። አውታረ መረቡ ክፍያ ያስከፍላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل مفتاح التوقيع الخارجي هذا. تبقى المفاتيح والعتبات والصلاحيات الأخرى كما هي. يجب أن يحتفظ مفتاح المالك بالتحكم. تفرض الشبكة رسومًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই বহিরাগত স্বাক্ষর কী সরিয়ে দেয়। অন্য কী, প্রয়োজনীয় স্বাক্ষরের সংখ্যা ও অনুমতিগুলো অপরিবর্তিত থাকে। মালিকের কীতে নিয়ন্ত্রণ বজায় থাকতে হবে। নেটওয়ার্ক ফি কাটে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní tento externí podpisový klíč. Ostatní klíče, prahové hodnoty a oprávnění zůstanou beze změny. Váš klíč vlastníka si musí zachovat kontrolu. Síť účtuje poplatek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne eksterne signeringsnøgle. Andre nøgler, tærskler og tilladelser er uændrede. Din ejernøgle skal bevare kontrollen. Netværket opkræver et gebyr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt diesen externen Signaturschlüssel. Andere Schlüssel, Schwellenwerte und Berechtigungen bleiben unverändert. Dein Eigentümerschlüssel muss die Kontrolle behalten. Es fällt eine Netzwerkgebühr an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί αυτό το εξωτερικό κλειδί υπογραφής. Τα άλλα κλειδιά, όρια και δικαιώματα παραμένουν αμετάβλητα. Το κλειδί κατόχου σας πρέπει να διατηρεί τον έλεγχο. Το δίκτυο χρεώνει προμήθεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes this external signing key. Other keys, thresholds and permissions stay unchanged. Your owner key must retain control. The network charges a fee."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina esta clave de firma externa. Las demás claves, los umbrales y los permisos no cambian. Tu clave de propietario debe conservar el control. La red cobra una comisión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کلید امضای خارجی را حذف می‌کند. کلیدهای دیگر، آستانه‌ها و مجوزها بدون تغییر می‌مانند. کلید مالک شما باید کنترل را حفظ کند. شبکه کارمزد می‌گیرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa tämän ulkoisen allekirjoitusavaimen. Muut avaimet, kynnysarvot ja käyttöoikeudet säilyvät ennallaan. Omistaja-avaimesi on säilytettävä tilin hallinta. Verkko veloittaa maksun."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aalisin ang panlabas na signing key na ito. Hindi magbabago ang ibang key, threshold at pahintulot. Dapat manatili ang kontrol sa owner key mo. May bayad sa network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire cette clé de signature externe. Les autres clés, seuils et autorisations restent inchangés. Votre clé propriétaire doit conserver le contrôle. Le réseau prélève des frais."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ બાહ્ય હસ્તાક્ષર કી દૂર કરે છે. અન્ય કી, થ્રેશોલ્ડ અને પરવાનગીઓ યથાવત્ રહે છે. તમારી માલિક કી પાસે નિયંત્રણ રહેવું જરૂરી છે. નેટવર્ક ફી વસૂલે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yana cire wannan maɓallin sa hannu na waje. Sauran maɓallai, iyakokin sa hannu da izini ba sa canzawa. Dole maɓallinka na mallaka ya riƙe iko. Hanyar sadarwa tana cajar kuɗi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסרת מפתח החתימה החיצוני הזה. המפתחות, הספים וההרשאות האחרים אינם משתנים. מפתח הבעלים שלך חייב לשמור על השליטה. הרשת גובה עמלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बाहरी हस्ताक्षर कुंजी हटाता है। दूसरी कुंजियाँ, सीमाएँ और अनुमतियाँ वैसी ही रहती हैं। आपकी मालिक कुंजी का नियंत्रण बना रहना चाहिए। नेटवर्क शुल्क लेता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja ovaj vanjski ključ za potpisivanje. Ostali ključevi, pragovi i dopuštenja ostaju nepromijenjeni. Vaš vlasnički ključ mora zadržati kontrolu. Mreža naplaćuje naknadu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja ezt a külső aláírókulcsot. A többi kulcs, küszöbérték és jogosultság változatlan marad. A tulajdonosi kulcsodnak meg kell őriznie az irányítást. A hálózat díjat számít fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kunci penandatanganan eksternal ini. Kunci, ambang, dan izin lain tetap sama. Kunci pemilik Anda harus tetap memegang kendali. Jaringan mengenakan biaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove questa chiave di firma esterna. Le altre chiavi, soglie e autorizzazioni restano invariate. La chiave del proprietario deve mantenere il controllo. La rete applica una commissione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この外部署名鍵を削除します。他の鍵、しきい値、権限は変わりません。所有者の鍵による制御を維持する必要があります。ネットワーク手数料がかかります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შლის ამ გარე ხელმოწერის გასაღებს. სხვა გასაღებები, ზღვრები და ნებართვები უცვლელი რჩება. მფლობელის გასაღებმა კონტროლი უნდა შეინარჩუნოს. ქსელი საკომისიოს იღებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដកសោចុះហត្ថលេខាខាងក្រៅនេះចេញ។ សោផ្សេង កម្រិត និងសិទ្ធិនៅដដែល។ សោម្ចាស់របស់អ្នកត្រូវរក្សាការគ្រប់គ្រង។ បណ្ដាញគិតថ្លៃសេវា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಬಾಹ್ಯ ಸಹಿ ಕೀಲಿಯನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಇತರ ಕೀಲಿಗಳು, ಮಿತಿಗಳು ಮತ್ತು ಅನುಮತಿಗಳು ಬದಲಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಮಾಲೀಕ ಕೀಲಿ ನಿಯಂತ್ರಣ ಉಳಿಸಿಕೊಳ್ಳಬೇಕು. ನೆಟ್‌ವರ್ಕ್ ಶುಲ್ಕ ವಿಧಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 외부 서명 키를 삭제합니다. 다른 키, 임계값 및 권한은 그대로 유지됩니다. 소유자 키는 제어 권한을 유지해야 합니다. 네트워크 수수료가 부과됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ബാഹ്യ ഒപ്പിടൽ കീ നീക്കം ചെയ്യുന്നു. മറ്റ് കീകളും പരിധികളും അനുമതികളും മാറില്ല. ഉടമയുടെ കീയ്ക്ക് നിയന്ത്രണം നിലനിൽക്കണം. നെറ്റ്‌വർക്ക് ഫീസ് ഈടാക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ही बाह्य स्वाक्षरी की काढते. इतर की, आवश्यक स्वाक्षरी मर्यादा आणि परवानग्या बदलत नाहीत. मालकाच्या कीकडे नियंत्रण राहणे आवश्यक आहे. नेटवर्क शुल्क आकारते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengalih keluar kunci tandatangan luaran ini. Kunci lain, ambang dan kebenaran kekal. Kunci pemilik anda mesti mengekalkan kawalan. Rangkaian mengenakan yuran."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤပြင်ပလက်မှတ်ထိုးကီးကို ဖယ်ရှားသည်။ အခြားကီးများ၊ သတ်မှတ်လိုအပ်ချက်များနှင့် ခွင့်ပြုချက်များ မပြောင်းလဲပါ။ ပိုင်ရှင်ကီးက ဆက်လက်ထိန်းချုပ်နိုင်ရမည်။ ကွန်ရက်က အခကြေးငွေ ကောက်ခံသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne eksterne signeringsnøkkelen. Andre nøkler, terskler og tillatelser forblir uendret. Eiernøkkelen din må beholde kontrollen. Nettverket krever et gebyr."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो बाह्य हस्ताक्षर कुञ्जी हटाउँछ। अन्य कुञ्जी, सीमा र अनुमति फेरिँदैनन्। मालिक कुञ्जीको नियन्त्रण कायम हुनुपर्छ। नेटवर्कले शुल्क लिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert deze externe ondertekeningssleutel. Andere sleutels, drempels en machtigingen blijven ongewijzigd. Je eigenaarsleutel moet de controle behouden. Het netwerk brengt kosten in rekening."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ବାହ୍ୟ ସ୍ୱାକ୍ଷର କୀ ହଟାଏ। ଅନ୍ୟ କୀ, ସୀମା ଓ ଅନୁମତି ଅପରିବର୍ତ୍ତିତ ରହେ। ଆପଣଙ୍କ ମାଲିକ କୀ ପାଖରେ ନିୟନ୍ତ୍ରଣ ରହିବା ଆବଶ୍ୟକ। ନେଟୱର୍କ ଶୁଳ୍କ ନିଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਬਾਹਰੀ ਦਸਤਖ਼ਤ ਕੁੰਜੀ ਹਟਾਉਂਦਾ ਹੈ। ਹੋਰ ਕੁੰਜੀਆਂ, ਹੱਦਾਂ ਅਤੇ ਇਜਾਜ਼ਤਾਂ ਨਹੀਂ ਬਦਲਦੀਆਂ। ਤੁਹਾਡੀ ਮਾਲਕ ਕੁੰਜੀ ਕੋਲ ਕੰਟਰੋਲ ਰਹਿਣਾ ਲਾਜ਼ਮੀ ਹੈ। ਨੈੱਟਵਰਕ ਫੀਸ ਲੈਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa ten zewnętrzny klucz podpisujący. Pozostałe klucze, progi i uprawnienia pozostają bez zmian. Klucz właściciela musi zachować kontrolę. Sieć pobiera opłatę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
