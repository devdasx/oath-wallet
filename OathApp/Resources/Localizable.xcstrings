        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤကုဒ်သည် ရွေးထားသော ကွန်ရက်နှင့် မကိုက်ညီပါ။ ဤကွန်ရက်အတွက် လိပ်စာကို စကင်ဖတ်ပါ သို့မဟုတ် နောက်ပြန်သွားပြီး အခြားပိုင်ဆိုင်မှု ရွေးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne koden samsvarer ikke med det valgte nettverket. Skann en adresse for dette nettverket, eller gå tilbake og velg en annen eiendel."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो कोड छानिएको नेटवर्कसँग मिल्दैन। यही नेटवर्कको ठेगाना स्क्यान गर्नुहोस् वा अर्को सम्पत्ति रोज्न पछाडि जानुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code komt niet overeen met het geselecteerde netwerk. Scan een adres voor dit netwerk of ga terug om een ander activum te kiezen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି କୋଡ୍ ବଛାଯାଇଥିବା ନେଟୱର୍କ ସହ ମେଳ ଖାଉନାହିଁ। ଏହି ନେଟୱର୍କର ଠିକଣା ସ୍କାନ୍ କରନ୍ତୁ କିମ୍ବା ଅନ୍ୟ ସମ୍ପତ୍ତି ବାଛିବାକୁ ପଛକୁ ଯାଆନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਕੋਡ ਚੁਣੇ ਨੈੱਟਵਰਕ ਨਾਲ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। ਇਸ ਨੈੱਟਵਰਕ ਦਾ ਪਤਾ ਸਕੈਨ ਕਰੋ ਜਾਂ ਹੋਰ ਸੰਪਤੀ ਚੁਣਨ ਲਈ ਵਾਪਸ ਜਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod nie pasuje do wybranej sieci. Zeskanuj adres dla tej sieci lub wróć, aby wybrać inne aktywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código não corresponde à rede selecionada. Escaneie um endereço desta rede ou volte para escolher outro ativo."
