        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ហត្ថលេខាដែលអនុម័តបានត្រឡប់ទៅ dApp។ ការចុះហត្ថលេខាតែឯងមិនបញ្ជាក់ការផ្ទេរទេ។"
