        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rede rejeitou a verificação da transação. Nada foi assinado. Volte à dApp e reveja o pedido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rețeaua a respins verificarea tranzacției. Nu a fost semnat nimic. Revino la dApp și verifică cererea."
