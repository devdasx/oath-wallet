    "private_key_view.never_share_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ፈጽሞ አይጠይቅህም። ለማንም አትላከው፣ በድረ ገጽ ላይ አትለጥፈው፣ ወይም ለድጋፍ ሰጪዎች አታጋራው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يطلبها منك Oath أبدًا. لا ترسلها لأحد ولا تلصقها في موقع ولا تشاركها مع الدعم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath কখনও এটি চাইবে না। কাউকে পাঠাবেন না, ওয়েবসাইটে পেস্ট করবেন না বা সহায়তাকর্মীকে দেবেন না।"
