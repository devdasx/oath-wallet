        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కనీసం 8 అక్షరాల పాస్‌వర్డ్‌ను ఎంచుకోండి. బ్యాకప్ పునరుద్ధరణకు ఈ పాస్‌వర్డ్ అవసరం; పోగొట్టుకుంటే తిరిగి పొందలేరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
