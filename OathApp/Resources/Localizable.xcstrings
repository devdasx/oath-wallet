    "send.fee_adjusted" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የቀረው ሂሳብህ ሙሉውን የአውታረ መረብ ክፍያ መሸፈን አይችልም። ከላይ ያለው መጠን ማስተካከያውን ያካትታል፤ ተቀባዩ በትክክል ይህን ይቀበላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغطي رصيدك المتبقي رسوم الشبكة كاملة. يتضمن المبلغ أعلاه التعديل؛ وهو بالضبط ما سيستلمه المستلم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবশিষ্ট ব্যালেন্সে পুরো নেটওয়ার্ক ফি মিটবে না। ওপরের পরিমাণে সমন্বয় ধরা আছে; প্রাপক ঠিক এটিই পাবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývající zůstatek nepokryje celý síťový poplatek. Výše uvedená částka již zahrnuje úpravu; přesně tolik příjemce dostane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din resterende saldo dækker ikke hele netværksgebyret. Beløbet ovenfor er allerede justeret og er præcis det, modtageren får."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Restguthaben deckt die Netzwerkgebühr nicht vollständig. Der obige Betrag ist angepasst und entspricht genau dem Empfangsbetrag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το υπόλοιπο που απομένει δεν καλύπτει ολόκληρη την προμήθεια δικτύου. Το παραπάνω ποσό περιλαμβάνει την προσαρμογή· αυτό ακριβώς θα λάβει ο παραλήπτης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your remaining balance cannot cover the full network fee. The amount above includes the adjustment; this is exactly what the recipient will receive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu saldo restante no cubre toda la comisión de red. El importe anterior incluye el ajuste y es exactamente lo que recibirá el destinatario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجودی باقی‌مانده کل کارمزد شبکه را پوشش نمی‌دهد. مبلغ بالا تعدیل شده است؛ این دقیقاً مبلغی است که گیرنده دریافت می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäljelle jäävä saldosi ei riitä koko verkkomaksuun. Yllä olevaan määrään on jo tehty tarvittava vähennys. Vastaanottaja saa täsmälleen tämän määrän."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi sapat ang natitirang balanse para sa buong bayad sa network. Kasama na sa halaga sa itaas ang pagsasaayos; ito mismo ang matatanggap ng tatanggap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre solde restant ne couvre pas tous les frais de réseau. Le montant ci-dessus inclut l’ajustement ; c’est exactement ce que recevra le destinataire."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું બાકી બેલેન્સ સંપૂર્ણ નેટવર્ક ફી આવરી શકતું નથી. ઉપરની રકમમાં ગોઠવણ સામેલ છે; પ્રાપ્તકર્તાને બરાબર આટલી જ રકમ મળશે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma'auninka da ya rage ba zai iya biyan duk kuɗin hanyar sadarwa ba. Adadin da ke sama yana haɗa daidaitawar; wannan shi ne ainihin abin da mai karɓa zai samu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היתרה שנותרה אינה מכסה את מלוא עמלת הרשת. הסכום שלמעלה כולל את ההתאמה; זה בדיוק הסכום שהנמען יקבל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका बचा बैलेंस पूरा नेटवर्क शुल्क नहीं चुका सकता। ऊपर की रकम में समायोजन शामिल है; प्राप्तकर्ता को ठीक यही रकम मिलेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preostali saldo ne može pokriti punu mrežnu naknadu. Gornji iznos uključuje prilagodbu; primatelj će primiti točno taj iznos."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fennmaradó egyenleged nem fedezi a teljes hálózati díjat. A fenti összeg már tartalmazza a módosítást; a címzett pontosan ennyit kap."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo tersisa Anda tidak cukup untuk seluruh biaya jaringan. Jumlah di atas sudah disesuaikan; inilah jumlah persis yang diterima penerima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il saldo residuo non copre l'intera commissione di rete. L'importo sopra include l'adeguamento: è esattamente ciò che riceverà il destinatario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りの残高では手数料全額を支払えません。上の金額は調整済みで、受取人が受け取る正確な金額です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დარჩენილი ბალანსი სრულ ქსელის საკომისიოს ვერ ფარავს. ზემოთ მოცემული თანხა შესწორებას მოიცავს; მიმღები ზუსტად ამდენს მიიღებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សមតុល្យសល់មិនអាចបង់ថ្លៃបណ្ដាញពេញ។ ចំនួនខាងលើរួមការកែតម្រូវ ហើយជាចំនួនពិតដែលអ្នកទទួលនឹងទទួល។"
