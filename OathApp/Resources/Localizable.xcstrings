    "recovery_view.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እነዚህን ቃላት በትክክለኛው ቅደም ተከተል ጻፍ ወይም ቅዳና በደህና ቦታ አስቀምጥ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوّن هذه الكلمات أو انسخها بالترتيب نفسه واحفظها في مكان آمن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দগুলো ঠিক একই ক্রমে লিখে বা কপি করে নিরাপদ জায়গায় রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapište nebo zkopírujte tato slova v přesném pořadí a uložte je na bezpečné místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ordene ned, eller kopiér dem i nøjagtig rækkefølge, og opbevar dem sikkert."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe oder kopiere diese Wörter in der genauen Reihenfolge und bewahre sie sicher auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε ή αντιγράψτε αυτές τις λέξεις με την ακριβή σειρά και φυλάξτε τις σε ασφαλές μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down or copy these words in the exact order and store them in a secure location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota o copia estas palabras en el orden exacto y guárdalas en un lugar seguro."
          }
        },
        "fa" : {
