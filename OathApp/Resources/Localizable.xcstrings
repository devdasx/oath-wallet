    "security.delay_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ወደ ዳራ ከሄደ በኋላ ለምን ያህል ጊዜ ክፍት እንደሚቆይ ምረጥ። የመክፈቻ ኮድ ጥበቃ ሲኖር፣ መተግበሪያውን እንደገና ማስጀመር ሁልጊዜ ማረጋገጫ ይፈልጋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدة بقاء Oath مفتوحًا بعد الانتقال إلى الخلفية. تتطلب إعادة تشغيل التطبيق التحقق من الهوية دائمًا عند تفعيل الحماية برمز الدخول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেছনে যাওয়ার পরে Oath কতক্ষণ আনলক থাকবে বেছে নিন। পাসকোড সুরক্ষা চালু থাকলে অ্যাপ পুনরায় চালু করার সময় সবসময় পরিচয় যাচাই লাগে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho Oath zůstane odemčen po přechodu na pozadí. Při zapnuté ochraně kódem vyžaduje opětovné spuštění aplikace vždy ověření totožnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor længe Oath forbliver låst op, efter appen er flyttet til baggrunden. Genstart af appen kræver altid godkendelse, når PIN-beskyttelse er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange Oath nach dem Wechsel in den Hintergrund entsperrt bleibt. Bei aktiviertem Code-Schutz erfordert ein Neustart der App immer eine Authentifizierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόσο θα παραμένει ξεκλείδωτο το Oath μετά τη μετάβαση στο παρασκήνιο. Η επανεκκίνηση απαιτεί πάντα έλεγχο ταυτότητας όταν είναι ενεργή η προστασία με κωδικό εισόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long Oath stays unlocked after moving to the background. Restarting the app always requires authentication when passcode protection is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto tiempo permanece Oath desbloqueado al pasar a segundo plano. Reiniciar la app siempre requiere autenticación si la protección por código está activada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب کنید Oath پس از رفتن به پس‌زمینه چه مدت باز بماند. اگر محافظت با رمز ورود روشن باشد، راه‌اندازی دوبارهٔ برنامه همیشه احراز هویت می‌خواهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan Oath pysyy avattuna taustalle siirtymisen jälkeen. Sovelluksen käynnistäminen uudelleen vaatii aina tunnistautumisen, kun pääsykoodisuojaus on käytössä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal mananatiling naka-unlock ang Oath pagkatapos mapunta sa background. Laging kailangan ang pagpapatunay kapag muling binuksan ang app kung naka-on ang proteksyon ng passcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps Oath reste déverrouillé après son passage en arrière-plan. Redémarrer l’app nécessite toujours une authentification si la protection par code est activée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પૃષ્ઠભૂમિમાં ગયા પછી Oath કેટલો સમય અનલૉક રહે તે પસંદ કરો. પાસકોડ સુરક્ષા ચાલુ હોય ત્યારે ઍપ ફરી શરૂ કરવા હંમેશાં ઓળખ ચકાસવી પડે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi tsawon lokacin da Oath zai kasance a buɗe bayan ya koma bango. Sake kunna manhajar kullum yana buƙatar tabbatar da shaidarka idan kariyar lambar buɗewa tana kunne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לבחור לכמה זמן Oath תישאר פתוחה לאחר מעבר לרקע. כשהגנה באמצעות קוד גישה פעילה, הפעלה מחדש של היישום תמיד דורשת אימות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि बैकग्राउंड में जाने के बाद Oath कितनी देर अनलॉक रहे। पासकोड सुरक्षा चालू होने पर ऐप दोबारा शुरू करते समय हमेशा पहचान सत्यापन चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koliko dugo Oath ostaje otključan nakon prelaska u pozadinu. Ponovno pokretanje aplikacije uvijek zahtijeva potvrdu identiteta kada je zaštita pristupnom šifrom uključena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, meddig maradjon az Oath feloldva a háttérbe kerülés után. Ha az alkalmazáskód-védelem be van kapcsolva, az alkalmazás újraindítása mindig hitelesítést igényel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama Oath tetap terbuka setelah masuk ke latar belakang. Memulai ulang aplikasi selalu memerlukan autentikasi saat perlindungan kode sandi aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli per quanto tempo Oath resta sbloccato dopo il passaggio in background. Se la protezione con codice è attiva, il riavvio dell'app richiede sempre l'autenticazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドに移った後、Oathのロック解除を維持する時間を選択します。パスコード保護が有効な場合、アプリの再起動時は必ず認証が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აირჩიეთ, რამდენ ხანს დარჩეს Oath განბლოკილი ფონურ რეჟიმში გადასვლის შემდეგ. თუ წვდომის კოდით დაცვა ჩართულია, აპის ხელახლა გაშვება ყოველთვის მოითხოვს ავთენტიფიკაციას."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជ្រើសរយៈពេលដែល Oath នៅដោះសោបន្ទាប់ពីទៅផ្ទៃខាងក្រោយ។ ការចាប់ផ្ដើមកម្មវិធីឡើងវិញតែងតែត្រូវផ្ទៀងផ្ទាត់ពេលការពារដោយកូដសម្ងាត់បើក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಿನ್ನೆಲೆಗೆ ಹೋದ ನಂತರ Oath ಎಷ್ಟು ಸಮಯ ಅನ್‌ಲಾಕ್ ಆಗಿರಬೇಕು ಎಂದು ಆಯ್ಕೆ ಮಾಡಿ. ಪಾಸ್‌ಕೋಡ್ ರಕ್ಷಣೆ ಆನ್ ಇದ್ದಾಗ ಆ್ಯಪ್ ಮರುಪ್ರಾರಂಭಿಸಿದರೆ ಯಾವಾಗಲೂ ದೃಢೀಕರಣ ಅಗತ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드로 전환한 후 Oath가 잠금 해제 상태를 유지할 시간을 선택하세요. 앱 암호 보호가 켜져 있으면 앱을 다시 시작할 때 항상 인증이 필요합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പശ്ചാത്തലത്തിലേക്ക് മാറിയ ശേഷം Oath എത്ര സമയം അൺലോക്ക് ചെയ്തിരിക്കണമെന്ന് തിരഞ്ഞെടുക്കുക. പാസ്‌കോഡ് സംരക്ഷണം ഓണാണെങ്കിൽ ആപ്പ് പുനരാരംഭിക്കുമ്പോൾ എപ്പോഴും പ്രാമാണീകരണം ആവശ്യമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पार्श्वभूमीत गेल्यानंतर Oath किती काळ अनलॉक राहील ते निवडा. पासकोड संरक्षण सुरू असल्यास ॲप पुन्हा सुरू करताना नेहमी प्रमाणीकरण लागते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempoh Oath kekal terbuka selepas beralih ke latar belakang. Memulakan semula aplikasi sentiasa memerlukan pengesahan apabila perlindungan kod laluan dihidupkan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နောက်ခံသို့ ရွှေ့ပြီးနောက် Oath ကို လော့ခ်ဖွင့်လျက် ထားမည့်အချိန်ကို ရွေးပါ။ ဝင်ခွင့်ကုဒ်ကာကွယ်မှု ဖွင့်ထားလျှင် အက်ပ်ပြန်စတိုင်း အထောက်အထားပြရန် လိုသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvor lenge Oath forblir ulåst etter at appen flyttes til bakgrunnen. Omstart av appen krever alltid autentisering når kodebeskyttelse er på."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पृष्ठभूमिमा गएपछि Oath कति समय अनलक रहने रोज्नुहोस्। पासकोड सुरक्षा चालू हुँदा एप पुनःसुरु गर्दा सधैँ प्रमाणीकरण चाहिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoelang Oath ontgrendeld blijft nadat de app naar de achtergrond gaat. Opnieuw starten vereist altijd verificatie als toegangscodebeveiliging aanstaat."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପୃଷ୍ଠଭୂମିକୁ ଯିବା ପରେ Oath କେତେ ସମୟ ଅନଲକ୍ ରହିବ ବାଛନ୍ତୁ। ପାସକୋଡ୍ ସୁରକ୍ଷା ସକ୍ରିୟ ଥିଲେ ଆପ୍ ପୁଣି ଆରମ୍ଭ କଲେ ସବୁବେଳେ ପରିଚୟ ପ୍ରମାଣ ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਚੁਣੋ ਕਿ ਬੈਕਗ੍ਰਾਊਂਡ ਵਿੱਚ ਜਾਣ ਤੋਂ ਬਾਅਦ Oath ਕਿੰਨਾ ਚਿਰ ਅਨਲੌਕ ਰਹੇ। ਪਾਸਕੋਡ ਸੁਰੱਖਿਆ ਚਾਲੂ ਹੋਣ 'ਤੇ ਐਪ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਹਮੇਸ਼ਾ ਪਛਾਣ ਦੀ ਪੁਸ਼ਟੀ ਲਾਜ਼ਮੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak długo Oath ma pozostawać odblokowane po przejściu do tła. Gdy ochrona kodem jest włączona, ponowne uruchomienie aplikacji zawsze wymaga uwierzytelnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha por quanto tempo Oath fica desbloqueado após ir para segundo plano. Reiniciar o app sempre exige autenticação quando a proteção por código está ativada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha durante quanto tempo Oath permanece desbloqueado depois de passar para segundo plano. Reiniciar a aplicação exige sempre autenticação quando a proteção por código está ativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege cât timp Oath rămâne deblocat după trecerea în fundal. Repornirea aplicației necesită întotdeauna autentificare când protecția prin cod este activată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как долго Oath остаётся разблокированным после перехода в фон. При включённой защите кодом-паролем перезапуск приложения всегда требует подтверждения личности."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چونڊيو ته پسمنظر ۾ وڃڻ کان پوءِ Oath ڪيتري دير کليل رهي. داخلا ڪوڊ جي حفاظت فعال هجي ته ايپ ٻيهر شروع ڪرڻ وقت هميشه سڃاڻپ جي تصديق ضروري آهي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "පසුබිමට ගිය පසු Oath කොපමණ වේලාවක් අගුළු හැර තැබිය යුතුද තෝරන්න. මුරකේත ආරක්ෂාව සක්‍රිය විට යෙදුම නැවත ඇරඹීමට සැමවිටම අනන්‍යතා තහවුරුව අවශ්‍යය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvoľte, ako dlho Oath zostane odomknutý po prechode na pozadie. Pri zapnutej ochrane kódom vyžaduje opätovné spustenie aplikácie vždy overenie totožnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite, kako dolgo Oath ostane odklenjen po premiku v ozadje. Ko je zaščita s kodo omogočena, ponovni zagon aplikacije vedno zahteva potrditev identitete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj hur länge Oath förblir upplåst efter att appen flyttats till bakgrunden. När appkodsskydd är aktiverat kräver en omstart av appen alltid autentisering."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chagua muda ambao Oath hubaki wazi baada ya kwenda chinichini. Kuanzisha programu tena daima kunahitaji uthibitishaji ikiwa ulinzi wa msimbo umewashwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பின்புலத்திற்குச் சென்ற பிறகு Oath எவ்வளவு நேரம் திறந்திருக்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும். அணுகல் குறியீட்டுப் பாதுகாப்பு இயக்கப்பட்டிருக்கும்போது செயலியை மறுதொடக்கம் செய்தால் எப்போதும் அடையாள உறுதிப்படுத்தல் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బ్యాక్‌గ్రౌండ్‌కు వెళ్లిన తర్వాత Oath ఎంతసేపు అన్‌లాక్‌గా ఉండాలో ఎంచుకోండి. పాస్‌కోడ్ రక్షణ ఆన్‌లో ఉంటే యాప్‌ను తిరిగి ప్రారంభించినప్పుడు ఎల్లప్పుడూ ధృవీకరణ అవసరం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระยะเวลาที่ Oath ยังปลดล็อกหลังไปอยู่เบื้องหลัง หากเปิดการป้องกันด้วยรหัสปลดล็อก การเริ่มแอปใหม่ต้องยืนยันตัวตนเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath arka plana geçtikten sonra ne kadar süre açık kalacağını seçin. Parola koruması açıkken uygulamayı yeniden başlatmak her zaman kimlik doğrulaması gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, як довго Oath залишатиметься розблокованим після переходу у фон. Якщо захист кодом увімкнено, перезапуск застосунку завжди потребує підтвердження особи."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب کریں کہ پس منظر میں جانے کے بعد Oath کتنی دیر ان لاک رہے۔ پاس کوڈ حفاظت فعال ہو تو ایپ دوبارہ شروع کرنے پر ہمیشہ شناخت کی تصدیق ضروری ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath fonga o‘tgandan keyin qancha vaqt ochiq turishini tanlang. Kirish kodi himoyasi yoqilganda ilovani qayta ishga tushirish har doim shaxsni tasdiqlashni talab qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn thời gian Oath tiếp tục mở khóa sau khi chuyển sang nền. Khi bật bảo vệ bằng mã khóa, khởi động lại ứng dụng luôn yêu cầu xác thực."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan bí Oath yóò ṣe pẹ́ ní ṣíṣí lẹ́yìn tí ó bá lọ sí ẹ̀yìn. Bí ààbò kóòdù ìwọlé bá ṣiṣẹ́, títún ètò bẹ̀rẹ̀ máa nílò ìjẹ́rìísí ẹni tí o jẹ́ nígbà gbogbo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 Oath 进入后台后保持解锁的时长。启用应用密码保护时，重新启动应用始终需要验证身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇 Oath 進入背景後維持解鎖的時間。啟用密碼保護時，重新啟動 App 一律需要驗證身分。"
          }
        }
      }
    },
