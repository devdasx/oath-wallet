        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବଛାଯାଇଥିବା ନେଟୱର୍କରେ ଏହି ସଂଯୋଗ ଯେଉଁ ପଦ୍ଧତି ଅନୁରୋଧ କରିପାରିବ ତାହା ଏଗୁଡ଼ିକ। ପ୍ରତ୍ୟେକ ସ୍ୱାକ୍ଷର କିମ୍ବା ଲେନଦେନ ପାଇଁ ଏବେବି ଆପଣଙ୍କ ଅନୁମୋଦନ ଦରକାର।"
          }
        },
        "pa" : {
          "stringUnit" : {
