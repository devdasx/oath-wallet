        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤအဆင့်ကို ကွန်ရက်က အတည်ပြုရန် စောင့်နေသည်။ အတည်ပြုပြီးမှ နောက်အဆင့်ကို ဆက်လုပ်နိုင်မည်။"
