        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ તમે મોકલતા હો તે રકમનો ભાગ છે. કુલમાં તે પહેલેથી સામેલ છે અને ફરી વસૂલાતું નથી."
