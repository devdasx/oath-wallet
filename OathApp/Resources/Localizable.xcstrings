    "scannerInvalidRecoveryDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቃላቱ፣ የቃላት ብዛቱ ወይም የማረጋገጫ ድምሩ ትክክል አይደለም። ዋናውን የመመለሻ ሐረግ አረጋግጥና እንደገና ሞክር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات أو عددها أو المجموع الاختباري غير صالح. تحقق من عبارة الاسترداد الأصلية وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শব্দ, শব্দসংখ্যা বা চেকসাম বৈধ নয়। মূল পুনরুদ্ধার বাক্যাংশ দেখে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slova, jejich počet nebo kontrolní součet nejsou platné. Zkontrolujte původní obnovovací frázi a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene, antallet af ord eller kontrolsummen er ugyldige. Kontrollér den oprindelige gendannelsesfrase, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter, Wortanzahl oder Prüfsumme sind ungültig. Prüfe die ursprüngliche Wiederherstellungsphrase und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λέξεις, ο αριθμός λέξεων ή το άθροισμα ελέγχου δεν είναι έγκυρα. Ελέγξτε την αρχική φράση ανάκτησης και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The words, word count or checksum are not valid. Check the original recovery phrase and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras, su cantidad o la suma de comprobación no son válidas. Comprueba la frase original y reintenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژه‌ها، تعداد واژه‌ها یا جمع کنترلی معتبر نیستند. عبارت بازیابی اصلی را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanat, sanamäärä tai tarkistussumma eivät kelpaa. Tarkista alkuperäinen palautuslause ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi wasto ang mga salita, bilang ng salita o checksum. Suriin ang orihinal na recovery phrase at subukan muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots, leur nombre ou la somme de contrôle sont invalides. Vérifiez la phrase de récupération d’origine et réessayez."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શબ્દો, શબ્દસંખ્યા અથવા ચેકસમ માન્ય નથી. મૂળ પુનઃપ્રાપ્તિ શબ્દસમૂહ તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalmomi, adadin kalmomi ko checksum ba su inganta ba. Duba asalin jimlar dawo da walat ka sake gwadawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המילים, מספר המילים או סכום הביקורת אינם תקינים. יש לבדוק את ביטוי השחזור המקורי ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द, शब्द संख्या या चेकसम मान्य नहीं है। मूल रिकवरी फ़्रेज़ जाँचकर फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riječi, njihov broj ili kontrolni zbroj nisu valjani. Provjerite izvornu frazu za oporavak pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szavak, a szavak száma vagy az ellenőrző összeg nem érvényes. Ellenőrizd az eredeti helyreállító szósort, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata-kata, jumlah kata, atau checksum tidak valid. Periksa frasa pemulihan asli dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole, il loro numero o il checksum non sono validi. Controlla la frase di recupero originale e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語、単語数、またはチェックサムが無効です。元のリカバリーフレーズを確認して再試行してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიტყვები, სიტყვების რაოდენობა ან საკონტროლო ჯამი არასწორია. შეამოწმეთ თავდაპირველი აღდგენის ფრაზა და ხელახლა სცადეთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពាក្យ ចំនួនពាក្យ ឬផលបូកផ្ទៀងផ្ទាត់មិនត្រឹមត្រូវ។ ពិនិត្យឃ្លាស្ដារដើម រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪದಗಳು, ಪದಗಳ ಸಂಖ್ಯೆ ಅಥವಾ checksum ಮಾನ್ಯವಲ್ಲ. ಮೂಲ ಮರುಪಡೆಯುವ ನುಡಿಗಟ್ಟು ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어, 단어 수 또는 체크섬이 올바르지 않습니다. 원래 복구 구문을 확인한 후 다시 시도하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാക്കുകളോ വാക്കുകളുടെ എണ്ണമോ ചെക്ക്‌സമോ സാധുവല്ല. യഥാർത്ഥ വീണ്ടെടുക്കൽ വാക്യം പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द, शब्दसंख्या किंवा चेकसम वैध नाहीत. मूळ पुनर्प्राप्ती वाक्यांश तपासून पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkataan, bilangan perkataan atau checksum tidak sah. Semak frasa pemulihan asal dan cuba lagi."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားလုံးများ၊ စကားလုံးအရေအတွက် သို့မဟုတ် checksum မမှန်ပါ။ မူရင်းပြန်လည်ရယူရေးစကားစုကို စစ်ပြီး ထပ်စမ်းပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene, antallet ord eller kontrollsummen er ugyldig. Kontroller den opprinnelige gjenopprettingsfrasen og prøv igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द, शब्द सङ्ख्या वा चेकसम मान्य छैन। मूल पुनःप्राप्ति वाक्यांश जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De woorden, het aantal woorden of de controlesom zijn niet geldig. Controleer de oorspronkelijke herstelzin en probeer het opnieuw."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶବ୍ଦ, ଶବ୍ଦ ସଂଖ୍ୟା କିମ୍ବା checksum ବୈଧ ନୁହେଁ। ମୂଳ ରିକଭରି ଫ୍ରେଜ୍ ଯାଞ୍ଚ କରି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ਬਦ, ਸ਼ਬਦਾਂ ਦੀ ਗਿਣਤੀ ਜਾਂ ਚੈੱਕਸਮ ਵੈਧ ਨਹੀਂ ਹਨ। ਮੂਲ ਰਿਕਵਰੀ ਸ਼ਬਦ ਜਾਂਚੋ ਅਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowa, ich liczba lub suma kontrolna są nieprawidłowe. Sprawdź oryginalną frazę odzyskiwania i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As palavras, a quantidade de palavras ou a soma de verificação não são válidas. Confira a frase de recuperação original e tente novamente."
