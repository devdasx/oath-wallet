    "wcRequestDeclinedDetail" : {
      "extractionState" : "stale",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን ጥያቄ አልተቀበልክም። ለእሱ ምንም ፊርማ አልተፈጠረም። ነባር የቶከን ማውጣት ፈቃዶች አልተቀየሩም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفضت هذا الطلب. لم يُنشأ له توقيع. تبقى حدود إنفاق الرموز الموجودة كما هي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এই অনুরোধ প্রত্যাখ্যান করেছেন। কোনো স্বাক্ষর তৈরি হয়নি। আগের টোকেন ব্যয়সীমা অপরিবর্তিত আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento požadavek jste odmítli. Nebyl pro něj vytvořen podpis. Stávající limity útraty tokenů se nezměnily."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du afviste denne anmodning. Der blev ikke oprettet nogen signatur til den. Eksisterende tilladelser til tokenforbrug er uændrede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Anfrage abgelehnt. Es wurde keine Signatur erstellt. Bestehende Token-Freigaben bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απορρίψατε αυτό το αίτημα. Δεν δημιουργήθηκε υπογραφή για αυτό. Οι υπάρχουσες εξουσιοδοτήσεις δαπάνης token δεν άλλαξαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You declined this request. No signature was created for it. Existing token allowances are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechazaste esta solicitud. No se creó ninguna firma. Los límites de tokens existentes no cambian."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این درخواست را رد کردید. امضایی برای آن ساخته نشد. سقف‌های فعلی خرج‌کرد توکن تغییر نکرده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hylkäsit tämän pyynnön. Sille ei luotu allekirjoitusta. Nykyiset tokenien käyttöoikeudet eivät muuttuneet."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggihan mo ang kahilingan. Walang ginawang pirma para rito. Hindi nagbago ang mga kasalukuyang pahintulot sa paggastos ng token."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez refusé cette demande. Aucune signature n’a été créée. Les autorisations de jetons existantes restent inchangées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે આ વિનંતી નકારી. તેના માટે કોઈ હસ્તાક્ષર બન્યા નથી. હાલની ટોકન ખર્ચ પરવાનગીઓ યથાવત્ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka ƙi wannan buƙatar. Ba a ƙirƙiri sa hannu gare ta ba. Izinin kashe token da suke akwai ba su canza ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דחית את הבקשה הזו. לא נוצרה עבורה חתימה. הרשאות הוצאת טוקנים קיימות לא השתנו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने यह अनुरोध अस्वीकार किया। इसके लिए कोई हस्ताक्षर नहीं बना। मौजूदा टोकन खर्च अनुमतियाँ नहीं बदली हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbili ste ovaj zahtjev. Za njega nije izrađen potpis. Postojeća odobrenja potrošnje tokena nisu promijenjena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elutasítottad ezt a kérést. Nem készült hozzá aláírás. A meglévő tokenköltési engedélyek nem változtak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menolak permintaan ini. Tidak ada tanda tangan yang dibuat untuknya. Izin belanja token yang ada tetap sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai rifiutato la richiesta. Non è stata creata alcuna firma. Le autorizzazioni di spesa dei token esistenti restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを拒否しました。署名は作成されていません。既存のトークン利用許可は変わりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენ ეს მოთხოვნა უარყავით. მისთვის ხელმოწერა არ შექმნილა. ტოკენების არსებული ხარჯვის უფლებები უცვლელია."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកបានបដិសេធសំណើនេះ។ មិនបានបង្កើតហត្ថលេខាសម្រាប់វា។ កំណត់ចំណាយថូខិនដែលមាននៅដដែល។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಈ ವಿನಂತಿ ತಿರಸ್ಕರಿಸಿದ್ದೀರಿ. ಇದಕ್ಕಾಗಿ ಯಾವುದೇ ಸಹಿ ರಚಿಸಿಲ್ಲ. ಈಗಿರುವ ಟೋಕನ್ ಖರ್ಚು ಅನುಮತಿಗಳು ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 요청을 거절했습니다. 해당 요청의 서명은 생성되지 않았습니다. 기존 토큰 지출 한도는 변경되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ ഈ അഭ്യർത്ഥന നിരസിച്ചു. അതിന് ഒപ്പൊന്നും സൃഷ്ടിച്ചിട്ടില്ല. നിലവിലുള്ള ടോക്കൺ ചെലവഴിക്കൽ പരിധികൾ മാറിയിട്ടില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही ही विनंती नाकारली. तिच्यासाठी स्वाक्षरी तयार झाली नाही. विद्यमान टोकन खर्च परवानग्या बदललेल्या नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menolak permintaan ini. Tiada tandatangan dicipta untuknya. Kebenaran token sedia ada tidak berubah."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤတောင်းဆိုချက်ကို သင်ငြင်းပယ်ခဲ့သည်။ ၎င်းအတွက် လက်မှတ် မဖန်တီးရသေးပါ။ ရှိပြီးသား တိုကင်သုံးစွဲခွင့်များ မပြောင်းပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du avviste denne forespørselen. Ingen signatur ble opprettet for den. Eksisterende tokenfullmakter er uendret."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंले अनुरोध अस्वीकार गर्नुभयो। यसको हस्ताक्षर बनाइएन। भएका टोकन खर्च सीमा फेरिएका छैनन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt dit verzoek afgewezen. Er is geen handtekening voor aangemaakt. Bestaande tokenbestedingsrechten zijn ongewijzigd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ ଏହି ଅନୁରୋଧ ପ୍ରତ୍ୟାଖ୍ୟାନ କରିଛନ୍ତି। ଏଥିପାଇଁ ସ୍ୱାକ୍ଷର ତିଆରି ହୋଇନାହିଁ। ପୂର୍ବରୁ ଥିବା ଟୋକେନ ଖର୍ଚ୍ଚ ଅଧିକାର ଅପରିବର୍ତ୍ତିତ ଅଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਬੇਨਤੀ ਰੱਦ ਕੀਤੀ। ਇਸ ਲਈ ਕੋਈ ਦਸਤਖ਼ਤ ਨਹੀਂ ਬਣੇ। ਮੌਜੂਦਾ ਟੋਕਨ ਖਰਚ ਅਧਿਕਾਰ ਨਹੀਂ ਬਦਲੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odrzucono to żądanie. Nie utworzono dla niego podpisu. Istniejące limity wydatków tokenów pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recusou esta solicitação. Nenhuma assinatura foi criada. Os limites de tokens existentes não mudaram."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recusou este pedido. Não foi criada nenhuma assinatura. Os limites de tokens existentes mantêm-se iguais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai refuzat această cerere. Nu a fost creată nicio semnătură pentru ea. Drepturile existente de cheltuire a tokenurilor rămân neschimbate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отклонили запрос. Подпись для него не создана. Существующие лимиты расходов токенов не изменены."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توهان هي درخواست رد ڪئي. ان لاءِ ڪو دستخط نه ٺاهيو ويو. موجوده ٽوڪن خرچ جا اختيار نه بدليا آهن."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ ඉල්ලීම ප්‍රතික්ෂේප කළේය. එයට අත්සනක් සෑදුවේ නැත. පවතින ටෝකන වියදම් සීමා නොවෙනස්ය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túto požiadavku ste odmietli. Nebol pre ňu vytvorený podpis. Existujúce limity míňania tokenov sa nezmenili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zahtevo ste zavrnili. Zanjo ni bil ustvarjen podpis. Obstoječi dovoljeni zneski žetonov so nespremenjeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du avvisade begäran. Ingen signatur skapades för den. Befintliga tokenbehörigheter är oförändrade."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umekataa ombi hili. Hakuna saini iliyoundwa kwa ajili yake. Ruhusa zilizopo za kutumia tokeni hazijabadilika."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் கோரிக்கையை நிராகரித்தீர்கள். அதற்குக் கையொப்பம் உருவாக்கப்படவில்லை. ஏற்கனவே உள்ள டோக்கன் செலவிடும் அனுமதிகள் மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు ఈ అభ్యర్థనను తిరస్కరించారు. దానికి సంతకం సృష్టించబడలేదు. ఉన్న టోకెన్ ఖర్చు అనుమతులు మారలేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณปฏิเสธคำขอนี้ ไม่ได้สร้างลายเซ็นให้คำขอนี้ วงเงินโทเค็นเดิมไม่เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu isteği reddettiniz. İstek için imza oluşturulmadı. Mevcut token harcama yetkileri değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви відхилили цей запит. Підпис для нього не створено. Наявні ліміти витрат токенів не змінено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ نے یہ درخواست مسترد کی۔ اس کے لیے دستخط نہیں بنا۔ موجودہ ٹوکن خرچ کی اجازتیں تبدیل نہیں ہوئیں۔"
