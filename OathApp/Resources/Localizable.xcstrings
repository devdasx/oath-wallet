        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सम्झौताका लागि NEAR मा भण्डारण सञ्चिति आवश्यक हुन्छ। नेटवर्क शुल्क NEAR लाई तिरिन्छ; Oath ले सक्रिय गर्ने शुल्क लिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
