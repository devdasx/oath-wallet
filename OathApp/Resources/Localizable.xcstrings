    "wcSolanaDurableNonce" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This authorization does not expire with time. It remains valid until the nonce is used or changed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنتهي صلاحية هذا التفويض بمرور الوقت. يبقى صالحًا حتى استخدام القيمة الفريدة أو تغييرها."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ፈቃድ በጊዜ አያበቃም። nonce እስኪጠቀም ወይም እስኪቀየር ድረስ ይሰራል።"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অনুমোদন সময়ের সঙ্গে মেয়াদোত্তীর্ণ হয় না। নন্স ব্যবহার বা পরিবর্তন না হওয়া পর্যন্ত এটি বৈধ থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto oprávnění časem nevyprší. Platí, dokud není nonce použit nebo změněn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne godkendelse udløber ikke med tiden. Den er gyldig, indtil noncen bruges eller ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Autorisierung läuft nicht mit der Zeit ab. Sie bleibt gültig, bis die Nonce verwendet oder geändert wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η εξουσιοδότηση δεν λήγει με την πάροδο του χρόνου. Ισχύει μέχρι να χρησιμοποιηθεί ή να αλλάξει το nonce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta autorización no caduca con el tiempo. Sigue siendo válida hasta que se use o cambie el nonce."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مجوز با گذشت زمان منقضی نمی‌شود. تا زمانی که نانس استفاده یا تغییر داده شود معتبر می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä valtuutus ei vanhene ajan myötä. Se on voimassa, kunnes nonce käytetään tai sitä muutetaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nag-e-expire sa paglipas ng panahon ang pahintulot na ito. Mananatili itong valid hanggang magamit o mabago ang nonce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette autorisation n’expire pas avec le temps. Elle reste valide jusqu’à ce que le nonce soit utilisé ou modifié."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ અધિકૃતતા સમય સાથે સમાપ્ત થતી નથી. નોન્સ વપરાય અથવા બદલાય ત્યાં સુધી તે માન્ય રહે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan izini ba ya ƙarewa da lokaci. Yana aiki har sai an yi amfani da nonce ko an canza shi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשאה זו אינה פוקעת עם הזמן. היא נשארת תקפה עד לשימוש ב־nonce או לשינויו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह अनुमति समय के साथ समाप्त नहीं होती। नॉन्स के इस्तेमाल या बदले जाने तक यह मान्य रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo ovlaštenje ne istječe s vremenom. Vrijedi dok se nonce ne upotrijebi ili promijeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az engedély nem jár le az idő múlásával. A nonce felhasználásáig vagy módosításáig érvényes marad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otorisasi ini tidak kedaluwarsa seiring waktu. Otorisasi tetap berlaku hingga nonce digunakan atau diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa autorizzazione non scade con il tempo. Rimane valida finché il nonce non viene utilizzato o modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この承認は時間の経過では失効しません。ノンスが使用または変更されるまで有効です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ ავტორიზაციას დროის გასვლით ვადა არ ეწურება. ის მოქმედებს nonce-ის გამოყენებამდე ან შეცვლამდე."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការអនុញ្ញាតនេះមិនផុតកំណត់តាមពេលវេលាទេ។ វានៅតែមានសុពលភាពរហូតដល់ nonce ត្រូវបានប្រើ ឬផ្លាស់ប្តូរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಅನುಮತಿ ಕಾಲ ಕಳೆದಂತೆ ಮುಕ್ತಾಯವಾಗುವುದಿಲ್ಲ. ನಾನ್ಸ್ ಬಳಸುವವರೆಗೆ ಅಥವಾ ಬದಲಾಯಿಸುವವರೆಗೆ ಇದು ಮಾನ್ಯವಾಗಿರುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 승인은 시간이 지나도 만료되지 않습니다. 논스가 사용되거나 변경될 때까지 유효합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ അനുമതി സമയം കഴിയുമ്പോൾ കാലഹരണപ്പെടില്ല. നോൺസ് ഉപയോഗിക്കുന്നതോ മാറ്റുന്നതോ വരെ ഇത് സാധുവായിരിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ही अधिकृतता वेळेनुसार कालबाह्य होत नाही. नॉन्स वापरला किंवा बदलला जाईपर्यंत ती वैध राहते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebenaran ini tidak luput mengikut masa. Ia kekal sah sehingga nonce digunakan atau diubah."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤခွင့်ပြုချက်သည် အချိန်ကြာလာ၍ သက်တမ်းမကုန်ပါ။ Nonce ကို အသုံးပြုခြင်း သို့မဟုတ် ပြောင်းလဲခြင်း မပြုမချင်း အကျုံးဝင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne godkjenningen utløper ikke med tiden. Den er gyldig til noncen brukes eller endres."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो अनुमति समयसँगै समाप्त हुँदैन। नन्स प्रयोग वा परिवर्तन नभएसम्म यो मान्य रहन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze autorisatie verloopt niet na verloop van tijd. Ze blijft geldig totdat de nonce wordt gebruikt of gewijzigd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଅନୁମତି ସମୟ ସହିତ ସମାପ୍ତ ହୁଏ ନାହିଁ। ନନ୍ସ ବ୍ୟବହାର କିମ୍ବା ପରିବର୍ତ୍ତନ ହେବା ପର୍ଯ୍ୟନ୍ତ ଏହା ବୈଧ ରହେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਅਧਿਕਾਰ ਸਮੇਂ ਨਾਲ ਖਤਮ ਨਹੀਂ ਹੁੰਦਾ। ਨੌਂਸ ਦੀ ਵਰਤੋਂ ਜਾਂ ਤਬਦੀਲੀ ਹੋਣ ਤੱਕ ਇਹ ਵੈਧ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To upoważnienie nie wygasa z upływem czasu. Pozostaje ważne do użycia lub zmiany nonce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta autorização não expira com o tempo. Ela permanece válida até que o nonce seja usado ou alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta autorização não expira com o tempo. Permanece válida até que o nonce seja utilizado ou alterado."
          }
        },
        "ro" : {
          "stringUnit" : {
