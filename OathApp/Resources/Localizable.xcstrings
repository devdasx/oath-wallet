    "passphrase.storage_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath የማለፊያ ሐረጉን በተመሰጠረው የመሣሪያህ ማከማቻ ውስጥ ያስቀምጣል። የራስህንም ደህንነቱ የተጠበቀ ቅጂ ያዝ። ለአዲሱ ዋሌት የተሠራ iCloud ምትኬ የማለፊያ ሐረጉን ይይዛል፤ የመጀመሪያው ዋሌትህ ምትኬ ግን አይይዘውም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Oath عبارة المرور في خزنتك المحلية المشفّرة. احتفظ أيضًا بنسخة آمنة خاصة بك. تتضمن نسخة iCloud للمحفظة الجديدة عبارة مرورها؛ أما نسخة محفظتك الأصلية فلا تتضمنها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath এনক্রিপ্ট করা স্থানীয় ভল্টে পাসফ্রেজ রাখে। নিজের নিরাপদ কপিও রাখুন। নতুন ওয়ালেটের iCloud ব্যাকআপে তার পাসফ্রেজ থাকে; মূল ওয়ালেটের ব্যাকআপে থাকে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ukládá přístupovou frázi do šifrovaného místního trezoru. Uchovejte si i vlastní bezpečnou kopii. Záloha iCloud vytvořená pro novou peněženku obsahuje její přístupovou frázi; záloha původní peněženky ji neobsahuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath gemmer adgangssætningen i dit krypterede lokale nøglelager. Opbevar også selv en sikker kopi. En iCloud-sikkerhedskopi af den nye wallet indeholder dens adgangssætning; sikkerhedskopien af din oprindelige wallet gør ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath speichert die Passphrase in deinem verschlüsselten lokalen Tresor. Bewahre zusätzlich eine eigene sichere Kopie auf. Eine iCloud-Sicherung der neuen Wallet enthält ihre Passphrase; die Sicherung der ursprünglichen Wallet nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Oath αποθηκεύει τη μυστική φράση στο κρυπτογραφημένο τοπικό σας θησαυροφυλάκιο. Φυλάξτε και δικό σας ασφαλές αντίγραφο. Ένα αντίγραφο ασφαλείας iCloud για το νέο πορτοφόλι περιλαμβάνει τη μυστική φράση του· το αντίγραφο του αρχικού πορτοφολιού δεν την περιλαμβάνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath saves the passphrase in your encrypted local vault. Keep your own secure copy too. An iCloud backup made for the new wallet includes its passphrase; your original wallet’s backup does not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath guarda la frase de contraseña en tu bóveda local cifrada. Guarda también tu propia copia segura. La copia en iCloud de la cartera nueva incluye su frase de contraseña; la de la cartera original no."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath عبارت عبور را در مخزن محلی رمزگذاری‌شدهٔ شما ذخیره می‌کند. خودتان نیز نسخه‌ای امن نگه دارید. پشتیبان iCloud کیف پول جدید شامل عبارت عبور آن است؛ پشتیبان کیف پول اصلی شامل آن نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath tallentaa salalauseen salattuun paikalliseen avainholviisi. Säilytä myös oma turvallinen kopiosi. Uuden lompakon iCloud-varmuuskopio sisältää sen salalauseen, mutta alkuperäisen lompakkosi varmuuskopio ei sisällä sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sine-save ng Oath ang passphrase sa naka-encrypt na lokal na vault mo. Magtago rin ng sarili mong ligtas na kopya. Kasama ang passphrase sa iCloud backup ng bagong wallet; hindi ito kasama sa backup ng orihinal na wallet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath enregistre la phrase secrète dans votre coffre local chiffré. Gardez aussi votre propre copie en lieu sûr. Une sauvegarde iCloud du nouveau portefeuille inclut sa phrase secrète ; celle du portefeuille d’origine ne l’inclut pas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath પાસફ્રેઝ તમારા ઉપકરણના એન્ક્રિપ્ટેડ સંગ્રહમાં સાચવે છે. તમારી પોતાની સુરક્ષિત નકલ પણ રાખો. નવા વૉલેટનો iCloud બૅકઅપ તેનો પાસફ્રેઝ સામેલ કરે છે; મૂળ વૉલેટનો બૅકઅપ નથી કરતો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath yana ajiye jimlar sirri a rumbun bayananka na cikin na'ura mai ɓoyayyen tsari. Ka kuma riƙe naka kwafin cikin tsaro. Madadin iCloud da aka yi wa sabon walat yana ɗauke da jimlar sirrinsa; madadin walat ɗinka na asali ba ya ɗauke da ita."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath שומרת את ביטוי הסיסמה בכספת המקומית המוצפנת שלך. יש לשמור גם עותק מאובטח משלך. גיבוי iCloud שנוצר עבור הארנק החדש כולל את ביטוי הסיסמה שלו; הגיבוי של הארנק המקורי אינו כולל אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath पासफ़्रेज़ को आपके एन्क्रिप्टेड स्थानीय वॉल्ट में सेव करता है। अपनी एक सुरक्षित प्रति भी रखें। नए वॉलेट के iCloud बैकअप में उसका पासफ़्रेज़ होता है; मूल वॉलेट के बैकअप में नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath sprema tajnu frazu u vaš šifrirani lokalni trezor. Čuvajte i vlastitu sigurnu kopiju. iCloud sigurnosna kopija novog novčanika uključuje njegovu tajnu frazu; sigurnosna kopija izvornog novčanika je ne uključuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Oath a titkosított helyi kulcstáradban menti a jelmondatot. Tarts róla saját biztonságos másolatot is. Az új tárcához készített iCloud-mentés tartalmazza a jelmondatát, az eredeti tárca mentése viszont nem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath menyimpan frasa sandi di brankas lokal terenkripsi Anda. Simpan juga salinan aman sendiri. Cadangan iCloud untuk dompet baru menyertakan frasa sandinya; cadangan dompet asli tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath salva la passphrase nella cassaforte locale crittografata. Conservane anche una copia sicura. Il backup iCloud del nuovo wallet include la passphrase; quello del wallet originale no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oathはパスフレーズを暗号化されたローカル保管庫に保存します。ご自身でも安全なコピーを保管してください。新しいウォレットのiCloudバックアップにはパスフレーズが含まれますが、元のウォレットのバックアップには含まれません。"
          }
