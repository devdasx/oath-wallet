    "seedPasswordNormalization" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum አቢይ እና ንዑስ ፊደላትን፣ የድምፅ ምልክቶችን እና ተደጋጋሚ ክፍተቶችን እንደ አንድ ይቆጥራል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعامل Electrum مع الأحرف الكبيرة والصغيرة والأحرف ذات علامات التشكيل والمسافات المتكررة على أنها متكافئة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum বড় ও ছোট হাতের অক্ষর, উচ্চারণচিহ্ন এবং পরপর একাধিক ফাঁককে সমতুল্য ধরে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum nerozlišuje velká a malá písmena ani diakritiku a opakované mezery považuje za jedinou mezeru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum skelner ikke mellem store og små bogstaver, bogstaver med og uden accenter eller enkelte og gentagne mellemrum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum behandelt Groß- und Kleinbuchstaben, Akzente und mehrfache Leerzeichen als gleichwertig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Electrum θεωρεί ισοδύναμα τα κεφαλαία και πεζά γράμματα, τα γράμματα με ή χωρίς τόνους και τα επαναλαμβανόμενα κενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum treats uppercase and lowercase letters, accents, and repeated spaces as equivalent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum trata como equivalentes las mayúsculas y las minúsculas, las letras con y sin acento y los espacios repetidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum میان حروف بزرگ و کوچک، نشانه‌های آوایی و فاصله‌های تکراری تفاوتی قائل نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum käsittelee isot ja pienet kirjaimet, tarkemerkit sekä toistuvat välilyönnit samanarvoisina."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinuturing ng Electrum na magkakatumbas ang malalaki at maliliit na letra, mga accent, at paulit-ulit na espasyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum traite comme équivalentes les majuscules et les minuscules, les lettres accentuées et non accentuées, ainsi que les espaces répétés."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum મોટા-નાના અક્ષરો, ઉચ્ચારચિહ્નો અને સતત આવતી ખાલી જગ્યાઓ વચ્ચેના ફરકને ધ્યાનમાં લેતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum yana ɗaukar manyan haruffa da ƙananan haruffa, alamomin lafazi da maimaitattun sarari a matsayin abu ɗaya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrum מתייחס לאותיות גדולות וקטנות, לסימנים דיאקריטיים ולרווחים חוזרים כשקולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
