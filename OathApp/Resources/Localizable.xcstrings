    "biometrics.locked_out" : {
      "comment" : "App interface text.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መክፈቻ ኮድህ ተቀምጧል። ባዮሜትሪክስን ለመመለስ መሣሪያህን ክፈትና እንደገና ሞክር፣ ወይም በመክፈቻ ኮድህ ቀጥል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ رمز الدخول. افتح قفل جهازك لاستعادة القياسات البيومترية ثم حاول مجددًا، أو تابع برمز الدخول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পাসকোড সংরক্ষিত হয়েছে। বায়োমেট্রিক ফিরিয়ে আনতে ডিভাইস আনলক করে আবার চেষ্টা করুন, অথবা পাসকোড দিয়ে এগিয়ে যান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístupový kód je uložen. Odemkněte zařízení, aby se biometrie obnovila, a zkuste to znovu, nebo pokračujte s kódem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din PIN-kode er gemt. Lås enheden op for at genaktivere biometri, og prøv derefter igen, eller fortsæt med din PIN-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Code wurde gespeichert. Entsperre dein Gerät, um die Biometrie wieder zu aktivieren, und versuche es erneut, oder fahre mit deinem Code fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός εισόδου σας αποθηκεύτηκε. Ξεκλειδώστε τη συσκευή για να επανέλθουν τα βιομετρικά στοιχεία και δοκιμάστε ξανά ή συνεχίστε με τον κωδικό εισόδου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your passcode is saved. Unlock your device to restore biometrics, then try again, or continue with your passcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu código de acceso está guardado. Desbloquea el dispositivo para restablecer la biometría y vuelve a intentarlo, o continúa con tu código."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز ورود برنامه ذخیره شد. برای بازیابی زیست‌سنجی، قفل دستگاه را باز کنید و دوباره تلاش کنید، یا با رمز ورود برنامه ادامه دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pääsykoodisi on tallennettu. Avaa laitteesi lukitus biometrisen tunnistuksen palauttamiseksi ja yritä uudelleen tai jatka pääsykoodilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-save ang passcode mo. I-unlock ang device para maibalik ang biometrics at subukan muli, o magpatuloy gamit ang passcode mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre code d’accès est enregistré. Déverrouillez votre appareil pour rétablir la biométrie, puis réessayez, ou continuez avec votre code."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારો ઍપ પાસકોડ સાચવ્યો છે. બાયોમેટ્રિક ફરી ઉપલબ્ધ કરવા ઉપકરણ અનલૉક કરો, પછી ફરી પ્રયાસ કરો અથવા તમારા પાસકોડથી આગળ વધો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ajiye lambar buɗewarka. Buɗe na'urarka don dawo da tantance halitta, sannan sake gwadawa, ko ci gaba da lambar buɗewarka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוד הגישה נשמר. יש לבטל את נעילת המכשיר כדי לשחזר את הגישה הביומטרית ולנסות שוב, או להמשיך באמצעות קוד הגישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासकोड सेव है। बायोमेट्रिक बहाल करने के लिए डिवाइस अनलॉक करके फिर कोशिश करें या पासकोड से जारी रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša je pristupna šifra spremljena. Otključajte uređaj kako biste ponovno omogućili biometriju, pa pokušajte ponovno ili nastavite s pristupnom šifrom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazáskód mentve. A biometria helyreállításához oldd fel az eszköz zárolását, és próbáld újra, vagy folytasd az alkalmazáskóddal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode sandi Anda telah disimpan. Buka kunci perangkat untuk memulihkan biometrik, lalu coba lagi, atau lanjutkan dengan kode sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice è salvato. Sblocca il dispositivo per ripristinare la biometria e riprova, oppure continua con il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードを保存しました。デバイスのロックを解除して生体認証を復帰させてから再試行するか、パスコードで続行してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი წვდომის კოდი შენახულია. ბიომეტრიის აღსადგენად განბლოკეთ მოწყობილობა და ხელახლა სცადეთ, ან გააგრძელეთ წვდომის კოდით."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កូដសម្ងាត់របស់អ្នកបានរក្សាទុក។ ដោះសោឧបករណ៍ដើម្បីស្ដារជីវមាត្រ រួចព្យាយាមម្ដងទៀត ឬបន្តដោយកូដសម្ងាត់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಪಾಸ್‌ಕೋಡ್ ಉಳಿಸಲಾಗಿದೆ. ಬಯೋಮೆಟ್ರಿಕ್ಸ್ ಮರುಸ್ಥಾಪಿಸಲು ನಿಮ್ಮ ಸಾಧನದ ಲಾಕ್ ತೆರೆಯಿರಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಪಾಸ್‌ಕೋಡ್‌ನೊಂದಿಗೆ ಮುಂದುವರಿಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 암호가 저장되었습니다. 기기를 잠금 해제하여 생체 인증을 복구한 다음 다시 시도하거나 앱 암호로 계속하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ആപ്പ് പാസ്‌കോഡ് സംരക്ഷിച്ചു. ബയോമെട്രിക് സംവിധാനം പുനഃസ്ഥാപിക്കാൻ ഉപകരണം അൺലോക്ക് ചെയ്ത് വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ പാസ്‌കോഡ് ഉപയോഗിച്ച് തുടരുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा पासकोड जतन झाला आहे. बायोमेट्रिक पुन्हा उपलब्ध करण्यासाठी उपकरण अनलॉक करून प्रयत्न करा किंवा पासकोडने पुढे जा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod laluan anda telah disimpan. Buka kunci peranti anda untuk memulihkan biometrik, kemudian cuba lagi, atau teruskan dengan kod laluan anda."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်ဝင်ခွင့်ကုဒ်ကို သိမ်းပြီးပါပြီ။ ဇီဝအမှတ်အသားပြန်သုံးနိုင်ရန် စက်၏ လော့ခ်ကို ဖွင့်ပြီး ထပ်စမ်းပါ သို့မဟုတ် ဝင်ခွင့်ကုဒ်ဖြင့် ဆက်လုပ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appkoden din er lagret. Lås opp enheten for å gjenaktivere biometri, og prøv deretter igjen, eller fortsett med appkoden."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको पासकोड सुरक्षित छ। बायोमेट्रिक सुविधा पुनःचालू गर्न उपकरण अनलक गरेर फेरि प्रयास गर्नुहोस् वा पासकोडबाट जारी राख्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je toegangscode is opgeslagen. Ontgrendel je apparaat om biometrie te herstellen en probeer het opnieuw, of ga verder met je toegangscode."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ପାସକୋଡ୍ ସେଭ୍ ହୋଇଛି। ବାୟୋମେଟ୍ରିକ୍ ପୁନଃଚାଲୁ କରିବାକୁ ଡିଭାଇସ ଅନଲକ୍ କରନ୍ତୁ, ତାପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ କିମ୍ବା ପାସକୋଡ୍ ସହ ଆଗକୁ ବଢ଼ନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡਾ ਪਾਸਕੋਡ ਸੁਰੱਖਿਅਤ ਹੈ। ਬਾਇਓਮੈਟ੍ਰਿਕ ਮੁੜ ਚਾਲੂ ਕਰਨ ਲਈ ਡਿਵਾਈਸ ਅਨਲੌਕ ਕਰੋ ਅਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਪਾਸਕੋਡ ਨਾਲ ਜਾਰੀ ਰੱਖੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod dostępu został zapisany. Odblokuj urządzenie, aby przywrócić biometrię, i spróbuj ponownie lub kontynuuj z kodem dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu código foi salvo. Desbloqueie o dispositivo para restaurar a biometria e tente novamente, ou continue com seu código."
