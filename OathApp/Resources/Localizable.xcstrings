        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni revoca comporta una commissione di rete. Oath prosegue dopo gli errori. Puoi lasciare questa schermata; sblocca e riprova le revoche interrotte."
          }
        },
        "ja" : {
          "stringUnit" : {
