        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ፊርማ እስከተገለጸው መጠን ድረስ ለአንድ ጊዜ ዝውውር ፈቃድ ይሰጣል። አውጪው ከጊዜ ገደቡ በፊት መጠቀም አለበት።"
