    "wcSignatureSentDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ያጸደቅኸው ፊርማ ወደ dApp ተመልሷል። መፈረም ብቻውን ዝውውር አያረጋግጥም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُعيد توقيعك المعتمد إلى التطبيق اللامركزي. التوقيع وحده لا يؤكد تحويلًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অনুমোদিত স্বাক্ষর dApp এ ফেরত গেছে। শুধু স্বাক্ষরে স্থানান্তর নিশ্চিত হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schválený podpis byl vrácen dApp. Samotný podpis nepotvrzuje převod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din godkendte signatur blev sendt tilbage til dAppen. En signering alene bekræfter ikke en overførsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine bestätigte Signatur wurde an die dApp zurückgegeben. Die Signatur allein bestätigt keine Übertragung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγκεκριμένη υπογραφή σας επιστράφηκε στη dApp. Η υπογραφή από μόνη της δεν επιβεβαιώνει μεταφορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your approved signature was returned to the dApp. Signing alone does not confirm a transfer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu firma aprobada se devolvió a la dApp. Firmar por sí solo no confirma una transferencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امضای تأییدشدهٔ شما به برنامهٔ غیرمتمرکز بازگردانده شد. امضا به‌تنهایی انتقال را تأیید نمی‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksymäsi allekirjoitus palautettiin dAppille. Pelkkä allekirjoittaminen ei vahvista siirtoa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naibalik sa dApp ang inaprubahan mong pirma. Hindi kinukumpirma ng pagpirma lamang ang paglipat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signature approuvée a été renvoyée à la dApp. La signature seule ne confirme pas un transfert."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા મંજૂર હસ્તાક્ષર dApp ને પરત આપ્યા છે. ફક્ત હસ્તાક્ષર કરવાથી ટ્રાન્સફરની પુષ્ટિ થતી નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An mayar da sa hannunka da ka amince da shi zuwa dApp. Sa hannu shi kaɗai ba ya tabbatar da canja wurin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החתימה שאישרת הוחזרה ליישום המבוזר. חתימה לבדה אינה מאשרת שהעברה בוצעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मंज़ूर हस्ताक्षर dApp को लौटाया गया। केवल हस्ताक्षर से ट्रांसफ़र की पुष्टि नहीं होती।"
