    "recovery_view.store_securely_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እነዚህን ቃላትና የዋሌትህን መዳረሻ ካጣህ፣ ገንዘብህ ሊመለስ አይችልም። ቃላቱን ያገኘ ሰው ገንዘብህን ሊወስድ ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن فقدت هذه الكلمات والوصول إلى محفظتك، فلن يمكن استرداد أموالك. يمكن لمن يحصل عليها أخذ أموالك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই শব্দগুলো ও ওয়ালেটে প্রবেশের সুযোগ হারালে আপনার অর্থ উদ্ধার করা যাবে না। যে কেউ শব্দগুলো পেলে আপনার অর্থ নিয়ে নিতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud ztratíte tato slova i přístup k peněžence, prostředky nelze obnovit. Každý, kdo slova získá, může vaše prostředky vzít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du mister både disse ord og adgangen til din wallet, kan dine midler ikke genskabes. Enhver, der får ordene, kan tage dine midler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlierst du diese Wörter und den Wallet-Zugriff, lässt sich dein Guthaben nicht wiederherstellen. Jeder, der sie erhält, kann dein Guthaben entwenden."
