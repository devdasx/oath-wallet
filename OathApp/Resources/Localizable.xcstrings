        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱ የተለየ የማለፊያ ሐረግ የራሱ አድራሻዎችና ቀሪ ሂሳቦች ያሉት የተለየ ዋሌት ይፈጥራል። የመጀመሪያው ዋሌትህ አይቀየርም፤ ገንዘብም በመካከላቸው አይዘዋወርም።"
