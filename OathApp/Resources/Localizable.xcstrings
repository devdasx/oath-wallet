    "history.filter.amount_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የእያንዳንዱን ሳንቲም ወይም ቶከን መለኪያ ይጠቀማል፣ የምንዛሬ ዋጋውን አይደለም። ቁጥሮችን ያለ ሺህ መለያ ምልክቶች አስገባ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم وحدات كل عملة أو رمز، لا قيمتها النقدية. أدخل الأرقام دون فواصل الآلاف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি কয়েন বা টোকেনের একক ব্যবহার করে, মুদ্রায় তার মূল্য নয়। হাজারের বিভাজক ছাড়া সংখ্যা লিখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá jednotky mincí a tokenů, nikoli jejich peněžní hodnotu. Čísla zadávejte bez oddělovačů tisíců."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger møntens eller tokenets egne enheder, ikke værdien i valuta. Indtast tal uden tusindtalsseparatorer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die Einheiten der Coins oder Token, nicht ihren Währungswert. Gib Zahlen ohne Tausendertrennzeichen ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί τις μονάδες κάθε νομίσματος ή token και όχι τη χρηματική τους αξία. Εισαγάγετε αριθμούς χωρίς διαχωριστικά χιλιάδων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses each coin or token’s units, not its currency value. Enter numbers without thousands separators."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las unidades de cada moneda o token, no su valor en divisa. Introduce números sin separadores de miles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از واحد هر کوین یا توکن استفاده می‌شود، نه ارزش آن به ارز رایج. اعداد را بدون جداکنندهٔ هزارگان وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää kunkin kolikon tai tokenin yksiköitä, ei sen valuutta-arvoa. Kirjoita luvut ilman tuhaterottimia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yunit ng bawat coin o token ang ginagamit, hindi ang halaga nito sa pera. Maglagay ng mga numero nang walang separator ng libo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les unités de chaque monnaie ou jeton, et non leur valeur en devise. Saisissez les nombres sans séparateurs de milliers."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક સિક્કા અથવા ટોકનના એકમ વપરાય છે, તેનું ચલણમાં મૂલ્ય નહીં. હજારોના વિભાજક વિના આંકડા દાખલ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana amfani da raka'o'in kowace tsaba ko token, ba ƙimarta a kuɗi ba. Shigar da lambobi ba tare da alamar raba dubunnai ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש ביחידות של כל מטבע או טוקן, ולא בשווי שלהם במטבע רגיל. יש להזין מספרים ללא מפרידי אלפים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर कॉइन या टोकन की इकाई इस्तेमाल होती है, मुद्रा में उसका मूल्य नहीं। हज़ार के विभाजक लगाए बिना संख्याएँ डालें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi jedinice pojedine kriptovalute ili tokena, a ne njihovu novčanu vrijednost. Unesite brojeve bez razdjelnika tisućica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyes érmék vagy tokenek egységeit használja, nem a pénznemben kifejezett értéküket. Ezreselválasztó nélkül add meg a számokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan satuan setiap koin atau token, bukan nilainya dalam mata uang. Masukkan angka tanpa pemisah ribuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le unità di ogni moneta o token, non il valore in valuta. Inserisci i numeri senza separatori delle migliaia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通貨換算額ではなく、各コインやトークンの数量を使用します。桁区切りなしで数値を入力してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იყენებს თითოეული მონეტის ან ტოკენის ერთეულებს და არა მათ ფულად ღირებულებას. რიცხვები ათასეულების გამყოფების გარეშე შეიყვანეთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រើឯកតារបស់កាក់ ឬថូខិននីមួយៗ មិនមែនតម្លៃជារូបិយប័ណ្ណ។ បញ្ចូលលេខដោយគ្មានសញ្ញាបំបែកខ្ទង់ពាន់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ನಾಣ್ಯ ಅಥವಾ ಟೋಕನ್‌ನ ಘಟಕಗಳನ್ನು ಬಳಸುತ್ತದೆ, ಅದರ ಕರೆನ್ಸಿ ಮೌಲ್ಯವನ್ನಲ್ಲ. ಸಾವಿರದ ಬೇರ್ಪಡಿಸುವ ಗುರುತುಗಳಿಲ್ಲದೆ ಸಂಖ್ಯೆ ನಮೂದಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화로 환산한 가치 대신 각 코인이나 토큰의 단위를 사용합니다. 천 단위 구분 기호 없이 숫자를 입력하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ കോയിന്റെയോ ടോക്കണിന്റെയോ യൂണിറ്റുകളാണ് ഉപയോഗിക്കുന്നത്, കറൻസി മൂല്യമല്ല. ആയിരങ്ങളെ വേർതിരിക്കുന്ന ചിഹ്നങ്ങളില്ലാതെ സംഖ്യകൾ നൽകുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक नाणे किंवा टोकनची एकके वापरते, चलनातील मूल्य नाही. हजारांचे विभाजक न वापरता संख्या भरा."
          }
        },
        "ms" : {
          "stringUnit" : {
