        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ရွေးထားသော ကွန်ရက်များတွင် ဤချိတ်ဆက်မှုက တောင်းနိုင်မည့် နည်းလမ်းများဖြစ်သည်။ လက်မှတ် သို့မဟုတ် အရောင်းအဝယ်တစ်ခုစီအတွက် သင့်ခွင့်ပြုချက် လိုသေးသည်။"
