    "settings.mail_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በዚህ መሣሪያ ላይ ኢሜይል አልተዘጋጀም። በ%@ ልትጽፍልን ትችላለህ። በኢሜይል መተግበሪያህ ለመጠቀም አድራሻውን ቅዳ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعدّ البريد على هذا الجهاز. يمكنك مراسلتنا على %@. انسخ العنوان لاستخدامه في تطبيق بريدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে মেইল সেট আপ নেই। %@ ঠিকানায় ইমেইল করতে পারেন। নিজের ইমেইল অ্যাপে ব্যবহার করতে ঠিকানা কপি করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail není na tomto zařízení nastaven. Napište nám na %@. Zkopírujte adresu a použijte ji ve své e-mailové aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail er ikke konfigureret på denne enhed. Du kan skrive til os på %@. Kopiér adressen for at bruge den i din mailapp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail ist auf diesem Gerät nicht eingerichtet. Du erreichst uns unter %@. Kopiere die Adresse für deine E-Mail-App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Mail δεν έχει ρυθμιστεί σε αυτή τη συσκευή. Μπορείτε να μας γράψετε στο %@. Αντιγράψτε τη διεύθυνση για χρήση στην εφαρμογή email σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail is not set up on this device. You can email us at %@. Copy the address to use it in your email app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail no está configurado en este dispositivo. Puedes escribirnos a %@. Copia la dirección para usarla en tu app de correo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail در این دستگاه تنظیم نشده است. می‌توانید به %@ ایمیل بزنید. نشانی را کپی کنید تا در برنامهٔ ایمیل خود استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähköpostia ei ole otettu käyttöön tällä laitteella. Voit kirjoittaa meille osoitteeseen %@. Kopioi osoite käyttääksesi sitä sähköpostisovelluksessasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi naka-set up ang Mail sa device na ito. Maaari kang mag-email sa amin sa %@. Kopyahin ang address para gamitin sa email app mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail n’est pas configuré sur cet appareil. Vous pouvez nous écrire à %@. Copiez l’adresse pour l’utiliser dans votre app de messagerie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઉપકરણ પર મેઇલ ગોઠવેલું નથી. તમે અમને %@ પર ઇમેઇલ કરી શકો છો. તમારી ઇમેઇલ ઍપમાં વાપરવા સરનામું કૉપિ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba a saita Imel a wannan na'ura ba. Za ka iya aiko mana imel a %@. Kwafi adireshin don amfani da shi a manhajar imel ɗinka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דואר אינו מוגדר במכשיר הזה. ניתן לכתוב לנו בכתובת %@. יש להעתיק את הכתובת לשימוש ביישום הדואר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर मेल सेट नहीं है। आप हमें %@ पर ईमेल कर सकते हैं। अपने ईमेल ऐप में इस्तेमाल करने के लिए पता कॉपी करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošta nije postavljena na ovom uređaju. Možete nam pisati na %@. Kopirajte adresu i upotrijebite je u svojoj aplikaciji za e-poštu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az eszközön nincs beállítva levelezés. Ezen a címen írhatsz nekünk: %@. Másold a címet, és használd a levelezőalkalmazásodban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail belum disiapkan di perangkat ini. Anda dapat mengirim email ke %@. Salin alamat untuk digunakan di aplikasi email Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posta non è configurata su questo dispositivo. Puoi scriverci a %@. Copia l'indirizzo per usarlo nella tua app email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではメールが未設定です。%@へお問い合わせいただけます。アドレスをコピーしてメールアプリで使用してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ მოწყობილობაზე ფოსტა დაყენებული არ არის. შეგიძლიათ მოგვწეროთ %@-ზე. დააკოპირეთ მისამართი თქვენს ელფოსტის აპში გამოსაყენებლად."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនបានរៀបចំអ៊ីមែលលើឧបករណ៍នេះ។ អ្នកអាចផ្ញើអ៊ីមែលមក %@។ ចម្លងអាសយដ្ឋានដើម្បីប្រើក្នុងកម្មវិធីអ៊ីមែល។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದಲ್ಲಿ ಮೇಲ್ ಹೊಂದಿಸಿಲ್ಲ. %@ ಗೆ ನಮಗೆ ಇಮೇಲ್ ಕಳುಹಿಸಬಹುದು. ನಿಮ್ಮ ಇಮೇಲ್ ಆ್ಯಪ್‌ನಲ್ಲಿ ಬಳಸಲು ವಿಳಾಸ ನಕಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 Mail이 설정되지 않았습니다. %@로 이메일을 보낼 수 있습니다. 이메일 앱에서 사용할 수 있도록 주소를 복사하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
