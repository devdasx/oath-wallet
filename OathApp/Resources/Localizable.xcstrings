        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polkadot Asset Hub இல் DOT மற்றும் ஆதரிக்கப்படும் சொத்துகளைப் பெற இந்த Polkadot முகவரியைப் பயன்படுத்தவும். பரிமாற்ற நிலையத்திலிருந்து எடுக்கும்போது Asset Hub ஐத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
