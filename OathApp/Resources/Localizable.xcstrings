        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব ধরনের ঠিকানা এই ওয়ালেটের। এখানে যে ঠিকানাই দেখা যাক, Oath প্রতিটি ধরনের গ্রহণের ও চেঞ্জ ঠিকানা পরীক্ষা করে।"
