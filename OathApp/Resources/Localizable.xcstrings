    "wcSolanaPartial" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መቀየር የሚፈቀድባቸው አንዳንድ መለያዎች በቀሪ ሂሳብ ቅድመ እይታው ውስጥ ሊካተቱ አልቻሉም። ይህ ቅድመ እይታ ሁሉንም ተፅዕኖዎች አይገልጽም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تضمين بعض الحسابات القابلة للكتابة في معاينة الأرصدة. لا تعرض هذه المعاينة جميع الآثار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবর্তনযোগ্য কিছু অ্যাকাউন্ট ব্যালেন্সের পূর্বরূপে অন্তর্ভুক্ত করা যায়নি। এই পূর্বরূপে সব প্রভাব দেখানো হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé účty s oprávněním k zápisu se nepodařilo zahrnout do náhledu zůstatků. Tento náhled nezachycuje všechny dopady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle konti med skriveadgang kunne ikke medtages i saldooversigten. Denne oversigt viser ikke alle virkninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige beschreibbare Konten konnten nicht in die Guthabenvorschau einbezogen werden. Diese Vorschau zeigt nicht alle Auswirkungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένοι λογαριασμοί με δικαίωμα εγγραφής δεν μπόρεσαν να συμπεριληφθούν στην προεπισκόπηση υπολοίπου. Αυτή η προεπισκόπηση δεν περιγράφει όλες τις επιπτώσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some writable accounts could not be included in the balance preview. This preview does not describe every effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido incluir algunas cuentas con permiso de escritura en la vista previa de saldos. Esta vista previa no muestra todos los efectos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برخی حساب‌های قابل‌نوشتن در پیش‌نمایش موجودی گنجانده نشدند. این پیش‌نمایش همهٔ اثرات را نشان نمی‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joitakin tilejä, joihin voidaan kirjoittaa, ei voitu sisällyttää saldojen esikatseluun. Esikatselu ei kuvaa kaikkia vaikutuksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maisama sa preview ng balanse ang ilang account na maaaring sulatan. Hindi ipinapakita ng preview na ito ang lahat ng magiging epekto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains comptes accessibles en écriture n’ont pas pu être inclus dans l’aperçu des soldes. Cet aperçu ne présente pas tous les effets."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડેટા લખી શકાય એવાં કેટલાક ખાતાં બૅલેન્સના પૂર્વાવલોકનમાં સામેલ થઈ શક્યાં નથી. આ પૂર્વાવલોકન બધી અસરો દર્શાવતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba a iya haɗa wasu asusun da za a iya rubuta bayanai a cikinsu cikin hasashen ma’auni ba. Wannan hasashen bai bayyana duk tasirin ma’amalar ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלק מהחשבונות שניתן לכתוב אליהם לא נכללו בתצוגה המקדימה של היתרה. התצוגה הזו לא מציגה את כל ההשפעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ लिखने योग्य खातों को बैलेंस के पूर्वावलोकन में शामिल नहीं किया जा सका। इस पूर्वावलोकन में हर प्रभाव नहीं दिखाया गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neke račune s dopuštenjem pisanja nije bilo moguće uključiti u pregled salda. Ovaj pregled ne prikazuje sve učinke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány írható fiókot nem sikerült belevenni az egyenleg előnézetébe. Ez az előnézet nem mutatja az összes hatást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa akun yang dapat ditulisi tidak dapat disertakan dalam pratinjau saldo. Pratinjau ini tidak menggambarkan semua dampaknya."
