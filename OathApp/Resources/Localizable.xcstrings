        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত হলে স্থানান্তর নেটওয়ার্কে নথিভুক্ত হয়। হোমে কন্ট্র্যাক্টের ঠিকানা খুঁজে সম্পদের তালিকায় টোকেন যোগ করতে পারেন। স্বয়ংক্রিয় টোকেন শনাক্তকরণ ও ব্যালেন্স হালনাগাদ এখনও নেই।"
