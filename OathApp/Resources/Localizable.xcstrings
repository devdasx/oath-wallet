        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନେଟୱର୍କ ଏହି ପଦକ୍ଷେପ ନିଶ୍ଚିତ କରିବାକୁ ଅପେକ୍ଷା କରାଯାଉଛି। ନିଶ୍ଚିତକରଣ ପରେ ପରବର୍ତ୍ତୀ ପଦକ୍ଷେପ ଉପଲବ୍ଧ ହେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨੈੱਟਵਰਕ ਵੱਲੋਂ ਇਸ ਪੜਾਅ ਦੀ ਪੁਸ਼ਟੀ ਦੀ ਉਡੀਕ ਹੈ। ਪੁਸ਼ਟੀ ਮਗਰੋਂ ਅਗਲਾ ਪੜਾਅ ਉਪਲਬਧ ਹੋਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
