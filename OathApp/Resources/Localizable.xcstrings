        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארנק לרשתות בלוקצ׳יין מרובות. שליחה, קבלה, תשלום ובקשת קריפטו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मल्टीचेन वॉलेट। क्रिप्टो भेजें, पाएँ, भुगतान करें और अनुरोध करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novčanik za više mreža. Šaljite i primajte kriptovalute, plaćajte njima i zatražite ih od drugih."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tárca több blokklánchoz. Küldj és fogadj kriptót, fizess vele, vagy kérj fizetést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet multichain. Kirim, terima, bayar, dan minta kripto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallet multichain. Invia, ricevi, paga e richiedi criptovalute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マルチチェーンウォレット。暗号資産の送金、受取、支払い、請求ができます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მრავალქსელური საფულე. გაგზავნეთ და მიიღეთ კრიპტოვალუტა, გადაიხადეთ და მოითხოვეთ თანხა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កាបូបពហុប្លុកឆេន។ ផ្ញើ ទទួល ទូទាត់ និងស្នើសុំគ្រីបតូ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಹು ನೆಟ್‌ವರ್ಕ್ ವ್ಯಾಲೆಟ್. ಕ್ರಿಪ್ಟೋ ಕಳುಹಿಸಿ, ಸ್ವೀಕರಿಸಿ, ಪಾವತಿಸಿ ಮತ್ತು ವಿನಂತಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멀티체인 지갑. 암호화폐를 보내고 받고, 결제하고 요청하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒന്നിലധികം ബ്ലോക്ക്‌ചെയിനുകളുള്ള വാലറ്റ്. ക്രിപ്റ്റോ അയയ്ക്കുക, സ്വീകരിക്കുക, പണമടയ്ക്കുക, അഭ്യർത്ഥിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुसाखळी वॉलेट. क्रिप्टो पाठवा, मिळवा, पैसे भरा आणि मागणी करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet berbilang rantaian. Hantar, terima, bayar dan minta kripto."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကွန်ရက်စုံပိုက်ဆံအိတ်။ ခရစ်ပ်တို ပို့ခြင်း၊ လက်ခံခြင်း၊ ပေးချေခြင်းနှင့် တောင်းခံခြင်း။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lommebok for flere blokkjeder. Send, motta, betal og be om krypto."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुचेन वालेट। क्रिप्टो पठाउनुहोस्, प्राप्त गर्नुहोस्, भुक्तानी गर्नुहोस् र माग्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallet voor meerdere blockchains. Verstuur, ontvang, betaal en vraag crypto aan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବହୁ ନେଟୱର୍କ ୱାଲେଟ। କ୍ରିପ୍ଟୋ ପଠାନ୍ତୁ, ଗ୍ରହଣ କରନ୍ତୁ, ପେମେଣ୍ଟ କରନ୍ତୁ ଓ ଅନୁରୋଧ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਹੁ-ਚੇਨ ਵਾਲਿਟ। ਕ੍ਰਿਪਟੋ ਭੇਜੋ, ਪ੍ਰਾਪਤ ਕਰੋ, ਭੁਗਤਾਨ ਕਰੋ ਅਤੇ ਮੰਗੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portfel wielosieciowy. Wysyłaj i odbieraj kryptowaluty, płać nimi i proś o wpłatę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carteira multichain. Envie, receba, pague e solicite criptomoedas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carteira multichain. Envie, receba, pague e peça criptomoedas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portofel pentru mai multe blockchainuri. Trimite, primește, plătește și solicită criptomonede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мультичейн-кошелёк. Отправляйте, получайте, оплачивайте и запрашивайте криптовалюту."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گهڻن زنجيرن وارو والٽ. ڪرپٽو موڪليو، وٺو، ادا ڪريو ۽ گهرو."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "බහු දාම පසුම්බිය. ක්‍රිප්ටෝ යවන්න, ලබන්න, ගෙවන්න සහ ඉල්ලන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peňaženka pre viac sietí. Odosielajte, prijímajte, plaťte a žiadajte o kryptomeny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denarnica za več verig. Pošiljajte, prejemajte, plačujte in zahtevajte kriptovalute."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plånbok för flera blockkedjor. Skicka, ta emot, betala och begär krypto."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochi ya minyororo mingi. Tuma, pokea, lipa na omba kripto."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பல சங்கிலிப் பணப்பை. கிரிப்டோவை அனுப்பவும், பெறவும், செலுத்தவும், கோரவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మల్టీచైన్ వాలెట్. క్రిప్టో పంపండి, స్వీకరించండి, చెల్లించండి, అభ్యర్థించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระเป๋าหลายเชน ส่ง รับ จ่าย และขอคริปโต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok zincirli cüzdan. Kripto gönderin, alın, ödeyin ve talep edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мультичейн-гаманець. Надсилайте й отримуйте криптовалюту, оплачуйте та запитуйте її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متعدد بلاک چینز کا والیٹ۔ کرپٹو بھیجیں، وصول کریں، ادائیگی اور درخواست کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko‘p tarmoqli hamyon. Kripto yuboring, qabul qiling, to‘lang va so‘rang."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví đa chuỗi. Gửi, nhận, thanh toán và yêu cầu tiền mã hóa."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àpamọ́wọ́ onínẹ́tíwọ́ọ̀kì púpọ̀. Firanṣẹ́, gbà, san owó, kí o sì béèrè owó krípítò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多链钱包。发送、接收、支付及请求加密货币。"
