      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህን ዋሌት ለመመለስ የመመለሻ ሐረጉና ይህ የማለፊያ ሐረግ ሁለቱም ያስፈልጋሉ። የመመለሻ ሐረጉ ብቻውን የመጀመሪያውን ዋሌት ይከፍታል። Oath የዋሌት የማለፊያ ሐረግን ዳግም ማዘጋጀት አይችልም።"
