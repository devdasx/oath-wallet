    "wallets.recently_deleted_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተወገዱ ዋሌቶች ለ7 ቀናት እዚህ ይቆያሉ። ከሚታየው ቀን በፊት ልትመልሳቸው ትችላለህ። ከዚያ በኋላ Oath በሚቀጥለው ጊዜ ሲከፈት በቋሚነት ይሰረዛሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المحافظ المُزالة هنا لمدة 7 أيام. يمكنك استعادتها قبل التاريخ المعروض. بعدها تُحذف نهائيًا عند فتح قفل Oath في المرة التالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরানো ওয়ালেট এখানে ৭ দিন থাকে। দেখানো তারিখের আগে ফেরাতে পারেন। তারপরে Oath পরের বার আনলক করলে স্থায়ীভাবে মুছে যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraněné peněženky tu zůstanou 7 dní. Můžete je obnovit před uvedeným datem. Poté se trvale smažou při příštím odemknutí Oath."
          }
