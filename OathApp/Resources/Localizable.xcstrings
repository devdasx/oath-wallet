        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath ho po vás nikdy nebude chtít. Nikomu ho neposílejte, nevkládejte ho na web ani ho nesdílejte s podporou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oath vil aldrig bede om den. Send den ikke til nogen, indsæt den ikke på et websted, og del den ikke med support."
