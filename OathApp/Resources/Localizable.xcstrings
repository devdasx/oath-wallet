    "restore.invalid_backup" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ምትኬ ተበላሽቷል ወይም የማይደገፍ ቅርጽ ይጠቀማል። ሌላ ምትኬ ምረጥ ወይም Oath አዘምንና እንደገና ሞክር።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه النسخة تالفة أو تستخدم صيغة غير مدعومة. اختر نسخة أخرى أو حدّث Oath وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ব্যাকআপ নষ্ট বা অসমর্থিত বিন্যাসে আছে। অন্য ব্যাকআপ নিন, অথবা Oath হালনাগাদ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato záloha je poškozená nebo používá nepodporovaný formát. Vyberte jinou zálohu nebo aktualizujte Oath a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sikkerhedskopi er beskadiget eller bruger et format, der ikke understøttes. Vælg en anden kopi, eller opdater Oath og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sicherung ist beschädigt oder hat ein nicht unterstütztes Format. Wähle eine andere Sicherung oder aktualisiere Oath und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αντίγραφο είναι κατεστραμμένο ή έχει μη υποστηριζόμενη μορφή. Επιλέξτε άλλο αντίγραφο ή ενημερώστε το Oath και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup is damaged or uses an unsupported format. Choose another backup or update Oath and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia está dañada o usa un formato no admitido. Elige otra o actualiza Oath y reintenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این پشتیبان آسیب دیده یا قالبش پشتیبانی نمی‌شود. پشتیبان دیگری انتخاب کنید یا Oath را به‌روز کنید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä varmuuskopio on vahingoittunut tai sen muotoa ei tueta. Valitse toinen varmuuskopio tai päivitä Oath ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sira ang backup na ito o hindi suportado ang format nito. Pumili ng ibang backup o i-update ang Oath at subukan muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde est endommagée ou utilise un format non pris en charge. Choisissez-en une autre ou mettez Oath à jour, puis réessayez."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ બૅકઅપ નુકસાન પામ્યો છે અથવા અસંમત સ્વરૂપ વાપરે છે. બીજો બૅકઅપ પસંદ કરો અથવા Oath અપડેટ કરીને ફરી પ્રયાસ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wannan madadi ya lalace ko yana amfani da tsarin da ba a tallafa wa. Zaɓi wani madadi ko sabunta Oath ka sake gwadawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגיבוי הזה פגום או משתמש בפורמט שאינו נתמך. יש לבחור גיבוי אחר או לעדכן את Oath ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बैकअप क्षतिग्रस्त है या असमर्थित प्रारूप में है। दूसरा बैकअप चुनें या Oath अपडेट करके फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova je sigurnosna kopija oštećena ili koristi nepodržani format. Odaberite drugu kopiju ili ažurirajte Oath pa pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a mentés sérült vagy nem támogatott formátumú. Válassz másik mentést, vagy frissítsd az Oath alkalmazást, majd próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan ini rusak atau menggunakan format yang tidak didukung. Pilih cadangan lain atau perbarui Oath dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup è danneggiato o usa un formato non supportato. Scegli un altro backup oppure aggiorna Oath e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップが破損しているか、未対応の形式です。別のバックアップを選ぶか、Oathを更新して再試行してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ასლი დაზიანებულია ან მხარდაუჭერელ ფორმატს იყენებს. აირჩიეთ სხვა ასლი ან განაახლეთ Oath და ხელახლა სცადეთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ច្បាប់ចម្លងនេះខូច ឬប្រើទម្រង់ដែលមិនគាំទ្រ។ ជ្រើសច្បាប់ចម្លងផ្សេង ឬធ្វើបច្ចុប្បន្នភាព Oath រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಬ್ಯಾಕಪ್ ಹಾನಿಯಾಗಿದೆ ಅಥವಾ ಬೆಂಬಲಿತವಲ್ಲದ ಸ್ವರೂಪ ಬಳಸುತ್ತದೆ. ಬೇರೆ ಬ್ಯಾಕಪ್ ಆಯ್ಕೆ ಮಾಡಿ ಅಥವಾ Oath ನವೀಕರಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업이 손상되었거나 지원하지 않는 형식입니다. 다른 백업을 선택하거나 Oath를 업데이트한 다음 다시 시도하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ബാക്കപ്പ് കേടായതാണ് അല്ലെങ്കിൽ പിന്തുണയ്ക്കാത്ത രൂപത്തിലാണ്. മറ്റൊരു ബാക്കപ്പ് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ Oath പുതുക്കി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा बॅकअप खराब आहे किंवा असमर्थित स्वरूप वापरतो. दुसरा बॅकअप निवडा किंवा Oath अपडेट करून पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
