    "receive.solana_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የ%@ ዋሌት አድራሻህን አጋራ። የላኪው ዋሌት ቶከኑን ወደ ተያያዘው የቶከን መለያ ይመራል። መጀመሪያ ያን መለያ መፍጠርና የማከማቻ ወጪውን መክፈል ሊያስፈልገው ይችላል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك عنوان محفظة %@ لديك. توجّه محفظة المرسل الرمز إلى حساب الرموز المرتبط به. وقد تحتاج إلى إنشاء ذلك الحساب ودفع تكلفة تخزينه أولًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার %@ ওয়ালেটের ঠিকানা শেয়ার করুন। প্রেরকের ওয়ালেট টোকেনকে সংশ্লিষ্ট টোকেন অ্যাকাউন্টে পাঠায়। আগে সেই অ্যাকাউন্ট তৈরি ও স্টোরেজ খরচ দেওয়ার প্রয়োজন হতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte adresu své peněženky %@. Peněženka odesílatele nasměruje token do přidruženého tokenového účtu. Možná bude muset tento účet nejprve vytvořit a zaplatit náklady na jeho úložiště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del din walletadresse på %@. Afsenderens wallet sender et token til den tilknyttede tokenkonto. Den kan først være nødt til at oprette kontoen og betale dens lagringsomkostning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine %@-Wallet-Adresse. Die sendende Wallet leitet Token an das zugehörige Token-Konto weiter. Sie muss es möglicherweise zuvor erstellen und die Speicherkosten zahlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοινοποιήστε τη διεύθυνση του πορτοφολιού σας %@. Το πορτοφόλι αποστολής κατευθύνει το token στον συνδεδεμένο λογαριασμό token του. Ενδέχεται να πρέπει πρώτα να δημιουργήσει τον λογαριασμό και να πληρώσει το κόστος αποθήκευσής του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your %@ wallet address. The sender’s wallet routes a token to its associated token account. It may need to create that account and pay its storage cost first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu dirección de cartera %@. La cartera del remitente dirige el token a su cuenta de tokens asociada. Puede necesitar crear esa cuenta y pagar su almacenamiento primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانی کیف پول %@ خود را به اشتراک بگذارید. کیف پول فرستنده توکن را به حساب توکن وابستهٔ آن هدایت می‌کند. ممکن است ابتدا به ایجاد آن حساب و پرداخت هزینهٔ ذخیره‌سازی نیاز باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa lompakko-osoitteesi verkossa %@. Lähettäjän lompakko ohjaa tokenin siihen liitetylle tokentilille. Sen on ehkä ensin luotava tili ja maksettava sen tallennuskustannus."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibahagi ang %@ wallet address mo. Dinadala ng wallet ng nagpapadala ang token sa kaugnay nitong token account. Maaaring kailangan muna nitong likhain ang account at bayaran ang storage nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre adresse de portefeuille %@. Le portefeuille expéditeur dirige le jeton vers son compte de jetons associé. Il peut devoir créer ce compte et payer son stockage au préalable."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું %@ વૉલેટ સરનામું વહેંચો. મોકલનારનું વૉલેટ ટોકનને તેના સંકળાયેલા ટોકન ખાતામાં મોકલે છે. પહેલાં તે ખાતું બનાવવું અને તેની સ્ટોરેજ કિંમત ચૂકવવી પડી શકે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raba adireshin walat ɗinka na %@. Walat ɗin mai aikawa yana tura token zuwa asusun token da yake da alaƙa da shi. Mai yiwuwa ya buƙaci ƙirƙirar wannan asusun da biyan kuɗin ma'ajiyarsa da farko."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לשתף את כתובת ארנק %@ שלך. הארנק של השולח מנתב טוקן לחשבון הטוקן המשויך אליו. ייתכן שיצטרך ליצור את החשבון ולשלם תחילה על האחסון שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना %@ वॉलेट पता साझा करें। भेजने वाला वॉलेट टोकन को उसके संबद्ध टोकन खाते में भेजता है। उसे पहले वह खाता बनाना और स्टोरेज का खर्च देना पड़ सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijelite adresu svojeg novčanika %@. Novčanik pošiljatelja usmjerava token na njegov pridruženi račun tokena. Možda prvo treba izraditi taj račun i platiti trošak njegove pohrane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszd meg a(z) %@-tárcacímedet. A küldő tárcája a hozzá tartozó tokenfiókba irányítja a tokent. Előbb szükség lehet a fiók létrehozására és a tárhelyköltség kifizetésére."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan alamat dompet %@ Anda. Dompet pengirim mengarahkan token ke akun token terkait. Akun tersebut mungkin perlu dibuat dan biaya penyimpanannya dibayar terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi l'indirizzo del tuo wallet %@. Il wallet del mittente indirizza il token al relativo account token associato. Potrebbe dover prima creare l'account e pagarne il costo di archiviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ウォレットのアドレスを共有します。送信側ウォレットが関連トークンアカウントにトークンを送ります。事前にそのアカウントを作成し、ストレージ費用を支払う必要がある場合があります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გააზიარეთ თქვენი %@ საფულის მისამართი. გამომგზავნის საფულე ტოკენს მის ასოცირებულ ტოკენის ანგარიშზე მიმართავს. შესაძლოა ჯერ ამ ანგარიშის შექმნა და საცავის საფასურის გადახდა დასჭირდეს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចែករំលែកអាសយដ្ឋានកាបូប %@ របស់អ្នក។ កាបូបអ្នកផ្ញើបញ្ជូនថូខិនទៅគណនីថូខិនពាក់ព័ន្ធ។ វាអាចត្រូវបង្កើតគណនីនោះ និងបង់ថ្លៃផ្ទុកជាមុន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ %@ ವ್ಯಾಲೆಟ್ ವಿಳಾಸ ಹಂಚಿಕೊಳ್ಳಿ. ಕಳುಹಿಸುವವರ ವ್ಯಾಲೆಟ್ ಟೋಕನ್ ಅನ್ನು ಅದರ ಸಂಬಂಧಿತ ಟೋಕನ್ ಖಾತೆಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಮೊದಲು ಆ ಖಾತೆಯನ್ನು ರಚಿಸಿ ಅದರ ಸಂಗ್ರಹಣೆ ವೆಚ್ಚ ಪಾವತಿಸಬೇಕಾಗಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 지갑 주소를 공유하세요. 보내는 사람의 지갑이 토큰을 연결된 토큰 계정으로 전달합니다. 먼저 해당 계정을 생성하고 저장 비용을 내야 할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ %@ വാലറ്റ് വിലാസം പങ്കിടുക. അയയ്ക്കുന്നയാളുടെ വാലറ്റ് ടോക്കണിനെ അനുബന്ധ ടോക്കൺ അക്കൗണ്ടിലേക്ക് അയയ്ക്കുന്നു. ആദ്യം ആ അക്കൗണ്ട് സൃഷ്ടിച്ച് സംഭരണ ചെലവ് നൽകേണ്ടി വന്നേക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा %@ वॉलेट पत्ता शेअर करा. पाठवणाऱ्याचे वॉलेट टोकन त्याच्या संबंधित टोकन खात्यात पाठवते. आधी ते खाते तयार करून साठवणीचा खर्च द्यावा लागू शकतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kongsi alamat dompet %@ anda. Dompet penghantar menghalakan token ke akaun token berkaitannya. Ia mungkin perlu mencipta akaun itu dan membayar kos storannya dahulu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့် %@ ပိုက်ဆံအိတ်လိပ်စာကို မျှဝေပါ။ ပို့သူ၏ ပိုက်ဆံအိတ်က တိုကင်ကို ၎င်း၏ ဆက်စပ်တိုကင်အကောင့်သို့ ပို့သည်။ ထိုအကောင့်ကို ဦးစွာ ဖန်တီးပြီး သိုလှောင်မှုစရိတ် ပေးရန် လိုအပ်နိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del lommebokadressen din på %@. Avsenderens lommebok sender tokenet til den tilknyttede tokenkontoen. Den må kanskje opprette kontoen og betale lagringskostnaden først."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आफ्नो %@ वालेट ठेगाना साझा गर्नुहोस्। पठाउनेको वालेटले टोकनलाई सम्बन्धित टोकन खातामा पुर्‍याउँछ। पहिले त्यो खाता बनाएर भण्डारण खर्च तिर्नुपर्ने हुन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel je %@-walletadres. De wallet van de verzender stuurt een token naar het bijbehorende tokenaccount. Mogelijk moet dat account eerst worden aangemaakt en moeten de opslagkosten worden betaald."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ %@ ୱାଲେଟ ଠିକଣା ଶେୟାର କରନ୍ତୁ। ପ୍ରେରକଙ୍କ ୱାଲେଟ ଟୋକେନକୁ ତାହାର ସମ୍ବନ୍ଧିତ ଟୋକେନ ଆକାଉଣ୍ଟକୁ ପଠାଏ। ପ୍ରଥମେ ସେହି ଆକାଉଣ୍ଟ ତିଆରି କରି ଷ୍ଟୋରେଜ୍ ଖର୍ଚ୍ଚ ଦେବା ଦରକାର ହୋଇପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ %@ ਵਾਲਿਟ ਪਤਾ ਸਾਂਝਾ ਕਰੋ। ਭੇਜਣ ਵਾਲੇ ਦਾ ਵਾਲਿਟ ਟੋਕਨ ਨੂੰ ਉਸ ਦੇ ਸੰਬੰਧਿਤ ਟੋਕਨ ਖਾਤੇ ਵਿੱਚ ਭੇਜਦਾ ਹੈ। ਪਹਿਲਾਂ ਉਸ ਨੂੰ ਇਹ ਖਾਤਾ ਬਣਾਉਣਾ ਅਤੇ ਸਟੋਰੇਜ ਖ਼ਰਚਾ ਦੇਣਾ ਪੈ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
