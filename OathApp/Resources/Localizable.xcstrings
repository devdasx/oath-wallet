    "contacts.address_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለእያንዳንዱ አድራሻ አውታረ መረቡን ምረጥ። ለአንድ ዕውቂያ ከአንድ በላይ አድራሻ ማስቀመጥ ትችላለህ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر شبكة لكل عنوان. يمكنك حفظ أكثر من عنوان لجهة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ঠিকানার নেটওয়ার্ক বেছে নিন। একজন পরিচিতির একাধিক ঠিকানা রাখতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro každou adresu zvolte síť. Ke kontaktu můžete uložit více adres."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg netværk for hver adresse. Du kan gemme flere adresser for en kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für jede Adresse ein Netzwerk. Du kannst mehrere Adressen pro Kontakt speichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε το δίκτυο για κάθε διεύθυνση. Μπορείτε να αποθηκεύσετε περισσότερες από μία διευθύνσεις για μια επαφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the network for each address. You can save more than one address for a contact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la red de cada dirección. Puedes guardar varias direcciones para un contacto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبکهٔ هر نشانی را انتخاب کنید. می‌توانید برای یک مخاطب چند نشانی ذخیره کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse verkko kullekin osoitteelle. Voit tallentaa yhteystiedolle useita osoitteita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin ang network ng bawat address. Maaari kang mag-save ng higit sa isang address para sa isang contact."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le réseau de chaque adresse. Vous pouvez enregistrer plusieurs adresses par contact."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક સરનામા માટે નેટવર્ક પસંદ કરો. એક સંપર્ક માટે એકથી વધુ સરનામાં સાચવી શકો છો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi hanyar sadarwa ga kowane adireshi. Za ka iya ajiye adireshi fiye da ɗaya ga abokin hulɗa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור רשת לכל כתובת. ניתן לשמור יותר מכתובת אחת לאיש קשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर पते के लिए नेटवर्क चुनें। एक संपर्क के लिए कई पते सेव कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite mrežu za svaku adresu. Za kontakt možete spremiti više adresa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki a hálózatot minden címhez. Egy névjegyhez több címet is menthetsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih jaringan untuk setiap alamat. Anda dapat menyimpan lebih dari satu alamat untuk satu kontak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la rete per ogni indirizzo. Puoi salvare più indirizzi per un contatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各アドレスのネットワークを選択してください。連絡先ごとに複数のアドレスを保存できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითოეული მისამართისთვის აირჩიეთ ქსელი. ერთ კონტაქტზე რამდენიმე მისამართის შენახვა შეგიძლიათ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជ្រើសបណ្ដាញសម្រាប់អាសយដ្ឋាននីមួយៗ។ អ្នកអាចរក្សាទុកអាសយដ្ឋានច្រើនសម្រាប់ទំនាក់ទំនងម្នាក់។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ವಿಳಾಸಕ್ಕೂ ನೆಟ್‌ವರ್ಕ್ ಆಯ್ಕೆ ಮಾಡಿ. ಒಬ್ಬ ಸಂಪರ್ಕಕ್ಕೆ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ವಿಳಾಸಗಳನ್ನು ಉಳಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소마다 네트워크를 선택하세요. 한 연락처에 여러 주소를 저장할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ വിലാസത്തിനും നെറ്റ്‌വർക്ക് തിരഞ്ഞെടുക്കുക. ഒരു കോൺടാക്റ്റിന് ഒന്നിലധികം വിലാസങ്ങൾ സംരക്ഷിക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक पत्त्यासाठी नेटवर्क निवडा. एका संपर्कासाठी अनेक पत्ते जतन करू शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih rangkaian bagi setiap alamat. Anda boleh menyimpan lebih daripada satu alamat untuk satu kenalan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လိပ်စာတစ်ခုစီအတွက် ကွန်ရက် ရွေးပါ။ အဆက်အသွယ်တစ်ဦးအတွက် လိပ်စာတစ်ခုထက်ပို၍ သိမ်းနိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg nettverk for hver adresse. Du kan lagre flere adresser for en kontakt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हरेक ठेगानाका लागि नेटवर्क रोज्नुहोस्। एउटा सम्पर्कका लागि धेरै ठेगाना सुरक्षित गर्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het netwerk voor elk adres. Je kunt meerdere adressen voor een contact opslaan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରତ୍ୟେକ ଠିକଣା ପାଇଁ ନେଟୱର୍କ ବାଛନ୍ତୁ। ଗୋଟିଏ ସମ୍ପର୍କ ପାଇଁ ଏକାଧିକ ଠିକଣା ସେଭ୍ କରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰੇਕ ਪਤੇ ਦਾ ਨੈੱਟਵਰਕ ਚੁਣੋ। ਇੱਕ ਸੰਪਰਕ ਲਈ ਇੱਕ ਤੋਂ ਵੱਧ ਪਤੇ ਸੁਰੱਖਿਅਤ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz sieć dla każdego adresu. Dla jednego kontaktu możesz zapisać więcej niż jeden adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a rede de cada endereço. Você pode salvar mais de um endereço por contato."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a rede de cada endereço. Pode guardar mais do que um endereço por contacto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege rețeaua pentru fiecare adresă. Poți salva mai multe adrese pentru un contact."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сеть для каждого адреса. Для одного контакта можно сохранить несколько адресов."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر پتي لاءِ نيٽ ورڪ چونڊيو. توهان هڪ رابطي لاءِ هڪ کان وڌيڪ پتا محفوظ ڪري سگهو ٿا."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එක් එක් ලිපිනයට ජාලය තෝරන්න. එක් සම්බන්ධතාවකට ලිපින කිහිපයක් සුරැකිය හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre každú adresu zvoľte sieť. Ku kontaktu môžete uložiť viac adries."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za vsak naslov izberite omrežje. Za stik lahko shranite več naslovov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj nätverk för varje adress. Du kan spara flera adresser för en kontakt."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chagua mtandao wa kila anwani. Unaweza kuhifadhi zaidi ya anwani moja kwa mtu."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு முகவரிக்கும் பிணையத்தைத் தேர்ந்தெடுக்கவும். ஒரு தொடர்புக்கு ஒன்றுக்கு மேற்பட்ட முகவரிகளைச் சேமிக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి చిరునామాకు నెట్‌వర్క్ ఎంచుకోండి. ఒక కాంటాక్ట్‌కు ఒకటికంటే ఎక్కువ చిరునామాలు సేవ్ చేయవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเครือข่ายสำหรับแต่ละที่อยู่ คุณสามารถบันทึกหลายที่อยู่ให้ผู้ติดต่อคนเดียวได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her adres için ağı seçin. Bir kişi için birden fazla adres kaydedebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть мережу для кожної адреси. Для одного контакту можна зберегти кілька адрес."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر پتے کا نیٹ ورک منتخب کریں۔ ایک رابطے کے لیے ایک سے زیادہ پتے محفوظ کر سکتے ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har bir manzil uchun tarmoqni tanlang. Kontakt uchun bittadan ortiq manzil saqlashingiz mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn mạng cho từng địa chỉ. Bạn có thể lưu nhiều địa chỉ cho một liên hệ."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan nẹ́tíwọ́ọ̀kì fún àdírẹ́sì kọ̀ọ̀kan. O lè fi àdírẹ́sì ju ẹyọ kan lọ pamọ́ fún olùbásọ̀rọ̀ kan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个地址选择网络。您可以为同一联系人保存多个地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請為每個地址選擇網路。每位聯絡人可儲存多個地址。"
          }
        }
      }
