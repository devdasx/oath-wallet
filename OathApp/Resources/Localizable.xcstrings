    "reset.data_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የግብይት ታሪክ፣ ዕውቂያዎች፣ አድራሻዎች፣ ማስታወሻዎችና በመጠባበቅ ላይ ያሉ የመሣሪያው የምትኬ መረጃዎች ይሰረዛሉ። ይህ ቀድሞ ወደ አውታረ መረብ የተላኩ ግብይቶችን አይሰርዝም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف سجل المعاملات وجهات الاتصال والعناوين والملاحظات وبيانات النسخ المحلية المعلّقة. لا يُلغي هذا معاملات أُرسلت بالفعل إلى شبكة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লেনদেনের ইতিহাস, পরিচিতি, ঠিকানা, নোট ও অপেক্ষমাণ স্থানীয় ব্যাকআপ ডেটা মুছে যাবে। এতে নেটওয়ার্কে ইতিমধ্যে পাঠানো লেনদেন বাতিল হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historie transakcí, kontakty, adresy, poznámky a čekající místní data záloh se smažou. Již odeslané transakce do sítě se tím nezruší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktionshistorik, kontakter, adresser, noter og afventende lokale sikkerhedskopidata slettes. Dette annullerer ikke transaktioner, der allerede er sendt til et netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktionsverlauf, Kontakte, Adressen, Notizen und ausstehende lokale Sicherungsdaten werden gelöscht. Bereits an ein Netzwerk gesendete Transaktionen werden nicht abgebrochen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ιστορικό συναλλαγών, οι επαφές, οι διευθύνσεις, οι σημειώσεις και τα εκκρεμή τοπικά δεδομένα αντιγράφων θα διαγραφούν. Αυτό δεν ακυρώνει συναλλαγές που έχουν ήδη σταλεί σε δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaction history, contacts, addresses, notes and pending local backup data will be deleted. This does not cancel transactions already sent to a network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán el historial de transacciones, contactos, direcciones, notas y datos locales de copias pendientes. No se cancelan las transacciones ya enviadas a una red."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سابقهٔ تراکنش، مخاطبان، نشانی‌ها، یادداشت‌ها و داده‌های پشتیبان محلیِ در انتظار حذف می‌شوند. تراکنش‌هایی که قبلاً به شبکه فرستاده شده‌اند لغو نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapahtumahistoria, yhteystiedot, osoitteet, muistiinpanot ja odottavat paikalliset varmuuskopiotiedot poistetaan. Tämä ei peru jo verkkoon lähetettyjä tapahtumia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabubura ang kasaysayan ng transaksyon, mga contact, address, tala at nakabinbing lokal na datos ng backup. Hindi nito kinakansela ang mga transaksyong naipadala na sa network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique des transactions, les contacts, adresses, notes et données locales de sauvegarde en attente seront supprimés. Les transactions déjà envoyées à un réseau ne seront pas annulées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વ્યવહાર ઇતિહાસ, સંપર્કો, સરનામાં, નોંધો અને બાકી સ્થાનિક બૅકઅપ ડેટા કાઢી નાખવામાં આવશે. આ નેટવર્ક પર પહેલેથી મોકલેલા વ્યવહારો રદ કરતું નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za a goge tarihin ma'amaloli, abokan hulɗa, adiresoshi, bayanin kula da bayanan madadin cikin na'ura da ke jira. Wannan ba ya soke ma'amalolin da aka riga aka aika zuwa hanyar sadarwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היסטוריית העסקאות, אנשי הקשר, הכתובות, ההערות ונתוני הגיבוי המקומיים הממתינים יימחקו. פעולה זו אינה מבטלת עסקאות שכבר נשלחו לרשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेन-देन इतिहास, संपर्क, पते, नोट और लंबित स्थानीय बैकअप डेटा हट जाएँगे। इससे नेटवर्क पर भेजे गए लेन-देन रद्द नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povijest transakcija, kontakti, adrese, bilješke i lokalni podaci sigurnosnih kopija na čekanju bit će izbrisani. Time se ne otkazuju transakcije već poslane na mrežu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tranzakciós előzmények, névjegyek, címek, jegyzetek és függő helyi mentési adatok törlődnek. Ez nem vonja vissza a hálózatra már elküldött tranzakciókat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat transaksi, kontak, alamat, catatan, dan data cadangan lokal tertunda akan dihapus. Ini tidak membatalkan transaksi yang sudah dikirim ke jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia delle transazioni, contatti, indirizzi, note e dati di backup locali in attesa verranno eliminati. Le transazioni già inviate a una rete non vengono annullate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引履歴、連絡先、アドレス、メモ、未処理のローカルバックアップデータを削除します。ネットワークに送信済みの取引はキャンセルされません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წაიშლება ტრანზაქციების ისტორია, კონტაქტები, მისამართები, ჩანაწერები და მომლოდინე ადგილობრივი სარეზერვო მონაცემები. ეს ქსელში უკვე გაგზავნილ ტრანზაქციებს არ აუქმებს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រវត្តិប្រតិបត្តិការ ទំនាក់ទំនង អាសយដ្ឋាន កំណត់ត្រា និងទិន្នន័យបម្រុងមូលដ្ឋានកំពុងរង់ចាំនឹងត្រូវលុប។ វាមិនបោះបង់ប្រតិបត្តិការដែលបានផ្ញើទៅបណ្ដាញរួចទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಹಿವಾಟಿನ ಇತಿಹಾಸ, ಸಂಪರ್ಕಗಳು, ವಿಳಾಸಗಳು, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಬಾಕಿಯಿರುವ ಸ್ಥಳೀಯ ಬ್ಯಾಕಪ್ ಡೇಟಾ ಅಳಿಸಲಾಗುತ್ತದೆ. ಇದು ಈಗಾಗಲೇ ನೆಟ್‌ವರ್ಕ್‌ಗೆ ಕಳುಹಿಸಿದ ವಹಿವಾಟುಗಳನ್ನು ರದ್ದುಮಾಡುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래 내역, 연락처, 주소, 메모 및 대기 중인 로컬 백업 데이터가 삭제됩니다. 이미 네트워크에 전송한 거래는 취소되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇടപാട് ചരിത്രം, കോൺടാക്റ്റുകൾ, വിലാസങ്ങൾ, കുറിപ്പുകൾ, തീർപ്പാകാത്ത പ്രാദേശിക ബാക്കപ്പ് ഡാറ്റ എന്നിവ ഇല്ലാതാക്കും. നെറ്റ്‌വർക്കിലേക്ക് ഇതിനകം അയച്ച ഇടപാടുകൾ ഇത് റദ്ദാക്കില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यवहार इतिहास, संपर्क, पत्ते, नोंदी आणि प्रलंबित स्थानिक बॅकअप डेटा हटवला जाईल. नेटवर्कला आधीच पाठवलेले व्यवहार रद्द होत नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejarah transaksi, kenalan, alamat, nota dan data sandaran setempat belum selesai akan dipadam. Ini tidak membatalkan transaksi yang telah dihantar ke rangkaian."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အရောင်းအဝယ်မှတ်တမ်း၊ အဆက်အသွယ်များ၊ လိပ်စာများ၊ မှတ်စုများနှင့် ဆိုင်းငံ့စက်တွင်းအရန်ဒေတာကို ဖျက်မည်။ ကွန်ရက်သို့ ပို့ပြီးသား အရောင်းအဝယ်များကို ပယ်ဖျက်ခြင်း မပြုပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksjonshistorikk, kontakter, adresser, notater og ventende lokale sikkerhetskopidata slettes. Dette avbryter ikke transaksjoner som allerede er sendt til et nettverk."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कारोबार इतिहास, सम्पर्क, ठेगाना, टिप्पणी र विचाराधीन स्थानीय जगेडा डेटा मेटिनेछन्। यसले नेटवर्कमा पठाइसकेका कारोबार रद्द गर्दैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transactiegeschiedenis, contacten, adressen, notities en openstaande lokale reservekopiegegevens worden verwijderd. Transacties die al naar een netwerk zijn verzonden, worden hiermee niet geannuleerd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଲେନଦେନ ଇତିହାସ, ସମ୍ପର୍କ, ଠିକଣା, ନୋଟ୍ ଓ ବିଚାରାଧୀନ ସ୍ଥାନୀୟ ବ୍ୟାକଅପ୍ ଡାଟା ବିଲୋପ ହେବ। ଏହା ନେଟୱର୍କକୁ ପଠାସରିଥିବା ଲେନଦେନ ବାତିଲ କରେ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਲੈਣ-ਦੇਣ ਇਤਿਹਾਸ, ਸੰਪਰਕ, ਪਤੇ, ਨੋਟ ਅਤੇ ਬਕਾਇਆ ਸਥਾਨਕ ਬੈਕਅੱਪ ਡਾਟਾ ਮਿਟ ਜਾਣਗੇ। ਇਸ ਨਾਲ ਨੈੱਟਵਰਕ ਨੂੰ ਪਹਿਲਾਂ ਭੇਜੇ ਲੈਣ-ਦੇਣ ਰੱਦ ਨਹੀਂ ਹੁੰਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia transakcji, kontakty, adresy, notatki i oczekujące lokalne dane kopii zapasowej zostaną usunięte. Nie anuluje to transakcji wysłanych już do sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de transações, contatos, endereços, notas e dados de backup local pendentes serão apagados. Isso não cancela transações já enviadas à rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de transações, contactos, endereços, notas e dados pendentes de cópias locais serão apagados. Isto não cancela transações já enviadas para a rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istoricul tranzacțiilor, contactele, adresele, notițele și datele locale de siguranță în așteptare vor fi șterse. Aceasta nu anulează tranzacțiile deja trimise într-o rețea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История транзакций, контакты, адреса, заметки и ожидающие локальные данные резервного копирования будут удалены. Уже отправленные в сеть транзакции не отменяются."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٽرانزيڪشن تاريخ، رابطا، پتا، نوٽ ۽ انتظار ۾ پيل مقامي بيڪ اپ ڊيٽا ڊليٽ ٿيندا. هي اڳ ۾ نيٽ ورڪ ڏانهن موڪليل ٽرانزيڪشنون رد نٿو ڪري."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ගනුදෙනු ඉතිහාසය, සම්බන්ධතා, ලිපින, සටහන් සහ පොරොත්තු දේශීය උපස්ථ දත්ත මකා දැමේ. දැනටමත් ජාලයට යැවූ ගනුදෙනු අවලංගු නොවේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "História transakcií, kontakty, adresy, poznámky a čakajúce miestne údaje záloh sa vymažú. Už odoslané transakcie do siete sa tým nezrušia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgodovina transakcij, stiki, naslovi, opombe in čakajoči lokalni podatki varnostnih kopij bodo izbrisani. To ne prekliče transakcij, ki so bile že poslane v omrežje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktionshistorik, kontakter, adresser, anteckningar och väntande lokala säkerhetskopieringsdata raderas. Detta avbryter inte transaktioner som redan har skickats till ett nätverk."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia ya miamala, watu, anwani, madokezo na data ya nakala ya ndani inayosubiri vitafutwa. Hii haighairi miamala iliyotumwa tayari kwenye mtandao."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பரிவர்த்தனை வரலாறு, தொடர்புகள், முகவரிகள், குறிப்புகள் மற்றும் நிலுவையில் உள்ள உள்ளகக் காப்புத் தரவு நீக்கப்படும். ஏற்கனவே பிணையத்திற்கு அனுப்பிய பரிவர்த்தனைகளை இது ரத்துசெய்யாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లావాదేవీ చరిత్ర, కాంటాక్ట్‌లు, చిరునామాలు, నోట్‌లు, పెండింగ్ స్థానిక బ్యాకప్ డేటా తొలగించబడతాయి. నెట్‌వర్క్‌కు ఇప్పటికే పంపిన లావాదేవీలు రద్దు కావు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติธุรกรรม ผู้ติดต่อ ที่อยู่ บันทึก และข้อมูลสำรองในอุปกรณ์ที่ค้างอยู่จะถูกลบ การดำเนินการนี้ไม่ยกเลิกธุรกรรมที่ส่งไปยังเครือข่ายแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem geçmişi, kişiler, adresler, notlar ve bekleyen yerel yedek verileri silinecek. Bu işlem, ağa zaten gönderilmiş işlemleri iptal etmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історію транзакцій, контакти, адреси, нотатки й очікувані локальні дані резервних копій буде видалено. Це не скасовує транзакції, уже надіслані в мережу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹرانزیکشن ہسٹری، رابطے، پتے، نوٹس اور زیرِ التوا مقامی بیک اپ ڈیٹا حذف ہو گا۔ پہلے سے نیٹ ورک کو بھیجی ٹرانزیکشنز منسوخ نہیں ہوں گی۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tranzaksiyalar tarixi, kontaktlar, manzillar, eslatmalar va kutilayotgan mahalliy zaxira ma’lumotlari o‘chiriladi. Bu tarmoqqa allaqachon yuborilgan tranzaksiyalarni bekor qilmaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử giao dịch, liên hệ, địa chỉ, ghi chú và dữ liệu sao lưu cục bộ đang chờ sẽ bị xóa. Thao tác này không hủy giao dịch đã gửi lên mạng."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ó pa ìtàn ìṣòwò, olùbásọ̀rọ̀, àdírẹ́sì, àkọsílẹ̀ àti dátà àfẹ̀yìntì orí ẹ̀rọ tó ń dúró rẹ́. Èyí kò fagilé ìṣòwò tí a ti fi ránṣẹ́ sí nẹ́tíwọ́ọ̀kì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易记录、联系人、地址、备注及待处理的本机备份数据都将删除。这不会取消已发送至网络的交易。"
