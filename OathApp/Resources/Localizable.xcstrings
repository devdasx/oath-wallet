    "wcMethodsDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ግንኙነት በተመረጡት አውታረ መረቦች ላይ እንዲጠይቅ የሚፈቀዱለት ዘዴዎች እነዚህ ናቸው። እያንዳንዱ ፊርማ ወይም ግብይት አሁንም ፈቃድህን ይፈልጋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه هي الطرق التي سيُسمح لهذا الاتصال بطلبها على الشبكات المحددة. ما زال كل توقيع أو معاملة يحتاج إلى موافقتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সংযোগ বাছাই করা নেটওয়ার্কে এই পদ্ধতিগুলোর অনুরোধ করতে পারবে। প্রতিটি স্বাক্ষর বা লেনদেনে এখনও আপনার অনুমোদন লাগে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jsou metody, o které smí toto připojení žádat ve vybraných sítích. Každý podpis nebo transakce stále vyžaduje vaše schválení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er de metoder, forbindelsen må anmode om på de valgte netværk. Hver signatur eller transaktion kræver stadig din godkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Methoden darf die Verbindung in den ausgewählten Netzwerken anfordern. Jede Signatur oder Transaktion benötigt weiterhin deine Zustimmung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές είναι οι μέθοδοι που θα μπορεί να ζητά αυτή η σύνδεση στα επιλεγμένα δίκτυα. Κάθε υπογραφή ή συναλλαγή χρειάζεται ακόμη την έγκρισή σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the methods this connection will be allowed to request on the selected networks. Each signature or transaction still needs your approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los métodos que esta conexión podrá solicitar en las redes seleccionadas. Cada firma o transacción sigue necesitando tu aprobación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این‌ها روش‌هایی هستند که این اتصال می‌تواند در شبکه‌های انتخاب‌شده درخواست کند. هر امضا یا تراکنش همچنان به تأیید شما نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä ovat menetelmät, joita tämä yhteys saa pyytää valituissa verkoissa. Jokainen allekirjoitus tai tapahtuma vaatii edelleen hyväksyntäsi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ito ang mga paraang papayagang hilingin ng koneksyong ito sa mga napiling network. Kailangan pa rin ng pahintulot mo ang bawat pirma o transaksyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les méthodes que cette connexion pourra demander sur les réseaux sélectionnés. Chaque signature ou transaction nécessite toujours votre approbation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ કનેક્શન પસંદ કરેલાં નેટવર્ક પર આ પદ્ધતિઓની વિનંતી કરી શકશે. દરેક હસ્તાક્ષર અથવા વ્યવહારને હજી તમારી મંજૂરી જોઈએ."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waɗannan su ne hanyoyin da wannan haɗin zai samu izinin nema a hanyoyin sadarwar da aka zaɓa. Kowane sa hannu ko ma'amala har yanzu yana buƙatar amincewarka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אלו השיטות שהחיבור יורשה לבקש ברשתות שנבחרו. כל חתימה או עסקה עדיין דורשת את אישורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये वे विधियाँ हैं जिन्हें यह कनेक्शन चुने नेटवर्क पर माँग सकेगा। हर हस्ताक्षर या लेन-देन को फिर भी आपकी मंज़ूरी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo su metode koje će ova veza moći tražiti na odabranim mrežama. Svaki potpis ili transakcija i dalje treba vaše odobrenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeket a metódusokat kérheti a kapcsolat a kiválasztott hálózatokon. Minden aláíráshoz és tranzakcióhoz továbbra is szükség van a jóváhagyásodra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inilah metode yang boleh diminta koneksi ini di jaringan yang dipilih. Setiap tanda tangan atau transaksi tetap memerlukan persetujuan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi sono i metodi che la connessione potrà richiedere sulle reti selezionate. Ogni firma o transazione richiede comunque la tua approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したネットワークでこの接続が要求できるメソッドです。署名や取引には引き続き個別の承認が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს ის მეთოდებია, რომელთა მოთხოვნაც ამ კავშირს არჩეულ ქსელებში შეეძლება. ყოველ ხელმოწერას ან ტრანზაქციას კვლავ თქვენი თანხმობა სჭირდება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នេះជាវិធីដែលការតភ្ជាប់នេះអាចស្នើលើបណ្ដាញជ្រើស។ ហត្ថលេខា ឬប្រតិបត្តិការនីមួយៗនៅតែត្រូវការអនុម័តអ្នក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಯ್ಕೆಮಾಡಿದ ನೆಟ್‌ವರ್ಕ್‌ಗಳಲ್ಲಿ ಈ ಸಂಪರ್ಕ ವಿನಂತಿಸಲು ಅನುಮತಿಸಲಾಗುವ ವಿಧಾನಗಳು ಇವು. ಪ್ರತಿ ಸಹಿ ಅಥವಾ ವಹಿವಾಟಿಗೂ ಇನ್ನೂ ನಿಮ್ಮ ಅನುಮೋದನೆ ಅಗತ್ಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결이 선택한 네트워크에서 요청할 수 있는 메서드입니다. 각 서명이나 거래에는 여전히 승인이 필요합니다."
