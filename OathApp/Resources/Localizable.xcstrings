    "cloud_backup.password_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቢያንስ 8 ቁምፊዎች ያሉት ይለፍ ቃል ምረጥ። ምትኬውን ለመመለስ ይህ ይለፍ ቃል ያስፈልግሃል፤ ከጠፋም ማስመለስ አይቻልም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كلمة سر من 8 محارف على الأقل. ستحتاج إليها لاستعادة النسخة ولا يمكن استرجاعها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্তত ৮ অক্ষরের পাসওয়ার্ড বেছে নিন। ব্যাকআপ পুনরুদ্ধারে এই পাসওয়ার্ড লাগবে; এটি উদ্ধার করা যায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte heslo o alespoň 8 znacích. Budete ho potřebovat k obnovení zálohy; nelze ho obnovit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en adgangskode med mindst 8 tegn. Du skal bruge den for at gendanne sikkerhedskopien; adgangskoden kan ikke genskabes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Passwort mit mindestens 8 Zeichen. Du brauchst es zur Wiederherstellung der Sicherung; es kann nicht wiederhergestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε κωδικό πρόσβασης με τουλάχιστον 8 χαρακτήρες. Θα τον χρειαστείτε για να επαναφέρετε το αντίγραφο· δεν μπορεί να ανακτηθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a password with at least 8 characters. You will need this password to restore the backup; it cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una contraseña de al menos 8 caracteres. La necesitarás para restaurar la copia; no se puede recuperar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گذرواژه‌ای با حداقل ۸ نویسه انتخاب کنید. برای بازیابی نسخهٔ پشتیبان به این گذرواژه نیاز دارید؛ خود گذرواژه قابل‌بازیابی نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse vähintään 8 merkin salasana. Tarvitset sen varmuuskopion palauttamiseen. Salasanaa ei voi palauttaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng password na may hindi bababa sa 8 character. Kailangan mo ito para maibalik ang backup; hindi na ito mababawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un mot de passe d’au moins 8 caractères. Il sera nécessaire pour restaurer la sauvegarde et ne peut pas être récupéré."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઓછામાં ઓછા 8 અક્ષરનો પાસવર્ડ પસંદ કરો. બૅકઅપ પુનઃસ્થાપિત કરવા આ પાસવર્ડની જરૂર પડશે; તે પાછો મેળવી શકાતો નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi kalmar sirri mai haruffa aƙalla 8. Za ka buƙaci wannan kalmar sirri don dawo da madadi; ba za a iya dawo da ita ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור סיסמה בת 8 תווים לפחות. הסיסמה תידרש לשחזור הגיבוי; לא ניתן לשחזר אותה אם תאבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम 8 अक्षरों का पासवर्ड चुनें। बैकअप बहाल करने के लिए यह पासवर्ड चाहिए; इसे वापस नहीं पाया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite lozinku s najmanje 8 znakova. Trebat će vam za obnovu sigurnosne kopije; nije je moguće povratiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz legalább 8 karakterből álló jelszót. A mentés visszaállításához szükséged lesz rá; a jelszó nem állítható helyre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kata sandi minimal 8 karakter. Anda memerlukannya untuk memulihkan cadangan; kata sandi ini tidak dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una password di almeno 8 caratteri. Ti servirà per ripristinare il backup e non può essere recuperata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8文字以上のパスワードを設定してください。バックアップの復元に必要です。このパスワード自体は復元できません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აირჩიეთ სულ მცირე 8-სიმბოლოიანი პაროლი. ის სარეზერვო ასლის აღსადგენად დაგჭირდებათ; მისი აღდგენა შეუძლებელია."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ជ្រើសពាក្យសម្ងាត់យ៉ាងតិច 8 តួអក្សរ។ អ្នកនឹងត្រូវការវាសម្រាប់ស្ដារច្បាប់ចម្លងបម្រុង ហើយមិនអាចយកពាក្យសម្ងាត់នេះមកវិញបានទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕನಿಷ್ಠ 8 ಅಕ್ಷರಗಳ ಪಾಸ್‌ವರ್ಡ್ ಆಯ್ಕೆ ಮಾಡಿ. ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪಿಸಲು ಈ ಪಾಸ್‌ವರ್ಡ್ ಅಗತ್ಯ; ಅದನ್ನು ಮರುಪಡೆಯಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8자 이상의 비밀번호를 정하세요. 백업을 복원하려면 이 비밀번호가 필요하며, 비밀번호는 복구할 수 없습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കുറഞ്ഞത് 8 അക്ഷരങ്ങളുള്ള പാസ്‌വേഡ് തിരഞ്ഞെടുക്കുക. ബാക്കപ്പ് വീണ്ടെടുക്കാൻ ഇത് ആവശ്യമാണ്; ഈ പാസ്‌വേഡ് വീണ്ടെടുക്കാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किमान 8 अक्षरांचा पासवर्ड निवडा. बॅकअप पुनर्संचयित करण्यासाठी हा पासवर्ड लागेल; तो हरवल्यास परत मिळवता येत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kata laluan sekurang-kurangnya 8 aksara. Anda memerlukannya untuk memulihkan sandaran; ia tidak boleh dipulihkan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အနည်းဆုံး အက္ခရာ ၈ လုံးပါ စကားဝှက်ကို ရွေးပါ။ အရန်ကို ပြန်တင်ရန် ဤစကားဝှက် လိုအပ်သည်။ မေ့သွားလျှင် ပြန်မရနိုင်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et passord med minst 8 tegn. Du trenger det for å gjenopprette sikkerhetskopien. Passordet kan ikke gjenopprettes."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम्तीमा ८ अक्षरको पासवर्ड रोज्नुहोस्। जगेडा पुनर्स्थापना गर्न यो पासवर्ड चाहिन्छ; यो पुनःप्राप्त गर्न सकिँदैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een wachtwoord van minstens 8 tekens. Je hebt dit wachtwoord nodig om de reservekopie te herstellen; het kan niet worden teruggehaald."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅତିକମରେ ୮ ଅକ୍ଷରର ପାସୱାର୍ଡ ବାଛନ୍ତୁ। ବ୍ୟାକଅପ୍ ପୁନଃସ୍ଥାପନ ପାଇଁ ଏହି ପାସୱାର୍ଡ ଲାଗିବ; ଏହା ପୁନରୁଦ୍ଧାର କରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘੱਟੋ-ਘੱਟ 8 ਅੱਖਰਾਂ ਦਾ ਪਾਸਵਰਡ ਚੁਣੋ। ਬੈਕਅੱਪ ਬਹਾਲ ਕਰਨ ਲਈ ਇਹ ਲੋੜੀਂਦਾ ਹੈ; ਇਸ ਨੂੰ ਮੁੜ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz hasło składające się z co najmniej 8 znaków. Będzie potrzebne do odtworzenia kopii; nie można go odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma senha com pelo menos 8 caracteres. Você precisará dela para restaurar o backup; ela não pode ser recuperada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma palavra-passe com pelo menos 8 carateres. Será necessária para restaurar a cópia de segurança e não pode ser recuperada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege o parolă cu cel puțin 8 caractere. Vei avea nevoie de ea pentru a restaura copia; parola nu poate fi recuperată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите пароль длиной не менее 8 символов. Он понадобится для восстановления копии; восстановить сам пароль нельзя."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گهٽ ۾ گهٽ 8 اکرن جو پاسورڊ چونڊيو. بيڪ اپ بحال ڪرڻ لاءِ توهان کي هي پاسورڊ گهرجي؛ اهو واپس حاصل نٿو ڪري سگهجي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවම වශයෙන් අක්ෂර 8ක මුරපදයක් තෝරන්න. උපස්ථය ප්‍රතිසාධනයට එය අවශ්‍ය වන අතර එය නැවත ලබාගත නොහැක."
