        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुल्क बाँकी मौज्दातबाट लिइन्छ। नपुगे रकमबाट घटाइन्छ। पठाउनुअघि ठ्याक्कै रकम र शुल्क समीक्षा गर्नुहोस्।"
