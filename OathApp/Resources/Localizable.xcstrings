        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это разрешение не истекает со временем. Оно действует, пока nonce не будет использован или изменён."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي اجازت وقت گذرڻ سان ختم نٿي ٿئي. نانس استعمال ٿيڻ يا تبديل ٿيڻ تائين صحيح رهي ٿي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම අවසරය කාලයත් සමඟ කල් ඉකුත් නොවේ. Nonce භාවිත කරන හෝ වෙනස් කරන තෙක් එය වලංගු වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto oprávnenie časom nevyprší. Platí, kým sa nonce nepoužije alebo nezmení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pooblastilo s časom ne poteče. Velja, dokler nonce ni uporabljen ali spremenjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna auktorisering löper inte ut med tiden. Den gäller tills noncen används eller ändras."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idhini hii haiishi muda wake kadiri muda unavyopita. Inaendelea kuwa halali hadi nonce itumike au ibadilishwe."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த அங்கீகாரம் காலப்போக்கில் காலாவதியாகாது. நான்ஸ் பயன்படுத்தப்படும் அல்லது மாற்றப்படும் வரை இது செல்லுபடியாகும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ అనుమతి కాలంతో గడువు ముగియదు. నాన్స్ ఉపయోగించే లేదా మార్చే వరకు ఇది చెల్లుబాటులో ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอนุญาตนี้ไม่หมดอายุตามเวลา แต่จะมีผลจนกว่าจะใช้หรือเปลี่ยน nonce"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yetkilendirme zamanla sona ermez. Nonce kullanılana veya değiştirilene kadar geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей дозвіл не спливає з часом. Він діє, доки nonce не буде використано або змінено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اجازت وقت گزرنے سے ختم نہیں ہوتی۔ نانس کے استعمال یا تبدیل ہونے تک یہ مؤثر رہتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ruxsat vaqt o‘tishi bilan tugamaydi. Nonce ishlatilguncha yoki o‘zgartirilguncha amal qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ủy quyền này không hết hạn theo thời gian. Nó vẫn có hiệu lực cho đến khi nonce được sử dụng hoặc thay đổi."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àṣẹ yìí kò parí bí àkókò ṣe ń lọ. Ó ṣì wúlò títí tí a ó fi lo nonce tàbí yí i padà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授权不会随时间到期。在 nonce 被使用或更改之前，它一直有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授權不會隨時間到期。在 nonce 被使用或變更之前，它一直有效。"
          }
        }
      }
    },
