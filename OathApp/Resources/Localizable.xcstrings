    "wcPermit2AllowanceDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አውጪው ይህን የማውጣት ፈቃድ መጠኑ እስኪያልቅ፣ ጊዜው እስኪያበቃ ወይም እስኪሰረዝ ሊጠቀምበት ይችላል። ፊርማውን የማስገቢያ ጊዜ ገደብ የተለየ ነው።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للجهة المخوّلة استخدام حد الإنفاق هذا حتى يُستهلك أو تنتهي صلاحيته أو يُلغى. مهلة إرسال التوقيع منفصلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যয়সীমা খরচ, মেয়াদ শেষ বা বাতিল না হওয়া পর্যন্ত ব্যয়কারী ব্যবহার করতে পারে। স্বাক্ষর জমার সময়সীমা আলাদা।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávněný subjekt může tento limit čerpat do vyčerpání, vypršení nebo odvolání. Lhůta pro odeslání podpisu je samostatná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forbrugsberettigede kan bruge denne forbrugsgrænse, indtil den er brugt op, udløber eller tilbagekaldes. Fristen for at indsende signaturen er separat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Berechtigte kann diese Freigabe nutzen, bis sie verbraucht, abgelaufen oder widerrufen ist. Die Einreichungsfrist der Signatur ist separat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εξουσιοδοτημένη διεύθυνση μπορεί να χρησιμοποιεί αυτή την άδεια δαπάνης μέχρι να εξαντληθεί, να λήξει ή να ανακληθεί. Η προθεσμία υποβολής υπογραφής είναι ξεχωριστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spender can use this allowance until it is spent, expires, or is revoked. The signature submission deadline is separate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección autorizada puede usar este límite de gasto hasta que se agote, caduque o se revoque. El plazo de envío de la firma es independiente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خرج‌کننده می‌تواند تا زمان مصرف، انقضا یا لغو از این سقف استفاده کند. مهلت ارسال امضا جداست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttöoikeuden saaja voi käyttää tätä rajaa, kunnes se on käytetty loppuun, vanhenee tai perutaan. Allekirjoituksen lähettämisen määräaika on erillinen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magagamit ng gagastos ang pahintulot na ito hanggang maubos, mag-expire o mabawi. Hiwalay ang takdang oras ng pagsusumite ng pirma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse autorisée peut utiliser cette autorisation de dépense jusqu’à son épuisement, son expiration ou sa révocation. Le délai de soumission de la signature est distinct."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ખર્ચ કરનાર આ ખર્ચ પરવાનગી વપરાઈ જાય, તેની મુદત પૂરી થાય અથવા રદ થાય ત્યાં સુધી વાપરી શકે છે. હસ્તાક્ષર સબમિટ કરવાની સમયમર્યાદા અલગ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai kashewa zai iya amfani da wannan izinin kashewa har sai an kashe shi, ya ƙare ko an soke shi. Ƙarshen lokacin miƙa sa hannun daban ne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעל הרשאת ההוצאה יכול להשתמש במכסה הזו עד שתנוצל, עד שתפוג או עד שתבוטל. המועד האחרון להגשת החתימה הוא נפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्चकर्ता इस सीमा का इस्तेमाल उसके खर्च हो जाने, समाप्ति या रद्द होने तक कर सकता है। हस्ताक्षर भेजने की समय-सीमा अलग है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovlaštena adresa može koristiti ovo odobrenje potrošnje dok se ne potroši, istekne ili opozove. Rok predaje potpisa je zaseban."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A költésre jogosult addig használhatja ezt a keretet, amíg el nem fogy, le nem jár vagy vissza nem vonod. Az aláírás benyújtásának határideje ettől független."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelanja dapat menggunakan izin belanja ini hingga habis, kedaluwarsa, atau dicabut. Tenggat pengiriman tanda tangan terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il soggetto autorizzato può usare questa autorizzazione di spesa finché non viene esaurita, scade o viene revocata. Il termine di invio della firma è separato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認先は利用枠を使い切るか、有効期限切れまたは取消まで使用できます。署名提出の期限とは別です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფლებამოსილ მისამართს ამ ხარჯვის უფლების გამოყენება შეუძლია მის ამოწურვამდე, ვადის გასვლამდე ან გაუქმებამდე. ხელმოწერის წარდგენის ვადა ცალკეა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកចំណាយអាចប្រើកំណត់នេះរហូតដល់ចំណាយអស់ ផុតកំណត់ ឬដកសិទ្ធិ។ ថ្ងៃកំណត់ដាក់ស្នើហត្ថលេខាដាច់ដោយឡែក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಖರ್ಚು ಮಾಡುವವರು ಈ ಖರ್ಚು ಅನುಮತಿಯನ್ನು ಬಳಸುವವರೆಗೆ, ಅವಧಿ ಮುಗಿಯುವವರೆಗೆ ಅಥವಾ ಹಿಂಪಡೆಯುವವರೆಗೆ ಬಳಸಬಹುದು. ಸಹಿ ಸಲ್ಲಿಸುವ ಕೊನೆಯ ಸಮಯ ಪ್ರತ್ಯೇಕವಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출자는 이 한도를 모두 쓰거나 만료되거나 취소될 때까지 사용할 수 있습니다. 서명 제출 기한은 별개입니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ചെലവഴിക്കൽ പരിധി ഉപയോഗിച്ചുതീരുന്നതോ കാലാവധി കഴിയുന്നതോ പിൻവലിക്കുന്നതോ വരെ ചെലവഴിക്കുന്നയാൾക്ക് ഉപയോഗിക്കാം. ഒപ്പ് സമർപ്പിക്കാനുള്ള സമയപരിധി വേറിട്ടതാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खर्चकर्ता ही परवानगी वापरून संपेपर्यंत, मुदत संपेपर्यंत किंवा रद्द होईपर्यंत वापरू शकतो. स्वाक्षरी सादरीकरणाची अंतिम मुदत वेगळी आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
