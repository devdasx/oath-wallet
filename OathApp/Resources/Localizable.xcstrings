        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako izgubite ove riječi i pristup novčaniku, sredstva nije moguće oporaviti. Svatko tko ih dobije može uzeti vaša sredstva."
