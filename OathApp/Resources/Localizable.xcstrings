        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಪದಗಳನ್ನು ಮತ್ತು ನಿಮ್ಮ ವ್ಯಾಲೆಟ್ ಪ್ರವೇಶವನ್ನು ಕಳೆದುಕೊಂಡರೆ ನಿಮ್ಮ ಹಣ ಮರುಪಡೆಯಲಾಗುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಪಡೆಯುವ ಯಾರಾದರೂ ನಿಮ್ಮ ಹಣ ತೆಗೆದುಕೊಳ್ಳಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
