        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα χρήματα πηγαίνουν στο πρωτόκολλο THORChain. Το σημείωμα καθορίζει ενέργεια, προορισμό και τυχόν όρια ανταλλαγής. Ελέγξτε ολόκληρο το σημείωμα πριν υπογράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These funds go to the THORChain protocol. The memo specifies the action, destination and any swap limits. Check the complete memo before signing."
