    "wcSwapCallDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እነዚህ ገደቦች ከትክክለኛው የልውውጥ ጥያቄ የመጡ ናቸው። የውጤት ግምት አይደሉም። ሁለቱንም የቶከን ውሎችና ተቀባዩን አረጋግጥ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي هذه الحدود من طلب المبادلة الدقيق. وليست تقديرًا للناتج. تحقق من عقدَي الرمزين والمستلم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সীমা হুবহু সোয়াপ অনুরোধ থেকে এসেছে। পাওয়ার পরিমাণের অনুমান নয়। দুই টোকেনের কন্ট্র্যাক্ট ও প্রাপক দেখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto limity vycházejí z přesného požadavku směny. Nejsou odhadem výstupu. Zkontrolujte oba kontrakty tokenů a příjemce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse grænser stammer fra den præcise bytteanmodning. De er ikke et estimat for det modtagne beløb. Kontrollér begge tokenkontrakter og modtageren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Limits stammen aus der exakten Swap-Anfrage, nicht aus einer Ergebnisschätzung. Prüfe beide Token-Verträge und den Empfänger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα όρια προέρχονται από το ακριβές αίτημα ανταλλαγής. Δεν είναι εκτίμηση του ποσού εξόδου. Ελέγξτε και τα δύο συμβόλαια token και τον παραλήπτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These limits come from the exact swap request. They are not an output estimate. Check both token contracts and the recipient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos límites proceden de la solicitud exacta de intercambio, no de una estimación del resultado. Comprueba ambos contratos de tokens y el destinatario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
