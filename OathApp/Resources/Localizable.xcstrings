    "permissionBatchDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱ ፈቃድ መሰረዝ የኔትወርክ ክፍያ አለው። Oath ከስህተት በኋላ ይቀጥላል። ከዚህ ማያ መውጣት ይችላሉ፤ ቆልፉን ይክፈቱና የተቋረጡትን መሰረዞች እንደገና ይሞክሩ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل عملية إلغاء رسوم شبكة. يواصل Oath العمل بعد أي فشل. يمكنك مغادرة هذه الشاشة؛ افتح القفل وأعد محاولة العمليات المتوقفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি অনুমতি প্রত্যাহারে নেটওয়ার্ক ফি লাগে। কোনো কাজ ব্যর্থ হলেও Oath বাকি কাজগুলো চালিয়ে যায়। আপনি এই স্ক্রিন ছেড়ে যেতে পারেন; যে প্রত্যাহারগুলো বাধাপ্রাপ্ত হয়েছে, আনলক করে সেগুলো আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za každé odvolání se platí síťový poplatek. Oath pokračuje i po chybách. Tuto obrazovku můžete opustit; po odemknutí zopakujte přerušená odvolání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tilbagekaldelse har et netværksgebyr. Oath fortsætter efter fejl. Du kan forlade denne skærm; lås op og prøv afbrudte tilbagekaldelser igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Widerruf kostet eine Netzwerkgebühr. Oath fährt nach Fehlern fort. Du kannst diesen Bildschirm verlassen; entsperre die App und wiederhole unterbrochene Widerrufe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ανάκληση έχει χρέωση δικτύου. Το Oath συνεχίζει μετά από αποτυχίες. Μπορείτε να φύγετε από αυτή την οθόνη· ξεκλειδώστε και επαναλάβετε τις ανακλήσεις που διακόπηκαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each removal has a network fee. Oath continues after failures. You can leave this screen; unlock and retry any interrupted removals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada revocación tiene una comisión de red. Oath continúa tras los fallos. Puedes salir de esta pantalla; desbloquea y reintenta las revocaciones interrumpidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر لغو دسترسی کارمزد شبکه دارد. Oath پس از خطاها ادامه می‌دهد. می‌توانید این صفحه را ترک کنید؛ برای تلاش دوبارهٔ موارد متوقف‌شده قفل را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisesta peruutuksesta veloitetaan verkkomaksu. Oath jatkaa virheiden jälkeen. Voit poistua tältä näytöltä; avaa lukitus ja yritä keskeytyneitä peruutuksia uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May bayad sa network ang bawat pagbawi. Magpapatuloy ang Oath kahit may mabigo. Maaari kang umalis sa screen na ito; i-unlock at subukan muli ang mga naantalang pagbawi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque révocation entraîne des frais de réseau. Oath continue après les échecs. Vous pouvez quitter cet écran ; déverrouillez et réessayez les révocations interrompues."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક મંજૂરી રદ કરવા માટે નેટવર્ક ફી લાગે છે. નિષ્ફળતા પછી પણ Oath ચાલુ રહે છે. તમે આ સ્ક્રીન છોડી શકો છો; અટકેલી પ્રક્રિયાઓ માટે અનલૉક કરીને ફરી પ્રયાસ કરો."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kowane soke izini yana da kuɗin hanyar sadarwa. Oath zai ci gaba bayan gazawa. Za ka iya barin wannan allo; buɗe kulle ka sake gwada ayyukan da suka tsaya."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל ביטול יש עמלת רשת. Oath ממשיכה גם לאחר כישלון. אפשר לצאת מהמסך הזה; יש לפתוח את הנעילה ולנסות שוב ביטולים שהופסקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर अनुमति रद्द करने पर नेटवर्क शुल्क लगता है। कुछ प्रयास विफल होने पर भी Oath बाकी अनुमतियाँ रद्द करना जारी रखता है। आप यह स्क्रीन छोड़ सकते हैं; कोई कार्य बाधित हो जाए तो अनलॉक करके उसे फिर आज़माएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki opoziv ima mrežnu naknadu. Oath nastavlja nakon pogrešaka. Možete napustiti ovaj zaslon; otključajte i ponovno pokušajte prekinute opozive."
