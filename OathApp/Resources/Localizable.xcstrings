      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ dApp የዋሌትህ መዳረሻ የለውም። ግንኙነት ሲኖር Oath እንደገና ለማሳወቅ ይሞክራል። አሁንም እንደገና መሞከር ትችላለህ።"
