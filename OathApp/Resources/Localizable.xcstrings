    "multisigSuiKeyDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የEd25519 የግል ቁልፍ በሄክሳዴሲማል ወይም suiprivkey ቅርጸት ያስገቡ።"
