    "multisigTronSetupDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ቦርሳ ገና በብዙ ፊርማዎች አልተጠበቀም። የአውታረ መረብ ክፍያውን ለመሸፈን ከታች ባለው አድራሻ TRX ይቀበሉ፣ ከዚያ የፊርማ ደንቦቹን ያንቁ። ማንቃቱ እስኪረጋገጥ ድረስ ሌሎች ንብረቶችን አይቀበሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المحفظة غير محمية بتوقيعات متعددة بعد. استلم TRX على العنوان أدناه لتغطية رسوم الشبكة، ثم فعّل قواعد التوقيع. لا تستلم أصولًا أخرى حتى يتم تأكيد التفعيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ওয়ালেট এখনো একাধিক স্বাক্ষর দিয়ে সুরক্ষিত নয়। নেটওয়ার্ক ফি মেটাতে নিচের ঠিকানায় TRX গ্রহণ করুন, তারপর এর স্বাক্ষরের নিয়ম সক্রিয় করুন। সক্রিয়করণ নিশ্চিত না হওয়া পর্যন্ত অন্য সম্পদ গ্রহণ করবেন না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato peněženka zatím není chráněna více podpisy. Přijměte TRX na níže uvedenou adresu pro pokrytí síťového poplatku a poté aktivujte pravidla podepisování. Dokud nebude aktivace potvrzena, nepřijímejte jiná aktiva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tegnebog er endnu ikke beskyttet af flere signaturer. Modtag TRX på adressen nedenfor for at dække netværksgebyret, og aktivér derefter signaturreglerne. Modtag ikke andre aktiver, før aktiveringen er bekræftet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wallet ist noch nicht durch mehrere Signaturen geschützt. Empfange TRX an der unten angegebenen Adresse, um die Netzwerkgebühr abzudecken, und aktiviere dann die Signaturregeln. Empfange keine anderen Vermögenswerte, bevor die Aktivierung bestätigt wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το πορτοφόλι δεν προστατεύεται ακόμη με πολλαπλές υπογραφές. Λάβετε TRX στην παρακάτω διεύθυνση για να καλύψετε την προμήθεια δικτύου και έπειτα ενεργοποιήστε τους κανόνες υπογραφών. Μην λάβετε άλλα στοιχεία μέχρι να επιβεβαιωθεί η ενεργοποίηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet is not protected by multiple signatures yet. Receive TRX at the address below to cover the network fee, then activate its signature rules. Do not receive other assets until activation is confirmed."
