        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሁሉም የአድራሻ ዓይነቶች የዚህ ዋሌት ናቸው። እዚህ የሚታየው አድራሻ ምንም ቢሆን፣ Oath ለእያንዳንዱ ዓይነት የመቀበያና የመልስ ገንዘብ አድራሻዎችን ይፈትሻል።"
