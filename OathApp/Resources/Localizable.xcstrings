      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እያንዳንዱ የማዋቀሪያ ደረጃ ማረጋገጫ ይፈልጋል። የXRP መጠባበቂያዎች በመለያው ውስጥ ይቀራሉ፤ የግብይት ክፍያዎች ለአውታረ መረቡ ይከፈላሉ፣ ለOath አይደሉም።"
