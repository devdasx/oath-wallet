      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ ጥያቄ ዋጋ የለውም። ወደ dApp ተመለስና አዲስ ጠይቅ። ምንም አልተፈረመም።"
